# Server-only WordPress origin. The /kar subdirectory is intentional.
WORDPRESS_URL=https://codecraft.ir/kar/
# Server-only: pretty is the default; use plain only for WordPress sites without rewrite permalinks.
WORDPRESS_PERMALINK_MODE=pretty

# Server-only sealed-session BFF configuration. Use an operator-provisioned random value of at least 32 characters.
APP_ORIGIN=https://app.example.com
IRON_SESSION_PASSWORD=replace-with-a-random-32-plus-character-operator-secret
# Exact opt-in for loopback WordPress OTP only; it is also blocked in production and requires both backend readiness booleans.
KARBAN_LOCAL_DEVELOPMENT=false
