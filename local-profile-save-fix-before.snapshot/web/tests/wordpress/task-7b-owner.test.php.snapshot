  if($case==='published-edit')get_post(20)->post_status='publish';
  if(in_array($case,['pending-save','graphql-pending-save'],true))get_post(20)->post_status='pending';
  check(!current_user_can('publish_post',20),'fixture specialist cannot publish');$before_caps=$GLOBALS['caps'];
  if($case==='submit'){$result=call_route('/profile/me/submit','POST');check(status($result)===200,'submit succeeds');}
  elseif($case==='graphql-pending-save'){($GLOBALS['mutations']['updateProfile']['mutateAndGetPayload'])(['input'=>['title'=>'Changed profession']]);}
  else{$result=call_route('/profile/me','POST',['title'=>'Changed profession']);check(status($result)===200,'save succeeds '.$case);}
  check(get_post(20)->post_status==='pending','moderation enforced '.$case);
  check(get_post(20)->post_name==='stable','installed pending capability semantics preserve server slug '.$case);
  check($GLOBALS['caps']===$before_caps&&!current_user_can('publish_post',20),'no general publish capability granted '.$case);
  check(empty($GLOBALS['filters']),'filter cleaned after success '.$case);
  $GLOBALS['uid']=3;$GLOBALS['caps'][3]=['publish_post'];wp_update_post(['ID'=>20,'post_status'=>'publish'],true);
  check(get_post(20)->post_name==='stable','later administrator publication retains URL '.$case);
 }
 reset_fixture();$GLOBALS['uid']=2;get_post(20)->post_status='pending';
 $GLOBALS['posts'][21]=clone get_post(20);$GLOBALS['posts'][21]->ID=21;$GLOBALS['posts'][21]->post_name='unrelated';
 $GLOBALS['during_post_write']=static function(){wp_update_post(['ID'=>21,'post_title'=>'Unrelated title'],true);};
 $result=call_route('/profile/me','POST',['title'=>'Changed profession']);check(status($result)===200,'scoped target succeeds');
 check(get_post(20)->post_name==='stable'&&get_post(21)->post_name==='','filter does not preserve unrelated pending post slug');check(empty($GLOBALS['filters']),'nested write cleanup');
 // A later unrelated pending write must still observe WordPress defaults.
 wp_update_post(['ID'=>21,'post_name'=>'arbitrary'],true);check(get_post(21)->post_name==='','filter cannot escape service lifetime');
 foreach(['post','post-zero','post-throw'] as $failure){reset_fixture();$GLOBALS['uid']=2;get_post(20)->post_status='pending';$GLOBALS['fail']=$failure;
  try{$result=call_route('/profile/me','POST',['title'=>'Changed profession']);check($failure!=='post-throw'&&status($result)===500,'write failure surfaced '.$failure);}
  catch(RuntimeException $e){check($failure==='post-throw'&&$e->getMessage()==='fixture write exception','fixture exception propagated');}
  check(empty($GLOBALS['filters']),'filter cleaned after failure '.$failure);check(!current_user_can('publish_post',20),'failure does not grant capabilities');
 }
 reset_fixture();$GLOBALS['uid']=2;check(status(call_route('/profile/me','POST',['slug'=>'arbitrary','title'=>'Changed']))===422&&get_post(20)->post_name==='stable','arbitrary slug still rejected');
 echo 'PASS task7B fix1 pending slug '.$GLOBALS['assertions']." assertions\n";exit(0);
}
