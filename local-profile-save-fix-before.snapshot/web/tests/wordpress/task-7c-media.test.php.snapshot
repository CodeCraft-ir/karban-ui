  file_put_contents($GLOBALS['fixture_file'],$bytes);clearstatcache(true,$GLOBALS['fixture_file']);
  $_FILES=['file'=>['name'=>$name,'type'=>$declared,'tmp_name'=>$GLOBALS['fixture_file'],'error'=>UPLOAD_ERR_OK,'size'=>$size??strlen($bytes)]];
 }
