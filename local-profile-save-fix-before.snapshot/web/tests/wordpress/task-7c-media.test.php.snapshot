/** Registered source callbacks + real tiny local image bytes. Never bootstraps WP or uploads. */
declare(strict_types=1);
namespace GraphQL\Error { class UserError extends \Exception {} }
namespace WPGraphQL\Model { class Post { public function __construct(public $post) {} } }
namespace Nahan\Core {
 // PHP upload provenance is the only native-file boundary replaced, in this test process only.
 function is_uploaded_file($path) { return ($GLOBALS['uploaded'] ?? false) && $path === ($GLOBALS['fixture_file'] ?? null); }
}
namespace {
 define('ABSPATH', __DIR__.'/'); define('OBJECT','OBJECT');
 $plugin=rtrim($argv[1]??'','/'); $mode=$argv[2]??'all';
 class WP_Error {public function __construct(private $code,private $message='',private $data=[]){}public function get_error_code(){return $this->code;}public function get_error_message(){return $this->message;}public function get_error_data(){return $this->data;}}
 class WP_REST_Response {public function __construct(public $data,public $status=200){}}
 class Request implements \ArrayAccess {
  public function __construct(private array $data=[]){} public function get_params(){return $this->data;}public function get_param($key){return $this->data[$key]??null;}
  public function offsetExists(mixed $o):bool{return isset($this->data[$o]);}public function offsetGet(mixed $o):mixed{return $this->data[$o]??null;}public function offsetSet(mixed $o,mixed $v):void{}public function offsetUnset(mixed $o):void{}
 }
 function is_wp_error($v){return $v instanceof WP_Error;}
 function register_rest_route($ns,$path,$args){$GLOBALS['routes'][$path][$args['methods']]=$args;}
 function register_graphql_field($type,$name,$args){$GLOBALS['graphql'][$type][$name]=$args;}
 function register_graphql_object_type($name,$args){$GLOBALS['objects'][$name]=$args;}
 function register_graphql_input_type($name,$args){$GLOBALS['inputs'][$name]=$args;}
 function register_graphql_enum_type(...$args){}
 function register_graphql_mutation($name,$args){$GLOBALS['mutations'][$name]=$args;}
 function get_current_user_id(){return $GLOBALS['uid'];}function is_user_logged_in(){return get_current_user_id()>0;}
 function wp_get_current_user(){return get_userdata(get_current_user_id());}function get_userdata($id){return $GLOBALS['users'][$id]??(object)['ID'=>0,'roles'=>[]];}
 function current_user_can($cap){return in_array($cap,$GLOBALS['caps'][get_current_user_id()]??[],true);}
 function get_user_meta($id,$key,$single=true){return $GLOBALS['um'][$id][$key]??'';}
 function get_post_meta($id,$key,$single=true){return $GLOBALS['pm'][$id][$key]??'';}
 function wp_slash($v){return is_array($v)?array_map('wp_slash',$v):(is_string($v)?addslashes($v):$v);}
 function unslash($v){return is_array($v)?array_map('unslash',$v):(is_string($v)?stripslashes($v):$v);}
 function update_post_meta($id,$key,$value,$prev=''){
  $GLOBALS['writes']++;if($GLOBALS['fail']===$key)return false;
  if($GLOBALS['fail']==='silent-'.$key)return 1;
  if($prev!==''&&get_post_meta($id,$key)!==$prev)return false;
  $v=unslash($value);if(get_post_meta($id,$key)===$v)return false;$GLOBALS['pm'][$id][$key]=$v;return 1;
 }
 function update_user_meta($id,$key,$value){$GLOBALS['writes']++;if($GLOBALS['fail']===$key)return false;if($GLOBALS['fail']==='silent-'.$key)return 1;$GLOBALS['um'][$id][$key]=unslash($value);return 1;}
 function add_post_meta($id,$key,$value,$unique=false){if($unique&&isset($GLOBALS['pm'][$id][$key]))return false;return update_post_meta($id,$key,$value);}
 function add_option($key,$value,$deprecated='',$autoload=null){if($GLOBALS['fail']==='lock-throw')throw new \RuntimeException('PRIVATE /filesystem');if(isset($GLOBALS['options'][$key])||$GLOBALS['fail']==='lock')return false;$GLOBALS['options'][$key]=$value;return true;}
 function delete_option($key){if($GLOBALS['fail']==='unlock-throw')throw new \RuntimeException('PRIVATE /filesystem');if($GLOBALS['fail']==='unlock')return false;unset($GLOBALS['options'][$key]);return true;}
 function get_post($id){return $GLOBALS['posts'][$id]??null;}
 function get_post_mime_type($id){return get_post($id)->post_mime_type??'';}
 function wp_get_attachment_image_url($id,$size){return $GLOBALS['urls'][$id]??'https://fixture.invalid/media-'.$id.'.png';}
 function wp_get_attachment_metadata($id){return $GLOBALS['fail']==='source-metadata'?false:['width'=>2,'height'=>2,'file'=>'fixture.png'];}
 function wp_get_attachment_url($id){return wp_get_attachment_image_url($id,'full');}
 function add_filter($tag,$callback,$priority=10,$accepted=1){$GLOBALS['filters'][$tag][$priority][spl_object_id($callback)]=[$callback,$accepted];}
 function remove_filter($tag,$callback,$priority=10){unset($GLOBALS['filters'][$tag][$priority][spl_object_id($callback)]);if(empty($GLOBALS['filters'][$tag][$priority]))unset($GLOBALS['filters'][$tag][$priority]);if(empty($GLOBALS['filters'][$tag]))unset($GLOBALS['filters'][$tag]);}
 function wp_update_post($data,$error=false){
  $GLOBALS['writes']++;if($GLOBALS['fail']==='post')return new WP_Error('db','PRIVATE /filesystem');if($GLOBALS['fail']==='post-zero')return 0;
  $id=$data['ID'];$row=array_merge(wp_slash((array)get_post($id)),$data);
  if($row['post_status']==='pending'&&!current_user_can('publish_post'))$row['post_name']='';
  foreach($GLOBALS['filters']['wp_insert_post_data']??[] as $callbacks)foreach($callbacks as [$fn,$accepted])$row=$fn($row,$data,$data,true);
  foreach($row as $key=>$value)$GLOBALS['posts'][$id]->$key=unslash($value);return $id;
 }
 function wp_get_post_terms($id,$tax){return [];}
 function wp_delete_attachment(...$args){$GLOBALS['deleted']++;throw new \RuntimeException('Must never delete a file');}
 function do_action(...$args){$GLOBALS['events'][]=$args;}
 function __return_true(){return true;}
 function get_page_by_path(...$args){return get_post(20);}
 function current_time(...$args){return '2026-10-21 00:00:00';}
 // Core persistence is stubbed, not called. Decode really uses GD, never a permissive fake.
 function wp_get_image_editor($path){
  $GLOBALS['decodes']++;if($GLOBALS['fail']==='decoder')return new WP_Error('decode','PRIVATE /filesystem');
  $image=@imagecreatefromstring(file_get_contents($path));if(!$image)return new WP_Error('decode');
  $size=['width'=>imagesx($image),'height'=>imagesy($image)];imagedestroy($image);
  return new class($size){public function __construct(private $size){}public function get_size(){return $this->size;}};
 }
 function media_handle_upload($field,$parent,$post_data=[],$overrides=[]){
  $GLOBALS['persist_calls']++;$GLOBALS['persist_args']=[$field,$parent,$post_data,$overrides];
  if($GLOBALS['fail']==='storage-throw')throw new \RuntimeException('PRIVATE /filesystem');
  if($GLOBALS['fail']==='storage')return new WP_Error('upload','PRIVATE /filesystem');if($GLOBALS['fail']==='storage-zero')return 0;
  $id=90;$GLOBALS['posts'][$id]=(object)['ID'=>$id,'post_type'=>'attachment','post_author'=>$post_data['post_author']??get_current_user_id(),'post_status'=>'inherit','post_mime_type'=>$GLOBALS['detected_mime']??'image/png'];
  if($GLOBALS['fail']==='storage-foreign')$GLOBALS['posts'][$id]->post_author=1;
  return $id;
 }
 function reset_fixture(){
  $GLOBALS['uid']=2;$GLOBALS['fail']='';$GLOBALS['uploaded']=true;$GLOBALS['writes']=0;$GLOBALS['persist_calls']=0;$GLOBALS['decodes']=0;$GLOBALS['deleted']=0;$GLOBALS['events']=[];$GLOBALS['options']=[];$GLOBALS['filters']=[];$GLOBALS['urls']=[];$GLOBALS['detected_mime']='image/png';
  $GLOBALS['caps']=[1=>['nahan_client'],2=>['nahan_specialist','nahan_edit_own_profile'],3=>['nahan_specialist','nahan_edit_own_profile']];
  $GLOBALS['users']=[1=>(object)['ID'=>1,'roles'=>['nahan_client'],'display_name'=>'Client'],2=>(object)['ID'=>2,'roles'=>['nahan_specialist'],'display_name'=>'Owner'],3=>(object)['ID'=>3,'roles'=>['nahan_specialist'],'display_name'=>'Other']];
  $GLOBALS['um']=[2=>['nahan_specialist_post'=>20],3=>['nahan_specialist_post'=>21]];
  $GLOBALS['posts']=[20=>(object)['ID'=>20,'post_author'=>2,'post_type'=>'nahan_specialist','post_name'=>'stable','post_title'=>'Trade','post_status'=>'draft','post_password'=>'','post_content'=>''],21=>(object)['ID'=>21,'post_author'=>3,'post_type'=>'nahan_specialist','post_name'=>'other','post_title'=>'Other','post_status'=>'draft','post_password'=>'']];
  $GLOBALS['pm']=[20=>['user'=>2,'is_verified'=>1],21=>['user'=>3]];
  for($id=30;$id<=54;$id++){ $GLOBALS['posts'][$id]=(object)['ID'=>$id,'post_type'=>'attachment','post_author'=>2,'post_status'=>'inherit','post_mime_type'=>'image/png'];$GLOBALS['pm'][$id]=['_nahan_media_owner'=>2,'_nahan_media_purpose'=>'public-portfolio']; }
  $_FILES=[];
 }
 $assertions=0;$failures=[];
 function check($ok,$message){$GLOBALS['assertions']++;if(!$ok)$GLOBALS['failures'][]=$message;}
 function route($path,$method,$data=[]){
  $r=$GLOBALS['routes'][$path][$method]??null;if(!$r){check(false,'Missing registered '.$method.' '.$path);return new WP_Error('missing',[''],['status'=>599]);}
  $req=new Request($data);$permission=$r['permission_callback']($req);if(is_wp_error($permission))return $permission;if($permission!==true)return new WP_Error('forbidden','',['status'=>403]);return $r['callback']($req);
 }
 function status($r){return is_wp_error($r)?($r->get_error_data()['status']??400):$r->status;}
 function code($r){return is_wp_error($r)?$r->get_error_code():($r->data['error']['code']??'');}
 function data($r){return is_wp_error($r)?[]:($r->data['data']??[]);}
