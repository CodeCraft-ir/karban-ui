{
  "scope": "Task9A source-only; no runtime/config values",
  "sources": {
    "includes/auth/class-sms-service.php": "<?php\nnamespace Nahan\\Core\\Auth;\n\nuse Nahan\\Core\\Admin\\Settings;\nuse Nahan\\Core\\Helpers;\nuse WP_Error;\n\nif ( ! defined( 'ABSPATH' ) ) {\n\texit;\n}\n\nfinal class SmsService {\n\n\tpublic function __construct( private Settings $settings ) {}\n\n\t/**\n\t * @return true|WP_Error\n\t */\n\tpublic function send_otp( string $phone, string $code ) {\n\t\treturn $this->send_by_pattern(\n\t\t\t$phone,\n\t\t\t(string) $this->settings->get( 'sms_kavenegar_pattern', '' ),\n\t\t\t[ 'code' => $code ]\n\t\t);\n\t}\n\n\tpublic function send_text( string $phone, string $text ) {\n\t\t$driver = (string) $this->settings->get( 'sms_driver', 'kavenegar' );\n\n\t\tif ( 'log' === $driver ) {\n\t\t\terror_log( \"[Nahan SMS:log] to={$phone} text={$text}\" );\n\t\t\treturn true;\n\t\t}\n\n\t\tif ( 'kavenegar' === $driver ) {\n\t\t\treturn $this->kavenegar_send( $phone, $text );\n\t\t}\n\n\t\treturn new WP_Error( 'sms_driver_unknown', 'درایور پیامک پشتیبانی نمی‌شود.' );\n\t}\n\n\tpublic function send_by_pattern( string $phone, string $template, array $tokens ) {\n\t\t$driver = (string) $this->settings->get( 'sms_driver', 'kavenegar' );\n\n\t\tif ( 'log' === $driver || empty( $template ) ) {\n\t\t\terror_log( '[Nahan SMS:log] to=' . $phone . ' tokens=' . wp_json_encode( $tokens ) );\n\t\t\treturn true;\n\t\t}\n\n\t\tif ( 'kavenegar' === $driver ) {\n\t\t\treturn $this->kavenegar_pattern( $phone, $template, $tokens );\n\t\t}\n\n\t\treturn new WP_Error( 'sms_driver_unknown', 'درایور پیامک پشتیبانی نمی‌شود.' );\n\t}\n\n\tprivate function kavenegar_send( string $phone, string $text ) {\n\t\t$apikey = (string) $this->settings->get( 'sms_kavenegar_apikey', '' );\n\t\t$sender = (string) $this->settings->get( 'sms_kavenegar_sender', '' );\n\t\tif ( empty( $apikey ) ) {\n\t\t\treturn new WP_Error( 'sms_misconfigured', 'کلید Kavenegar تنظیم نشده.' );\n\t\t}\n\n\t\t$url  = \"https://api.kavenegar.com/v1/{$apikey}/sms/send.json\";\n\t\t$body = [\n\t\t\t'receptor' => Helpers::to_english_digits( $phone ),\n\t\t\t'message'  => $text,\n\t\t];\n\t\tif ( $sender ) {\n\t\t\t$body['sender'] = $sender;\n\t\t}\n\n\t\t$resp = wp_remote_post( $url, [\n\t\t\t'timeout' => 10,\n\t\t\t'body'    => $body,\n\t\t] );\n\n\t\treturn $this->parse_kavenegar_response( $resp );\n\t}\n\n\tprivate function kavenegar_pattern( string $phone, string $template, array $tokens ) {\n\t\t$apikey = (string) $this->settings->get( 'sms_kavenegar_apikey', '' );\n\t\tif ( empty( $apikey ) ) {\n\t\t\treturn new WP_Error( 'sms_misconfigured', 'کلید Kavenegar تنظیم نشده.' );\n\t\t}\n\n\t\t$body = [\n\t\t\t'receptor' => Helpers::to_english_digits( $phone ),\n\t\t\t'template' => $template,\n\t\t];\n\t\t$i = 1;\n\t\tforeach ( $tokens as $value ) {\n\t\t\t$body[ 'token' . ( 1 === $i ? '' : (string) $i ) ] = (string) $value;\n\t\t\t$i++;\n\t\t\tif ( $i > 10 ) {\n\t\t\t\tbreak;\n\t\t\t}\n\t\t}\n\n\t\t$url  = \"https://api.kavenegar.com/v1/{$apikey}/verify/lookup.json\";\n\t\t$resp = wp_remote_post( $url, [\n\t\t\t'timeout' => 10,\n\t\t\t'body'    => $body,\n\t\t] );\n\n\t\treturn $this->parse_kavenegar_response( $resp );\n\t}\n\n\tprivate function parse_kavenegar_response( $resp ) {\n\t\tif ( is_wp_error( $resp ) ) {\n\t\t\treturn $resp;\n\t\t}\n\t\t$code = wp_remote_retrieve_response_code( $resp );\n\t\t$body = json_decode( wp_remote_retrieve_body( $resp ), true );\n\t\tif ( 200 === (int) $code && isset( $body['return']['status'] ) && 200 === (int) $body['return']['status'] ) {\n\t\t\treturn true;\n\t\t}\n\t\t$message = $body['return']['message'] ?? 'خطا در ارسال پیامک';\n\t\treturn new WP_Error( 'sms_provider_error', $message, [ 'http' => $code, 'body' => $body ] );\n\t}\n}\n",
    "includes/auth/class-otp-manager.php": "<?php\nnamespace Nahan\\Core\\Auth;\n\nuse Nahan\\Core\\Helpers;\nuse Nahan\\Core\\LocalDevelopmentGate;\nuse Nahan\\Core\\RateLimiter;\nuse WP_Error;\n\nif ( ! defined( 'ABSPATH' ) ) {\n\texit;\n}\n\nfinal class OtpManager {\n\n\tprivate LocalDevelopmentGate $local_development;\n\tprivate OtpSchema $schema;\n\tprivate ?\\Closure $send_otp;\n\n\tpublic function __construct( private SmsService $sms, ?LocalDevelopmentGate $local_development = null, ?OtpSchema $schema = null, ?callable $send_otp = null ) {\n\t\t$this->local_development = $local_development ?? new LocalDevelopmentGate();\n\t\t$this->schema = $schema ?? new OtpSchema();\n\t\t$this->send_otp = null === $send_otp ? null : \\Closure::fromCallable( $send_otp );\n\t}\n\n\t/** @return array|WP_Error ['tracking_code' => ..., 'expires_in' => ..., 'delivery_mode' => ..., 'code_length' => ...] */\n\tpublic function request( string $phone, string $ip ) {\n\t\t$phone = Helpers::normalize_iranian_phone( $phone );\n\t\tif ( ! $phone ) {\n\t\t\treturn new WP_Error( 'invalid_phone', 'شماره موبایل معتبر نیست.', [ 'status' => 422 ] );\n\t\t}\n\t\t$ttl = (int) Helpers::get_setting( 'otp_ttl', 120 );\n\t\t$throttle = (int) Helpers::get_setting( 'otp_throttle_window', 60 );\n\t\tif ( ! RateLimiter::attempt( 'otp_request_phone', $phone, 5, 600 ) ) return new WP_Error( 'otp_rate_limited', 'تعداد درخواست‌ها زیاد است. کمی صبر کنید.', [ 'status' => 429 ] );\n\t\tif ( ! RateLimiter::attempt( 'otp_request_ip', $ip, 10, 600 ) ) return new WP_Error( 'otp_rate_limited_ip', 'تعداد درخواست از این IP زیاد است.', [ 'status' => 429 ] );\n\t\tif ( ! RateLimiter::attempt( 'otp_throttle', $phone, 1, $throttle ) ) return new WP_Error( 'otp_throttled', \"بین درخواست‌ها حداقل {$throttle} ثانیه صبر کنید.\", [ 'status' => 429 ] );\n\n\t\t$local_simulated = $this->local_development->is_otp_simulation_enabled();\n\t\t$provenance_ready = $this->schema->is_ready();\n\t\tif ( $local_simulated && ! $provenance_ready ) return new WP_Error( 'otp_local_configuration_unavailable', 'ورود آزمایشی محلی آماده نیست.', [ 'status' => 503 ] );\n\t\tglobal $wpdb;\n\t\t$table = Helpers::table( 'otp_codes' );\n\t\t$delivery_mode = $local_simulated ? 'local_simulated' : 'sms';\n\t\t$code_length = $local_simulated ? 6 : 5;\n\t\t$code = $local_simulated ? '145632' : $this->generate_code();\n\t\t$tracking = wp_generate_uuid4();\n\t\t$record = [ 'phone' => $phone, 'code_hash' => Helpers::hash_token( $code ), 'tracking_code' => $tracking, 'attempts' => 0, 'ip_address' => $ip, 'user_agent' => Helpers::user_agent(), 'created_at' => Helpers::now_mysql(), 'expires_at' => Helpers::add_seconds_mysql( $ttl ) ];\n\t\t$format = [ '%s', '%s', '%s', '%d', '%s', '%s', '%s', '%s' ];\n\t\tif ( $provenance_ready ) { $record['delivery_mode'] = $delivery_mode; $record['code_length'] = $code_length; $format[] = '%s'; $format[] = '%d'; }\n\t\tif ( 1 !== (int) $wpdb->insert( $table, $record, $format ) ) return new WP_Error( 'otp_storage_unavailable', 'درخواست تأیید اکنون در دسترس نیست.', [ 'status' => 503 ] );\n\t\tif ( ! $local_simulated ) { $sent = null === $this->send_otp ? $this->sms->send_otp( $phone, $code ) : ( $this->send_otp )( $phone, $code ); if ( is_wp_error( $sent ) ) return $sent; }\n\t\treturn [ 'tracking_code' => $tracking, 'expires_in' => $ttl, 'delivery_mode' => $delivery_mode, 'code_length' => $code_length ];\n\t}\n\n\t/** @return string|WP_Error normalized phone on success. */\n\tpublic function verify( string $tracking_code, string $code ) {\n\t\t$context = $this->verify_with_context( $tracking_code, $code );\n\t\treturn is_wp_error( $context ) ? $context : $context['phone'];\n\t}\n\n\t/**\n\t * Returns persisted, trusted context after the same atomic OTP consume path.\n\t * $before_consume lets a public caller reject a local credential prerequisite\n\t * without consuming a valid challenge.\n\t *\n\t * @return array{phone:string,delivery_mode:string,code_length:int}|WP_Error\n\t */\n\tpublic function verify_with_context( string $tracking_code, string $code, ?callable $before_consume = null ) {\n\t\tglobal $wpdb;\n\t\t$table = Helpers::table( 'otp_codes' );\n\t\t$row = $wpdb->get_row( $wpdb->prepare( \"SELECT * FROM {$table} WHERE tracking_code = %s\", $tracking_code ), ARRAY_A );\n\t\tif ( ! $row ) return new WP_Error( 'otp_not_found', 'کد درخواست یافت نشد.', [ 'status' => 404 ] );\n\t\tif ( ! empty( $row['consumed_at'] ) ) return new WP_Error( 'otp_consumed', 'این کد قبلا استفاده شده.', [ 'status' => 410 ] );\n\t\tif ( strtotime( $row['expires_at'] . ' UTC' ) < time() ) return new WP_Error( 'otp_expired', 'کد منقضی شده است.', [ 'status' => 410 ] );\n\t\t$max_attempts = (int) Helpers::get_setting( 'otp_max_attempts', 5 );\n\t\tif ( (int) $row['attempts'] >= $max_attempts ) return new WP_Error( 'otp_too_many_attempts', 'تعداد تلاش بیش از حد مجاز.', [ 'status' => 429 ] );\n\t\t$delivery_mode = $row['delivery_mode'] ?? 'sms';\n\t\t$code_length = isset( $row['code_length'] ) ? (int) $row['code_length'] : 5;\n\t\tif ( ( 'sms' !== $delivery_mode || 5 !== $code_length ) && ( 'local_simulated' !== $delivery_mode || 6 !== $code_length ) ) return new WP_Error( 'otp_invalid', 'کد وارد شده اشتباه است.', [ 'status' => 422 ] );\n\t\tif ( 'local_simulated' === $delivery_mode && ! $this->local_development->is_otp_simulation_enabled() ) return new WP_Error( 'otp_local_unavailable', 'ورود آزمایشی محلی در دسترس نیست.', [ 'status' => 403 ] );\n\t\t$code = Helpers::to_english_digits( $code );\n\t\tif ( $code_length !== strlen( $code ) || ! ctype_digit( $code ) ) return new WP_Error( 'otp_invalid', 'کد وارد شده اشتباه است.', [ 'status' => 422 ] );\n\t\tif ( ! hash_equals( $row['code_hash'], Helpers::hash_token( $code ) ) ) {\n\t\t\t$affected = $wpdb->query( $wpdb->prepare( \"UPDATE {$table} SET attempts = attempts + 1 WHERE id = %d AND consumed_at IS NULL AND attempts < %d\", (int) $row['id'], $max_attempts ) );\n\t\t\tif ( 1 !== (int) $affected ) return new WP_Error( 'otp_too_many_attempts', 'تعداد تلاش بیش از حد مجاز.', [ 'status' => 429 ] );\n\t\t\treturn new WP_Error( 'otp_invalid', 'کد وارد شده اشتباه است.', [ 'status' => 422 ] );\n\t\t}\n\t\t$context = [ 'phone' => (string) $row['phone'], 'delivery_mode' => (string) $delivery_mode, 'code_length' => $code_length ];\n\t\tif ( null !== $before_consume ) { $allowed = $before_consume( $context ); if ( is_wp_error( $allowed ) ) return $allowed; if ( true !== $allowed ) return new WP_Error( 'otp_unavailable', 'ورود اکنون در دسترس نیست.', [ 'status' => 503 ] ); }\n\t\t$consumed = $wpdb->query( $wpdb->prepare( \"UPDATE {$table} SET consumed_at = %s WHERE id = %d AND consumed_at IS NULL AND attempts < %d AND expires_at >= UTC_TIMESTAMP()\", Helpers::now_mysql(), (int) $row['id'], $max_attempts ) );\n\t\tif ( 1 !== (int) $consumed ) return new WP_Error( 'otp_consumed', 'این کد قبلا استفاده شده.', [ 'status' => 410 ] );\n\t\tRateLimiter::clear( 'otp_throttle', $row['phone'] ); RateLimiter::clear( 'otp_request_phone', $row['phone'] );\n\t\treturn $context;\n\t}\n\n\tpublic function cleanup_expired(): void { global $wpdb; $wpdb->query( \"DELETE FROM \" . Helpers::table( 'otp_codes' ) . \" WHERE expires_at < UTC_TIMESTAMP() - INTERVAL 1 DAY\" ); }\n\tprivate function generate_code(): string { $digits = ''; for ( $i = 0; $i < 5; $i++ ) $digits .= (string) random_int( 0, 9 ); return $digits; }\n}\n",
    "includes/admin/class-admin-panel.php": "<?php\nnamespace Nahan\\Core\\Admin;\n\nif ( ! defined( 'ABSPATH' ) ) {\n\texit;\n}\n\nfinal class AdminPanel {\n\n\tpublic function __construct( private Settings $settings ) {}\n\n\tpublic function register(): void {\n\t\tadd_action( 'admin_menu', [ $this, 'add_menus' ] );\n\t\tadd_action( 'admin_init', [ $this, 'register_settings' ] );\n\t\tadd_action( 'admin_enqueue_scripts', [ $this, 'assets' ] );\n\t}\n\n\tpublic function add_menus(): void {\n\t\tadd_menu_page(\n\t\t\t'پلتفرم نهان',\n\t\t\t'نهان',\n\t\t\t'nahan_manage_verifications',\n\t\t\t'nahan-dashboard',\n\t\t\t[ $this, 'render_dashboard' ],\n\t\t\t'dashicons-businessperson',\n\t\t\t20\n\t\t);\n\t\tadd_submenu_page(\n\t\t\t'nahan-dashboard',\n\t\t\t'داشبورد',\n\t\t\t'داشبورد',\n\t\t\t'nahan_manage_verifications',\n\t\t\t'nahan-dashboard',\n\t\t\t[ $this, 'render_dashboard' ]\n\t\t);\n\t\tadd_submenu_page(\n\t\t\t'nahan-dashboard',\n\t\t\t'تنظیمات نهان',\n\t\t\t'تنظیمات',\n\t\t\t'manage_options',\n\t\t\t'nahan-settings',\n\t\t\t[ $this, 'render_settings' ]\n\t\t);\n\t}\n\n\tpublic function assets( string $hook ): void {\n\t\tif ( strpos( $hook, 'nahan' ) === false ) {\n\t\t\treturn;\n\t\t}\n\t\twp_enqueue_style( 'nahan-admin', NAHAN_CORE_URL . 'assets/admin.css', [], NAHAN_CORE_VERSION );\n\t}\n\n\tpublic function render_dashboard(): void {\n\t\tif ( ! current_user_can( 'nahan_manage_verifications' ) ) {\n\t\t\twp_die( 'دسترسی ندارید.' );\n\t\t}\n\t\tglobal $wpdb;\n\t\t$specialists  = (int) wp_count_posts( 'nahan_specialist' )->publish;\n\t\t$projects     = (int) wp_count_posts( 'nahan_project' )->publish;\n\t\t$pending_ver  = (int) $wpdb->get_var(\n\t\t\t\"SELECT COUNT(*) FROM {$wpdb->posts} p\n\t\t\tJOIN {$wpdb->postmeta} m ON m.post_id=p.ID AND m.meta_key='status' AND m.meta_value='pending'\n\t\t\tWHERE p.post_type='nahan_verification' AND p.post_status='publish'\"\n\t\t);\n\t\t$open_reports = (int) $wpdb->get_var(\n\t\t\t\"SELECT COUNT(*) FROM {$wpdb->posts} p\n\t\t\tJOIN {$wpdb->postmeta} m ON m.post_id=p.ID AND m.meta_key='status' AND m.meta_value='open'\n\t\t\tWHERE p.post_type='nahan_report' AND p.post_status='publish'\"\n\t\t);\n\t\t$active_subs = (int) $wpdb->get_var(\n\t\t\t\"SELECT COUNT(*) FROM {$wpdb->prefix}nahan_subscriptions WHERE status='active' AND ends_at > UTC_TIMESTAMP()\"\n\t\t);\n\t\techo '<div class=\"wrap\"><h1>داشبورد نهان</h1>';\n\t\techo '<div class=\"nahan-grid\" style=\"display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:16px;margin-top:20px\">';\n\t\tprintf( '<div class=\"card\" style=\"padding:16px;background:#fff;border:1px solid #ddd;border-radius:8px\"><h3>متخصصین</h3><p style=\"font-size:28px;margin:0\">%d</p></div>', $specialists );\n\t\tprintf( '<div class=\"card\" style=\"padding:16px;background:#fff;border:1px solid #ddd;border-radius:8px\"><h3>پروژه‌ها</h3><p style=\"font-size:28px;margin:0\">%d</p></div>', $projects );\n\t\tprintf( '<div class=\"card\" style=\"padding:16px;background:#fff;border:1px solid #ddd;border-radius:8px\"><h3>تایید هویت در انتظار</h3><p style=\"font-size:28px;margin:0;color:#d63638\">%d</p></div>', $pending_ver );\n\t\tprintf( '<div class=\"card\" style=\"padding:16px;background:#fff;border:1px solid #ddd;border-radius:8px\"><h3>گزارش‌های باز</h3><p style=\"font-size:28px;margin:0;color:#d63638\">%d</p></div>', $open_reports );\n\t\tprintf( '<div class=\"card\" style=\"padding:16px;background:#fff;border:1px solid #ddd;border-radius:8px\"><h3>اشتراک‌های فعال</h3><p style=\"font-size:28px;margin:0;color:#2271b1\">%d</p></div>', $active_subs );\n\t\techo '</div>';\n\t\techo '<p style=\"margin-top:20px\"><a class=\"button button-primary\" href=\"' . esc_url( admin_url( 'edit.php?post_type=nahan_verification' ) ) . '\">صف بررسی تایید هویت</a> ';\n\t\techo '<a class=\"button\" href=\"' . esc_url( admin_url( 'edit.php?post_type=nahan_report' ) ) . '\">گزارش‌های تخلف</a></p>';\n\t\techo '</div>';\n\t}\n\n\tpublic function register_settings(): void {\n\t\t$keys = [\n\t\t\t'sms_driver', 'sms_kavenegar_apikey', 'sms_kavenegar_pattern', 'sms_kavenegar_sender',\n\t\t\t'jwt_access_ttl', 'jwt_refresh_ttl',\n\t\t\t'otp_ttl', 'otp_max_attempts', 'otp_throttle_window',\n\t\t\t'payment_gateway', 'zarinpal_merchant_id', 'zarinpal_sandbox',\n\t\t\t'shahkar_enabled', 'shahkar_endpoint', 'shahkar_token',\n\t\t\t'lead_default_price', 'default_city_slug',\n\t\t];\n\t\tforeach ( $keys as $k ) {\n\t\t\tregister_setting( 'nahan-settings', \"nahan_$k\" );\n\t\t}\n\t\tregister_setting( 'nahan-settings', 'nahan_subscription_plans' );\n\t}\n\n\tpublic function render_settings(): void {\n\t\tif ( ! current_user_can( 'manage_options' ) ) {\n\t\t\twp_die( 'دسترسی ندارید.' );\n\t\t}\n\t\techo '<div class=\"wrap\"><h1>تنظیمات نهان</h1><form method=\"post\" action=\"options.php\">';\n\t\tsettings_fields( 'nahan-settings' );\n\n\t\t$row = static function ( string $label, string $key, string $type = 'text', $default = '' ) {\n\t\t\t$val = esc_attr( (string) get_option( \"nahan_$key\", $default ) );\n\t\t\t$id  = \"nahan_$key\";\n\t\t\techo '<tr><th><label for=\"' . esc_attr( $id ) . '\">' . esc_html( $label ) . '</label></th><td>';\n\t\t\tif ( 'textarea' === $type ) {\n\t\t\t\techo '<textarea id=\"' . esc_attr( $id ) . '\" name=\"' . esc_attr( $id ) . '\" rows=\"3\" cols=\"60\">' . esc_textarea( $val ) . '</textarea>';\n\t\t\t} elseif ( 'checkbox' === $type ) {\n\t\t\t\t$checked = checked( '1', $val, false );\n\t\t\t\techo '<input id=\"' . esc_attr( $id ) . '\" type=\"checkbox\" name=\"' . esc_attr( $id ) . '\" value=\"1\" ' . $checked . ' />';\n\t\t\t} elseif ( 'number' === $type ) {\n\t\t\t\techo '<input id=\"' . esc_attr( $id ) . '\" type=\"number\" name=\"' . esc_attr( $id ) . '\" value=\"' . esc_attr( $val ) . '\" class=\"regular-text\" />';\n\t\t\t} else {\n\t\t\t\techo '<input id=\"' . esc_attr( $id ) . '\" type=\"text\" name=\"' . esc_attr( $id ) . '\" value=\"' . esc_attr( $val ) . '\" class=\"regular-text\" />';\n\t\t\t}\n\t\t\techo '</td></tr>';\n\t\t};\n\n\t\techo '<h2>پیامک</h2><table class=\"form-table\">';\n\t\t$row( 'درایور پیامک (kavenegar/log)', 'sms_driver', 'text', 'kavenegar' );\n\t\t$row( 'Kavenegar API Key', 'sms_kavenegar_apikey' );\n\t\t$row( 'Kavenegar Pattern OTP', 'sms_kavenegar_pattern' );\n\t\t$row( 'Kavenegar Sender', 'sms_kavenegar_sender' );\n\t\techo '</table>';\n\n\t\techo '<h2>JWT و OTP</h2><table class=\"form-table\">';\n\t\t$row( 'JWT Access TTL (ثانیه)', 'jwt_access_ttl', 'number', 900 );\n\t\t$row( 'JWT Refresh TTL (ثانیه)', 'jwt_refresh_ttl', 'number', 2592000 );\n\t\t$row( 'OTP TTL (ثانیه)', 'otp_ttl', 'number', 120 );\n\t\t$row( 'OTP Max Attempts', 'otp_max_attempts', 'number', 5 );\n\t\t$row( 'OTP Throttle Window (ثانیه)', 'otp_throttle_window', 'number', 60 );\n\t\techo '</table>';\n\n\t\techo '<h2>درگاه پرداخت</h2><table class=\"form-table\">';\n\t\t$row( 'درگاه (zarinpal)', 'payment_gateway', 'text', 'zarinpal' );\n\t\t$row( 'مرچنت کد زرین‌پال', 'zarinpal_merchant_id' );\n\t\t$row( 'حالت Sandbox', 'zarinpal_sandbox', 'checkbox', '1' );\n\t\techo '</table>';\n\n\t\techo '<h2>شاهکار</h2><table class=\"form-table\">';\n\t\t$row( 'فعال', 'shahkar_enabled', 'checkbox', '0' );\n\t\t$row( 'Endpoint', 'shahkar_endpoint' );\n\t\t$row( 'Token', 'shahkar_token' );\n\t\techo '</table>';\n\n\t\techo '<h2>متفرقه</h2><table class=\"form-table\">';\n\t\t$row( 'قیمت پیش‌فرض Lead (تومان)', 'lead_default_price', 'number', 50000 );\n\t\t$row( 'Slug شهر پیش‌فرض', 'default_city_slug', 'text', 'kashan' );\n\t\techo '</table>';\n\n\t\tsubmit_button();\n\t\techo '</form></div>';\n\t}\n}\n",
    "includes/admin/class-settings.php": "<?php\nnamespace Nahan\\Core\\Admin;\n\nuse Nahan\\Core\\Helpers;\n\nif ( ! defined( 'ABSPATH' ) ) {\n\texit;\n}\n\nfinal class Settings {\n\n\tpublic function get( string $key, $default = null ) {\n\t\treturn Helpers::get_setting( $key, $default );\n\t}\n\n\tpublic function set( string $key, $value ): void {\n\t\tupdate_option( \"nahan_$key\", $value );\n\t}\n}\n"
  },
