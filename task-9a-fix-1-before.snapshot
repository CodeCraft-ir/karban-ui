{
  "scope": "Task9A fix-1 source-only preprocessing correction; no runtime/config values",
  "sources": {
    "/Applications/XAMPP/xamppfiles/htdocs/karban/wp-content/plugins/karban-core/includes/admin/class-admin-panel.php": "<?php\nnamespace Nahan\\Core\\Admin;\n\nif ( ! defined( 'ABSPATH' ) ) {\n\texit;\n}\n\nfinal class AdminPanel {\n\n\tprivate const SMS_KEYS = [\n\t\t'sms_driver', 'sms_kavenegar_apikey', 'sms_kavenegar_pattern', 'sms_kavenegar_sender',\n\t\t'sms_faraz_apikey', 'sms_faraz_pattern_code', 'sms_faraz_originator', 'sms_faraz_variable',\n\t];\n\tprivate const SMS_SECRETS = [ 'sms_faraz_apikey', 'sms_kavenegar_apikey' ];\n\t/** Re-entrant Settings API sanitization during the checked, non-autoloading write. */\n\tprivate array $saving_sms = [];\n\n\tpublic function __construct( private Settings $settings ) {}\n\n\tpublic function register(): void {\n\t\tadd_action( 'admin_menu', [ $this, 'add_menus' ] );\n\t\tadd_action( 'admin_init', [ $this, 'register_settings' ] );\n\t\tadd_action( 'admin_enqueue_scripts', [ $this, 'assets' ] );\n\t}\n\n\tpublic function add_menus(): void {\n\t\tadd_menu_page(\n\t\t\t'پلتفرم نهان',\n\t\t\t'نهان',\n\t\t\t'nahan_manage_verifications',\n\t\t\t'nahan-dashboard',\n\t\t\t[ $this, 'render_dashboard' ],\n\t\t\t'dashicons-businessperson',\n\t\t\t20\n\t\t);\n\t\tadd_submenu_page(\n\t\t\t'nahan-dashboard',\n\t\t\t'داشبورد',\n\t\t\t'داشبورد',\n\t\t\t'nahan_manage_verifications',\n\t\t\t'nahan-dashboard',\n\t\t\t[ $this, 'render_dashboard' ]\n\t\t);\n\t\tadd_submenu_page(\n\t\t\t'nahan-dashboard',\n\t\t\t'تنظیمات نهان',\n\t\t\t'تنظیمات',\n\t\t\t'manage_options',\n\t\t\t'nahan-settings',\n\t\t\t[ $this, 'render_settings' ]\n\t\t);\n\t}\n\n\tpublic function assets( string $hook ): void {\n\t\tif ( strpos( $hook, 'nahan' ) === false ) {\n\t\t\treturn;\n\t\t}\n\t\twp_enqueue_style( 'nahan-admin', NAHAN_CORE_URL . 'assets/admin.css', [], NAHAN_CORE_VERSION );\n\t}\n\n\tpublic function render_dashboard(): void {\n\t\tif ( ! current_user_can( 'nahan_manage_verifications' ) ) {\n\t\t\twp_die( 'دسترسی ندارید.' );\n\t\t}\n\t\tglobal $wpdb;\n\t\t$specialists  = (int) wp_count_posts( 'nahan_specialist' )->publish;\n\t\t$projects     = (int) wp_count_posts( 'nahan_project' )->publish;\n\t\t$pending_ver  = (int) $wpdb->get_var(\n\t\t\t\"SELECT COUNT(*) FROM {$wpdb->posts} p\n\t\t\tJOIN {$wpdb->postmeta} m ON m.post_id=p.ID AND m.meta_key='status' AND m.meta_value='pending'\n\t\t\tWHERE p.post_type='nahan_verification' AND p.post_status='publish'\"\n\t\t);\n\t\t$open_reports = (int) $wpdb->get_var(\n\t\t\t\"SELECT COUNT(*) FROM {$wpdb->posts} p\n\t\t\tJOIN {$wpdb->postmeta} m ON m.post_id=p.ID AND m.meta_key='status' AND m.meta_value='open'\n\t\t\tWHERE p.post_type='nahan_report' AND p.post_status='publish'\"\n\t\t);\n\t\t$active_subs = (int) $wpdb->get_var(\n\t\t\t\"SELECT COUNT(*) FROM {$wpdb->prefix}nahan_subscriptions WHERE status='active' AND ends_at > UTC_TIMESTAMP()\"\n\t\t);\n\t\techo '<div class=\"wrap\"><h1>داشبورد نهان</h1>';\n\t\techo '<div class=\"nahan-grid\" style=\"display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:16px;margin-top:20px\">';\n\t\tprintf( '<div class=\"card\" style=\"padding:16px;background:#fff;border:1px solid #ddd;border-radius:8px\"><h3>متخصصین</h3><p style=\"font-size:28px;margin:0\">%d</p></div>', $specialists );\n\t\tprintf( '<div class=\"card\" style=\"padding:16px;background:#fff;border:1px solid #ddd;border-radius:8px\"><h3>پروژه‌ها</h3><p style=\"font-size:28px;margin:0\">%d</p></div>', $projects );\n\t\tprintf( '<div class=\"card\" style=\"padding:16px;background:#fff;border:1px solid #ddd;border-radius:8px\"><h3>تایید هویت در انتظار</h3><p style=\"font-size:28px;margin:0;color:#d63638\">%d</p></div>', $pending_ver );\n\t\tprintf( '<div class=\"card\" style=\"padding:16px;background:#fff;border:1px solid #ddd;border-radius:8px\"><h3>گزارش‌های باز</h3><p style=\"font-size:28px;margin:0;color:#d63638\">%d</p></div>', $open_reports );\n\t\tprintf( '<div class=\"card\" style=\"padding:16px;background:#fff;border:1px solid #ddd;border-radius:8px\"><h3>اشتراک‌های فعال</h3><p style=\"font-size:28px;margin:0;color:#2271b1\">%d</p></div>', $active_subs );\n\t\techo '</div>';\n\t\techo '<p style=\"margin-top:20px\"><a class=\"button button-primary\" href=\"' . esc_url( admin_url( 'edit.php?post_type=nahan_verification' ) ) . '\">صف بررسی تایید هویت</a> ';\n\t\techo '<a class=\"button\" href=\"' . esc_url( admin_url( 'edit.php?post_type=nahan_report' ) ) . '\">گزارش‌های تخلف</a></p>';\n\t\techo '</div>';\n\t}\n\n\tpublic function register_settings(): void {\n\t\tforeach ( self::SMS_KEYS as $key ) {\n\t\t\tregister_setting( 'nahan-settings', \"nahan_$key\", [\n\t\t\t\t'type' => 'string',\n\t\t\t\t'show_in_rest' => false,\n\t\t\t\t'sanitize_callback' => fn( $value ) => $this->sanitize_sms_setting( $key, $value ),\n\t\t\t] );\n\t\t}\n\t\t$keys = [\n\t\t\t'jwt_access_ttl', 'jwt_refresh_ttl',\n\t\t\t'otp_ttl', 'otp_max_attempts', 'otp_throttle_window',\n\t\t\t'payment_gateway', 'zarinpal_merchant_id', 'zarinpal_sandbox',\n\t\t\t'shahkar_enabled', 'shahkar_endpoint', 'shahkar_token',\n\t\t\t'lead_default_price', 'default_city_slug',\n\t\t];\n\t\tforeach ( $keys as $k ) {\n\t\t\tregister_setting( 'nahan-settings', \"nahan_$k\" );\n\t\t}\n\t\tregister_setting( 'nahan-settings', 'nahan_subscription_plans' );\n\t}\n\n\t/** Registered Settings API boundary; no provider calls and no secret output. */\n\tprivate function sanitize_sms_setting( string $key, $value ) {\n\t\tif ( array_key_exists( $key, $this->saving_sms ) ) return $this->saving_sms[ $key ];\n\t\t$option = \"nahan_$key\";\n\t\t$old = get_option( $option, 'sms_driver' === $key ? 'kavenegar' : ( 'sms_faraz_variable' === $key ? 'code' : '' ) );\n\t\t$nonce = $_POST['_wpnonce'] ?? '';\n\t\tif ( ! current_user_can( 'manage_options' ) || ! is_string( $nonce ) || ! wp_verify_nonce( wp_unslash( $nonce ), 'nahan-settings-options' ) ) {\n\t\t\twp_die( 'اجازه تغییر تنظیمات پیامک وجود ندارد.' );\n\t\t}\n\t\t$secret = in_array( $key, self::SMS_SECRETS, true );\n\t\t$clear = $secret && '1' === ( $_POST[ $option . '_clear' ] ?? null );\n\t\tif ( $clear ) {\n\t\t\t$value = '';\n\t\t} elseif ( $secret && ( '' === $value || null === $value ) ) {\n\t\t\t$value = $old;\n\t\t} elseif ( ! Settings::valid_sms_value( $key, $value ) ) {\n\t\t\tadd_settings_error( $option, 'sms_settings_invalid', 'مقدار تنظیمات پیامک معتبر نیست؛ مقدار پیشین حفظ شد.' );\n\t\t\t$value = $old;\n\t\t}\n\t\t// options.php normally calls update_option without an autoload argument. Persist\n\t\t// here with false, check the result, then return the stored value so its outer\n\t\t// update is a no-op. Re-entrant sanitize_option/add_option sees only vetted data.\n\t\t$this->saving_sms[ $key ] = $value;\n\t\ttry {\n\t\t\t$stored = get_option( $option, null );\n\t\t\tif ( $stored !== $value ) {\n\t\t\t\tif ( ! update_option( $option, $value, false ) || get_option( $option, null ) !== $value ) wp_die( 'ذخیره تنظیمات پیامک انجام نشد.' );\n\t\t\t} elseif ( $secret ) {\n\t\t\t\t// Existing secrets may predate non-autoload storage. The reviewed WP API\n\t\t\t\t// returns false for no change too; only a storage error means failure.\n\t\t\t\tglobal $wpdb;\n\t\t\t\tif ( ! function_exists( 'wp_set_option_autoload' ) ) wp_die( 'ذخیره امن تنظیمات پیامک در دسترس نیست.' );\n\t\t\t\t$changed = wp_set_option_autoload( $option, false );\n\t\t\t\tif ( ! $changed && ! empty( $wpdb->last_error ) ) wp_die( 'ذخیره امن تنظیمات پیامک انجام نشد.' );\n\t\t\t}\n\t\t} finally {\n\t\t\tunset( $this->saving_sms[ $key ] );\n\t\t}\n\t\treturn $value;\n\t}\n\n\tprivate function render_sms_secret( string $label, string $key ): void {\n\t\t$id = \"nahan_$key\";\n\t\t$configured = '' !== (string) $this->settings->get( $key, '' );\n\t\techo '<tr><th><label for=\"' . esc_attr( $id ) . '\">' . esc_html( $label ) . '</label></th><td>';\n\t\techo '<input id=\"' . esc_attr( $id ) . '\" type=\"password\" name=\"' . esc_attr( $id ) . '\" value=\"\" autocomplete=\"off\" class=\"regular-text\" />';\n\t\techo '<span data-configured=\"' . ( $configured ? 'yes' : 'no' ) . '\">' . esc_html( $configured ? 'تنظیم شده' : 'تنظیم نشده' ) . '</span> ';\n\t\techo '<label><input type=\"checkbox\" name=\"' . esc_attr( $id . '_clear' ) . '\" value=\"1\" />' . esc_html( 'حذف صریح کلید ذخیره‌شده' ) . '</label>';\n\t\techo '<p class=\"description\">' . esc_html( 'خالی بگذارید تا کلید قبلی حفظ شود. کلید هرگز نمایش داده نمی‌شود.' ) . '</p></td></tr>';\n\t}\n\n\tpublic function render_settings(): void {\n\t\tif ( ! current_user_can( 'manage_options' ) ) {\n\t\t\twp_die( 'دسترسی ندارید.' );\n\t\t}\n\t\techo '<div class=\"wrap\"><h1>تنظیمات نهان</h1><form method=\"post\" action=\"options.php\">';\n\t\tsettings_fields( 'nahan-settings' );\n\n\t\t$row = static function ( string $label, string $key, string $type = 'text', $default = '' ) {\n\t\t\t$val = esc_attr( (string) get_option( \"nahan_$key\", $default ) );\n\t\t\t$id  = \"nahan_$key\";\n\t\t\techo '<tr><th><label for=\"' . esc_attr( $id ) . '\">' . esc_html( $label ) . '</label></th><td>';\n\t\t\tif ( 'textarea' === $type ) {\n\t\t\t\techo '<textarea id=\"' . esc_attr( $id ) . '\" name=\"' . esc_attr( $id ) . '\" rows=\"3\" cols=\"60\">' . esc_textarea( $val ) . '</textarea>';\n\t\t\t} elseif ( 'checkbox' === $type ) {\n\t\t\t\t$checked = checked( '1', $val, false );\n\t\t\t\techo '<input id=\"' . esc_attr( $id ) . '\" type=\"checkbox\" name=\"' . esc_attr( $id ) . '\" value=\"1\" ' . $checked . ' />';\n\t\t\t} elseif ( 'number' === $type ) {\n\t\t\t\techo '<input id=\"' . esc_attr( $id ) . '\" type=\"number\" name=\"' . esc_attr( $id ) . '\" value=\"' . esc_attr( $val ) . '\" class=\"regular-text\" />';\n\t\t\t} else {\n\t\t\t\techo '<input id=\"' . esc_attr( $id ) . '\" type=\"text\" name=\"' . esc_attr( $id ) . '\" value=\"' . esc_attr( $val ) . '\" class=\"regular-text\" />';\n\t\t\t}\n\t\t\techo '</td></tr>';\n\t\t};\n\n\t\techo '<h2>پیامک</h2><table class=\"form-table\">';\n\t\t$row( 'درایور پیامک (kavenegar/log/faraz_ippanel)', 'sms_driver', 'text', 'kavenegar' );\n\t\t$this->render_sms_secret( 'Kavenegar API Key', 'sms_kavenegar_apikey' );\n\t\t$row( 'Kavenegar Pattern OTP', 'sms_kavenegar_pattern' );\n\t\t$row( 'Kavenegar Sender', 'sms_kavenegar_sender' );\n\t\t$this->render_sms_secret( 'Faraz / IPPanel API Key', 'sms_faraz_apikey' );\n\t\t$row( 'Faraz Pattern Code', 'sms_faraz_pattern_code' );\n\t\t$row( 'Faraz Originator (E.164)', 'sms_faraz_originator' );\n\t\t$row( 'Faraz OTP Variable', 'sms_faraz_variable', 'text', 'code' );\n\t\techo '</table>';\n\n\t\techo '<h2>JWT و OTP</h2><table class=\"form-table\">';\n\t\t$row( 'JWT Access TTL (ثانیه)', 'jwt_access_ttl', 'number', 900 );\n\t\t$row( 'JWT Refresh TTL (ثانیه)', 'jwt_refresh_ttl', 'number', 2592000 );\n\t\t$row( 'OTP TTL (ثانیه)', 'otp_ttl', 'number', 120 );\n\t\t$row( 'OTP Max Attempts', 'otp_max_attempts', 'number', 5 );\n\t\t$row( 'OTP Throttle Window (ثانیه)', 'otp_throttle_window', 'number', 60 );\n\t\techo '</table>';\n\n\t\techo '<h2>درگاه پرداخت</h2><table class=\"form-table\">';\n\t\t$row( 'درگاه (zarinpal)', 'payment_gateway', 'text', 'zarinpal' );\n\t\t$row( 'مرچنت کد زرین‌پال', 'zarinpal_merchant_id' );\n\t\t$row( 'حالت Sandbox', 'zarinpal_sandbox', 'checkbox', '1' );\n\t\techo '</table>';\n\n\t\techo '<h2>شاهکار</h2><table class=\"form-table\">';\n\t\t$row( 'فعال', 'shahkar_enabled', 'checkbox', '0' );\n\t\t$row( 'Endpoint', 'shahkar_endpoint' );\n\t\t$row( 'Token', 'shahkar_token' );\n\t\techo '</table>';\n\n\t\techo '<h2>متفرقه</h2><table class=\"form-table\">';\n\t\t$row( 'قیمت پیش‌فرض Lead (تومان)', 'lead_default_price', 'number', 50000 );\n\t\t$row( 'Slug شهر پیش‌فرض', 'default_city_slug', 'text', 'kashan' );\n\t\techo '</table>';\n\n\t\tsubmit_button();\n\t\techo '</form></div>';\n\t}\n}\n",
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/tests/wordpress/task-9a-sms.test.php": "<?php\n/** Task9A: real SmsService and registered AdminPanel callbacks; fake WP HTTP/options/DB only. No WP bootstrap. */\ndeclare(strict_types=1);\ndefine('ABSPATH', __DIR__ . '/');\ndefine('ARRAY_A', 'ARRAY_A');\ndefine('NAHAN_CORE_DIR', '/Applications/XAMPP/xamppfiles/htdocs/karban/wp-content/plugins/karban-core/');\nclass WP_Error {\n public function __construct(public string $code='', public string $message='', public mixed $data=null) {}\n public function get_error_code() { return $this->code; }\n public function get_error_data() { return $this->data; }\n}\nfunction is_wp_error($v) { return $v instanceof WP_Error; }\nfunction get_option($k,$d=false) { return $GLOBALS['options'][$k] ?? $d; }\nfunction register_setting($g,$k,$args=[]) { $GLOBALS['registered'][$k]=$args; }\nfunction update_option($k,$v,$autoload=null) {\n if (isset($GLOBALS['registered'][$k]['sanitize_callback'])) $v=($GLOBALS['registered'][$k]['sanitize_callback'])($v);\n if ($GLOBALS['fail_write']) return false;\n if (array_key_exists($k,$GLOBALS['options']) && $GLOBALS['options'][$k] === $v) return false;\n $GLOBALS['options'][$k]=$v; $GLOBALS['autoload'][$k]=$autoload; $GLOBALS['writes'][]=[$k,$autoload]; return true;\n}\nfunction wp_set_option_autoload($k,$v) { if ($GLOBALS['fail_autoload']) { $GLOBALS['wpdb']->last_error='synthetic-private-storage-error'; return false; } $GLOBALS['autoload'][$k]=$v; return true; }\nfunction add_settings_error($setting,$code,$message,$type='error') { $GLOBALS['settings_errors'][]=[$setting,$code,$message,$type]; }\nfunction current_user_can($cap) { return $cap==='manage_options' && $GLOBALS['admin']; }\nfunction wp_verify_nonce($nonce,$action) { return $nonce==='fixture-nonce' && $action==='nahan-settings-options'; }\nfunction wp_unslash($v) { return $v; }\nfinal class ControlledStop extends RuntimeException {}\nfunction wp_die($message) { throw new ControlledStop('Controlled stop: '.$message); }\nfunction settings_fields($g) { echo '<input type=\"hidden\" name=\"_wpnonce\" value=\"fixture-nonce\" />'; }\nfunction submit_button() { echo '<button>Save</button>'; }\nfunction esc_html($v) { return htmlspecialchars((string)$v,ENT_QUOTES,'UTF-8'); }\nfunction esc_attr($v) { return esc_html($v); }\nfunction esc_textarea($v) { return esc_html($v); }\nfunction checked($a,$b,$echo=false) { return $a===$b?'checked=\"checked\"':''; }\nfunction wp_json_encode($v) { return json_encode($v,JSON_THROW_ON_ERROR); }\nfunction wp_remote_post($url,$args) { $GLOBALS['http'][]=[$url,$args]; return $GLOBALS['response']; }\nfunction wp_remote_retrieve_response_code($r) { return $r['response']['code']??0; }\nfunction wp_remote_retrieve_body($r) { return $r['body']??''; }\nfunction wp_generate_uuid4() { static $i=0; return 'fixture-tracking-'.++$i; }\nfunction current_time($t,$gmt=false) { return gmdate('Y-m-d H:i:s'); }\nfunction sanitize_text_field($v) { return $v; }\nfunction wp_parse_url($v) { return parse_url($v); }\nfinal class FixtureDb {\n public string $prefix='wp_'; public string $last_error=''; public int $insert_id=0; public array $rows=[]; public array $rate=[]; public array $mutations=[]; public int|false $invalidate_result=1;\n public function prepare($sql,...$args) { return [$sql,$args]; }\n public function get_col($sql,$column=0) { return ['id','delivery_mode','code_length']; }\n public function get_row($q,$mode=null) {\n  [$sql,$args]=$q;\n  if (str_contains($sql,'rate_limits')) return $this->rate[$args[0].$args[1]]??null;\n  foreach($this->rows as $row) if ($row['tracking_code']===$args[0]) return $row;\n  return null;\n }\n public function insert($table,$row,$formats=null) {\n  $row['id']=++$this->insert_id;\n  if (str_contains($table,'rate_limits')) $this->rate[$row['bucket'].$row['identifier']]=$row;\n  else { $row['consumed_at']=null; $this->rows[$row['id']]=$row; }\n  return 1;\n }\n public function update($table,$row,$where,$f=null,$wf=null) { foreach($this->rate as &$r) if ($r['id']===$where['id']) $r=array_merge($r,$row); return 1; }\n public function query($q) {\n  $this->mutations[]=$q; [$sql,$args]=$q;\n  if (str_starts_with($sql,'DELETE') && str_contains($sql,'tracking_code = %s') && str_contains($sql,'code_hash = %s') && str_contains($sql,'consumed_at IS NULL')) {\n   if ($this->invalidate_result!==1) return $this->invalidate_result;\n   foreach($this->rows as $id=>$r) if ($r['tracking_code']===$args[0] && $r['code_hash']===$args[1] && $r['consumed_at']===null) { unset($this->rows[$id]); return 1; }\n   return 0;\n  }\n  throw new RuntimeException('Unexpected mutation');\n }\n public function delete($t,$where,$format=null) { throw new RuntimeException('Must not broadly delete challenges or clear throttle'); }\n}\nrequire_once NAHAN_CORE_DIR.'includes/class-helpers.php';\nrequire_once NAHAN_CORE_DIR.'includes/class-rate-limiter.php';\nrequire_once NAHAN_CORE_DIR.'includes/admin/class-settings.php';\nrequire_once NAHAN_CORE_DIR.'includes/admin/class-admin-panel.php';\nrequire_once NAHAN_CORE_DIR.'includes/auth/class-sms-service.php';\nrequire_once NAHAN_CORE_DIR.'includes/class-local-development-gate.php';\nrequire_once NAHAN_CORE_DIR.'includes/auth/class-otp-schema.php';\nrequire_once NAHAN_CORE_DIR.'includes/auth/class-otp-manager.php';\nuse Nahan\\Core\\Admin\\Settings;\nuse Nahan\\Core\\Admin\\AdminPanel;\nuse Nahan\\Core\\Auth\\SmsService;\nuse Nahan\\Core\\Auth\\OtpManager;\nuse Nahan\\Core\\LocalDevelopmentGate;\nfunction expect($b,$why) { if (!$b) throw new RuntimeException($why); }\nfunction same($want,$got,$why) { expect($want===$got,$why); }\nfunction error_safe($r,$code=null) {\n expect($r instanceof WP_Error,'Must fail closed'); if ($code!==null) same($code,$r->code,'Safe error code');\n foreach(['fixture-key','private-transport','private-provider','09121234567','+989121234567','54321'] as $private) expect(!str_contains(json_encode($r),$private),'Error must not expose sensitive data');\n}\nfunction reset_fixture() {\n $GLOBALS['options']=['nahan_sms_driver'=>'faraz_ippanel','nahan_sms_faraz_apikey'=>'fixture-key','nahan_sms_faraz_pattern_code'=>'fixture-pattern','nahan_sms_faraz_originator'=>'+983000505','nahan_sms_faraz_variable'=>'login_code'];\n $GLOBALS['http']=[]; $GLOBALS['registered']=[]; $GLOBALS['writes']=[]; $GLOBALS['autoload']=[]; $GLOBALS['settings_errors']=[];\n $GLOBALS['fail_write']=false; $GLOBALS['fail_autoload']=false; $GLOBALS['admin']=true; $GLOBALS['wpdb']=new FixtureDb();\n $GLOBALS['response']=['response'=>['code'=>200],'body'=>'{\"data\":{\"message_outbox_ids\":[12345]},\"meta\":{\"status\":true}}'];\n $_POST=['_wpnonce'=>'fixture-nonce','option_page'=>'nahan-settings']; $_SERVER=[];\n return new SmsService(new Settings());\n}\nfunction panel() { $p=new AdminPanel(new Settings()); $p->register_settings(); return $p; }\nfunction save($key,$value) { expect(isset($GLOBALS['registered']['nahan_'.$key]['sanitize_callback']),'Actual registered sanitizer required'); update_option('nahan_'.$key,$value); return get_option('nahan_'.$key); }\n$tests=[];\n$tests['fixed Edge HTTP contract and dynamic OTP parameter']=function() {\n $s=reset_fixture(); same(true,$s->send_otp('۰۹۱۲۱۲۳۴۵۶۷','54321'),'Documented acceptance'); same(1,count($GLOBALS['http']),'One transport only');\n [$url,$args]=$GLOBALS['http'][0]; same('https://edge.ippanel.com/v1/api/send',$url,'Fixed HTTPS endpoint'); same('fixture-key',$args['headers']['Authorization'],'Raw key without Bearer');\n same('application/json',$args['headers']['Content-Type'],'JSON content'); same('application/json',$args['headers']['Accept'],'JSON accept'); same(0,$args['redirection'],'Never follow redirects'); expect($args['timeout']>0 && $args['timeout']<=10,'Bounded timeout'); expect(($args['limit_response_size']??PHP_INT_MAX)<=16384,'Bound HTTP response');\n same(['sending_type'=>'pattern','from_number'=>'+983000505','code'=>'fixture-pattern','recipients'=>['+989121234567'],'params'=>['login_code'=>'54321']],json_decode($args['body'],true),'Exact typed provider payload');\n};\n$tests['invalid configuration and inputs never call HTTP or log success']=function() {\n $cases=[['sms_faraz_apikey',''],['sms_faraz_apikey',\"key\\r\\nInjected: x\"],['sms_faraz_apikey','has space'],['sms_faraz_apikey',str_repeat('x',513)],['sms_faraz_pattern_code',''],['sms_faraz_pattern_code',\"a\\nb\"],['sms_faraz_pattern_code',str_repeat('p',129)],['sms_faraz_originator','3000505'],['sms_faraz_originator','+0123456'],['sms_faraz_variable','x.y'],['sms_faraz_variable',''],['sms_faraz_variable',str_repeat('a',65)],['sms_driver','log'],['sms_driver','unknown']];\n foreach($cases as [$k,$v]) { $s=reset_fixture(); $GLOBALS['options']['nahan_'.$k]=$v; error_safe($s->send_otp('09121234567','54321')); same([],$GLOBALS['http'],'Invalid setting blocks HTTP'); }\n foreach(['not-phone','09121234567,09121111111'] as $phone) { $s=reset_fixture(); error_safe($s->send_otp($phone,'54321')); same([],$GLOBALS['http'],'One valid phone only'); }\n $s=reset_fixture(); unset($GLOBALS['options']['nahan_sms_faraz_variable']); same(true,$s->send_otp('09121234567','54321'),'Variable default code'); same(['code'=>'54321'],json_decode($GLOBALS['http'][0][1]['body'],true)['params'],'Default variable');\n foreach(['log','unknown','kavenegar'] as $driver) { $s=reset_fixture(); $GLOBALS['options']['nahan_sms_driver']=$driver; error_safe($s->send_by_pattern('09121234567','',['code'=>'54321'])); same([],$GLOBALS['http'],'Missing pattern cannot fall back'); }\n};\n$tests['strict documented acceptance and safe rejection without retries']=function() {\n $bodies=['{\"meta\":{\"status\":false},\"data\":{\"message_outbox_ids\":[1]}}','{\"meta\":{\"status\":\"true\"},\"data\":{\"message_outbox_ids\":[1]}}','{\"meta\":{\"status\":true},\"data\":{\"message_outbox_ids\":[]}}','{\"meta\":{\"status\":true},\"data\":{\"message_outbox_ids\":[\"bad\"]}}','{\"meta\":{\"status\":true},\"data\":{\"message_outbox_ids\":[0]}}','{\"meta\":{\"status\":true},\"data\":{\"message_outbox_ids\":[1.5]}}','{\"meta\":{\"status\":true},\"data\":{\"message_outbox_ids\":{\"x\":1}}}','invalid-json',str_repeat('x',16385),'null','{\"meta\":{\"status\":true},\"data\":{\"message_outbox_ids\":[true]}}'];\n foreach($bodies as $body) { $s=reset_fixture(); $GLOBALS['response']['body']=$body; error_safe($s->send_otp('09121234567','54321'),'sms_provider_error'); same(1,count($GLOBALS['http']),'Never retry malformed response'); }\n foreach([301,401,422,500] as $http) { $s=reset_fixture(); $GLOBALS['response']['response']['code']=$http; error_safe($s->send_otp('09121234567','54321'),'sms_provider_error'); same(1,count($GLOBALS['http']),'No HTTP retry'); }\n $s=reset_fixture(); $GLOBALS['response']=new WP_Error('timeout','private-transport fixture-key 54321',['private-provider']); error_safe($s->send_otp('09121234567','54321'),'sms_transport_error'); same(1,count($GLOBALS['http']),'Timeout not retried');\n};\n$tests['readiness is internal boolean and text is explicitly unsupported']=function() {\n $s=reset_fixture(); expect(method_exists($s,'is_otp_configured'),'Internal readiness seam'); same(true,$s->is_otp_configured(),'Valid provider ready'); same([],$GLOBALS['http'],'Readiness never pings');\n unset($GLOBALS['options']['nahan_sms_faraz_apikey']); same(false,$s->is_otp_configured(),'Missing secret not ready'); error_safe($s->send_text('09121234567','notification'),'sms_text_unsupported'); same([],$GLOBALS['http'],'No text transport for Faraz');\n};\n$tests['registered form masks both SMS keys, escapes fields and renders nonce']=function() {\n reset_fixture(); $GLOBALS['options']['nahan_sms_kavenegar_apikey']='fixture-legacy-secret'; $GLOBALS['options']['nahan_sms_faraz_pattern_code']='\\\"><script>bad</script>'; $p=panel(); ob_start(); $p->render_settings(); $html=ob_get_clean();\n expect(!str_contains($html,'fixture-key')&&!str_contains($html,'fixture-legacy-secret'),'Never render saved SMS keys');\n foreach(['faraz','kavenegar'] as $driver) { expect((bool)preg_match('/<input[^>]*type=\"password\"[^>]*name=\"nahan_sms_'.$driver.'_apikey\"[^>]*value=\"\"[^>]*autocomplete=\"off\"/',$html),'Blank masked key field'); expect(str_contains($html,'name=\"nahan_sms_'.$driver.'_apikey_clear\"'),'Explicit separate clear intent'); }\n expect(str_contains($html,'data-configured=\"yes\"'),'Safe presence indicator'); expect(str_contains($html,'name=\"_wpnonce\"'),'Settings API nonce'); expect(!str_contains($html,'<script>bad</script>'),'Escaped field values'); same([],$GLOBALS['http'],'Render never sends');\n $GLOBALS['admin']=false; try { $p->render_settings(); throw new LogicException('Must deny'); } catch(RuntimeException $e) { expect(!$e instanceof LogicException,'Low capability render denied'); }\n};\n$tests['registered sanitizers retain blank and invalid keys; explicit clear only']=function() {\n reset_fixture(); panel(); same('fixture-key',save('sms_faraz_apikey',''),'Blank retains'); same(false,$GLOBALS['autoload']['nahan_sms_faraz_apikey'],'Retained key nonautoload');\n same('replacement-key',save('sms_faraz_apikey','replacement-key'),'Change key'); same(false,$GLOBALS['autoload']['nahan_sms_faraz_apikey'],'New key nonautoload');\n foreach([\"bad\\r\\nheader\",'spaces invalid',[],str_repeat('a',513)] as $bad) same('replacement-key',save('sms_faraz_apikey',$bad),'Invalid retains');\n $_POST['nahan_sms_faraz_apikey_clear']='1'; same('',save('sms_faraz_apikey',''),'Explicit clear'); same([],$GLOBALS['http'],'Sanitizers never send');\n reset_fixture(); panel(); unset($GLOBALS['options']['nahan_sms_faraz_apikey']); same('new-fixture-key',save('sms_faraz_apikey','new-fixture-key'),'First save'); same(false,$GLOBALS['autoload']['nahan_sms_faraz_apikey'],'First save disables autoload');\n};\n$tests['capability nonce allowlist and strict field validation']=function() {\n foreach([['admin',false],['nonce','wrong']] as [$k,$v]) { reset_fixture(); panel(); if($k==='admin') $GLOBALS['admin']=$v; else $_POST['_wpnonce']=$v; $_POST['nahan_sms_faraz_apikey_clear']='1'; foreach(['sms_faraz_apikey'=>'replacement-key','sms_driver'=>'log'] as $key=>$value) { try { save($key,$value); throw new LogicException('Must deny save'); } catch(ControlledStop $e) {} } same('fixture-key',get_option('nahan_sms_faraz_apikey'),'Unauthorized change/clear retained'); same('faraz_ippanel',get_option('nahan_sms_driver'),'Unauthorized driver retained'); same([],$GLOBALS['writes'],'No unauthorized writes'); }\n reset_fixture(); panel(); foreach(['unknown',[],\"faraz_ippanel\\n\"] as $bad) same('faraz_ippanel',save('sms_driver',$bad),'Driver strict allowlist');\n foreach(['sms_faraz_pattern_code'=>\"bad\\npattern\",'sms_faraz_originator'=>'3000','sms_faraz_variable'=>'bad.name'] as $key=>$bad) { $old=get_option('nahan_'.$key); same($old,save($key,$bad),'Invalid field retains'); }\n same('verification-code',save('sms_faraz_variable','verification-code'),'Approved variable name'); same('log',save('sms_driver','log'),'Allowlist log retained for non-OTP'); expect(count($GLOBALS['settings_errors'])>0,'Safe validation errors reported');\n};\n$tests['failed checked option writes cannot report configured success']=function() {\n foreach(['fail_write','fail_autoload'] as $failure) { reset_fixture(); panel(); $GLOBALS[$failure]=true; try { save('sms_faraz_apikey',$failure==='fail_write'?'replacement-key':''); throw new LogicException('Must stop failed persistence'); } catch(ControlledStop $e) { expect(!str_contains($e->getMessage(),'private'),'Storage failure safe'); } same('fixture-key',get_option('nahan_sms_faraz_apikey'),'Failure retains old value'); }\n};\n$tests['real manager invalidates only failed persisted challenge and retains throttle']=function() {\n $s=reset_fixture(); $db=$GLOBALS['wpdb']; $db->rows[100]=['id'=>100,'tracking_code'=>'unrelated','code_hash'=>'hash','consumed_at'=>null];\n $GLOBALS['response']=new WP_Error('timeout','private-transport');\n $gate=new LocalDevelopmentGate(['local_development'=>false,'local_dev_otp'=>false,'environment_type'=>'production','site_url'=>'https://example.test','remote_addr'=>'127.0.0.1']);\n $m=new OtpManager($s,$gate); error_safe($m->request('09121234567','192.0.2.1'),'sms_transport_error'); same([100],array_keys($db->rows),'Only failed challenge removed'); same(1,count($db->mutations),'One checked CAS invalidation'); same(1,count($GLOBALS['http']),'One request'); error_safe($m->request('09121234567','192.0.2.1'),'otp_throttled'); same(1,count($GLOBALS['http']),'Failure retains throttle');\n foreach([0,false] as $failed) { $s=reset_fixture(); $GLOBALS['response']=new WP_Error('timeout','private-transport'); $GLOBALS['wpdb']->invalidate_result=$failed; error_safe((new OtpManager($s,$gate))->request('09121234567','192.0.2.1'),'otp_storage_unavailable'); }\n $s=reset_fixture(); $result=(new OtpManager($s,$gate))->request('09121234567','192.0.2.1'); expect(is_array($result),'Accepted request gets tracking only'); same('sms',$result['delivery_mode'],'Normal provenance'); same(5,$result['code_length'],'Normal five-digit mode'); expect(!isset($result['code']),'No code returned'); $row=array_values($GLOBALS['wpdb']->rows)[0]; $body=json_decode($GLOBALS['http'][0][1]['body'],true); same(hash('sha256',$body['params']['login_code']),$row['code_hash'],'Standard hashed persisted OTP'); same(120,$result['expires_in'],'Standard TTL');\n};\n$tests['numeric variable names still encode params as a JSON object']=function() {\n $s=reset_fixture(); $GLOBALS['options']['nahan_sms_faraz_variable']='0'; same(true,$s->send_otp('09121234567','54321'),'Numeric identifier allowed'); $body=json_decode($GLOBALS['http'][0][1]['body']); expect($body->params instanceof stdClass,'Params must be object, never a JSON array'); same('54321',$body->params->{'0'},'Exact numeric variable mapping');\n};\n$tests['object-shaped IDs cannot be mistaken for a list']=function() {\n $s=reset_fixture(); $GLOBALS['response']['body']='{\"meta\":{\"status\":true},\"data\":{\"message_outbox_ids\":{\"0\":12345}}}'; error_safe($s->send_otp('09121234567','54321'),'sms_provider_error');\n};\n$tests['invalid legacy key cannot bypass boundaries']=function() {\n foreach(['',\"key\\r\\nheader\"] as $key) { $s=reset_fixture(); $GLOBALS['options']['nahan_sms_driver']='kavenegar'; $GLOBALS['options']['nahan_sms_kavenegar_pattern']='fixture-pattern'; $GLOBALS['options']['nahan_sms_kavenegar_apikey']=$key; error_safe($s->send_otp('09121234567','54321'),'sms_misconfigured'); same([],$GLOBALS['http'],'Invalid legacy credentials block HTTP too'); }\n};\n$tests['unauthorized first-time settings cannot write even defaults']=function() {\n foreach([false,true] as $cap) { reset_fixture(); panel(); $GLOBALS['options']=[]; $GLOBALS['admin']=$cap; $_POST['_wpnonce']='wrong'; try { save('sms_faraz_apikey','new-fixture-key'); } catch(ControlledStop $e) {} same([],$GLOBALS['writes'],'Unauthorized outer Settings API update must not create option'); }\n};\n$tests['OTP log driver neither logs nor reports success']=function() {\n $s=reset_fixture(); $GLOBALS['options']['nahan_sms_driver']='log'; $file=tempnam(getenv('TMPDIR'),'task9a-log-'); $before=ini_get('error_log'); ini_set('error_log',$file);\n try { error_safe($s->send_otp('09121234567','54321'),'sms_misconfigured'); error_safe($s->send_by_pattern('09121234567','fixture-pattern',['code'=>'54321']),'sms_misconfigured'); same('',file_get_contents($file),'OTP paths must not log codes or full phones'); } finally { ini_set('error_log',$before); unlink($file); }\n};\n$tests['first invalid secret save cannot create an autoloaded option']=function() {\n reset_fixture(); panel(); unset($GLOBALS['options']['nahan_sms_faraz_apikey']); same('',save('sms_faraz_apikey',\"invalid\\r\\nheader\"),'Invalid new key not saved'); same(false,$GLOBALS['autoload']['nahan_sms_faraz_apikey']??null,'Even retained empty secret option must not autoload');\n};\n$tests['all real OTP drivers reject malformed phones before HTTP']=function() {\n $s=reset_fixture(); $GLOBALS['options']['nahan_sms_driver']='kavenegar'; $GLOBALS['options']['nahan_sms_kavenegar_apikey']='fixture-legacy-key'; $GLOBALS['options']['nahan_sms_kavenegar_pattern']='fixture-pattern'; error_safe($s->send_otp('not-phone','54321'),'sms_invalid_phone'); same([],$GLOBALS['http'],'Legacy OTP must validate phone too');\n};\n$tests['legacy OTP acceptance preserved and legacy transport details redacted']=function() {\n $s=reset_fixture(); $GLOBALS['options']['nahan_sms_driver']='kavenegar'; $GLOBALS['options']['nahan_sms_kavenegar_apikey']='fixture-legacy-key'; $GLOBALS['options']['nahan_sms_kavenegar_pattern']='fixture-pattern';\n $GLOBALS['response']=['response'=>['code'=>200],'body'=>'{\"return\":{\"status\":200}}']; same(true,$s->send_otp('09121234567','54321'),'Existing accepted Kavenegar response');\n $GLOBALS['response']=['response'=>['code'=>422],'body'=>'{\"return\":{\"status\":422,\"message\":\"private-provider fixture-key 54321\"}}']; error_safe($s->send_otp('09121234567','54321'),'sms_provider_error');\n $GLOBALS['response']=new WP_Error('timeout','private-transport fixture-key 54321'); error_safe($s->send_otp('09121234567','54321'),'sms_transport_error');\n};\n$failed=0; foreach($tests as $name=>$test) { try { $test(); echo \"PASS $name\\n\"; } catch(Throwable $e) { $failed++; echo \"FAIL $name: \".$e->getMessage().\"\\n\"; } } echo count($tests).' tests; '.$failed.\" failures\\n\"; exit($failed?1:0);\n",
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/task-9a-report.md": "# Task 9A — Faraz/IPPanel provider and safe SMS settings\n\n## Outcome and boundary\n\nImplemented the approved source-only slice in the active XAMPP plugin. Offline tests are green. This is **not live SMS acceptance or delivery proof**. No credentials were read from the installation, entered, printed, or copied. No real HTTP/provider ping, SMS, WordPress bootstrap, DB/admin save, config/environment/dependency change, commit, or subagent was used.\n\nLocal fixed `145632`, default driver selection, local gates, five/six-digit provenance, JWT behavior, and BFF/mode policy remain unchanged. No gallery/owner/client/UI source was edited. Existing media 9 and runtime data were not touched by this task; the controller's independent gallery reproduction is outside this change.\n\n## Actual artifacts and source diff scope\n\nBaseline, captured before functional edits (source text/hashes and 15 pre-existing user-file hashes; no runtime/config values):\n\n- `/Users/binam/project/پرهیزکاری/karban-uiux/web/task-9a-before.snapshot`\n\nNew executable offline test:\n\n- `/Users/binam/project/پرهیزکاری/karban-uiux/web/tests/wordpress/task-9a-sms.test.php`\n\nThis report:\n\n- `/Users/binam/project/پرهیزکاری/karban-uiux/web/task-9a-report.md`\n\nExactly four active-plugin source files changed relative to the snapshot:\n\n1. `/Applications/XAMPP/xamppfiles/htdocs/karban/wp-content/plugins/karban-core/includes/auth/class-sms-service.php` — Faraz pattern adapter, internal readiness, fail-closed OTP paths, controlled provider errors, explicit Faraz text unsupported result. Existing Kavenegar acceptance remains supported; key validation and error redaction also cover that OTP path.\n2. `/Applications/XAMPP/xamppfiles/htdocs/karban/wp-content/plugins/karban-core/includes/auth/class-otp-manager.php` — checked invalidation of the exact persisted challenge on non-successful real transport; simulation and verification/CAS logic untouched.\n3. `/Applications/XAMPP/xamppfiles/htdocs/karban/wp-content/plugins/karban-core/includes/admin/class-admin-panel.php` — registered SMS sanitizers, capability/nonce enforcement, masked/blank SMS key fields and explicit clear controls, checked non-autoload persistence.\n4. `/Applications/XAMPP/xamppfiles/htdocs/karban/wp-content/plugins/karban-core/includes/admin/class-settings.php` — shared bounded SMS-field validation; existing general settings methods unchanged.\n\nThe old plugin copy was not modified. External active-plugin changes are compared to the snapshot, not assumed to appear in the web repository's git diff. No separate diff artifact was created. Final scope inspection found all 15 captured pre-existing user files byte-identical by SHA-256; unrelated controller browser artifacts were left alone.\n\n## Provider contract and interfaces\n\nContract evidence is the approved brief, not a newly fetched SDK or network probe:\n\n- https://ippanelcom.github.io/Edge-Document/fa/docs/\n- https://ippanelcom.github.io/Edge-Document/docs/send/pattern\n\n`SmsService::send_otp(string $phone, string $code)` keeps the existing `true|WP_Error` interface. `faraz_ippanel` is an additional exact driver allowlist member; no driver selection was saved or changed.\n\nThe Faraz adapter sends exactly one native `wp_remote_post` to `https://edge.ippanel.com/v1/api/send`:\n\n- Raw API key in `Authorization`, without `Bearer`; no username/password or panel-login OTP flow.\n- `Accept` and `Content-Type`: `application/json`.\n- Timeout 10 seconds; redirection 0; HTTP response limit 16,384 bytes, checked again before JSON decoding.\n- Typed JSON: `sending_type: \"pattern\"`, configured `from_number`, configured pattern `code`, one E.164 Iranian mobile in `recipients`, and an object `params` mapping the configured variable to the existing manager's OTP. Numeric variable names still serialize as object keys, not a JSON list.\n- Shared Iranian mobile normalization, then domestic `09…` to `+989…`; no sender guessing, arbitrary endpoint, retry, provider failover, log fallback, simulation fallback, or returned OTP/outbox IDs.\n- Acceptance requires HTTP 2xx **and** boolean `meta.status === true` **and** a nonempty actual JSON list of positive integer `data.message_outbox_ids`. Numeric-keyed JSON objects, empty/bad IDs, scalar bodies, malformed/oversized JSON, redirects, authorization errors, provider rejection, and transport errors are rejected.\n- Acceptance means accepted by the provider, not a delivery receipt. Faraz free-text notification sending returns `sms_text_unsupported`; it is not advertised as implemented.\n\nNew internal `SmsService::is_otp_configured(): bool` validates local settings only. It performs no HTTP, publishes no status endpoint, exposes no secret, and is not yet wired into mode/BFF policy.\n\nControlled errors include `sms_misconfigured`, `sms_driver_unknown`, `sms_invalid_phone`, `sms_invalid_otp`, `sms_provider_error`, `sms_transport_error`, `sms_text_unsupported`, and checked-lifecycle failure `otp_storage_unavailable`. Provider/transport bodies, raw causes, authorization, OTP, and full phone are not added to these errors or OTP logs.\n\n## Settings and secret handling\n\nPrivate WordPress options:\n\n| Option | Validation / semantics |\n| --- | --- |\n| `nahan_sms_driver` | Exact `kavenegar`, `log`, or `faraz_ippanel`; existing default `kavenegar` unchanged |\n| `nahan_sms_faraz_apikey` | Nonempty 1–512 printable ASCII bytes; controls and whitespace rejected, never trimmed/repaired or echoed |\n| `nahan_sms_faraz_pattern_code` | 1–128 printable non-whitespace ASCII bytes, no controls |\n| `nahan_sms_faraz_originator` | Strict `+` E.164 syntax, nonzero first digit, at most 15 digits |\n| `nahan_sms_faraz_variable` | 1–64 ASCII letters/digits/underscore/hyphen; absent-option default `code` |\n\nThe existing Kavenegar SMS key is also rendered as an empty password input. Both key inputs have autocomplete off and a presence-only yes/no indicator; no saved value, hidden secret, or secret-bearing JavaScript is rendered. Blank/missing key input retains the stored key. Explicit `nahan_sms_faraz_apikey_clear=1` or the corresponding Kavenegar clear checkbox is a separate intent. `manage_options` and the existing `nahan-settings-options` nonce are required for mutation/clear. Unauthorized sanitizer calls stop safely, including first-time options, before an outer Settings API write can create defaults. Invalid fields retain prior values and add controlled validation errors, rather than being silently treated as clear.\n\nSMS options are registered with actual sanitizer callbacks and `show_in_rest=false`. The existing form remains on `options.php` with `settings_fields('nahan-settings')`.\n\nPersistence detail for independent review: `options.php` normally calls `update_option` without an autoload argument. The SMS sanitizer therefore performs a checked `update_option(option, vetted_value, false)` under a bounded per-option re-entrancy guard and verifies the stored result. Its return makes the outer Settings API update a no-op. Retained existing secrets use the reviewed `wp_set_option_autoload(option, false)` API; its false/no-change return is distinguished from a storage error via `wpdb->last_error`. A storage failure stops with a controlled message, not a false success. Invalid first-time secret input also preserves an empty value through non-autoload persistence. This code was exercised only against in-memory fakes; **no live migration or save was executed**.\n\nNo JWT secret or non-SMS module settings were changed, and no homemade encryption/storage mechanism was added.\n\n## OTP failure lifecycle\n\nReal requests still use the normal random five-digit code, hash, TTL, throttles, tracking and persisted context. On a result other than strict `true`, the manager executes a prepared conditional deletion matching **this tracking code and code hash, with `consumed_at IS NULL`**. Exactly one affected row is required. Zero/false invalidation results become safe `otp_storage_unavailable` errors. Unrelated challenge rows are untouched, no consumed-success state is written, no tracking success is returned, and throttling is not cleared. Timeout acceptance is uncertain, so there is no automatic resend.\n\nThe explicit local simulation continues to bypass SmsService entirely. The existing verification, attempts, expiry, consume CAS and credential-provenance paths were not modified.\n\n## TDD evidence\n\nThe suite invokes the real SmsService, OtpManager, Settings validator, and actual registered AdminPanel sanitizer/render callbacks. Only external HTTP, WP option/persistence, and DB boundaries are faked; no source-grep substitute proves provider/admin behavior.\n\nObserved progression:\n\n1. Initial confirmed RED: **9 tests, 9 failures** before functional implementation. Missing HTTP boundary, log-success fallback, absent readiness, unmasked keys, missing registered sanitizers, unchecked persistence and absent challenge invalidation all failed.\n2. First GREEN: **9 tests, 0 failures**.\n3. Additional shape/authentication RED: **14 tests, 4 failures** — numeric variable serialized as array, object-shaped IDs mistaken for list, invalid legacy key boundary, unauthorized first-time option creation. Those defects were corrected.\n4. Invalid first-secret/autoload RED: **15 tests, 1 failure**, then corrected.\n5. Invalid legacy-phone RED: **17 tests, 1 failure**, then corrected.\n6. Final focused GREEN: **17 tests, 0 failures**.\n\nCoverage includes exact URL/auth/body/one-recipient/timeout/redirect limits; missing/invalid configuration and phones; meta false/string, bad/empty/object IDs, invalid/oversized JSON, redirect/401/422/500, timeout and no retries; readiness/render/sanitizers doing no HTTP; actual masked form, nonce, escaped fields, blank retain/change/clear, authorization and strict validators, autoload false and write failures; OTP no-log behavior; only-the-failed-challenge invalidation with checked failure handling, retained throttle and normal successful hash/TTL/provenance; Kavenegar acceptance compatibility and safe error redaction.\n\n## Final verification\n\nFrom `/Users/binam/project/پرهیزکاری/karban-uiux/web`:\n\n```sh\nfor f in tests/wordpress/*.php; do\n  php \"$f\" /Applications/XAMPP/xamppfiles/htdocs/karban/wp-content/plugins/karban-core || exit 1\ndone\n```\n\nAll **12 standalone PHP suites passed**: 17 new Task 9A cases plus all **11 prior suites**. Prior suite output includes local profile 176 checks, owner foundation 148 assertions, provisioning 55 assertions, media 237 assertions, Task 7A 44 cases, plus local OTP, credential, financial, admin, taxonomy and public-profile boundaries.\n\nAn earlier invocation omitted the plugin-path CLI argument and produced harness errors in `local-profile-save`, `public-profile-guard`, `task-7b-owner`, `task-7b-provisioning`, and `task-7c-media`. These were invocation errors, not suppressed failures; the complete final run above supplies the required argument and passes all of them.\n\nAdditional checks:\n\n- `php -l` passed for all active-plugin PHP source and all web WordPress PHP tests: **65 files**.\n- `git diff --check` passed for tracked web changes.\n- Snapshot-based unified diff inspection/added-line whitespace checks passed for the four external plugin files.\n- All **15 captured pre-existing user-file SHA-256 checks passed**.\n- No Node/full UI build was run because frontend source was untouched.\n\nThe controller requested a pause after that green run for its separate gallery reproduction. No Task 9A source was changed during or after the pause. On resume, only this report and final scope/diff evidence were completed; the full suite was not needlessly repeated.\n\n## Self-review and remaining limits\n\nSelf-review checked the approved brief against provider dispatch, raw-key fixed HTTPS transport, strict acceptance, error privacy, secret retention/clear/capability/nonce/autoload behavior, first-save and PHP JSON-shape edges, exact-challenge invalidation, unchanged local gates/defaults and source scope. No additional implementation was added after final green verification.\n\nIndependent controller review is still required. Offline fakes are not live WordPress/DB/admin-form integration or provider/account-plan compatibility proof. In particular, review the registered sanitizer's checked re-entrant persistence and retained-secret autoload API handling before an actual admin save.\n\nDeferred to a separately approved next slice: local/real mode and BFF policy integration using the internal readiness seam; operator entry of a new API key and approved pattern/sender/variable through the secured admin form; and only then a separately approved single-phone controlled real acceptance test. Never request the secret in chat, read existing stored values, or claim delivered from outbox acceptance. Gallery/native preview issues remain independent and were not changed here.\n"
  },
