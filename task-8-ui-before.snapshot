    "src/app/api/account/me/route.ts": "import \"server-only\";\n\nimport { getProfileRouteHandlers } from \"@/services/profile/profile-bff.server\";\n\nexport const runtime = \"nodejs\";\nexport const dynamic = \"force-dynamic\";\n\nexport async function GET(request: Request) {\n  return getProfileRouteHandlers().account(request);\n}\n\nexport async function POST(request: Request) {\n  return getProfileRouteHandlers().updateAccount(request);\n}\n",
    "src/app/api/auth/challenge/route.ts": "import { createAuthRouteHandlers } from \"@/services/auth/auth-route-adapters\";\nimport { getAuthBffRouteDependencies } from \"@/services/auth/auth-bff.server\";\n\nexport const runtime = \"nodejs\";\nexport const dynamic = \"force-dynamic\";\nexport const revalidate = 0;\n\nexport async function GET(request: Request): Promise<Response> {\n  return createAuthRouteHandlers(getAuthBffRouteDependencies()).challenge(request);\n}\n",
