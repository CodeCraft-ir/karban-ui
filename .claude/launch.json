{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "karban-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--webpack", "--hostname", "127.0.0.1", "--port", "3000"],
      "port": 3000
    },
    {
      "name": "karban-local-wordpress-test",
      "runtimeExecutable": "env",
      "runtimeArgs": ["WORDPRESS_URL=http://localhost/karban/", "WORDPRESS_PERMALINK_MODE=plain", "npm", "run", "dev", "--", "--webpack", "--hostname", "127.0.0.1", "--port", "3002"],
      "port": 3002
    },
    {
      "name": "karban-wordpress-smoke",
      "runtimeExecutable": "node",
      "runtimeArgs": ["tests/integration/local-wordpress-smoke.mjs"],
      "port": 3003
    }
  ]
}
