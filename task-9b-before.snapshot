    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/components/sections/owner/owner-render.test.ts": {
      "sha256": "f2cdc588fef5d7e791011649ef59c0a4fa51e4458a87814c9b170be349145653",
      "text": "import assert from 'node:assert/strict';\nimport {test} from 'node:test';\nimport {createElement} from 'react';\nimport {renderToStaticMarkup} from 'react-dom/server';\nimport {MediaUpload} from './MediaUpload.tsx';\nimport { AccountForm, ProfessionalForm } from './OwnerForms.tsx';\nimport { ClientDashboard } from '../ClientDashboard.tsx';\nimport { ProDashboard } from '../ProDashboard.tsx';\nimport { SpecialistProfile } from '../SpecialistProfile.tsx';\nimport {parseSpecialistDetail} from '@/lib/specialist-adapters';\nimport { PortfolioGallery } from '../../blocks/PortfolioGallery.tsx';\nimport {createOwnerClient,settleOwnerAction} from '@/lib/owner-client';\nimport type {ProfileDto} from '@/services/profile/profile-contracts';\nconst account={id:1,displayName:'نام واقعی',role:'client' as const,loginPhoneMasked:'09*****4567',avatar:null,location:{id:42,name:'کاشان',slug:'kashan'},specialist:null};\nconst profile={id:8,slug:'worker',title:'نقاش واقعی',status:'pending' as const,categories:[{id:17,name:'نقاشی',slug:'paint'}],cities:[],avatar:null,bio:'متن',skills:'مهارت',address:'نشانی خصوصی',availability:'' as const,priceHint:'',experienceYears:0,gallery:[],galleryRevision:3,galleryAvailable:true};\nconst cities=[{id:42,name:'کاشان',slug:'kashan',count:0}];\ntest('uncertain mutation and failed rereads keep real editing controls locked until authoritative reread succeeds',async()=>{\n const calls:string[]=[];let getCount=0;let blocked=false;let current:ProfileDto=profile;\n const fresh={...profile,title:'عنوان تازه از سرور',galleryRevision:9};\n const api=createOwnerClient(async(path,init)=>{\n  calls.push(`${init?.method??'GET'} ${path}`);\n  if(init?.method==='POST')return Response.json({error:{code:'operation_uncertain',reloadRequired:true}},{status:503});\n  getCount++;\n  return getCount<=2?Response.json({error:{code:'profile_unavailable'}},{status:503}):Response.json({profile:fresh});\n },async()=>{});\n const controls=()=>renderToStaticMarkup(createElement(ProfessionalForm,{profile:current,cities,categories:[],disabled:blocked,onSave:async()=>{}}));\n const uncertain=await settleOwnerAction(()=>api.saveProfile({title:'تغییر صریح'}),()=>api.profile(),blocked);\n assert.equal(uncertain.ok,false);\n if(uncertain.ok)assert.fail('mutation must remain uncertain');\n blocked=uncertain.reloadFailed;\n assert.equal(blocked,true);assert.equal(uncertain.state,undefined);assert.match(controls(),/<fieldset disabled=\"\"/);\n const failedRead=await settleOwnerAction(()=>api.profile(),()=>api.profile(),blocked);\n if(failedRead.ok)assert.fail('first explicit reread must fail');\n assert.equal(failedRead.state,undefined);\n assert.equal(failedRead.reloadFailed,true,'failed explicit GET must preserve the existing recovery lock');\n blocked=failedRead.reloadFailed;\n assert.match(controls(),/<fieldset disabled=\"\"/);assert.equal(current.title,profile.title);\n const recovered=await settleOwnerAction(()=>api.profile(),()=>api.profile(),blocked);\n if(!recovered.ok)assert.fail('second explicit reread must succeed');\n current=recovered.value;blocked=false;\n assert.equal(current.title,fresh.title);assert.equal(current.galleryRevision,9);\n assert.doesNotMatch(controls(),/<fieldset disabled=\"\"/);assert.match(controls(),/عنوان تازه از سرور/);\n assert.deepEqual(calls,['POST /api/profile/me','GET /api/profile/me','GET /api/profile/me','GET /api/profile/me']);\n});\ntest('media picker discloses public purpose before enabled uploads and never promises video or codecs',()=>{\n const html=renderToStaticMarkup(createElement(MediaUpload,{purpose:'public-avatar',capabilities:{purposes:['public-avatar'],imageMimes:['image/jpeg','image/webp'],maxBytes:1000,maxDimension:100,maxPixels:10000,maxFiles:1,maxGalleryItems:20,video:{enabled:false,reason:'video_unsupported'},imageDecoderRequired:true},disabled:false,upload:async()=>{throw new Error();},assign:async()=>false}));\n assert.match(html,/عمومی/);assert.match(html,/حتی.*بررسی/);assert.match(html,/WebP/);assert.match(html,/ویدیو.*پشتیبانی نمی‌شود/);assert.match(html,/accept=\"image\\/jpeg,image\\/webp\"/);assert.match(html,/disabled=\"\"/);\n});\ntest('account form actually renders masked readonly identity, independent avatar and ID-selected city',()=>{\n const html=renderToStaticMarkup(createElement(AccountForm,{account,cities,disabled:false,onSave:async()=>{}}));\n assert.match(html,/name=\"display_name\"/);assert.match(html,/09\\*{5}4567/);assert.match(html,/<option value=\"42\" selected=\"\">/);\n assert.doesNotMatch(html,/name=\"(?:phone|role|user_id|email|password)\"/);\n});\ntest('professional form renders private address, bounded real fields, IDs and truthful review status',()=>{\n const html=renderToStaticMarkup(createElement(ProfessionalForm,{profile,cities,categories:[{id:17,name:'نقاشی',slug:'paint',count:0}],disabled:false,onSave:async()=>{}}));\n assert.match(html,/name=\"category_ids\"[^>]*value=\"17\"/);assert.match(html,/checked=\"\"/);assert.match(html,/name=\"experience_years\"/);assert.match(html,/خصوصی/);assert.match(html,/حداکثر ۴۰۰۰/);\n assert.doesNotMatch(html,/name=\"(?:verified|status|slug|role)\"/);\n});\ntest('authenticated dashboards render profile destinations and unconnected states, never fixture finances',()=>{\n const client=renderToStaticMarkup(createElement(ClientDashboard,{displayName:account.displayName}));\n const pro=renderToStaticMarkup(createElement(ProDashboard,{displayName:account.displayName}));\n assert.match(client,/href=\"\\/account\"/);assert.match(pro,/href=\"\\/pro\\/profile\"/);assert.match(pro,/متصل نیست/);\n for(const html of [client,pro]) assert.doesNotMatch(html,/تومان|verified|۴۸۰|480,000|موجودی کیف پول/);\n});\ntest('public profile composes real gallery and unavailable reviews',()=>{\n const specialist=parseSpecialistDetail({id:8,slug:'worker',title:'نقاش',is_verified:false,categories:[],cities:[],gallery:[{id:9,url:'https://example.test/real.png',type:'image',caption:'بازسازی واقعی'}]});\n const html=renderToStaticMarkup(createElement(SpecialistProfile,{specialist}));\n assert.match(html,/src=\"https:\\/\\/example.test\\/real.png\"/);assert.match(html,/نظر.*دسترس/);\n});\ntest('public portfolio renders actual normalized media and captions, not generated art or tags',()=>{\n const html=renderToStaticMarkup(createElement(PortfolioGallery,{items:[{id:9,url:'https://example.test/real.png',type:'image',caption:'بازسازی واقعی'}]}));\n assert.match(html,/src=\"https:\\/\\/example.test\\/real.png\"/);assert.match(html,/بازسازی واقعی/);assert.doesNotMatch(html,/radial-gradient|پروژه موفق|تومان/);\n});\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/components/sections/owner/owner-mounted.test.ts": {
      "sha256": "f69dbe1e4c071bcc721a982ef9a052841134c4628fd391d54859b60744850035",
      "text": "import assert from 'node:assert/strict';\nimport {createRequire} from 'node:module';\nimport {test} from 'node:test';\nimport {act,createElement as h,Fragment,StrictMode} from 'react';\nimport type {Root} from 'react-dom/client';\nimport type {OwnerScreen} from '@/lib/owner-ui';\nimport type {MediaCapabilitiesDto,ProfileDto} from '@/services/profile/profile-contracts';\n\nconst account={id:7001,displayName:'Offline owner',role:'specialist' as const,loginPhoneMasked:null,avatar:null,location:null,specialist:{id:7002,slug:'offline-owner',status:'draft' as const}};\nconst profile:ProfileDto={id:7002,slug:'offline-owner',title:'Offline profile',status:'draft',categories:[],cities:[],avatar:null,bio:'',skills:'',address:'',availability:'',priceHint:'',experienceYears:null,gallery:[{id:7003,url:'http://localhost/fixture-never-loaded.png',type:'image',caption:'Offline gallery image'}],galleryRevision:1,galleryAvailable:true};\nconst removed={gallery:[],galleryRevision:2,galleryAvailable:true,status:'draft' as const};\nconst fresh:ProfileDto={...profile,...removed};\nconst capabilities:MediaCapabilitiesDto={purposes:['public-avatar','public-portfolio'],imageMimes:['image/png'],maxBytes:1024,maxDimension:1024,maxPixels:1048576,maxFiles:1,maxGalleryItems:20,video:{enabled:false,reason:'video_unsupported'},imageDecoderRequired:true};\nconst initial=(value=profile):Extract<OwnerScreen,{kind:'ready'}>=>({kind:'ready',account,profile:value,capabilities,cities:[],categories:[],optionsUnavailable:false});\nconst success='ارجاع تصویر جدا شد؛ فایل عمومی حذف نشده است.';\nconst empty='تصویری در گالری ثبت نشده است.';\nconst detachLabel='جدا کردن از گالری';\nconst reloadLabel='بارگذاری دوباره وضعیت';\nfunction deferred<T>() {\n let resolve!:(value:T)=>void;\n let reject!:(reason:unknown)=>void;\n const promise=new Promise<T>((yes,no)=>{resolve=yes;reject=no;});\n return {promise,resolve,reject};\n}\nconst json=(value:unknown,status=200)=>Response.json(value,{status});\nconst failure=(code:string,status:number,reloadRequired=false)=>json({error:{code,reloadRequired}},status);\n\n// One serial suite owns the DOM globals. No native fetch fallback, external\n// resource loader, hook mocks, fake provider, testing library, or effect shim.\ntest('actual OwnerEditor + AuthSummaryProvider mounted offline lifecycle',async t=>{\n const require=createRequire(import.meta.url);\n const {JSDOM}=require('jsdom') as {JSDOM:new(html:string,options:object)=>{window:Window & typeof globalThis}};\n const dom=new JSDOM('<!doctype html><html><body></body></html>',{url:'http://localhost/',pretendToBeVisual:true});\n const win=dom.window;\n const originals=new Map<string,PropertyDescriptor|undefined>();\n const install=(key:string,value:unknown)=>{\n  originals.set(key,Object.getOwnPropertyDescriptor(globalThis,key));\n  Object.defineProperty(globalThis,key,{value,writable:true,configurable:true});\n };\n // jsdom has no matchMedia. Only reduced motion matches; no application effect\n // is bypassed. Resources are disabled by jsdom's default (no `resources`).\n Object.defineProperty(win,'matchMedia',{value:(query:string)=>({matches:query==='(prefers-reduced-motion: reduce)',media:query,onchange:null,addListener(){},removeListener(){},addEventListener(){},removeEventListener(){},dispatchEvent(){return true;}})});\n for(const [key,value] of Object.entries({window:win,self:win,document:win.document,navigator:win.navigator,HTMLElement:win.HTMLElement,Element:win.Element,Node:win.Node,MutationObserver:win.MutationObserver,getComputedStyle:win.getComputedStyle.bind(win),requestAnimationFrame:win.requestAnimationFrame.bind(win),cancelAnimationFrame:win.cancelAnimationFrame.bind(win),IS_REACT_ACT_ENVIRONMENT:true}))install(key,value);\n let router:((path:string,init?:RequestInit)=>Promise<Response>)|undefined;\n const unexpected:string[]=[];\n const offlineFetch=async(input:RequestInfo|URL,init?:RequestInit)=>{\n  if(typeof input!=='string'||!input.startsWith('/api/')||input.startsWith('//')||!router){\n   unexpected.push(`unexpected request: ${String(input)}`);throw new Error(unexpected.at(-1));\n  }\n  return router(input,init);\n };\n install('fetch',offlineFetch);\n win.fetch=offlineFetch;\n let activeRoot:Root|undefined;\n try{\n  // DOM must precede these imports: Button's actual GSAP/useGSAP runs normally.\n  const {createRoot}=await import('react-dom/client');\n  const {OwnerEditor}=await import('./OwnerEditor.tsx');\n  const {AuthSummaryProvider,useAuthSummary}=await import('@/components/layout/useAuthSummary');\n  function Consumer({name}:{name:string}) {\n   const summary=useAuthSummary();\n   return h('aside',{'data-consumer':name},\n    h('output',null,JSON.stringify({id:summary.account?.id??null,pending:summary.pending,error:summary.error,logoutPending:summary.logoutPending,logoutError:summary.logoutError})),\n    h('button',{'data-refresh':name,onClick:()=>void summary.refresh()},'summary read'),\n    h('button',{'data-logout':name,onClick:()=>void summary.logout()},'logout'),\n    h('button',{'data-clear':name,onClick:()=>summary.clearAccount(true)},'invalidate'));\n  }\n  async function harness(strict=true){\n   const calls:{path:string;method:string;body:unknown;signal:AbortSignal|null|undefined}[]=[];\n   const summaries:ReturnType<typeof deferred<Response>>[]=[];\n   const deletes:ReturnType<typeof deferred<Response>>[]=[];\n   const reads:ReturnType<typeof deferred<Response>>[]=[];\n   const logouts:ReturnType<typeof deferred<Response>>[]=[];\n   const waiting=new Set<ReturnType<typeof deferred<Response>>>();\n   const enqueue=(list:ReturnType<typeof deferred<Response>>[],signal?:AbortSignal|null)=>{\n    const item=deferred<Response>();list.push(item);waiting.add(item);\n    const abort=()=>item.reject(new DOMException('Aborted','AbortError'));\n    if(signal?.aborted)abort();else signal?.addEventListener('abort',abort,{once:true});\n    return item.promise.finally(()=>{waiting.delete(item);signal?.removeEventListener('abort',abort);});\n   };\n   router=async(path,init)=>{\n    const method=init?.method??'GET';\n    calls.push({path,method,body:init?.body,signal:init?.signal});\n    if(path==='/api/auth/me'&&method==='GET')return enqueue(summaries);\n    if(path==='/api/profile/media'&&method==='GET')return json({capabilities});\n    if(path==='/api/profile/gallery/media/7003'&&method==='DELETE')return enqueue(deletes);\n    if(path==='/api/profile/me'&&method==='GET')return enqueue(reads,init?.signal);\n    if(path==='/api/auth/logout'&&method==='POST')return enqueue(logouts);\n    unexpected.push(`unhandled ${method} ${path}`);throw new Error(unexpected.at(-1));\n   };\n   const host=win.document.createElement('main');win.document.body.append(host);\n   const root=createRoot(host);activeRoot=root;\n   const render=async(show=true,value=profile)=>{\n    const children=h(AuthSummaryProvider,null,h(Consumer,{name:'a'}),h(Consumer,{name:'b'}),show?h(OwnerEditor,{initial:initial(value)}):null);\n    await act(async()=>root.render(h(strict?StrictMode:Fragment,null,children)));\n   };\n   const resolve=async(item:ReturnType<typeof deferred<Response>>,response:Response)=>{await act(async()=>item.resolve(response));};\n   const click=async(button:HTMLButtonElement)=>{await act(async()=>button.click());};\n   const button=(label:string)=>{\n    const found=Array.from(host.querySelectorAll('button')).find(node=>node.textContent===label);\n    assert.ok(found,`button exists: ${label}`);return found;\n   };\n   const selector=(value:string)=>{const node=host.querySelector<HTMLButtonElement>(value);assert.ok(node,value);return node;};\n   const summary=()=>{\n    const a=host.querySelector('[data-consumer=\"a\"] output')?.textContent;\n    assert.equal(a,host.querySelector('[data-consumer=\"b\"] output')?.textContent,'two actual consumers share the snapshot');\n    return JSON.parse(a??'null') as {id:number|null;pending:boolean;error:boolean;logoutPending:boolean;logoutError:boolean};\n   };\n   const busy=(value:boolean)=>{assert.equal(host.querySelector('[aria-busy]')?.getAttribute('aria-busy'),String(value));};\n   const galleryCount=(count:number)=>assert.equal(host.querySelectorAll('figure').length,count);\n   const detached=()=>{\n    galleryCount(0);assert.ok(host.textContent?.includes(empty));\n    assert.ok(Array.from(host.querySelectorAll('[role=\"status\"]')).some(node=>node.textContent===success));\n    busy(false);assert.ok(host.textContent?.includes('وضعیت: پیش‌نویس'));\n    assert.ok(host.querySelector('a[href=\"/specialists/offline-owner\"]'),'stable slug unchanged');\n   };\n   const start=async()=>{\n    const oldRoot=host.querySelector('[aria-busy]');assert.ok(oldRoot);\n    await click(button(detachLabel));busy(true);galleryCount(1);\n    assert.equal(button(detachLabel).disabled,true);\n    assert.equal(deletes.length,1);assert.equal(deletes[0]!==undefined,true);\n    assert.equal(calls.find(call=>call.method==='DELETE')?.body,JSON.stringify({expected_revision:1}));\n    await click(button(detachLabel));assert.equal(deletes.length,1,'disabled duplicate is not dispatched');\n    return oldRoot;\n   };\n   async function close(){\n    try{await act(async()=>root.unmount());}\n    finally{\n     activeRoot=undefined;\n     await act(async()=>{for(const pending of waiting)pending.reject(new DOMException('Test closed','AbortError'));});\n     host.remove();router=undefined;\n    }\n    assert.deepEqual(unexpected,[],'strict router never fell through');\n    for(const call of calls.filter(call=>call.path==='/api/profile/media'))assert.equal(call.signal?.aborted,true,'capability readers aborted on cleanup');\n   }\n   try{\n    await render();assert.ok(summaries.length>=1);\n    // StrictMode runs mount effects twice. Resolve newest summary first, then\n    // oldest, exercising the real store's generation check without mock state.\n    for(const request of [...summaries].reverse())await resolve(request,json({account}));\n    summary();galleryCount(1);busy(false);\n   }catch(error){await close();throw error;}\n   return {host,calls,summaries,deletes,reads,logouts,render,resolve,click,button,selector,summary,busy,galleryCount,detached,start,close};\n  }\n\n  for(const strict of [false,true])await t.test(`successful deferred detach updates the same mounted editor (StrictMode=${strict})`,async()=>{\n   const app=await harness(strict);\n   try{\n    const ownerRoot=await app.start();\n    await app.resolve(app.deletes[0],json({gallery:removed}));app.detached();\n    assert.equal(app.host.querySelector('[aria-busy]'),ownerRoot,'no manual reload/remount');\n    assert.equal(app.reads.length,0);assert.equal(app.summaries.length,strict?2:1,'detach does not refresh the provider');\n   }finally{await app.close();}\n  });\n\n  await t.test('shared provider loading during DELETE preserves account, root, and accepted result',async()=>{\n   const app=await harness();\n   try{\n    const ownerRoot=await app.start();\n    await app.click(app.selector('[data-refresh=\"b\"]'));\n    assert.equal(app.summary().pending,true);assert.equal(app.summary().id,account.id);\n    assert.equal(app.host.querySelector('[aria-busy]'),ownerRoot);\n    await app.resolve(app.deletes[0],json({gallery:removed}));app.detached();\n    await app.resolve(app.summaries.at(-1)!,json({account}));app.detached();\n    assert.equal(app.host.querySelector('[aria-busy]'),ownerRoot);\n   }finally{await app.close();}\n  });\n\n  for(const responseWhileHidden of [true,false])await t.test(`provider read failure/recovery during DELETE (response while hidden=${responseWhileHidden})`,async()=>{\n   const app=await harness();\n   try{\n    const ownerRoot=await app.start();\n    await app.click(app.selector('[data-refresh=\"a\"]'));\n    await app.resolve(app.summaries.at(-1)!,failure('account_unavailable',503));\n    assert.equal(app.summary().error,true);assert.equal(app.summary().id,null);\n    assert.equal(ownerRoot.isConnected,false,'access gate replaces DOM, not necessarily OwnerEditor');\n    assert.equal(app.host.querySelector('[aria-busy]'),null);assert.ok(app.host.textContent?.includes('بررسی دسترسی حساب'));\n    if(responseWhileHidden)await app.resolve(app.deletes[0],json({gallery:removed}));\n    await app.click(app.selector('[data-refresh=\"b\"]'));\n    await app.resolve(app.summaries.at(-1)!,json({account}));\n    if(!responseWhileHidden){app.busy(true);app.galleryCount(1);await app.resolve(app.deletes[0],json({gallery:removed}));}\n    app.detached();assert.notEqual(app.host.querySelector('[aria-busy]'),ownerRoot,'new DOM still carries accepted state');\n    assert.equal(app.deletes.length,1);assert.equal(app.reads.length,0);\n   }finally{await app.close();}\n  });\n\n  await t.test('out-of-order provider loads from two consumers cannot discard the detach result',async()=>{\n   const app=await harness();\n   try{\n    await app.start();await app.click(app.selector('[data-refresh=\"a\"]'));const older=app.summaries.at(-1)!;\n    await app.click(app.selector('[data-refresh=\"b\"]'));const newer=app.summaries.at(-1)!;\n    await app.resolve(newer,json({account}));await app.resolve(app.deletes[0],json({gallery:removed}));\n    await app.resolve(older,failure('account_unavailable',503));\n    assert.equal(app.summary().error,false);app.detached();\n   }finally{await app.close();}\n  });\n\n  await t.test('actual unmount discards old response; remount uses fresh authoritative input',async()=>{\n   const app=await harness();\n   try{\n    const oldRoot=await app.start();await app.render(false);\n    assert.equal(oldRoot.isConnected,false);\n    await app.render(true,fresh);app.galleryCount(0);app.busy(false);\n    const newRoot=app.host.querySelector('[aria-busy]');\n    await app.resolve(app.deletes[0],json({gallery:removed}));\n    assert.equal(app.host.querySelector('[aria-busy]'),newRoot);app.galleryCount(0);app.busy(false);\n    assert.equal(app.host.textContent?.includes(success),false,'old completion must not notify the new editor');\n    assert.equal(app.deletes.length,1);\n   }finally{await app.close();}\n  });\n\n  await t.test('negative control: genuine remount with explicitly stale initial input is not proof of a detach defect',async()=>{\n   const app=await harness();\n   try{\n    await app.start();await app.resolve(app.deletes[0],json({gallery:removed}));app.detached();\n    await app.render(false);await app.render(true,profile);\n    app.galleryCount(1);app.busy(false);\n    assert.equal(app.host.textContent?.includes(success),false);\n    assert.equal(app.reads.length,0,'OwnerEditor does not fetch profile automatically on remount');\n    // This supplies old props deliberately; no evidence says the real server\n    // composition supplied old props. It is not a forced RED/product requirement.\n    await app.click(app.button(reloadLabel));assert.equal(app.reads.length,1);\n    await app.resolve(app.reads[0],json({profile:fresh}));app.galleryCount(0);app.busy(false);\n   }finally{await app.close();}\n  });\n\n  await t.test('malformed successful mutation DTO is not accepted; authoritative reread recovers without replay',async()=>{\n   const app=await harness();\n   try{\n    await app.start();await app.resolve(app.deletes[0],json({gallery:{...removed,galleryRevision:'invalid'}}));\n    app.busy(true);app.galleryCount(1);assert.equal(app.reads.length,1);\n    await app.resolve(app.reads[0],json({profile:fresh}));app.galleryCount(0);app.busy(false);\n    assert.ok(app.host.querySelector('[role=\"alert\"]'));assert.equal(app.host.textContent?.includes(success),false);\n    assert.equal(app.deletes.length,1);\n   }finally{await app.close();}\n  });\n\n  await t.test('409 and failed rereads preserve the mutation lock until a successful explicit read',async()=>{\n   const app=await harness();\n   try{\n    await app.start();await app.resolve(app.deletes[0],failure('gallery_conflict',409,true));\n    app.busy(true);assert.equal(app.reads.length,1);\n    await app.resolve(app.reads[0],failure('profile_unavailable',503));\n    app.busy(false);app.galleryCount(1);assert.equal(app.button(detachLabel).disabled,true);\n    assert.ok(app.host.querySelector('[role=\"alert\"]')?.textContent?.includes('تا بارگذاری دوباره'));\n    await app.click(app.button(detachLabel));assert.equal(app.deletes.length,1);\n    await app.click(app.button(reloadLabel));await app.resolve(app.reads[1],failure('profile_unavailable',503));\n    assert.equal(app.button(detachLabel).disabled,true,'plain failed GET does not unlock');\n    await app.click(app.button(reloadLabel));await app.resolve(app.reads[2],json({profile:fresh}));\n    app.galleryCount(0);app.busy(false);assert.equal(Array.from(app.host.querySelectorAll('[role=\"alert\"]')).some(node=>Boolean(node.textContent)),false);\n    assert.equal(app.deletes.length,1);assert.equal(app.button('ارسال برای بررسی').disabled,false);\n   }finally{await app.close();}\n  });\n\n  for(const [status,code] of [[403,'forbidden'],[401,'refresh_required']] as const)await t.test(`${status} ${code} never replays a mutation or accepts a gallery result`,async()=>{\n   const app=await harness();\n   try{\n    await app.start();await app.resolve(app.deletes[0],failure(code,status));\n    app.galleryCount(1);app.busy(false);assert.ok(app.host.querySelector('[role=\"alert\"]'));\n    assert.equal(app.host.textContent?.includes(success),false);assert.equal(app.reads.length,0);assert.equal(app.deletes.length,1);\n    if(status===401)assert.ok(app.host.querySelector('a[href=\"/auth/recover?returnTo=/pro/profile\"]'));\n   }finally{await app.close();}\n  });\n\n  for(const logoutStatus of [200,503])await t.test(`logout generation cancels DELETE and stale summary (logout status ${logoutStatus})`,async()=>{\n   const app=await harness();\n   try{\n    await app.start();await app.click(app.selector('[data-refresh=\"a\"]'));const staleSummary=app.summaries.at(-1)!;\n    await app.click(app.selector('[data-logout=\"b\"]'));\n    assert.equal(app.summary().logoutPending,true);assert.equal(app.summary().id,null);\n    await app.resolve(app.deletes[0],json({gallery:removed}));await app.resolve(staleSummary,json({account}));\n    assert.equal(app.summary().id,null);assert.equal(app.host.querySelector('[aria-busy]'),null);\n    await app.resolve(app.logouts[0],json({},logoutStatus));\n    assert.equal(app.summary().logoutError,logoutStatus!==200);assert.equal(app.summary().id,null);\n    assert.equal(app.host.textContent?.includes(success),false);assert.equal(app.host.querySelector('figure'),null);\n    assert.equal(app.deletes.length,1);\n   }finally{await app.close();}\n  });\n\n  await t.test('explicit invalidation cancels an in-flight detach even after access is recovered',async()=>{\n   const app=await harness();\n   try{\n    await app.start();await app.click(app.selector('[data-clear=\"a\"]'));assert.equal(app.summary().logoutError,true);\n    await app.resolve(app.deletes[0],json({gallery:removed}));\n    await app.click(app.selector('[data-refresh=\"b\"]'));await app.resolve(app.summaries.at(-1)!,json({account}));\n    app.galleryCount(1);assert.equal(app.host.textContent?.includes(success),false,'cancelled result was not applied');\n    // This test checks rejection, not a new requirement to unlock a cancelled\n    // editor. Security cancellation is intentionally preserved unchanged.\n    assert.equal(app.deletes.length,1);\n   }finally{await app.close();}\n  });\n }finally{\n  if(activeRoot)await act(async()=>activeRoot!.unmount());\n  dom.window.close();\n  for(const [key,descriptor] of originals){if(descriptor)Object.defineProperty(globalThis,key,descriptor);else Reflect.deleteProperty(globalThis,key);}\n }\n});\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/components/sections/owner/workspace-render.test.ts": {
      "sha256": "dc452acd103b9b160695e2c019a3e815c898ea058a8d4082758135d10270ba05",
      "text": "import assert from 'node:assert/strict';\nimport {test} from 'node:test';\nimport {createElement} from 'react';\nimport {renderToStaticMarkup} from 'react-dom/server';\nimport {ClientDashboard} from '../ClientDashboard.tsx';\nimport {ProDashboard} from '../ProDashboard.tsx';\nimport {AccountForm,ProfessionalForm} from './OwnerForms.tsx';\nimport {MediaUpload} from './MediaUpload.tsx';\nimport type {AccountDto,ProfileDto,MediaCapabilitiesDto} from '@/services/profile/profile-contracts';\nconst account:AccountDto={id:1,displayName:'نام واقعی',role:'client',loginPhoneMasked:'09*****4567',avatar:null,location:null,specialist:null};\nconst profile:ProfileDto={id:8,slug:'worker',title:'نقاش واقعی',status:'pending',categories:[{id:17,name:'نقاشی',slug:'paint'}],cities:[],avatar:null,bio:'معرفی ذخیره‌شده',skills:'مهارت',address:'نشانی خصوصی',availability:'',priceHint:'',experienceYears:0,gallery:[],galleryRevision:3,galleryAvailable:true};\nconst capabilities:MediaCapabilitiesDto={purposes:['public-avatar'],imageMimes:['image/jpeg','image/webp'],maxBytes:1000,maxDimension:100,maxPixels:10000,maxFiles:1,maxGalleryItems:20,video:{enabled:false,reason:'video_unsupported'},imageDecoderRequired:true};\nconst render=renderToStaticMarkup;\ntest('client workspace marks current section and makes search the primary task without specialist links',()=>{\n const html=render(createElement(ClientDashboard,{displayName:account.displayName}));\n assert.match(html,/max-w-5xl/);assert.match(html,/<a[^>]*aria-current=\"page\"[^>]*href=\"\\/dashboard\"|<a[^>]*href=\"\\/dashboard\"[^>]*aria-current=\"page\"/);\n assert.match(html,/<a[^>]*class=\"[^\"]*bg-primary[^\"]*\"[^>]*href=\"\\/search\"|<a[^>]*href=\"\\/search\"[^>]*class=\"[^\"]*bg-primary/);\n assert.doesNotMatch(html,/href=\"\\/pro|تومان|درصد|verified/);assert.match(html,/نام واقعی/);\n});\ntest('specialist workspace prioritizes completing a profile and retains truthful disconnected services',()=>{\n const html=render(createElement(ProDashboard,{displayName:account.displayName}));\n assert.match(html,/تکمیل پروفایل حرفه‌ای/);assert.match(html,/aria-current=\"page\"/);assert.match(html,/متصل نیست/);\n assert.doesNotMatch(html,/تومان|درصد|تاییدشده|پروژه موفق/);\n});\ntest('professional fields are semantically grouped, private address separate and save remains inside the form',()=>{\n const html=render(createElement(ProfessionalForm,{profile,cities:[],categories:[],disabled:true,onSave:async()=>{}}));\n for(const title of ['معرفی و مهارت‌ها','خدمات و محدوده فعالیت','شرایط همکاری','نشانی خصوصی']) assert.match(html,new RegExp(`<legend[^>]*>${title}`));\n assert.match(html,/<fieldset disabled=\"\"/);assert.match(html,/<form[\\s\\S]*<button[^>]*type=\"submit\"[\\s\\S]*ذخیره[\\s\\S]*<\\/form>/);\n assert.match(html,/value=\"0\"/);assert.doesNotMatch(html,/name=\"(?:status|verified|role)\"/);\n});\ntest('account identity is visibly grouped as readonly and excluded from save payload fields',()=>{\n const html=render(createElement(AccountForm,{account,cities:[],disabled:false,onSave:async()=>{}}));\n assert.match(html,/<legend[^>]*>شناسه‌های ورود/);assert.match(html,/09\\*{5}4567/);\n assert.equal((html.match(/readOnly=\"\"/g)||[]).length,2);assert.doesNotMatch(html,/name=\"(?:phone|role|login-phone|account-role)\"/);\n});\ntest('upload workspace describes its actual empty stage and gates picker after visible public consent',()=>{\n const html=render(createElement(MediaUpload,{purpose:'public-avatar',capabilities,disabled:false,upload:async()=>{throw Error();},assign:async()=>false}));\n assert.match(html,/هنوز تصویری انتخاب نشده/);assert.match(html,/انتخاب تصویر[\\s\\S]*بارگذاری فایل[\\s\\S]*اتصال به پروفایل/);\n assert.ok(html.indexOf('عمومی بودن فایل')<html.indexOf('type=\"file\"'));\n assert.match(html,/<input[^>]*type=\"file\"[^>]*disabled=\"\"/);assert.match(html,/حتی اگر پروفایل پیش‌نویس/);\n});\ntest('unsupported media purpose never exposes a picker or hides public URL warning',()=>{\n const html=render(createElement(MediaUpload,{purpose:'public-portfolio',capabilities,disabled:false,upload:async()=>{throw Error();},assign:async()=>false}));\n assert.match(html,/قابلیت بارگذاری در دسترس نیست/);assert.match(html,/نشانی فایل بارگذاری‌شده عمومی است/);assert.doesNotMatch(html,/type=\"file\"/);\n});\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/components/sections/owner/workspace-presentation.test.ts": {
      "sha256": "1099bb1dd2de49041e9fa5e6447de1f50368eb6134dc1075686fb86bd933300c",
      "text": "import assert from 'node:assert/strict';\nimport {test} from 'node:test';\nimport {createElement} from 'react';\nimport {renderToStaticMarkup} from 'react-dom/server';\nimport * as workspace from './AccountWorkspace.tsx';\nimport type {ProfileDto} from '@/services/profile/profile-contracts';\nconst profile:ProfileDto={id:8,slug:'worker',title:'نقاش واقعی',status:'pending',categories:[{id:17,name:'نقاشی',slug:'paint'}],cities:[],avatar:null,bio:'متن',skills:'مهارت',address:'نشانی خصوصی',availability:'',priceHint:'',experienceYears:0,gallery:[],galleryRevision:3,galleryAvailable:true};\ntest('saved checklist projects only persisted title category city, with optional media separate',()=>{\n assert.deepEqual(workspace.savedProfileChecklist(profile),[{label:'عنوان حرفه‌ای',complete:true},{label:'دسته خدمت',complete:true},{label:'شهر خدمت',complete:false}]);\n assert.deepEqual(workspace.savedProfileChecklist({...profile,title:'  ',categories:[],cities:[{id:42,name:'کاشان',slug:'kashan'}]}).map(item=>item.complete),[false,false,true]);\n});\ntest('review presentation never enables pending or recovery-locked submission',()=>{\n for(const status of ['draft','pending','publish'] as const){\n  assert.equal(workspace.reviewPresentation(status,true).disabled,true);\n  assert.equal(workspace.reviewPresentation(status,false).disabled,status==='pending');\n }\n assert.match(workspace.reviewPresentation('pending',false).label,/در انتظار بررسی/);\n});\ntest('media projection distinguishes selection upload and attachment, without claiming saved success',()=>{\n assert.equal(workspace.uploadPresentation({selected:false,uploaded:false,pending:false,uncertain:false}),'هنوز تصویری انتخاب نشده است.');\n assert.match(workspace.uploadPresentation({selected:true,uploaded:false,pending:false,uncertain:false}),/انتخاب شده.*هنوز بارگذاری نشده/);\n assert.match(workspace.uploadPresentation({selected:false,uploaded:true,pending:false,uncertain:false}),/بارگذاری شده.*هنوز متصل نشده/);\n assert.match(workspace.uploadPresentation({selected:false,uploaded:true,pending:true,uncertain:false}),/در حال انجام/);\n assert.match(workspace.uploadPresentation({selected:true,uploaded:false,pending:false,uncertain:true}),/قطعی نیست/);\n});\ntest('saved summary renders server title, pending status and unknown verification distinctly without private content',()=>{\n const html=renderToStaticMarkup(createElement(workspace.SavedProfileSummary,{profile}));\n assert.match(html,/نقاش واقعی/);assert.match(html,/در انتظار بررسی/);assert.match(html,/تایید هویت: اطلاعات قابل نمایش نیست/);\n assert.match(html,/اطلاعات ذخیره‌شده/);assert.match(html,/شهر خدمت[\\s\\S]*ثبت نشده/);\n assert.match(html,/اختیاری/);assert.match(html,/تا زمان انتشار/);\n assert.doesNotMatch(html,/نشانی خصوصی|درصد|%|تاییدشده/);\n});\ntest('all actual publication and verification values stay independent in the summary',()=>{\n for(const status of ['draft','pending','publish'] as const)for(const verified of [false,true,undefined]){\n  const html=renderToStaticMarkup(createElement(workspace.SavedProfileSummary,{profile:{...profile,status,verified}}));\n  assert.match(html,new RegExp({draft:'پیش‌نویس',pending:'در انتظار بررسی',publish:'منتشرشده'}[status]));\n  assert.match(html,new RegExp(verified===undefined?'اطلاعات قابل نمایش نیست':verified?'تاییدشده؛ فقط خواندنی':'تایید نشده؛ فقط خواندنی'));\n }\n});\ntest('review panel exposes a single distinct action on saved data and pending text with disabled control',()=>{\n const html=renderToStaticMarkup(createElement(workspace.ProfileReviewPanel,{status:'pending',disabled:false,onSubmit:()=>{}}));\n assert.match(html,/نسخه ذخیره‌شده/);assert.match(html,/در انتظار بررسی/);assert.match(html,/<button[^>]*disabled=\"\"/);\n assert.equal((html.match(/<button/g)||[]).length,1);assert.doesNotMatch(html,/type=\"submit\"/);\n});\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/components/layout/auth-summary-view.ts": {
      "sha256": "213fd69ae2d568073dcc23a989edc35291e6a8f822b785623785553ca9bc2dfd",
      "text": "import type { AuthSummarySnapshot } from \"./auth-summary-store.ts\";\n\nexport type LogoutPresentation =\n  | { state: \"pending\"; label: \"در حال خروج...\" }\n  | { state: \"error\"; label: \"خروج انجام نشد\" }\n  | { state: \"idle\"; label: \"\" };\n\ntype LogoutPresentationInput = Pick<AuthSummarySnapshot, \"logoutPending\" | \"logoutError\"> & Partial<Pick<AuthSummarySnapshot, \"account\" | \"pending\" | \"error\">>;\n\nexport function getLogoutPresentation(snapshot: LogoutPresentationInput): LogoutPresentation {\n  if (snapshot.logoutPending) return { state: \"pending\", label: \"در حال خروج...\" };\n  if (snapshot.logoutError) return { state: \"error\", label: \"خروج انجام نشد\" };\n  return { state: \"idle\", label: \"\" };\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/components/layout/auth-summary-store.test.ts": {
      "sha256": "254297e92a326b8bc2029d61d22005c2ddf57b5c6373f0745c59a0893c162527",
      "text": "import assert from \"node:assert/strict\";\nimport { test } from \"node:test\";\nimport type { AccountSummary } from \"@/lib/contracts/auth\";\nimport { getLogoutPresentation } from \"./auth-summary-view.ts\";\nimport { createAuthSummaryStore } from \"./auth-summary-store.ts\";\n\nconst account: AccountSummary = { id: 88, displayName: \"حساب مشترک\", role: \"client\" };\n\ntest(\"invalidates late reads for every subscribed AppShell consumer after shared logout clear\", async () => {\n  let resolveRead: ((value: AccountSummary) => void) | undefined;\n  let logoutCalls = 0;\n  const store = createAuthSummaryStore({\n    read: () => new Promise<AccountSummary>((resolve) => { resolveRead = resolve; }),\n    logout: async () => { logoutCalls += 1; },\n  });\n  const headerSnapshots: string[] = [];\n  const bottomNavSnapshots: string[] = [];\n  store.subscribe(() => headerSnapshots.push(JSON.stringify(store.getSnapshot())));\n  store.subscribe(() => bottomNavSnapshots.push(JSON.stringify(store.getSnapshot())));\n\n  const readPromise = store.load();\n  const logoutPromise = store.logout();\n  assert.equal(await logoutPromise, \"/\");\n  resolveRead?.(account);\n  await readPromise;\n\n  assert.equal(logoutCalls, 1);\n  assert.equal(store.getSnapshot().account, null);\n  assert.equal(headerSnapshots.at(-1)?.includes(\"حساب مشترک\"), false);\n  assert.equal(bottomNavSnapshots.at(-1)?.includes(\"حساب مشترک\"), false);\n});\n\ntest(\"shares duplicate-submit guard and clears all consumers when logout fails\", async () => {\n  let rejectLogout: ((error: Error) => void) | undefined;\n  let logoutCalls = 0;\n  const store = createAuthSummaryStore({\n    read: async () => account,\n    logout: () => {\n      logoutCalls += 1;\n      return new Promise<void>((_, reject) => { rejectLogout = reject; });\n    },\n  });\n  await store.load();\n  const first = store.logout();\n  const second = store.logout();\n  assert.equal(second, first);\n  await Promise.resolve();\n  rejectLogout?.(new Error(\"remote logout unavailable\"));\n  assert.equal(await first, null);\n  assert.equal(logoutCalls, 1);\n  assert.deepEqual(store.getSnapshot(), {\n    account: null,\n    pending: false,\n    error: true,\n    logoutPending: false,\n    logoutError: true,\n  });\n});\n\ntest('mutation/login summary reload broadcasts the authoritative new name and clears prior logout error',async()=>{\n let current=account;const store=createAuthSummaryStore({read:async()=>current,logout:async()=>{throw new Error();}});\n await store.load();await store.logout();current={...account,displayName:'نام تازه'};\n const seen:string[]=[];store.subscribe(()=>seen.push(store.getSnapshot().account?.displayName??''));\n await store.load();assert.equal(store.getSnapshot().logoutError,false);assert.equal(seen.at(-1),'نام تازه');\n});\ntest('a summary reload cannot restore identity during in-flight logout',async()=>{\n let finish!:()=>void;const store=createAuthSummaryStore({read:async()=>account,logout:()=>new Promise<void>(resolve=>{finish=resolve;})});\n await store.load();const out=store.logout();await Promise.resolve();await store.load();\n assert.equal(store.getSnapshot().account,null);finish();await out;\n});\n\ntest(\"keeps logout pending and failure presentation visible after account clearing\", () => {\n  assert.deepEqual(getLogoutPresentation({ account: null, pending: false, error: false, logoutPending: true, logoutError: false }), {\n    state: \"pending\",\n    label: \"در حال خروج...\",\n  });\n  assert.deepEqual(getLogoutPresentation({ account: null, pending: false, error: true, logoutPending: false, logoutError: true }), {\n    state: \"error\",\n    label: \"خروج انجام نشد\",\n  });\n});\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/components/layout/auth-summary-store.ts": {
      "sha256": "9ea9c2083c04b6db91b66dc839dcd2847647028ab583425d535bd49c9e502688",
      "text": "import { settleLogout } from \"../../lib/auth-logout.ts\";\nimport type { AccountSummary } from \"../../lib/contracts/auth.ts\";\n\nexport interface AuthSummaryReader {\n  read(): Promise<AccountSummary | null>;\n  logout(): Promise<void>;\n}\n\nexport interface AuthSummarySnapshot {\n  account: AccountSummary | null;\n  pending: boolean;\n  error: boolean;\n  logoutPending: boolean;\n  logoutError: boolean;\n}\n\nexport interface AuthSummaryStore {\n  getSnapshot: () => AuthSummarySnapshot;\n  subscribe: (listener: () => void) => () => void;\n  load: () => Promise<void>;\n  clearAccount: (failed: boolean) => void;\n  logout: () => Promise<\"/\" | null>;\n}\n\nconst initialSnapshot: AuthSummarySnapshot = {\n  account: null,\n  pending: false,\n  error: false,\n  logoutPending: false,\n  logoutError: false,\n};\n\nexport function createAuthSummaryStore(reader: AuthSummaryReader): AuthSummaryStore {\n  let snapshot = initialSnapshot;\n  let generation = 0;\n  let logoutPromise: Promise<\"/\" | null> | undefined;\n  const listeners = new Set<() => void>();\n\n  const notify = () => listeners.forEach((listener) => listener());\n  const update = (next: AuthSummarySnapshot) => {\n    snapshot = next;\n    notify();\n  };\n  const clearAccount = (failed: boolean) => {\n    generation += 1;\n    update({ ...snapshot, account: null, pending: false, error: failed, logoutError: failed });\n  };\n\n  return {\n    getSnapshot: () => snapshot,\n    subscribe(listener) {\n      listeners.add(listener);\n      return () => listeners.delete(listener);\n    },\n    async load() {\n      if (snapshot.logoutPending) return;\n      const requestGeneration = ++generation;\n      update({ ...snapshot, pending: true, error: false });\n      try {\n        const account = await reader.read();\n        if (requestGeneration !== generation) return;\n        update({ ...snapshot, account, pending: false, error: false, logoutError: false });\n      } catch {\n        if (requestGeneration !== generation) return;\n        update({ ...snapshot, account: null, pending: false, error: true });\n      }\n    },\n    clearAccount,\n    logout() {\n      if (logoutPromise) return logoutPromise;\n      clearAccount(false);\n      update({ ...snapshot, logoutPending: true, logoutError: false });\n      const task = Promise.resolve()\n        .then(() => reader.logout())\n        .then(\n          () => {\n            const presentation = settleLogout(\"success\");\n            update({ ...snapshot, account: null, pending: false, error: false, logoutPending: false, logoutError: presentation.error });\n            return presentation.navigateTo;\n          },\n          () => {\n            const presentation = settleLogout(\"failure\");\n            update({ ...snapshot, account: null, pending: false, error: true, logoutPending: false, logoutError: presentation.error });\n            return presentation.navigateTo;\n          },\n        )\n        .finally(() => {\n          logoutPromise = undefined;\n        });\n      logoutPromise = task;\n      return task;\n    },\n  };\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/hooks/useInstallPrompt.ts": {
      "sha256": "6bc48fac5d3083645867c0f62e758de8d4010d8991a56c2426fbdd80eb6b7f0b",
      "text": "\"use client\";\n\nimport { useCallback, useEffect, useState } from \"react\";\n\n/** Chromium's non-standard install prompt event. */\ninterface BeforeInstallPromptEvent extends Event {\n  prompt: () => Promise<void>;\n  userChoice: Promise<{ outcome: \"accepted\" | \"dismissed\" }>;\n}\n\nconst DISMISS_KEY = \"karban-install-dismissed\";\nconst DISMISS_DAYS = 14;\n\nfunction isStandalone() {\n  return (\n    window.matchMedia(\"(display-mode: standalone)\").matches ||\n    // iOS Safari legacy flag\n    (navigator as unknown as { standalone?: boolean }).standalone === true\n  );\n}\n\nfunction isIos() {\n  return (\n    /iphone|ipad|ipod/i.test(navigator.userAgent) &&\n    !/crios|fxios/i.test(navigator.userAgent)\n  );\n}\n\n/**\n * useInstallPrompt — one hook powering every install surface.\n *\n * - Chromium: captures `beforeinstallprompt`, exposes `promptInstall()`.\n * - iOS Safari: no prompt API → `isIosSafari` flags the manual\n *   \"Share → Add to Home Screen\" fallback sheet.\n * - Already installed (standalone) or recently dismissed → all surfaces hide.\n */\nexport function useInstallPrompt() {\n  const [deferred, setDeferred] = useState<BeforeInstallPromptEvent | null>(null);\n  const [installed, setInstalled] = useState(false);\n  const [iosSafari, setIosSafari] = useState(false);\n  const [dismissed, setDismissed] = useState(true); // safe default pre-mount\n\n  useEffect(() => {\n    if (isStandalone()) {\n      setInstalled(true);\n      return;\n    }\n    setIosSafari(isIos());\n\n    const ts = Number(localStorage.getItem(DISMISS_KEY) ?? 0);\n    setDismissed(ts > 0 && Date.now() - ts < DISMISS_DAYS * 86_400_000);\n\n    const onPrompt = (e: Event) => {\n      e.preventDefault();\n      setDeferred(e as BeforeInstallPromptEvent);\n    };\n    const onInstalled = () => {\n      setInstalled(true);\n      setDeferred(null);\n    };\n    window.addEventListener(\"beforeinstallprompt\", onPrompt);\n    window.addEventListener(\"appinstalled\", onInstalled);\n    return () => {\n      window.removeEventListener(\"beforeinstallprompt\", onPrompt);\n      window.removeEventListener(\"appinstalled\", onInstalled);\n    };\n  }, []);\n\n  const promptInstall = useCallback(async () => {\n    if (!deferred) return false;\n    await deferred.prompt();\n    const { outcome } = await deferred.userChoice;\n    if (outcome === \"accepted\") setInstalled(true);\n    setDeferred(null);\n    return outcome === \"accepted\";\n  }, [deferred]);\n\n  const dismiss = useCallback(() => {\n    localStorage.setItem(DISMISS_KEY, String(Date.now()));\n    setDismissed(true);\n  }, []);\n\n  return {\n    /** Native prompt is armed (Chromium) */\n    canPrompt: deferred !== null && !installed,\n    /** iOS Safari — show manual instructions instead */\n    isIosSafari: iosSafari && !installed,\n    /** Any install surface should render */\n    canInstall: !installed && (deferred !== null || (iosSafari && !isStandaloneSafe())),\n    isInstalled: installed,\n    bannerDismissed: dismissed,\n    promptInstall,\n    dismiss,\n  };\n}\n\nfunction isStandaloneSafe() {\n  try {\n    return isStandalone();\n  } catch {\n    return false;\n  }\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/lib/owner-client.ts": {
      "sha256": "9deb6aaa3cf8f77100e23b32e02713f9b214c2df7edef10d95be49bc996cd254",
      "text": "import { ProfileBoundaryError, object, parseAccount, parseProfile, parseGallery, parseCapabilities, parseUpload, parseInput, integer, type AccountDto, type ProfileDto, type PublicMediaPurpose, type GalleryDto } from '../services/profile/profile-contracts.ts';\nimport type { OwnerError } from './owner-ui.ts';\n\nexport class OwnerClientError extends Error implements OwnerError {\n  readonly status:number; readonly code:string; readonly reloadRequired:boolean;\n  constructor(status:number,code:string,reloadRequired=false) { super('owner_operation_failed');this.status=status;this.code=code;this.reloadRequired=reloadRequired; }\n}\nfunction accountDto(raw:unknown):AccountDto {\n  const a=object(raw);return parseAccount({id:a.id,display_name:a.displayName,role:a.role,login_phone_masked:a.loginPhoneMasked,avatar:a.avatar,location:a.location,specialist:a.specialist});\n}\nfunction galleryDto(raw:unknown):GalleryDto {\n  const g=object(raw);return parseGallery({gallery:g.gallery,gallery_revision:g.galleryRevision,gallery_available:g.galleryAvailable,status:g.status});\n}\nfunction profileDto(raw:unknown):ProfileDto {\n  const p=object(raw);return parseProfile({id:p.id,slug:p.slug,title:p.title,status:p.status,categories:p.categories,cities:p.cities,avatar:p.avatar,bio:p.bio,skills:p.skills,address:p.address,availability:p.availability,price_hint:p.priceHint,experience_years:p.experienceYears,gallery:p.gallery,gallery_revision:p.galleryRevision,gallery_available:p.galleryAvailable,...(Object.hasOwn(p,'verified')?{verified:p.verified}:{})});\n}\nfunction project<T>(raw:unknown,parser:(value:unknown)=>T,mutation=false):T {\n  try{return parser(raw);}catch{throw new OwnerClientError(503,mutation?'operation_uncertain':'profile_unavailable',mutation);}\n}\nlet refreshFlight:Promise<void>|undefined;\nlet refreshEpoch=0;\nexport type OwnerFetch=(path:string,init?:RequestInit)=>Promise<Response>;\nexport function createOwnerClient(fetcher:OwnerFetch,syncSummary:()=>Promise<void>) {\n  async function request(path:string,method='GET',body?:Record<string,unknown>|FormData,signal?:AbortSignal):Promise<Record<string,unknown>> {\n    let response:Response;\n    try {\n      response=await fetcher(path,{method,credentials:'same-origin',cache:'no-store',signal,\n        ...(body instanceof FormData?{body}:body?{headers:{'Content-Type':'application/json'},body:JSON.stringify(body)}:{})});\n    } catch(error) {\n      if(signal?.aborted) throw error;\n      throw new OwnerClientError(503,method==='GET'?'profile_unavailable':'operation_uncertain',method!=='GET');\n    }\n    const value=await response.json().catch(()=>null);\n    if(!response.ok) {\n      const e=value && typeof value==='object' ? value.error : null;\n      throw new OwnerClientError(response.status,typeof e?.code==='string'?e.code:'profile_unavailable',e?.reloadRequired===true || response.status===409);\n    }\n    try{return object(value);}catch{throw new OwnerClientError(503,method==='GET'?'profile_unavailable':'operation_uncertain',method!=='GET');}\n  }\n  async function refresh() {\n    if(!refreshFlight) refreshFlight=request('/api/auth/refresh','POST',{}).then(async()=>{refreshEpoch++;await syncSummary();}).finally(()=>{refreshFlight=undefined;});\n    await refreshFlight;\n  }\n  async function recoverRead<T>(path:string,key:string,parser:(raw:unknown)=>T):Promise<T> {\n    const before=refreshEpoch;\n    try{const result=project((await request(path))[key],parser);await syncSummary();return result;}\n    catch(error){\n      if(!(error instanceof OwnerClientError)||error.status!==401||error.code!=='refresh_required')throw error;\n      if(before===refreshEpoch)await refresh();\n      return project((await request(path))[key],parser);\n    }\n  }\n  function revision(profile:ProfileDto) {\n    if(!profile.galleryAvailable || profile.galleryRevision===null) throw new OwnerClientError(409,'gallery_storage_unavailable',true);\n    return integer(profile.galleryRevision,0);\n  }\n  return {\n    account:async(signal?:AbortSignal)=>accountDto((await request('/api/account/me','GET',undefined,signal)).account),\n    profile:async(signal?:AbortSignal)=>profileDto((await request('/api/profile/me','GET',undefined,signal)).profile),\n    capabilities:async(signal?:AbortSignal)=>{\n      const c=object((await request('/api/profile/media','GET',undefined,signal)).capabilities);\n      return parseCapabilities({purposes:c.purposes,image_mimes:c.imageMimes,max_bytes:c.maxBytes,max_dimension:c.maxDimension,max_pixels:c.maxPixels,max_files:c.maxFiles,max_gallery_items:c.maxGalleryItems,video:c.video,image_decoder_required:c.imageDecoderRequired});\n    },\n    async saveAccount(input:unknown) { const a=project((await request('/api/account/me','POST',parseInput('account',input))).account,accountDto,true);await syncSummary();return a; },\n    async saveProfile(input:unknown) { return project((await request('/api/profile/me','POST',parseInput('profile',input))).profile,profileDto,true); },\n    async submitProfile() { return project((await request('/api/profile/submit','POST',{})).profile,profileDto,true); },\n    async upload(file:File,purpose:PublicMediaPurpose) {\n      const form=new FormData();form.append('file',file);form.append('purpose',purpose);\n      const media=project((await request('/api/profile/media','POST',form)).media,parseUpload,true);\n      if(media.purpose!==purpose)throw new OwnerClientError(503,'operation_uncertain',true);\n      return media;\n    },\n    async addGallery(id:number,caption:string,profile:ProfileDto) {\n      return project((await request('/api/profile/gallery','POST',parseInput('gallery',{media_id:id,caption,kind:'image',expected_revision:revision(profile)}))).gallery,galleryDto,true);\n    },\n    async detachGallery(id:number,profile:ProfileDto) {\n      return project((await request(`/api/profile/gallery/media/${integer(id)}`,'DELETE',{expected_revision:revision(profile)})).gallery,galleryDto,true);\n    },\n    recoverAccount:()=>recoverRead('/api/account/me','account',accountDto),\n    recoverProfile:()=>recoverRead('/api/profile/me','profile',profileDto),\n  };\n}\nexport async function settleOwnerAction<T,S>(operation:()=>Promise<T>,reread:()=>Promise<S>,blockedBefore=false):Promise<{ok:true;value:T}|{ok:false;error:OwnerClientError;state?:S;reloadFailed:boolean}> {\n  try {return {ok:true,value:await operation()};}\n  catch(cause){\n    const error=cause instanceof OwnerClientError?cause:cause instanceof ProfileBoundaryError?new OwnerClientError(cause.status,cause.code):new OwnerClientError(503,'operation_uncertain',true);\n    if(error.reloadRequired || error.status===409){\n      try{return {ok:false,error,state:await reread(),reloadFailed:false};}catch{return {ok:false,error,reloadFailed:true};}\n    }\n    // A plain failed GET/validation response proves no fresh owner state. It\n    // cannot clear a lock established by an earlier uncertain write.\n    return {ok:false,error,reloadFailed:blockedBefore};\n  }\n}\nexport type OwnerClient=ReturnType<typeof createOwnerClient>;\n/** Local form lifetime only, not identity/auth state. Prevents duplicate dispatch and stale component updates. */\nexport function createActionGate(){\n  let generation=0;let busy=false;\n  return {begin(){if(busy)return null;busy=true;const token=++generation;return {current:()=>token===generation,finish:()=>{if(token===generation)busy=false;}};},cancel(){generation++;busy=false;}};\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/lib/seo.test.ts": {
      "sha256": "6906dad1e6876b100e91d709c135a4c0d7b2fcaa958e573933c07ae4c471697d",
      "text": "import assert from \"node:assert/strict\";\nimport { test } from \"node:test\";\nimport type { PublicSpecialistDetail } from \"./contracts/specialists.ts\";\nimport { serializeJsonLd, specialistJsonLd } from \"./seo.ts\";\n\nfunction detail(overrides: Partial<PublicSpecialistDetail> = {}): PublicSpecialistDetail {\n  return {\n    id: 42,\n    slug: \"mina-painter\",\n    title: \"مینا نقاش <&>\",\n    verified: true,\n    rating: { average: 4.5, count: 12 },\n    avatarUrl: null,\n    availability: \"available\",\n    categories: [\"نقاشی\"],\n    cities: [\"تهران\"],\n    description: \"بازسازی <امن> & دقیق\",\n    bio: null,\n    skills: \"رنگ‌آمیزی، پتینه\",\n    experienceYears: 8,\n    responseMinutes: 45,\n    priceHint: \"توافقی\",\n    address: \"تهران\",\n    phoneDisplay: \"09121234567\",\n    coordinates: null,\n    verifiedAt: null,\n    gallery: \"unavailable\",\n    reviews: \"unavailable\",\n    ...overrides,\n  };\n}\n\ntest(\"specialist JSON-LD uses only normalized public detail fields\", () => {\n  const schema = specialistJsonLd(detail());\n\n  assert.equal(schema[\"@type\"], \"LocalBusiness\");\n  assert.equal(schema.name, \"مینا نقاش <&>\");\n  assert.equal(schema.description, \"بازسازی <امن> & دقیق\");\n  assert.deepEqual(schema.address, {\n    \"@type\": \"PostalAddress\",\n    streetAddress: \"تهران\",\n    addressLocality: \"تهران\",\n    addressCountry: \"IR\",\n  });\n  assert.deepEqual(schema.aggregateRating, {\n    \"@type\": \"AggregateRating\",\n    ratingValue: 4.5,\n    reviewCount: 12,\n    bestRating: 5,\n    worstRating: 1,\n  });\n  assert.equal(\"telephone\" in schema, false);\n  assert.equal(\"review\" in schema, false);\n  assert.equal(\"numberOfEmployees\" in schema, false);\n});\n\ntest(\"specialist JSON-LD omits unavailable rating and address\", () => {\n  const schema = specialistJsonLd(detail({ rating: null, address: null, cities: [] }));\n\n  assert.equal(\"aggregateRating\" in schema, false);\n  assert.equal(\"address\" in schema, false);\n});\n\ntest(\"serializes JSON-LD without executable tag delimiters or entity syntax\", () => {\n  const serialized = serializeJsonLd({ value: \"</script><img src=x>&\" });\n\n  assert.equal(serialized.includes(\"<\"), false);\n  assert.equal(serialized.includes(\"&\"), false);\n  assert.equal(JSON.parse(serialized).value, \"</script><img src=x>&\");\n});\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/lib/data.ts": {
      "sha256": "872d020929e148f6eb1d7f6d0e364f4657b1b544463bc218811abbb7b77d844b",
      "text": "/* ---------- Karban domain types & Persian dummy data ---------- */\n\nexport interface Category {\n  id: string;\n  slug: string;\n  title: string;\n  icon: string; // lucide icon name key\n  jobs: number;\n}\n\nexport interface PortfolioItem {\n  id: string;\n  title: string;\n  hue: number; // used to render deterministic gradient art\n  tag: string;\n}\n\nexport interface Review {\n  id: string;\n  author: string;\n  rating: number;\n  date: string;\n  text: string;\n  project: string;\n}\n\nexport interface Specialist {\n  id: string;\n  slug: string;\n  name: string;\n  title: string;\n  category: string;\n  city: string;\n  neighborhood: string;\n  rating: number;\n  reviewsCount: number;\n  distanceKm: number;\n  verified: boolean;\n  available: boolean;\n  experienceYears: number;\n  completedJobs: number;\n  responseTime: string;\n  hue: number;\n  about: string;\n  skills: string[];\n  portfolio: PortfolioItem[];\n  reviews: Review[];\n}\n\nexport type ProjectStatus =\n  | \"در انتظار\"\n  | \"در حال انجام\"\n  | \"تکمیل شده\"\n  | \"لغو شده\";\n\nexport interface Project {\n  id: string;\n  title: string;\n  category: string;\n  status: ProjectStatus;\n  budget: number;\n  createdAt: string;\n  proposals: number;\n  neighborhood: string;\n}\n\nexport interface Lead {\n  id: string;\n  projectTitle: string;\n  category: string;\n  budget: number;\n  neighborhood: string;\n  distanceKm: number;\n  postedAgo: string;\n  clientName: string;\n  clientPhone: string;\n  price: number; // lead unlock price\n  unlocked: boolean;\n}\n\nexport const CITIES = [\n  \"تهران\",\n  \"مشهد\",\n  \"اصفهان\",\n  \"شیراز\",\n  \"تبریز\",\n  \"کرج\",\n  \"قم\",\n  \"اهواز\",\n] as const;\n\nexport const CATEGORIES: Category[] = [\n  { id: \"c1\", slug: \"electrical\", title: \"برق‌کاری\", icon: \"zap\", jobs: 482 },\n  { id: \"c2\", slug: \"plumbing\", title: \"لوله‌کشی\", icon: \"wrench\", jobs: 391 },\n  { id: \"c3\", slug: \"painting\", title: \"نقاشی ساختمان\", icon: \"paintbrush\", jobs: 356 },\n  { id: \"c4\", slug: \"tiling\", title: \"کاشی‌کاری\", icon: \"grid\", jobs: 274 },\n  { id: \"c5\", slug: \"carpentry\", title: \"نجاری\", icon: \"hammer\", jobs: 233 },\n  { id: \"c6\", slug: \"hvac\", title: \"تاسیسات و تهویه\", icon: \"thermometer\", jobs: 218 },\n  { id: \"c7\", slug: \"welding\", title: \"جوشکاری\", icon: \"flame\", jobs: 187 },\n  { id: \"c8\", slug: \"gypsum\", title: \"گچ‌کاری\", icon: \"layers\", jobs: 165 },\n  { id: \"c9\", slug: \"stone\", title: \"سنگ‌کاری\", icon: \"mountain\", jobs: 142 },\n  { id: \"c10\", slug: \"renovation\", title: \"بازسازی کامل\", icon: \"house\", jobs: 128 },\n  { id: \"c11\", slug: \"roofing\", title: \"ایزوگام و بام\", icon: \"umbrella\", jobs: 97 },\n  { id: \"c12\", slug: \"landscaping\", title: \"محوطه‌سازی\", icon: \"trees\", jobs: 76 },\n];\n\nconst LOREM_FA =\n  \"کار با کیفیت و تحویل به‌موقع، اولویت اصلی من است. با بیش از یک دهه تجربه در پروژه‌های مسکونی و اداری، تمام مراحل کار را با جزئیات کامل و مطابق استاندارد اجرا می‌کنم.\";\n\nexport const SPECIALISTS: Specialist[] = [\n  {\n    id: \"s1\",\n    slug: \"amir-hosseini\",\n    name: \"امیر حسینی\",\n    title: \"استادکار برق ساختمان\",\n    category: \"برق‌کاری\",\n    city: \"تهران\",\n    neighborhood: \"سعادت‌آباد\",\n    rating: 4.9,\n    reviewsCount: 127,\n    distanceKm: 1.2,\n    verified: true,\n    available: true,\n    experienceYears: 12,\n    completedJobs: 340,\n    responseTime: \"کمتر از ۱ ساعت\",\n    hue: 45,\n    about:\n      \"متخصص برق‌کشی ساختمان‌های مسکونی و تجاری با ۱۲ سال سابقه. \" + LOREM_FA,\n    skills: [\"برق‌کشی توکار\", \"نصب لوستر\", \"هوشمندسازی\", \"رفع اتصالی\", \"تابلو برق\"],\n    portfolio: [\n      { id: \"p1\", title: \"برق‌کشی کامل آپارتمان ۱۲۰ متری\", hue: 42, tag: \"مسکونی\" },\n      { id: \"p2\", title: \"هوشمندسازی ویلا در لواسان\", hue: 200, tag: \"هوشمند\" },\n      { id: \"p3\", title: \"نورپردازی محوطه باغ\", hue: 280, tag: \"نورپردازی\" },\n      { id: \"p4\", title: \"تابلو برق صنعتی کارگاه\", hue: 10, tag: \"صنعتی\" },\n      { id: \"p5\", title: \"بازسازی سیم‌کشی ساختمان قدیمی\", hue: 160, tag: \"بازسازی\" },\n    ],\n    reviews: [\n      {\n        id: \"r1\",\n        author: \"مهدی رضایی\",\n        rating: 5,\n        date: \"۲ هفته پیش\",\n        text: \"بسیار منظم و دقیق. کار برق‌کشی واحد ما را سه روزه و تمیز تحویل داد. قیمت هم منصفانه بود.\",\n        project: \"برق‌کشی آپارتمان\",\n      },\n      {\n        id: \"r2\",\n        author: \"سارا محمدی\",\n        rating: 5,\n        date: \"۱ ماه پیش\",\n        text: \"برای نصب لوستر و رفع اتصالی تماس گرفتم، همان روز آمد و مشکل را حل کرد. کاملاً حرفه‌ای.\",\n        project: \"رفع اتصالی\",\n      },\n      {\n        id: \"r3\",\n        author: \"رضا کریمی\",\n        rating: 4,\n        date: \"۲ ماه پیش\",\n        text: \"کیفیت کار عالی بود، فقط شروع پروژه یک روز عقب افتاد. در کل راضی هستم و پیشنهاد می‌کنم.\",\n        project: \"هوشمندسازی\",\n      },\n    ],\n  },\n  {\n    id: \"s2\",\n    slug: \"hasan-moradi\",\n    name: \"حسن مرادی\",\n    title: \"لوله‌کش و تاسیسات‌کار\",\n    category: \"لوله‌کشی\",\n    city: \"تهران\",\n    neighborhood: \"پونک\",\n    rating: 4.8,\n    reviewsCount: 94,\n    distanceKm: 2.8,\n    verified: true,\n    available: true,\n    experienceYears: 15,\n    completedJobs: 410,\n    responseTime: \"حدود ۲ ساعت\",\n    hue: 205,\n    about: \"استادکار لوله‌کشی آب و فاضلاب و شوفاژ. \" + LOREM_FA,\n    skills: [\"لوله‌کشی آب\", \"شوفاژ\", \"رفع نم\", \"تشخیص ترکیدگی\", \"پکیج\"],\n    portfolio: [\n      { id: \"p1\", title: \"لوله‌کشی کامل ساختمان ۴ طبقه\", hue: 210, tag: \"مسکونی\" },\n      { id: \"p2\", title: \"نصب پکیج و رادیاتور\", hue: 30, tag: \"گرمایش\" },\n      { id: \"p3\", title: \"رفع نم سرویس بهداشتی\", hue: 180, tag: \"تعمیرات\" },\n      { id: \"p4\", title: \"موتورخانه مجتمع تجاری\", hue: 260, tag: \"تجاری\" },\n    ],\n    reviews: [\n      {\n        id: \"r1\",\n        author: \"علی نوری\",\n        rating: 5,\n        date: \"۱ هفته پیش\",\n        text: \"ترکیدگی لوله را بدون تخریب اضافی پیدا و ترمیم کرد. واقعاً کارش را بلد است.\",\n        project: \"تشخیص ترکیدگی\",\n      },\n      {\n        id: \"r2\",\n        author: \"نازنین احمدی\",\n        rating: 4.5,\n        date: \"۳ هفته پیش\",\n        text: \"نصب پکیج تمیز و سریع انجام شد. توضیحات کامل هم درباره نگهداری داد.\",\n        project: \"نصب پکیج\",\n      },\n    ],\n  },\n  {\n    id: \"s3\",\n    slug: \"maryam-sadeghi\",\n    name: \"مریم صادقی\",\n    title: \"طراح و نقاش ساختمان\",\n    category: \"نقاشی ساختمان\",\n    city: \"تهران\",\n    neighborhood: \"ونک\",\n    rating: 5.0,\n    reviewsCount: 68,\n    distanceKm: 3.5,\n    verified: true,\n    available: false,\n    experienceYears: 8,\n    completedJobs: 190,\n    responseTime: \"کمتر از ۳۰ دقیقه\",\n    hue: 320,\n    about: \"متخصص رنگ‌آمیزی مدرن، پتینه و کاغذ دیواری. \" + LOREM_FA,\n    skills: [\"رنگ روغنی\", \"پتینه\", \"کاغذ دیواری\", \"کنیتکس\", \"رنگ کودک\"],\n    portfolio: [\n      { id: \"p1\", title: \"پتینه دیوار پذیرایی\", hue: 330, tag: \"پتینه\" },\n      { id: \"p2\", title: \"اتاق کودک با طرح ابر\", hue: 190, tag: \"اتاق کودک\" },\n      { id: \"p3\", title: \"نقاشی کامل دفتر اداری\", hue: 90, tag: \"اداری\" },\n      { id: \"p4\", title: \"کاغذ دیواری سه‌بعدی\", hue: 250, tag: \"کاغذ دیواری\" },\n      { id: \"p5\", title: \"نمای داخلی کافه\", hue: 20, tag: \"تجاری\" },\n      { id: \"p6\", title: \"رنگ‌آمیزی راه‌پله برج\", hue: 140, tag: \"مشاعات\" },\n    ],\n    reviews: [\n      {\n        id: \"r1\",\n        author: \"شیما تهرانی\",\n        rating: 5,\n        date: \"۴ روز پیش\",\n        text: \"سلیقه فوق‌العاده‌ای دارد. اتاق کودکم را به زیباترین شکل ممکن درآورد. ممنونم!\",\n        project: \"اتاق کودک\",\n      },\n      {\n        id: \"r2\",\n        author: \"کامران وفایی\",\n        rating: 5,\n        date: \"۲ هفته پیش\",\n        text: \"دفتر ما را در تعطیلات آخر هفته بدون توقف کار رنگ کرد. نتیجه بی‌نقص بود.\",\n        project: \"نقاشی اداری\",\n      },\n    ],\n  },\n  {\n    id: \"s4\",\n    slug: \"javad-akbari\",\n    name: \"جواد اکبری\",\n    title: \"کاشی‌کار و سرامیک‌کار\",\n    category: \"کاشی‌کاری\",\n    city: \"تهران\",\n    neighborhood: \"نارمک\",\n    rating: 4.7,\n    reviewsCount: 81,\n    distanceKm: 5.1,\n    verified: false,\n    available: true,\n    experienceYears: 10,\n    completedJobs: 265,\n    responseTime: \"حدود ۱ ساعت\",\n    hue: 25,\n    about: \"کاشی‌کاری کف و بدنه، سرامیک اسلب و پرسلان. \" + LOREM_FA,\n    skills: [\"سرامیک اسلب\", \"کاشی استخری\", \"بندکشی\", \"کف‌سازی\"],\n    portfolio: [\n      { id: \"p1\", title: \"اسلب پرسلان لابی برج\", hue: 220, tag: \"لوکس\" },\n      { id: \"p2\", title: \"کاشی‌کاری استخر ویلا\", hue: 185, tag: \"استخر\" },\n      { id: \"p3\", title: \"سرویس بهداشتی مستر\", hue: 35, tag: \"مسکونی\" },\n    ],\n    reviews: [\n      {\n        id: \"r1\",\n        author: \"بهرام قاسمی\",\n        rating: 4.5,\n        date: \"۱ ماه پیش\",\n        text: \"کاشی‌کاری حمام را با دقت میلی‌متری انجام داد. بندکشی‌ها کاملاً یکدست است.\",\n        project: \"سرویس بهداشتی\",\n      },\n    ],\n  },\n  {\n    id: \"s5\",\n    slug: \"mohsen-zare\",\n    name: \"محسن زارع\",\n    title: \"نجار و کابینت‌ساز\",\n    category: \"نجاری\",\n    city: \"تهران\",\n    neighborhood: \"تهرانپارس\",\n    rating: 4.9,\n    reviewsCount: 112,\n    distanceKm: 6.4,\n    verified: true,\n    available: true,\n    experienceYears: 18,\n    completedJobs: 380,\n    responseTime: \"کمتر از ۱ ساعت\",\n    hue: 95,\n    about: \"ساخت کابینت، کمد دیواری و دکوراسیون چوبی سفارشی. \" + LOREM_FA,\n    skills: [\"کابینت MDF\", \"کمد دیواری\", \"درب چوبی\", \"دکور تلویزیون\"],\n    portfolio: [\n      { id: \"p1\", title: \"کابینت آشپزخانه هایگلاس\", hue: 50, tag: \"آشپزخانه\" },\n      { id: \"p2\", title: \"کمد دیواری اتاق خواب\", hue: 120, tag: \"اتاق خواب\" },\n      { id: \"p3\", title: \"دکور تلویزیون مدرن\", hue: 300, tag: \"پذیرایی\" },\n      { id: \"p4\", title: \"کتابخانه چوب گردو\", hue: 15, tag: \"لوکس\" },\n    ],\n    reviews: [\n      {\n        id: \"r1\",\n        author: \"فرزانه مقدم\",\n        rating: 5,\n        date: \"۵ روز پیش\",\n        text: \"کابینت آشپزخانه دقیقاً مطابق طرح سه‌بعدی از آب درآمد. نصب هم فوق‌العاده تمیز بود.\",\n        project: \"کابینت آشپزخانه\",\n      },\n      {\n        id: \"r2\",\n        author: \"امید شریفی\",\n        rating: 5,\n        date: \"۳ هفته پیش\",\n        text: \"چوب باکیفیت، اتصالات محکم و قیمت منطقی. بهترین نجاری که تا حالا باهاش کار کردم.\",\n        project: \"کتابخانه\",\n      },\n    ],\n  },\n  {\n    id: \"s6\",\n    slug: \"reza-ghanbari\",\n    name: \"رضا قنبری\",\n    title: \"متخصص تاسیسات و تهویه\",\n    category: \"تاسیسات و تهویه\",\n    city: \"تهران\",\n    neighborhood: \"شهرک غرب\",\n    rating: 4.6,\n    reviewsCount: 57,\n    distanceKm: 2.1,\n    verified: true,\n    available: true,\n    experienceYears: 9,\n    completedJobs: 175,\n    responseTime: \"حدود ۳ ساعت\",\n    hue: 175,\n    about: \"نصب و سرویس داکت اسپلیت، چیلر و سیستم‌های تهویه مطبوع. \" + LOREM_FA,\n    skills: [\"داکت اسپلیت\", \"چیلر\", \"فن کویل\", \"کولر گازی\"],\n    portfolio: [\n      { id: \"p1\", title: \"داکت اسپلیت پنت‌هاوس\", hue: 170, tag: \"مسکونی\" },\n      { id: \"p2\", title: \"تهویه سالن ورزشی\", hue: 240, tag: \"تجاری\" },\n    ],\n    reviews: [\n      {\n        id: \"r1\",\n        author: \"پیمان راد\",\n        rating: 4.5,\n        date: \"۲ هفته پیش\",\n        text: \"نصب داکت اسپلیت را اصولی و با نقشه انجام داد. صدای دستگاه تقریباً صفر است.\",\n        project: \"داکت اسپلیت\",\n      },\n    ],\n  },\n];\n\nexport const CLIENT_PROJECTS: Project[] = [\n  {\n    id: \"pr1\",\n    title: \"بازسازی سرویس بهداشتی و حمام\",\n    category: \"کاشی‌کاری\",\n    status: \"در حال انجام\",\n    budget: 45_000_000,\n    createdAt: \"۳ روز پیش\",\n    proposals: 8,\n    neighborhood: \"سعادت‌آباد\",\n  },\n  {\n    id: \"pr2\",\n    title: \"برق‌کشی واحد ۹۵ متری نوساز\",\n    category: \"برق‌کاری\",\n    status: \"در انتظار\",\n    budget: 30_000_000,\n    createdAt: \"۱ هفته پیش\",\n    proposals: 12,\n    neighborhood: \"پونک\",\n  },\n  {\n    id: \"pr3\",\n    title: \"نقاشی کامل آپارتمان دو خوابه\",\n    category: \"نقاشی ساختمان\",\n    status: \"تکمیل شده\",\n    budget: 18_000_000,\n    createdAt: \"۱ ماه پیش\",\n    proposals: 15,\n    neighborhood: \"ونک\",\n  },\n  {\n    id: \"pr4\",\n    title: \"نصب کابینت آشپزخانه\",\n    category: \"نجاری\",\n    status: \"لغو شده\",\n    budget: 85_000_000,\n    createdAt: \"۲ ماه پیش\",\n    proposals: 6,\n    neighborhood: \"نارمک\",\n  },\n];\n\nexport const PRO_LEADS: Lead[] = [\n  {\n    id: \"l1\",\n    projectTitle: \"برق‌کشی کامل واحد ۱۱۰ متری\",\n    category: \"برق‌کاری\",\n    budget: 38_000_000,\n    neighborhood: \"سعادت‌آباد\",\n    distanceKm: 1.8,\n    postedAgo: \"۲۰ دقیقه پیش\",\n    clientName: \"آقای رحیمی\",\n    clientPhone: \"۰۹۱۲ ××× ۴۸۷۲\",\n    price: 95_000,\n    unlocked: false,\n  },\n  {\n    id: \"l2\",\n    projectTitle: \"رفع اتصالی و تعویض فیوز مرکزی\",\n    category: \"برق‌کاری\",\n    budget: 5_000_000,\n    neighborhood: \"شهرک غرب\",\n    distanceKm: 3.2,\n    postedAgo: \"۱ ساعت پیش\",\n    clientName: \"خانم موسوی\",\n    clientPhone: \"۰۹۳۵ ××× ۱۱۹۰\",\n    price: 45_000,\n    unlocked: false,\n  },\n  {\n    id: \"l3\",\n    projectTitle: \"نورپردازی سقف کناف پذیرایی\",\n    category: \"برق‌کاری\",\n    budget: 12_000_000,\n    neighborhood: \"مرزداران\",\n    distanceKm: 4.5,\n    postedAgo: \"۳ ساعت پیش\",\n    clientName: \"آقای صالحی\",\n    clientPhone: \"۰۹۱۹ ××× ۶۶۰۳\",\n    price: 65_000,\n    unlocked: true,\n  },\n];\n\nexport function getSpecialist(slug: string): Specialist | undefined {\n  return SPECIALISTS.find((s) => s.slug === slug);\n}\n"
