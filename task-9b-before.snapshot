    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/lib/owner-ui.test.ts": {
      "sha256": "7f56912e0ae818275a6babe2538f553903347611d2250c23d057c66c74b42d3b",
      "text": "import assert from 'node:assert/strict';\nimport { test } from 'node:test';\nimport * as ui from './owner-ui.ts';\n\ntest('account form sends only exact editable fields and explicit null clears', () => {\n  assert.equal(typeof ui.accountInput, 'function');\n  const form = new FormData(); form.set('display_name', 'آزاده'); form.set('account_city_id', ''); form.set('role', 'specialist');\n  assert.deepEqual(ui.accountInput(form), {display_name:'آزاده',account_city_id:null});\n  form.set('account_city_id','1e2'); assert.throws(() => ui.accountInput(form));\n  form.set('account_city_id','2'); form.set('display_name','x'.repeat(101)); assert.throws(() => ui.accountInput(form));\n});\ntest('professional inputs preserve taxonomy IDs, optional clears and backend limits', () => {\n  assert.equal(typeof ui.profileInput, 'function');\n  const form = new FormData();\n  for (const [key,value] of Object.entries({title:'نقاش',bio:'',skills:'',city_id:'',availability:'',experience_years:'0',price_hint:'',address:''})) form.set(key,value);\n  form.append('category_ids','17'); form.append('category_ids','29');\n  assert.deepEqual(ui.profileInput(form), {title:'نقاش',bio:'',skills:'',category_ids:[17,29],city_id:null,availability:'',experience_years:0,price_hint:'',address:''});\n  form.set('bio','a\\nb'); assert.throws(() => ui.profileInput(form));\n});\ntest('recovery targets are bounded; navigation follows authoritative role', () => {\n  assert.equal(typeof ui.recoveryTarget, 'function');\n  for (const target of ['https://bad.test','//bad.test','/pro/profile?next=x','/api/auth/refresh',undefined]) assert.equal(ui.recoveryTarget(target),'/account');\n  assert.equal(ui.recoveryTarget('/pro/profile'),'/pro/profile');\n  assert.deepEqual(ui.accountLinks('client').map(x=>x.href), ['/account','/dashboard']);\n  assert.deepEqual(ui.accountLinks('specialist').map(x=>x.href), ['/account','/pro/profile','/pro']);\n});\ntest('page composition reads direct helpers, guards both roles and never reads specialist data for client', async () => {\n  assert.equal(typeof ui.loadOwnerScreen,'function');\n  const calls:string[]=[];\n  const ports = {account:async()=>{calls.push('account');return {role:'client'};},profile:async()=>{calls.push('profile');return {};},capabilities:async()=>{calls.push('capabilities');return {};},cities:async()=>[],categories:async()=>[]};\n  const denied = await ui.loadOwnerScreen('profile',ports as never);\n  assert.deepEqual(denied,{kind:'redirect',location:'/dashboard'}); assert.deepEqual(calls,['account']);\n  const allowed = await ui.loadOwnerScreen('account',ports as never); assert.equal(allowed.kind,'ready');\n  const expired = await ui.loadOwnerScreen('account',{...ports,account:async()=>{throw {code:'refresh_required',status:401};}} as never);\n  assert.deepEqual(expired,{kind:'recovery',target:'/account'});\n  const unavailable = await ui.loadOwnerScreen('account',{...ports,account:async()=>{throw {code:'auth_unavailable',status:503};}} as never);\n  assert.deepEqual(unavailable,{kind:'unavailable'});\n});\ntest('dashboard entry distinguishes wrong role, expiry, lost session and provider outage',async()=>{\n assert.equal(typeof ui.loadAccountEntry,'function');\n assert.deepEqual(await ui.loadAccountEntry('specialist',async()=>({role:'client'}) as never,'/pro'),{kind:'redirect',location:'/dashboard'});\n assert.deepEqual(await ui.loadAccountEntry('client',async()=>{throw {code:'refresh_required'};},'/dashboard'),{kind:'recovery',target:'/dashboard'});\n assert.deepEqual(await ui.loadAccountEntry('client',async()=>{throw {code:'unauthenticated'};},'/dashboard'),{kind:'redirect',location:'/auth/login'});\n assert.deepEqual(await ui.loadAccountEntry('client',async()=>{throw {code:'auth_unavailable'};},'/dashboard'),{kind:'unavailable'});\n});\ntest('known codec rejection allows a different explicit file, while uncertain uploads stay locked',()=>{\n assert.equal(typeof ui.uploadOutcomeUncertain,'function');\n assert.equal(ui.uploadOutcomeUncertain({status:415,code:'image_decoder_unavailable_or_invalid',reloadRequired:true}),false);\n assert.equal(ui.uploadOutcomeUncertain({status:503,code:'operation_uncertain',reloadRequired:true}),true);\n assert.match(ui.ownerErrorText({status:422,code:'profile_incomplete',reloadRequired:true}),/تکمیل/);\n});\ntest('codec, conflicts and uncertain mutations have actionable non-fictional messages',()=>{\n  assert.equal(typeof ui.ownerErrorText,'function');\n  assert.match(ui.ownerErrorText({status:415,code:'image_decoder_unavailable_or_invalid'}),/WebP|پردازش/);\n  assert.match(ui.ownerErrorText({status:409,code:'gallery_revision_conflict'}),/بارگذاری/);\n  assert.match(ui.ownerErrorText({status:503,code:'operation_uncertain'}),/ممکن/);\n});\ntest('422 validation copy names only allowlisted fields and never echoes backend details',()=>{\n  const message=(code:string)=>ui.ownerErrorText({status:422,code,message:'PRIVATE backend details'} as ui.OwnerError);\n  assert.match(message('invalid_display_name'),/نام/);\n  assert.match(message('invalid_city'),/شهر/);\n  assert.match(message('unknown_field'),/فیلد|ورودی/);\n  for(const code of ['unknown_field','invalid_display_name','invalid_city','PRIVATE backend details']) {\n    assert.doesNotMatch(message(code),/PRIVATE|چندخطی|دسته/);\n  }\n  assert.equal(message('PRIVATE backend details'),message('unrecognized_code'));\n});\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/lib/specialist-search.test.ts": {
      "sha256": "b34d753cb34536c135460f650ef5cafabc6ce365fe5d9b58d8aa37ef0fd471a9",
      "text": "import assert from \"node:assert/strict\";\nimport { test } from \"node:test\";\nimport {\n  parseSpecialistSearchParams,\n  buildSpecialistSearchQuery,\n  buildSpecialistPaginationQuery,\n} from \"./specialist-search.ts\";\n\ntest(\"normalizes supported search parameters and Persian pagination\", () => {\n  const parsed = parseSpecialistSearchParams({\n    q: [\"  کاشی & رنگ  \", \"ignored\"],\n    category: \"کاشی‌کاری\",\n    city: \"تهران\",\n    verified: \"true\",\n    page: \"۳\",\n    per_page: \"99\",\n    radius: \"10\",\n    neighborhood: \"north\",\n  });\n  assert.deepEqual(parsed, {\n    q: \"کاشی & رنگ\",\n    category: \"کاشی‌کاری\",\n    city: \"تهران\",\n    verified: true,\n    page: 3,\n    perPage: 30,\n  });\n  assert.equal(buildSpecialistSearchQuery(parsed), \"q=%DA%A9%D8%A7%D8%B4%DB%8C+%26+%D8%B1%D9%86%DA%AF&category=%DA%A9%D8%A7%D8%B4%DB%8C%E2%80%8C%DA%A9%D8%A7%D8%B1%DB%8C&city=%D8%AA%D9%87%D8%B1%D8%A7%D9%86&verified=1&page=3&per_page=30\");\n});\n\ntest(\"uses deterministic safe fallbacks and omits false verified\", () => {\n  const parsed = parseSpecialistSearchParams({ verified: \"0\", page: \"bad\", per_page: \"0\" });\n  assert.deepEqual(parsed, { q: \"\", category: \"\", city: \"\", verified: false, page: 1, perPage: 20 });\n  assert.equal(buildSpecialistSearchQuery(parsed), \"page=1&per_page=20\");\n  assert.equal(buildSpecialistPaginationQuery(parsed, 4), \"page=4&per_page=20\");\n  assert.equal(buildSpecialistPaginationQuery(parsed, 4, { q: \"new\", city: \"شیراز\" }), \"q=new&city=%D8%B4%DB%8C%D8%B1%D8%A7%D8%B2&page=1&per_page=20\");\n});\n\ntest(\"caps query text and rejects unsupported values without reflecting them\", () => {\n  const parsed = parseSpecialistSearchParams({ q: \"x\".repeat(500), category: \"../bad\", city: \"\", verified: \"no\" });\n  assert.equal(parsed.q.length, 200);\n  assert.equal(parsed.category, \"../bad\");\n  assert.equal(buildSpecialistSearchQuery(parsed).includes(\"radius\"), false);\n});\n\ntest(\"encodes a single safe detail slug\", async () => {\n  const { buildSpecialistDetailPath } = await import(\"./specialist-search.ts\");\n  assert.equal(buildSpecialistDetailPath(\"sara نقاش\"), \"specialists/sara%20%D9%86%D9%82%D8%A7%D8%B4\");\n  for (const slug of [\"\", \"../x\", \"a/b\", \"a\\\\b\", \"a?b\", \"a#b\", \"\\u0000\"]) {\n    assert.throws(() => buildSpecialistDetailPath(slug));\n  }\n});\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/lib/tap-feedback.test.ts": {
      "sha256": "9843acd815a3a10cc0e99a9995be0815a79948d2a905279322cfb25144789bbe",
      "text": "import assert from 'node:assert/strict';\nimport {test} from 'node:test';\nimport * as motion from './tap-feedback.ts';\ntest('shared primitive tap feedback preserves its spring but honors reduced motion',()=>{\n assert.equal(typeof motion.tapFeedback,'function');\n assert.deepEqual(motion.tapFeedback(true,true),{scale:1,duration:0});\n assert.deepEqual(motion.tapFeedback(true,false),{scale:1,duration:0});\n assert.deepEqual(motion.tapFeedback(false,true),{scale:0.95,duration:0.12,ease:'power2.out'});\n assert.deepEqual(motion.tapFeedback(false,false),{scale:1,duration:0.55,ease:'elastic.out(1.1, 0.45)'});\n});\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/lib/owner-ui.ts": {
      "sha256": "6fa37e7429320eceb6912a309d02e9b3582cd75cbf7d3c48648b7583dad24f8c",
      "text": "import { parseInput, type AccountDto, type ProfileDto, type MediaCapabilitiesDto } from '../services/profile/profile-contracts.ts';\nimport type { PublicTerm } from './contracts/specialists.ts';\nimport type { RegistrationRole } from './contracts/auth.ts';\n\nexport const OWNER_TARGETS = ['/account','/pro/profile','/dashboard','/pro'] as const;\nexport type OwnerTarget = typeof OWNER_TARGETS[number];\nexport function recoveryTarget(value: unknown): OwnerTarget {\n  return OWNER_TARGETS.includes(value as OwnerTarget) ? value as OwnerTarget : '/account';\n}\nexport function accountLinks(role: RegistrationRole) {\n  return [ {href:'/account',label:'حساب شخصی'}, ...(role === 'specialist' ? [{href:'/pro/profile',label:'ویرایش پروفایل حرفه‌ای'}] : []), {href:role === 'specialist' ? '/pro':'/dashboard',label:'داشبورد'} ];\n}\nfunction numeric(form: FormData, key: string): number | null {\n  const raw = form.get(key);\n  if (raw === '') return null;\n  if (typeof raw !== 'string' || !/^(0|[1-9]\\d*)$/.test(raw)) throw new Error('invalid_request');\n  return Number(raw);\n}\nexport function accountInput(form: FormData) {\n  return parseInput('account',{display_name:form.get('display_name'),account_city_id:numeric(form,'account_city_id')});\n}\nexport function profileInput(form: FormData) {\n  const fields = Object.fromEntries(['title','bio','skills','availability','price_hint','address'].map(key=>[key,form.get(key)]));\n  const category_ids = form.getAll('category_ids').map(raw=>{\n    if(typeof raw !== 'string' || !/^[1-9]\\d*$/.test(raw)) throw new Error('invalid_request'); return Number(raw);\n  });\n  return parseInput('profile',{...fields,category_ids,city_id:numeric(form,'city_id'),experience_years:numeric(form,'experience_years')});\n}\nexport interface OwnerError { status: number; code: string; reloadRequired?: boolean; }\nexport function uploadOutcomeUncertain(error:OwnerError):boolean {\n  return error.status>=500 || error.code==='operation_uncertain' || (error.reloadRequired===true && ![413,415,422].includes(error.status));\n}\nexport function ownerErrorText(error: OwnerError): string {\n  if(error.code === 'refresh_required') return 'اعتبار دسترسی تمام شده است؛ بازیابی نشست را انتخاب کنید. تغییرات خودکار تکرار نمی‌شوند.';\n  if(error.status === 401) return 'نشست معتبر نیست؛ دوباره وارد شوید.';\n  if(error.code === 'image_decoder_unavailable_or_invalid') return 'پردازش این تصویر ممکن نیست. پشتیبانی WebP به کُدک سرور وابسته است؛ یک تصویر JPEG یا PNG سالم انتخاب کنید.';\n  if(error.status === 415) return 'این فایل تصویر قابل پشتیبانی نیست. ویدیو پشتیبانی نمی‌شود.';\n  if(error.status === 413) return 'حجم تصویر بیش از حد مجاز است.';\n  if(error.code === 'profile_incomplete') return 'برای ارسال به بررسی، عنوان، دسته و شهر خدمت را تکمیل و ذخیره کنید.';\n  if(error.status === 422) {\n    if(error.code === 'invalid_display_name') return 'نام نمایشی معتبر نیست؛ نامی غیرخالی و حداکثر ۱۰۰ نویسه، بدون خط جدید یا نشانه‌های غیرمجاز وارد کنید.';\n    if(error.code === 'invalid_city') return 'شهر انتخاب‌شده معتبر نیست؛ یکی از شهرهای فهرست را انتخاب کنید.';\n    if(error.code === 'unknown_field') return 'درخواست شامل فیلد غیرمجاز است؛ صفحه را دوباره بارگذاری و ورودی‌ها را بررسی کنید.';\n    return 'اطلاعات درخواست معتبر نیست؛ ورودی‌ها را بررسی و دوباره تلاش کنید.';\n  }\n  if(error.code === 'operation_uncertain') return 'ممکن است عملیات ثبت شده باشد. وضعیت را دوباره بارگذاری کنید؛ ارسال خودکار تکرار نمی‌شود.';\n  if(error.status === 409 || error.reloadRequired) return 'وضعیت ممکن است تغییر کرده باشد. اطلاعات تازه بارگذاری می‌شود؛ پیش از اقدام دوباره آن را بررسی کنید.';\n  return 'اطلاعات فعلاً در دسترس نیست. بارگذاری مجدد را انتخاب کنید.';\n}\nexport interface OwnerReadPorts {\n  account(): Promise<AccountDto>; profile(): Promise<ProfileDto>; capabilities():Promise<MediaCapabilitiesDto>;\n  cities():Promise<PublicTerm[]>; categories():Promise<PublicTerm[]>;\n}\nexport type OwnerScreen =\n | {kind:'ready';account:AccountDto;profile:ProfileDto|null;capabilities:MediaCapabilitiesDto|null;cities:PublicTerm[];categories:PublicTerm[];optionsUnavailable:boolean}\n | {kind:'redirect';location:'/auth/login'|'/dashboard'|'/pro'}\n | {kind:'recovery';target:OwnerTarget}\n | {kind:'unavailable'};\nexport async function loadAccountEntry(role:RegistrationRole,read:()=>Promise<AccountDto>,target:OwnerTarget):Promise<{kind:'ready';account:AccountDto}|Exclude<OwnerScreen,{kind:'ready'}>> {\n  try {\n    const account=await read();\n    if(account.role!==role)return {kind:'redirect',location:account.role==='client'?'/dashboard':'/pro'};\n    return {kind:'ready',account};\n  }catch(error){\n    const code=error&&typeof error==='object'&&'code' in error?error.code:null;\n    if(code==='refresh_required')return {kind:'recovery',target};\n    if(code==='unauthenticated'||code==='refresh_cancelled')return {kind:'redirect',location:'/auth/login'};\n    return {kind:'unavailable'};\n  }\n}\n/** Server composition uses direct injected helpers; never writes cookies or issues self HTTP. */\nexport async function loadOwnerScreen(kind:'account'|'profile',ports:OwnerReadPorts):Promise<OwnerScreen> {\n  try {\n    const account=await ports.account();\n    if(kind==='profile' && account.role!=='specialist') return {kind:'redirect',location:'/dashboard'};\n    const profile=kind==='profile'?await ports.profile():null;\n    const [capabilities,cities,categories]=await Promise.all([\n      ports.capabilities().catch(()=>null),ports.cities().catch(()=>null),\n      kind==='profile'?ports.categories().catch(()=>null):Promise.resolve([]),\n    ]);\n    return {kind:'ready',account,profile,capabilities,cities:cities??[],categories:categories??[],optionsUnavailable:cities===null||categories===null};\n  } catch(error) {\n    const code=error && typeof error==='object' && 'code' in error ? error.code : null;\n    if(code==='refresh_required') return {kind:'recovery',target:kind==='profile'?'/pro/profile':'/account'};\n    if(code==='unauthenticated'||code==='refresh_cancelled') return {kind:'redirect',location:'/auth/login'};\n    return {kind:'unavailable'};\n  }\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/lib/tap-feedback.ts": {
      "sha256": "dc2d1bb896a3693f1b71019c0e9848411444e92edddc5c613497217cb163fe1b",
      "text": "export function tapFeedback(reduced:boolean,pressed:boolean) {\n  if(reduced)return {scale:1,duration:0};\n  return pressed?{scale:0.95,duration:0.12,ease:'power2.out'}:{scale:1,duration:0.55,ease:'elastic.out(1.1, 0.45)'};\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/lib/public-specialist-pagination.test.ts": {
      "sha256": "bdfa07fe11b699c56003d5291939ea5dd38622a3f9b20eb0677df2688c685041",
      "text": "import assert from \"node:assert/strict\";\nimport { test } from \"node:test\";\nimport {\n  CatalogPaginationLimitError,\n  buildCatalogPaginationWindow,\n  loadBoundedCatalogPages,\n} from \"./public-specialist-pagination.ts\";\n\ninterface Page {\n  page: number;\n  pages: number;\n  items: { slug: string }[];\n}\n\nfunction page(pageNumber: number, totalPages: number): Page {\n  return { page: pageNumber, pages: totalPages, items: [{ slug: `specialist-${pageNumber}` }] };\n}\n\ntest(\"builds a constant-size pagination window for huge safe page counts\", () => {\n  const totalPages = Number.MAX_SAFE_INTEGER;\n  const window = buildCatalogPaginationWindow(42, totalPages);\n\n  assert.deepEqual(window, [1, \"ellipsis\", 40, 41, 42, 43, 44, \"ellipsis\", totalPages]);\n  assert.equal(window.length, 9);\n  assert.deepEqual(buildCatalogPaginationWindow(totalPages, totalPages), [1, \"ellipsis\", totalPages - 2, totalPages - 1, totalPages]);\n});\n\ntest(\"loads every bounded catalog page with no more than four concurrent requests\", async () => {\n  let active = 0;\n  let maximumActive = 0;\n  const calls: number[] = [];\n  const catalogs = await loadBoundedCatalogPages(page(1, 9), async (pageNumber) => {\n    calls.push(pageNumber);\n    active += 1;\n    maximumActive = Math.max(maximumActive, active);\n    await new Promise((resolve) => setTimeout(resolve, 2));\n    active -= 1;\n    return page(pageNumber, 9);\n  });\n\n  assert.equal(maximumActive <= 4, true);\n  assert.deepEqual(calls.sort((left, right) => left - right), [2, 3, 4, 5, 6, 7, 8, 9]);\n  assert.deepEqual(catalogs.map((catalog) => catalog.page), [1, 2, 3, 4, 5, 6, 7, 8, 9]);\n});\n\ntest(\"rejects huge or above-ceiling page counts before allocating or fetching\", async () => {\n  let calls = 0;\n  await assert.rejects(\n    () => loadBoundedCatalogPages(page(1, Number.MAX_SAFE_INTEGER), async (pageNumber) => {\n      calls += 1;\n      return page(pageNumber, Number.MAX_SAFE_INTEGER);\n    }),\n    CatalogPaginationLimitError,\n  );\n  assert.equal(calls, 0);\n\n  await assert.rejects(\n    () => loadBoundedCatalogPages(page(1, 1001), async (pageNumber) => page(pageNumber, 1001)),\n    CatalogPaginationLimitError,\n  );\n});\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/lib/portfolio-dialog.test.ts": {
      "sha256": "cfcda3a6ebe21c9ce9b1e3cc515d213ff23a64b2ccfa78e2f38f05640fc6800c",
      "text": "import assert from 'node:assert/strict';\nimport {test} from 'node:test';\nimport * as dialog from './portfolio-dialog.ts';\ntest('gallery selection changes do not close and reopen the native modal or replace original focus',()=>{\n assert.equal(typeof dialog.createPortfolioDialogSession,'function');\n let shows=0,closes=0,restores=0,innerFocus=0;\n const element={open:false,showModal(){this.open=true;shows++;},close(){this.open=false;closes++;}};\n const session=dialog.createPortfolioDialogSession();\n session.show(element,{focus(){restores++;}});\n session.show(element,{focus(){innerFocus++;}});\n assert.equal(shows,1);assert.equal(closes,0);\n session.close();session.close();\n assert.equal(closes,1);assert.equal(restores,1);assert.equal(innerFocus,0);\n});\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/lib/auth-page-guards.ts": {
      "sha256": "ff0557f2b126c44f4c531d59f987a21c89934fee53e86a9b8fd77838fa313130",
      "text": "import type { AccountSummary, RegistrationRole } from \"./contracts/auth.ts\";\n\nexport type ProtectedRoute = \"client\" | \"specialist\";\nexport type GuardResult =\n  | { kind: \"allow\"; account: AccountSummary }\n  | { kind: \"redirect\"; location: \"/auth/login\" | \"/dashboard\" | \"/pro\" };\n\nexport interface SafeAccountSessionPort {\n  readAccount(): Promise<AccountSummary | undefined>;\n}\n\nexport function resolveProtectedRoute(account: AccountSummary | undefined, required: ProtectedRoute): GuardResult {\n  if (!account || !account.role) return { kind: \"redirect\", location: \"/auth/login\" };\n  if (account.role === required) return { kind: \"allow\", account };\n  const home: Record<RegistrationRole, \"/dashboard\" | \"/pro\"> = {\n    client: \"/dashboard\",\n    specialist: \"/pro\",\n  };\n  return { kind: \"redirect\", location: home[account.role] };\n}\n\nexport async function resolveProtectedRouteFromSession(\n  port: SafeAccountSessionPort,\n  required: ProtectedRoute,\n): Promise<GuardResult> {\n  return resolveProtectedRoute(await port.readAccount(), required);\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/lib/utils.ts": {
      "sha256": "1cda2e0abaf09692ac73a335c64461a90f22fde3a8872fa44389dab3298787af",
      "text": "import { clsx, type ClassValue } from \"clsx\";\nimport { twMerge } from \"tailwind-merge\";\n\nexport function cn(...inputs: ClassValue[]) {\n  return twMerge(clsx(inputs));\n}\n\n/** Convert latin digits to Persian digits — ۰۱۲۳۴۵۶۷۸۹ */\nexport function faNum(value: number | string): string {\n  const fa = \"۰۱۲۳۴۵۶۷۸۹\";\n  return String(value).replace(/\\d/g, (d) => fa[Number(d)]);\n}\n\n/** Format a number with Persian thousands separators, e.g. ۲٬۵۰۰٬۰۰۰ */\nexport function faPrice(value: number): string {\n  return faNum(new Intl.NumberFormat(\"en-US\").format(value).replace(/,/g, \"٬\"));\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/lib/auth-request-policy.ts": {
      "sha256": "174a2538e174298af6a24ceda78ad66169d706110e86643bbd0bd0e7e1d18ccd",
      "text": "import type { RegistrationRole } from \"./contracts/auth.ts\";\n\nexport const MAX_AUTH_JSON_BYTES = 4_096;\n\nexport type AuthRequestPolicyCode =\n  | \"invalid_request\"\n  | \"invalid_origin\"\n  | \"invalid_request_metadata\"\n  | \"invalid_content_type\"\n  | \"request_too_large\";\n\nconst errorStatus: Record<AuthRequestPolicyCode, number> = {\n  invalid_request: 400,\n  invalid_origin: 403,\n  invalid_request_metadata: 403,\n  invalid_content_type: 415,\n  request_too_large: 413,\n};\n\nexport class AuthRequestPolicyError extends Error {\n  readonly code: AuthRequestPolicyCode;\n  readonly status: number;\n\n  constructor(code: AuthRequestPolicyCode) {\n    super(\"درخواست احراز هویت معتبر نیست.\");\n    this.name = \"AuthRequestPolicyError\";\n    this.code = code;\n    this.status = errorStatus[code];\n  }\n}\n\nexport interface OtpRequestBody {\n  phone: string;\n  role: RegistrationRole;\n}\n\nexport interface OtpVerifyBody {\n  code: string;\n}\n\nfunction reject(code: AuthRequestPolicyCode): never {\n  throw new AuthRequestPolicyError(code);\n}\n\nfunction exactKeys(value: Record<string, unknown>, expected: readonly string[]): boolean {\n  const keys = Object.keys(value);\n  return keys.length === expected.length && expected.every((key) => Object.hasOwn(value, key));\n}\n\nfunction record(value: unknown): Record<string, unknown> {\n  if (value === null || typeof value !== \"object\" || Array.isArray(value)) {\n    return reject(\"invalid_request\");\n  }\n  return value as Record<string, unknown>;\n}\n\nfunction boundedString(value: unknown, maximumLength: number): string {\n  if (typeof value !== \"string\" || value.length === 0 || value.length > maximumLength) {\n    return reject(\"invalid_request\");\n  }\n  return value;\n}\n\nasync function readLimitedBody(request: Request): Promise<string> {\n  if (request.body === null) {\n    return reject(\"invalid_request\");\n  }\n\n  const reader = request.body.getReader();\n  const chunks: Uint8Array[] = [];\n  let total = 0;\n  try {\n    while (true) {\n      const { done, value } = await reader.read();\n      if (done) {\n        break;\n      }\n      total += value.byteLength;\n      if (total > MAX_AUTH_JSON_BYTES) {\n        await reader.cancel();\n        return reject(\"request_too_large\");\n      }\n      chunks.push(value);\n    }\n  } finally {\n    reader.releaseLock();\n  }\n\n  return new TextDecoder().decode(Buffer.concat(chunks.map((chunk) => Buffer.from(chunk))));\n}\n\nexport function assertAuthMutationOrigin(request: Request, appOrigin: string): void {\n  if (request.headers.get(\"origin\") !== appOrigin) {\n    return reject(\"invalid_origin\");\n  }\n  const fetchSite = request.headers.get(\"sec-fetch-site\");\n  if (fetchSite !== null && fetchSite !== \"same-origin\") {\n    return reject(\"invalid_request_metadata\");\n  }\n}\n\nasync function parseBody(request: Request, appOrigin: string): Promise<Record<string, unknown>> {\n  assertAuthMutationOrigin(request, appOrigin);\n  const mediaType = request.headers.get(\"content-type\")?.split(\";\", 1)[0]?.trim().toLowerCase();\n  if (mediaType !== \"application/json\") {\n    return reject(\"invalid_content_type\");\n  }\n\n  const raw = await readLimitedBody(request);\n  try {\n    return record(JSON.parse(raw) as unknown);\n  } catch (error) {\n    if (error instanceof AuthRequestPolicyError) {\n      throw error;\n    }\n    return reject(\"invalid_request\");\n  }\n}\n\nexport async function parseOtpRequest(request: Request, appOrigin: string): Promise<OtpRequestBody> {\n  const body = await parseBody(request, appOrigin);\n  if (!exactKeys(body, [\"phone\", \"role\"]) || (body.role !== \"client\" && body.role !== \"specialist\")) {\n    return reject(\"invalid_request\");\n  }\n  return { phone: boundedString(body.phone, 32), role: body.role };\n}\n\nexport async function parseOtpVerifyRequest(request: Request, appOrigin: string): Promise<OtpVerifyBody> {\n  const body = await parseBody(request, appOrigin);\n  if (!exactKeys(body, [\"code\"])) {\n    return reject(\"invalid_request\");\n  }\n  return { code: boundedString(body.code, 6) };\n}\n\nasync function parseEmptyObject(request: Request, appOrigin: string): Promise<Record<never, never>> {\n  const body = await parseBody(request, appOrigin);\n  if (!exactKeys(body, [])) {\n    return reject(\"invalid_request\");\n  }\n  return {};\n}\n\nexport const parseRefreshRequest = parseEmptyObject;\nexport const parseLogoutRequest = parseEmptyObject;\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/lib/specialist-sitemap.test.ts": {
      "sha256": "97d4129e96dcc02f33768c679eed34a3be4f6f3284cb17a44218d4e1b0adfa09",
      "text": "import assert from \"node:assert/strict\";\nimport { test } from \"node:test\";\nimport { collectSpecialistSitemapSlugs } from \"./specialist-sitemap.ts\";\n\ntest(\"collects unique nonempty specialist slugs across catalog pages\", () => {\n  const slugs = collectSpecialistSitemapSlugs([\n    [{ slug: \"mina\" }, { slug: \"reza\" }],\n    [{ slug: \"mina\" }, { slug: \"sara\" }],\n    [{ slug: \"\" }, { slug: \"  \" }, { slug: \"sara\" }],\n  ]);\n\n  assert.deepEqual(slugs, [\"mina\", \"reza\", \"sara\"]);\n});\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/lib/specialist-adapters.test.ts": {
      "sha256": "e024572dd8498af0d94f7de235286a81c98054306f2973692ad0c53e234b46d4",
      "text": "import assert from \"node:assert/strict\";\nimport { test } from \"node:test\";\nimport {\n  PublicDataContractError,\n  parseSpecialistCard,\n  parseSpecialistDetail,\n  normalizePublicPhone,\n  normalizePublicUrl,\n} from \"./specialist-adapters.ts\";\n\ntest(\"projects real public image arrays without leaking metadata or inventing content\", () => {\n  const base = { id:2,slug:'detail',title:'Detail',is_verified:false,categories:[],cities:[] };\n  const item = { id:19,url:'https://example.test/real.webp',type:'image',caption:'کار واقعی',owner:99 };\n  assert.deepEqual(parseSpecialistDetail({...base,gallery:[item]}).gallery,[{id:19,url:item.url,type:'image',caption:item.caption}]);\n  for(const url of ['javascript:alert(1)','https://u:p@example.test/a','https://example.test/a#private','https://example.test/a b']) {\n    assert.equal(parseSpecialistDetail({...base,gallery:[{...item,url}]}).gallery,'unavailable');\n  }\n  assert.equal(parseSpecialistDetail({...base,gallery:[item,item]}).gallery,'unavailable');\n});\n\ntest(\"parses a truthful public card and drops unknown private fields\", () => {\n  const card = parseSpecialistCard({\n    id: 12,\n    slug: \"sara-نقاش\",\n    title: \"سارا نقاش\",\n    is_verified: true,\n    rating_avg: 4.8,\n    rating_count: 3,\n    avatar_url: \"https://codecraft.ir/uploads/sara.jpg\",\n    availability: \"available\",\n    categories: [\"نقاشی\"],\n    cities: [\"تهران\"],\n    phone: \"+989121234567\",\n    user_id: 99,\n  });\n\n  assert.deepEqual(card, {\n    id: 12,\n    slug: \"sara-نقاش\",\n    title: \"سارا نقاش\",\n    verified: true,\n    rating: { average: 4.8, count: 3 },\n    avatarUrl: \"https://codecraft.ir/uploads/sara.jpg\",\n    availability: \"available\",\n    categories: [\"نقاشی\"],\n    cities: [\"تهران\"],\n  });\n  assert.equal(\"phone\" in card, false);\n});\n\ntest(\"keeps unknown availability and does not manufacture a zero rating\", () => {\n  const card = parseSpecialistCard({\n    id: 1,\n    slug: \"x\",\n    title: \"X\",\n    is_verified: false,\n    rating_avg: 5,\n    rating_count: 0,\n    avatar_url: false,\n    availability: \"offline\",\n    categories: [],\n    cities: [],\n  });\n  assert.equal(card.rating, null);\n  assert.equal(card.avatarUrl, null);\n  assert.equal(card.availability, \"unknown\");\n});\n\ntest(\"rejects malformed required identity and collections\", () => {\n  for (const fixture of [\n    { id: 0, slug: \"x\", title: \"X\", is_verified: false, categories: [], cities: [] },\n    { id: 1, slug: \"\", title: \"X\", is_verified: false, categories: [], cities: [] },\n    { id: 1, slug: \"x\", title: \"\", is_verified: false, categories: [], cities: [] },\n    { id: 1, slug: \"x\", title: \"X\", is_verified: false, categories: \"نقاشی\", cities: [] },\n  ]) {\n    assert.throws(() => parseSpecialistCard(fixture), PublicDataContractError);\n  }\n});\n\ntest(\"requires a boolean verification flag without changing valid true or false\", () => {\n  const identity = { id: 4, slug: \"verified\", title: \"Verified\", categories: [], cities: [] };\n  for (const is_verified of [undefined, null, \"true\", 1]) {\n    const fixture = is_verified === undefined\n      ? { ...identity }\n      : { ...identity, is_verified };\n    assert.throws(() => parseSpecialistCard(fixture), PublicDataContractError);\n  }\n  assert.equal(parseSpecialistCard({ ...identity, is_verified: true }).verified, true);\n  assert.equal(parseSpecialistCard({ ...identity, is_verified: false }).verified, false);\n});\n\ntest(\"normalizes only the named public phone field and safe URLs\", () => {\n  assert.equal(normalizePublicPhone(\"۰۹۱۲ ۱۲۳-۴۵۶۷\"), \"09121234567\");\n  assert.equal(normalizePublicPhone(\"+٩٨ (٩١٢) ١٢٣٤٥٦٧\"), \"+989121234567\");\n  assert.equal(normalizePublicPhone(\"<script>0912</script>\"), null);\n  assert.equal(normalizePublicPhone(\"https://example.test/0912\"), null);\n  assert.equal(normalizePublicUrl(\"javascript:alert(1)\"), null);\n  assert.equal(normalizePublicUrl(\"https://example.test/a\"), \"https://example.test/a\");\n});\n\ntest(\"represents unsupported gallery and unavailable reviews without fake records\", () => {\n  const detail = parseSpecialistDetail({\n    id: 2,\n    slug: \"detail\",\n    title: \"Detail\",\n    is_verified: true,\n    rating_avg: 0,\n    rating_count: 0,\n    avatar_url: null,\n    availability: \"busy\",\n    categories: [],\n    cities: [],\n    description: \"توضیح\",\n    bio: \"بیو\",\n    skills: \"رنگ، گچ\",\n    experience_years: 0,\n    response_minutes: 15,\n    price_hint: \"توافقی\",\n    address: \"تهران\",\n    phone_display: \"۰۹۱۲۱۲۳۴۵۶۷\",\n    lat: 0,\n    lng: 0,\n    gallery: [{ media: 44, caption: \"private shape\" }],\n    verified_at: null,\n    secret_phone: \"09120000000\",\n  });\n  assert.equal(detail.phoneDisplay, \"09121234567\");\n  assert.equal(detail.gallery, \"unavailable\");\n  assert.equal(detail.reviews, \"unavailable\");\n  assert.equal(\"secretPhone\" in detail, false);\n  assert.equal(detail.experienceYears, null);\n  assert.equal(detail.coordinates, null);\n});\n\ntest(\"does not expose out-of-range coordinates as a real location\", () => {\n  const detail = parseSpecialistDetail({\n    id: 3, slug: \"coords\", title: \"Coords\", is_verified: false,\n    rating_avg: 0, rating_count: 0, avatar_url: null, availability: \"away\",\n    categories: [], cities: [], lat: 91, lng: 181, gallery: [],\n  });\n  assert.equal(detail.coordinates, null);\n});\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/lib/public-specialist-pagination.ts": {
      "sha256": "ec7f150ee4a1d47bae78c38b9647279b3c6c8f1e2da872303d7480053b466c10",
      "text": "export const MAX_PUBLIC_CATALOG_PAGES = 1_000;\nexport const PUBLIC_CATALOG_PAGE_CONCURRENCY = 4;\n\nexport type CatalogPaginationToken = number | \"ellipsis\";\n\nexport interface CatalogPageLike {\n  page: number;\n  pages: number;\n}\n\nexport class CatalogPaginationLimitError extends Error {\n  constructor() {\n    super(\"تعداد صفحه‌های فهرست عمومی از سقف امن بیشتر است.\");\n    this.name = \"CatalogPaginationLimitError\";\n  }\n}\n\nexport class CatalogPaginationContractError extends Error {\n  constructor() {\n    super(\"صفحه‌بندی فهرست عمومی معتبر نیست.\");\n    this.name = \"CatalogPaginationContractError\";\n  }\n}\n\nfunction isSafePage(value: number): boolean {\n  return Number.isSafeInteger(value) && value > 0;\n}\n\n/**\n * Creates only a fixed-size display window: first/last page, the current page,\n * and at most two neighbours on either side. It never allocates by total pages.\n */\nexport function buildCatalogPaginationWindow(\n  currentPage: number,\n  totalPages: number,\n): CatalogPaginationToken[] {\n  if (!isSafePage(currentPage) || !isSafePage(totalPages) || currentPage > totalPages) {\n    return [];\n  }\n\n  const visible = new Set<number>([1, totalPages]);\n  for (let page = Math.max(1, currentPage - 2); page <= Math.min(totalPages, currentPage + 2); page += 1) {\n    visible.add(page);\n  }\n\n  const pages = [...visible].sort((left, right) => left - right);\n  const window: CatalogPaginationToken[] = [];\n  for (const page of pages) {\n    const previous = window.at(-1);\n    if (typeof previous === \"number\" && page - previous > 1) window.push(\"ellipsis\");\n    window.push(page);\n  }\n  return window;\n}\n\n/**\n * Reads a complete catalog only when its declared page count fits the documented\n * per-response ceiling. At most four page requests run at once; a malformed\n * response or one failed request rejects the entire operation rather than\n * returning a partial sitemap.\n */\nexport async function loadBoundedCatalogPages<T extends CatalogPageLike>(\n  first: T,\n  loadPage: (page: number) => Promise<T>,\n  options: {\n    maxPages?: number;\n    concurrency?: number;\n  } = {},\n): Promise<T[]> {\n  const maxPages = options.maxPages ?? MAX_PUBLIC_CATALOG_PAGES;\n  const concurrency = options.concurrency ?? PUBLIC_CATALOG_PAGE_CONCURRENCY;\n  if (!Number.isSafeInteger(maxPages) || maxPages < 1 || !Number.isSafeInteger(concurrency) || concurrency < 1) {\n    throw new CatalogPaginationContractError();\n  }\n  if (!isSafePage(first.page) || !Number.isSafeInteger(first.pages) || first.pages < 0 || first.page !== 1) {\n    throw new CatalogPaginationContractError();\n  }\n  if (first.pages > maxPages) throw new CatalogPaginationLimitError();\n  if (first.pages === 0) return [first];\n\n  const results: T[] = [first];\n  let nextPage = 2;\n  const workerCount = Math.min(concurrency, first.pages - 1);\n\n  async function worker(): Promise<void> {\n    while (nextPage <= first.pages) {\n      const requestedPage = nextPage;\n      nextPage += 1;\n      const catalog = await loadPage(requestedPage);\n      if (catalog.page !== requestedPage || catalog.pages !== first.pages) {\n        throw new CatalogPaginationContractError();\n      }\n      results[requestedPage - 1] = catalog;\n    }\n  }\n\n  await Promise.all(Array.from({ length: workerCount }, () => worker()));\n  return results;\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/lib/owner-client.test.ts": {
      "sha256": "d245979956b6ae90219901047e25e47598d2a96f75e4f3b1ad21fad713669b70",
      "text": "import assert from 'node:assert/strict';\nimport { test } from 'node:test';\nimport {ProfileBoundaryError} from '../services/profile/profile-contracts.ts';\nimport * as client from './owner-client.ts';\nconst account={id:2,displayName:'نام',role:'client',loginPhoneMasked:null,avatar:null,location:null,specialist:null};\nconst profile={id:8,slug:'worker',title:'نام',status:'draft',categories:[],cities:[],avatar:null,bio:'',skills:'',address:'',availability:'',priceHint:'',experienceYears:null,gallery:[],galleryRevision:3,galleryAvailable:true};\n\ntest('production client sends fixed account snake fields and updates shared summary only after success',async()=>{\n  assert.equal(typeof client.createOwnerClient,'function');\n  const calls:Array<[string,RequestInit|undefined]>=[];let synced=0;\n  const api=client.createOwnerClient(async(path,init)=>{calls.push([String(path),init]);return Response.json({account});},async()=>{synced++;});\n  assert.deepEqual(await api.saveAccount({display_name:'نام',account_city_id:null}),account);\n  assert.equal(calls[0][0],'/api/account/me');assert.equal(calls[0][1]?.method,'POST');\n  assert.deepEqual(JSON.parse(calls[0][1]?.body as string),{display_name:'نام',account_city_id:null});assert.equal(synced,1);\n  await assert.rejects(()=>api.saveAccount({role:'specialist'}));assert.equal(calls.length,1);\n});\ntest('recovery refreshes only an actual refresh_required response, never healthy or lost sessions',async()=>{\n const calls:string[]=[];const api=client.createOwnerClient(async(path,init)=>{calls.push(`${init?.method??'GET'} ${path}`);return Response.json({account});},async()=>{});\n assert.deepEqual(await api.recoverAccount(),account);assert.deepEqual(calls,['GET /api/account/me']);\n const lost:string[]=[];const invalid=client.createOwnerClient(async(path)=>{lost.push(String(path));return Response.json({error:{code:'unauthenticated'}},{status:401});},async()=>{});\n await assert.rejects(()=>invalid.recoverAccount());assert.deepEqual(lost,['/api/account/me']);\n});\ntest('explicit refresh singleflights and rereads GET; failed mutations and uploads are never replayed',async()=>{\n  assert.equal(typeof client.createOwnerClient,'function');\n  const calls:string[]=[]; let release!:()=>void; const gate=new Promise<void>(r=>{release=r;});\n  let refreshed=false;\n  const api=client.createOwnerClient(async(path,init)=>{calls.push(`${init?.method??'GET'} ${path}`);if(path==='/api/auth/refresh'){await gate;refreshed=true;return Response.json({account});}return refreshed?Response.json({account}):Response.json({error:{code:'refresh_required'}},{status:401});},async()=>{});\n  const a=api.recoverAccount();const b=api.recoverAccount(); release();await Promise.all([a,b]);\n  assert.equal(calls.filter(x=>x==='POST /api/auth/refresh').length,1);assert.equal(calls.filter(x=>x==='GET /api/account/me').length,4);\n  const failedCalls:string[]=[];\n  const failed=client.createOwnerClient(async(path)=>{failedCalls.push(String(path));return Response.json({error:{code:'refresh_required',reloadRequired:true}},{status:401});},async()=>{});\n  await assert.rejects(()=>failed.saveAccount({display_name:'نام'}));\n  const file=new File(['image'],'test.png',{type:'image/png'});\n  await assert.rejects(()=>failed.upload(file,'public-avatar'));\n  assert.deepEqual(failedCalls,['/api/account/me','/api/profile/media']);\n});\ntest('uploaded media stays separate from assignment; gallery uses latest revision and detach ID',async()=>{\n  assert.equal(typeof client.createOwnerClient,'function');const calls:Array<[string,RequestInit|undefined]>=[];\n  const media={id:31,url:'https://example.test/photo.png',type:'image',mime:'image/png',purpose:'public-portfolio'};\n  const api=client.createOwnerClient(async(path,init)=>{calls.push([String(path),init]); if(path==='/api/profile/media')return Response.json({media});return Response.json({gallery:{gallery:[],galleryRevision:4,galleryAvailable:true,status:'pending'}});},async()=>{});\n  assert.deepEqual(await api.upload(new File(['image'],'test.png',{type:'image/png'}),'public-portfolio'),media);\n  assert.equal(calls.length,1); const multipart=calls[0][1]?.body as FormData; assert.deepEqual([...multipart.keys()],['file','purpose']);\n  await api.addGallery(31,'تصویر',profile as never);\n  assert.deepEqual(JSON.parse(calls[1][1]?.body as string),{media_id:31,caption:'تصویر',kind:'image',expected_revision:3});\n  await api.detachGallery(31,{...profile,galleryRevision:4} as never);\n  assert.equal(calls[2][0],'/api/profile/gallery/media/31');assert.deepEqual(JSON.parse(calls[2][1]?.body as string),{expected_revision:4});\n  await assert.rejects(()=>api.addGallery(31,'',{...profile,galleryAvailable:false} as never));assert.equal(calls.length,3);\n});\ntest('409 reloadRequired is retained without trusting backend message; failed refresh cannot claim a session',async()=>{\n  assert.equal(typeof client.createOwnerClient,'function');\n  const api=client.createOwnerClient(async()=>Response.json({error:{code:'gallery_revision_conflict',reloadRequired:true,message:'secret'}},{status:409}),async()=>{});\n  await assert.rejects(()=>api.addGallery(2,'',profile as never),(error:unknown)=>{assert.ok(error instanceof client.OwnerClientError);assert.equal(error.reloadRequired,true);assert.equal(error.status,409);assert.equal(error.message.includes('secret'),false);return true;});\n  let synced=0;const broken=client.createOwnerClient(async(path)=>path==='/api/auth/refresh'?Response.json({error:{code:'auth_unavailable'}},{status:503}):Response.json({error:{code:'refresh_required'}},{status:401}),async()=>{synced++;});\n  await assert.rejects(()=>broken.recoverAccount());assert.equal(synced,0);\n});\ntest('malformed success after a possible write stays uncertain, unlike local validation',async()=>{\n const api=client.createOwnerClient(async()=>Response.json({account:{id:1,displayName:'bad'}}),async()=>{throw new Error('must not sync');});\n await assert.rejects(()=>api.saveAccount({display_name:'نام'}),(error:unknown)=>{assert.ok(error instanceof client.OwnerClientError);assert.equal(error.reloadRequired,true);assert.equal(error.code,'operation_uncertain');return true;});\n});\ntest('local input rejection is not presented as an ambiguously completed mutation',async()=>{\n let reads=0;const result=await client.settleOwnerAction(async()=>{throw new ProfileBoundaryError();},async()=>{reads++;return profile;});\n assert.equal(result.ok,false);if(!result.ok){assert.equal(result.error.status,422);assert.equal(result.error.reloadRequired,false);}assert.equal(reads,0);\n});\ntest('failed mutation rereads authoritative state once, never retries or fabricates success',async()=>{\n assert.equal(typeof client.settleOwnerAction,'function');let writes=0;let reads=0;\n const result=await client.settleOwnerAction(async()=>{writes++;throw new client.OwnerClientError(409,'gallery_revision_conflict',true);},async()=>{reads++;return profile;});\n assert.equal(result.ok,false);if(!result.ok){assert.deepEqual(result.state,profile);assert.equal(result.reloadFailed,false);}assert.equal(writes,1);assert.equal(reads,1);\n const lost=await client.settleOwnerAction(async()=>{throw new client.OwnerClientError(503,'operation_uncertain',true);},async()=>{throw new Error();});\n assert.equal(lost.ok,false);if(!lost.ok)assert.equal(lost.reloadFailed,true);\n});\n\ntest('lifetime gate denies double actions and drops cancelled results',async()=>{\n  assert.equal(typeof client.createActionGate,'function'); const gate=client.createActionGate();const run=gate.begin();assert.ok(run);assert.equal(gate.begin(),null);gate.cancel();assert.equal(run.current(),false);run.finish();\n});\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/lib/auth-ui.ts": {
      "sha256": "289088d6a223575823dae07eab0955c6f1d41c8fbdc8925eecfc7243301de195",
      "text": "import type { AccountSummary, RegistrationRole } from \"./contracts/auth.ts\";\n\ntype AuthenticatedAccount = Omit<AccountSummary, \"role\"> & { role: RegistrationRole };\n\nexport interface AuthChallengePresentation {\n  expiresAt: number;\n  codeLength: 5 | 6;\n  isSimulated: boolean;\n}\n\nexport interface PublicAuthResult {\n  account: AccountSummary;\n  redirectTo: \"/dashboard\" | \"/pro\";\n  onboardingTo?: \"/account\" | \"/pro/profile\";\n}\n\nconst redirectByRole: Record<Exclude<RegistrationRole, never>, \"/dashboard\" | \"/pro\"> = {\n  client: \"/dashboard\",\n  specialist: \"/pro\",\n};\n\nexport function buildOtpRequest(phone: string, role: RegistrationRole): { phone: string; role: RegistrationRole } {\n  return { phone, role };\n}\n\nexport function otpSlots(codeLength: 5 | 6): number[] {\n  return Array.from({ length: codeLength }, (_, index) => index);\n}\n\nexport function parseAuthChallenge(value: unknown): AuthChallengePresentation {\n  if (value === null || typeof value !== \"object\" || Array.isArray(value)) throw new Error(\"invalid_challenge\");\n  const input = value as Record<string, unknown>;\n  if (!Number.isSafeInteger(input.expiresAt) || (input.codeLength !== 5 && input.codeLength !== 6) || typeof input.isSimulated !== \"boolean\") {\n    throw new Error(\"invalid_challenge\");\n  }\n  return { expiresAt: input.expiresAt as number, codeLength: input.codeLength, isSimulated: input.isSimulated };\n}\n\nfunction parseAccount(value: unknown): AuthenticatedAccount {\n  if (value === null || typeof value !== \"object\" || Array.isArray(value)) throw new Error(\"invalid_auth_result\");\n  const account = value as Record<string, unknown>;\n  const id = account.id;\n  if (!Number.isSafeInteger(id) || (id as number) < 1 || typeof account.displayName !== \"string\" ||\n      (account.role !== \"client\" && account.role !== \"specialist\")) throw new Error(\"invalid_auth_result\");\n  return { id: id as number, displayName: account.displayName, role: account.role };\n}\n\nexport function parseAuthResult(value: unknown): PublicAuthResult {\n  if (value === null || typeof value !== \"object\" || Array.isArray(value)) throw new Error(\"invalid_auth_result\");\n  const result = value as Record<string, unknown>;\n  if (result.redirectTo !== \"/dashboard\" && result.redirectTo !== \"/pro\") throw new Error(\"invalid_auth_result\");\n  const account = parseAccount(result.account);\n  if (redirectByRole[account.role] !== result.redirectTo) throw new Error(\"invalid_auth_result\");\n  const onboardingTo = account.role === 'specialist' ? '/pro/profile' : '/account';\n  if (result.onboardingTo !== undefined && result.onboardingTo !== onboardingTo) throw new Error('invalid_auth_result');\n  return { account, redirectTo: result.redirectTo, ...(result.onboardingTo ? {onboardingTo} : {}) };\n}\n\nexport function parseAccountSummary(value: unknown): AccountSummary {\n  if (value === null || typeof value !== \"object\" || Array.isArray(value)) throw new Error(\"invalid_account\");\n  const account = (value as Record<string, unknown>).account;\n  return parseAccount(account);\n}\n\nexport async function readVerificationChallenge(fetcher: (path:string, init?:RequestInit)=>Promise<Response>, signal?:AbortSignal): Promise<AuthChallengePresentation> {\n  const response = await fetcher('/api/auth/challenge', {credentials:'same-origin',cache:'no-store',signal});\n  const body = await response.json().catch(()=>null);\n  if(!response.ok) throw new Error(mapAuthError(response.status,body?.error?.code));\n  return parseAuthChallenge(body?.challenge);\n}\nexport function canResendCode(phone:string,pending:boolean,seconds:number):boolean { return Boolean(phone) && !pending && seconds<=0; }\n\nexport function mapAuthError(status: number, code: unknown): string {\n  if(status === 429) return 'تعداد تلاش‌ها زیاد است؛ کمی صبر کنید و دوباره درخواست کنید.';\n  if(status === 422 && code !== 'invalid_code') return 'اطلاعات درخواست معتبر نیست؛ شماره و ورودی‌ها را بررسی کنید.';\n  if(status === 401 && code !== 'challenge_missing') return 'نشست ورود معتبر نیست؛ دوباره وارد شوید.';\n  if (code === \"invalid_challenge\") return \"اطلاعات کد معتبر نیست؛ کد جدید درخواست کن.\";\n  if (code === \"challenge_missing\" || (status === 401 && code === \"challenge_missing\")) return \"کد تایید در دسترس نیست؛ دوباره درخواست کد کن.\";\n  if (status === 410 || code === \"challenge_expired\") return \"زمان کد تمام شده است؛ کد جدید درخواست کن.\";\n  if (status === 422 && code === \"invalid_code\") return \"کد وارد شده صحیح نیست. دوباره تلاش کن.\";\n  if (status === 503 || code === \"auth_unavailable\") return \"سرویس ورود موقتاً در دسترس نیست.\";\n  return \"عملیات ورود انجام نشد. دوباره تلاش کن.\";\n}\n\nexport function fixedHomeForRole(role: RegistrationRole): \"/dashboard\" | \"/pro\" {\n  return redirectByRole[role];\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/lib/auth-logout.ts": {
      "sha256": "c07cfbc5b30a5e54f5fa58a01fff95839a8602c31a1b5df6ecffa995be274a53",
      "text": "export type LogoutOutcome = \"success\" | \"failure\";\n\nexport interface LogoutPresentation {\n  pending: false;\n  account: null;\n  error: boolean;\n  navigateTo: \"/\" | null;\n}\n\nexport function canStartLogout(pending: boolean): boolean {\n  return !pending;\n}\n\n/** A remote failure is not a claim about revocation; local UI becomes anonymous either way. */\nexport function settleLogout(outcome: LogoutOutcome): LogoutPresentation {\n  return {\n    pending: false,\n    account: null,\n    error: outcome === \"failure\",\n    navigateTo: outcome === \"success\" ? \"/\" : null,\n  };\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/lib/auth-policy.test.ts": {
      "sha256": "a90c7834a56b2e8cecc7713682b2cd2529ed662999f402b225ec5763d81f3b3b",
      "text": "import assert from \"node:assert/strict\";\nimport { test } from \"node:test\";\nimport {\n  deadlineFromTtl,\n  getAccountHome,\n  normalizeIranianPhone,\n  normalizeOtpCode,\n  resolveAccountRole,\n  toAccountSummary,\n} from \"./auth-policy.ts\";\nimport type { RegistrationRole } from \"./contracts/auth.ts\";\n\nfunction assertSafeValidationFailure(\n  operation: () => unknown,\n  code: string,\n  rejectedValue: unknown,\n): void {\n  assert.throws(operation, (error: unknown) => {\n    assert.ok(error instanceof Error);\n    assert.equal((error as Error & { status: number }).status, 422);\n    assert.equal((error as Error & { code: string }).code, code);\n    assert.match(error.message, /[؀-ۿ]/u);\n    assert.equal(\"cause\" in error, false);\n    assert.equal(\"data\" in error, false);\n    if (typeof rejectedValue === \"string\" && rejectedValue.trim().length > 0) {\n      const serialized = JSON.stringify(error, Object.getOwnPropertyNames(error));\n      assert.equal(serialized.includes(rejectedValue), false);\n    }\n    return true;\n  });\n}\n\n// Break caught: stripping letters or misreading a prefix grants an invalid phone.\nfor (const [name, input] of [\n  [\"Persian digits\", \"۰۹۱۲۱۲۳۴۵۶۷\"],\n  [\"Arabic digits\", \"٠٩١٢١٢٣٤٥٦٧\"],\n  [\"plus-country prefix\", \"+98 912 123 4567\"],\n  [\"international dialing prefix\", \"0098(912)123-4567\"],\n  [\"bare mobile\", \"9121234567\"],\n  [\"country prefix\", \"989121234567\"],\n  [\"domestic punctuation\", \" (0912) 123-4567 \"],\n  [\"nonbreaking spaces\", \"+98 912 123 4567\"],\n] as const) {\n  test(`normalizes ${name} to the literal domestic mobile number`, () => {\n    assert.equal(normalizeIranianPhone(input), \"09121234567\");\n  });\n}\n\ntest(\"rejects malformed phones without reflecting the rejected value\", () => {\n  for (const input of [\n    \"phone-secret-text\",\n    \"09121234567abc\",\n    \"08121234567\",\n    \"02112345678\",\n    \"0912123456\",\n    \"091212345678\",\n    \"+97 912 123 4567\",\n    \"+9809121234567\",\n    \"009809121234567\",\n    \"++989121234567\",\n    \"98+9121234567\",\n    \"0912.123.4567\",\n    \"\",\n    \"   \",\n    null,\n    undefined,\n    9121234567,\n  ]) {\n    assertSafeValidationFailure(\n      () => normalizeIranianPhone(input as string),\n      \"invalid_phone\",\n      input,\n    );\n  }\n});\n\n// Break caught: numeric coercion drops a leading zero or admits non-five-digit codes.\nfor (const [name, input, expected] of [\n  [\"Persian leading zero\", \"۰۱۲۳۴\", \"01234\"],\n  [\"Arabic leading zero\", \"٠١٢٣٤\", \"01234\"],\n  [\"ASCII leading zero\", \"01234\", \"01234\"],\n  [\"arbitrary code\", \"58319\", \"58319\"],\n  [\"all zeros\", \"00000\", \"00000\"],\n] as const) {\n  test(`normalizes the ${name} OTP as a string`, () => {\n    assert.equal(normalizeOtpCode(input), expected);\n  });\n}\n\ntest(\"rejects wrong-length and non-digit OTPs with a safe validation error\", () => {\n  for (const input of [\n    \"1234\",\n    \"123456\",\n    \"12a34\",\n    \"otp-secret-text\",\n    \" 01234\",\n    \"01234 \",\n    \"01 234\",\n    \"01234\\n\",\n    \"\",\n    null,\n    undefined,\n    12345,\n  ]) {\n    assertSafeValidationFailure(\n      () => normalizeOtpCode(input as string),\n      \"otp_invalid\",\n      input,\n    );\n  }\n});\n\n// Break caught: defaulting, de-duplicating or prioritizing roles grants unintended access.\nfor (const [name, roles, expected] of [\n  [\"client only\", [\"nahan_client\"], \"client\"],\n  [\"specialist only\", [\"nahan_specialist\"], \"specialist\"],\n  [\"no roles\", [], null],\n  [\"unknown role\", [\"subscriber\"], null],\n  [\"administrator\", [\"administrator\"], null],\n  [\"UI alias\", [\"pro\"], null],\n  [\"registration role is not a backend role\", [\"client\"], null],\n  [\"both supported roles\", [\"nahan_client\", \"nahan_specialist\"], null],\n  [\"admin mixed with client\", [\"administrator\", \"nahan_client\"], null],\n  [\"unknown mixed with specialist\", [\"nahan_specialist\", \"subscriber\"], null],\n  [\"duplicate client\", [\"nahan_client\", \"nahan_client\"], null],\n  [\"duplicate specialist\", [\"nahan_specialist\", \"nahan_specialist\"], null],\n] as const) {\n  test(`resolves ${name} conservatively`, () => {\n    assert.equal(resolveAccountRole(roles), expected);\n  });\n}\n\ntest(\"returns only fixed allowlisted account home paths\", () => {\n  assert.equal(getAccountHome(\"client\"), \"/dashboard\");\n  assert.equal(getAccountHome(\"specialist\"), \"/pro\");\n  assert.equal(getAccountHome(null), null);\n  assert.equal(getAccountHome(\"https://evil.example/\" as RegistrationRole), null);\n});\n\ntest(\"projects only the declared account fields from backend roles\", () => {\n  const user = Object.freeze({\n    id: 47,\n    display_name: \"آزاده نمونه\",\n    roles: Object.freeze([\"nahan_specialist\"]),\n    phone: \"09129876543\",\n    access_token: \"synthetic-summary-access-secret\",\n    refresh_token: \"synthetic-summary-refresh-secret\",\n    tracking_code: \"synthetic-summary-tracking-secret\",\n    unknown_backend_field: \"synthetic-raw-secret\",\n  });\n\n  const summary = toAccountSummary(user);\n  assert.deepEqual(summary, {\n    id: 47,\n    displayName: \"آزاده نمونه\",\n    role: \"specialist\",\n  });\n  assert.equal(\n    JSON.stringify(summary),\n    '{\"id\":47,\"displayName\":\"آزاده نمونه\",\"role\":\"specialist\"}',\n  );\n  assert.notEqual(summary, user);\n});\n\ntest(\"does not invent a display name or fallback role for an unsupported account\", () => {\n  assert.deepEqual(\n    toAccountSummary({ id: 51, display_name: \"\", roles: [\"administrator\"] }),\n    { id: 51, displayName: \"\", role: null },\n  );\n});\n\n// Break caught: using a fixed lifetime, converting twice, or allowing unsafe arithmetic.\nfor (const [name, nowMs, ttlSeconds, expected] of [\n  [\"OTP lifetime\", 1_700_000_000_000, 120, 1_700_000_120_000],\n  [\"access lifetime\", 1_700_000_000_000, 900, 1_700_000_900_000],\n  [\"refresh lifetime\", 1_700_000_000_000, 2_592_000, 1_702_592_000_000],\n  [\"alternate backend lifetime\", 1_700_000_000_000, 37, 1_700_000_037_000],\n  [\"epoch\", 0, 1, 1000],\n  [\"safe upper boundary\", 9_007_199_254_739_991, 1, 9_007_199_254_740_991],\n] as const) {\n  test(`computes the ${name} deadline from the caller's clock`, () => {\n    assert.equal(deadlineFromTtl(nowMs, ttlSeconds), expected);\n  });\n}\n\ntest(\"rejects invalid clocks, TTLs and overflowing deadlines\", () => {\n  for (const [nowMs, ttlSeconds] of [\n    [-1, 120],\n    [1.5, 120],\n    [NaN, 120],\n    [Infinity, 120],\n    [-Infinity, 120],\n    [Number.MAX_SAFE_INTEGER + 1, 1],\n    [1_700_000_000_000, 0],\n    [1_700_000_000_000, -1],\n    [1_700_000_000_000, 1.5],\n    [1_700_000_000_000, NaN],\n    [1_700_000_000_000, Infinity],\n    [0, Number.MAX_SAFE_INTEGER],\n    [Number.MAX_SAFE_INTEGER, 1],\n  ]) {\n    assertSafeValidationFailure(\n      () => deadlineFromTtl(nowMs, ttlSeconds),\n      \"invalid_deadline\",\n      undefined,\n    );\n  }\n});\n\ntest(\"normalizes exactly the stored five- or six-digit OTP length\", () => {\n  assert.equal(normalizeOtpCode(\"۰۱۲۳۴\", 5), \"01234\");\n  assert.equal(normalizeOtpCode(\"١٤٥٦٣٢\", 6), \"145632\");\n\n  for (const [value, expectedLength] of [\n    [\"145632\", 5],\n    [\"01234\", 6],\n    [\"12345\", 7],\n    [\"123456\", 0],\n  ] as const) {\n    assertSafeValidationFailure(\n      () => normalizeOtpCode(value, expectedLength as 5 | 6),\n      \"otp_invalid\",\n      value,\n    );\n  }\n});\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/lib/specialist-adapters.ts": {
      "sha256": "5b89a994b91e462ab1bcb9cda8e102527a45f6621a952dbd1b7109cc9295a380",
      "text": "import type {\n  PublicSpecialistCard,\n  PublicSpecialistDetail,\n  PublicSpecialistAvailability,\n} from \"./contracts/specialists.ts\";\nimport { WordPressApiError } from \"../services/wordpress/errors.ts\";\n\nconst CONTROL_CHARACTERS = /[\\u0000-\\u001F\\u007F]/;\nconst PHONE_DIGITS = /[\\s().-]/g;\nconst PERSIAN_DIGITS = \"۰۱۲۳۴۵۶۷۸۹\";\nconst ARABIC_DIGITS = \"٠١٢٣٤٥٦٧٨٩\";\n\nexport class PublicDataContractError extends WordPressApiError {\n  constructor(message = \"ساختار دادهٔ عمومی متخصص معتبر نیست.\") {\n    super({ status: 502, code: \"invalid_public_contract\", message });\n    this.name = \"PublicDataContractError\";\n    Object.setPrototypeOf(this, new.target.prototype);\n  }\n}\n\nfunction isRecord(value: unknown): value is Record<string, unknown> {\n  return typeof value === \"object\" && value !== null && !Array.isArray(value);\n}\n\nfunction requiredString(value: unknown, field: string): string {\n  if (typeof value !== \"string\" || value.trim().length === 0 || CONTROL_CHARACTERS.test(value)) {\n    throw new PublicDataContractError(`فیلد عمومی ${field} معتبر نیست.`);\n  }\n  return value.trim();\n}\n\nfunction requiredSafeInteger(value: unknown, field: string, minimum = 0): number {\n  if (!Number.isSafeInteger(value) || (value as number) < minimum) {\n    throw new PublicDataContractError(`فیلد عمومی ${field} معتبر نیست.`);\n  }\n  return value as number;\n}\n\nfunction requiredBoolean(value: unknown, field: string): boolean {\n  if (typeof value !== \"boolean\") {\n    throw new PublicDataContractError(`فیلد عمومی ${field} معتبر نیست.`);\n  }\n  return value;\n}\n\nfunction requiredStrings(value: unknown, field: string): string[] {\n  if (!Array.isArray(value) || value.some((item) => typeof item !== \"string\" || CONTROL_CHARACTERS.test(item))) {\n    throw new PublicDataContractError(`فهرست عمومی ${field} معتبر نیست.`);\n  }\n  return value.map((item) => item.trim()).filter(Boolean);\n}\n\nfunction optionalText(value: unknown): string | null {\n  if (typeof value !== \"string\") return null;\n  const text = value.trim();\n  return text.length > 0 && !CONTROL_CHARACTERS.test(text) ? text : null;\n}\n\nfunction optionalPositiveInteger(value: unknown): number | null {\n  return Number.isSafeInteger(value) && (value as number) > 0 ? (value as number) : null;\n}\n\nfunction optionalFiniteCoordinate(value: unknown, maximum: number): number | null {\n  return typeof value === \"number\" && Number.isFinite(value) && value !== 0 && Math.abs(value) <= maximum\n    ? value\n    : null;\n}\n\nexport function normalizePublicUrl(value: unknown): string | null {\n  if (typeof value !== \"string\" || value.trim().length === 0 || CONTROL_CHARACTERS.test(value)) return null;\n  try {\n    const parsed = new URL(value.trim());\n    return parsed.protocol === \"https:\" || parsed.protocol === \"http:\" ? parsed.toString() : null;\n  } catch {\n    return null;\n  }\n}\n\nfunction translatedDigits(value: string): string {\n  return value.replace(/[۰-۹٠-٩]/g, (digit) => {\n    const persian = PERSIAN_DIGITS.indexOf(digit);\n    return String(persian >= 0 ? persian : ARABIC_DIGITS.indexOf(digit));\n  });\n}\n\n/** Accepts only an ordinary dialing string from the published `phone_display` field. */\nexport function normalizePublicPhone(value: unknown): string | null {\n  if (typeof value !== \"string\" || CONTROL_CHARACTERS.test(value)) return null;\n  const normalized = translatedDigits(value.trim());\n  if (/[^\\d+\\s().-]/.test(normalized) || normalized.includes(\"+\") && !normalized.startsWith(\"+\")) return null;\n  const compact = normalized.replace(PHONE_DIGITS, \"\");\n  if (!/^\\+?\\d{7,15}$/.test(compact)) return null;\n  return compact;\n}\n\nfunction availability(value: unknown): PublicSpecialistAvailability {\n  return value === \"available\" || value === \"busy\" || value === \"away\" ? value : \"unknown\";\n}\n\nfunction rating(average: unknown, count: unknown): PublicSpecialistCard[\"rating\"] {\n  if (\n    typeof average !== \"number\" || !Number.isFinite(average) || average < 0 || average > 5 ||\n    !Number.isSafeInteger(count) || (count as number) <= 0\n  ) return null;\n  return { average, count: count as number };\n}\n\nexport function parseSpecialistCard(value: unknown): PublicSpecialistCard {\n  if (!isRecord(value)) throw new PublicDataContractError();\n  return {\n    id: requiredSafeInteger(value.id, \"id\", 1),\n    slug: requiredString(value.slug, \"slug\"),\n    title: requiredString(value.title, \"title\"),\n    verified: requiredBoolean(value.is_verified, \"is_verified\"),\n    rating: rating(value.rating_avg, value.rating_count),\n    avatarUrl: normalizePublicUrl(value.avatar_url),\n    availability: availability(value.availability),\n    categories: requiredStrings(value.categories, \"categories\"),\n    cities: requiredStrings(value.cities, \"cities\"),\n  };\n}\n\nfunction publicGallery(value:unknown):PublicSpecialistDetail['gallery'] {\n  if(!Array.isArray(value)||value.length>20) return 'unavailable';\n  if(!value.length) return 'empty';\n  const seen=new Set<number>();\n  const items=[];\n  for(const raw of value){\n    if(!isRecord(raw) || !Number.isSafeInteger(raw.id) || (raw.id as number)<1 || seen.has(raw.id as number) || raw.type!=='image' || typeof raw.url!=='string' || raw.url.length>2048 || /[\\s\\\\\\p{Cc}]/u.test(raw.url) || typeof raw.caption!=='string' || [...raw.caption].length>300 || /[<>\\p{Cc}\\p{Cs}]/u.test(raw.caption)) return 'unavailable';\n    let url:URL;try{url=new URL(raw.url);}catch{return 'unavailable';}\n    if(!['http:','https:'].includes(url.protocol)||!url.hostname||url.username||url.password||url.hash)return 'unavailable';\n    seen.add(raw.id as number);items.push({id:raw.id as number,url:raw.url,type:'image' as const,caption:raw.caption});\n  }\n  return items;\n}\n\nexport function parseSpecialistDetail(value: unknown): PublicSpecialistDetail {\n  if (!isRecord(value)) throw new PublicDataContractError();\n  const card = parseSpecialistCard(value);\n  const lat = optionalFiniteCoordinate(value.lat, 90);\n  const lng = optionalFiniteCoordinate(value.lng, 180);\n  return {\n    ...card,\n    description: optionalText(value.description),\n    bio: optionalText(value.bio),\n    skills: optionalText(value.skills),\n    experienceYears: optionalPositiveInteger(value.experience_years),\n    responseMinutes: optionalPositiveInteger(value.response_minutes),\n    priceHint: optionalText(value.price_hint),\n    address: optionalText(value.address),\n    phoneDisplay: normalizePublicPhone(value.phone_display),\n    coordinates: lat !== null && lng !== null ? { lat, lng } : null,\n    verifiedAt: optionalText(value.verified_at),\n    gallery: publicGallery(value.gallery),\n    reviews: \"unavailable\",\n  };\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/lib/auth-request-policy.test.ts": {
      "sha256": "3880ea0f716bd978205a5a92c543c903742ef75e15a3dd6ad1598b0205bfc80e",
      "text": "import assert from \"node:assert/strict\";\nimport { test } from \"node:test\";\nimport {\n  AuthRequestPolicyError,\n  parseLogoutRequest,\n  parseOtpRequest,\n  parseOtpVerifyRequest,\n  parseRefreshRequest,\n} from \"./auth-request-policy.ts\";\n\nconst APP_ORIGIN = \"https://app.example.test\";\n\nfunction mutation(body: string, headers: Record<string, string> = {}): Request {\n  return new Request(`${APP_ORIGIN}/api/auth/request`, {\n    method: \"POST\",\n    headers: {\n      Origin: APP_ORIGIN,\n      \"Content-Type\": \"application/json; charset=utf-8\",\n      \"Sec-Fetch-Site\": \"same-origin\",\n      ...headers,\n    },\n    body,\n  });\n}\n\nasync function rejects(\n  operation: () => Promise<unknown>,\n  code: string,\n  status: number,\n  forbidden: string[] = [],\n): Promise<void> {\n  await assert.rejects(operation, (error: unknown) => {\n    assert.ok(error instanceof AuthRequestPolicyError);\n    assert.equal(error.code, code);\n    assert.equal(error.status, status);\n    const serialized = JSON.stringify(error, Object.getOwnPropertyNames(error));\n    for (const value of forbidden) {\n      assert.equal(serialized.includes(value), false);\n    }\n    return true;\n  });\n}\n\ntest(\"accepts only a same-origin JSON OTP request with the exact public fields\", async () => {\n  assert.deepEqual(\n    await parseOtpRequest(mutation('{\"phone\":\"+98 912 123 4567\",\"role\":\"specialist\"}'), APP_ORIGIN),\n    { phone: \"+98 912 123 4567\", role: \"specialist\" },\n  );\n});\n\ntest(\"accepts only an exact code body for verify and exact empty bodies for refresh/logout\", async () => {\n  assert.deepEqual(await parseOtpVerifyRequest(mutation('{\"code\":\"۱۲۳۴۵\"}'), APP_ORIGIN), {\n    code: \"۱۲۳۴۵\",\n  });\n  assert.deepEqual(await parseRefreshRequest(mutation(\"{}\"), APP_ORIGIN), {});\n  assert.deepEqual(await parseLogoutRequest(mutation(\"{}\"), APP_ORIGIN), {});\n});\n\ntest(\"rejects malformed, extra, oversized, and route-crossed JSON before a coordinator can run\", async () => {\n  for (const body of [\n    \"\",\n    \"null\",\n    \"[]\",\n    \"{\",\n    '{\"phone\":\"09121234567\"}',\n    '{\"phone\":\"09121234567\",\"role\":\"client\",\"trackingCode\":\"secret\"}',\n    '{\"code\":\"12345\",\"role\":\"specialist\"}',\n    '{\"code\":\"1234567\"}',\n    JSON.stringify({ phone: \"9\".repeat(33), role: \"client\" }),\n    JSON.stringify({ phone: \"09121234567\", role: \"client\", padding: \"x\".repeat(64) }),\n  ]) {\n    await rejects(() => parseOtpRequest(mutation(body), APP_ORIGIN), \"invalid_request\", 400, [\"trackingCode\", \"secret\"]);\n  }\n  await rejects(() => parseOtpVerifyRequest(mutation('{\"code\":\"12345\",\"role\":\"client\"}'), APP_ORIGIN), \"invalid_request\", 400);\n  await rejects(() => parseRefreshRequest(mutation('{\"unexpected\":true}'), APP_ORIGIN), \"invalid_request\", 400);\n  await rejects(() => parseLogoutRequest(mutation('{\"refresh_token\":\"secret\"}'), APP_ORIGIN), \"invalid_request\", 400, [\"secret\"]);\n});\n\ntest(\"rejects invalid origin, Fetch Metadata, content type, and 4KiB stream bodies safely\", async () => {\n  await rejects(\n    () => parseOtpRequest(mutation('{\"phone\":\"09121234567\",\"role\":\"client\"}', { Origin: \"https://evil.example\" }), APP_ORIGIN),\n    \"invalid_origin\",\n    403,\n  );\n  await rejects(\n    () => parseOtpRequest(mutation('{\"phone\":\"09121234567\",\"role\":\"client\"}', { Origin: \"null\" }), APP_ORIGIN),\n    \"invalid_origin\",\n    403,\n  );\n  await rejects(\n    () => parseOtpRequest(mutation('{\"phone\":\"09121234567\",\"role\":\"client\"}', { \"Sec-Fetch-Site\": \"cross-site\" }), APP_ORIGIN),\n    \"invalid_request_metadata\",\n    403,\n  );\n  await rejects(\n    () => parseOtpRequest(mutation('{\"phone\":\"09121234567\",\"role\":\"client\"}', { \"Content-Type\": \"text/plain\" }), APP_ORIGIN),\n    \"invalid_content_type\",\n    415,\n  );\n  await rejects(\n    () => parseOtpRequest(mutation(`{\"phone\":\"09121234567\",\"role\":\"client\",\"padding\":\"${\"x\".repeat(4_097)}\"}`), APP_ORIGIN),\n    \"request_too_large\",\n    413,\n  );\n});\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/lib/auth-policy.ts": {
      "sha256": "1daebd2e1b08bc66e14f2ef68140cd759ff9ec1b26d12a58385fdb2af4240aaa",
      "text": "import type { AccountSummary, RegistrationRole } from \"./contracts/auth.ts\";\n\ntype AuthValidationCode = \"invalid_phone\" | \"otp_invalid\" | \"invalid_deadline\";\n\nconst validationMessages: Record<AuthValidationCode, string> = {\n  invalid_phone: \"شماره موبایل معتبر نیست.\",\n  otp_invalid: \"کد تأیید باید دقیقاً پنج رقم باشد.\",\n  invalid_deadline: \"زمان اعتبار قابل محاسبه نیست.\",\n};\n\nexport class AuthValidationError extends Error {\n  readonly status = 422;\n  readonly code: AuthValidationCode;\n\n  constructor(code: AuthValidationCode) {\n    super(validationMessages[code]);\n    this.name = \"AuthValidationError\";\n    this.code = code;\n  }\n}\n\nfunction toAsciiDigits(value: string): string {\n  return value.replace(/[۰-۹٠-٩]/gu, (digit) =>\n    String(digit.charCodeAt(0) - (digit >= \"۰\" ? 0x06f0 : 0x0660)),\n  );\n}\n\nexport function normalizeIranianPhone(value: string): string {\n  if (typeof value === \"string\") {\n    const digits = toAsciiDigits(value).replace(/[\\s()-]/gu, \"\");\n    const match = /^(?:0|98|\\+98|0098)?(9\\d{9})$/u.exec(digits);\n    if (match) {\n      return `0${match[1]}`;\n    }\n  }\n  throw new AuthValidationError(\"invalid_phone\");\n}\n\nexport type OtpCodeLength = 5 | 6;\n\nfunction isOtpCodeLength(value: unknown): value is OtpCodeLength {\n  return value === 5 || value === 6;\n}\n\nexport function normalizeOtpCode(value: string, expectedLength: OtpCodeLength = 5): string {\n  if (typeof value === \"string\" && isOtpCodeLength(expectedLength)) {\n    const digits = toAsciiDigits(value);\n    if (digits.length === expectedLength && /^\\d+$/u.test(digits)) {\n      return digits;\n    }\n  }\n  throw new AuthValidationError(\"otp_invalid\");\n}\n\nexport function resolveAccountRole(roles: readonly string[]): RegistrationRole | null {\n  if (roles.length !== 1) {\n    return null;\n  }\n  switch (roles[0]) {\n    case \"nahan_client\":\n      return \"client\";\n    case \"nahan_specialist\":\n      return \"specialist\";\n    default:\n      return null;\n  }\n}\n\nexport function getAccountHome(\n  role: RegistrationRole | null,\n): \"/dashboard\" | \"/pro\" | null {\n  switch (role) {\n    case \"client\":\n      return \"/dashboard\";\n    case \"specialist\":\n      return \"/pro\";\n    default:\n      return null;\n  }\n}\n\nexport function toAccountSummary(user: {\n  id: number;\n  display_name: string;\n  roles: readonly string[];\n}): AccountSummary {\n  return {\n    id: user.id,\n    displayName: user.display_name,\n    role: resolveAccountRole(user.roles),\n  };\n}\n\nexport function deadlineFromTtl(nowMs: number, ttlSeconds: number): number {\n  if (\n    !Number.isSafeInteger(nowMs) || nowMs < 0 ||\n    !Number.isSafeInteger(ttlSeconds) || ttlSeconds <= 0\n  ) {\n    throw new AuthValidationError(\"invalid_deadline\");\n  }\n  const ttlMs = ttlSeconds * 1000;\n  const deadline = nowMs + ttlMs;\n  if (!Number.isSafeInteger(ttlMs) || !Number.isSafeInteger(deadline)) {\n    throw new AuthValidationError(\"invalid_deadline\");\n  }\n  return deadline;\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/lib/auth-logout.test.ts": {
      "sha256": "8a5039e76ca67a621be5b561693c7a211c717f784a10ab7cd98c36423b7b7f6f",
      "text": "import assert from \"node:assert/strict\";\nimport { test } from \"node:test\";\nimport { canStartLogout, settleLogout } from \"./auth-logout.ts\";\n\ntest(\"rejects duplicate logout submits while one request is pending\", () => {\n  assert.equal(canStartLogout(false), true);\n  assert.equal(canStartLogout(true), false);\n});\n\ntest(\"clears the local account state after successful or failed remote logout\", () => {\n  assert.deepEqual(settleLogout(\"success\"), { pending: false, account: null, error: false, navigateTo: \"/\" });\n  assert.deepEqual(settleLogout(\"failure\"), { pending: false, account: null, error: true, navigateTo: null });\n  const serialized = JSON.stringify(settleLogout(\"failure\"));\n  assert.equal(serialized.includes(\"refreshToken\"), false);\n  assert.equal(serialized.includes(\"phone\"), false);\n});\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/lib/seo.ts": {
      "sha256": "fabfd673baab394cb23aea47db9a4e05e815007146504a0850fcd2d470f8381a",
      "text": "import type { PublicSpecialistDetail } from \"@/lib/contracts/specialists\";\n\n/** Canonical origin — override in production via env. */\nexport const SITE_URL =\n  process.env.NEXT_PUBLIC_SITE_URL ?? \"https://karban.ir\";\n\ntype JsonLdValue = Record<string, unknown> | readonly unknown[];\n\n/**\n * Produces script-safe JSON while preserving the original structured data.\n * React renders this string as script text, so tag delimiters must not survive.\n */\nexport function serializeJsonLd(value: JsonLdValue): string {\n  return JSON.stringify(value)\n    .replace(/</g, \"\\\\u003c\")\n    .replace(/&/g, \"\\\\u0026\");\n}\n\n/* ---------------- JSON-LD builders ---------------- */\n\nexport function orgJsonLd() {\n  return {\n    \"@context\": \"https://schema.org\",\n    \"@type\": \"Organization\",\n    \"@id\": `${SITE_URL}/#org`,\n    name: \"کاربان\",\n    alternateName: \"Karban\",\n    url: SITE_URL,\n    logo: `${SITE_URL}/icons/icon-512.svg`,\n    description: \"فهرست عمومی متخصصان و خدمات ساختمانی کاربان\",\n  };\n}\n\nexport function webSiteJsonLd() {\n  return {\n    \"@context\": \"https://schema.org\",\n    \"@type\": \"WebSite\",\n    \"@id\": `${SITE_URL}/#website`,\n    name: \"کاربان\",\n    url: SITE_URL,\n    inLanguage: \"fa-IR\",\n    publisher: { \"@id\": `${SITE_URL}/#org` },\n    potentialAction: {\n      \"@type\": \"SearchAction\",\n      target: {\n        \"@type\": \"EntryPoint\",\n        urlTemplate: `${SITE_URL}/search?q={search_term_string}`,\n      },\n      \"query-input\": \"required name=search_term_string\",\n    },\n  };\n}\n\n/** LocalBusiness data limited to the normalized public specialist detail. */\nexport function specialistJsonLd(specialist: PublicSpecialistDetail) {\n  const schema: Record<string, unknown> = {\n    \"@context\": \"https://schema.org\",\n    \"@type\": \"LocalBusiness\",\n    \"@id\": `${SITE_URL}/specialists/${encodeURIComponent(specialist.slug)}#business`,\n    name: specialist.title,\n    url: `${SITE_URL}/specialists/${encodeURIComponent(specialist.slug)}`,\n    parentOrganization: { \"@id\": `${SITE_URL}/#org` },\n  };\n\n  const description = specialist.description ?? specialist.bio;\n  if (description) schema.description = description;\n  if (specialist.skills) schema.knowsAbout = specialist.skills;\n  if (specialist.priceHint) schema.priceRange = specialist.priceHint;\n\n  const city = specialist.cities[0];\n  if (specialist.address || city) {\n    schema.address = {\n      \"@type\": \"PostalAddress\",\n      ...(specialist.address ? { streetAddress: specialist.address } : {}),\n      ...(city ? { addressLocality: city } : {}),\n      addressCountry: \"IR\",\n    };\n  }\n\n  if (specialist.rating) {\n    schema.aggregateRating = {\n      \"@type\": \"AggregateRating\",\n      ratingValue: specialist.rating.average,\n      reviewCount: specialist.rating.count,\n      bestRating: 5,\n      worstRating: 1,\n    };\n  }\n\n  return schema;\n}\n\nexport function breadcrumbJsonLd(\n  items: { name: string; path: string }[],\n) {\n  return {\n    \"@context\": \"https://schema.org\",\n    \"@type\": \"BreadcrumbList\",\n    itemListElement: items.map((item, index) => ({\n      \"@type\": \"ListItem\",\n      position: index + 1,\n      name: item.name,\n      item: `${SITE_URL}${item.path}`,\n    })),\n  };\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/lib/auth-ui.test.ts": {
      "sha256": "2f76a31978a34f6fda9921aebadb51e2ed4266bfc7b9de56bb9c7e6af64ae095",
      "text": "import assert from \"node:assert/strict\";\nimport { test } from \"node:test\";\nimport {\n  buildOtpRequest,\n  mapAuthError,\n  parseAuthChallenge,\n  parseAuthResult,\n  otpSlots,\n} from \"./auth-ui.ts\";\n\ntest(\"builds the exact request shape with the selected pre-verification role\", () => {\n  assert.deepEqual(buildOtpRequest(\"۰۹۱۲۱۲۳۴۵۶۷\", \"specialist\"), {\n    phone: \"۰۹۱۲۱۲۳۴۵۶۷\",\n    role: \"specialist\",\n  });\n});\n\ntest(\"derives five or six presentation slots from the safe challenge\", () => {\n  assert.deepEqual(otpSlots(5), [0, 1, 2, 3, 4]);\n  assert.deepEqual(otpSlots(6), [0, 1, 2, 3, 4, 5]);\n  assert.deepEqual(parseAuthChallenge({ expiresAt: 1_700_000_100_000, codeLength: 6, isSimulated: true }), {\n    expiresAt: 1_700_000_100_000,\n    codeLength: 6,\n    isSimulated: true,\n  });\n  assert.throws(() => parseAuthChallenge({ expiresAt: 0, codeLength: 7, isSimulated: \"yes\" }));\n});\n\ntest(\"accepts only authoritative fixed redirects and safe account summaries\", () => {\n  assert.deepEqual(parseAuthResult({\n    account: { id: 12, displayName: \"نمونه\", role: \"client\" },\n    redirectTo: \"/dashboard\",\n  }), {\n    account: { id: 12, displayName: \"نمونه\", role: \"client\" },\n    redirectTo: \"/dashboard\",\n  });\n  assert.throws(() => parseAuthResult({\n    account: { id: 12, displayName: \"نمونه\", role: \"client\" },\n    redirectTo: \"https://evil.example/steal\",\n  }));\n  assert.equal(JSON.stringify({ account: { id: 12, displayName: \"نمونه\", role: \"client\" } }).includes(\"phone\"), false);\n});\n\ntest(\"maps pending-safe public errors without exposing response details\", () => {\n  assert.equal(mapAuthError(401, \"challenge_missing\"), \"کد تایید در دسترس نیست؛ دوباره درخواست کد کن.\");\n  assert.equal(mapAuthError(422, \"invalid_code\"), \"کد وارد شده صحیح نیست. دوباره تلاش کن.\");\n  assert.equal(mapAuthError(503, \"auth_unavailable\"), \"سرویس ورود موقتاً در دسترس نیست.\");\n  assert.equal(mapAuthError(503, \"invalid_challenge\"), \"اطلاعات کد معتبر نیست؛ کد جدید درخواست کن.\");\n  assert.equal(mapAuthError(500, \"access-token-private\"), \"عملیات ورود انجام نشد. دوباره تلاش کن.\");\n});\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/lib/specialist-search.ts": {
      "sha256": "3f3b03c3a662c1b6fa191520fbc23ed03482fca478d6a22ee88cda5625b9570e",
      "text": "import type {\n  PublicSpecialistSearchInput,\n  PublicSpecialistSearchParams,\n} from \"./contracts/specialists.ts\";\nimport { PublicDataContractError } from \"./specialist-adapters.ts\";\n\nconst DEFAULT_PER_PAGE = 20;\nconst MAX_PER_PAGE = 30;\nconst MAX_QUERY_LENGTH = 200;\nconst CONTROL_CHARACTERS = /[\\u0000-\\u001F\\u007F]/;\nconst PERSIAN_DIGITS = \"۰۱۲۳۴۵۶۷۸۹\";\nconst ARABIC_DIGITS = \"٠١٢٣٤٥٦٧٨٩\";\n\nfunction firstScalar(value: string | string[] | undefined): string | undefined {\n  return Array.isArray(value) ? value[0] : value;\n}\n\nfunction translateDigits(value: string): string {\n  return value.replace(/[۰-۹٠-٩]/g, (digit) => {\n    const index = PERSIAN_DIGITS.indexOf(digit);\n    return String(index >= 0 ? index : ARABIC_DIGITS.indexOf(digit));\n  });\n}\n\nfunction boundedText(value: string | undefined, maximum: number): string {\n  if (typeof value !== \"string\" || CONTROL_CHARACTERS.test(value)) return \"\";\n  return value.trim().slice(0, maximum);\n}\n\nfunction pageValue(value: string | undefined, fallback: number): number {\n  const text = translateDigits(value ?? \"\").trim();\n  if (!/^\\d+$/.test(text)) return fallback;\n  const parsed = Number(text);\n  return Number.isSafeInteger(parsed) && parsed > 0 ? parsed : fallback;\n}\n\nexport function parseSpecialistSearchParams(input: PublicSpecialistSearchInput): PublicSpecialistSearchParams {\n  const perPage = pageValue(firstScalar(input.per_page), DEFAULT_PER_PAGE);\n  return {\n    q: boundedText(firstScalar(input.q), MAX_QUERY_LENGTH),\n    category: boundedText(firstScalar(input.category), MAX_QUERY_LENGTH),\n    city: boundedText(firstScalar(input.city), MAX_QUERY_LENGTH),\n    verified: [\"1\", \"true\"].includes(firstScalar(input.verified)?.trim().toLowerCase() ?? \"\"),\n    page: pageValue(firstScalar(input.page), 1),\n    perPage: Math.min(Math.max(perPage, 1), MAX_PER_PAGE),\n  };\n}\n\nexport function buildSpecialistSearchQuery(params: PublicSpecialistSearchParams): string {\n  const query = new URLSearchParams();\n  if (params.q) query.set(\"q\", params.q);\n  if (params.category) query.set(\"category\", params.category);\n  if (params.city) query.set(\"city\", params.city);\n  if (params.verified) query.set(\"verified\", \"1\");\n  query.set(\"page\", String(params.page));\n  query.set(\"per_page\", String(params.perPage));\n  return query.toString();\n}\n\nexport function buildSpecialistPaginationQuery(\n  params: PublicSpecialistSearchParams,\n  page: number,\n  changedFilters?: Partial<Pick<PublicSpecialistSearchParams, \"q\" | \"category\" | \"city\" | \"verified\" | \"perPage\">>,\n): string {\n  const filtersChanged = changedFilters !== undefined;\n  const next = { ...params, ...changedFilters, page: filtersChanged ? 1 : page };\n  return buildSpecialistSearchQuery({\n    ...next,\n    page: Number.isSafeInteger(next.page) && next.page > 0 ? next.page : 1,\n    perPage: Math.min(Math.max(next.perPage, 1), MAX_PER_PAGE),\n  });\n}\n\nexport function buildSpecialistDetailPath(slug: string): string {\n  if (\n    typeof slug !== \"string\" || slug.trim().length === 0 || CONTROL_CHARACTERS.test(slug) ||\n    /[\\\\/?#]/.test(slug) || slug.includes(\"..\")\n  ) {\n    throw new PublicDataContractError(\"شناسهٔ عمومی متخصص معتبر نیست.\");\n  }\n  return `specialists/${encodeURIComponent(slug.trim())}`;\n}\n\nexport const DEFAULT_SPECIALIST_PER_PAGE = DEFAULT_PER_PAGE;\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/lib/auth-page-guards.test.ts": {
      "sha256": "d08ef454493f4d5c023aaa42e1f8742e11201d805e5659b6423fd2a73dcf7d78",
      "text": "import assert from \"node:assert/strict\";\nimport { test } from \"node:test\";\nimport { resolveProtectedRoute, resolveProtectedRouteFromSession } from \"./auth-page-guards.ts\";\nimport type { AccountSummary } from \"./contracts/auth.ts\";\n\nconst client: AccountSummary = { id: 1, displayName: \"کارفرما\", role: \"client\" };\nconst specialist: AccountSummary = { id: 2, displayName: \"متخصص\", role: \"specialist\" };\nconst mixed: AccountSummary = { id: 3, displayName: \"حساب چندنقشی\", role: null };\n\ntest(\"guards anonymous accounts with a fixed login redirect\", async () => {\n  const port = { readAccount: async () => undefined };\n  assert.deepEqual(await resolveProtectedRouteFromSession(port, \"client\"), {\n    kind: \"redirect\",\n    location: \"/auth/login\",\n  });\n});\n\ntest(\"allows only the matching client or specialist role\", async () => {\n  assert.deepEqual(await resolveProtectedRouteFromSession({ readAccount: async () => client }, \"client\"), { kind: \"allow\", account: client });\n  assert.deepEqual(await resolveProtectedRouteFromSession({ readAccount: async () => specialist }, \"specialist\"), { kind: \"allow\", account: specialist });\n  assert.deepEqual(await resolveProtectedRouteFromSession({ readAccount: async () => client }, \"specialist\"), { kind: \"redirect\", location: \"/dashboard\" });\n  assert.deepEqual(await resolveProtectedRouteFromSession({ readAccount: async () => specialist }, \"client\"), { kind: \"redirect\", location: \"/pro\" });\n});\n\ntest(\"fails closed for mixed or unknown roles without a user-controlled return path\", async () => {\n  assert.deepEqual(await resolveProtectedRouteFromSession({ readAccount: async () => mixed }, \"client\"), { kind: \"redirect\", location: \"/auth/login\" });\n  assert.deepEqual(resolveProtectedRoute({ ...mixed, role: null }, \"specialist\"), { kind: \"redirect\", location: \"/auth/login\" });\n  const serialized = JSON.stringify(await resolveProtectedRouteFromSession({ readAccount: async () => undefined }, \"client\"));\n  assert.equal(serialized.includes(\"phone\"), false);\n  assert.equal(serialized.includes(\"return\"), false);\n});\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/lib/specialist-sitemap.ts": {
      "sha256": "e65e9c3a87725b43e5e9c639fcddc7ad74f591c0b8d61bd6a15f2ddc8d7ef7e9",
      "text": "export interface SpecialistSitemapItem {\n  slug: string;\n}\n\n/** Keeps sitemap paths stable when the public catalog repeats an item across pages. */\nexport function collectSpecialistSitemapSlugs(\n  pages: readonly (readonly SpecialistSitemapItem[])[],\n): string[] {\n  const slugs = new Set<string>();\n\n  for (const page of pages) {\n    for (const item of page) {\n      const slug = item.slug.trim();\n      if (slug) slugs.add(slug);\n    }\n  }\n\n  return [...slugs];\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/lib/portfolio-dialog.ts": {
      "sha256": "340310f467df6fe9d2c34ea1214c1615d366b6c00800007d5e421b797d45f84c",
      "text": "interface DialogPort {open:boolean;showModal():void;close():void;}\ninterface FocusPort {focus():void;}\n/** One native modal lifetime across image selections; only final close restores the opener. */\nexport function createPortfolioDialogSession(){\n let current:DialogPort|null=null;let previous:FocusPort|null=null;\n return {\n  show(dialog:DialogPort,opener:FocusPort|null){\n   if(current===dialog&&dialog.open)return;\n   current=dialog;previous=opener;\n   if(!dialog.open)dialog.showModal();\n  },\n  close(){\n   const element=current;const opener=previous;current=null;previous=null;\n   if(element?.open)element.close();\n   opener?.focus();\n  },\n };\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/lib/auth-completion.test.ts": {
      "sha256": "84413c4667a62a68450f067d2b7b3d07187343c8786b2608ef98378cd52b1891",
      "text": "import assert from 'node:assert/strict';\nimport { test } from 'node:test';\nimport * as auth from './auth-ui.ts';\n\ntest('verify reload reads actual challenge even with no transient phone; resend requires reentry',async()=>{\n  assert.equal(typeof auth.readVerificationChallenge,'function');let calls=0;\n  const challenge=await auth.readVerificationChallenge(async(path)=>{assert.equal(path,'/api/auth/challenge');calls++;return Response.json({challenge:{expiresAt:1900000000000,codeLength:5,isSimulated:false}});});\n  assert.equal(challenge.codeLength,5);assert.equal(calls,1);\n  assert.equal(auth.canResendCode('',false,0),false);assert.equal(auth.canResendCode('09121234567',false,0),true);\n});\ntest('minimal onboarding is bounded by server account role; wrong-code/expiry/rate/config semantics differ',()=>{\n  const a=auth.parseAuthResult({account:{id:1,displayName:'نام',role:'specialist'},redirectTo:'/pro',onboardingTo:'/pro/profile'});\n  assert.equal(a.onboardingTo,'/pro/profile');\n  assert.throws(()=>auth.parseAuthResult({account:{id:1,displayName:'نام',role:'client'},redirectTo:'/dashboard',onboardingTo:'/pro/profile'}));\n  assert.match(auth.mapAuthError(429,'rate_limited'),/صبر/);\n  assert.notEqual(auth.mapAuthError(422,'invalid_request'),auth.mapAuthError(401,'unauthenticated'));\n});\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/lib/public-specialist-detail.ts": {
      "sha256": "641275c01957deca247d5a552473d3b469c5a9933b3271a6e3c067ba29b3bb20",
      "text": "import { cache } from \"react\";\nimport { loadPublicSpecialistDetail } from \"@/services/wordpress/public-specialists\";\n\n/**\n * Detail loads can record a public profile view upstream. Sharing this cache\n * between the page and its metadata prevents a second load during one render.\n */\nexport const loadCachedPublicSpecialistDetail = cache(\n  async (slug: string) => loadPublicSpecialistDetail(slug),\n);\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/lib/contracts/specialists.ts": {
      "sha256": "1ccf94dc378ef570ab4b81bf027c40448e3cd0776a23a38e22fa7d61895e7182",
      "text": "export type PublicSpecialistAvailability =\n  | \"available\"\n  | \"busy\"\n  | \"away\"\n  | \"unknown\";\n\nexport interface PublicSpecialistRating {\n  average: number;\n  count: number;\n}\n\nexport interface PublicSpecialistCard {\n  id: number;\n  slug: string;\n  title: string;\n  verified: boolean;\n  rating: PublicSpecialistRating | null;\n  avatarUrl: string | null;\n  availability: PublicSpecialistAvailability;\n  categories: string[];\n  cities: string[];\n}\n\nexport interface PublicPortfolioImage { id: number; url: string; type: 'image'; caption: string; }\n\nexport interface PublicSpecialistDetail extends PublicSpecialistCard {\n  description: string | null;\n  bio: string | null;\n  skills: string | null;\n  experienceYears: number | null;\n  responseMinutes: number | null;\n  priceHint: string | null;\n  address: string | null;\n  phoneDisplay: string | null;\n  coordinates: { lat: number; lng: number } | null;\n  verifiedAt: string | null;\n  /** Only normalized public images; unsupported legacy media remains unavailable. */\n  gallery: \"empty\" | \"unavailable\" | PublicPortfolioImage[];\n  /** The plugin endpoint has no trustworthy public review records. */\n  reviews: \"unavailable\";\n}\n\nexport interface PublicSpecialistCatalog {\n  items: PublicSpecialistCard[];\n  page: number;\n  total: number;\n  pages: number;\n}\n\nexport interface PublicSpecialistSearchParams {\n  q: string;\n  category: string;\n  city: string;\n  verified: boolean;\n  page: number;\n  perPage: number;\n}\n\nexport type PublicSpecialistSearchInput = Record<\n  string,\n  string | string[] | undefined\n>;\n\nexport type PublicTaxonomy = \"job_category\" | \"city\" | \"neighborhood\";\n\nexport interface PublicTerm {\n  id: number;\n  name: string;\n  slug: string;\n  count: number;\n  parent?: number;\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/lib/contracts/auth.ts": {
      "sha256": "14f42bb2ac2f92b5e2df43eaaf24d70a5de0c8a9afe96677cc8957f571d9b83b",
      "text": "export type RegistrationRole = \"client\" | \"specialist\";\n\nexport interface AccountSummary {\n  id: number;\n  displayName: string;\n  role: RegistrationRole | null;\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/services/wordpress/public-specialists.test.ts": {
      "sha256": "2644d929809876324f693cebbc86a85ed88b6c69f8c9035edda4295d922d283c",
      "text": "import assert from \"node:assert/strict\";\nimport { after, before, test } from \"node:test\";\nimport { WordPressApiError } from \"../wordpress/errors.ts\";\nimport {\n  loadPublicSpecialistDetail,\n  loadPublicSpecialists,\n} from \"./public-specialists.ts\";\n\nconst environment = process.env as Record<string, string | undefined>;\nconst originalUrl = environment.WORDPRESS_URL;\n\nbefore(() => { environment.WORDPRESS_URL = \"https://codecraft.ir/kar/\"; });\nafter(() => {\n  if (originalUrl === undefined) delete environment.WORDPRESS_URL;\n  else environment.WORDPRESS_URL = originalUrl;\n});\n\nconst card = {\n  id: 10, slug: \"mina\", title: \"مینا\", is_verified: true,\n  rating_avg: 4.5, rating_count: 2, avatar_url: null, availability: \"available\",\n  categories: [\"نقاشی\"], cities: [\"تهران\"],\n};\n\ntest(\"loads the fixed public specialists path with normalized supported query\", async () => {\n  const calls: string[] = [];\n  const catalog = await loadPublicSpecialists(\n    { q: \" رنگ \", verified: \"false\", page: \"۲\", per_page: \"31\", radius: \"3\" },\n    { request: async (path) => { calls.push(path); return { items: [card], page: 2, total: 2, pages: 2 }; } },\n  );\n  assert.deepEqual(calls, [\"specialists?q=%D8%B1%D9%86%DA%AF&page=2&per_page=30\"]);\n  assert.equal(catalog.items[0]?.slug, \"mina\");\n  assert.equal(catalog.page, 2);\n  assert.equal(catalog.total, 2);\n  assert.equal(catalog.pages, 2);\n});\n\ntest(\"rejects malformed catalog pagination and card payloads as a safe contract failure\", async () => {\n  await assert.rejects(\n    () => loadPublicSpecialists({}, { request: async () => ({ items: [], page: 1, total: 0, pages: 1.5 }) }),\n    (error: unknown) => error instanceof WordPressApiError && error.status === 502 && error.code === \"invalid_public_contract\",\n  );\n  await assert.rejects(\n    () => loadPublicSpecialists({}, { request: async () => ({ items: [{ ...card, id: \"10\" }], page: 1, total: 1, pages: 1 }) }),\n    (error: unknown) => error instanceof WordPressApiError && error.status === 502,\n  );\n});\n\ntest(\"uses a single encoded detail component and preserves upstream WordPress errors\", async () => {\n  const calls: string[] = [];\n  const detail = await loadPublicSpecialistDetail(\"مینا نقاش\", {\n    request: async (path) => { calls.push(path); return { ...card, slug: \"مینا نقاش\", phone_display: \"۰۹۱۲۱۲۳۴۵۶۷\", gallery: [] }; },\n  });\n  assert.deepEqual(calls, [\"specialists/%D9%85%DB%8C%D9%86%D8%A7%20%D9%86%D9%82%D8%A7%D8%B4\"]);\n  assert.equal(detail.phoneDisplay, \"09121234567\");\n\n  let callsAfterUnsafeSlug = 0;\n  await assert.rejects(() => loadPublicSpecialistDetail(\"../private\", { request: async () => { callsAfterUnsafeSlug += 1; return card; } }));\n  assert.equal(callsAfterUnsafeSlug, 0);\n\n  const notFound = new WordPressApiError({ status: 404, code: \"not_found\", message: \"یافت نشد\" });\n  await assert.rejects(\n    () => loadPublicSpecialistDetail(\"missing\", { request: async () => { throw notFound; } }),\n    (error: unknown) => error === notFound,\n  );\n});\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/services/wordpress/rest-client.ts": {
      "sha256": "e7662a09de852b26ce622a63ceebf80a4a362b7980e0e7c4343eed5354a52a0d",
      "text": "import {\n  assertWordPressServerOnly,\n  getWordPressOrigin,\n  getWordPressPermalinkMode,\n  getWordPressRestBaseUrl,\n  WORDPRESS_REST_NAMESPACE,\n} from \"./config.ts\";\nimport {\n  isWordPressFailureEnvelope,\n  isWordPressSuccessEnvelope,\n  type WordPressFailureEnvelope,\n} from \"./contracts.ts\";\nimport { WordPressApiError } from \"./errors.ts\";\n\nexport const DEFAULT_WORDPRESS_TIMEOUT_MS = 10_000;\n\nexport type WordPressFetch = (\n  input: RequestInfo | URL,\n  init?: RequestInit,\n) => Promise<Response>;\n\nexport interface WordPressRequestOptions<TBody = unknown> {\n  method?: string;\n  body?: TBody;\n  token?: string;\n  accessToken?: string;\n  authToken?: string;\n  authorizationToken?: string;\n  timeoutMs?: number;\n  signal?: AbortSignal;\n  fetch?: WordPressFetch;\n  fetchImpl?: WordPressFetch;\n}\n\nexport interface WordPressRestRequest<TBody = unknown>\n  extends WordPressRequestOptions<TBody> {\n  path: string;\n}\n\ntype WordPressResponseLike = Response & {\n  json?: () => Promise<unknown>;\n  text?: () => Promise<string>;\n};\n\nfunction invalidRequestError(code: string, message: string): WordPressApiError {\n  return new WordPressApiError({ status: 400, code, message });\n}\n\nfunction resolveToken(options: WordPressRequestOptions): string | undefined {\n  const token =\n    options.token ??\n    options.accessToken ??\n    options.authToken ??\n    options.authorizationToken;\n\n  if (token === undefined || token === \"\") {\n    return undefined;\n  }\n\n  if (typeof token !== \"string\") {\n    throw invalidRequestError(\n      \"invalid_token\",\n      \"توکن احراز هویت باید یک رشته باشد.\",\n    );\n  }\n\n  return token;\n}\n\nfunction resolveTimeout(options: WordPressRequestOptions): number {\n  if (options.timeoutMs === undefined) {\n    return DEFAULT_WORDPRESS_TIMEOUT_MS;\n  }\n\n  if (\n    typeof options.timeoutMs !== \"number\" ||\n    !Number.isFinite(options.timeoutMs) ||\n    options.timeoutMs <= 0\n  ) {\n    throw invalidRequestError(\n      \"invalid_timeout\",\n      \"مهلت درخواست باید یک عدد مثبت باشد.\",\n    );\n  }\n\n  return options.timeoutMs;\n}\n\nfunction normalizeMethod(method: string | undefined): string {\n  if (method === undefined) {\n    return \"GET\";\n  }\n\n  const normalizedMethod = method.trim().toUpperCase();\n  if (!/^[A-Z]+$/.test(normalizedMethod)) {\n    throw invalidRequestError(\"invalid_method\", \"روش درخواست معتبر نیست.\");\n  }\n\n  return normalizedMethod;\n}\n\nfunction hasPathTraversal(path: string): boolean {\n  if (path.includes(\"\\\\\")) {\n    return true;\n  }\n\n  const pathWithoutQuery = path.split(/[?#]/, 1)[0] ?? path;\n  let decodedPath = pathWithoutQuery;\n\n  try {\n    decodedPath = decodeURIComponent(pathWithoutQuery);\n  } catch {\n    return true;\n  }\n\n  return decodedPath.split(\"/\").some((segment) => segment === \"..\");\n}\n\nfunction hasReservedRestQuery(searchParams: URLSearchParams): boolean {\n  for (const key of searchParams.keys()) {\n    // URLSearchParams decodes percent escapes and '+'. PHP then truncates at\n    // NUL, skips leading spaces, and normalizes dots/spaces in top-level names.\n    const phpKey = (key.split(\"\\0\", 1)[0] ?? \"\")\n      .replace(/^ +/, \"\")\n      .replace(/[ .]/g, \"_\");\n    const topLevelKey = phpKey.split(\"[\", 1)[0];\n\n    // Array suffixes still address the reserved root. An unmatched '[' is\n    // normalized to '_' by PHP, so `rest[route` also becomes `rest_route`.\n    if (\n      topLevelKey === \"rest_route\" ||\n      phpKey.replace(/\\[/g, \"_\") === \"rest_route\"\n    ) {\n      return true;\n    }\n  }\n\n  return false;\n}\n\nexport function buildWordPressRestUrl(path: string, configuredUrl?: string): string {\n  if (typeof path !== \"string\") {\n    throw invalidRequestError(\"invalid_path\", \"مسیر درخواست معتبر نیست.\");\n  }\n\n  const trimmedPath = path.trim();\n  if (\n    trimmedPath.length === 0 ||\n    /^(?:[a-z][a-z\\d+.-]*:|\\/\\/)/i.test(trimmedPath) ||\n    hasPathTraversal(trimmedPath) ||\n    trimmedPath.includes(\"#\")\n  ) {\n    if (trimmedPath.length === 0) {\n      return getWordPressRestBaseUrl(configuredUrl);\n    }\n\n    throw invalidRequestError(\n      \"invalid_path\",\n      \"مسیر درخواست باید زیرمسیر امن وردپرس باشد.\",\n    );\n  }\n\n  const origin = getWordPressOrigin(configuredUrl);\n  const prettyBase = new URL(\n    `${origin}/wp-json/${WORDPRESS_REST_NAMESPACE}/`,\n  );\n  const relativePath = trimmedPath.replace(/^\\/+/, \"\");\n  const resolved = new URL(relativePath, prettyBase);\n\n  if (\n    resolved.origin !== prettyBase.origin ||\n    !resolved.pathname.startsWith(prettyBase.pathname) ||\n    hasReservedRestQuery(resolved.searchParams)\n  ) {\n    throw invalidRequestError(\n      \"invalid_path\",\n      \"مسیر درخواست باید زیرمسیر امن وردپرس باشد.\",\n    );\n  }\n\n  if (getWordPressPermalinkMode() === \"pretty\") {\n    return resolved.toString();\n  }\n\n  const routePath = resolved.pathname.slice(prettyBase.pathname.length);\n  const endpoint = new URL(`${origin}/index.php`);\n  endpoint.searchParams.set(\n    \"rest_route\",\n    `/${WORDPRESS_REST_NAMESPACE}/${routePath}`,\n  );\n  for (const [key, value] of resolved.searchParams) {\n    endpoint.searchParams.append(key, value);\n  }\n  return endpoint.toString();\n}\n\nasync function readJson(response: WordPressResponseLike): Promise<unknown> {\n  if (typeof response.text === \"function\") {\n    const text = await response.text();\n    if (text.trim().length === 0) {\n      throw new SyntaxError(\"Empty JSON response\");\n    }\n    return JSON.parse(text) as unknown;\n  }\n\n  if (typeof response.json === \"function\") {\n    return response.json();\n  }\n\n  throw new SyntaxError(\"Response has no JSON body reader\");\n}\n\nfunction responseStatus(response: WordPressResponseLike): number {\n  return Number.isFinite(response.status) ? response.status : 0;\n}\n\nfunction isSuccessfulHttpResponse(response: WordPressResponseLike): boolean {\n  if (typeof response.ok === \"boolean\") {\n    return response.ok;\n  }\n\n  const status = responseStatus(response);\n  return status >= 200 && status < 300;\n}\n\nfunction pluginErrorToApiError(\n  envelope: WordPressFailureEnvelope,\n  status: number,\n  token: string | undefined,\n): WordPressApiError {\n  return new WordPressApiError({\n    status,\n    code: envelope.error.code,\n    message: envelope.error.message,\n    data: envelope.error.data,\n    sensitiveValues: token ? [token] : [],\n  });\n}\n\nfunction httpError(status: number, token: string | undefined): WordPressApiError {\n  return new WordPressApiError({\n    status,\n    code: \"http_error\",\n    message: \"درخواست وردپرس با خطا روبه‌رو شد.\",\n    sensitiveValues: token ? [token] : [],\n  });\n}\n\nfunction invalidJsonError(status: number, token: string | undefined): WordPressApiError {\n  return new WordPressApiError({\n    status,\n    code: \"invalid_json\",\n    message: \"پاسخ وردپرس JSON معتبر نیست.\",\n    sensitiveValues: token ? [token] : [],\n  });\n}\n\nfunction invalidEnvelopeError(\n  status: number,\n  token: string | undefined,\n): WordPressApiError {\n  return new WordPressApiError({\n    status,\n    code: \"invalid_envelope\",\n    message: \"ساختار پاسخ وردپرس معتبر نیست.\",\n    sensitiveValues: token ? [token] : [],\n  });\n}\n\nfunction timeoutError(status: number, token: string | undefined): WordPressApiError {\n  return new WordPressApiError({\n    status,\n    code: \"timeout\",\n    message: \"مهلت درخواست وردپرس به پایان رسید.\",\n    sensitiveValues: token ? [token] : [],\n  });\n}\n\nfunction abortedError(status: number, token: string | undefined): WordPressApiError {\n  return new WordPressApiError({\n    status,\n    code: \"aborted\",\n    message: \"درخواست وردپرس لغو شد.\",\n    sensitiveValues: token ? [token] : [],\n  });\n}\n\nfunction networkError(token: string | undefined): WordPressApiError {\n  return new WordPressApiError({\n    status: 0,\n    code: \"network_error\",\n    message: \"ارتباط با وردپرس برقرار نشد.\",\n    sensitiveValues: token ? [token] : [],\n  });\n}\n\nfunction getFetchImplementation(\n  options: WordPressRequestOptions,\n): WordPressFetch {\n  const fetchImplementation = options.fetch ?? options.fetchImpl;\n  if (fetchImplementation) {\n    return fetchImplementation;\n  }\n\n  if (typeof globalThis.fetch === \"function\") {\n    return globalThis.fetch.bind(globalThis) as WordPressFetch;\n  }\n\n  throw new WordPressApiError({\n    status: 0,\n    code: \"fetch_unavailable\",\n    message: \"امکان ارسال درخواست وردپرس وجود ندارد.\",\n  });\n}\n\ninterface RequestSignal {\n  signal: AbortSignal;\n  didTimeout: () => boolean;\n  cleanup: () => void;\n}\n\nfunction createRequestSignal(\n  timeoutMs: number,\n  callerSignal: AbortSignal | undefined,\n): RequestSignal {\n  const controller = new AbortController();\n  let timedOut = false;\n\n  const timeoutId = setTimeout(() => {\n    timedOut = true;\n    controller.abort();\n  }, timeoutMs);\n\n  const onCallerAbort = () => controller.abort(callerSignal?.reason);\n  if (callerSignal) {\n    if (callerSignal.aborted) {\n      onCallerAbort();\n    } else {\n      callerSignal.addEventListener(\"abort\", onCallerAbort, { once: true });\n    }\n  }\n\n  return {\n    signal: controller.signal,\n    didTimeout: () => timedOut,\n    cleanup: () => {\n      clearTimeout(timeoutId);\n      callerSignal?.removeEventListener(\"abort\", onCallerAbort);\n    },\n  };\n}\n\nfunction normalizeRestArguments<TBody>(\n  pathOrRequest: string | WordPressRestRequest<TBody>,\n  options: WordPressRequestOptions<TBody> | undefined,\n): { path: string; options: WordPressRequestOptions<TBody> } {\n  if (typeof pathOrRequest === \"string\") {\n    return { path: pathOrRequest, options: options ?? {} };\n  }\n\n  if (\n    pathOrRequest !== null &&\n    typeof pathOrRequest === \"object\" &&\n    typeof pathOrRequest.path === \"string\"\n  ) {\n    return { path: pathOrRequest.path, options: pathOrRequest };\n  }\n\n  throw invalidRequestError(\"invalid_path\", \"مسیر درخواست معتبر نیست.\");\n}\n\nexport async function wordpressRest<TData = unknown, TBody = unknown>(\n  pathOrRequest: string | WordPressRestRequest<TBody>,\n  options?: WordPressRequestOptions<TBody>,\n): Promise<TData> {\n  assertWordPressServerOnly();\n\n  const request = normalizeRestArguments(pathOrRequest, options);\n  const token = resolveToken(request.options);\n  const timeoutMs = resolveTimeout(request.options);\n  const method = normalizeMethod(request.options.method);\n  const url = buildWordPressRestUrl(request.path);\n  const fetchImplementation = getFetchImplementation(request.options);\n  const hasBody = request.options.body !== undefined;\n\n  let body: string | undefined;\n  if (hasBody) {\n    try {\n      body = JSON.stringify(request.options.body);\n    } catch {\n      throw invalidRequestError(\"invalid_body\", \"بدنه درخواست قابل پردازش نیست.\");\n    }\n\n    if (body === undefined) {\n      throw invalidRequestError(\"invalid_body\", \"بدنه درخواست قابل پردازش نیست.\");\n    }\n  }\n\n  const headers: Record<string, string> = {\n    Accept: \"application/json\",\n  };\n  if (hasBody) {\n    headers[\"Content-Type\"] = \"application/json\";\n  }\n  if (token) {\n    headers.Authorization = `Bearer ${token}`;\n  }\n\n  const requestSignal = createRequestSignal(timeoutMs, request.options.signal);\n  const init: RequestInit = {\n    method,\n    headers,\n    cache: \"no-store\",\n    signal: requestSignal.signal,\n  };\n  if (hasBody) {\n    init.body = body;\n  }\n\n  try {\n    const response = (await fetchImplementation(url, init)) as WordPressResponseLike;\n    const status = responseStatus(response);\n    let payload: unknown;\n\n    try {\n      payload = await readJson(response);\n    } catch (error) {\n      // Body consumption can reject after headers when the request is aborted.\n      // Preserve that cause for the shared cancellation mapping below.\n      if (requestSignal.signal.aborted) {\n        throw error;\n      }\n      throw invalidJsonError(status, token);\n    }\n\n    if (!isSuccessfulHttpResponse(response)) {\n      if (isWordPressFailureEnvelope(payload)) {\n        throw pluginErrorToApiError(payload, status, token);\n      }\n      throw httpError(status, token);\n    }\n\n    if (isWordPressFailureEnvelope(payload)) {\n      throw pluginErrorToApiError(payload, status, token);\n    }\n\n    if (!isWordPressSuccessEnvelope<TData>(payload)) {\n      throw invalidEnvelopeError(status, token);\n    }\n\n    return payload.data;\n  } catch (error) {\n    if (requestSignal.didTimeout()) {\n      throw timeoutError(408, token);\n    }\n\n    if (request.options.signal?.aborted) {\n      throw abortedError(499, token);\n    }\n\n    if (error instanceof WordPressApiError) {\n      throw error;\n    }\n\n    throw networkError(token);\n  } finally {\n    requestSignal.cleanup();\n  }\n}\n\nexport const requestWordPressRest = wordpressRest;\nexport const wordpressRestRequest = wordpressRest;\nexport const fetchWordPressRest = wordpressRest;\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/services/wordpress/public-specialists.ts": {
      "sha256": "33bb013bc63088b61c0bbcc472689cbaad1ab4a08dbead497d07f6a3f7270ddf",
      "text": "import {\n  parseSpecialistCard,\n  parseSpecialistDetail,\n  PublicDataContractError,\n} from \"../../lib/specialist-adapters.ts\";\nimport {\n  buildSpecialistDetailPath,\n  buildSpecialistSearchQuery,\n  parseSpecialistSearchParams,\n} from \"../../lib/specialist-search.ts\";\nimport type {\n  PublicSpecialistCatalog,\n  PublicSpecialistDetail,\n  PublicSpecialistSearchInput,\n} from \"../../lib/contracts/specialists.ts\";\nimport { WordPressApiError } from \"./errors.ts\";\nimport { wordpressRest } from \"./rest-client.ts\";\n\nexport type PublicSpecialistRequest = (path: string) => Promise<unknown>;\n\nexport interface PublicSpecialistsOptions {\n  request?: PublicSpecialistRequest;\n}\n\nfunction requestBoundary(options: PublicSpecialistsOptions): PublicSpecialistRequest {\n  return options.request ?? ((path) => wordpressRest(path));\n}\n\nfunction requiredSafeInteger(value: unknown, field: string, minimum = 0): number {\n  if (!Number.isSafeInteger(value) || (value as number) < minimum) {\n    throw new PublicDataContractError(`صفحه‌بندی عمومی ${field} معتبر نیست.`);\n  }\n  return value as number;\n}\n\nfunction parseCatalog(value: unknown): PublicSpecialistCatalog {\n  if (typeof value !== \"object\" || value === null || Array.isArray(value)) {\n    throw new PublicDataContractError(\"فهرست عمومی متخصصان معتبر نیست.\");\n  }\n  const catalog = value as Record<string, unknown>;\n  if (!Array.isArray(catalog.items)) {\n    throw new PublicDataContractError(\"فهرست عمومی متخصصان معتبر نیست.\");\n  }\n  const page = requiredSafeInteger(catalog.page, \"page\", 1);\n  const total = requiredSafeInteger(catalog.total, \"total\");\n  const pages = requiredSafeInteger(catalog.pages, \"pages\");\n  if ((total === 0 && pages !== 0) || (total > 0 && (pages < 1 || page > pages))) {\n    throw new PublicDataContractError(\"صفحه‌بندی عمومی متخصصان معتبر نیست.\");\n  }\n  return { items: catalog.items.map(parseSpecialistCard), page, total, pages };\n}\n\nexport async function loadPublicSpecialists(\n  input: PublicSpecialistSearchInput = {},\n  options: PublicSpecialistsOptions = {},\n): Promise<PublicSpecialistCatalog> {\n  const query = buildSpecialistSearchQuery(parseSpecialistSearchParams(input));\n  const payload = await requestBoundary(options)(`specialists?${query}`);\n  return parseCatalog(payload);\n}\n\nexport async function loadPublicSpecialistDetail(\n  slug: string,\n  options: PublicSpecialistsOptions = {},\n): Promise<PublicSpecialistDetail> {\n  const payload = await requestBoundary(options)(buildSpecialistDetailPath(slug));\n  return parseSpecialistDetail(payload);\n}\n\n/** Helps UI callers distinguish a true public 404 from upstream failure. */\nexport function isPublicSpecialistNotFound(error: unknown): error is WordPressApiError {\n  return error instanceof WordPressApiError && error.status === 404 && error.code === \"not_found\";\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/services/wordpress/errors.ts": {
      "sha256": "bae711380c1ec786569c3825a3c2d13ccea34ceb881a057f107d2fc739526386",
      "text": "const SENSITIVE_KEY_PATTERN =\n  /(authorization|access[_-]?token|refresh[_-]?token|id[_-]?token|token|secret|password|cookie|credential|api[_-]?key)/i;\nconst BEARER_PATTERN = /\\bBearer\\s+[^\\s,;]+/gi;\nconst JWT_KEY_PATTERN = /eyJ[A-Za-z0-9_-]*\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]*/;\n\nexport type SafeWordPressErrorData =\n  | null\n  | boolean\n  | number\n  | string\n  | SafeWordPressErrorData[]\n  | { [key: string]: SafeWordPressErrorData };\n\nexport interface WordPressApiErrorOptions {\n  status: number;\n  code: string;\n  message: string;\n  data?: unknown;\n  /** Values that must not appear in the error message or safe data. */\n  sensitiveValues?: readonly string[];\n}\n\nfunction redactString(value: string, sensitiveValues: readonly string[] = []): string {\n  let redacted = value.replace(BEARER_PATTERN, \"Bearer [redacted]\");\n\n  for (const sensitiveValue of sensitiveValues) {\n    if (sensitiveValue.length > 0) {\n      redacted = redacted.split(sensitiveValue).join(\"[redacted]\");\n    }\n  }\n\n  return redacted;\n}\n\n/**\n * Keep backend error details useful without allowing credentials into an error\n * object that may be rendered or sent to an error monitor.\n */\nexport function toSafeWordPressErrorData(\n  value: unknown,\n  sensitiveValues: readonly string[] = [],\n  seen = new WeakSet<object>(),\n): SafeWordPressErrorData | undefined {\n  if (value === null) {\n    return null;\n  }\n\n  if (typeof value === \"string\") {\n    return redactString(value, sensitiveValues);\n  }\n\n  if (typeof value === \"boolean\" || typeof value === \"number\") {\n    return value;\n  }\n\n  if (Array.isArray(value)) {\n    if (seen.has(value)) {\n      return \"[circular]\";\n    }\n\n    seen.add(value);\n    const safeArray = value.map((item) =>\n      toSafeWordPressErrorData(item, sensitiveValues, seen),\n    );\n    seen.delete(value);\n    return safeArray.map((item) => item ?? null);\n  }\n\n  if (typeof value === \"object\") {\n    if (seen.has(value)) {\n      return \"[circular]\";\n    }\n\n    seen.add(value);\n    const safeObject: { [key: string]: SafeWordPressErrorData } = {};\n\n    for (const [key, item] of Object.entries(value as Record<string, unknown>)) {\n      // Backends may echo credentials in property names as well as values.\n      if (\n        SENSITIVE_KEY_PATTERN.test(key) ||\n        redactString(key, sensitiveValues) !== key ||\n        JWT_KEY_PATTERN.test(key)\n      ) {\n        continue;\n      }\n\n      const safeItem = toSafeWordPressErrorData(item, sensitiveValues, seen);\n      if (safeItem !== undefined) {\n        safeObject[key] = safeItem;\n      }\n    }\n\n    seen.delete(value);\n    return safeObject;\n  }\n\n  return undefined;\n}\n\nexport function sanitizeWordPressErrorMessage(\n  message: string,\n  sensitiveValues: readonly string[] = [],\n): string {\n  const redacted = redactString(message, sensitiveValues).trim();\n  return redacted || \"خطا در ارتباط با وردپرس.\";\n}\n\nfunction normalizeStatus(status: number): number {\n  return Number.isFinite(status) && status >= 0 ? Math.trunc(status) : 0;\n}\n\nfunction normalizeCode(\n  code: string,\n  sensitiveValues: readonly string[] = [],\n): string {\n  const normalized = redactString(code, sensitiveValues).trim();\n  return normalized.length > 0 ? normalized : \"wordpress_error\";\n}\n\nexport class WordPressApiError extends Error {\n  readonly status: number;\n  readonly code: string;\n  readonly data?: SafeWordPressErrorData;\n\n  constructor(options: WordPressApiErrorOptions);\n  constructor(\n    status: number,\n    code: string,\n    message: string,\n    data?: unknown,\n    sensitiveValues?: readonly string[],\n  );\n  constructor(\n    optionsOrStatus: WordPressApiErrorOptions | number,\n    positionalCode?: string,\n    positionalMessage?: string,\n    positionalData?: unknown,\n    positionalSensitiveValues: readonly string[] = [],\n  ) {\n    const options: WordPressApiErrorOptions =\n      typeof optionsOrStatus === \"number\"\n        ? {\n            status: optionsOrStatus,\n            code: positionalCode ?? \"wordpress_error\",\n            message: positionalMessage ?? \"خطا در ارتباط با وردپرس.\",\n            data: positionalData,\n            sensitiveValues: positionalSensitiveValues,\n          }\n        : optionsOrStatus;\n    const sensitiveValues = options.sensitiveValues ?? [];\n\n    super(sanitizeWordPressErrorMessage(options.message, sensitiveValues));\n    this.name = \"WordPressApiError\";\n    this.status = normalizeStatus(options.status);\n    this.code = normalizeCode(options.code, sensitiveValues);\n\n    const safeData = toSafeWordPressErrorData(options.data, sensitiveValues);\n    if (safeData !== undefined) {\n      this.data = safeData;\n    }\n\n    Object.setPrototypeOf(this, new.target.prototype);\n  }\n}\n\nexport function isWordPressApiError(error: unknown): error is WordPressApiError {\n  return error instanceof WordPressApiError;\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/services/wordpress/contracts.ts": {
      "sha256": "d48483bd3855af681fa274385e6f47dba96b85f4052c6ac9a155e25f62554a68",
      "text": "export interface WordPressSuccessEnvelope<TData = unknown> {\n  success: true;\n  data: TData;\n}\n\nexport interface WordPressErrorPayload {\n  code: string;\n  message: string;\n  data?: unknown;\n}\n\nexport interface WordPressFailureEnvelope {\n  success: false;\n  error: WordPressErrorPayload;\n}\n\nexport type WordPressEnvelope<TData = unknown> =\n  | WordPressSuccessEnvelope<TData>\n  | WordPressFailureEnvelope;\n\nexport interface WordPressGraphqlError {\n  message: string;\n  locations?: unknown;\n  path?: unknown;\n  extensions?: Record<string, unknown>;\n  [key: string]: unknown;\n}\n\nexport interface WordPressGraphqlResponse<TData = unknown> {\n  data?: TData;\n  errors?: WordPressGraphqlError[];\n}\n\nfunction isRecord(value: unknown): value is Record<string, unknown> {\n  return typeof value === \"object\" && value !== null && !Array.isArray(value);\n}\n\nfunction hasOwn(value: object, key: PropertyKey): boolean {\n  return Object.prototype.hasOwnProperty.call(value, key);\n}\n\nexport function isWordPressSuccessEnvelope<TData = unknown>(\n  value: unknown,\n): value is WordPressSuccessEnvelope<TData> {\n  return (\n    isRecord(value) &&\n    value.success === true &&\n    hasOwn(value, \"data\")\n  );\n}\n\nexport function isWordPressErrorPayload(value: unknown): value is WordPressErrorPayload {\n  return (\n    isRecord(value) &&\n    typeof value.code === \"string\" &&\n    typeof value.message === \"string\"\n  );\n}\n\nexport function isWordPressFailureEnvelope(\n  value: unknown,\n): value is WordPressFailureEnvelope {\n  return (\n    isRecord(value) &&\n    value.success === false &&\n    isWordPressErrorPayload(value.error)\n  );\n}\n\nexport function isWordPressEnvelope<TData = unknown>(\n  value: unknown,\n): value is WordPressEnvelope<TData> {\n  return isWordPressSuccessEnvelope<TData>(value) || isWordPressFailureEnvelope(value);\n}\n\nexport function isWordPressGraphqlError(value: unknown): value is WordPressGraphqlError {\n  return isRecord(value) && typeof value.message === \"string\";\n}\n\nexport function isWordPressGraphqlResponse<TData = unknown>(\n  value: unknown,\n): value is WordPressGraphqlResponse<TData> {\n  if (!isRecord(value)) {\n    return false;\n  }\n\n  const hasData = hasOwn(value, \"data\");\n  const hasErrors = hasOwn(value, \"errors\");\n\n  if (!hasData && !hasErrors) {\n    return false;\n  }\n\n  return (\n    !hasErrors ||\n    (Array.isArray(value.errors) && value.errors.every(isWordPressGraphqlError))\n  );\n}\n\n// Short aliases keep the runtime guards convenient for internal adapters.\nexport const isSuccessEnvelope = isWordPressSuccessEnvelope;\nexport const isFailureEnvelope = isWordPressFailureEnvelope;\nexport const isGraphqlResponse = isWordPressGraphqlResponse;\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/services/wordpress/taxonomies.ts": {
      "sha256": "3518cb52a3ef0dbceb3fddfed686fb0eca64e2d3958f5bdac56a935a353c78b9",
      "text": "import type { PublicTaxonomy, PublicTerm } from \"../../lib/contracts/specialists.ts\";\nimport {\n  assertWordPressServerOnly,\n  getWordPressOrigin,\n  getWordPressPermalinkMode,\n} from \"./config.ts\";\nimport { WordPressApiError } from \"./errors.ts\";\nimport type { WordPressFetch } from \"./rest-client.ts\";\n\nconst TERM_PATHS: Readonly<Record<PublicTaxonomy, string>> = {\n  job_category: \"job_category\",\n  city: \"city\",\n  neighborhood: \"neighborhood\",\n};\nconst CORE_TERMS_TIMEOUT_MS = 10_000;\nconst MAX_TERM_PAGES = 100;\n\nexport interface PublicTermsOptions {\n  fetch?: WordPressFetch;\n  timeoutMs?: number;\n}\n\nfunction contractError(message = \"ساختار دادهٔ عمومی دسته‌بندی معتبر نیست.\"): WordPressApiError {\n  return new WordPressApiError({ status: 502, code: \"invalid_public_contract\", message });\n}\n\nfunction isTaxonomy(value: string): value is PublicTaxonomy {\n  return Object.prototype.hasOwnProperty.call(TERM_PATHS, value);\n}\n\nfunction fetchImplementation(options: PublicTermsOptions): WordPressFetch {\n  if (options.fetch) return options.fetch;\n  if (typeof globalThis.fetch === \"function\") return globalThis.fetch.bind(globalThis) as WordPressFetch;\n  throw new WordPressApiError({ status: 0, code: \"fetch_unavailable\", message: \"امکان ارسال درخواست وردپرس وجود ندارد.\" });\n}\n\nfunction termUrl(taxonomy: PublicTaxonomy, page: number): string {\n  const origin = getWordPressOrigin();\n  const query = new URLSearchParams({ per_page: \"100\", page: String(page), _fields: \"id,name,slug,count,parent\" });\n  const path = TERM_PATHS[taxonomy];\n\n  if (getWordPressPermalinkMode() === \"pretty\") {\n    return `${origin}/wp-json/wp/v2/${path}?${query.toString()}`;\n  }\n\n  const endpoint = new URL(`${origin}/index.php`);\n  endpoint.searchParams.set(\"rest_route\", `/wp/v2/${path}`);\n  for (const [key, value] of query) {\n    endpoint.searchParams.append(key, value);\n  }\n  return endpoint.toString();\n}\n\ninterface TermPagination {\n  pages: number;\n  total: number;\n}\n\nfunction parsePagination(response: Response, payload: unknown[], page: number): TermPagination {\n  const pagesHeader = response.headers.get(\"x-wp-totalpages\");\n  const totalHeader = response.headers.get(\"x-wp-total\");\n  if (\n    !pagesHeader ||\n    !totalHeader ||\n    !/^\\d+$/.test(pagesHeader) ||\n    !/^\\d+$/.test(totalHeader)\n  ) {\n    throw contractError(\"صفحه‌بندی دسته‌بندی معتبر نیست.\");\n  }\n\n  const pages = Number(pagesHeader);\n  const total = Number(totalHeader);\n  if (\n    !Number.isSafeInteger(pages) ||\n    !Number.isSafeInteger(total) ||\n    pages < 0 ||\n    total < 0 ||\n    pages > MAX_TERM_PAGES ||\n    pages !== Math.ceil(total / 100) ||\n    (pages === 0 && (page !== 1 || payload.length !== 0))\n  ) {\n    throw contractError(\"صفحه‌بندی دسته‌بندی معتبر نیست.\");\n  }\n\n  return { pages, total };\n}\n\nfunction parseTerm(value: unknown, taxonomy: PublicTaxonomy): PublicTerm {\n  if (typeof value !== \"object\" || value === null || Array.isArray(value)) throw contractError();\n  const term = value as Record<string, unknown>;\n  if (!Number.isSafeInteger(term.id) || (term.id as number) < 1 || typeof term.name !== \"string\" || !term.name.trim() || typeof term.slug !== \"string\" || !term.slug.trim() || !Number.isSafeInteger(term.count) || (term.count as number) < 0) throw contractError();\n  if (taxonomy === \"job_category\") {\n    if (!Number.isSafeInteger(term.parent) || (term.parent as number) < 0) throw contractError();\n    return { id: term.id as number, name: term.name.trim(), slug: term.slug.trim(), count: term.count as number, parent: term.parent as number };\n  }\n  return { id: term.id as number, name: term.name.trim(), slug: term.slug.trim(), count: term.count as number };\n}\n\nasync function fetchPage(taxonomy: PublicTaxonomy, page: number, fetcher: WordPressFetch, timeoutMs: number): Promise<{ terms: PublicTerm[]; pages: number; total: number }> {\n  const controller = new AbortController();\n  const timeout = setTimeout(() => controller.abort(), timeoutMs);\n  try {\n    let response: Response;\n    try {\n      response = await fetcher(termUrl(taxonomy, page), { method: \"GET\", headers: { Accept: \"application/json\" }, cache: \"no-store\", credentials: \"omit\", signal: controller.signal });\n    } catch {\n      throw new WordPressApiError({ status: controller.signal.aborted ? 408 : 0, code: controller.signal.aborted ? \"timeout\" : \"network_error\", message: controller.signal.aborted ? \"مهلت درخواست وردپرس به پایان رسید.\" : \"ارتباط با وردپرس برقرار نشد.\" });\n    }\n    if (!response.ok) throw new WordPressApiError({ status: response.status, code: \"http_error\", message: \"درخواست وردپرس با خطا روبه‌رو شد.\" });\n    let payload: unknown;\n    try {\n      payload = await response.json();\n    } catch {\n      if (controller.signal.aborted) {\n        throw new WordPressApiError({ status: 408, code: \"timeout\", message: \"مهلت درخواست وردپرس به پایان رسید.\" });\n      }\n      throw new WordPressApiError({ status: response.status, code: \"invalid_json\", message: \"پاسخ وردپرس JSON معتبر نیست.\" });\n    }\n    if (!Array.isArray(payload)) throw contractError();\n    const { pages, total } = parsePagination(response, payload, page);\n    return { terms: payload.map((item) => parseTerm(item, taxonomy)), pages, total };\n  } finally { clearTimeout(timeout); }\n}\n\nexport async function loadPublicTerms(taxonomy: PublicTaxonomy, options: PublicTermsOptions = {}): Promise<PublicTerm[]> {\n  assertWordPressServerOnly();\n  if (!isTaxonomy(taxonomy)) throw new WordPressApiError({ status: 400, code: \"invalid_taxonomy\", message: \"دسته‌بندی عمومی معتبر نیست.\" });\n  const timeoutMs = options.timeoutMs ?? CORE_TERMS_TIMEOUT_MS;\n  if (!Number.isFinite(timeoutMs) || timeoutMs <= 0) throw new WordPressApiError({ status: 400, code: \"invalid_timeout\", message: \"مهلت درخواست باید یک عدد مثبت باشد.\" });\n  const fetcher = fetchImplementation(options);\n  const first = await fetchPage(taxonomy, 1, fetcher, timeoutMs);\n  if (first.pages === 0) {\n    return [];\n  }\n\n  const remaining = Array.from({ length: first.pages - 1 }, (_, index) => index + 2);\n  const later: PublicTerm[][] = [];\n  for (let index = 0; index < remaining.length; index += 4) {\n    const batch = await Promise.all(remaining.slice(index, index + 4).map(async (page) => {\n      const result = await fetchPage(taxonomy, page, fetcher, timeoutMs);\n      if (result.pages !== first.pages || result.total !== first.total) {\n        throw contractError(\"صفحه‌بندی دسته‌بندی معتبر نیست.\");\n      }\n      return result.terms;\n    }));\n    later.push(...batch);\n  }\n  const deduplicated = new Map<number, PublicTerm>();\n  for (const term of [first.terms, ...later].flat()) deduplicated.set(term.id, term);\n  return [...deduplicated.values()];\n}\n\nexport const PUBLIC_TAXONOMIES = Object.freeze(Object.keys(TERM_PATHS) as PublicTaxonomy[]);\nexport const PUBLIC_TERM_PAGE_LIMIT = MAX_TERM_PAGES;\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/services/wordpress/taxonomies.test.ts": {
      "sha256": "b22e9700b8ee313bf3bd6ac591c09aba3fa63544e470e18e725d77558f909c33",
      "text": "import assert from \"node:assert/strict\";\nimport { after, before, test } from \"node:test\";\nimport { WordPressApiError } from \"./errors.ts\";\nimport { loadPublicTerms } from \"./taxonomies.ts\";\n\nconst environment = process.env as Record<string, string | undefined>;\nconst originalUrl = environment.WORDPRESS_URL;\nbefore(() => { environment.WORDPRESS_URL = \"https://codecraft.ir/kar/\"; });\nafter(() => { if (originalUrl === undefined) delete environment.WORDPRESS_URL; else environment.WORDPRESS_URL = originalUrl; });\n\nfunction termsResponse(items: unknown[], pageCount = 1, total = items.length): Response {\n  return new Response(JSON.stringify(items), { status: 200, headers: { \"X-WP-TotalPages\": String(pageCount), \"X-WP-Total\": String(total), \"Content-Type\": \"application/json\" } });\n}\n\ntest(\"loads allowlisted core terms under the configured WordPress subdirectory\", async () => {\n  const urls: string[] = [];\n  const terms = await loadPublicTerms(\"job_category\", {\n    fetch: async (input, init) => {\n      urls.push(String(input));\n      assert.equal(init?.cache, \"no-store\");\n      assert.equal(new Headers(init?.headers).get(\"accept\"), \"application/json\");\n      assert.equal(new Headers(init?.headers).has(\"authorization\"), false);\n      assert.equal(init?.credentials, \"omit\");\n      return termsResponse([{ id: 4, name: \"کاشی\", slug: \"کاشی\", count: 7, parent: 0 }]);\n    },\n  });\n  assert.deepEqual(urls, [\"https://codecraft.ir/kar/wp-json/wp/v2/job_category?per_page=100&page=1&_fields=id%2Cname%2Cslug%2Ccount%2Cparent\"]);\n  assert.deepEqual(terms, [{ id: 4, name: \"کاشی\", slug: \"کاشی\", count: 7, parent: 0 }]);\n});\n\ntest(\"refuses browser execution before dispatching an injected terms fetch\", async () => {\n  const originalWindow = Object.getOwnPropertyDescriptor(globalThis, \"window\");\n  let calls = 0;\n  Object.defineProperty(globalThis, \"window\", { configurable: true, value: {} });\n  try {\n    await assert.rejects(\n      () => loadPublicTerms(\"city\", { fetch: async () => { calls += 1; return termsResponse([]); } }),\n      /only be called from the server/,\n    );\n    assert.equal(calls, 0);\n  } finally {\n    if (originalWindow) Object.defineProperty(globalThis, \"window\", originalWindow);\n    else delete (globalThis as { window?: unknown }).window;\n  }\n});\n\ntest(\"fetches every term page and deduplicates IDs\", async () => {\n  const pages: number[] = [];\n  const terms = await loadPublicTerms(\"city\", {\n    fetch: async (input) => {\n      const page = Number(new URL(String(input)).searchParams.get(\"page\"));\n      pages.push(page);\n      return termsResponse(page === 1 ? [{ id: 1, name: \"تهران\", slug: \"tehran\", count: 1 }] : [{ id: 1, name: \"تهران\", slug: \"tehran\", count: 1 }, { id: 2, name: \"شیراز\", slug: \"shiraz\", count: 2 }], 2, 101);\n    },\n  });\n  assert.deepEqual(pages, [1, 2]);\n  assert.deepEqual(terms.map((term) => term.id), [1, 2]);\n});\n\ntest(\"allows the documented zero-page empty core taxonomy result only on its first page\", async () => {\n  const requestedUrls: string[] = [];\n  const terms = await loadPublicTerms(\"job_category\", {\n    fetch: async (input) => {\n      requestedUrls.push(String(input));\n      return termsResponse([], 0);\n    },\n  });\n\n  assert.deepEqual(terms, []);\n  assert.deepEqual(requestedUrls, [\n    \"https://codecraft.ir/kar/wp-json/wp/v2/job_category?per_page=100&page=1&_fields=id%2Cname%2Cslug%2Ccount%2Cparent\",\n  ]);\n});\n\ntest(\"rejects malformed or inconsistent core taxonomy pagination headers\", async () => {\n  const malformedResponses = [\n    new Response(\"[]\", { status: 200, headers: { \"X-WP-TotalPages\": \"0\", \"X-WP-Total\": \"not-a-number\" } }),\n    new Response(\"[]\", { status: 200, headers: { \"X-WP-TotalPages\": \"0\" } }),\n    termsResponse([{ id: 1, name: \"تهران\", slug: \"tehran\", count: 1 }], 0),\n    new Response(\"[]\", { status: 200, headers: { \"X-WP-TotalPages\": \"0\", \"X-WP-Total\": \"1\" } }),\n    new Response(\"[]\", { status: 200, headers: { \"X-WP-TotalPages\": \"1\", \"X-WP-Total\": \"0\" } }),\n  ];\n\n  for (const response of malformedResponses) {\n    await assert.rejects(\n      () => loadPublicTerms(\"city\", { fetch: async () => response.clone() }),\n      (error: unknown) => error instanceof WordPressApiError && error.status === 502 && error.code === \"invalid_public_contract\",\n    );\n  }\n});\n\ntest(\"uses fixed plain REST core taxonomy routes without accepting caller route overrides\", async () => {\n  const previousMode = environment.WORDPRESS_PERMALINK_MODE;\n  const urls: string[] = [];\n  environment.WORDPRESS_PERMALINK_MODE = \"plain\";\n  try {\n    await loadPublicTerms(\"city\", {\n      fetch: async (input) => {\n        urls.push(String(input));\n        return termsResponse([], 0);\n      },\n    });\n  } finally {\n    if (previousMode === undefined) delete environment.WORDPRESS_PERMALINK_MODE;\n    else environment.WORDPRESS_PERMALINK_MODE = previousMode;\n  }\n\n  assert.deepEqual(urls, [\n    \"https://codecraft.ir/kar/index.php?rest_route=%2Fwp%2Fv2%2Fcity&per_page=100&page=1&_fields=id%2Cname%2Cslug%2Ccount%2Cparent\",\n  ]);\n});\n\ntest(\"rejects nonallowlisted taxonomy and unsafe/malformed core responses\", async () => {\n  let calls = 0;\n  await assert.rejects(() => loadPublicTerms(\"users\" as never, { fetch: async () => { calls += 1; return termsResponse([]); } }));\n  assert.equal(calls, 0);\n  for (const response of [\n    new Response(\"[]\", { status: 200 }),\n    new Response(\"{}\", { status: 200, headers: { \"X-WP-TotalPages\": \"1\" } }),\n    termsResponse([{ id: 0, name: \"x\", slug: \"x\", count: 0 }]),\n    termsResponse([], 101),\n  ]) {\n    await assert.rejects(\n      () => loadPublicTerms(\"city\", { fetch: async () => response.clone() }),\n      (error: unknown) => error instanceof WordPressApiError && error.status === 502,\n    );\n  }\n});\n\ntest(\"maps core HTTP and invalid JSON failures without credentials\", async () => {\n  await assert.rejects(\n    () => loadPublicTerms(\"neighborhood\", { fetch: async () => new Response('{\"code\":\"rest_forbidden\"}', { status: 403 }) }),\n    (error: unknown) => error instanceof WordPressApiError && error.code === \"http_error\" && error.status === 403,\n  );\n  await assert.rejects(\n    () => loadPublicTerms(\"neighborhood\", { fetch: async () => new Response(\"not json\", { status: 200, headers: { \"X-WP-TotalPages\": \"1\" } }) }),\n    (error: unknown) => error instanceof WordPressApiError && error.code === \"invalid_json\",\n  );\n});\n\ntest(\"maps a timeout while reading a term body after headers\", async () => {\n  await assert.rejects(\n    () => loadPublicTerms(\"city\", {\n      timeoutMs: 10,\n      fetch: async (_input, init) => {\n        const signal = init?.signal;\n        assert.ok(signal instanceof AbortSignal);\n        return new Response(\n          new ReadableStream<Uint8Array>({\n            start(controller) {\n              signal.addEventListener(\"abort\", () => controller.error(signal.reason), { once: true });\n            },\n          }),\n          { status: 200, headers: { \"X-WP-TotalPages\": \"1\" } },\n        );\n      },\n    }),\n    (error: unknown) => error instanceof WordPressApiError && error.code === \"timeout\" && error.status === 408,\n  );\n});\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/services/wordpress/graphql-client.ts": {
      "sha256": "9b1e854375de26c27dc2db8f91f7fcf0fbacc298d5750afa325b27b4274a7aed",
      "text": "import {\n  assertWordPressServerOnly,\n  getWordPressGraphqlEndpoint,\n} from \"./config.ts\";\nimport {\n  isWordPressGraphqlResponse,\n  type WordPressGraphqlError,\n} from \"./contracts.ts\";\nimport { WordPressApiError } from \"./errors.ts\";\nimport {\n  DEFAULT_WORDPRESS_TIMEOUT_MS,\n  type WordPressFetch,\n  type WordPressRequestOptions,\n} from \"./rest-client.ts\";\n\nexport type WordPressGraphqlVariables = Record<string, unknown>;\n\nexport type WordPressGraphqlRequestOptions = Omit<\n  WordPressRequestOptions,\n  \"body\" | \"method\"\n>;\n\ntype WordPressResponseLike = Response & {\n  json?: () => Promise<unknown>;\n  text?: () => Promise<string>;\n};\n\nfunction invalidRequestError(code: string, message: string): WordPressApiError {\n  return new WordPressApiError({ status: 400, code, message });\n}\n\nfunction resolveToken(\n  options: WordPressGraphqlRequestOptions,\n): string | undefined {\n  const token =\n    options.token ??\n    options.accessToken ??\n    options.authToken ??\n    options.authorizationToken;\n\n  if (token === undefined || token === \"\") {\n    return undefined;\n  }\n\n  if (typeof token !== \"string\") {\n    throw invalidRequestError(\n      \"invalid_token\",\n      \"توکن احراز هویت باید یک رشته باشد.\",\n    );\n  }\n\n  return token;\n}\n\nfunction resolveTimeout(options: WordPressGraphqlRequestOptions): number {\n  if (options.timeoutMs === undefined) {\n    return DEFAULT_WORDPRESS_TIMEOUT_MS;\n  }\n\n  if (\n    typeof options.timeoutMs !== \"number\" ||\n    !Number.isFinite(options.timeoutMs) ||\n    options.timeoutMs <= 0\n  ) {\n    throw invalidRequestError(\n      \"invalid_timeout\",\n      \"مهلت درخواست باید یک عدد مثبت باشد.\",\n    );\n  }\n\n  return options.timeoutMs;\n}\n\nasync function readJson(response: WordPressResponseLike): Promise<unknown> {\n  if (typeof response.text === \"function\") {\n    const text = await response.text();\n    if (text.trim().length === 0) {\n      throw new SyntaxError(\"Empty JSON response\");\n    }\n    return JSON.parse(text) as unknown;\n  }\n\n  if (typeof response.json === \"function\") {\n    return response.json();\n  }\n\n  throw new SyntaxError(\"Response has no JSON body reader\");\n}\n\nfunction responseStatus(response: WordPressResponseLike): number {\n  return Number.isFinite(response.status) ? response.status : 0;\n}\n\nfunction isSuccessfulHttpResponse(response: WordPressResponseLike): boolean {\n  if (typeof response.ok === \"boolean\") {\n    return response.ok;\n  }\n\n  const status = responseStatus(response);\n  return status >= 200 && status < 300;\n}\n\nfunction getFetchImplementation(\n  options: WordPressGraphqlRequestOptions,\n): WordPressFetch {\n  const fetchImplementation = options.fetch ?? options.fetchImpl;\n  if (fetchImplementation) {\n    return fetchImplementation;\n  }\n\n  if (typeof globalThis.fetch === \"function\") {\n    return globalThis.fetch.bind(globalThis) as WordPressFetch;\n  }\n\n  throw new WordPressApiError({\n    status: 0,\n    code: \"fetch_unavailable\",\n    message: \"امکان ارسال درخواست وردپرس وجود ندارد.\",\n  });\n}\n\ninterface RequestSignal {\n  signal: AbortSignal;\n  didTimeout: () => boolean;\n  cleanup: () => void;\n}\n\nfunction createRequestSignal(\n  timeoutMs: number,\n  callerSignal: AbortSignal | undefined,\n): RequestSignal {\n  const controller = new AbortController();\n  let timedOut = false;\n\n  const timeoutId = setTimeout(() => {\n    timedOut = true;\n    controller.abort();\n  }, timeoutMs);\n\n  const onCallerAbort = () => controller.abort(callerSignal?.reason);\n  if (callerSignal) {\n    if (callerSignal.aborted) {\n      onCallerAbort();\n    } else {\n      callerSignal.addEventListener(\"abort\", onCallerAbort, { once: true });\n    }\n  }\n\n  return {\n    signal: controller.signal,\n    didTimeout: () => timedOut,\n    cleanup: () => {\n      clearTimeout(timeoutId);\n      callerSignal?.removeEventListener(\"abort\", onCallerAbort);\n    },\n  };\n}\n\nfunction graphqlErrorToApiError(\n  errors: WordPressGraphqlError[],\n  status: number,\n  token: string | undefined,\n): WordPressApiError {\n  const code = errors.find(\n    (error) =>\n      typeof error.extensions?.code === \"string\" &&\n      error.extensions.code.trim().length > 0,\n  )?.extensions?.code;\n  const message = errors.map((error) => error.message).join(\"؛ \");\n\n  return new WordPressApiError({\n    status,\n    code: typeof code === \"string\" ? code : \"graphql_error\",\n    message,\n    data: errors.length === 1 ? errors[0] : errors,\n    sensitiveValues: token ? [token] : [],\n  });\n}\n\nfunction httpError(status: number, token: string | undefined): WordPressApiError {\n  return new WordPressApiError({\n    status,\n    code: \"http_error\",\n    message: \"درخواست GraphQL وردپرس با خطا روبه‌رو شد.\",\n    sensitiveValues: token ? [token] : [],\n  });\n}\n\nfunction invalidJsonError(status: number, token: string | undefined): WordPressApiError {\n  return new WordPressApiError({\n    status,\n    code: \"invalid_json\",\n    message: \"پاسخ GraphQL وردپرس JSON معتبر نیست.\",\n    sensitiveValues: token ? [token] : [],\n  });\n}\n\nfunction invalidResponseError(\n  status: number,\n  token: string | undefined,\n): WordPressApiError {\n  return new WordPressApiError({\n    status,\n    code: \"invalid_graphql_response\",\n    message: \"ساختار پاسخ GraphQL وردپرس معتبر نیست.\",\n    sensitiveValues: token ? [token] : [],\n  });\n}\n\nfunction timeoutError(token: string | undefined): WordPressApiError {\n  return new WordPressApiError({\n    status: 408,\n    code: \"timeout\",\n    message: \"مهلت درخواست GraphQL وردپرس به پایان رسید.\",\n    sensitiveValues: token ? [token] : [],\n  });\n}\n\nfunction abortedError(token: string | undefined): WordPressApiError {\n  return new WordPressApiError({\n    status: 499,\n    code: \"aborted\",\n    message: \"درخواست GraphQL وردپرس لغو شد.\",\n    sensitiveValues: token ? [token] : [],\n  });\n}\n\nfunction networkError(token: string | undefined): WordPressApiError {\n  return new WordPressApiError({\n    status: 0,\n    code: \"network_error\",\n    message: \"ارتباط با وردپرس برقرار نشد.\",\n    sensitiveValues: token ? [token] : [],\n  });\n}\n\nexport async function wordpressGraphql<\n  TData = unknown,\n  TVariables extends WordPressGraphqlVariables = WordPressGraphqlVariables,\n>(\n  query: string,\n  variables: TVariables = {} as TVariables,\n  options: WordPressGraphqlRequestOptions = {},\n): Promise<TData> {\n  assertWordPressServerOnly();\n\n  if (typeof query !== \"string\" || query.trim().length === 0) {\n    throw invalidRequestError(\"invalid_query\", \"پرس‌وجوی GraphQL معتبر نیست.\");\n  }\n\n  if (\n    variables === null ||\n    typeof variables !== \"object\" ||\n    Array.isArray(variables)\n  ) {\n    throw invalidRequestError(\n      \"invalid_variables\",\n      \"متغیرهای GraphQL باید یک شیء باشند.\",\n    );\n  }\n\n  const token = resolveToken(options);\n  const timeoutMs = resolveTimeout(options);\n  const fetchImplementation = getFetchImplementation(options);\n  let body: string | undefined;\n  try {\n    body = JSON.stringify({ query, variables });\n  } catch {\n    throw invalidRequestError(\n      \"invalid_variables\",\n      \"بدنه GraphQL قابل پردازش نیست.\",\n    );\n  }\n\n  if (body === undefined) {\n    throw invalidRequestError(\n      \"invalid_variables\",\n      \"بدنه GraphQL قابل پردازش نیست.\",\n    );\n  }\n\n  const endpoint = getWordPressGraphqlEndpoint();\n\n  const headers: Record<string, string> = {\n    Accept: \"application/json\",\n    \"Content-Type\": \"application/json\",\n  };\n  if (token) {\n    headers.Authorization = `Bearer ${token}`;\n  }\n\n  const requestSignal = createRequestSignal(timeoutMs, options.signal);\n  const init: RequestInit = {\n    method: \"POST\",\n    headers,\n    body,\n    cache: \"no-store\",\n    signal: requestSignal.signal,\n  };\n\n  try {\n    const response = (await fetchImplementation(endpoint, init)) as WordPressResponseLike;\n    const status = responseStatus(response);\n    let payload: unknown;\n\n    try {\n      payload = await readJson(response);\n    } catch (error) {\n      // Body consumption can reject after headers when the request is aborted.\n      // Preserve that cause for the shared cancellation mapping below.\n      if (requestSignal.signal.aborted) {\n        throw error;\n      }\n      throw invalidJsonError(status, token);\n    }\n\n    if (!isSuccessfulHttpResponse(response)) {\n      if (isWordPressGraphqlResponse(payload) && payload.errors?.length) {\n        throw graphqlErrorToApiError(payload.errors, status, token);\n      }\n      throw httpError(status, token);\n    }\n\n    if (!isWordPressGraphqlResponse<TData>(payload)) {\n      throw invalidResponseError(status, token);\n    }\n\n    if (payload.errors && payload.errors.length > 0) {\n      throw graphqlErrorToApiError(payload.errors, status, token);\n    }\n\n    if (!(\"data\" in payload)) {\n      throw invalidResponseError(status, token);\n    }\n\n    return payload.data as TData;\n  } catch (error) {\n    if (requestSignal.didTimeout()) {\n      throw timeoutError(token);\n    }\n\n    if (options.signal?.aborted) {\n      throw abortedError(token);\n    }\n\n    if (error instanceof WordPressApiError) {\n      throw error;\n    }\n\n    throw networkError(token);\n  } finally {\n    requestSignal.cleanup();\n  }\n}\n\nexport const requestWordPressGraphql = wordpressGraphql;\nexport const wordpressGraphQL = wordpressGraphql;\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/services/wordpress/config.ts": {
      "sha256": "b88589cfaa6c611543808296e914dab492a252f92ed6a3f93ffc372361435f11",
      "text": "export const WORDPRESS_URL_ENV = \"WORDPRESS_URL\" as const;\nexport const WORDPRESS_PERMALINK_MODE_ENV = \"WORDPRESS_PERMALINK_MODE\" as const;\nexport const WORDPRESS_REST_NAMESPACE = \"nahan/v1\" as const;\n\nexport type WordPressPermalinkMode = \"pretty\" | \"plain\";\n\nexport interface WordPressConfig {\n  origin: string;\n  restBaseUrl: string;\n  graphqlEndpoint: string;\n}\n\nfunction readWordPressUrl(): string {\n  const configuredUrl =\n    typeof process !== \"undefined\" ? process.env[WORDPRESS_URL_ENV] : undefined;\n\n  if (!configuredUrl || configuredUrl.trim().length === 0) {\n    throw new Error(\"WORDPRESS_URL is required for the server-side WordPress client.\");\n  }\n\n  return configuredUrl;\n}\n\n/**\n * The absence of the server-only setting retains the established pretty URL\n * behavior. Any present value must be an exact supported mode; probing and\n * fallback would make the selected deployment behavior ambiguous.\n */\nexport function getWordPressPermalinkMode(): WordPressPermalinkMode {\n  const configuredMode =\n    typeof process !== \"undefined\"\n      ? process.env[WORDPRESS_PERMALINK_MODE_ENV]\n      : undefined;\n\n  if (configuredMode === undefined) {\n    return \"pretty\";\n  }\n\n  if (configuredMode === \"pretty\" || configuredMode === \"plain\") {\n    return configuredMode;\n  }\n\n  throw new Error(\"WORDPRESS_PERMALINK_MODE must be either pretty or plain.\");\n}\n\nfunction isProduction(): boolean {\n  return typeof process !== \"undefined\" && process.env.NODE_ENV === \"production\";\n}\n\n/**\n * Normalize only the origin configured for WordPress. The pathname is part of\n * the origin for this deployment, so it must be retained (for example, /kar).\n */\nexport function normalizeWordPressOrigin(configuredUrl = readWordPressUrl()): string {\n  if (typeof configuredUrl !== \"string\" || configuredUrl.trim().length === 0) {\n    throw new Error(\"WORDPRESS_URL must be a non-empty absolute URL.\");\n  }\n\n  let parsedUrl: URL;\n  try {\n    parsedUrl = new URL(configuredUrl.trim());\n  } catch {\n    throw new Error(\"WORDPRESS_URL must be a valid absolute URL.\");\n  }\n\n  if (parsedUrl.protocol !== \"http:\" && parsedUrl.protocol !== \"https:\") {\n    throw new Error(\"WORDPRESS_URL must use the http or https protocol.\");\n  }\n\n  if (isProduction() && parsedUrl.protocol !== \"https:\") {\n    throw new Error(\"WORDPRESS_URL must use HTTPS in production.\");\n  }\n\n  if (\n    parsedUrl.origin === \"null\" ||\n    parsedUrl.hostname.length === 0 ||\n    parsedUrl.username.length > 0 ||\n    parsedUrl.password.length > 0 ||\n    parsedUrl.search.length > 0 ||\n    parsedUrl.hash.length > 0\n  ) {\n    throw new Error(\n      \"WORDPRESS_URL must contain only a scheme, host, port, and pathname.\",\n    );\n  }\n\n  const pathname = parsedUrl.pathname.replace(/\\/+$/, \"\");\n  return `${parsedUrl.origin}${pathname}`;\n}\n\nexport function getWordPressOrigin(configuredUrl?: string): string {\n  return normalizeWordPressOrigin(configuredUrl);\n}\n\nexport function getWordPressRestBaseUrl(configuredUrl?: string): string {\n  const origin = getWordPressOrigin(configuredUrl);\n  if (getWordPressPermalinkMode() === \"pretty\") {\n    return `${origin}/wp-json/${WORDPRESS_REST_NAMESPACE}/`;\n  }\n\n  const endpoint = new URL(`${origin}/index.php`);\n  endpoint.searchParams.set(\"rest_route\", `/${WORDPRESS_REST_NAMESPACE}/`);\n  return endpoint.toString();\n}\n\nexport function getWordPressGraphqlEndpoint(configuredUrl?: string): string {\n  const origin = getWordPressOrigin(configuredUrl);\n  return getWordPressPermalinkMode() === \"pretty\"\n    ? `${origin}/graphql`\n    : `${origin}/index.php?graphql`;\n}\n\nexport function getWordPressConfig(configuredUrl?: string): WordPressConfig {\n  return {\n    origin: getWordPressOrigin(configuredUrl),\n    restBaseUrl: getWordPressRestBaseUrl(configuredUrl),\n    graphqlEndpoint: getWordPressGraphqlEndpoint(configuredUrl),\n  };\n}\n\n/**\n * Isolated replacement point for the server-only package once it can be\n * installed. Transport entry points call this before touching credentials.\n */\nexport function assertWordPressServerOnly(): void {\n  if (typeof window !== \"undefined\") {\n    throw new Error(\"The WordPress client can only be called from the server.\");\n  }\n}\n\n// Friendly aliases for internal callers that prefer shorter URL names.\nexport const normalizeWordPressUrl = normalizeWordPressOrigin;\nexport const getWordPressRestUrl = getWordPressRestBaseUrl;\nexport const getWordPressGraphqlUrl = getWordPressGraphqlEndpoint;\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/services/wordpress/client.test.ts": {
      "sha256": "86ad6e96913cdda07b6246cac22de722d9b34b278d20485f193bf150abeda307",
      "text": "import assert from \"node:assert/strict\";\nimport { after, before, test } from \"node:test\";\nimport {\n  getWordPressGraphqlEndpoint,\n  getWordPressRestBaseUrl,\n} from \"./config.ts\";\nimport { WordPressApiError } from \"./errors.ts\";\nimport { wordpressGraphql } from \"./graphql-client.ts\";\nimport {\n  wordpressRest,\n  type WordPressFetch,\n  type WordPressRequestOptions,\n} from \"./rest-client.ts\";\n\nconst environment = process.env as Record<string, string | undefined>;\nconst TEST_WORDPRESS_URL = \"https://codecraft.ir/kar/\";\nconst originalWordPressUrl = environment.WORDPRESS_URL;\nconst originalNodeEnv = environment.NODE_ENV;\n\nbefore(() => {\n  process.env.WORDPRESS_URL = TEST_WORDPRESS_URL;\n  environment.NODE_ENV = \"test\";\n});\n\nafter(() => {\n  if (originalWordPressUrl === undefined) {\n    delete process.env.WORDPRESS_URL;\n  } else {\n    process.env.WORDPRESS_URL = originalWordPressUrl;\n  }\n\n  if (originalNodeEnv === undefined) {\n    delete environment.NODE_ENV;\n  } else {\n    environment.NODE_ENV = originalNodeEnv;\n  }\n});\n\nfunction jsonResponse(payload: unknown, status = 200): Response {\n  return new Response(JSON.stringify(payload), {\n    status,\n    headers: { \"content-type\": \"application/json\" },\n  });\n}\n\nfunction responseHeaders(init: RequestInit | undefined): Headers {\n  return new Headers(init?.headers);\n}\n\ntest(\"extracts REST success data and applies the server request contract\", async () => {\n  let requestedUrl: RequestInfo | URL | undefined;\n  let requestedInit: RequestInit | undefined;\n\n  const data = await wordpressRest<{ id: number }>(\"specialists?published=1\", {\n    fetch: async (input, init) => {\n      requestedUrl = input;\n      requestedInit = init;\n      return jsonResponse({ success: true, data: { id: 42 } });\n    },\n  });\n\n  assert.deepEqual(data, { id: 42 });\n  assert.equal(\n    requestedUrl,\n    `${getWordPressRestBaseUrl(TEST_WORDPRESS_URL)}specialists?published=1`,\n  );\n  assert.equal(requestedInit?.method, \"GET\");\n  assert.equal(responseHeaders(requestedInit).get(\"accept\"), \"application/json\");\n  assert.equal(responseHeaders(requestedInit).has(\"content-type\"), false);\n  assert.equal(requestedInit?.cache, \"no-store\");\n  assert.ok(requestedInit?.signal instanceof AbortSignal);\n});\n\ntest(\"sends JSON and a caller-supplied bearer token without exposing it elsewhere\", async () => {\n  let requestedInit: RequestInit | undefined;\n  const token = \"secret-bearer-token\";\n\n  const data = await wordpressRest<{ ok: boolean }, { title: string }>(\"projects\", {\n    method: \"POST\",\n    body: { title: \"خانه\" },\n    token,\n    fetch: async (_input, init) => {\n      requestedInit = init;\n      return jsonResponse({ success: true, data: { ok: true } });\n    },\n  });\n\n  assert.deepEqual(data, { ok: true });\n  const headers = responseHeaders(requestedInit);\n  assert.equal(headers.get(\"authorization\"), `Bearer ${token}`);\n  assert.equal(headers.get(\"content-type\"), \"application/json\");\n  assert.equal(requestedInit?.body, JSON.stringify({ title: \"خانه\" }));\n});\n\ntest(\"maps REST plugin and HTTP errors without leaking a bearer token\", async () => {\n  const token = \"do-not-leak-this-token\";\n\n  await assert.rejects(\n    () =>\n      wordpressRest(\"private\", {\n        token,\n        fetch: async () =>\n          jsonResponse(\n            {\n              success: false,\n              error: {\n                code: \"forbidden\",\n                message: `توکن ${token} معتبر نیست.`,\n                data: { authorization: token, safe: \"جزئیات عمومی\" },\n              },\n            },\n            403,\n          ),\n      }),\n    (error: unknown) => {\n      assert.ok(error instanceof WordPressApiError);\n      assert.equal(error.status, 403);\n      assert.equal(error.code, \"forbidden\");\n      assert.equal(error.message.includes(token), false);\n      assert.equal(JSON.stringify(error).includes(token), false);\n      assert.deepEqual(error.data, { safe: \"جزئیات عمومی\" });\n      return true;\n    },\n  );\n\n  await assert.rejects(\n    () =>\n      wordpressRest(\"private\", {\n        token,\n        fetch: async () => jsonResponse({ message: token }, 502),\n      }),\n    (error: unknown) => {\n      assert.ok(error instanceof WordPressApiError);\n      assert.equal(error.status, 502);\n      assert.equal(error.code, \"http_error\");\n      assert.equal(error.message.includes(token), false);\n      assert.equal(JSON.stringify(error).includes(token), false);\n      return true;\n    },\n  );\n});\n\ntest(\"rejects absolute and traversal REST paths before making a request\", async () => {\n  let calls = 0;\n  const fetch = async () => {\n    calls += 1;\n    return jsonResponse({ success: true, data: null });\n  };\n\n  for (const path of [\"https://evil.example/\", \"//evil.example/\", \"../users\", \"%2e%2e/users\"]) {\n    await assert.rejects(\n      () => wordpressRest(path, { fetch }),\n      (error: unknown) => {\n        assert.ok(error instanceof WordPressApiError);\n        assert.equal(error.code, \"invalid_path\");\n        return true;\n      },\n    );\n  }\n\n  assert.equal(calls, 0);\n});\n\ntest(\"maps invalid JSON and invalid success envelopes\", async () => {\n  await assert.rejects(\n    () =>\n      wordpressRest(\"broken\", {\n        fetch: async () => new Response(\"not-json\", { status: 200 }),\n      }),\n    (error: unknown) => {\n      assert.ok(error instanceof WordPressApiError);\n      assert.equal(error.status, 200);\n      assert.equal(error.code, \"invalid_json\");\n      return true;\n    },\n  );\n\n  await assert.rejects(\n    () =>\n      wordpressRest(\"broken\", {\n        fetch: async () => jsonResponse({ success: true, result: \"wrong-key\" }),\n      }),\n    (error: unknown) => {\n      assert.ok(error instanceof WordPressApiError);\n      assert.equal(error.code, \"invalid_envelope\");\n      return true;\n    },\n  );\n});\n\ntest(\"aborts and maps a timed-out REST request\", async () => {\n  let observedAbort = false;\n\n  await assert.rejects(\n    () =>\n      wordpressRest(\"slow\", {\n        timeoutMs: 10,\n        fetch: (_input, init) =>\n          new Promise<Response>((_resolve, reject) => {\n            const signal = init?.signal;\n            assert.ok(signal);\n            signal.addEventListener(\n              \"abort\",\n              () => {\n                observedAbort = true;\n                reject(signal.reason ?? new Error(\"aborted\"));\n              },\n              { once: true },\n            );\n          }),\n      }),\n    (error: unknown) => {\n      assert.ok(error instanceof WordPressApiError);\n      assert.equal(error.status, 408);\n      assert.equal(error.code, \"timeout\");\n      return true;\n    },\n  );\n\n  assert.equal(observedAbort, true);\n});\n\ntest(\"uses the fixed plain REST and GraphQL endpoints while preserving route-override rejection\", async () => {\n  const previousMode = environment.WORDPRESS_PERMALINK_MODE;\n  environment.WORDPRESS_PERMALINK_MODE = \"plain\";\n  try {\n    let restUrl: RequestInfo | URL | undefined;\n    await wordpressRest(\"specialists?per_page=1\", {\n      fetch: async (input) => {\n        restUrl = input;\n        return jsonResponse({ success: true, data: [] });\n      },\n    });\n    assert.equal(\n      restUrl,\n      \"https://codecraft.ir/kar/index.php?rest_route=%2Fnahan%2Fv1%2Fspecialists&per_page=1\",\n    );\n\n    let graphqlUrl: RequestInfo | URL | undefined;\n    await wordpressGraphql(\"query Type { __typename }\", {}, {\n      fetch: async (input, init) => {\n        graphqlUrl = input;\n        assert.equal(init?.method, \"POST\");\n        assert.equal(init?.body, JSON.stringify({ query: \"query Type { __typename }\", variables: {} }));\n        return jsonResponse({ data: { __typename: \"RootQuery\" } });\n      },\n    });\n    assert.equal(graphqlUrl, \"https://codecraft.ir/kar/index.php?graphql\");\n\n    let fetchCalls = 0;\n    await assert.rejects(\n      () => wordpressRest(\"specialists?rest_route=%2Fwp%2Fv2%2Fusers\", {\n        fetch: async () => {\n          fetchCalls += 1;\n          return jsonResponse({ success: true, data: [] });\n        },\n      }),\n      (error: unknown) => error instanceof WordPressApiError && error.code === \"invalid_path\",\n    );\n    assert.equal(fetchCalls, 0);\n  } finally {\n    if (previousMode === undefined) delete environment.WORDPRESS_PERMALINK_MODE;\n    else environment.WORDPRESS_PERMALINK_MODE = previousMode;\n  }\n});\n\ntest(\"maps GraphQL errors and extracts successful data\", async () => {\n  const token = \"graphql-secret-token\";\n  let requestedUrl: RequestInfo | URL | undefined;\n  let requestBody: { query: string; variables: Record<string, unknown> } | undefined;\n\n  await assert.rejects(\n    () =>\n      wordpressGraphql(\n        \"query Viewer { viewer { id } }\",\n        { includePrivate: true },\n        {\n          token,\n          fetch: async (input, init) => {\n            requestedUrl = input;\n            requestBody = JSON.parse(String(init?.body)) as typeof requestBody;\n            return jsonResponse({\n              errors: [\n                {\n                  message: `توکن ${token} اجازه ندارد`,\n                  extensions: { code: \"FORBIDDEN\" },\n                },\n              ],\n            });\n          },\n        },\n      ),\n    (error: unknown) => {\n      assert.ok(error instanceof WordPressApiError);\n      assert.equal(error.status, 200);\n      assert.equal(error.code, \"FORBIDDEN\");\n      assert.equal(error.message.includes(token), false);\n      assert.equal(JSON.stringify(error).includes(token), false);\n      return true;\n    },\n  );\n\n  assert.equal(requestedUrl, getWordPressGraphqlEndpoint(TEST_WORDPRESS_URL));\n  assert.deepEqual(requestBody, {\n    query: \"query Viewer { viewer { id } }\",\n    variables: { includePrivate: true },\n  });\n\n  const data = await wordpressGraphql<{ viewer: { id: string } }>(\n    \"query Viewer { viewer { id } }\",\n    {},\n    {\n      fetch: async (_input, init) => {\n        assert.equal(responseHeaders(init).get(\"accept\"), \"application/json\");\n        assert.equal(responseHeaders(init).get(\"content-type\"), \"application/json\");\n        assert.equal(init?.cache, \"no-store\");\n        return jsonResponse({ data: { viewer: { id: \"42\" } } });\n      },\n    },\n  );\n\n  assert.deepEqual(data, { viewer: { id: \"42\" } });\n});\n\n// Headers resolve immediately, but the real Response body stays unreadable until\n// the transport's signal aborts. The callback fires once text() is pending.\nfunction pendingBodyFetch(onTextRead: () => void): WordPressFetch {\n  return async (_input, init) => {\n    const signal = init?.signal;\n    assert.ok(signal);\n\n    const response = new Response(\n      new ReadableStream<Uint8Array>({\n        start(controller) {\n          signal.addEventListener(\"abort\", () => controller.error(signal.reason), {\n            once: true,\n          });\n        },\n      }),\n      { status: 200, headers: { \"content-type\": \"application/json\" } },\n    );\n    const readText = response.text.bind(response);\n    response.text = () => {\n      const pendingText = readText();\n      onTextRead();\n      return pendingText;\n    };\n    return response;\n  };\n}\n\nconst knownKeyCredential = \"R1_8nY6qW4xP2vZ\";\nconst keyLeakCases = [\n  {\n    name: \"known credential\",\n    key: `diagnostic-${knownKeyCredential}-detail`,\n    forbidden: knownKeyCredential,\n  },\n  {\n    name: \"bearer credential\",\n    key: \"Bearer b9Qv4Xp8Lm2\",\n    forbidden: \"b9Qv4Xp8Lm2\",\n  },\n  {\n    name: \"JWT\",\n    key: \"eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiI0MiJ9.c2lnbmF0dXJl\",\n    forbidden: \"eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiI0MiJ9.c2lnbmF0dXJl\",\n  },\n];\n\nfor (const transport of [\"REST\", \"GraphQL\"] as const) {\n  const request = (options: WordPressRequestOptions): Promise<unknown> =>\n    transport === \"REST\"\n      ? wordpressRest(\"private\", options)\n      : wordpressGraphql(\"query Viewer { viewer { id } }\", {}, options);\n\n  test(`round-1: ${transport} classifies timeout during a pending response.text()`, {\n    timeout: 2_000,\n  }, async () => {\n    let textReadStarted = false;\n\n    await assert.rejects(\n      () => request({\n        timeoutMs: 20,\n        fetch: pendingBodyFetch(() => { textReadStarted = true; }),\n      }),\n      (error: unknown) => {\n        assert.ok(error instanceof WordPressApiError);\n        assert.equal(error.code, \"timeout\");\n        assert.equal(error.status, 408);\n        return true;\n      },\n    );\n\n    assert.equal(textReadStarted, true);\n  });\n\n  test(`round-1: ${transport} classifies caller abort during a pending response.text()`, {\n    timeout: 2_000,\n  }, async () => {\n    const caller = new AbortController();\n    let notifyTextRead!: () => void;\n    const textReadStarted = new Promise<void>((resolve) => {\n      notifyTextRead = resolve;\n    });\n    const rejectedRequest = assert.rejects(\n      () => request({\n        signal: caller.signal,\n        timeoutMs: 1_000,\n        fetch: pendingBodyFetch(notifyTextRead),\n      }),\n      (error: unknown) => {\n        assert.ok(error instanceof WordPressApiError);\n        assert.equal(error.code, \"aborted\");\n        assert.equal(error.status, 499);\n        return true;\n      },\n    );\n\n    await textReadStarted;\n    caller.abort(new DOMException(\"Caller cancelled\", \"AbortError\"));\n    await rejectedRequest;\n  });\n\n  for (const { name, key, forbidden } of keyLeakCases) {\n    test(`round-1: ${transport} excludes nested ${name} error keys from serialized errors`, async () => {\n      const details = {\n        [key]: \"private diagnostic\",\n        nested: [{ details: { [key]: \"private diagnostic\", safe: \"kept\" } }],\n        safe: \"kept\",\n      };\n      const payload = transport === \"REST\"\n        ? {\n            success: false,\n            error: { code: \"forbidden\", message: \"دسترسی مجاز نیست.\", data: details },\n          }\n        : {\n            errors: [{\n              message: \"دسترسی مجاز نیست.\",\n              extensions: { code: \"FORBIDDEN\", ...details },\n            }],\n          };\n\n      await assert.rejects(\n        () => request({\n          token: knownKeyCredential,\n          fetch: async () => jsonResponse(payload, 403),\n        }),\n        (error: unknown) => {\n          assert.ok(error instanceof WordPressApiError);\n          assert.equal(error.status, 403);\n          const serialized = JSON.stringify(error);\n          assert.equal(serialized.includes(forbidden), false);\n          assert.match(serialized, /\"safe\":\"kept\"/);\n          return true;\n        },\n      );\n    });\n  }\n}\n\ntest(\"round-1: rejects PHP-normalized rest_route query keys before fetch\", async (context) => {\n  const reservedKeys = [\n    \"rest_route\",\n    \"%72est%5Froute\",\n    \"rest.route\",\n    \"rest%2Eroute\",\n    \"rest+route\",\n    \"rest%20route\",\n    \"+rest_route\",\n    \"%20%20rest.route\",\n    \"rest_route[]\",\n    \"rest_route[override]\",\n    \"rest_route%5B%5D\",\n    \"rest%20route%5Bvalue%5D\",\n    \"rest[route\",\n    \"rest%5Broute\",\n    \"rest_route%00ignored\",\n    \"rest.route%00suffix\",\n    \"%20rest%2eroute%00suffix\",\n    \"rest_route%00%5Bignored%5D\",\n  ];\n\n  for (const key of reservedKeys) {\n    await context.test(key, async () => {\n      let fetchCalls = 0;\n\n      await assert.rejects(\n        () => wordpressRest(`specialists?page=1&${key}=%2Fwp%2Fv2%2Fusers`, {\n          fetch: async () => {\n            fetchCalls += 1;\n            return jsonResponse({ success: true, data: [] });\n          },\n        }),\n        (error: unknown) => {\n          assert.ok(error instanceof WordPressApiError);\n          assert.equal(error.status, 400);\n          assert.equal(error.code, \"invalid_path\");\n          return true;\n        },\n      );\n\n      assert.equal(fetchCalls, 0);\n    });\n  }\n});\n\ntest(\"round-1: preserves ordinary REST filter and pagination queries\", async () => {\n  let requestedUrl: RequestInfo | URL | undefined;\n  const data = await wordpressRest<{ id: number }[]>(\n    \"specialists?page=2&per_page=12&filter%5Bverified%5D=1&filter%5Brest_route%5D=visible&search=rest_route&rest_route_hint=allowed\",\n    {\n      fetch: async (input) => {\n        requestedUrl = input;\n        return jsonResponse({ success: true, data: [{ id: 42 }] });\n      },\n    },\n  );\n\n  assert.deepEqual(data, [{ id: 42 }]);\n  assert.equal(\n    requestedUrl,\n    \"https://codecraft.ir/kar/wp-json/nahan/v1/specialists?page=2&per_page=12&filter%5Bverified%5D=1&filter%5Brest_route%5D=visible&search=rest_route&rest_route_hint=allowed\",\n  );\n});\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/services/wordpress/url.test.ts": {
      "sha256": "5823c3284c1759e8b689973f38e4f0a56a2b6032adcc46b42e7c5f609e24f1cd",
      "text": "import assert from \"node:assert/strict\";\nimport { after, before, test } from \"node:test\";\nimport {\n  getWordPressConfig,\n  getWordPressGraphqlEndpoint,\n  getWordPressOrigin,\n  getWordPressPermalinkMode,\n  getWordPressRestBaseUrl,\n  normalizeWordPressOrigin,\n} from \"./config.ts\";\n\nconst environment = process.env as Record<string, string | undefined>;\nconst originalWordPressUrl = environment.WORDPRESS_URL;\nconst originalPermalinkMode = environment.WORDPRESS_PERMALINK_MODE;\nconst originalNodeEnv = environment.NODE_ENV;\n\nbefore(() => {\n  process.env.WORDPRESS_URL = \"https://codecraft.ir/kar/\";\n});\n\nafter(() => {\n  if (originalWordPressUrl === undefined) {\n    delete process.env.WORDPRESS_URL;\n  } else {\n    process.env.WORDPRESS_URL = originalWordPressUrl;\n  }\n\n  if (originalPermalinkMode === undefined) {\n    delete environment.WORDPRESS_PERMALINK_MODE;\n  } else {\n    environment.WORDPRESS_PERMALINK_MODE = originalPermalinkMode;\n  }\n\n  if (originalNodeEnv === undefined) {\n    delete environment.NODE_ENV;\n  } else {\n    environment.NODE_ENV = originalNodeEnv;\n  }\n});\n\ntest(\"normalizes /kar/ and builds the exact WordPress endpoints\", () => {\n  const configuredUrl = \" https://codecraft.ir/kar/ \";\n\n  assert.equal(\n    normalizeWordPressOrigin(configuredUrl),\n    \"https://codecraft.ir/kar\",\n  );\n  assert.equal(\n    getWordPressRestBaseUrl(configuredUrl),\n    \"https://codecraft.ir/kar/wp-json/nahan/v1/\",\n  );\n  assert.equal(\n    getWordPressGraphqlEndpoint(configuredUrl),\n    \"https://codecraft.ir/kar/graphql\",\n  );\n  assert.deepEqual(getWordPressConfig(configuredUrl), {\n    origin: \"https://codecraft.ir/kar\",\n    restBaseUrl: \"https://codecraft.ir/kar/wp-json/nahan/v1/\",\n    graphqlEndpoint: \"https://codecraft.ir/kar/graphql\",\n  });\n});\n\ntest(\"uses pretty permalinks by default and only accepts exact configured modes\", () => {\n  delete environment.WORDPRESS_PERMALINK_MODE;\n  assert.equal(getWordPressPermalinkMode(), \"pretty\");\n\n  environment.WORDPRESS_PERMALINK_MODE = \"plain\";\n  assert.equal(getWordPressPermalinkMode(), \"plain\");\n  assert.equal(\n    getWordPressRestBaseUrl(\"https://codecraft.ir/kar/\"),\n    \"https://codecraft.ir/kar/index.php?rest_route=%2Fnahan%2Fv1%2F\",\n  );\n  assert.equal(\n    getWordPressGraphqlEndpoint(\"https://codecraft.ir/kar/\"),\n    \"https://codecraft.ir/kar/index.php?graphql\",\n  );\n\n  for (const unsupportedMode of [\"\", \"pretty \", \"PRETTY\", \"rewrite\"]) {\n    environment.WORDPRESS_PERMALINK_MODE = unsupportedMode;\n    assert.throws(() => getWordPressPermalinkMode(), /WORDPRESS_PERMALINK_MODE/);\n  }\n\n  delete environment.WORDPRESS_PERMALINK_MODE;\n});\n\ntest(\"reads the server-only WORDPRESS_URL without a live fallback\", () => {\n  assert.equal(getWordPressOrigin(), \"https://codecraft.ir/kar\");\n\n  const previous = environment.WORDPRESS_URL;\n  delete environment.WORDPRESS_URL;\n  try {\n    assert.throws(\n      () => getWordPressOrigin(),\n      /WORDPRESS_URL is required/,\n    );\n  } finally {\n    if (previous === undefined) {\n      delete environment.WORDPRESS_URL;\n    } else {\n      environment.WORDPRESS_URL = previous;\n    }\n  }\n});\n\ntest(\"rejects malformed or unsafe configured URLs\", () => {\n  const malformedUrls = [\n    \"\",\n    \"not-a-url\",\n    \"/kar\",\n    \"ftp://codecraft.ir/kar\",\n    \"https://user:password@codecraft.ir/kar\",\n    \"https://codecraft.ir/kar?token=secret\",\n    \"https://codecraft.ir/kar#fragment\",\n  ];\n\n  for (const malformedUrl of malformedUrls) {\n    assert.throws(() => normalizeWordPressOrigin(malformedUrl), malformedUrl);\n  }\n});\n\ntest(\"rejects an HTTP origin in production while allowing it outside production\", () => {\n  environment.NODE_ENV = \"production\";\n  assert.throws(\n    () => normalizeWordPressOrigin(\"http://localhost:8080/kar/\"),\n    /HTTPS in production/,\n  );\n\n  environment.NODE_ENV = \"test\";\n  assert.equal(\n    normalizeWordPressOrigin(\"http://localhost:8080/kar/\"),\n    \"http://localhost:8080/kar\",\n  );\n});\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/services/auth/wordpress-auth.ts": {
      "sha256": "431157e6311dddba785079d3a6cc800c2d0e9fd06aadcca55846cf620a28f959",
      "text": "import {\n  AuthValidationError,\n  normalizeIranianPhone,\n  normalizeOtpCode,\n} from \"../../lib/auth-policy.ts\";\nimport type { RegistrationRole } from \"../../lib/contracts/auth.ts\";\nimport { assertWordPressServerOnly } from \"../wordpress/config.ts\";\nimport { WordPressApiError } from \"../wordpress/errors.ts\";\nimport type { WordPressRequestOptions } from \"../wordpress/rest-client.ts\";\nimport {\n  AuthResponseError,\n  parseUpstreamLocalStatus,\n  parseUpstreamLogoutResult,\n  parseUpstreamMeUser,\n  parseUpstreamOtpChallenge,\n  parseUpstreamRefreshResult,\n  parseUpstreamVerifyResult,\n  type UpstreamLocalStatus,\n  type UpstreamLogoutResult,\n  type UpstreamMeUser,\n  type UpstreamOtpChallenge,\n  type UpstreamRefreshResult,\n  type UpstreamVerifyResult,\n} from \"./contracts.ts\";\n\nexport type WordPressAuthRequest = (\n  path: string,\n  options?: WordPressRequestOptions,\n) => Promise<unknown>;\n\nexport interface StoredOtpChallengeContext {\n  /**\n   * Derived only from the server-stored requestOtp response. Never accept this\n   * value from browser JSON, form state, or any client-controlled flag.\n   */\n  expectedCodeLength: 5 | 6;\n}\n\nexport interface WordPressAuthGateway {\n  requestOtp(phone: string): Promise<UpstreamOtpChallenge>;\n  verifyOtp(\n    input: {\n      trackingCode: string;\n      code: string;\n      role: RegistrationRole;\n      deviceId?: string;\n    },\n    storedChallenge?: StoredOtpChallengeContext,\n  ): Promise<UpstreamVerifyResult>;\n  refresh(refreshToken: string): Promise<UpstreamRefreshResult>;\n  me(accessToken: string): Promise<UpstreamMeUser>;\n  localStatus(): Promise<UpstreamLocalStatus>;\n  logoutRefresh(refreshToken: string): Promise<UpstreamLogoutResult>;\n  logout(accessToken: string, refreshToken: string): Promise<UpstreamLogoutResult>;\n}\n\nconst pluginErrors = {\n  invalid_phone: { status: 422, message: \"شماره موبایل معتبر نیست.\" },\n  otp_rate_limited: { status: 429, message: \"تعداد درخواست‌های این شماره زیاد است. کمی صبر کنید.\" },\n  otp_rate_limited_ip: { status: 429, message: \"تعداد درخواست‌های این اتصال زیاد است. کمی صبر کنید.\" },\n  otp_throttled: { status: 429, message: \"برای درخواست دوباره کد، کمی صبر کنید.\" },\n  otp_not_found: { status: 404, message: \"درخواست تأیید یافت نشد. کد تازه درخواست کنید.\" },\n  otp_consumed: { status: 410, message: \"این کد قبلاً استفاده شده است. کد تازه درخواست کنید.\" },\n  otp_expired: { status: 410, message: \"کد تأیید منقضی شده است. کد تازه درخواست کنید.\" },\n  otp_invalid: { status: 422, message: \"کد تأیید معتبر نیست.\" },\n  otp_too_many_attempts: { status: 429, message: \"تعداد تلاش‌های تأیید بیش از حد مجاز است.\" },\n  invalid_refresh: { status: 401, message: \"اعتبار ورود معتبر نیست. دوباره وارد شوید.\" },\n  revoked_refresh: { status: 401, message: \"اعتبار ورود لغو شده است. دوباره وارد شوید.\" },\n  expired_refresh: { status: 401, message: \"اعتبار ورود منقضی شده است. دوباره وارد شوید.\" },\n  unauthenticated: { status: 401, message: \"برای ادامه، وارد حساب شوید.\" },\n} as const;\n\nconst errorPresentations = {\n  ...pluginErrors,\n  invalid_request: { status: 422, message: \"اطلاعات درخواست تأیید معتبر نیست.\" },\n  invalid_tracking_code: { status: 422, message: \"شناسه درخواست تأیید معتبر نیست.\" },\n  invalid_role: { status: 422, message: \"نقش ثبت‌نام معتبر نیست.\" },\n  invalid_device_id: { status: 422, message: \"شناسه دستگاه معتبر نیست.\" },\n  invalid_credentials: { status: 422, message: \"اطلاعات احراز هویت معتبر نیست.\" },\n  invalid_response: { status: 502, message: \"پاسخ سرویس احراز هویت معتبر نیست.\" },\n  network_error: { status: 503, message: \"ارتباط با سرویس احراز هویت برقرار نشد. دوباره تلاش کنید.\" },\n  auth_unavailable: { status: 502, message: \"سرویس احراز هویت در دسترس نیست. دوباره تلاش کنید.\" },\n  server_only: { status: 500, message: \"این عملیات فقط در سرور مجاز است.\" },\n} as const;\n\nexport type AuthGatewayErrorCode = keyof typeof errorPresentations;\n\nexport class AuthGatewayError extends Error {\n  readonly code: AuthGatewayErrorCode;\n  readonly status: number;\n\n  constructor(code: AuthGatewayErrorCode) {\n    const safeCode = Object.hasOwn(errorPresentations, code) ? code : \"auth_unavailable\";\n    const presentation = errorPresentations[safeCode];\n    super(presentation.message);\n    this.name = \"AuthGatewayError\";\n    this.code = safeCode;\n    this.status = presentation.status;\n  }\n}\n\nfunction safeFailure(error: unknown): AuthGatewayError {\n  if (error instanceof AuthGatewayError) {\n    return new AuthGatewayError(error.code);\n  }\n  if (error instanceof AuthValidationError) {\n    if (error.code === \"invalid_phone\" || error.code === \"otp_invalid\") {\n      return new AuthGatewayError(error.code);\n    }\n  }\n  if (error instanceof AuthResponseError) {\n    return new AuthGatewayError(\"invalid_response\");\n  }\n  if (error instanceof WordPressApiError) {\n    if (Object.hasOwn(pluginErrors, error.code)) {\n      return new AuthGatewayError(error.code as keyof typeof pluginErrors);\n    }\n    switch (error.code) {\n      case \"invalid_json\":\n      case \"invalid_envelope\":\n        return new AuthGatewayError(\"invalid_response\");\n      case \"network_error\":\n      case \"timeout\":\n      case \"aborted\":\n      case \"fetch_unavailable\":\n        return new AuthGatewayError(\"network_error\");\n    }\n  }\n  return new AuthGatewayError(\"auth_unavailable\");\n}\n\nfunction assertServerRuntime(): void {\n  try {\n    assertWordPressServerOnly();\n  } catch {\n    throw new AuthGatewayError(\"server_only\");\n  }\n}\n\nasync function run<T>(operation: () => Promise<T>): Promise<T> {\n  try {\n    assertServerRuntime();\n    return await operation();\n  } catch (error) {\n    // Always construct a fresh allowlisted error, without upstream data or cause.\n    throw safeFailure(error);\n  }\n}\n\nfunction requireCredential(\n  value: unknown,\n  code: \"invalid_credentials\" | \"invalid_tracking_code\" = \"invalid_credentials\",\n): asserts value is string {\n  if (typeof value !== \"string\" || value.length === 0 || /[\\s\\p{Cc}]/u.test(value)) {\n    throw new AuthGatewayError(code);\n  }\n}\n\nconst lazyWordPressRest: WordPressAuthRequest = async (path, options) => {\n  const { wordpressRest } = await import(\"../wordpress/rest-client.ts\");\n  return wordpressRest(path, options);\n};\n\nexport function createWordPressAuthGateway(\n  request: WordPressAuthRequest = lazyWordPressRest,\n): WordPressAuthGateway {\n  assertServerRuntime();\n\n  return {\n    requestOtp: (phone) => run(async () => {\n      const normalizedPhone = normalizeIranianPhone(phone);\n      return parseUpstreamOtpChallenge(await request(\"auth/otp/request\", {\n        method: \"POST\",\n        body: { phone: normalizedPhone },\n      }));\n    }),\n\n    verifyOtp: (input, storedChallenge) => run(async () => {\n      if (input === null || typeof input !== \"object\" || Array.isArray(input)) {\n        throw new AuthGatewayError(\"invalid_request\");\n      }\n      const expectedCodeLength = storedChallenge?.expectedCodeLength ?? 5;\n      if (expectedCodeLength !== 5 && expectedCodeLength !== 6) {\n        throw new AuthGatewayError(\"invalid_request\");\n      }\n      requireCredential(input.trackingCode, \"invalid_tracking_code\");\n      const code = normalizeOtpCode(input.code, expectedCodeLength);\n      if (input.role !== \"client\" && input.role !== \"specialist\") {\n        throw new AuthGatewayError(\"invalid_role\");\n      }\n      if (input.deviceId !== undefined &&\n          (typeof input.deviceId !== \"string\" || input.deviceId.length > 64)) {\n        throw new AuthGatewayError(\"invalid_device_id\");\n      }\n      const body: {\n        tracking_code: string;\n        code: string;\n        role: RegistrationRole;\n        device_id?: string;\n      } = { tracking_code: input.trackingCode, code, role: input.role };\n      if (input.deviceId !== undefined) {\n        body.device_id = input.deviceId;\n      }\n      return parseUpstreamVerifyResult(await request(\"auth/otp/verify\", {\n        method: \"POST\",\n        body,\n      }));\n    }),\n\n    refresh: (refreshToken) => run(async () => {\n      requireCredential(refreshToken);\n      return parseUpstreamRefreshResult(await request(\"auth/refresh\", {\n        method: \"POST\",\n        body: { refresh_token: refreshToken },\n      }));\n    }),\n\n    me: (accessToken) => run(async () => {\n      requireCredential(accessToken);\n      return parseUpstreamMeUser(await request(\"auth/me\", {\n        method: \"GET\",\n        token: accessToken,\n      }));\n    }),\n\n    localStatus: () => run(async () => (\n      parseUpstreamLocalStatus(await request(\"auth/local-status\", { method: \"GET\" }))\n    )),\n\n    logoutRefresh: (refreshToken) => run(async () => {\n      requireCredential(refreshToken);\n      return parseUpstreamLogoutResult(await request(\"auth/logout/refresh\", {\n        method: \"POST\",\n        body: { refresh_token: refreshToken },\n      }));\n    }),\n\n    logout: (accessToken, refreshToken) => run(async () => {\n      requireCredential(accessToken);\n      requireCredential(refreshToken);\n      return parseUpstreamLogoutResult(await request(\"auth/logout\", {\n        method: \"POST\",\n        token: accessToken,\n        body: { refresh_token: refreshToken, all_devices: false },\n      }));\n    }),\n  };\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/services/auth/auth-session-schema.test.ts": {
      "sha256": "0a6898c2d921b5583456139347b29fc2754a4a3307eaa1e47da461d29e9955b9",
      "text": "import assert from \"node:assert/strict\";\nimport { test } from \"node:test\";\nimport { getIronSession, type CookieStore } from \"iron-session\";\nimport {\n  MAX_SEALED_SESSION_BYTES,\n  parseSealedAuthSession,\n} from \"./auth-session-schema.ts\";\nimport { applyAuthSession } from \"./auth-session-storage.ts\";\nimport type { AuthSessionData } from \"./auth-coordinator.ts\";\n\nconst now = 1_700_000_000_000;\nconst password = \"test-password-only-not-a-deployment-secret\".repeat(2);\n\nfunction validSession(): AuthSessionData {\n  return {\n    sessionId: \"9aa0a1b2-c3d4-4e5f-8a90-b1c2d3e4f5a6\",\n    version: 1,\n    auth: {\n      accessToken: \"access-token\",\n      accessExpiresAt: now - 1,\n      refreshToken: \"refresh-token\",\n      refreshExpiresAt: now + 60_000,\n      account: { id: 47, displayName: \"آزاده نمونه\", role: \"specialist\" },\n      generation: \"84e86fd2-2205-4880-a65c-4b8da64489f1\",\n    },\n  };\n}\n\ntest(\"accepts a current iron-session v9 seal with an expired access deadline but viable refresh\", async () => {\n  const values = new Map<string, string>();\n  const store: CookieStore = {\n    get: (name) => values.has(name) ? { name, value: values.get(name)! } : undefined,\n    getAll: () => [...values].map(([name, value]) => ({ name, value })),\n    set: (name, value) => { values.set(name, value); },\n  };\n  const options = { cookieName: \"karban_auth\", password, ttl: 2_592_000, cookieOptions: { httpOnly: true, sameSite: \"lax\" as const, secure: false, path: \"/\" } };\n  const first = await getIronSession<AuthSessionData>(store, options);\n  const original = validSession();\n  Object.assign(first, original);\n  await first.save();\n  const restored = await getIronSession<AuthSessionData>(store, options);\n  assert.deepEqual(parseSealedAuthSession(restored, now), original);\n});\n\ntest(\"rejects partial, conflicting, oversized, and malformed sealed session fields without serializing credentials\", () => {\n  const valid = validSession();\n  const malformed: unknown[] = [\n    {},\n    { ...valid, version: 2 },\n    { ...valid, sessionId: \"not-a-uuid\" },\n    { ...valid, auth: { ...valid.auth!, accessToken: \"contains\\ncontrol\" } },\n    { ...valid, auth: { ...valid.auth!, refreshExpiresAt: now } },\n    { ...valid, auth: { ...valid.auth!, account: { ...valid.auth!.account, role: null } } },\n    { ...valid, challenge: { trackingCode: \"track\", role: \"client\", codeLength: 6, deliveryMode: \"sms\", expiresAt: now + 1 } },\n    { ...valid, challenge: { trackingCode: \"track\", role: \"client\", codeLength: 5, deliveryMode: \"sms\", expiresAt: now + 1 } },\n    { ...valid, auth: undefined, challenge: { trackingCode: \"track\", role: \"client\", codeLength: 5, deliveryMode: \"sms\", expiresAt: now } },\n    { ...valid, auth: undefined, challenge: { trackingCode: \"x\".repeat(MAX_SEALED_SESSION_BYTES), role: \"client\", codeLength: 5, deliveryMode: \"sms\", expiresAt: now + 1 } },\n  ];\n  for (const value of malformed) {\n    assert.equal(parseSealedAuthSession(value, now), undefined);\n  }\n  const serialized = String(JSON.stringify(parseSealedAuthSession({ auth: { accessToken: \"private-access\" } }, now)));\n  assert.equal(serialized.includes(\"private-access\"), false);\n});\n\ntest(\"applies a verified auth transition to a real iron cookie without retaining a stale challenge\", async () => {\n  const values = new Map<string, string>();\n  const store: CookieStore = {\n    get: (name) => values.has(name) ? { name, value: values.get(name)! } : undefined,\n    getAll: () => [...values].map(([name, value]) => ({ name, value })),\n    set: (name, value) => { values.set(name, value); },\n  };\n  const options = { cookieName: \"karban_auth\", password, ttl: 2_592_000, cookieOptions: { httpOnly: true, sameSite: \"lax\" as const, secure: false, path: \"/\" } };\n  const requested = await getIronSession<AuthSessionData>(store, options);\n  Object.assign(requested, {\n    sessionId: \"9aa0a1b2-c3d4-4e5f-8a90-b1c2d3e4f5a6\",\n    version: 1,\n    challenge: { trackingCode: \"track\", role: \"client\", codeLength: 5, deliveryMode: \"sms\", expiresAt: now + 60_000 },\n  } satisfies AuthSessionData);\n  await requested.save();\n\n  const verifying = await getIronSession<AuthSessionData>(store, options);\n  applyAuthSession(verifying, validSession());\n  await verifying.save();\n  const restored = await getIronSession<AuthSessionData>(store, options);\n  assert.equal(restored.challenge, undefined);\n  assert.deepEqual(parseSealedAuthSession(restored, now), validSession());\n});\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/services/auth/auth-bff.server.ts": {
      "sha256": "16e79c5cb0486628f5b66ebcce26bf24d3871d785121656d1c41e991e3f06b9a",
      "text": "import \"server-only\";\n\nimport type { IronSession } from \"iron-session\";\nimport {\n  createAuthCoordinator,\n  createRefreshCoordinator,\n  type SealedAuthCoordinator,\n  type AuthSessionData,\n} from \"./auth-coordinator.ts\";\nimport { createOtpReadinessCheck } from \"./auth-bff-policy.ts\";\nimport { getAuthRuntimeConfig, isLoopbackOtpAllowed, isLoopbackWordPressOrigin } from \"./auth-runtime-config.ts\";\nimport type { AuthRouteAdapterDependencies } from \"./auth-route-adapters.ts\";\nimport { getAuthSession } from \"./session.server.ts\";\nimport { createIronSessionPort } from \"./auth-session-storage.ts\";\nimport { parseSealedAuthSession } from \"./auth-session-schema.ts\";\nimport { createWordPressAuthGateway } from \"./wordpress-auth.ts\";\nimport { getWordPressOrigin } from \"../wordpress/config.ts\";\n\nconst refreshCoordinator = createRefreshCoordinator(() => Date.now());\n\nfunction hasSealedAuthData(session: IronSession<AuthSessionData>): boolean {\n  return [\"sessionId\", \"version\", \"challenge\", \"auth\"].some((key) => Object.hasOwn(session, key));\n}\n\n/** Server-only request composition. Read-only mode never writes or destroys cookies. */\nexport async function createRequestAuthCoordinator(readOnly = false): Promise<SealedAuthCoordinator> {\n  const config = getAuthRuntimeConfig();\n  if (!config) {\n    throw new Error(\"auth configuration unavailable\");\n  }\n  const session = await getAuthSession();\n  if (!session) {\n    throw new Error(\"auth session unavailable\");\n  }\n  const initial = parseSealedAuthSession(session, Date.now());\n  if (!initial && hasSealedAuthData(session)) {\n    // Invalid seals are terminal; rendering must not mutate cookies.\n    if (!readOnly) session.destroy();\n    throw new Error(\"invalid sealed auth session\");\n  }\n  const wordpressOrigin = getWordPressOrigin();\n  const gateway = createWordPressAuthGateway();\n  return createAuthCoordinator({\n    gateway,\n    session: createIronSessionPort(session, initial, readOnly),\n    now: () => Date.now(),\n    uuid: () => crypto.randomUUID(),\n    ensureOtpReady: createOtpReadinessCheck({\n      isLoopback: isLoopbackWordPressOrigin(wordpressOrigin),\n      localDevelopmentEnabled: isLoopbackOtpAllowed(process.env, wordpressOrigin),\n      getLocalStatus: () => gateway.localStatus(),\n    }),\n    refreshCoordinator,\n  });\n}\n\n/** Route handlers call this at request time; no environment is read during module import. */\nexport function getAuthBffRouteDependencies(): AuthRouteAdapterDependencies {\n  return {\n    appOrigin: getAuthRuntimeConfig()?.appOrigin,\n    getCoordinator: () => createRequestAuthCoordinator(),\n  };\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/services/auth/auth-bff-policy.test.ts": {
      "sha256": "c148e054db28d878234cb536a9b324eb3e9227f2680cce7ebb845270d99062d7",
      "text": "import assert from \"node:assert/strict\";\nimport { test } from \"node:test\";\nimport { AuthCoordinatorError } from \"./auth-coordinator.ts\";\nimport { createOtpReadinessCheck } from \"./auth-bff-policy.ts\";\n\nasync function rejects(operation: () => Promise<void>): Promise<void> {\n  await assert.rejects(operation, (error: unknown) => {\n    assert.ok(error instanceof AuthCoordinatorError);\n    assert.equal(error.code, \"auth_unavailable\");\n    assert.equal(error.status, 503);\n    return true;\n  });\n}\n\ntest(\"blocks loopback OTP before requestOtp when opt-in is missing, readiness false, or preflight fails\", async () => {\n  for (const check of [\n    createOtpReadinessCheck({ isLoopback: true, localDevelopmentEnabled: false, getLocalStatus: async () => ({ otpReady: true, credentialProvenanceReady: true }) }),\n    createOtpReadinessCheck({ isLoopback: true, localDevelopmentEnabled: true, getLocalStatus: async () => ({ otpReady: false, credentialProvenanceReady: true }) }),\n    createOtpReadinessCheck({ isLoopback: true, localDevelopmentEnabled: true, getLocalStatus: async () => ({ otpReady: true, credentialProvenanceReady: false }) }),\n    createOtpReadinessCheck({ isLoopback: true, localDevelopmentEnabled: true, getLocalStatus: async () => { throw new Error(\"fixed readiness 404 payload\"); } }),\n  ]) {\n    await rejects(check);\n  }\n});\n\ntest(\"does not preflight nonloopback production providers\", async () => {\n  let calls = 0;\n  const check = createOtpReadinessCheck({\n    isLoopback: false,\n    localDevelopmentEnabled: false,\n    getLocalStatus: async () => { calls += 1; return { otpReady: false, credentialProvenanceReady: false }; },\n  });\n  await assert.doesNotReject(check);\n  assert.equal(calls, 0);\n});\n\ntest(\"allows loopback issuance only after both trusted readiness booleans are true\", async () => {\n  let calls = 0;\n  const check = createOtpReadinessCheck({\n    isLoopback: true,\n    localDevelopmentEnabled: true,\n    getLocalStatus: async () => { calls += 1; return { otpReady: true, credentialProvenanceReady: true }; },\n  });\n  await assert.doesNotReject(check);\n  assert.equal(calls, 1);\n});\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/services/auth/auth-runtime-config.ts": {
      "sha256": "0424338a80058258bab201441ecf588f7e5dd2201a9d69f231097aec934be3fc",
      "text": "export interface AuthRuntimeConfig {\n  appOrigin: string;\n  ironPassword: string;\n}\n\nfunction normalizedOrigin(value: string | undefined): string | undefined {\n  if (!value || value.trim().length === 0) {\n    return undefined;\n  }\n  try {\n    const parsed = new URL(value.trim());\n    if (parsed.protocol !== \"http:\" && parsed.protocol !== \"https:\") {\n      return undefined;\n    }\n    if (parsed.username || parsed.password || parsed.search || parsed.hash || parsed.pathname !== \"/\") {\n      return undefined;\n    }\n    return parsed.origin;\n  } catch {\n    return undefined;\n  }\n}\n\nexport function getAuthRuntimeConfig(environment: NodeJS.ProcessEnv = process.env): AuthRuntimeConfig | undefined {\n  const appOrigin = normalizedOrigin(environment.APP_ORIGIN);\n  const ironPassword = environment.IRON_SESSION_PASSWORD;\n  if (!appOrigin || !ironPassword || ironPassword.trim().length < 32) {\n    return undefined;\n  }\n  return { appOrigin, ironPassword };\n}\n\nexport function isLoopbackWordPressOrigin(origin: string | undefined): boolean {\n  if (!origin) {\n    return false;\n  }\n  try {\n    const url = new URL(origin);\n    return url.protocol === \"http:\" && (\n      url.hostname === \"localhost\" ||\n      url.hostname === \"127.0.0.1\" ||\n      url.hostname === \"[::1]\"\n    );\n  } catch {\n    return false;\n  }\n}\n\nexport function isLoopbackOtpAllowed(\n  environment: NodeJS.ProcessEnv = process.env,\n  wordpressOrigin: string | undefined,\n): boolean {\n  return (\n    environment.KARBAN_LOCAL_DEVELOPMENT === \"true\" &&\n    environment.NODE_ENV !== \"production\" &&\n    isLoopbackWordPressOrigin(wordpressOrigin)\n  );\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/services/auth/contracts.ts": {
      "sha256": "8f82b9fa144ba16ae577a1f8c42b20c4a9c4914e3725ac2105e7e6249f34848f",
      "text": "export type OtpDeliveryMode = \"sms\" | \"local_simulated\";\nexport type OtpCodeLength = 5 | 6;\n\nexport interface UpstreamOtpChallenge {\n  tracking_code: string;\n  expires_in: number;\n  delivery_mode: OtpDeliveryMode;\n  code_length: OtpCodeLength;\n}\n\nexport interface UpstreamTokenPair {\n  access_token: string;\n  access_expires_in: number;\n  refresh_token: string;\n  refresh_expires_in: number;\n  token_type: \"Bearer\";\n}\n\nexport interface UpstreamVerifiedUser {\n  id: number;\n  display_name: string;\n  roles: string[];\n  phone: string;\n}\n\nexport interface UpstreamMeUser {\n  id: number;\n  display_name: string;\n  roles: string[];\n  phone: string | null;\n  specialist_post_id: number;\n}\n\nexport interface UpstreamVerifyResult {\n  tokens: UpstreamTokenPair;\n  is_new: boolean;\n  user: UpstreamVerifiedUser;\n}\n\nexport interface UpstreamRefreshResult {\n  tokens: UpstreamTokenPair;\n}\n\nexport interface UpstreamLogoutResult {\n  logged_out: true;\n}\n\nexport interface UpstreamLocalStatus {\n  otpReady: boolean;\n  credentialProvenanceReady: boolean;\n}\n\nexport class AuthResponseError extends Error {\n  readonly code = \"invalid_response\";\n  readonly status = 502;\n\n  constructor() {\n    super(\"پاسخ سرویس احراز هویت معتبر نیست.\");\n    this.name = \"AuthResponseError\";\n  }\n}\n\nfunction record(value: unknown): Record<string, unknown> {\n  if (value === null || typeof value !== \"object\" || Array.isArray(value)) {\n    throw new AuthResponseError();\n  }\n  return value as Record<string, unknown>;\n}\n\nfunction string(value: unknown): string {\n  if (typeof value !== \"string\") {\n    throw new AuthResponseError();\n  }\n  return value;\n}\n\nfunction nonemptyString(value: unknown): string {\n  const parsed = string(value);\n  if (parsed.trim().length === 0) {\n    throw new AuthResponseError();\n  }\n  return parsed;\n}\n\nfunction safeInteger(value: unknown, minimum: number): number {\n  if (typeof value !== \"number\" || !Number.isSafeInteger(value) || value < minimum) {\n    throw new AuthResponseError();\n  }\n  return value;\n}\n\nfunction roles(value: unknown): string[] {\n  if (!Array.isArray(value)) {\n    throw new AuthResponseError();\n  }\n  const parsed: string[] = [];\n  for (const role of value) {\n    parsed.push(string(role));\n  }\n  return parsed;\n}\n\nfunction parseVerifiedUser(value: unknown): UpstreamVerifiedUser {\n  const user = record(value);\n  return {\n    id: safeInteger(user.id, 1),\n    display_name: string(user.display_name),\n    roles: roles(user.roles),\n    phone: string(user.phone),\n  };\n}\n\nexport function parseUpstreamOtpChallenge(value: unknown): UpstreamOtpChallenge {\n  const challenge = record(value);\n  const hasMode = Object.hasOwn(challenge, \"delivery_mode\");\n  const hasLength = Object.hasOwn(challenge, \"code_length\");\n  let delivery_mode: OtpDeliveryMode = \"sms\";\n  let code_length: OtpCodeLength = 5;\n\n  if (hasMode !== hasLength) {\n    throw new AuthResponseError();\n  }\n  if (hasMode) {\n    if (challenge.delivery_mode !== \"sms\" && challenge.delivery_mode !== \"local_simulated\") {\n      throw new AuthResponseError();\n    }\n    if (challenge.code_length !== 5 && challenge.code_length !== 6) {\n      throw new AuthResponseError();\n    }\n    delivery_mode = challenge.delivery_mode;\n    code_length = challenge.code_length;\n    if ((delivery_mode === \"sms\" && code_length !== 5) ||\n        (delivery_mode === \"local_simulated\" && code_length !== 6)) {\n      throw new AuthResponseError();\n    }\n  }\n\n  return {\n    tracking_code: nonemptyString(challenge.tracking_code),\n    expires_in: safeInteger(challenge.expires_in, 1),\n    delivery_mode,\n    code_length,\n  };\n}\n\nexport function parseUpstreamTokenPair(value: unknown): UpstreamTokenPair {\n  const tokens = record(value);\n  if (tokens.token_type !== \"Bearer\") {\n    throw new AuthResponseError();\n  }\n  return {\n    access_token: nonemptyString(tokens.access_token),\n    access_expires_in: safeInteger(tokens.access_expires_in, 1),\n    refresh_token: nonemptyString(tokens.refresh_token),\n    refresh_expires_in: safeInteger(tokens.refresh_expires_in, 1),\n    token_type: \"Bearer\",\n  };\n}\n\nexport function parseUpstreamVerifyResult(value: unknown): UpstreamVerifyResult {\n  const result = record(value);\n  if (typeof result.is_new !== \"boolean\") {\n    throw new AuthResponseError();\n  }\n  return {\n    tokens: parseUpstreamTokenPair(result.tokens),\n    is_new: result.is_new,\n    user: parseVerifiedUser(result.user),\n  };\n}\n\nexport function parseUpstreamRefreshResult(value: unknown): UpstreamRefreshResult {\n  const result = record(value);\n  return { tokens: parseUpstreamTokenPair(result.tokens) };\n}\n\nexport function parseUpstreamMeUser(value: unknown): UpstreamMeUser {\n  const user = record(value);\n  return {\n    id: safeInteger(user.id, 1),\n    display_name: string(user.display_name),\n    roles: roles(user.roles),\n    phone: user.phone === null ? null : string(user.phone),\n    specialist_post_id: safeInteger(user.specialist_post_id, 0),\n  };\n}\n\nexport function parseUpstreamLogoutResult(value: unknown): UpstreamLogoutResult {\n  const result = record(value);\n  if (result.logged_out !== true) {\n    throw new AuthResponseError();\n  }\n  return { logged_out: true };\n}\n\nexport function parseUpstreamLocalStatus(value: unknown): UpstreamLocalStatus {\n  const result = record(value);\n  if (\n    typeof result.otpReady !== \"boolean\" ||\n    typeof result.credentialProvenanceReady !== \"boolean\"\n  ) {\n    throw new AuthResponseError();\n  }\n  return {\n    otpReady: result.otpReady,\n    credentialProvenanceReady: result.credentialProvenanceReady,\n  };\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/services/auth/session.server.ts": {
      "sha256": "781b653b1e4fd205beeda1c0c4ba5e3f4e3710a9ef0e51639f3a3623aacfb71c",
      "text": "import \"server-only\";\n\nimport { getIronSession, type IronSession, type SessionOptions } from \"iron-session\";\nimport { cookies } from \"next/headers\";\nimport type { AuthSessionData } from \"./auth-coordinator.ts\";\nimport { getAuthRuntimeConfig } from \"./auth-runtime-config.ts\";\nimport { applyAuthSession } from \"./auth-session-storage.ts\";\n\nexport const AUTH_SESSION_COOKIE_NAME = \"karban_auth\";\nconst AUTH_SESSION_TTL_SECONDS = 2_592_000;\n\nfunction sessionOptions(password: string): SessionOptions {\n  return {\n    cookieName: AUTH_SESSION_COOKIE_NAME,\n    password,\n    ttl: AUTH_SESSION_TTL_SECONDS,\n    cookieOptions: {\n      httpOnly: true,\n      sameSite: \"lax\",\n      secure: process.env.NODE_ENV === \"production\",\n      path: \"/\",\n    },\n  };\n}\n\nexport async function getAuthSession(): Promise<IronSession<AuthSessionData> | undefined> {\n  const config = getAuthRuntimeConfig();\n  if (!config) {\n    return undefined;\n  }\n  return getIronSession<AuthSessionData>(await cookies(), sessionOptions(config.ironPassword));\n}\n\nexport function replaceAuthSession(\n  session: IronSession<AuthSessionData>,\n  next: AuthSessionData,\n): Promise<void> {\n  applyAuthSession(session, next);\n  return session.save();\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/services/auth/auth-session-storage.ts": {
      "sha256": "e1ded6ca218d010422f89d5e9af49518374f074634b4fb1d08443aa8e33d8ed0",
      "text": "import type { IronSession } from \"iron-session\";\nimport type { AuthSessionData, AuthSessionPort } from \"./auth-coordinator.ts\";\n\n/** Applies a complete replacement before the caller saves an iron-session cookie. */\nexport function applyAuthSession(\n  session: IronSession<AuthSessionData>,\n  next: AuthSessionData,\n): void {\n  delete session.sessionId;\n  delete session.version;\n  delete session.challenge;\n  delete session.auth;\n  session.sessionId = next.sessionId;\n  session.version = next.version;\n  if (next.challenge) {\n    session.challenge = next.challenge;\n  }\n  if (next.auth) {\n    session.auth = next.auth;\n  }\n}\n\n/** The same real iron-session port serves handlers and read-only server helpers. */\nexport function createIronSessionPort(\n  session: IronSession<AuthSessionData>,\n  initial: AuthSessionData | undefined,\n  readOnly = false,\n): AuthSessionPort {\n  let current = initial;\n  return {\n    read: () => current,\n    save: async (next) => {\n      if (readOnly) throw new Error(\"read-only auth session\");\n      applyAuthSession(session, next);\n      await session.save();\n      current = next;\n    },\n    destroy: () => {\n      current = undefined;\n      if (!readOnly) session.destroy();\n    },\n  };\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/services/auth/auth-coordinator.ts": {
      "sha256": "a3e78296ccb93759c0d9a159dc88043449c8e4540d21350aafd504306a16aa9e",
      "text": "import { parseSealedAuthSession } from \"./auth-session-schema.ts\";\nimport {\n  AuthValidationError,\n  deadlineFromTtl,\n  getAccountHome,\n  normalizeOtpCode,\n  toAccountSummary,\n} from \"../../lib/auth-policy.ts\";\nimport type { AccountSummary, RegistrationRole } from \"../../lib/contracts/auth.ts\";\nimport type {\n  OtpCodeLength,\n  OtpDeliveryMode,\n  UpstreamMeUser,\n  UpstreamOtpChallenge,\n  UpstreamRefreshResult,\n  UpstreamVerifyResult,\n} from \"./contracts.ts\";\n\nexport interface AuthChallengeContext {\n  trackingCode: string;\n  role: RegistrationRole;\n  codeLength: OtpCodeLength;\n  deliveryMode: OtpDeliveryMode;\n  expiresAt: number;\n}\n\nexport interface AuthCredentialContext {\n  accessToken: string;\n  accessExpiresAt: number;\n  refreshToken: string;\n  refreshExpiresAt: number;\n  account: AccountSummary;\n  generation: string;\n}\n\nexport interface AuthSessionData {\n  sessionId: string;\n  version: 1;\n  challenge?: AuthChallengeContext;\n  auth?: AuthCredentialContext;\n}\n\nexport interface AuthSessionPort {\n  read(): AuthSessionData | undefined;\n  save(session: AuthSessionData): Promise<void>;\n  destroy(): void;\n}\n\nexport interface AuthGatewayPort {\n  requestOtp(phone: string): Promise<UpstreamOtpChallenge>;\n  verifyOtp(input: { trackingCode: string; code: string; role: RegistrationRole }, storedChallenge: { expectedCodeLength: OtpCodeLength }): Promise<UpstreamVerifyResult>;\n  refresh(refreshToken: string): Promise<UpstreamRefreshResult>;\n  me(accessToken: string): Promise<UpstreamMeUser>;\n  logoutRefresh(refreshToken: string): Promise<{ logged_out: true }>;\n}\n\nexport type AuthCoordinatorCode = \"rate_limited\" | \"invalid_request\" | \"auth_unavailable\" | \"challenge_missing\" | \"challenge_expired\" | \"invalid_code\" | \"unsupported_role\" | \"unauthenticated\" | \"refresh_required\" | \"refresh_cancelled\";\n\nconst statusByCode: Record<AuthCoordinatorCode, number> = {\n  rate_limited: 429,\n  invalid_request: 422,\n  auth_unavailable: 503,\n  challenge_missing: 401,\n  challenge_expired: 410,\n  invalid_code: 422,\n  unsupported_role: 403,\n  unauthenticated: 401,\n  refresh_required: 401,\n  refresh_cancelled: 401,\n};\n\nexport class AuthCoordinatorError extends Error {\n  readonly code: AuthCoordinatorCode;\n  readonly status: number;\n\n  constructor(code: AuthCoordinatorCode, status = statusByCode[code]) {\n    super(\"عملیات احراز هویت در حال حاضر قابل انجام نیست.\");\n    this.name = \"AuthCoordinatorError\";\n    this.code = code;\n    this.status = status;\n  }\n}\n\nexport interface RefreshCoordinator {\n  run<T>(key: string, operation: (isCancelled: () => boolean) => Promise<T>): Promise<T>;\n  cancelAndWait(key: string, credentialExpiresAt?: number): Promise<void>;\n  isCancelled(key: string): boolean;\n  claim(key: string, auth: AuthCredentialContext, write: boolean): {\n    check(): void;\n    commit(next: AuthCredentialContext): void;\n    release(): void;\n  };\n}\n\ninterface RefreshEntry {\n  cancelled: boolean;\n  expiresAt: number;\n  settled: boolean;\n  promise?: Promise<unknown>;\n}\n\nconst REFRESH_REPLAY_GRACE_MS = 5_000;\nconst MAX_REFRESH_ENTRIES = 512;\nconst MAX_CANCELLED_TOMBSTONES = 512;\n\nexport function createRefreshCoordinator(now: () => number): RefreshCoordinator {\n  const entries = new Map<string, RefreshEntry>();\n  const cancellations = new Map<string, number>();\n  // Per-generation fences cover independent cookie/response ports, not just one\n  // closure's session snapshot. Retain until refresh expiry; never evict a live\n  // fence to admit another writer. Multi-process deployments need shared affinity.\n  const fences = new Map<string, { seal: string; busy: boolean; cancelled: boolean; expiresAt: number }>();\n  let cancellationAdmissionBlocked = false;\n  let fenceAdmissionBlockedUntil = 0;\n  function prune(): void {\n    const time = now();\n    for (const [key, fence] of fences) {\n      if (!fence.busy && fence.expiresAt <= time) fences.delete(key);\n    }\n    for (const [key, entry] of entries) {\n      if (entry.settled && entry.expiresAt <= time) entries.delete(key);\n    }\n    for (const [key, expiresAt] of cancellations) {\n      if (expiresAt <= time) cancellations.delete(key);\n    }\n    if (cancellations.size < MAX_CANCELLED_TOMBSTONES) {\n      cancellationAdmissionBlocked = false;\n    }\n    while (entries.size > MAX_REFRESH_ENTRIES) {\n      const settledKey = [...entries].find(([, entry]) => entry.settled)?.[0];\n      if (!settledKey) break;\n      entries.delete(settledKey);\n    }\n  }\n  function entryFor(key: string): RefreshEntry | undefined {\n    const existing = entries.get(key);\n    if (existing) return existing;\n    prune();\n    if (entries.size >= MAX_REFRESH_ENTRIES) return undefined;\n    const entry: RefreshEntry = { cancelled: false, expiresAt: now() + REFRESH_REPLAY_GRACE_MS, settled: true };\n    entries.set(key, entry);\n    return entry;\n  }\n  return {\n    run<T>(\n      key: string,\n      operation: (isCancelled: () => boolean) => Promise<T>,\n    ): Promise<T> {\n      prune();\n      if (cancellations.has(key)) return Promise.reject(new AuthCoordinatorError(\"refresh_cancelled\"));\n      if (cancellationAdmissionBlocked) return Promise.reject(new AuthCoordinatorError(\"auth_unavailable\"));\n      const entry = entryFor(key);\n      if (!entry) return Promise.reject(new AuthCoordinatorError(\"auth_unavailable\"));\n      if (entry.cancelled) return Promise.reject(new AuthCoordinatorError(\"refresh_cancelled\"));\n      if (entry.promise) return entry.promise as Promise<T>;\n      entry.settled = false;\n      const task = operation(() => entry.cancelled).finally(() => {\n        entry.settled = true;\n        entry.expiresAt = now() + REFRESH_REPLAY_GRACE_MS;\n        prune();\n      });\n      entry.promise = task;\n      return task;\n    },\n    async cancelAndWait(key, credentialExpiresAt) {\n      prune();\n      const fence = fences.get(key);\n      if (fence) fence.cancelled = true;\n      else if (credentialExpiresAt !== undefined && credentialExpiresAt > now()) {\n        if (fences.size >= MAX_REFRESH_ENTRIES) {\n          // Lost cancellation admission must never make an old valid seal usable.\n          fenceAdmissionBlockedUntil = Math.max(fenceAdmissionBlockedUntil, credentialExpiresAt);\n        } else {\n          fences.set(key, { seal: \"\", busy: false, cancelled: true, expiresAt: credentialExpiresAt });\n        }\n      }\n      const existing = entries.get(key);\n      if (existing) {\n        existing.cancelled = true;\n        existing.expiresAt = now() + REFRESH_REPLAY_GRACE_MS;\n        try { await existing.promise; } catch { /* Cancellation waits for finalization, not its outcome. */ }\n        return;\n      }\n      if (!cancellations.has(key)) {\n        if (cancellations.size >= MAX_CANCELLED_TOMBSTONES) {\n          cancellationAdmissionBlocked = true;\n          return;\n        }\n        cancellations.set(key, now() + REFRESH_REPLAY_GRACE_MS);\n      }\n    },\n    isCancelled(key) {\n      prune();\n      return cancellations.has(key) || entries.get(key)?.cancelled === true || fences.get(key)?.cancelled === true;\n    },\n    claim(key, auth, write) {\n      prune();\n      if (this.isCancelled(key)) throw new AuthCoordinatorError(\"refresh_cancelled\");\n      if (fenceAdmissionBlockedUntil > now()) throw new AuthCoordinatorError(\"auth_unavailable\");\n      let fence = fences.get(key);\n      const seal = JSON.stringify(auth);\n      if (!fence) {\n        if (fences.size >= MAX_REFRESH_ENTRIES || cancellationAdmissionBlocked) throw new AuthCoordinatorError(\"auth_unavailable\");\n        fence = { seal, busy: false, cancelled: false, expiresAt: auth.refreshExpiresAt };\n        fences.set(key, fence);\n      }\n      if (fence.busy || fence.seal !== seal) throw new AuthCoordinatorError(\"refresh_required\");\n      if (write) fence.busy = true;\n      const held = fence;\n      let expected = seal;\n      return {\n        check: () => {\n          if (this.isCancelled(key) || held.cancelled) throw new AuthCoordinatorError(\"refresh_cancelled\");\n          if (held.seal !== expected) throw new AuthCoordinatorError(\"refresh_required\");\n        },\n        commit: (next) => { expected = JSON.stringify(next); held.seal = expected; held.expiresAt = next.refreshExpiresAt; },\n        release: () => { if (write) held.busy = false; },\n      };\n    },\n  };\n}\n\nexport interface AuthCoordinatorDependencies {\n  gateway: AuthGatewayPort;\n  session: AuthSessionPort;\n  now: () => number;\n  uuid: () => string;\n  ensureOtpReady: () => Promise<void>;\n  refreshCoordinator: RefreshCoordinator;\n}\n\nexport interface PublicChallenge { expiresAt: number; codeLength: OtpCodeLength; isSimulated: boolean; }\nexport interface PublicAuthResult { account: AccountSummary; redirectTo: \"/dashboard\" | \"/pro\"; onboardingTo?: \"/account\" | \"/pro/profile\"; }\n\nfunction upstreamCode(error: unknown): string | undefined {\n  return error !== null && typeof error === \"object\" && typeof (error as { code?: unknown }).code === \"string\"\n    ? (error as { code: string }).code\n    : undefined;\n}\nfunction safeError(error: unknown): AuthCoordinatorError {\n  if (error instanceof AuthCoordinatorError) return error;\n  if (error instanceof AuthValidationError || upstreamCode(error) === \"otp_invalid\") return new AuthCoordinatorError(\"invalid_code\");\n  if ([\"invalid_refresh\", \"revoked_refresh\", \"expired_refresh\"].includes(upstreamCode(error) ?? \"\")) return new AuthCoordinatorError(\"unauthenticated\");\n  if ([\"otp_expired\", \"otp_consumed\", \"otp_not_found\"].includes(upstreamCode(error) ?? \"\")) return new AuthCoordinatorError(\"challenge_expired\");\n  if ([\"otp_rate_limited\", \"otp_rate_limited_ip\", \"otp_throttled\", \"otp_too_many_attempts\"].includes(upstreamCode(error) ?? \"\")) return new AuthCoordinatorError(\"rate_limited\");\n  if ([\"invalid_phone\", \"invalid_request\", \"invalid_tracking_code\", \"invalid_role\", \"invalid_device_id\"].includes(upstreamCode(error) ?? \"\")) return new AuthCoordinatorError(\"invalid_request\");\n  return new AuthCoordinatorError(\"auth_unavailable\");\n}\nfunction terminalVerificationFailure(error: unknown): boolean {\n  return [\"otp_consumed\", \"otp_expired\", \"otp_not_found\", \"otp_too_many_attempts\"].includes(upstreamCode(error) ?? \"\");\n}\nfunction publicChallenge(challenge: AuthChallengeContext): PublicChallenge {\n  return { expiresAt: challenge.expiresAt, codeLength: challenge.codeLength, isSimulated: challenge.deliveryMode === \"local_simulated\" };\n}\nfunction accountFrom(user: { id: number; display_name: string; roles: readonly string[] }): AccountSummary {\n  const account = toAccountSummary(user);\n  if (account.role === null) throw new AuthCoordinatorError(\"unsupported_role\");\n  return account;\n}\nfunction publicAuth(account: AccountSummary): PublicAuthResult {\n  const redirectTo = getAccountHome(account.role);\n  if (!redirectTo) throw new AuthCoordinatorError(\"unsupported_role\");\n  return { account, redirectTo };\n}\nfunction withoutChallenge(session: AuthSessionData): AuthSessionData { const next = { ...session }; delete next.challenge; return next; }\nfunction refreshKey(session: AuthSessionData, auth: AuthCredentialContext): string { return `${session.sessionId}:${auth.generation}`; }\n\nexport interface AuthCoordinator {\n  requestOtp(phone: string, role: RegistrationRole): Promise<{ challenge: PublicChallenge }>;\n  verifyOtp(code: string): Promise<PublicAuthResult>;\n  challenge(): PublicChallenge;\n  me(): Promise<{ account: AccountSummary }>;\n  refresh(): Promise<{ account: AccountSummary }>;\n  logout(): Promise<void>;\n}\n\nexport interface SealedAuthCoordinator extends AuthCoordinator {\n  /** Internal server composition only. Never expose as a Server Action. No retry/refresh. */\n  authenticatedOperation<T>(operation: (accessToken: string, account: AccountSummary, assertActive: () => void) => Promise<T>, summary?: (result: T) => AccountSummary, mutation?: boolean): Promise<T>;\n}\n\nexport function createAuthCoordinator(dependencies: AuthCoordinatorDependencies): SealedAuthCoordinator {\n  const { gateway, session, now, uuid, ensureOtpReady, refreshCoordinator } = dependencies;\n  function readSession(): AuthSessionData | undefined {\n    const current = session.read();\n    if (current?.auth && refreshCoordinator.isCancelled(refreshKey(current, current.auth))) {\n      session.destroy();\n      return undefined;\n    }\n    return current;\n  }\n  function requireSession(): AuthSessionData { const current = readSession(); if (!current) throw new AuthCoordinatorError(\"unauthenticated\"); return current; }\n  function requireChallenge(): AuthChallengeContext {\n    const challenge = requireSession().challenge;\n    if (!challenge) throw new AuthCoordinatorError(\"challenge_missing\");\n    if (challenge.expiresAt <= now()) throw new AuthCoordinatorError(\"challenge_expired\");\n    return challenge;\n  }\n  function requireAuth(): { base: AuthSessionData; auth: AuthCredentialContext; key: string } {\n    const base = requireSession();\n    if (!base.auth) throw new AuthCoordinatorError(\"unauthenticated\");\n    const key = refreshKey(base, base.auth);\n    if (refreshCoordinator.isCancelled(key)) { session.destroy(); throw new AuthCoordinatorError(\"unauthenticated\"); }\n    return { base, auth: base.auth, key };\n  }\n  async function revokeNewRefresh(refreshToken: string): Promise<void> { try { await gateway.logoutRefresh(refreshToken); } catch { /* local terminal state wins */ } }\n\n  return {\n    async authenticatedOperation(operation, summary, mutation = false) {\n      if (!parseSealedAuthSession(session.read(), now())?.auth) throw new AuthCoordinatorError(\"unauthenticated\");\n      const { base, auth, key } = requireAuth();\n      if (auth.accessExpiresAt <= now()) throw new AuthCoordinatorError(\"refresh_required\");\n      if (auth.refreshExpiresAt <= now()) throw new AuthCoordinatorError(\"unauthenticated\");\n      const lease = refreshCoordinator.claim(key, auth, mutation || !!summary);\n      try {\n        lease.check();\n        let result;\n        try { result = await operation(auth.accessToken, { ...auth.account }, lease.check); }\n        catch (error) { lease.check(); throw error; }\n        lease.check();\n        if (summary) {\n          const account = summary(result);\n          if (account.id !== auth.account.id || account.role !== auth.account.role ||\n            typeof account.displayName !== \"string\" || account.displayName.length > 160 || /[\\p{Cc}]/u.test(account.displayName)) {\n            throw new AuthCoordinatorError(\"auth_unavailable\");\n          }\n          const current = session.read();\n          if (!current?.auth || JSON.stringify(current.auth) !== JSON.stringify(auth)) throw new AuthCoordinatorError(\"refresh_required\");\n          const next = { ...withoutChallenge(base), auth: { ...auth, account: { id: account.id, displayName: account.displayName, role: account.role } } };\n          try { await session.save(next); } catch { throw new AuthCoordinatorError(\"auth_unavailable\"); }\n          lease.check();\n          lease.commit(next.auth);\n        }\n        return result;\n      } finally { lease.release(); }\n    },\n    async requestOtp(phone, role) {\n      try {\n        const previous = readSession();\n        if (session.read() && !previous) throw new AuthCoordinatorError(\"unauthenticated\");\n        await ensureOtpReady();\n        const issued = await gateway.requestOtp(phone);\n        const challenge: AuthChallengeContext = { trackingCode: issued.tracking_code, role, codeLength: issued.code_length, deliveryMode: issued.delivery_mode, expiresAt: deadlineFromTtl(now(), issued.expires_in) };\n        const next: AuthSessionData = { sessionId: previous?.sessionId ?? uuid(), version: 1, challenge };\n        await session.save(next);\n        return { challenge: publicChallenge(challenge) };\n      } catch (error) { throw safeError(error); }\n    },\n    async verifyOtp(code) {\n      let base: AuthSessionData;\n      let challenge: AuthChallengeContext;\n      try {\n        base = requireSession();\n        challenge = requireChallenge();\n        const normalizedCode = normalizeOtpCode(code, challenge.codeLength);\n        let verified: UpstreamVerifyResult;\n        try {\n          verified = await gateway.verifyOtp({ trackingCode: challenge.trackingCode, code: normalizedCode, role: challenge.role }, { expectedCodeLength: challenge.codeLength });\n        } catch (error) {\n          if (terminalVerificationFailure(error)) await session.save(withoutChallenge(base));\n          throw error;\n        }\n        const account = accountFrom(verified.user);\n        const tokens = verified.tokens;\n        const next: AuthSessionData = { ...withoutChallenge(base), auth: { accessToken: tokens.access_token, accessExpiresAt: deadlineFromTtl(now(), tokens.access_expires_in), refreshToken: tokens.refresh_token, refreshExpiresAt: deadlineFromTtl(now(), tokens.refresh_expires_in), account, generation: uuid() } };\n        await session.save(next);\n        return { ...publicAuth(account), ...(verified.is_new ? { onboardingTo: account.role === \"specialist\" ? \"/pro/profile\" as const : \"/account\" as const } : {}) };\n      } catch (error) { throw safeError(error); }\n    },\n    challenge() { return publicChallenge(requireChallenge()); },\n    async me() {\n      try {\n        const { auth } = requireAuth();\n        if (auth.accessExpiresAt <= now()) throw new AuthCoordinatorError(\"refresh_required\");\n        return { account: accountFrom(await gateway.me(auth.accessToken)) };\n      } catch (error) { throw safeError(error); }\n    },\n    async refresh() {\n      let base: AuthSessionData; let auth: AuthCredentialContext; let key: string;\n      try { ({ base, auth, key } = requireAuth()); } catch (error) { throw safeError(error); }\n      if (auth.refreshExpiresAt <= now()) throw new AuthCoordinatorError(\"unauthenticated\");\n      try {\n        return await refreshCoordinator.run(key, async (isCancelled) => {\n          if (isCancelled()) throw new AuthCoordinatorError(\"refresh_cancelled\");\n          const lease = refreshCoordinator.claim(key, auth, true);\n          let refreshed: UpstreamRefreshResult | undefined;\n          try {\n            refreshed = await gateway.refresh(auth.refreshToken);\n            const account = accountFrom(await gateway.me(refreshed.tokens.access_token));\n            const current = session.read()?.auth;\n            if (isCancelled() || !current || current.generation !== auth.generation || current.refreshToken !== auth.refreshToken) throw new AuthCoordinatorError(\"refresh_cancelled\");\n            const next: AuthSessionData = { ...withoutChallenge(base), auth: { accessToken: refreshed.tokens.access_token, accessExpiresAt: deadlineFromTtl(now(), refreshed.tokens.access_expires_in), refreshToken: refreshed.tokens.refresh_token, refreshExpiresAt: deadlineFromTtl(now(), refreshed.tokens.refresh_expires_in), account, generation: auth.generation } };\n            await session.save(next);\n            if (isCancelled()) throw new AuthCoordinatorError(\"refresh_cancelled\");\n            lease.check();\n            lease.commit(next.auth!);\n            return { account };\n          } catch (error) {\n            if (refreshed) await revokeNewRefresh(refreshed.tokens.refresh_token);\n            throw safeError(error);\n          } finally { lease.release(); }\n        });\n      } catch (error) { throw safeError(error); }\n    },\n    async logout() {\n      const current = session.read();\n      const auth = current?.auth;\n      if (!current || !auth) { session.destroy(); return; }\n      const key = refreshKey(current, auth);\n      await refreshCoordinator.cancelAndWait(key, auth.refreshExpiresAt);\n      session.destroy();\n      await revokeNewRefresh(auth.refreshToken);\n    },\n  };\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/services/auth/auth-route-adapters.ts": {
      "sha256": "39352b5d6da67ca39293671b692da46dd9444d9c604f5c559daf59b58d9680e5",
      "text": "import {\n  AuthRequestPolicyError,\n  parseLogoutRequest,\n  parseOtpRequest,\n  parseOtpVerifyRequest,\n  parseRefreshRequest,\n} from \"../../lib/auth-request-policy.ts\";\nimport { AuthCoordinatorError, type AuthCoordinator } from \"./auth-coordinator.ts\";\n\nexport interface AuthRouteAdapterDependencies {\n  appOrigin: string | undefined;\n  getCoordinator: () => Promise<AuthCoordinator>;\n}\n\nexport interface AuthRouteHandlers {\n  request(request: Request): Promise<Response>;\n  verify(request: Request): Promise<Response>;\n  challenge(request: Request): Promise<Response>;\n  me(request: Request): Promise<Response>;\n  refresh(request: Request): Promise<Response>;\n  logout(request: Request): Promise<Response>;\n}\n\nconst privateNoStoreHeaders = {\n  \"Cache-Control\": \"private, no-store\",\n  Pragma: \"no-cache\",\n  Vary: \"Cookie\",\n};\n\nfunction json(body: unknown, status = 200): Response {\n  return Response.json(body, { status, headers: privateNoStoreHeaders });\n}\n\nfunction empty(status: number): Response {\n  return new Response(null, { status, headers: privateNoStoreHeaders });\n}\n\nfunction errorResponse(error: unknown): Response {\n  if (error instanceof AuthRequestPolicyError || error instanceof AuthCoordinatorError) {\n    return json({ error: { code: error.code } }, error.status);\n  }\n  return json({ error: { code: \"auth_unavailable\" } }, 503);\n}\n\nfunction unavailable(): Response {\n  return json({ error: { code: \"auth_unavailable\" } }, 503);\n}\n\nexport function createAuthRouteHandlers(dependencies: AuthRouteAdapterDependencies): AuthRouteHandlers {\n  async function withCoordinator<T>(operation: (coordinator: AuthCoordinator) => Promise<T>): Promise<Response> {\n    if (!dependencies.appOrigin) {\n      return unavailable();\n    }\n    try {\n      return json(await operation(await dependencies.getCoordinator()));\n    } catch (error) {\n      return errorResponse(error);\n    }\n  }\n\n  return {\n    async request(request) {\n      if (!dependencies.appOrigin) {\n        return unavailable();\n      }\n      try {\n        const body = await parseOtpRequest(request, dependencies.appOrigin);\n        return await withCoordinator((coordinator) => coordinator.requestOtp(body.phone, body.role));\n      } catch (error) {\n        return errorResponse(error);\n      }\n    },\n    async verify(request) {\n      if (!dependencies.appOrigin) {\n        return unavailable();\n      }\n      try {\n        const body = await parseOtpVerifyRequest(request, dependencies.appOrigin);\n        return await withCoordinator((coordinator) => coordinator.verifyOtp(body.code));\n      } catch (error) {\n        return errorResponse(error);\n      }\n    },\n    async challenge() {\n      return withCoordinator(async (coordinator) => ({ challenge: coordinator.challenge() }));\n    },\n    async me() {\n      return withCoordinator((coordinator) => coordinator.me());\n    },\n    async refresh(request) {\n      if (!dependencies.appOrigin) {\n        return unavailable();\n      }\n      try {\n        await parseRefreshRequest(request, dependencies.appOrigin);\n        return await withCoordinator((coordinator) => coordinator.refresh());\n      } catch (error) {\n        return errorResponse(error);\n      }\n    },\n    async logout(request) {\n      if (!dependencies.appOrigin) {\n        return unavailable();\n      }\n      try {\n        await parseLogoutRequest(request, dependencies.appOrigin);\n        const coordinator = await dependencies.getCoordinator();\n        await coordinator.logout();\n        return empty(204);\n      } catch (error) {\n        return errorResponse(error);\n      }\n    },\n  };\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/services/auth/auth-session-schema.ts": {
      "sha256": "c4e13fe80825e28b3147e8f99e93111ac6e5482849e2c86ff374ce600d23a482",
      "text": "import type { AccountSummary, RegistrationRole } from \"../../lib/contracts/auth.ts\";\nimport type {\n  AuthChallengeContext,\n  AuthCredentialContext,\n  AuthSessionData,\n} from \"./auth-coordinator.ts\";\n\nexport const MAX_SEALED_SESSION_BYTES = 3_000;\n\nconst UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-9a-f][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/iu;\nconst CONTROL = /[\\p{Cc}]/u;\n\nfunction object(value: unknown): Record<string, unknown> | undefined {\n  return value !== null && typeof value === \"object\" && !Array.isArray(value)\n    ? value as Record<string, unknown>\n    : undefined;\n}\n\nfunction exactKeys(value: Record<string, unknown>, keys: readonly string[]): boolean {\n  const actual = Object.keys(value);\n  return actual.length === keys.length && keys.every((key) => Object.hasOwn(value, key));\n}\n\nfunction safeInteger(value: unknown): value is number {\n  return typeof value === \"number\" && Number.isSafeInteger(value) && value >= 0;\n}\n\nfunction boundedText(value: unknown, maximum: number, allowEmpty = false): value is string {\n  return typeof value === \"string\" &&\n    (allowEmpty || value.length > 0) &&\n    value.length <= maximum &&\n    !CONTROL.test(value);\n}\n\nfunction token(value: unknown, maximum: number): value is string {\n  return boundedText(value, maximum) && !/\\s/u.test(value);\n}\n\nfunction parseAccount(value: unknown): AccountSummary | undefined {\n  const account = object(value);\n  if (!account || !exactKeys(account, [\"id\", \"displayName\", \"role\"]) ||\n    !safeInteger(account.id) || account.id < 1 ||\n    !boundedText(account.displayName, 160, true) ||\n    (account.role !== \"client\" && account.role !== \"specialist\")) {\n    return undefined;\n  }\n  return { id: account.id, displayName: account.displayName, role: account.role };\n}\n\nfunction parseChallenge(value: unknown, now: number): AuthChallengeContext | undefined {\n  const challenge = object(value);\n  if (!challenge || !exactKeys(challenge, [\"trackingCode\", \"role\", \"codeLength\", \"deliveryMode\", \"expiresAt\"]) ||\n    !boundedText(challenge.trackingCode, 128) ||\n    (challenge.role !== \"client\" && challenge.role !== \"specialist\") ||\n    (challenge.codeLength !== 5 && challenge.codeLength !== 6) ||\n    (challenge.deliveryMode !== \"sms\" && challenge.deliveryMode !== \"local_simulated\") ||\n    !safeInteger(challenge.expiresAt) || challenge.expiresAt <= now ||\n    (challenge.deliveryMode === \"sms\" && challenge.codeLength !== 5) ||\n    (challenge.deliveryMode === \"local_simulated\" && challenge.codeLength !== 6)) {\n    return undefined;\n  }\n  return {\n    trackingCode: challenge.trackingCode,\n    role: challenge.role,\n    codeLength: challenge.codeLength,\n    deliveryMode: challenge.deliveryMode,\n    expiresAt: challenge.expiresAt,\n  };\n}\n\nfunction parseAuth(value: unknown, now: number): AuthCredentialContext | undefined {\n  const auth = object(value);\n  if (!auth || !exactKeys(auth, [\"accessToken\", \"accessExpiresAt\", \"refreshToken\", \"refreshExpiresAt\", \"account\", \"generation\"]) ||\n    !token(auth.accessToken, 2_048) || !safeInteger(auth.accessExpiresAt) || auth.accessExpiresAt < 1 ||\n    !token(auth.refreshToken, 512) || !safeInteger(auth.refreshExpiresAt) || auth.refreshExpiresAt <= now ||\n    !boundedText(auth.generation, 36) || !UUID.test(auth.generation)) {\n    return undefined;\n  }\n  const account = parseAccount(auth.account);\n  if (!account) {\n    return undefined;\n  }\n  return {\n    accessToken: auth.accessToken,\n    accessExpiresAt: auth.accessExpiresAt,\n    refreshToken: auth.refreshToken,\n    refreshExpiresAt: auth.refreshExpiresAt,\n    account,\n    generation: auth.generation,\n  };\n}\n\n/** Parses only the sealed shape the BFF owns; malformed input never throws or echoes private values. */\nexport function parseSealedAuthSession(value: unknown, now: number): AuthSessionData | undefined {\n  if (!safeInteger(now)) {\n    return undefined;\n  }\n  try {\n    if (JSON.stringify(value).length > MAX_SEALED_SESSION_BYTES) {\n      return undefined;\n    }\n  } catch {\n    return undefined;\n  }\n  const session = object(value);\n  if (!session || !exactKeys(session, Object.hasOwn(session, \"challenge\") || Object.hasOwn(session, \"auth\")\n    ? [\"sessionId\", \"version\", ...(Object.hasOwn(session, \"challenge\") ? [\"challenge\"] : []), ...(Object.hasOwn(session, \"auth\") ? [\"auth\"] : [])]\n    : [\"sessionId\", \"version\"]) ||\n    session.version !== 1 || !boundedText(session.sessionId, 36) || !UUID.test(session.sessionId)) {\n    return undefined;\n  }\n  if (Object.hasOwn(session, \"challenge\") && Object.hasOwn(session, \"auth\")) {\n    return undefined;\n  }\n  const challenge = Object.hasOwn(session, \"challenge\") ? parseChallenge(session.challenge, now) : undefined;\n  const auth = Object.hasOwn(session, \"auth\") ? parseAuth(session.auth, now) : undefined;\n  if ((Object.hasOwn(session, \"challenge\") && !challenge) || (Object.hasOwn(session, \"auth\") && !auth)) {\n    return undefined;\n  }\n  return {\n    sessionId: session.sessionId,\n    version: 1,\n    ...(challenge ? { challenge } : {}),\n    ...(auth ? { auth } : {}),\n  };\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/services/auth/auth-route-adapters.test.ts": {
      "sha256": "bb391c8701af46219823aed5b41395db122e01b80707da4a8a9170e0b1a878b4",
      "text": "import assert from \"node:assert/strict\";\nimport { test } from \"node:test\";\nimport type { AuthCoordinator } from \"./auth-coordinator.ts\";\nimport { createAuthRouteHandlers } from \"./auth-route-adapters.ts\";\n\nconst APP_ORIGIN = \"https://app.example.test\";\n\nfunction post(path: string, body: string, headers: Record<string, string> = {}): Request {\n  return new Request(`${APP_ORIGIN}${path}`, {\n    method: \"POST\",\n    headers: {\n      Origin: APP_ORIGIN,\n      \"Content-Type\": \"application/json\",\n      \"Sec-Fetch-Site\": \"same-origin\",\n      ...headers,\n    },\n    body,\n  });\n}\n\nfunction fakeCoordinator(): AuthCoordinator & { calls: Record<string, number> } {\n  const calls = { requestOtp: 0, verifyOtp: 0, challenge: 0, me: 0, refresh: 0, logout: 0 };\n  return {\n    calls,\n    requestOtp: async () => { calls.requestOtp += 1; return { challenge: { expiresAt: 1_700_000_120_000, codeLength: 5, isSimulated: false } }; },\n    verifyOtp: async () => { calls.verifyOtp += 1; return { account: { id: 47, displayName: \"آزاده نمونه\", role: \"specialist\" }, redirectTo: \"/pro\" }; },\n    challenge: () => { calls.challenge += 1; return { expiresAt: 1_700_000_120_000, codeLength: 5, isSimulated: false }; },\n    me: async () => { calls.me += 1; return { account: { id: 47, displayName: \"آزاده نمونه\", role: \"specialist\" } }; },\n    refresh: async () => { calls.refresh += 1; return { account: { id: 47, displayName: \"آزاده نمونه\", role: \"specialist\" } }; },\n    logout: async () => { calls.logout += 1; },\n  };\n}\n\nasync function json(response: Response): Promise<unknown> {\n  assert.equal(response.headers.get(\"cache-control\"), \"private, no-store\");\n  assert.equal(response.headers.get(\"pragma\"), \"no-cache\");\n  return response.json();\n}\n\ntest(\"maps fixed BFF endpoints to safe public projections and no-store responses\", async () => {\n  const coordinator = fakeCoordinator();\n  const routes = createAuthRouteHandlers({ appOrigin: APP_ORIGIN, getCoordinator: async () => coordinator });\n\n  assert.deepEqual(await json(await routes.request(post(\"/api/auth/request\", '{\"phone\":\"09121234567\",\"role\":\"client\"}'))), {\n    challenge: { expiresAt: 1_700_000_120_000, codeLength: 5, isSimulated: false },\n  });\n  assert.deepEqual(await json(await routes.verify(post(\"/api/auth/verify\", '{\"code\":\"12345\"}'))), {\n    account: { id: 47, displayName: \"آزاده نمونه\", role: \"specialist\" }, redirectTo: \"/pro\",\n  });\n  assert.deepEqual(await json(await routes.challenge(new Request(`${APP_ORIGIN}/api/auth/challenge`))), {\n    challenge: { expiresAt: 1_700_000_120_000, codeLength: 5, isSimulated: false },\n  });\n  assert.deepEqual(await json(await routes.me(new Request(`${APP_ORIGIN}/api/auth/me`))), {\n    account: { id: 47, displayName: \"آزاده نمونه\", role: \"specialist\" },\n  });\n  assert.deepEqual(await json(await routes.refresh(post(\"/api/auth/refresh\", \"{}\"))), {\n    account: { id: 47, displayName: \"آزاده نمونه\", role: \"specialist\" },\n  });\n  const logout = await routes.logout(post(\"/api/auth/logout\", \"{}\"));\n  assert.equal(logout.status, 204);\n  assert.equal(logout.headers.get(\"cache-control\"), \"private, no-store\");\n  assert.equal(await logout.text(), \"\");\n  assert.deepEqual(coordinator.calls, { requestOtp: 1, verifyOtp: 1, challenge: 1, me: 1, refresh: 1, logout: 1 });\n});\n\ntest(\"stops hostile mutation requests before acquiring a coordinator or mutating a session\", async () => {\n  const coordinator = fakeCoordinator();\n  let acquired = 0;\n  const routes = createAuthRouteHandlers({ appOrigin: APP_ORIGIN, getCoordinator: async () => { acquired += 1; return coordinator; } });\n  for (const request of [\n    post(\"/api/auth/request\", '{\"phone\":\"09121234567\",\"role\":\"client\",\"tracking\":\"private\"}'),\n    post(\"/api/auth/request\", '{\"phone\":\"09121234567\",\"role\":\"client\"}', { Origin: \"https://evil.example\" }),\n    post(\"/api/auth/request\", '{\"phone\":\"09121234567\",\"role\":\"client\"}', { \"Sec-Fetch-Site\": \"cross-site\" }),\n    post(\"/api/auth/request\", '{\"phone\":\"09121234567\",\"role\":\"client\"}', { \"Content-Type\": \"text/plain\" }),\n    post(\"/api/auth/refresh\", '{\"refresh_token\":\"private\"}'),\n    post(\"/api/auth/logout\", '{\"refresh_token\":\"private\"}'),\n  ]) {\n    const handler = request.url.endsWith(\"/refresh\") ? routes.refresh : request.url.endsWith(\"/logout\") ? routes.logout : routes.request;\n    const response = await handler(request);\n    assert.ok([400, 403, 415].includes(response.status));\n    const body = JSON.stringify(await response.json());\n    assert.equal(body.includes(\"private\"), false);\n    assert.equal(body.includes(\"tracking\"), false);\n  }\n  assert.equal(acquired, 0);\n  assert.deepEqual(coordinator.calls, { requestOtp: 0, verifyOtp: 0, challenge: 0, me: 0, refresh: 0, logout: 0 });\n});\n\ntest(\"returns runtime configuration and coordinator failures as secret-safe 503 responses\", async () => {\n  let missingAcquisitions = 0;\n  const missing = createAuthRouteHandlers({\n    appOrigin: undefined,\n    getCoordinator: async () => { missingAcquisitions += 1; throw new Error(\"must not run\"); },\n  });\n  for (const handler of [\n    () => missing.request(post(\"/api/auth/request\", '{\"phone\":\"09121234567\",\"role\":\"client\"}')),\n    () => missing.verify(post(\"/api/auth/verify\", '{\"code\":\"12345\"}')),\n    () => missing.challenge(new Request(`${APP_ORIGIN}/api/auth/challenge`)),\n    () => missing.me(new Request(`${APP_ORIGIN}/api/auth/me`)),\n    () => missing.refresh(post(\"/api/auth/refresh\", \"{}\")),\n    () => missing.logout(post(\"/api/auth/logout\", \"{}\")),\n  ]) {\n    const missingResponse = await handler();\n    assert.equal(missingResponse.status, 503);\n    assert.deepEqual(await missingResponse.json(), { error: { code: \"auth_unavailable\" } });\n  }\n  assert.equal(missingAcquisitions, 0);\n\n  const failing = createAuthRouteHandlers({ appOrigin: APP_ORIGIN, getCoordinator: async () => { throw new Error(\"access-token-private\"); } });\n  const failureResponse = await failing.request(post(\"/api/auth/request\", '{\"phone\":\"09121234567\",\"role\":\"client\"}'));\n  assert.equal(failureResponse.status, 503);\n  const body = JSON.stringify(await failureResponse.json());\n  assert.equal(body.includes(\"access-token-private\"), false);\n  assert.equal(failureResponse.headers.get(\"cache-control\"), \"private, no-store\");\n});\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/services/auth/auth-page-guards.server.ts": {
      "sha256": "25b0c5525837f0f8853afcd279819e84beefdabb938b35137a0ab840c0da2ff6",
      "text": "import \"server-only\";\n\nimport { redirect } from \"next/navigation\";\nimport { resolveProtectedRouteFromSession, type ProtectedRoute } from \"@/lib/auth-page-guards\";\nimport type { AccountSummary } from \"@/lib/contracts/auth\";\nimport { getAuthSession } from \"@/services/auth/session.server\";\nimport { parseSealedAuthSession } from \"@/services/auth/auth-session-schema\";\n\nexport async function readSafeAccount(): Promise<AccountSummary | undefined> {\n  const session = await getAuthSession();\n  if (!session) return undefined;\n  const parsed = parseSealedAuthSession(session, Date.now());\n  if (!parsed?.auth || parsed.auth.accessExpiresAt <= Date.now()) return undefined;\n  return parsed.auth.account;\n}\n\nexport async function requireAccount(required: ProtectedRoute): Promise<AccountSummary> {\n  const result = await resolveProtectedRouteFromSession({ readAccount: readSafeAccount }, required);\n  if (result.kind === \"redirect\") redirect(result.location);\n  return result.account;\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/services/auth/wordpress-auth-bff.test.ts": {
      "sha256": "96617ccc7de989e875b97fd70c4e7f353969d33eb5bddefab9d480f92aabde29",
      "text": "import assert from \"node:assert/strict\";\nimport { test } from \"node:test\";\nimport { AuthGatewayError, createWordPressAuthGateway } from \"./wordpress-auth.ts\";\n\nconst REFRESH = \"f5c26ab3447d73a4d90dcaa352d8ecf51b064dbd4731f34abc5c98a351d7de22\";\n\ntest(\"reads local readiness through the fixed private endpoint without issuing OTP\", async () => {\n  const calls: Array<{ path: string; options: unknown }> = [];\n  const gateway = createWordPressAuthGateway(async (path, options) => {\n    calls.push({ path, options });\n    return { otpReady: false, credentialProvenanceReady: false };\n  });\n  assert.deepEqual(await gateway.localStatus(), { otpReady: false, credentialProvenanceReady: false });\n  assert.deepEqual(calls, [{ path: \"auth/local-status\", options: { method: \"GET\" } }]);\n});\n\ntest(\"revoke-by-refresh calls the unauthenticated durable logout endpoint without an access token\", async () => {\n  const calls: Array<{ path: string; options: unknown }> = [];\n  const gateway = createWordPressAuthGateway(async (path, options) => {\n    calls.push({ path, options });\n    return { logged_out: true };\n  });\n  assert.deepEqual(await gateway.logoutRefresh(REFRESH), { logged_out: true });\n  assert.deepEqual(calls, [{\n    path: \"auth/logout/refresh\",\n    options: { method: \"POST\", body: { refresh_token: REFRESH } },\n  }]);\n});\n\ntest(\"rejects malformed local-status and logout-refresh payloads without retaining private credentials\", async () => {\n  const malformedStatus = createWordPressAuthGateway(async () => ({ otpReady: true }));\n  await assert.rejects(() => malformedStatus.localStatus(), (error: unknown) => {\n    assert.ok(error instanceof AuthGatewayError);\n    assert.equal(error.code, \"invalid_response\");\n    assert.equal(JSON.stringify(error, Object.getOwnPropertyNames(error)).includes(REFRESH), false);\n    return true;\n  });\n  const malformedLogout = createWordPressAuthGateway(async () => ({ logged_out: false }));\n  await assert.rejects(() => malformedLogout.logoutRefresh(REFRESH), (error: unknown) => {\n    assert.ok(error instanceof AuthGatewayError);\n    assert.equal(error.code, \"invalid_response\");\n    assert.equal(JSON.stringify(error, Object.getOwnPropertyNames(error)).includes(REFRESH), false);\n    return true;\n  });\n});\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/services/auth/wordpress-auth.test.ts": {
      "sha256": "3eb00120db87fafdb66d9d6aa86da6912a54a50e01fa59ba1c9840d2121557bf",
      "text": "import assert from \"node:assert/strict\";\nimport { test } from \"node:test\";\nimport { toAccountSummary } from \"../../lib/auth-policy.ts\";\nimport { WordPressApiError } from \"../wordpress/errors.ts\";\nimport type { WordPressRequestOptions } from \"../wordpress/rest-client.ts\";\nimport {\n  AuthGatewayError,\n  createWordPressAuthGateway,\n  type WordPressAuthGateway,\n  type WordPressAuthRequest,\n} from \"./wordpress-auth.ts\";\n\nconst PHONE = \"09129876543\";\nconst OTP = \"58319\";\nconst TRACKING = \"f64a7a08-a32a-4d61-9be7-c425a8b8ee4c\";\nconst ACCESS = \"synthetic-opaque-access-credential\";\nconst REFRESH = \"f5c26ab3447d73a4d90dcaa352d8ecf51b064dbd4731f34abc5c98a351d7de22\";\nconst tokens = Object.freeze({\n  access_token: \"eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOjQ3LCJ0eXBlIjoiYWNjZXNzIn0.synthetic-signature\",\n  access_expires_in: 900,\n  refresh_token: REFRESH,\n  refresh_expires_in: 2_592_000,\n  token_type: \"Bearer\",\n});\nconst user = Object.freeze({\n  id: 47,\n  display_name: \"آزاده نمونه\",\n  roles: Object.freeze([\"nahan_specialist\"]),\n  phone: PHONE,\n});\nconst verified = Object.freeze({ tokens, is_new: false, user });\nconst verificationInput = Object.freeze({\n  trackingCode: TRACKING,\n  code: OTP,\n  role: \"specialist\" as const,\n});\n\nfunction captureRequest(response: unknown): {\n  request: WordPressAuthRequest;\n  calls: { path: string; options?: WordPressRequestOptions }[];\n} {\n  const calls: { path: string; options?: WordPressRequestOptions }[] = [];\n  return {\n    calls,\n    request: async (path, options) => {\n      calls.push({ path, options });\n      return response;\n    },\n  };\n}\n\nasync function assertSafeFailure(\n  operation: () => Promise<unknown>,\n  expectedCode: string,\n  expectedStatus: number,\n): Promise<AuthGatewayError> {\n  let captured: AuthGatewayError | undefined;\n  await assert.rejects(operation, (error: unknown) => {\n    assert.ok(error instanceof AuthGatewayError);\n    assert.equal(error.code, expectedCode);\n    assert.equal(error.status, expectedStatus);\n    assert.match(error.message, /[؀-ۿ]/u);\n    assert.equal(\"data\" in error, false);\n    assert.equal(\"cause\" in error, false);\n    const serialized = JSON.stringify(error, Object.getOwnPropertyNames(error));\n    for (const secret of [\n      PHONE, \"+98 912 987 6543\", \"۰۹۱۲۹۸۷۶۵۴۳\", OTP, \"۰۱۲۳۴\", TRACKING,\n      ACCESS, REFRESH, tokens.access_token, \"synthetic-raw-backend-payload\",\n      \"arbitrary_backend_error\", \"access_token\", \"refresh_token\", \"authorization\",\n    ]) {\n      assert.equal(serialized.includes(secret), false);\n    }\n    captured = error;\n    return true;\n  });\n  assert.ok(captured);\n  return captured;\n}\n\n// Break caught: double namespace, wrong method/body, or unnormalized credentials.\ntest(\"requests an OTP with only the canonical phone at the fixed REST boundary\", async () => {\n  const external = captureRequest({ tracking_code: TRACKING, expires_in: 37, resend_after: 60 });\n  const gateway = createWordPressAuthGateway(external.request);\n  assert.deepEqual(await gateway.requestOtp(\"+98 912 987 6543\"), {\n    tracking_code: \"f64a7a08-a32a-4d61-9be7-c425a8b8ee4c\",\n    expires_in: 37,\n    delivery_mode: \"sms\",\n    code_length: 5,\n  });\n  assert.deepEqual(external.calls, [{\n    path: \"auth/otp/request\",\n    options: { method: \"POST\", body: { phone: \"09129876543\" } },\n  }]);\n});\n\ntest(\"verifies a normalized OTP with explicit registration intent and bounded device ID\", async () => {\n  const external = captureRequest({ ...verified, is_new: true, unknown_backend_field: \"discard\" });\n  const gateway = createWordPressAuthGateway(external.request);\n  const result = await gateway.verifyOtp({\n    trackingCode: TRACKING,\n    code: \"۰۱۲۳۴\",\n    role: \"specialist\",\n    deviceId: \"d\".repeat(64),\n  });\n  assert.deepEqual(result, {\n    tokens: {\n      access_token: \"eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOjQ3LCJ0eXBlIjoiYWNjZXNzIn0.synthetic-signature\",\n      access_expires_in: 900,\n      refresh_token: \"f5c26ab3447d73a4d90dcaa352d8ecf51b064dbd4731f34abc5c98a351d7de22\",\n      refresh_expires_in: 2_592_000,\n      token_type: \"Bearer\",\n    },\n    is_new: true,\n    user: { id: 47, display_name: \"آزاده نمونه\", roles: [\"nahan_specialist\"], phone: \"09129876543\" },\n  });\n  assert.deepEqual(external.calls, [{\n    path: \"auth/otp/verify\",\n    options: {\n      method: \"POST\",\n      body: { tracking_code: TRACKING, code: \"01234\", role: \"specialist\", device_id: \"d\".repeat(64) },\n    },\n  }]);\n});\n\ntest(\"omits an absent device ID and follows existing-account backend roles rather than intent\", async () => {\n  const external = captureRequest({ ...verified, user: { ...user, roles: [\"nahan_client\"] } });\n  const gateway = createWordPressAuthGateway(external.request);\n  const result = await gateway.verifyOtp(verificationInput);\n  assert.ok(result);\n  assert.equal(result.is_new, false);\n  assert.deepEqual(toAccountSummary(result.user), { id: 47, displayName: \"آزاده نمونه\", role: \"client\" });\n  assert.deepEqual(external.calls, [{\n    path: \"auth/otp/verify\",\n    options: { method: \"POST\", body: { tracking_code: TRACKING, code: \"58319\", role: \"specialist\" } },\n  }]);\n});\n\ntest(\"refreshes with an opaque credential in the body and no access-token option\", async () => {\n  const external = captureRequest({ tokens, unknown_backend_field: \"discard\" });\n  const result = await createWordPressAuthGateway(external.request).refresh(REFRESH);\n  assert.deepEqual(result, { tokens: {\n    access_token: \"eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOjQ3LCJ0eXBlIjoiYWNjZXNzIn0.synthetic-signature\",\n    access_expires_in: 900,\n    refresh_token: \"f5c26ab3447d73a4d90dcaa352d8ecf51b064dbd4731f34abc5c98a351d7de22\",\n    refresh_expires_in: 2_592_000,\n    token_type: \"Bearer\",\n  } });\n  assert.deepEqual(external.calls, [{\n    path: \"auth/refresh\",\n    options: { method: \"POST\", body: { refresh_token: REFRESH } },\n  }]);\n});\n\ntest(\"gets the current user with the transport token option without decoding identity\", async () => {\n  const external = captureRequest({ ...user, phone: null, specialist_post_id: 0, unknown_backend_field: \"discard\" });\n  assert.deepEqual(await createWordPressAuthGateway(external.request).me(ACCESS), {\n    id: 47, display_name: \"آزاده نمونه\", roles: [\"nahan_specialist\"], phone: null, specialist_post_id: 0,\n  });\n  assert.deepEqual(external.calls, [{ path: \"auth/me\", options: { method: \"GET\", token: ACCESS } }]);\n});\n\ntest(\"logs out only the explicit refresh credential with authenticated all_devices false\", async () => {\n  const external = captureRequest({ logged_out: true, unknown_backend_field: \"discard\" });\n  assert.deepEqual(await createWordPressAuthGateway(external.request).logout(ACCESS, REFRESH), { logged_out: true });\n  assert.deepEqual(external.calls, [{\n    path: \"auth/logout\",\n    options: { method: \"POST\", token: ACCESS, body: { refresh_token: REFRESH, all_devices: false } },\n  }]);\n});\n\n// Break caught: validating after dispatch causes avoidable OTP/mutation requests.\ntest(\"rejects invalid phones before making any external request\", async () => {\n  const external = captureRequest({ tracking_code: TRACKING, expires_in: 120 });\n  const gateway = createWordPressAuthGateway(external.request);\n  for (const phone of [\"\", \"09129876543-secret\", \"+97 912 987 6543\", null, 47]) {\n    await assertSafeFailure(() => gateway.requestOtp(phone as string), \"invalid_phone\", 422);\n  }\n  assert.equal(external.calls.length, 0);\n});\n\ntest(\"requires valid tracking, five-digit code, explicit role and at-most-64-character device ID before verification\", async () => {\n  const external = captureRequest(verified);\n  const gateway = createWordPressAuthGateway(external.request);\n  type VerifyInput = Parameters<WordPressAuthGateway[\"verifyOtp\"]>[0];\n  const invalidInputs: { input: unknown; code: string }[] = [\n    { input: null, code: \"invalid_request\" },\n    { input: undefined, code: \"invalid_request\" },\n    ...[\"\", \"   \", \"invalid\\ntracking\", null, 47].map((trackingCode) => ({\n      input: { ...verificationInput, trackingCode }, code: \"invalid_tracking_code\",\n    })),\n    ...[\"1234\", \"123456\", \"58a19\", null, 58319].map((code) => ({\n      input: { ...verificationInput, code }, code: \"otp_invalid\",\n    })),\n    ...[undefined, null, \"pro\", \"administrator\", \"nahan_client\", 47].map((role) => ({\n      input: { ...verificationInput, role }, code: \"invalid_role\",\n    })),\n    ...[\"d\".repeat(65), null, 47].map((deviceId) => ({\n      input: { ...verificationInput, deviceId }, code: \"invalid_device_id\",\n    })),\n  ];\n  for (const { input, code } of invalidInputs) {\n    await assertSafeFailure(() => gateway.verifyOtp(input as VerifyInput), code, 422);\n  }\n  assert.equal(external.calls.length, 0);\n});\n\ntest(\"accepts client registration intent without aliasing it to a backend role\", async () => {\n  const external = captureRequest({ ...verified, user: { ...user, roles: [\"nahan_client\"] } });\n  const result = await createWordPressAuthGateway(external.request).verifyOtp({ ...verificationInput, role: \"client\" });\n  assert.ok(result);\n  assert.deepEqual(toAccountSummary(result.user), { id: 47, displayName: \"آزاده نمونه\", role: \"client\" });\n  assert.deepEqual(external.calls, [{\n    path: \"auth/otp/verify\",\n    options: { method: \"POST\", body: { tracking_code: TRACKING, code: \"58319\", role: \"client\" } },\n  }]);\n});\n\ntest(\"rejects invalid required server credentials before refresh, me or logout dispatch\", async () => {\n  const external = captureRequest({ logged_out: true });\n  const gateway = createWordPressAuthGateway(external.request);\n  for (const invalid of [\"\", \"   \", \"invalid\\ncredential\", \"Bearer duplicated-prefix\", null, undefined, 47]) {\n    await assertSafeFailure(() => gateway.refresh(invalid as string), \"invalid_credentials\", 422);\n    await assertSafeFailure(() => gateway.me(invalid as string), \"invalid_credentials\", 422);\n    await assertSafeFailure(() => gateway.logout(invalid as string, REFRESH), \"invalid_credentials\", 422);\n    await assertSafeFailure(() => gateway.logout(ACCESS, invalid as string), \"invalid_credentials\", 422);\n  }\n  assert.equal(external.calls.length, 0);\n});\n\ntest(\"never accepts a syntactically valid OTP as a local magic-code success\", async () => {\n  const codes: string[] = [];\n  const gateway = createWordPressAuthGateway(async (_path, options) => {\n    codes.push((options?.body as { code: string }).code);\n    throw new WordPressApiError({ status: 422, code: \"otp_invalid\", message: \"synthetic-raw-backend-payload\" });\n  });\n  for (const code of [\"12345\", \"00000\", \"58319\", \"01234\"]) {\n    await assertSafeFailure(() => gateway.verifyOtp({ ...verificationInput, code }), \"otp_invalid\", 422);\n  }\n  assert.deepEqual(codes, [\"12345\", \"00000\", \"58319\", \"01234\"]);\n});\n\nconst pluginFailures = [\n  [\"invalid_phone\", 422],\n  [\"otp_rate_limited\", 429],\n  [\"otp_rate_limited_ip\", 429],\n  [\"otp_throttled\", 429],\n  [\"otp_not_found\", 404],\n  [\"otp_consumed\", 410],\n  [\"otp_expired\", 410],\n  [\"otp_invalid\", 422],\n  [\"otp_too_many_attempts\", 429],\n  [\"invalid_refresh\", 401],\n  [\"revoked_refresh\", 401],\n  [\"expired_refresh\", 401],\n  [\"unauthenticated\", 401],\n] as const;\n\n// Break caught: forwarding arbitrary upstream code/status/message/data/cause leaks secrets.\nfor (const [code, status] of pluginFailures) {\n  test(`preserves safe ${code} semantics without retaining the upstream error`, async () => {\n    const upstream = new WordPressApiError({\n      status: 599,\n      code,\n      message: `${PHONE} ${OTP} ${REFRESH} Bearer ${ACCESS} synthetic-raw-backend-payload`,\n      data: { phone: PHONE, code: OTP, tracking: TRACKING, [`raw_${REFRESH}`]: \"synthetic-raw-backend-payload\" },\n    });\n    const gateway = createWordPressAuthGateway(async () => { throw upstream; });\n    const result = await assertSafeFailure(() => gateway.verifyOtp(verificationInput), code, status);\n    assert.notEqual(result, upstream);\n    const alternative = createWordPressAuthGateway(async () => {\n      throw new WordPressApiError({ status, code, message: \"different arbitrary_backend_error\" });\n    });\n    const other = await assertSafeFailure(() => alternative.verifyOtp(verificationInput), code, status);\n    assert.equal(result.message, other.message);\n  });\n}\n\ntest(\"turns unknown failures and prototype-name error codes into explicit safe failures\", async () => {\n  for (const failure of [\n    new Error(`${REFRESH} ${PHONE} ${OTP} Bearer ${ACCESS} synthetic-raw-backend-payload`),\n    new WordPressApiError({ status: 598, code: `arbitrary_backend_error_${REFRESH}`, message: PHONE, data: { secret: OTP } }),\n    new WordPressApiError({ status: 401, code: \"constructor\", message: REFRESH }),\n    new WordPressApiError({ status: 401, code: \"toString\", message: ACCESS }),\n    { code: \"unauthenticated\", message: REFRESH, data: { phone: PHONE } },\n    null,\n  ]) {\n    const gateway = createWordPressAuthGateway(async () => { throw failure; });\n    await assertSafeFailure(() => gateway.refresh(REFRESH), \"auth_unavailable\", 502);\n  }\n});\n\ntest(\"classifies transport network and malformed-response failures without leaking details\", async () => {\n  for (const [upstreamCode, expectedCode, expectedStatus] of [\n    [\"network_error\", \"network_error\", 503],\n    [\"timeout\", \"network_error\", 503],\n    [\"aborted\", \"network_error\", 503],\n    [\"fetch_unavailable\", \"network_error\", 503],\n    [\"invalid_json\", \"invalid_response\", 502],\n    [\"invalid_envelope\", \"invalid_response\", 502],\n  ] as const) {\n    const gateway = createWordPressAuthGateway(async () => {\n      throw new WordPressApiError({ status: 0, code: upstreamCode, message: REFRESH, data: { [ACCESS]: PHONE } });\n    });\n    await assertSafeFailure(() => gateway.me(ACCESS), expectedCode, expectedStatus);\n  }\n});\n\ntest(\"rejects a malformed success response for every operation rather than inventing auth success\", async () => {\n  const gateway = createWordPressAuthGateway(async () => ({\n    tokens: { ...tokens, access_expires_in: 0 },\n    user: { ...user, id: 0 },\n    is_new: false,\n    tracking_code: TRACKING,\n    expires_in: 0,\n    logged_out: false,\n    raw_backend_payload: { phone: PHONE, code: OTP, refresh_token: REFRESH },\n  }));\n  for (const operation of [\n    () => gateway.requestOtp(PHONE),\n    () => gateway.verifyOtp(verificationInput),\n    () => gateway.refresh(REFRESH),\n    () => gateway.me(ACCESS),\n    () => gateway.logout(ACCESS, REFRESH),\n  ]) {\n    await assertSafeFailure(operation, \"invalid_response\", 502);\n  }\n});\n\ntest(\"constructs the default gateway without reading WordPress configuration eagerly\", (context) => {\n  const original = process.env.WORDPRESS_URL;\n  context.after(() => {\n    if (original === undefined) delete process.env.WORDPRESS_URL;\n    else process.env.WORDPRESS_URL = original;\n  });\n  delete process.env.WORDPRESS_URL;\n  assert.doesNotThrow(() => createWordPressAuthGateway());\n});\n\ntest(\"guards factory and every credential-bearing invocation with window defined before dispatch\", async (context) => {\n  const external = captureRequest(verified);\n  const gateways = [createWordPressAuthGateway(external.request), createWordPressAuthGateway()];\n  const descriptor = Object.getOwnPropertyDescriptor(globalThis, \"window\");\n  context.after(() => {\n    if (descriptor) Object.defineProperty(globalThis, \"window\", descriptor);\n    else Reflect.deleteProperty(globalThis, \"window\");\n  });\n  Object.defineProperty(globalThis, \"window\", { configurable: true, value: {} });\n  assert.throws(() => createWordPressAuthGateway(external.request), (error: unknown) => {\n    assert.ok(error instanceof AuthGatewayError);\n    assert.equal(error.code, \"server_only\");\n    assert.equal(error.status, 500);\n    assert.match(error.message, /[؀-ۿ]/u);\n    return true;\n  });\n  for (const gateway of gateways) {\n    for (const operation of [\n      () => gateway.requestOtp(PHONE),\n      () => gateway.verifyOtp(verificationInput),\n      () => gateway.refresh(REFRESH),\n      () => gateway.me(ACCESS),\n      () => gateway.logout(ACCESS, REFRESH),\n      () => gateway.me(\"\"),\n    ]) {\n      await assertSafeFailure(operation, \"server_only\", 500);\n    }\n  }\n  assert.equal(external.calls.length, 0);\n});\n\ntest(\"sends a server-stored six-digit challenge upstream and never treats 145632 as a local success\", async () => {\n  const sentCodes: string[] = [];\n  const gateway = createWordPressAuthGateway(async (_path, options) => {\n    sentCodes.push((options?.body as { code: string }).code);\n    throw new WordPressApiError({\n      status: 422,\n      code: \"otp_invalid\",\n      message: \"synthetic-raw-backend-payload\",\n    });\n  });\n\n  await assertSafeFailure(\n    () => gateway.verifyOtp(\n      { ...verificationInput, code: \"۱۴۵۶۳۲\" },\n      { expectedCodeLength: 6 },\n    ),\n    \"otp_invalid\",\n    422,\n  );\n  assert.deepEqual(sentCodes, [\"145632\"]);\n});\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/services/auth/auth-runtime-config.test.ts": {
      "sha256": "4741c977daab9c0c7e9de347f39fb18081a6071daf0ef115d908e1187f2de3cb",
      "text": "import assert from \"node:assert/strict\";\nimport { test } from \"node:test\";\nimport {\n  getAuthRuntimeConfig,\n  isLoopbackWordPressOrigin,\n  isLoopbackOtpAllowed,\n} from \"./auth-runtime-config.ts\";\n\nfunction env(values: Record<string, string | undefined>): NodeJS.ProcessEnv {\n  return { ...values } as NodeJS.ProcessEnv;\n}\n\ntest(\"reads auth runtime configuration lazily and rejects missing or weak deployment secrets without throwing\", () => {\n  assert.equal(getAuthRuntimeConfig(env({})), undefined);\n  assert.equal(getAuthRuntimeConfig(env({ APP_ORIGIN: \"https://app.example.test\", IRON_SESSION_PASSWORD: \"short\" })), undefined);\n  assert.equal(getAuthRuntimeConfig(env({ APP_ORIGIN: \"not a URL\", IRON_SESSION_PASSWORD: \"x\".repeat(32) })), undefined);\n  assert.deepEqual(getAuthRuntimeConfig(env({\n    APP_ORIGIN: \"https://app.example.test/\",\n    IRON_SESSION_PASSWORD: \"x\".repeat(32),\n  })), {\n    appOrigin: \"https://app.example.test\",\n    ironPassword: \"x\".repeat(32),\n  });\n});\n\ntest(\"permits loopback OTP only with exact development opt-in and a non-production environment\", () => {\n  for (const origin of [\"http://localhost:8080/kar\", \"http://127.0.0.1/kar\", \"http://[::1]:8080/kar\"]) {\n    assert.equal(isLoopbackWordPressOrigin(origin), true);\n    assert.equal(isLoopbackOtpAllowed(env({ KARBAN_LOCAL_DEVELOPMENT: \"true\", NODE_ENV: \"development\" }), origin), true);\n  }\n  for (const envValues of [\n    {},\n    { KARBAN_LOCAL_DEVELOPMENT: \"false\", NODE_ENV: \"development\" },\n    { KARBAN_LOCAL_DEVELOPMENT: \"TRUE\", NODE_ENV: \"development\" },\n    { KARBAN_LOCAL_DEVELOPMENT: \"true\", NODE_ENV: \"production\" },\n  ]) {\n    assert.equal(isLoopbackOtpAllowed(env(envValues), \"http://localhost/kar\"), false);\n  }\n  assert.equal(isLoopbackOtpAllowed(env({ KARBAN_LOCAL_DEVELOPMENT: \"true\", NODE_ENV: \"development\" }), \"https://codecraft.ir/kar\"), false);\n});\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/services/auth/auth-coordinator.test.ts": {
      "sha256": "ef56c9dff9c1ef6bd8de73d4aa6fb0ae06a39bbc94cca51b9e22504fa03f54ad",
      "text": "import assert from \"node:assert/strict\";\nimport { test } from \"node:test\";\nimport type { AccountSummary } from \"../../lib/contracts/auth.ts\";\nimport {\n  AuthCoordinatorError,\n  createAuthCoordinator,\n  createRefreshCoordinator,\n  type AuthGatewayPort,\n  type AuthSessionData,\n  type AuthSessionPort,\n} from \"./auth-coordinator.ts\";\n\nconst now = 1_700_000_000_000;\nconst account: AccountSummary = { id: 47, displayName: \"آزاده نمونه\", role: \"specialist\" };\n\nfunction tokenPair(suffix = \"a\") {\n  return {\n    access_token: `access-${suffix}`,\n    access_expires_in: 900,\n    refresh_token: `refresh-${suffix}`,\n    refresh_expires_in: 2_592_000,\n    token_type: \"Bearer\" as const,\n  };\n}\n\nfunction session(initial?: AuthSessionData): AuthSessionPort & { saved: AuthSessionData[]; destroyed: number } {\n  let state = initial;\n  const saved: AuthSessionData[] = [];\n  let destroyed = 0;\n  return {\n    get saved() { return saved; },\n    get destroyed() { return destroyed; },\n    read: () => state,\n    save: async (next) => { state = structuredClone(next); saved.push(structuredClone(next)); },\n    destroy: () => { state = undefined; destroyed += 1; },\n  };\n}\n\nfunction gateway(overrides: Partial<AuthGatewayPort> = {}): AuthGatewayPort & { calls: Record<string, number> } {\n  const calls = { requestOtp: 0, verifyOtp: 0, refresh: 0, me: 0, logoutRefresh: 0 };\n  return {\n    calls,\n    requestOtp: async () => {\n      calls.requestOtp += 1;\n      return { tracking_code: \"tracking-private\", expires_in: 120, delivery_mode: \"sms\", code_length: 5 };\n    },\n    verifyOtp: async () => {\n      calls.verifyOtp += 1;\n      return { tokens: tokenPair(), is_new: false, user: { id: 47, display_name: \"آزاده نمونه\", roles: [\"nahan_specialist\"], phone: \"09121234567\" } };\n    },\n    refresh: async () => {\n      calls.refresh += 1;\n      return { tokens: tokenPair(\"rotated\") };\n    },\n    me: async () => {\n      calls.me += 1;\n      return { id: 47, display_name: \"آزاده نمونه\", roles: [\"nahan_specialist\"], phone: null, specialist_post_id: 0 };\n    },\n    logoutRefresh: async () => { calls.logoutRefresh += 1; return { logged_out: true }; },\n    ...overrides,\n  };\n}\n\nfunction coordinator(\n  authGateway = gateway(),\n  authSession = session(),\n  readiness: () => Promise<void> = async () => {},\n) {\n  return {\n    gateway: authGateway,\n    session: authSession,\n    coordinator: createAuthCoordinator({\n      gateway: authGateway,\n      session: authSession,\n      now: () => now,\n      uuid: () => \"session-or-generation-id\",\n      ensureOtpReady: readiness,\n      refreshCoordinator: createRefreshCoordinator(() => now),\n    }),\n  };\n}\n\nasync function rejects(operation: () => Promise<unknown>, code: string, status: number): Promise<void> {\n  await assert.rejects(operation, (error: unknown) => {\n    assert.ok(error instanceof AuthCoordinatorError);\n    assert.equal(error.code, code);\n    assert.equal(error.status, status);\n    const serialized = JSON.stringify(error, Object.getOwnPropertyNames(error));\n    for (const secret of [\"tracking-private\", \"09121234567\", \"access-a\", \"refresh-a\", \"access-rotated\", \"refresh-rotated\"]) {\n      assert.equal(serialized.includes(secret), false);\n    }\n    return true;\n  });\n}\n\ntest(\"preserves safe upstream validation and rate semantics through actual callbacks\", async () => {\n  for (const [upstream, code, status] of [\n    [\"otp_rate_limited\", \"rate_limited\", 429], [\"otp_rate_limited_ip\", \"rate_limited\", 429],\n    [\"otp_throttled\", \"rate_limited\", 429], [\"otp_too_many_attempts\", \"rate_limited\", 429],\n    [\"invalid_phone\", \"invalid_request\", 422], [\"otp_consumed\", \"challenge_expired\", 410],\n  ] as const) {\n    const fixture = coordinator(gateway({ verifyOtp: async () => { throw { code: upstream, message: \"private\" }; } }));\n    await fixture.coordinator.requestOtp(\"09121234567\", \"client\");\n    await rejects(() => fixture.coordinator.verifyOtp(\"12345\"), code, status);\n  }\n});\n\ntest('lost refresh credentials are 401, provider/config failures stay 503',async()=>{\n for(const upstream of ['invalid_refresh','revoked_refresh','expired_refresh','invalid_response']){\n  const fixture=coordinator(gateway({refresh:async()=>{throw {code:upstream,message:'private'};}}));\n  await fixture.coordinator.requestOtp('09121234567','client');await fixture.coordinator.verifyOtp('12345');\n  await rejects(()=>fixture.coordinator.refresh(),upstream==='invalid_response'?'auth_unavailable':'unauthenticated',upstream==='invalid_response'?503:401);\n }\n});\n\ntest(\"new-account onboarding is presentation from server role, not selected role permission\", async () => {\n  const fixture = coordinator(gateway({ verifyOtp: async () => ({tokens:tokenPair(),is_new:true,user:{id:47,display_name:\"نام\",roles:[\"nahan_specialist\"],phone:\"09121234567\"}}) }));\n  await fixture.coordinator.requestOtp(\"09121234567\", \"client\");\n  const result = await fixture.coordinator.verifyOtp(\"12345\");\n  assert.equal(result.account.role, \"specialist\");\n  assert.equal((result as unknown as {onboardingTo:string}).onboardingTo, \"/pro/profile\");\n});\n\ntest(\"gates OTP issuance before dispatch and stores only sealed challenge context\", async () => {\n  const blocked = coordinator(gateway(), session(), async () => { throw new AuthCoordinatorError(\"auth_unavailable\", 503); });\n  await rejects(() => blocked.coordinator.requestOtp(\"09121234567\", \"client\"), \"auth_unavailable\", 503);\n  assert.equal(blocked.gateway.calls.requestOtp, 0);\n\n  const active = coordinator();\n  assert.deepEqual(await active.coordinator.requestOtp(\"09121234567\", \"client\"), {\n    challenge: { expiresAt: now + 120_000, codeLength: 5, isSimulated: false },\n  });\n  assert.equal(active.gateway.calls.requestOtp, 1);\n  assert.deepEqual(active.session.saved[0], {\n    sessionId: \"session-or-generation-id\",\n    version: 1,\n    challenge: {\n      trackingCode: \"tracking-private\",\n      role: \"client\",\n      codeLength: 5,\n      deliveryMode: \"sms\",\n      expiresAt: now + 120_000,\n    },\n  });\n  assert.equal(JSON.stringify(active.session.saved[0]).includes(\"09121234567\"), false);\n});\n\ntest(\"uses server-stored challenge dimensions, consumes it before verification, and honors backend role\", async () => {\n  const active = coordinator();\n  await active.coordinator.requestOtp(\"09121234567\", \"client\");\n  const verified = await active.coordinator.verifyOtp(\"۱۲۳۴۵\");\n  assert.deepEqual(verified, { account, redirectTo: \"/pro\" });\n  assert.equal(active.gateway.calls.verifyOtp, 1);\n  const sealed = active.session.saved[1];\n  assert.deepEqual(sealed.auth?.account, account);\n  assert.equal(sealed.challenge, undefined);\n  assert.equal(JSON.stringify(sealed).includes(\"tracking-private\"), false);\n\n  const six = coordinator();\n  await six.session.save({\n    sessionId: \"six-session\",\n    version: 1,\n    challenge: { trackingCode: \"tracking-6\", role: \"specialist\", codeLength: 6, deliveryMode: \"local_simulated\", expiresAt: now + 1 },\n  });\n  await rejects(() => six.coordinator.verifyOtp(\"12345\"), \"invalid_code\", 422);\n  assert.equal(six.gateway.calls.verifyOtp, 0);\n});\n\ntest(\"never grants a session from expired, missing, or unsupported-role challenge results\", async () => {\n  const expired = coordinator();\n  await expired.session.save({ sessionId: \"expired\", version: 1, challenge: { trackingCode: \"t\", role: \"client\", codeLength: 5, deliveryMode: \"sms\", expiresAt: now } });\n  await rejects(() => expired.coordinator.verifyOtp(\"12345\"), \"challenge_expired\", 410);\n  assert.equal(expired.gateway.calls.verifyOtp, 0);\n\n  const invalidRoleGateway = gateway({\n    verifyOtp: async () => ({ tokens: tokenPair(), is_new: false, user: { id: 47, display_name: \"x\", roles: [\"administrator\"], phone: \"09121234567\" } }),\n  });\n  const invalidRole = coordinator(invalidRoleGateway);\n  await invalidRole.coordinator.requestOtp(\"09121234567\", \"client\");\n  await rejects(() => invalidRole.coordinator.verifyOtp(\"12345\"), \"unsupported_role\", 403);\n  assert.equal(invalidRole.session.read()?.auth, undefined);\n});\n\ntest(\"returns safe GET projections without exposing tracking or saving on reads\", async () => {\n  const active = coordinator();\n  await active.coordinator.requestOtp(\"09121234567\", \"client\");\n  assert.deepEqual(active.coordinator.challenge(), { expiresAt: now + 120_000, codeLength: 5, isSimulated: false });\n  assert.equal(JSON.stringify(active.coordinator.challenge()).includes(\"tracking\"), false);\n  const savedBefore = active.session.saved.length;\n  await active.coordinator.verifyOtp(\"12345\");\n  assert.deepEqual(await active.coordinator.me(), { account });\n  assert.equal(active.session.saved.length, savedBefore + 1);\n\n  const stale = coordinator(undefined, session({ sessionId: \"s\", version: 1, auth: {\n    accessToken: \"expired\", accessExpiresAt: now, refreshToken: \"refresh\", refreshExpiresAt: now + 1, account, generation: \"g\",\n  } }));\n  await rejects(() => stale.coordinator.me(), \"refresh_required\", 401);\n  assert.equal(stale.gateway.calls.me, 0);\n});\n\ntest(\"coalesces refresh by generation and prevents a logout race from restoring local auth\", async () => {\n  let releaseRefresh: (() => void) | undefined;\n  const refreshStarted = new Promise<void>((resolve) => { releaseRefresh = resolve; });\n  const rotatingGateway = gateway({\n    refresh: async () => {\n      rotatingGateway.calls.refresh += 1;\n      await refreshStarted;\n      return { tokens: tokenPair(\"rotated\") };\n    },\n  });\n  const authSession = session({\n    sessionId: \"race-session\",\n    version: 1,\n    auth: { accessToken: \"access-a\", accessExpiresAt: now + 1, refreshToken: \"refresh-a\", refreshExpiresAt: now + 2, account, generation: \"generation-a\" },\n  });\n  const refreshCoordinator = createRefreshCoordinator(() => now);\n  const active = createAuthCoordinator({ gateway: rotatingGateway, session: authSession, now: () => now, uuid: () => \"unused\", ensureOtpReady: async () => {}, refreshCoordinator });\n  const first = active.refresh();\n  const second = active.refresh();\n  assert.equal(rotatingGateway.calls.refresh, 1);\n  const logout = active.logout();\n  releaseRefresh?.();\n  await rejects(() => first, \"refresh_cancelled\", 401);\n  await rejects(() => second, \"refresh_cancelled\", 401);\n  await logout;\n  assert.equal(authSession.destroyed, 1);\n  assert.equal(authSession.read(), undefined);\n  assert.equal(rotatingGateway.calls.logoutRefresh, 2);\n  assert.equal(authSession.saved.some((entry) => entry.auth?.refreshToken === \"refresh-rotated\"), false);\n});\n\ntest(\"keeps retryable challenges but clears only successful or terminal verification outcomes\", async () => {\n  let firstAttempt = true;\n  const retryGateway = gateway({\n    verifyOtp: async () => {\n      retryGateway.calls.verifyOtp += 1;\n      if (firstAttempt) {\n        firstAttempt = false;\n        throw Object.assign(new Error(\"wrong code\"), { code: \"otp_invalid\" });\n      }\n      return { tokens: tokenPair(), is_new: false, user: { id: 47, display_name: \"آزاده نمونه\", roles: [\"nahan_specialist\"], phone: \"09121234567\" } };\n    },\n  });\n  const retry = coordinator(retryGateway);\n  await retry.coordinator.requestOtp(\"09121234567\", \"client\");\n  await rejects(() => retry.coordinator.verifyOtp(\"00000\"), \"invalid_code\", 422);\n  assert.equal(retry.session.read()?.challenge?.trackingCode, \"tracking-private\");\n  assert.deepEqual(await retry.coordinator.verifyOtp(\"12345\"), { account, redirectTo: \"/pro\" });\n  assert.equal(retry.session.read()?.challenge, undefined);\n  assert.equal(retry.session.read()?.auth?.account.role, \"specialist\");\n\n  const terminalGateway = gateway({\n    verifyOtp: async () => { throw Object.assign(new Error(\"expired\"), { code: \"otp_expired\" }); },\n  });\n  const terminal = coordinator(terminalGateway);\n  await terminal.coordinator.requestOtp(\"09121234567\", \"client\");\n  await rejects(() => terminal.coordinator.verifyOtp(\"12345\"), \"challenge_expired\", 410);\n  assert.equal(terminal.session.read()?.challenge, undefined);\n  assert.equal(terminal.session.read()?.auth, undefined);\n});\n\ntest(\"serializes refresh finalization across distinct route session ports and rejects stale sealed auth\", async () => {\n  const initial: AuthSessionData = {\n    sessionId: \"9aa0a1b2-c3d4-4e5f-8a90-b1c2d3e4f5a6\",\n    version: 1,\n    auth: { accessToken: \"access-a\", accessExpiresAt: now + 1, refreshToken: \"refresh-a\", refreshExpiresAt: now + 2, account, generation: \"84e86fd2-2205-4880-a65c-4b8da64489f1\" },\n  };\n  const events: string[] = [];\n  let saveEntered!: () => void;\n  let releaseSave!: () => void;\n  const saveStarted = new Promise<void>((resolve) => { saveEntered = resolve; });\n  const saveRelease = new Promise<void>((resolve) => { releaseSave = resolve; });\n  function routePort(name: string, blockSave: boolean): AuthSessionPort & { readonly destroyed: number; state(): AuthSessionData | undefined } {\n    let state: AuthSessionData | undefined = structuredClone(initial);\n    let destroyed = 0;\n    return {\n      get destroyed() { return destroyed; },\n      state: () => state,\n      read: () => state,\n      save: async (next) => {\n        events.push(`${name}:save-start`);\n        if (blockSave) {\n          saveEntered();\n          await saveRelease;\n        }\n        state = structuredClone(next);\n        events.push(`${name}:save-end`);\n      },\n      destroy: () => { state = undefined; destroyed += 1; events.push(`${name}:destroy`); },\n    };\n  }\n  const refreshPort = routePort(\"refresh\", true);\n  const logoutPort = routePort(\"logout\", false);\n  const stalePort = routePort(\"stale\", false);\n  const refreshCoordinator = createRefreshCoordinator(() => now);\n  const rotatingGateway = gateway();\n  const refreshing = createAuthCoordinator({ gateway: rotatingGateway, session: refreshPort, now: () => now, uuid: () => \"unused\", ensureOtpReady: async () => {}, refreshCoordinator });\n  const loggingOut = createAuthCoordinator({ gateway: rotatingGateway, session: logoutPort, now: () => now, uuid: () => \"unused\", ensureOtpReady: async () => {}, refreshCoordinator });\n  const stale = createAuthCoordinator({ gateway: rotatingGateway, session: stalePort, now: () => now, uuid: () => \"unused\", ensureOtpReady: async () => {}, refreshCoordinator });\n\n  const refresh = refreshing.refresh();\n  await saveStarted;\n  const logout = loggingOut.logout();\n  await Promise.resolve();\n  assert.equal(logoutPort.destroyed, 0);\n  releaseSave();\n  await rejects(() => refresh, \"refresh_cancelled\", 401);\n  await logout;\n  assert.equal(logoutPort.destroyed, 1);\n  assert.equal(events.at(-1), \"logout:destroy\");\n  assert.equal(rotatingGateway.calls.logoutRefresh, 2);\n  const meCalls = rotatingGateway.calls.me;\n  await rejects(() => stale.me(), \"unauthenticated\", 401);\n  assert.equal(stalePort.destroyed, 1);\n  assert.equal(rotatingGateway.calls.me, meCalls);\n});\n\n\n\ntest(\"never evicts unsettled refresh generations when the bounded coordinator crosses 512 live entries\", async () => {\n  const refreshCoordinator = createRefreshCoordinator(() => now);\n  const releases: Array<() => void> = [];\n  const operations: Array<Promise<void>> = [];\n  for (let index = 0; index < 513; index += 1) {\n    const key = `live-generation-${index}`;\n    let release!: () => void;\n    const pending = new Promise<void>((resolve) => { release = resolve; });\n    releases.push(release);\n    operations.push(refreshCoordinator.run(key, async (isCancelled) => {\n      await pending;\n      if (isCancelled()) {\n        throw new AuthCoordinatorError(\"refresh_cancelled\");\n      }\n    }));\n  }\n  await Promise.resolve();\n\n  const cancellation = refreshCoordinator.cancelAndWait(\"live-generation-0\");\n  await Promise.resolve();\n  releases[0]();\n  await cancellation;\n  await assert.rejects(operations[0], (error: unknown) => {\n    assert.ok(error instanceof AuthCoordinatorError);\n    assert.equal(error.code, \"refresh_cancelled\");\n    return true;\n  });\n\n  for (let index = 1; index < releases.length; index += 1) {\n    releases[index]();\n  }\n  const settled = await Promise.allSettled(operations);\n  assert.equal(settled.filter((result) => result.status === \"rejected\").length, 2);\n});\n\n\n\n\ntest(\"records an absent cancellation tombstone at live-capacity saturation and expires it safely\", async () => {\n  let clock = now;\n  const refreshCoordinator = createRefreshCoordinator(() => clock);\n  const releases: Array<() => void> = [];\n  const operations: Array<Promise<void>> = [];\n  for (let index = 0; index < 512; index += 1) {\n    let release!: () => void;\n    const pending = new Promise<void>((resolve) => { release = resolve; });\n    releases.push(release);\n    operations.push(refreshCoordinator.run(`saturated-generation-${index}`, async () => pending));\n  }\n  await Promise.resolve();\n\n  await refreshCoordinator.cancelAndWait(\"absent-after-saturation\");\n  releases[0]();\n  await operations[0];\n  let staleOperationStarted = false;\n  await assert.rejects(\n    refreshCoordinator.run(\"absent-after-saturation\", async () => { staleOperationStarted = true; }),\n    (error: unknown) => {\n      assert.ok(error instanceof AuthCoordinatorError);\n      assert.equal(error.code, \"refresh_cancelled\");\n      return true;\n    },\n  );\n  assert.equal(staleOperationStarted, false);\n\n  for (let index = 1; index < releases.length; index += 1) releases[index]();\n  await Promise.all(operations.slice(1));\n  clock += 5_001;\n  await assert.doesNotReject(refreshCoordinator.run(\"absent-after-saturation\", async () => undefined));\n});\n\n\ntest(\"keeps remote logout failure local-terminal and never serializes credentials\", async () => {\n  const failingGateway = gateway({ logoutRefresh: async () => { throw new Error(\"refresh-a remote failure\"); } });\n  const active = coordinator(failingGateway, session({\n    sessionId: \"logout-session\", version: 1,\n    auth: { accessToken: \"access-a\", accessExpiresAt: now + 1, refreshToken: \"refresh-a\", refreshExpiresAt: now + 2, account, generation: \"generation-a\" },\n  }));\n  await assert.doesNotReject(() => active.coordinator.logout());\n  assert.equal(active.session.destroyed, 1);\n  assert.equal(active.session.read(), undefined);\n});\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/services/auth/session-seal.test.ts": {
      "sha256": "f04262e7bf653a2424f6ad3d2bf5ed8111ea04eab758cf0f193f5148ade9663a",
      "text": "import assert from \"node:assert/strict\";\nimport { test } from \"node:test\";\nimport { getIronSession, type CookieStore } from \"iron-session\";\nimport type { AuthSessionData } from \"./auth-coordinator.ts\";\n\nconst password = \"test-password-only-not-a-deployment-secret\".repeat(2);\n\ntest(\"real iron-session v9 seal stays below one host-only 4KiB cookie with realistic private auth state\", async () => {\n  const writes: Array<{ name: string; value: string; options: Record<string, unknown> }> = [];\n  const store: CookieStore = {\n    get: () => undefined,\n    getAll: () => [],\n    set: (name, value, options) => { writes.push({ name, value, options: options as Record<string, unknown> }); },\n  };\n  const session = await getIronSession<AuthSessionData>(store, {\n    cookieName: \"karban_auth\",\n    password,\n    ttl: 2_592_000,\n    cookieOptions: { httpOnly: true, sameSite: \"lax\", secure: false, path: \"/\" },\n  });\n  Object.assign(session, {\n    sessionId: \"9aa0a1b2-c3d4-4e5f-8a90-b1c2d3e4f5a6\",\n    version: 1,\n    challenge: {\n      trackingCode: \"4670bf85-7183-46c8-9fba-79198fd2ee53\",\n      role: \"specialist\",\n      codeLength: 6,\n      deliveryMode: \"local_simulated\",\n      expiresAt: 1_700_000_120_000,\n    },\n    auth: {\n      accessToken: `eyJhbGciOiJIUzI1NiJ9.${\"a\".repeat(640)}.signature`,\n      accessExpiresAt: 1_700_000_900_000,\n      refreshToken: \"r\".repeat(128),\n      refreshExpiresAt: 1_702_592_000_000,\n      account: { id: 47, displayName: \"آزاده نمونه\", role: \"specialist\" },\n      generation: \"84e86fd2-2205-4880-a65c-4b8da64489f1\",\n    },\n  } satisfies AuthSessionData);\n  await session.save();\n\n  assert.equal(writes.length, 1);\n  const [cookie] = writes;\n  assert.equal(cookie.name, \"karban_auth\");\n  assert.ok(cookie.value.length < 4_096);\n  assert.equal(cookie.options.httpOnly, true);\n  assert.equal(cookie.options.sameSite, \"lax\");\n  assert.equal(cookie.options.secure, false);\n  assert.equal(cookie.options.path, \"/\");\n  assert.equal(\"domain\" in cookie.options, false);\n});\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/services/auth/auth-session-port.test.ts": {
      "sha256": "59ed553ebe6e424e72080c4c6eaeaf3a8ef15d02809ff35613ecbd24c244ff7c",
      "text": "import assert from \"node:assert/strict\";\nimport { test } from \"node:test\";\nimport { getIronSession, type CookieStore } from \"iron-session\";\nimport * as storage from \"./auth-session-storage.ts\";\nimport { parseSealedAuthSession } from \"./auth-session-schema.ts\";\nimport type { AuthSessionData } from \"./auth-coordinator.ts\";\nconst initial:AuthSessionData={sessionId:\"9aa0a1b2-c3d4-4e5f-8a90-b1c2d3e4f5a6\",version:1,auth:{accessToken:\"private-access\",refreshToken:\"private-refresh\",accessExpiresAt:Date.now()+90_000,refreshExpiresAt:Date.now()+900_000,generation:\"84e86fd2-2205-4880-a65c-4b8da64489f1\",account:{id:47,displayName:\"نام\",role:\"specialist\"}}};\n\ntest(\"real iron-session production port roundtrip replaces summary, preserves private credentials and never reintroduces a challenge\",async()=>{\n  assert.equal(typeof storage.createIronSessionPort,\"function\",\"production iron-session port missing\");\n  let cookie=\"\";let writes=0;\n  const store:CookieStore={get:(name)=>name===\"test-auth\"&&cookie?{name:\"test-auth\",value:cookie}:undefined,getAll:()=>[],set:(_name,value)=>{cookie=value;writes++;}};\n  const options={cookieName:\"test-auth\",password:\"test-only-not-a-deployment-secret\".repeat(2),cookieOptions:{httpOnly:true,sameSite:\"lax\" as const,path:\"/\",secure:false}};\n  const session=await getIronSession<AuthSessionData>(store,options);\n  const port=storage.createIronSessionPort(session,undefined,false);\n  await port.save(initial);\n  const next={...initial,auth:{...initial.auth!,account:{...initial.auth!.account,displayName:\"تازه\"}}};\n  await port.save(next);\n  const reread=await getIronSession<AuthSessionData>(store,options);\n  assert.deepEqual(parseSealedAuthSession(reread,Date.now()),next);\n  assert.equal(\"challenge\" in reread,false);assert.equal(reread.auth!.refreshToken,\"private-refresh\");assert.equal(writes,2);\n  const readonly=storage.createIronSessionPort(reread,next,true);\n  readonly.destroy();assert.equal(writes,2);await assert.rejects(readonly.save(next));assert.equal(writes,2);\n});\n\ntest(\"failed cookie save does not replace the port's current authoritative state\",async()=>{\n  const fake={save:async()=>{throw Error(\"failed\");},destroy:()=>{},updateConfig:()=>{}};\n  const port=storage.createIronSessionPort(fake as Awaited<ReturnType<typeof getIronSession<AuthSessionData>>>,initial,false);\n  await assert.rejects(port.save({...initial,auth:{...initial.auth!,account:{...initial.auth!.account,displayName:\"late\"}}}));\n  assert.equal(port.read()!.auth!.account.displayName,\"نام\");\n});\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/services/auth/auth-bff-policy.ts": {
      "sha256": "a1fd52db19aff144beddd7dc53c68fd1f37036f5f0a68dba1ccfcf6874f3e678",
      "text": "import { AuthCoordinatorError } from \"./auth-coordinator.ts\";\nimport type { UpstreamLocalStatus } from \"./contracts.ts\";\n\nexport interface OtpReadinessDependencies {\n  isLoopback: boolean;\n  localDevelopmentEnabled: boolean;\n  getLocalStatus: () => Promise<UpstreamLocalStatus>;\n}\n\nexport function createOtpReadinessCheck(dependencies: OtpReadinessDependencies): () => Promise<void> {\n  return async () => {\n    if (!dependencies.isLoopback) {\n      return;\n    }\n    if (!dependencies.localDevelopmentEnabled) {\n      throw new AuthCoordinatorError(\"auth_unavailable\");\n    }\n    try {\n      const status = await dependencies.getLocalStatus();\n      if (status.otpReady !== true || status.credentialProvenanceReady !== true) {\n        throw new AuthCoordinatorError(\"auth_unavailable\");\n      }\n    } catch (error) {\n      if (error instanceof AuthCoordinatorError) {\n        throw error;\n      }\n      throw new AuthCoordinatorError(\"auth_unavailable\");\n    }\n  };\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/services/auth/contracts.test.ts": {
      "sha256": "20d59992ace2071487b87d3a446555e609161b2096757b57b566496cc3c26dc4",
      "text": "import assert from \"node:assert/strict\";\nimport { test } from \"node:test\";\nimport {\n  AuthResponseError,\n  parseUpstreamLogoutResult,\n  parseUpstreamMeUser,\n  parseUpstreamOtpChallenge,\n  parseUpstreamRefreshResult,\n  parseUpstreamTokenPair,\n  parseUpstreamVerifyResult,\n} from \"./contracts.ts\";\n\nconst tokens = Object.freeze({\n  access_token: \"eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOjQ3LCJ0eXBlIjoiYWNjZXNzIn0.synthetic-signature\",\n  access_expires_in: 900,\n  refresh_token: \"f5c26ab3447d73a4d90dcaa352d8ecf51b064dbd4731f34abc5c98a351d7de22\",\n  refresh_expires_in: 2_592_000,\n  token_type: \"Bearer\",\n});\nconst verifiedUser = Object.freeze({\n  id: 47,\n  display_name: \"آزاده نمونه\",\n  roles: Object.freeze([\"nahan_specialist\"]),\n  phone: \"09129876543\",\n});\nconst verified = Object.freeze({ tokens, is_new: false, user: verifiedUser });\nconst currentUser = Object.freeze({ ...verifiedUser, specialist_post_id: 71 });\nconst challenge = Object.freeze({\n  tracking_code: \"f64a7a08-a32a-4d61-9be7-c425a8b8ee4c\",\n  expires_in: 120,\n});\nconst invalidPositiveIntegers: readonly unknown[] = [\n  0, -1, 1.5, NaN, Infinity, Number.MAX_SAFE_INTEGER + 1, \"120\", null, undefined,\n];\n\nfunction assertInvalidResponse(operation: () => unknown): void {\n  assert.throws(operation, (error: unknown) => {\n    assert.ok(error instanceof AuthResponseError);\n    assert.equal(error.code, \"invalid_response\");\n    assert.equal(error.status, 502);\n    assert.match(error.message, /[؀-ۿ]/u);\n    assert.equal(\"cause\" in error, false);\n    assert.equal(\"data\" in error, false);\n    const serialized = JSON.stringify(error, Object.getOwnPropertyNames(error));\n    for (const secret of [\n      tokens.access_token,\n      tokens.refresh_token,\n      verifiedUser.phone,\n      challenge.tracking_code,\n      \"58319\",\n      \"synthetic-raw-response\",\n      \"access_token\",\n      \"refresh_token\",\n    ]) {\n      assert.equal(serialized.includes(secret), false);\n    }\n    return true;\n  });\n}\n\nfunction assertRequiredFields(\n  parse: (value: unknown) => unknown,\n  fixture: Record<string, unknown>,\n): void {\n  for (const field of Object.keys(fixture)) {\n    const incomplete = { ...fixture };\n    delete incomplete[field];\n    assertInvalidResponse(() => parse(incomplete));\n  }\n}\n\n// Break caught: passing raw data through preserves unknown fields or invents a resend TTL.\ntest(\"parses a challenge with its actual TTL and discards unknown fields\", () => {\n  const input = Object.freeze({\n    ...challenge,\n    expires_in: 37,\n    resend_after: 60,\n    unknown_backend_field: \"synthetic-raw-response\",\n  });\n  assert.deepEqual(parseUpstreamOtpChallenge(input), {\n    tracking_code: \"f64a7a08-a32a-4d61-9be7-c425a8b8ee4c\",\n    expires_in: 37,\n    delivery_mode: \"sms\",\n    code_length: 5,\n  });\n});\n\ntest(\"rejects missing, empty or malformed challenge fields and unsafe TTLs\", () => {\n  assertRequiredFields(parseUpstreamOtpChallenge, challenge);\n  for (const expires_in of invalidPositiveIntegers) {\n    assertInvalidResponse(() => parseUpstreamOtpChallenge({ ...challenge, expires_in }));\n  }\n  for (const tracking_code of [\"\", \"   \", null, 23, undefined]) {\n    assertInvalidResponse(() => parseUpstreamOtpChallenge({ ...challenge, tracking_code }));\n  }\n});\n\ntest(\"parses all token-pair fields without hardcoding backend lifetimes\", () => {\n  assert.deepEqual(\n    parseUpstreamTokenPair(Object.freeze({\n      ...tokens,\n      access_expires_in: 73,\n      refresh_expires_in: 86401,\n      unknown_backend_field: \"synthetic-raw-response\",\n    })),\n    {\n      access_token: \"eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOjQ3LCJ0eXBlIjoiYWNjZXNzIn0.synthetic-signature\",\n      access_expires_in: 73,\n      refresh_token: \"f5c26ab3447d73a4d90dcaa352d8ecf51b064dbd4731f34abc5c98a351d7de22\",\n      refresh_expires_in: 86401,\n      token_type: \"Bearer\",\n    },\n  );\n});\n\ntest(\"rejects missing or malformed token-pair fields with no defaults\", () => {\n  assertRequiredFields(parseUpstreamTokenPair, tokens);\n  for (const field of [\"access_expires_in\", \"refresh_expires_in\"]) {\n    for (const value of invalidPositiveIntegers) {\n      assertInvalidResponse(() => parseUpstreamTokenPair({ ...tokens, [field]: value }));\n    }\n  }\n  for (const field of [\"access_token\", \"refresh_token\"]) {\n    for (const value of [\"\", \" \\n\", null, 47, undefined]) {\n      assertInvalidResponse(() => parseUpstreamTokenPair({ ...tokens, [field]: value }));\n    }\n  }\n  for (const token_type of [\"bearer\", \"Basic\", \"\", null, true, undefined]) {\n    assertInvalidResponse(() => parseUpstreamTokenPair({ ...tokens, token_type }));\n  }\n});\n\ntest(\"parses a complete verify result into fresh nested DTOs\", () => {\n  const input = Object.freeze({\n    ...verified,\n    tokens: Object.freeze({ ...tokens, unknown_backend_field: \"synthetic-raw-response\" }),\n    user: Object.freeze({ ...verifiedUser, unknown_backend_field: \"synthetic-raw-response\" }),\n    unknown_backend_field: \"synthetic-raw-response\",\n  });\n  const parsed = parseUpstreamVerifyResult(input);\n  assert.deepEqual(parsed, {\n    tokens: {\n      access_token: \"eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOjQ3LCJ0eXBlIjoiYWNjZXNzIn0.synthetic-signature\",\n      access_expires_in: 900,\n      refresh_token: \"f5c26ab3447d73a4d90dcaa352d8ecf51b064dbd4731f34abc5c98a351d7de22\",\n      refresh_expires_in: 2_592_000,\n      token_type: \"Bearer\",\n    },\n    is_new: false,\n    user: {\n      id: 47,\n      display_name: \"آزاده نمونه\",\n      roles: [\"nahan_specialist\"],\n      phone: \"09129876543\",\n    },\n  });\n  assert.notEqual(parsed, input);\n  assert.notEqual(parsed.tokens, input.tokens);\n  assert.notEqual(parsed.user, input.user);\n  assert.notEqual(parsed.user.roles, input.user.roles);\n  assert.equal(parseUpstreamVerifyResult({ ...verified, is_new: true }).is_new, true);\n});\n\ntest(\"rejects missing verify fields, nonboolean is_new and malformed nested tokens\", () => {\n  assertRequiredFields(parseUpstreamVerifyResult, verified);\n  for (const is_new of [\"false\", 0, 1, null, undefined]) {\n    assertInvalidResponse(() => parseUpstreamVerifyResult({ ...verified, is_new }));\n  }\n  for (const value of [null, {}, { ...tokens, refresh_expires_in: 0 }]) {\n    assertInvalidResponse(() => parseUpstreamVerifyResult({ ...verified, tokens: value }));\n  }\n});\n\ntest(\"rejects incomplete verified users, unsafe IDs and wrong field types\", () => {\n  for (const field of Object.keys(verifiedUser)) {\n    const user: Record<string, unknown> = { ...verifiedUser };\n    delete user[field];\n    assertInvalidResponse(() => parseUpstreamVerifyResult({ ...verified, user }));\n  }\n  for (const id of invalidPositiveIntegers) {\n    assertInvalidResponse(() => parseUpstreamVerifyResult({ ...verified, user: { ...verifiedUser, id } }));\n  }\n  for (const [field, values] of [\n    [\"display_name\", [null, 47, undefined]],\n    [\"phone\", [null, 47, undefined]],\n    [\"roles\", [null, \"nahan_client\", [\"nahan_client\", 42], [null], new Array(1)]],\n  ] as const) {\n    for (const value of values) {\n      assertInvalidResponse(() => parseUpstreamVerifyResult({ ...verified, user: { ...verifiedUser, [field]: value } }));\n    }\n  }\n  assertInvalidResponse(() => parseUpstreamVerifyResult({ ...verified, user: null }));\n});\n\ntest(\"keeps backend role strings and empty display names for conservative policy\", () => {\n  const parsed = parseUpstreamVerifyResult({\n    ...verified,\n    user: { ...verifiedUser, display_name: \"\", roles: [\"administrator\", \"nahan_specialist\"] },\n  });\n  assert.equal(parsed.user.display_name, \"\");\n  assert.deepEqual(parsed.user.roles, [\"administrator\", \"nahan_specialist\"]);\n});\n\ntest(\"parses the required refresh wrapper and discards unknown fields\", () => {\n  assert.deepEqual(\n    parseUpstreamRefreshResult(Object.freeze({ tokens, unknown_backend_field: \"synthetic-raw-response\" })),\n    { tokens: {\n      access_token: \"eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOjQ3LCJ0eXBlIjoiYWNjZXNzIn0.synthetic-signature\",\n      access_expires_in: 900,\n      refresh_token: \"f5c26ab3447d73a4d90dcaa352d8ecf51b064dbd4731f34abc5c98a351d7de22\",\n      refresh_expires_in: 2_592_000,\n      token_type: \"Bearer\",\n    } },\n  );\n});\n\ntest(\"rejects naked, missing or malformed refresh token pairs\", () => {\n  for (const value of [tokens, {}, { tokens: null }, { tokens: {} }, { tokens: { ...tokens, token_type: \"Basic\" } }]) {\n    assertInvalidResponse(() => parseUpstreamRefreshResult(value));\n  }\n});\n\ntest(\"parses current-user phone null and specialist ID zero only where documented\", () => {\n  assert.deepEqual(\n    parseUpstreamMeUser(Object.freeze({ ...currentUser, phone: null, specialist_post_id: 0, unknown_backend_field: \"synthetic-raw-response\" })),\n    { id: 47, display_name: \"آزاده نمونه\", roles: [\"nahan_specialist\"], phone: null, specialist_post_id: 0 },\n  );\n  assert.deepEqual(parseUpstreamMeUser(currentUser), {\n    id: 47,\n    display_name: \"آزاده نمونه\",\n    roles: [\"nahan_specialist\"],\n    phone: \"09129876543\",\n    specialist_post_id: 71,\n  });\n});\n\ntest(\"rejects incomplete current users and invalid IDs, roles, names or phone types\", () => {\n  assertRequiredFields(parseUpstreamMeUser, currentUser);\n  for (const id of invalidPositiveIntegers) {\n    assertInvalidResponse(() => parseUpstreamMeUser({ ...currentUser, id }));\n  }\n  for (const specialist_post_id of [-1, 1.5, NaN, Infinity, Number.MAX_SAFE_INTEGER + 1, \"0\", null, undefined]) {\n    assertInvalidResponse(() => parseUpstreamMeUser({ ...currentUser, specialist_post_id }));\n  }\n  for (const [field, values] of [\n    [\"display_name\", [null, 47, undefined]],\n    [\"phone\", [47, false, undefined]],\n    [\"roles\", [null, {}, \"nahan_specialist\", [47], new Array(1)]],\n  ] as const) {\n    for (const value of values) {\n      assertInvalidResponse(() => parseUpstreamMeUser({ ...currentUser, [field]: value }));\n    }\n  }\n});\n\ntest(\"requires a true logout acknowledgment rather than pretending success\", () => {\n  assert.deepEqual(parseUpstreamLogoutResult(Object.freeze({ logged_out: true, unknown_backend_field: \"synthetic-raw-response\" })), { logged_out: true });\n  for (const value of [{}, { logged_out: false }, { logged_out: \"true\" }, { logged_out: 1 }, { logged_out: null }]) {\n    assertInvalidResponse(() => parseUpstreamLogoutResult(value));\n  }\n});\n\ntest(\"rejects null, array and primitive payloads for every upstream operation\", () => {\n  for (const parse of [\n    parseUpstreamOtpChallenge,\n    parseUpstreamTokenPair,\n    parseUpstreamVerifyResult,\n    parseUpstreamRefreshResult,\n    parseUpstreamMeUser,\n    parseUpstreamLogoutResult,\n  ]) {\n    for (const value of [null, undefined, [], \"synthetic-raw-response\", 47, true]) {\n      assertInvalidResponse(() => parse(value));\n    }\n  }\n});\n\ntest(\"parses legacy five-digit and explicit local six-digit OTP challenge provenance\", () => {\n  assert.deepEqual(parseUpstreamOtpChallenge(challenge), {\n    tracking_code: \"f64a7a08-a32a-4d61-9be7-c425a8b8ee4c\",\n    expires_in: 120,\n    delivery_mode: \"sms\",\n    code_length: 5,\n  });\n  assert.deepEqual(parseUpstreamOtpChallenge({\n    ...challenge,\n    delivery_mode: \"local_simulated\",\n    code_length: 6,\n  }), {\n    tracking_code: \"f64a7a08-a32a-4d61-9be7-c425a8b8ee4c\",\n    expires_in: 120,\n    delivery_mode: \"local_simulated\",\n    code_length: 6,\n  });\n});\n\ntest(\"rejects malformed or inconsistent OTP challenge provenance instead of inferring local mode\", () => {\n  for (const value of [\n    { ...challenge, delivery_mode: \"local_simulated\" },\n    { ...challenge, code_length: 6 },\n    { ...challenge, delivery_mode: \"sms\", code_length: 6 },\n    { ...challenge, delivery_mode: \"local_simulated\", code_length: 5 },\n    { ...challenge, delivery_mode: \"local_simulated\", code_length: 7 },\n    { ...challenge, delivery_mode: \"browser-local\", code_length: 6 },\n  ]) {\n    assertInvalidResponse(() => parseUpstreamOtpChallenge(value));\n  }\n});\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/services/auth/authenticated-operation.test.ts": {
      "sha256": "88e66e681ff5b89a29ed9744828ab30bcf56c06fb1c5d80dd2b29177fcfcec1c",
      "text": "import assert from \"node:assert/strict\";\nimport { test } from \"node:test\";\nimport { createAuthCoordinator, createRefreshCoordinator, type AuthGatewayPort, type AuthSessionData, type AuthSessionPort } from \"./auth-coordinator.ts\";\n\nconst now = 1_700_000_000_000;\nconst base = (): AuthSessionData => ({ sessionId: \"9aa0a1b2-c3d4-4e5f-8a90-b1c2d3e4f5a6\", version: 1, auth: { accessToken: \"private-access\", refreshToken: \"private-refresh\", accessExpiresAt: now + 10_000, refreshExpiresAt: now + 100_000, generation: \"84e86fd2-2205-4880-a65c-4b8da64489f1\", account: { id: 47, displayName: \"نام\", role: \"specialist\" } } });\nfunction port(initial: AuthSessionData | undefined = base()) {\n  let state: AuthSessionData | undefined = initial; const saved: AuthSessionData[] = [];\n  return { read: () => state, save: async (next: AuthSessionData) => { state = structuredClone(next); saved.push(next); }, destroy: () => { state = undefined; }, saved };\n}\nfunction setup(session: AuthSessionPort = port(), shared = createRefreshCoordinator(() => now)) {\n  const gateway: AuthGatewayPort = {\n    requestOtp: async () => { throw Error(\"unused\"); }, verifyOtp: async () => { throw Error(\"unused\"); },\n    refresh: async () => ({ tokens: { access_token: \"new-access\", refresh_token: \"new-refresh\", access_expires_in: 900, refresh_expires_in: 9000, token_type: \"Bearer\" } }),\n    me: async () => ({ id: 47, display_name: \"نام\", roles: [\"nahan_specialist\"], phone: null, specialist_post_id: 1 }),\n    logoutRefresh: async () => ({ logged_out: true }),\n  };\n  return createAuthCoordinator({ session, gateway, refreshCoordinator: shared, now: () => now, uuid: () => crypto.randomUUID(), ensureOtpReady: async () => {} });\n}\nfunction deferred() { let resolve!: () => void; const promise = new Promise<void>(r => { resolve = r; }); return { promise, resolve }; }\n\ntest(\"sealed operation validates expiry and never rotates or saves on a read\", async () => {\n  const p = port(); const c = setup(p);\n  assert.equal(typeof c.authenticatedOperation, \"function\", \"internal sealed operation is missing\");\n  assert.deepEqual(await c.authenticatedOperation(async (_token, account) => account), base().auth!.account);\n  assert.equal(p.saved.length, 0);\n  const expired = base(); expired.auth!.accessExpiresAt = now;\n  await assert.rejects(setup(port(expired)).authenticatedOperation(async () => 1), { code: \"refresh_required\" });\n  await assert.rejects(setup({ read: () => undefined, save: async () => {}, destroy: () => {} }).authenticatedOperation(async () => 1), { code: \"unauthenticated\" });\n});\n\ntest(\"internal operation rejects a malformed current seal before any gateway use\", async () => {\n  for (const patch of [{generation:\"invalid\"},{accessToken:{}},{account:{id:47,displayName:\"نام\",role:\"administrator\"}}]) {\n    const malformed=base();Object.assign(malformed.auth!,patch);let calls=0;\n    await assert.rejects(setup(port(malformed)).authenticatedOperation(async()=>{calls++;return 1;}),{code:\"unauthenticated\"});\n    assert.equal(calls,0);\n  }\n});\n\ntest(\"summary write preserves credentials, rejects identity changes and independent stale response ports\", async () => {\n  const shared = createRefreshCoordinator(() => now); const p = port(); const c = setup(p, shared);\n  const updated = { ...base().auth!.account, displayName: \"تازه\" };\n  assert.equal(await c.authenticatedOperation(async () => updated, a => a), updated);\n  assert.equal(p.saved[0].auth!.accessToken, \"private-access\");\n  assert.equal(p.saved[0].auth!.refreshToken, \"private-refresh\");\n  assert.equal(p.saved[0].auth!.account.displayName, \"تازه\");\n  assert.equal(\"challenge\" in p.saved[0], false);\n  await assert.rejects(setup(port(), shared).authenticatedOperation(async () => updated, a => a), { code: \"refresh_required\" });\n  await assert.rejects(c.authenticatedOperation(async () => ({ ...updated, id: 90 }), a => a), { code: \"auth_unavailable\" });\n});\n\ntest(\"concurrent refresh cannot be overwritten by a stale independent account port\", async () => {\n  const shared = createRefreshCoordinator(() => now); const p = port();\n  await setup(p, shared).refresh();\n  let called = false;\n  await assert.rejects(setup(port(), shared).authenticatedOperation(async () => { called = true; return 1; }), { code: \"refresh_required\" });\n  assert.equal(called, false);\n  assert.equal(p.read()!.auth!.refreshToken, \"new-refresh\");\n});\n\ntest(\"logout from an independent response port wins an in-flight mutation and prevents summary save\", async () => {\n  const shared = createRefreshCoordinator(() => now); const p = port(); const started = deferred(); const finish = deferred();\n  const write = setup(p, shared).authenticatedOperation(async () => { started.resolve(); await finish.promise; return { ...base().auth!.account, displayName: \"late\" }; }, a => a);\n  await started.promise;\n  await setup(port(), shared).logout();\n  finish.resolve();\n  await assert.rejects(write, { code: \"refresh_cancelled\" });\n  assert.equal(p.saved.length, 0);\n});\n\ntest(\"logout cancellation survives replay grace across independent response ports for the credential lifetime\", async () => {\n  let time=now;const shared=createRefreshCoordinator(()=>time);\n  await setup(port(),shared).logout();time+=6000;\n  let calls=0;\n  await assert.rejects(setup(port(),shared).authenticatedOperation(async()=>{calls++;return 1;}),{code:\"unauthenticated\"});\n  assert.equal(calls,0);\n});\n\ntest(\"ambiguous operation and failed save are not retried; overlapping writes fail closed\", async () => {\n  const p = port(); let calls = 0;\n  await assert.rejects(setup(p).authenticatedOperation(async () => { calls++; throw Error(\"private backend\"); }), /private backend/);\n  assert.equal(calls, 1);\n  const bad: AuthSessionPort = { ...p, save: async () => { throw Error(\"cookie failure\"); } };\n  await assert.rejects(setup(bad).authenticatedOperation(async () => base().auth!.account, a => a), { code: \"auth_unavailable\" });\n  const shared = createRefreshCoordinator(() => now); const started = deferred(); const finish = deferred();\n  const pending = setup(port(), shared).authenticatedOperation(async () => { started.resolve(); await finish.promise; return 1; }, undefined, true);\n  await started.promise;\n  await assert.rejects(setup(port(), shared).authenticatedOperation(async () => 2, undefined, true), { code: \"refresh_required\" });\n  finish.resolve(); await pending;\n});\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/services/profile/profile-bff.server.ts": {
      "sha256": "d4a8380e56a72273d6518b67d4dbf4d103163b922055a6940afcb783930e9e77",
      "text": "import \"server-only\";\n\nimport { createRequestAuthCoordinator } from \"../auth/auth-bff.server.ts\";\nimport { getAuthRuntimeConfig } from \"../auth/auth-runtime-config.ts\";\nimport { wordpressRest } from \"../wordpress/rest-client.ts\";\nimport { createWordPressProfileUpload } from \"./wordpress-profile-upload.ts\";\nimport { createProfileGateway } from \"./profile-gateway.ts\";\nimport { createProfileService } from \"./profile-service.ts\";\nimport { createProfileRouteHandlers } from \"./profile-route-adapters.ts\";\n\nasync function requestService(readOnly: boolean) {\n  const auth = await createRequestAuthCoordinator(readOnly);\n  const gateway = createProfileGateway({json: wordpressRest, upload: createWordPressProfileUpload()});\n  return createProfileService({auth,gateway});\n}\n\n/** Handler-only composition: fixed upstream adapters, never browser-supplied URLs/options. */\nexport function getProfileRouteHandlers() {\n  return createProfileRouteHandlers({appOrigin:getAuthRuntimeConfig()?.appOrigin,getService:requestService});\n}\n\n/** Server Component helpers are fresh reads and never save, destroy, refresh or rotate cookies. */\nexport async function readOwnerAccount() { return (await requestService(true)).account(); }\nexport async function readOwnerProfile() { return (await requestService(true)).profile(); }\nexport async function readOwnerMediaCapabilities() { return (await requestService(true)).capabilities(); }\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/services/profile/profile-gateway.ts": {
      "sha256": "ab8d3256c2ef2d4ac1ed12b6d33e84d947bb925cc770939b683572453e780559",
      "text": "import { assertWordPressServerOnly } from \"../wordpress/config.ts\";\nimport { parseAccount, parseCapabilities, parseGallery, parseInput, parseMediaId, parseProfile, parseUpload, ProfileBoundaryError } from \"./profile-contracts.ts\";\nimport { safeProfileError } from \"./profile-errors.ts\";\nimport type { PublicUploadInput } from \"./profile-request-policy.ts\";\n\nexport interface ProfileGatewayDependencies {\n  json(path: string, options: {method:\"GET\"|\"POST\"|\"DELETE\";token:string;body?:Record<string,unknown>}): Promise<unknown>;\n  upload(token: string, input: PublicUploadInput): Promise<unknown>;\n}\n/** Trusted server adapter. Paths/methods cannot come from a browser input. */\nexport function createProfileGateway(dependencies: ProfileGatewayDependencies) {\n  async function call<T>(path:string,token:string,method:\"GET\"|\"POST\"|\"DELETE\",parse:(value:unknown)=>T,body?:Record<string,unknown>):Promise<T> {\n    assertWordPressServerOnly();\n    let raw:unknown;\n    try { raw=await dependencies.json(path,{method,token,...(body===undefined?{}:{body})}); }\n    catch(error) { throw safeProfileError(error,method!==\"GET\"); }\n    try { return parse(raw); }\n    catch { throw new ProfileBoundaryError(method===\"GET\"?\"invalid_upstream_response\":\"operation_uncertain\",503); }\n  }\n  return {\n    account:(token:string)=>call(\"account/me\",token,\"GET\",parseAccount),\n    updateAccount:(token:string,body:unknown)=>call(\"account/me\",token,\"POST\",parseAccount,parseInput(\"account\",body)),\n    profile:(token:string)=>call(\"profile/me\",token,\"GET\",parseProfile),\n    updateProfile:(token:string,body:unknown)=>call(\"profile/me\",token,\"POST\",parseProfile,parseInput(\"profile\",body)),\n    submit:(token:string)=>call(\"profile/me/submit\",token,\"POST\",parseProfile,{}),\n    capabilities:(token:string)=>call(\"uploads\",token,\"GET\",parseCapabilities),\n    addGallery:(token:string,body:unknown)=>call(\"profile/me/gallery\",token,\"POST\",parseGallery,parseInput(\"gallery\",body)),\n    deleteGallery:(token:string,id:string,body:unknown)=>call(`profile/me/gallery/media/${parseMediaId(id)}`,token,\"DELETE\",parseGallery,parseInput(\"delete\",body)),\n    async upload(token:string,input:PublicUploadInput) {\n      assertWordPressServerOnly();\n      let raw:unknown;\n      try { raw=await dependencies.upload(token,input); } catch(error) { throw safeProfileError(error,true); }\n      try { const result=parseUpload(raw); if(result.purpose!==input.purpose) throw Error(); return result; }\n      catch { throw new ProfileBoundaryError(\"operation_uncertain\",503); }\n    },\n  };\n}\nexport type ProfileGateway = ReturnType<typeof createProfileGateway>;\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/services/profile/profile-gateway.test.ts": {
      "sha256": "f047c3955f9d48cfa0f932e74c2cfde5b6a0aa5ffc94757f6e03c0210a73b7fb",
      "text": "import assert from \"node:assert/strict\";\nimport { test } from \"node:test\";\nimport { wordpressRest } from \"../wordpress/rest-client.ts\";\nimport * as transport from \"./wordpress-profile-upload.ts\";\nimport * as gateway from \"./profile-gateway.ts\";\nconst account = { id:47,display_name:\"نام\",role:\"specialist\",login_phone_masked:null,avatar:null,location:null,specialist:{id:51,slug:\"specialist-47\",status:\"draft\"} };\nconst uploaded = { id:31,url:\"https://media.example/a.png\",type:\"image\",mime:\"image/png\",purpose:\"public-avatar\" };\nconst file = () => ({file:new File([\"local-fixture\"],\"a.png\",{type:\"image/png\"}),purpose:\"public-avatar\" as const});\nconst envelope = (data:unknown) => Response.json({success:true,data});\n\ntest(\"fixed gateway uses exact private JSON paths, methods and bodies without arbitrary proxy options\", async () => {\n  assert.equal(typeof gateway.createProfileGateway,\"function\",\"fixed private gateway is missing\");\n  const calls: unknown[] = [];\n  const g = gateway.createProfileGateway({ json: async (path, options) => { calls.push({path,options}); return account; }, upload: async () => uploaded });\n  await g.account(\"private-access\"); await g.updateAccount(\"private-access\",{display_name:\"تازه\"});\n  assert.deepEqual(calls,[{path:\"account/me\",options:{method:\"GET\",token:\"private-access\"}},{path:\"account/me\",options:{method:\"POST\",token:\"private-access\",body:{display_name:\"تازه\"}}}]);\n  await assert.rejects(async () => g.updateAccount(\"private-access\",{role:\"administrator\"}));\n  assert.equal(calls.length,2);\n});\n\ntest(\"production gateway through the real private JSON transport sends fixed profile/gallery paths with Bearer only in headers\", async () => {\n  const old=process.env.WORDPRESS_URL;const mode=process.env.WORDPRESS_PERMALINK_MODE;process.env.WORDPRESS_URL=\"https://wp.example/kar\";process.env.WORDPRESS_PERMALINK_MODE=\"pretty\";\n  const profile={id:51,slug:\"specialist-47\",title:\"عنوان\",status:\"pending\",categories:[],cities:[],avatar:null,gallery:[],gallery_revision:1,gallery_available:true,bio:\"متن\",skills:\"\",address:\"\",availability:\"\",price_hint:\"\",experience_years:null};\n  const calls:Array<{path:string;method:string;body:unknown}>=[];\n  try {\n    const g=gateway.createProfileGateway({json:(path,options)=>wordpressRest(path,{...options,fetch:async(input,init)=>{\n      const url=new URL(String(input));assert.equal(url.origin,\"https://wp.example\");assert.ok(url.pathname.startsWith(\"/kar/wp-json/nahan/v1/\"));\n      assert.equal(new Headers(init!.headers).get(\"authorization\"),\"Bearer private-access\");assert.equal(init!.cache,\"no-store\");\n      const body=init!.body===undefined?undefined:JSON.parse(String(init!.body));assert.ok(!JSON.stringify(body??{}).includes(\"private-access\"));calls.push({path,method:String(init!.method),body});\n      return envelope(path.includes(\"gallery\")?{gallery:[],gallery_revision:2,gallery_available:true,status:\"pending\"}:profile);\n    }}),upload:async()=>uploaded});\n    await g.profile(\"private-access\");await g.updateProfile(\"private-access\",{city_id:987,bio:\"تازه\"});await g.submit(\"private-access\");await g.addGallery(\"private-access\",{media_id:31,caption:\"نمونه\",expected_revision:1});await g.deleteGallery(\"private-access\",\"31\",{expected_revision:2});\n    assert.deepEqual(calls,[{path:\"profile/me\",method:\"GET\",body:undefined},{path:\"profile/me\",method:\"POST\",body:{city_id:987,bio:\"تازه\"}},{path:\"profile/me/submit\",method:\"POST\",body:{}},{path:\"profile/me/gallery\",method:\"POST\",body:{media_id:31,caption:\"نمونه\",expected_revision:1}},{path:\"profile/me/gallery/media/31\",method:\"DELETE\",body:{expected_revision:2}}]);\n  } finally {if(old===undefined)delete process.env.WORDPRESS_URL;else process.env.WORDPRESS_URL=old;if(mode===undefined)delete process.env.WORDPRESS_PERMALINK_MODE;else process.env.WORDPRESS_PERMALINK_MODE=mode;}\n});\n\ntest(\"dedicated upload transport preserves multipart native boundary, private Bearer, no-store, omit and fixed installation path\", async () => {\n  assert.equal(typeof transport.createWordPressProfileUpload,\"function\",\"dedicated upload transport missing\");\n  const old = process.env.WORDPRESS_URL; const mode = process.env.WORDPRESS_PERMALINK_MODE;\n  process.env.WORDPRESS_URL=\"https://wp.example/kar\";\n  try {\n    for (const permalink of [\"pretty\",\"plain\"]) {\n      process.env.WORDPRESS_PERMALINK_MODE=permalink;\n      let calls=0;\n      const upload=transport.createWordPressProfileUpload({fetch:async (input,init) => {\n        calls++; assert.equal(String(input),permalink===\"pretty\" ? \"https://wp.example/kar/wp-json/nahan/v1/uploads\" : \"https://wp.example/kar/index.php?rest_route=%2Fnahan%2Fv1%2Fuploads\");\n        assert.equal(init!.method,\"POST\"); assert.equal(init!.cache,\"no-store\"); assert.equal(init!.credentials,\"omit\"); assert.equal(init!.redirect,\"error\");\n        const headers=new Headers(init!.headers); assert.equal(headers.get(\"authorization\"),\"Bearer private-access\"); assert.equal(headers.has(\"content-type\"),false);\n        assert.ok(init!.body instanceof FormData); assert.deepEqual([...init!.body.keys()],[\"file\",\"purpose\"]);\n        return envelope(uploaded);\n      }});\n      assert.deepEqual(await upload(\"private-access\",file()),uploaded); assert.equal(calls,1);\n    }\n  } finally { if(old===undefined) delete process.env.WORDPRESS_URL; else process.env.WORDPRESS_URL=old; if(mode===undefined) delete process.env.WORDPRESS_PERMALINK_MODE; else process.env.WORDPRESS_PERMALINK_MODE=mode; }\n});\n\ntest(\"upload transport bounds response body and times out after headers; no retry and no raw errors\", async () => {\n  const old=process.env.WORDPRESS_URL; process.env.WORDPRESS_URL=\"https://wp.example\";\n  try {\n    let calls=0; let cancelled=false;\n    const upload=transport.createWordPressProfileUpload({timeoutMs:15,fetch:async () => {calls++; return new Response(new ReadableStream({cancel(){cancelled=true;}}),{headers:{\"content-type\":\"application/json\"}});}});\n    await assert.rejects(upload(\"private-access\",file()), {code:\"operation_uncertain\",status:503}); assert.equal(calls,1); assert.equal(cancelled,true);\n    const oversized=transport.createWordPressProfileUpload({fetch:async()=>new Response(\"x\".repeat(256*1024+1))});\n    await assert.rejects(oversized(\"private-access\",file()),{code:\"operation_uncertain\",status:503});\n    const error=transport.createWordPressProfileUpload({fetch:async () => Response.json({success:false,error:{code:\"gallery_revision_conflict\",message:\"private-access 09123456789 /server/path\"}},{status:409})});\n    await assert.rejects(error(\"private-access\",file()), e => { assert.ok(!JSON.stringify(e).includes(\"09123456789\")); assert.ok(!String(e).includes(\"private-access\")); return true; });\n  } finally { if(old===undefined) delete process.env.WORDPRESS_URL; else process.env.WORDPRESS_URL=old; }\n});\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/services/profile/profile-service.ts": {
      "sha256": "79d29e989f998bf1c0ff3f4845c9693b4711824abe19d24a1f0e1a0be1b04deb",
      "text": "import type { AccountSummary } from \"../../lib/contracts/auth.ts\";\nimport type { SealedAuthCoordinator } from \"../auth/auth-coordinator.ts\";\nimport { parseInput, parseMediaId, ProfileBoundaryError, type AccountDto, type ProfileDto } from \"./profile-contracts.ts\";\nimport type { ProfileGateway } from \"./profile-gateway.ts\";\nimport type { PublicUploadInput } from \"./profile-request-policy.ts\";\n\ninterface ProfileServiceDependencies { auth: Pick<SealedAuthCoordinator,\"authenticatedOperation\">; gateway: ProfileGateway; }\n/** Pure production logic; only the server-only composition receives real credentials/ports. */\nexport function createProfileService({auth,gateway}:ProfileServiceDependencies) {\n  function identity(owner:AccountDto,summary:AccountSummary):AccountDto {\n    if(owner.id!==summary.id || owner.role!==summary.role)throw new ProfileBoundaryError(\"owner_identity_mismatch\",503);\n    return owner;\n  }\n  function specialist(summary:AccountSummary) {\n    if(summary.role!==\"specialist\")throw new ProfileBoundaryError(\"forbidden\",403);\n  }\n  async function owner(token:string,summary:AccountSummary,check:()=>void) {\n    specialist(summary);\n    const account=identity(await gateway.account(token),summary);\n    check();\n    if(!account.specialist)throw new ProfileBoundaryError(\"no_profile\",404);\n    return account.specialist;\n  }\n  function owned(profile:ProfileDto,link:{id:number;slug:string}):ProfileDto {\n    if(profile.id!==link.id || profile.slug!==link.slug)throw new ProfileBoundaryError(\"owner_identity_mismatch\",503);\n    return profile;\n  }\n  return {\n    account:()=>auth.authenticatedOperation(async(token,summary)=>identity(await gateway.account(token),summary)),\n    updateAccount(body:unknown) {\n      const input=parseInput(\"account\",body);\n      return auth.authenticatedOperation(async(token,summary,check)=>{\n        identity(await gateway.updateAccount(token,input),summary);\n        check();\n        // Do not trust an optimistic POST DTO as the sealed account summary.\n        return identity(await gateway.account(token),summary);\n      },account=>({id:account.id,displayName:account.displayName,role:account.role}),true);\n    },\n    profile:()=>auth.authenticatedOperation(async(token,summary,check)=>{\n      const link=await owner(token,summary,check); return owned(await gateway.profile(token),link);\n    }),\n    updateProfile(body:unknown) {\n      const input=parseInput(\"profile\",body);\n      return auth.authenticatedOperation(async(token,summary,check)=>{\n        const link=await owner(token,summary,check); return owned(await gateway.updateProfile(token,input),link);\n      },undefined,true);\n    },\n    submit:()=>auth.authenticatedOperation(async(token,summary,check)=>{\n      const link=await owner(token,summary,check); return owned(await gateway.submit(token),link);\n    },undefined,true),\n    addGallery(body:unknown) {\n      const input=parseInput(\"gallery\",body);\n      return auth.authenticatedOperation(async(token,summary,check)=>{await owner(token,summary,check);return gateway.addGallery(token,input);},undefined,true);\n    },\n    deleteGallery(id:string,body:unknown) {\n      parseMediaId(id); const input=parseInput(\"delete\",body);\n      return auth.authenticatedOperation(async(token,summary,check)=>{await owner(token,summary,check);return gateway.deleteGallery(token,id,input);},undefined,true);\n    },\n    capabilities:()=>auth.authenticatedOperation(async(token,summary,check)=>{\n      const limits=await gateway.capabilities(token);\n      check();\n      if(summary.role===\"client\" && limits.purposes.some(p=>p!==\"public-avatar\"))throw new ProfileBoundaryError(\"invalid_upstream_response\",503);\n      return limits;\n    }),\n    upload:(input:PublicUploadInput)=>auth.authenticatedOperation(async(token,summary,check)=>{\n      if(input.purpose===\"public-portfolio\")await owner(token,summary,check);\n      return gateway.upload(token,input);\n    },undefined,true),\n  };\n}\nexport type ProfileService = ReturnType<typeof createProfileService>;\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/services/profile/profile-contracts.test.ts": {
      "sha256": "59c3d08f128f284a2a4b9e1896265618d67d32028eb117f46635e3d4d412146a",
      "text": "import assert from \"node:assert/strict\";\nimport { test } from \"node:test\";\nimport * as contracts from \"./profile-contracts.ts\";\n\nexport const accountRaw = { id: 47, display_name: \"نام\", role: \"specialist\", login_phone_masked: \"09*****6789\", avatar: { id: 31, url: \"https://media.example/a.jpg\", type: \"image\" }, location: { id: 987, name: \"کاشان\", slug: \"kashan\" }, specialist: { id: 51, slug: \"specialist-47\", status: \"draft\" }, phone: \"09123456789\", tokens: \"private\" };\nexport const profileRaw = { id: 51, slug: \"specialist-47\", title: \"عنوان\", status: \"draft\", categories: [{ id: 91, name: \"تعمیر\", slug: \"repair\" }], cities: [{ id: 987, name: \"کاشان\", slug: \"kashan\" }], avatar: null, gallery: [{ id: 32, url: \"https://media.example/b.png\", type: \"image\", caption: \"نمونه\" }], gallery_revision: 2, gallery_available: true, bio: \"درباره\", skills: \"مهارت\", address: \"آدرس خصوصی\", availability: \"available\", price_hint: \"توافقی\", experience_years: 3 };\nexport const capabilityRaw = { purposes: [\"public-avatar\", \"public-portfolio\"], image_mimes: [\"image/jpeg\", \"image/png\", \"image/webp\", \"image/gif\"], max_bytes: 20971520, max_dimension: 8192, max_pixels: 24000000, max_files: 1, max_gallery_items: 20, video: { enabled: false, reason: \"video_unsupported\" }, image_decoder_required: true };\n\ntest(\"runtime owner projections minimize account data and preserve honest draft/gallery state\", () => {\n  assert.equal(typeof contracts.parseAccount, \"function\", \"account runtime projection missing\");\n  const a = contracts.parseAccount(accountRaw);\n  assert.deepEqual(a, { id: 47, displayName: \"نام\", role: \"specialist\", loginPhoneMasked: \"09*****6789\", avatar: accountRaw.avatar, location: accountRaw.location, specialist: accountRaw.specialist });\n  assert.ok(!JSON.stringify(a).includes(\"09123456789\"));\n  const p = contracts.parseProfile(profileRaw);\n  assert.equal(p.galleryRevision, 2); assert.equal(p.status, \"draft\"); assert.equal(p.gallery[0].id, 32);\n  assert.equal(\"verified\" in p, false);\n  assert.equal(contracts.parseProfile({ ...profileRaw, verified: true }).verified, true);\n  assert.equal(contracts.parseProfile({ ...profileRaw, gallery: [], gallery_revision: null, gallery_available: false }).galleryAvailable, false);\n});\n\ntest(\"owner DTOs fail closed for malformed identity, unsafe URLs, invalid gallery, and false video claims\", () => {\n  for (const patch of [{ id: \"47\" }, { role: \"administrator\" }, { login_phone_masked: \"09123456789\" }, { avatar: { id: 31, type: \"image\", url: \"https://user:pass@host/a\" } }, { display_name: \"a\\nprivate\" }]) assert.throws(() => contracts.parseAccount({ ...accountRaw, ...patch }));\n  for (const patch of [{ status: \"publish-now\" }, { gallery_revision: -1 }, { verified: \"true\" }, { gallery: [profileRaw.gallery[0], profileRaw.gallery[0]] }, { gallery: [{ ...profileRaw.gallery[0], url: \"javascript:alert(1)\" }] }, { experience_years: 81 }, { cities: [{ id: 1, name: \"x\", slug: \"a b\" }] }]) assert.throws(() => contracts.parseProfile({ ...profileRaw, ...patch }));\n  assert.equal(contracts.parseCapabilities(capabilityRaw).video.enabled, false);\n  assert.throws(() => contracts.parseCapabilities({ ...capabilityRaw, video: { enabled: true } }));\n  assert.throws(() => contracts.parseCapabilities({ ...capabilityRaw, max_bytes: 20971521 }));\n});\n\ntest(\"exact installed backend contract allows absent masked phone and rejects names over 100 and text controls\", () => {\n  assert.equal(contracts.parseAccount({ ...accountRaw, login_phone_masked: null }).loginPhoneMasked, null);\n  assert.throws(() => contracts.parseInput(\"account\", { display_name: \"x\".repeat(101) }));\n  assert.throws(() => contracts.parseInput(\"profile\", { bio: \"line\\nbreak\" }));\n});\n\ntest(\"strict write allowlists match backend bounds and never admit authority, URLs or coerced IDs\", () => {\n  assert.deepEqual(contracts.parseInput(\"account\", { display_name: \"تازه\", account_city_id: 987, avatar_id: null }), { display_name: \"تازه\", account_city_id: 987, avatar_id: null });\n  assert.deepEqual(contracts.parseInput(\"profile\", { bio: \"ب\".repeat(4000), category_ids: [91], city_id: 987, avatar_id: 31 }), { bio: \"ب\".repeat(4000), category_ids: [91], city_id: 987, avatar_id: 31 });\n  for (const body of [{ status: \"publish\" }, { verified: true }, { user: 47 }, { role: \"client\" }, { author: 47 }, { slug: \"fake\" }, { avatar_id: \"31\" }, { category_ids: [1, 1] }, { bio: \"x\".repeat(4001) }, { title: \"<script>\" }]) assert.throws(() => contracts.parseInput(\"profile\", body));\n  assert.deepEqual(contracts.parseInput(\"gallery\", { media_id: 32, caption: \"نمونه\", expected_revision: 2 }), { media_id: 32, caption: \"نمونه\", expected_revision: 2 });\n  assert.throws(() => contracts.parseInput(\"gallery\", { media_id: 32, url: \"https://foreign.example/file\" }));\n  assert.throws(() => contracts.parseInput(\"gallery\", { media_id: 32, kind: \"video\" }));\n  assert.throws(() => contracts.parseInput(\"submit\", { status: \"pending\" }));\n  for (const id of [\"0\", \"01\", \"1e2\", \"1/2\", \"-1\", \"9007199254740992\", \"%31\"]) assert.throws(() => contracts.parseMediaId(id));\n  assert.equal(contracts.parseMediaId(\"32\"), 32);\n});\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/services/profile/profile-request-policy.ts": {
      "sha256": "283e7a6bff946e27105a595f5d740648e5f4793797c557b8b30ed881bcfec3e2",
      "text": "import { assertAuthMutationOrigin } from \"../../lib/auth-request-policy.ts\";\nimport { IMAGE_MIMES, MAX_FILE_BYTES, MAX_PROFILE_JSON_BYTES, MULTIPART_OVERHEAD_BYTES, ProfileBoundaryError, parseInput, purpose, type InputKind, type PublicMediaPurpose } from \"./profile-contracts.ts\";\n\nexport interface PublicUploadInput { file: File; purpose: PublicMediaPurpose; }\nconst BODY_TIMEOUT_MS = 15_000;\n\n/** Bound actual streaming bytes before parsing/allocating FormData. Content-Length is only an early rejection hint. */\nexport async function readBoundedBody(request: Request, maximum: number, timeoutMs = BODY_TIMEOUT_MS): Promise<Uint8Array> {\n  const length = request.headers.get(\"content-length\");\n  if (length && /^\\d+$/u.test(length) && Number(length) > maximum) {\n    void request.body?.cancel().catch(() => {});\n    throw new ProfileBoundaryError(\"request_too_large\", 413);\n  }\n  if (!request.body) throw new ProfileBoundaryError(\"invalid_request\", 400);\n  const reader = request.body.getReader(); const chunks: Uint8Array[] = []; let total = 0;\n  let fail!: (error: Error) => void;\n  const interrupted = new Promise<never>((_resolve, reject) => { fail = reject; });\n  const stop = (code: string, status: number) => {\n    fail(new ProfileBoundaryError(code, status));\n    void reader.cancel().catch(() => {});\n  };\n  const timer = setTimeout(() => stop(\"body_timeout\", 408), timeoutMs);\n  const abort = () => stop(\"request_aborted\", 400);\n  request.signal.addEventListener(\"abort\", abort, {once:true});\n  try {\n    if (request.signal.aborted) abort();\n    while (true) {\n      const chunk = await Promise.race([reader.read(), interrupted]);\n      if (request.signal.aborted) throw new ProfileBoundaryError(\"request_aborted\", 400);\n      if (chunk.done) break;\n      total += chunk.value.byteLength;\n      if (total > maximum) {\n        void reader.cancel().catch(() => {});\n        throw new ProfileBoundaryError(\"request_too_large\", 413);\n      }\n      chunks.push(chunk.value);\n    }\n    // Never allocate an unbounded copy or parse directly from the caller stream.\n    const bytes = new Uint8Array(total); let at = 0;\n    for (const chunk of chunks) { bytes.set(chunk, at); at += chunk.byteLength; }\n    return bytes;\n  } finally {\n    clearTimeout(timer); request.signal.removeEventListener(\"abort\", abort); reader.releaseLock();\n  }\n}\nexport async function parseProfileJson(request: Request, appOrigin: string, kind: InputKind): Promise<Record<string, unknown>> {\n  assertAuthMutationOrigin(request, appOrigin);\n  if (request.headers.get(\"content-type\")?.split(\";\", 1)[0]?.trim().toLowerCase() !== \"application/json\") throw new ProfileBoundaryError(\"invalid_content_type\", 415);\n  const raw = await readBoundedBody(request, MAX_PROFILE_JSON_BYTES);\n  let parsed: unknown;\n  try { parsed = JSON.parse(new TextDecoder(\"utf-8\", { fatal: true }).decode(raw)); }\n  catch { throw new ProfileBoundaryError(\"invalid_request\", 400); }\n  return parseInput(kind, parsed);\n}\nexport async function parseProfileMultipart(request: Request, appOrigin: string): Promise<PublicUploadInput> {\n  assertAuthMutationOrigin(request, appOrigin);\n  const contentType = request.headers.get(\"content-type\") ?? \"\";\n  // Exactly one bounded, ASCII boundary parameter. No alternate request-driven context.\n  const match = /^multipart\\/form-data;\\s*boundary=(?:\"([a-zA-Z0-9'()+_,.\\/:=? -]{1,70})\"|([a-zA-Z0-9'()+_,.\\/:=?-]{1,70}))\\s*$/iu.exec(contentType);\n  if (!match) throw new ProfileBoundaryError(\"invalid_content_type\", 415);\n  const bytes = await readBoundedBody(request, MAX_FILE_BYTES + MULTIPART_OVERHEAD_BYTES);\n  let data: FormData;\n  try {\n    data = await new Request(\"https://bounded.invalid/\", {method:\"POST\", headers:{\"content-type\":contentType}, body: bytes as BodyInit}).formData();\n  } catch { throw new ProfileBoundaryError(\"invalid_request\", 400); }\n  if ([...data.keys()].length !== 2 || data.getAll(\"file\").length !== 1 || data.getAll(\"purpose\").length !== 1) throw new ProfileBoundaryError();\n  const p = purpose(data.get(\"purpose\")); const file = data.get(\"file\");\n  if (!(file instanceof File) || file.size < 1) throw new ProfileBoundaryError();\n  if (file.size > MAX_FILE_BYTES) throw new ProfileBoundaryError(\"request_too_large\", 413);\n  if (!file.name || Buffer.byteLength(file.name, \"utf8\") > 200 || /[\\/\\\\\\p{Cc}\\p{Cs}]/u.test(file.name)) throw new ProfileBoundaryError();\n  if (/^video\\//iu.test(file.type) || /\\.(mp4|mov|webm|avi|mkv)$/iu.test(file.name)) throw new ProfileBoundaryError(\"video_unsupported\", 415);\n  const extensions: Record<string, string> = {jpg:\"image/jpeg\",jpeg:\"image/jpeg\",png:\"image/png\",webp:\"image/webp\",gif:\"image/gif\"};\n  const extension = file.name.split(\".\").at(-1)?.toLowerCase() ?? \"\";\n  if (!IMAGE_MIMES.includes(file.type as typeof IMAGE_MIMES[number]) || extensions[extension] !== file.type) throw new ProfileBoundaryError(\"unsupported_media\", 415);\n  // These are boundary shape checks, NOT proof of actual image bytes. WP's decoder is authoritative.\n  return {file, purpose:p};\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/services/profile/wordpress-profile-upload.ts": {
      "sha256": "505185ac9bcf13c25075af81fbacc4bf50195c5e8dd53ca6fe3f9a73f0c44a91",
      "text": "import { assertWordPressServerOnly } from \"../wordpress/config.ts\";\nimport { buildWordPressRestUrl, type WordPressFetch } from \"../wordpress/rest-client.ts\";\nimport { isWordPressFailureEnvelope, isWordPressSuccessEnvelope } from \"../wordpress/contracts.ts\";\nimport { WordPressApiError } from \"../wordpress/errors.ts\";\nimport { MAX_FILE_BYTES, ProfileBoundaryError, purpose } from \"./profile-contracts.ts\";\nimport { readBoundedBody, type PublicUploadInput } from \"./profile-request-policy.ts\";\nimport { safeProfileError } from \"./profile-errors.ts\";\n\ninterface UploadTransportDependencies { fetch?: WordPressFetch; timeoutMs?: number; }\n/** Internal server transport: fixed path/method/options, no JSON serialization, no redirects or retry. */\nexport function createWordPressProfileUpload(dependencies: UploadTransportDependencies = {}) {\n  return async (accessToken: string, input: PublicUploadInput): Promise<unknown> => {\n    assertWordPressServerOnly();\n    const controller = new AbortController();\n    let interrupt!: () => void;\n    const interrupted = new Promise<never>((_resolve,reject) => { interrupt = () => { controller.abort(); reject(new ProfileBoundaryError(\"operation_uncertain\",503)); }; });\n    const timer = setTimeout(interrupt,dependencies.timeoutMs ?? 30_000);\n    try {\n      if (typeof accessToken !== \"string\" || !accessToken || /\\s/u.test(accessToken)) throw new ProfileBoundaryError(\"unauthenticated\",401);\n      const p = purpose(input.purpose);\n      if (!(input.file instanceof File) || input.file.size < 1 || input.file.size > MAX_FILE_BYTES) throw new ProfileBoundaryError(\"invalid_upload\",422);\n      const body = new FormData(); body.append(\"file\",input.file,input.file.name); body.append(\"purpose\",p);\n      const fetchImpl=dependencies.fetch ?? globalThis.fetch;\n      const response=await Promise.race([fetchImpl(buildWordPressRestUrl(\"uploads\"), {\n        method:\"POST\",headers:{Accept:\"application/json\",Authorization:`Bearer ${accessToken}`},body,\n        cache:\"no-store\",credentials:\"omit\",redirect:\"error\",signal:controller.signal,\n      }),interrupted]);\n      if (!response.body) throw new ProfileBoundaryError(\"operation_uncertain\",503);\n      const bounded=new Request(\"https://bounded.invalid/\",{method:\"POST\",body:response.body,signal:controller.signal,duplex:\"half\"} as RequestInit);\n      let bytes: Uint8Array;\n      try { bytes = await Promise.race([readBoundedBody(bounded,256*1024,dependencies.timeoutMs ?? 30_000),interrupted]); }\n      catch { throw new ProfileBoundaryError(\"operation_uncertain\",503); }\n      let payload: unknown;\n      try { payload=JSON.parse(new TextDecoder(\"utf-8\",{fatal:true}).decode(bytes)); }\n      catch { throw new ProfileBoundaryError(\"operation_uncertain\",503); }\n      if (isWordPressFailureEnvelope(payload)) throw new WordPressApiError({status:response.status,code:payload.error.code,message:\"خطای ذخیره رسانه\"});\n      if (!response.ok || !isWordPressSuccessEnvelope(payload)) throw new ProfileBoundaryError(\"operation_uncertain\",503);\n      return payload.data;\n    } catch (error) {\n      if (controller.signal.aborted) throw new ProfileBoundaryError(\"operation_uncertain\",503);\n      throw safeProfileError(error,true);\n    } finally { clearTimeout(timer); }\n  };\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/services/profile/profile-contracts.ts": {
      "sha256": "dc6138e11cac0ffded162a46705aa32a79e93cd21b0d7f0ee5e8eeccc8d590de",
      "text": "import type { RegistrationRole } from \"../../lib/contracts/auth.ts\";\n\nexport const MAX_FILE_BYTES = 20 * 1024 * 1024;\nexport const MULTIPART_OVERHEAD_BYTES = 256 * 1024;\nexport const MAX_PROFILE_JSON_BYTES = 16 * 1024;\nexport const IMAGE_MIMES = [\"image/jpeg\", \"image/png\", \"image/webp\", \"image/gif\"] as const;\nexport type PublicMediaPurpose = \"public-avatar\" | \"public-portfolio\";\nexport type ProfileStatus = \"draft\" | \"pending\" | \"publish\";\nexport interface TaxonomyRef { id: number; name: string; slug: string; }\nexport interface ImageRef { id: number; url: string; type: \"image\"; }\nexport interface GalleryItem extends ImageRef { caption: string; }\nexport interface AccountDto {\n  id: number; displayName: string; role: RegistrationRole; loginPhoneMasked: string | null;\n  avatar: ImageRef | null; location: TaxonomyRef | null;\n  specialist: { id: number; slug: string; status: ProfileStatus } | null;\n}\nexport interface GalleryDto { gallery: GalleryItem[]; galleryRevision: number | null; galleryAvailable: boolean; status: ProfileStatus; }\nexport interface ProfileDto extends GalleryDto {\n  id: number; slug: string; title: string; categories: TaxonomyRef[]; cities: TaxonomyRef[];\n  avatar: ImageRef | null; bio: string; skills: string; address: string;\n  availability: \"available\" | \"busy\" | \"away\" | \"\"; priceHint: string; experienceYears: number | null; verified?: boolean;\n}\nexport interface UploadDto extends ImageRef { mime: typeof IMAGE_MIMES[number]; purpose: PublicMediaPurpose; }\nexport interface MediaCapabilitiesDto {\n  purposes: PublicMediaPurpose[]; imageMimes: Array<typeof IMAGE_MIMES[number]>; maxBytes: number;\n  maxDimension: number; maxPixels: number; maxFiles: 1; maxGalleryItems: number;\n  video: { enabled: false; reason: \"video_unsupported\" }; imageDecoderRequired: true;\n}\nexport class ProfileBoundaryError extends Error {\n  readonly code: string;\n  readonly status: number;\n  constructor(code = \"invalid_request\", status = 422) {\n    super(\"درخواست قابل انجام نیست. وضعیت را دوباره بارگذاری کنید.\");\n    this.name = \"ProfileBoundaryError\"; this.code = code; this.status = status;\n  }\n}\nfunction invalid(): never { throw new ProfileBoundaryError(); }\nexport function object(value: unknown): Record<string, unknown> {\n  if (value === null || typeof value !== \"object\" || Array.isArray(value)) return invalid();\n  return value as Record<string, unknown>;\n}\nexport function integer(value: unknown, min = 1, max = Number.MAX_SAFE_INTEGER): number {\n  if (typeof value !== \"number\" || !Number.isSafeInteger(value) || value < min || value > max) return invalid();\n  return value;\n}\nfunction text(value: unknown, max: number, nonempty = false): string {\n  if (typeof value !== \"string\" || [...value].length > max || (nonempty && !value.trim()) || /[<>\\p{Cc}\\p{Cs}]/u.test(value)) return invalid();\n  return value;\n}\nfunction multiline(value: unknown, max: number): string { return text(value, max); }\nfunction slug(value: unknown): string {\n  const result = text(value, 200, true);\n  if (!/^(?:[a-zA-Z0-9_\\-]|%[a-fA-F0-9]{2}|[\\p{L}\\p{N}])+$/u.test(result)) return invalid();\n  return result;\n}\nfunction status(value: unknown): ProfileStatus {\n  if (value !== \"draft\" && value !== \"pending\" && value !== \"publish\") return invalid();\n  return value;\n}\nfunction role(value: unknown): RegistrationRole {\n  if (value !== \"client\" && value !== \"specialist\") return invalid();\n  return value;\n}\nexport function purpose(value: unknown): PublicMediaPurpose {\n  if (value !== \"public-avatar\" && value !== \"public-portfolio\") return invalid();\n  return value;\n}\nfunction mime(value: unknown): typeof IMAGE_MIMES[number] {\n  if (!IMAGE_MIMES.includes(value as typeof IMAGE_MIMES[number])) return invalid();\n  return value as typeof IMAGE_MIMES[number];\n}\nfunction safeUrl(value: unknown): string {\n  const result = text(value, 2048, true);\n  if (/[\\s\\\\]/u.test(result)) return invalid();\n  let url: URL; try { url = new URL(result); } catch { return invalid(); }\n  if (![\"http:\", \"https:\"].includes(url.protocol) || !url.hostname || url.username || url.password || url.hash) return invalid();\n  return result;\n}\nfunction image(value: unknown): ImageRef {\n  const v = object(value);\n  if (v.type !== \"image\") return invalid();\n  return { id: integer(v.id), url: safeUrl(v.url), type: \"image\" };\n}\nfunction taxonomy(value: unknown): TaxonomyRef {\n  const v = object(value); return { id: integer(v.id), name: text(v.name, 200, true), slug: slug(v.slug) };\n}\nfunction list<T extends { id: number }>(value: unknown, max: number, parse: (v: unknown) => T): T[] {\n  if (!Array.isArray(value) || value.length > max) return invalid();\n  const result = value.map(parse);\n  if (new Set(result.map(v => v.id)).size !== result.length) return invalid();\n  return result;\n}\nfunction nullable<T>(value: unknown, parse: (v: unknown) => T): T | null { return value === null ? null : parse(value); }\nfunction boolean(value: unknown): boolean { if (typeof value !== \"boolean\") return invalid(); return value; }\nexport function parseAccount(value: unknown): AccountDto {\n  const v = object(value); const masked = nullable(v.login_phone_masked, x => text(x, 16, true));\n  if (masked !== null && !/^09\\*{5}\\d{4}$/u.test(masked)) return invalid();\n  return {\n    id: integer(v.id), displayName: text(v.display_name, 160), role: role(v.role), loginPhoneMasked: masked,\n    avatar: nullable(v.avatar, image), location: nullable(v.location, taxonomy),\n    specialist: nullable(v.specialist, raw => { const s = object(raw); return { id: integer(s.id), slug: slug(s.slug), status: status(s.status) }; }),\n  };\n}\nexport function parseGallery(value: unknown): GalleryDto {\n  const v = object(value);\n  const galleryAvailable = boolean(v.gallery_available);\n  const galleryRevision = nullable(v.gallery_revision, x => integer(x, 0));\n  if (galleryAvailable && galleryRevision === null) return invalid();\n  return {\n    gallery: list(v.gallery, 20, raw => { const i = object(raw); return { ...image(i), caption: multiline(i.caption, 300) }; }),\n    galleryRevision, galleryAvailable, status: status(v.status),\n  };\n}\nexport function parseProfile(value: unknown): ProfileDto {\n  const v = object(value); const availability = v.availability;\n  if (availability !== \"\" && availability !== \"available\" && availability !== \"busy\" && availability !== \"away\") return invalid();\n  return {\n    ...parseGallery(v), id: integer(v.id), slug: slug(v.slug), title: text(v.title, 160),\n    categories: list(v.categories, 10, taxonomy), cities: list(v.cities, 1, taxonomy), avatar: nullable(v.avatar, image),\n    bio: multiline(v.bio, 4000), skills: multiline(v.skills, 1000), address: multiline(v.address, 500), availability,\n    priceHint: multiline(v.price_hint, 200), experienceYears: nullable(v.experience_years, x => integer(x, 0, 80)),\n    ...(Object.hasOwn(v, \"verified\") ? { verified: boolean(v.verified) } : {}),\n  };\n}\nexport function parseUpload(value: unknown): UploadDto {\n  const v = object(value); return { ...image(v), mime: mime(v.mime), purpose: purpose(v.purpose) };\n}\nexport function parseCapabilities(value: unknown): MediaCapabilitiesDto {\n  const v = object(value); const video = object(v.video);\n  if (!Array.isArray(v.purposes) || v.purposes.length < 1 || v.purposes.length > 2 ||\n    !Array.isArray(v.image_mimes) || v.image_mimes.length < 1 || v.image_mimes.length > 4 ||\n    v.max_files !== 1 || v.image_decoder_required !== true || video.enabled !== false || video.reason !== \"video_unsupported\") return invalid();\n  const purposes = v.purposes.map(purpose); const imageMimes = v.image_mimes.map(mime);\n  if (new Set(purposes).size !== purposes.length || new Set(imageMimes).size !== imageMimes.length) return invalid();\n  return { purposes, imageMimes, maxBytes: integer(v.max_bytes, 1, MAX_FILE_BYTES), maxDimension: integer(v.max_dimension, 1, 8192),\n    maxPixels: integer(v.max_pixels, 1, 24_000_000), maxFiles: 1, maxGalleryItems: integer(v.max_gallery_items, 1, 20),\n    video: { enabled: false, reason: \"video_unsupported\" }, imageDecoderRequired: true };\n}\n\nexport type InputKind = \"account\" | \"profile\" | \"submit\" | \"gallery\" | \"delete\";\nconst allowed: Record<InputKind, readonly string[]> = {\n  account: [\"display_name\", \"account_city_id\", \"avatar_id\"],\n  profile: [\"title\", \"bio\", \"skills\", \"category_ids\", \"city_id\", \"availability\", \"experience_years\", \"price_hint\", \"address\", \"avatar_id\"],\n  submit: [], gallery: [\"media_id\", \"caption\", \"kind\", \"expected_revision\"], delete: [\"expected_revision\"],\n};\n/** Output uses the backend's fixed field names. No caller-selected authority or URL. */\nexport function parseInput(kind: InputKind, value: unknown): Record<string, unknown> {\n  const v = object(value); const out: Record<string, unknown> = {};\n  for (const key of Object.keys(v)) {\n    if (!allowed[kind].includes(key)) return invalid();\n    const x = v[key];\n    switch (key) {\n      case \"display_name\": out[key] = text(x, 100, true); break;\n      case \"title\": out[key] = text(x, 160, true); break;\n      case \"bio\": out[key] = multiline(x, 4000); break;\n      case \"skills\": out[key] = multiline(x, 1000); break;\n      case \"price_hint\": out[key] = multiline(x, 200); break;\n      case \"address\": out[key] = multiline(x, 500); break;\n      case \"caption\": out[key] = multiline(x, 300); break;\n      case \"avatar_id\": case \"account_city_id\": case \"city_id\": out[key] = nullable(x, integer); break;\n      case \"media_id\": out[key] = integer(x); break;\n      case \"expected_revision\": out[key] = integer(x, 0); break;\n      case \"experience_years\": out[key] = nullable(x, y => integer(y, 0, 80)); break;\n      case \"category_ids\": {\n        if (!Array.isArray(x) || x.length > 10) return invalid();\n        const ids = x.map(y => integer(y)); if (new Set(ids).size !== ids.length) return invalid(); out[key] = ids; break;\n      }\n      case \"availability\": if (![\"\", \"available\", \"busy\", \"away\"].includes(x as string)) return invalid(); out[key] = x; break;\n      case \"kind\": if (x !== \"image\") return invalid(); out[key] = \"image\"; break;\n    }\n  }\n  if (kind === \"gallery\" && !Object.hasOwn(out, \"media_id\")) return invalid();\n  return out;\n}\nexport function parseMediaId(value: string): number {\n  if (!/^[1-9]\\d{0,15}$/u.test(value)) return invalid();\n  return integer(Number(value));\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/services/profile/profile-route-adapters.test.ts": {
      "sha256": "a3b7ba771c0c4a7fd4f7212416c35e078c9f56e60cc79b6c62f870dc99667e9a",
      "text": "import assert from \"node:assert/strict\";\nimport { test } from \"node:test\";\nimport { createAuthCoordinator, createRefreshCoordinator, type AuthGatewayPort, type AuthSessionData } from \"../auth/auth-coordinator.ts\";\nimport { createProfileGateway } from \"./profile-gateway.ts\";\nimport * as adapters from \"./profile-route-adapters.ts\";\nimport * as service from \"./profile-service.ts\";\nimport { WordPressApiError } from \"../wordpress/errors.ts\";\nconst origin=\"https://app.example\";\nconst rawAccount={id:47,display_name:\"نام\",role:\"specialist\",login_phone_masked:\"09*****6789\",avatar:null,location:null,specialist:{id:51,slug:\"specialist-47\",status:\"draft\"}};\nconst rawProfile={id:51,slug:\"specialist-47\",title:\"عنوان\",status:\"draft\",categories:[],cities:[],avatar:null,gallery:[],gallery_revision:0,gallery_available:true,bio:\"درباره\",skills:\"\",address:\"خصوصی\",availability:\"\",price_hint:\"\",experience_years:null};\nconst rawCap={purposes:[\"public-avatar\",\"public-portfolio\"],image_mimes:[\"image/png\"],max_bytes:20971520,max_dimension:8192,max_pixels:24000000,max_files:1,max_gallery_items:20,video:{enabled:false,reason:\"video_unsupported\"},image_decoder_required:true};\nfunction state(role:\"client\"|\"specialist\"=\"specialist\"):AuthSessionData {return {sessionId:\"9aa0a1b2-c3d4-4e5f-8a90-b1c2d3e4f5a6\",version:1,auth:{accessToken:\"private-access\",refreshToken:\"private-refresh\",accessExpiresAt:Date.now()+90_000,refreshExpiresAt:Date.now()+900_000,generation:\"84e86fd2-2205-4880-a65c-4b8da64489f1\",account:{id:47,displayName:\"نام\",role}}};}\nfunction request(body:unknown={},headers:Record<string,string>={}){return new Request(origin+\"/api/profile/me\",{method:\"POST\",headers:{origin,\"content-type\":\"application/json\",...headers},body:JSON.stringify(body)});}\nfunction fixture(options:{role?:\"client\"|\"specialist\";anonymous?:boolean;response?:(path:string,method:string,body:unknown)=>unknown;saveFail?:boolean}={}) {\n  let current:AuthSessionData|undefined=options.anonymous?undefined:state(options.role); const saves:AuthSessionData[]=[]; const calls:Array<{path:string;method:string;token:string;body?:unknown}>=[];\n  const authGateway:AuthGatewayPort={requestOtp:async()=>{throw Error();},verifyOtp:async()=>{throw Error();},refresh:async()=>{throw Error(\"must not refresh\");},me:async()=>{throw Error();},logoutRefresh:async()=>({logged_out:true})};\n  const auth=createAuthCoordinator({session:{read:()=>current,save:async next=>{if(options.saveFail)throw Error(\"private cookie error\");current=next;saves.push(next);},destroy:()=>{current=undefined;}},gateway:authGateway,now:()=>Date.now(),uuid:()=>crypto.randomUUID(),ensureOtpReady:async()=>{},refreshCoordinator:createRefreshCoordinator(()=>Date.now())});\n  const gateway=createProfileGateway({json:async(path,init)=>{\n    calls.push({path,...init}); const replacement=options.response?.(path,init.method,init.body); if(replacement!==undefined)return replacement;\n    if(path===\"account/me\")return {...rawAccount,...(options.role===\"client\"?{role:\"client\",specialist:null}:{})};\n    if(path===\"uploads\")return {...rawCap,...(options.role===\"client\"?{purposes:[\"public-avatar\"]}:{})};\n    if(path.includes(\"gallery\"))return {gallery:[],gallery_revision:1,gallery_available:true,status:\"pending\"};\n    return {...rawProfile,...(init.method===\"POST\"?{status:\"pending\"}:{})};\n  },upload:async(token,input)=>{calls.push({path:\"uploads\",method:\"POST\",token});return {id:31,url:\"https://media.example/a.png\",type:\"image\",mime:\"image/png\",purpose:input.purpose};}});\n  const s=service.createProfileService({auth,gateway});\n  const handlers=adapters.createProfileRouteHandlers({appOrigin:origin,getService:async()=>s});\n  return {s,handlers,calls,saves,auth};\n}\n\ntest(\"actual production route adapter exposes minimized account/profile/capabilities with private no-store and no cookie writes on GET\",async()=>{\n  assert.equal(typeof adapters.createProfileRouteHandlers,\"function\",\"production profile adapter missing\");\n  const f=fixture();\n  for(const method of [\"account\",\"profile\",\"capabilities\"] as const){const r=await f.handlers[method](new Request(origin));assert.equal(r.status,200);assert.equal(r.headers.get(\"cache-control\"),\"private, no-store\");assert.equal(r.headers.has(\"access-control-allow-origin\"),false);const text=await r.text();assert.ok(!text.includes(\"private-access\")&&!text.includes(\"private-refresh\")&&!text.includes(\"09123456789\"));}\n  assert.equal(f.saves.length,0);\n});\n\ntest(\"invalid Origin, forbidden keys, invalid IDs and malformed bodies cause zero upstream calls\",async()=>{\n  const f=fixture();\n  const results=[await f.handlers.updateAccount(request({role:\"administrator\"})),await f.handlers.updateProfile(request({status:\"publish\"})),await f.handlers.submit(request({verified:true})),await f.handlers.addGallery(request({media_id:1,owner:47})),await f.handlers.deleteGallery(request(),\"1/2\"),await f.handlers.updateAccount(request({}, {origin:\"https://evil.example\"}))];\n  for(const r of results)assert.ok([403,422].includes(r.status));\n  assert.equal(f.calls.length,0);\n});\n\ntest(\"anonymous and clients cannot use specialist operations; clients retain account/avatar capability\",async()=>{\n  const anonymous=fixture({anonymous:true}); assert.equal((await anonymous.handlers.account(new Request(origin))).status,401);assert.equal(anonymous.calls.length,0);\n  const client=fixture({role:\"client\"}); assert.equal((await client.handlers.profile(new Request(origin))).status,403);assert.equal(client.calls.length,0);\n  assert.equal((await client.handlers.account(new Request(origin))).status,200);\n  assert.equal((await client.handlers.capabilities(new Request(origin))).status,200);\n  const data=new FormData();data.append(\"purpose\",\"public-portfolio\");data.append(\"file\",new File([\"x\"],\"a.png\",{type:\"image/png\"}));\n  const r=await client.handlers.upload(new Request(origin,{method:\"POST\",headers:{origin},body:data}));assert.equal(r.status,403);assert.equal(client.calls.some(c=>c.method===\"POST\"),false);\n});\n\ntest(\"account mutation rereads authoritative identity and updates summary without rotation\",async()=>{\n  let written=false;\n  const f=fixture({response:(path,method)=>{if(path!==\"account/me\")return undefined;if(method===\"POST\")written=true;return {...rawAccount,display_name:written?\"تازه\":\"نام\"};}});\n  const r=await f.handlers.updateAccount(request({display_name:\"تازه\"}));assert.equal(r.status,200);\n  assert.deepEqual(f.calls.map(c=>[c.path,c.method]),[[\"account/me\",\"POST\"],[\"account/me\",\"GET\"]]);\n  assert.equal(f.saves.length,1);assert.equal(f.saves[0].auth!.account.displayName,\"تازه\");assert.equal(f.saves[0].auth!.refreshToken,\"private-refresh\");\n  assert.equal((await r.json()).account.displayName,\"تازه\");\n});\n\ntest(\"owner identity/role/link mismatches and save failures never return authenticated success\",async()=>{\n  for(const patch of [{id:90},{role:\"client\"}]){const f=fixture({response:()=>({...rawAccount,...patch})});const r=await f.handlers.updateAccount(request({display_name:\"تازه\"}));assert.equal(r.status,503);assert.equal(f.saves.length,0);}\n  const mismatch=fixture({response:path=>path===\"profile/me\"?{...rawProfile,id:90}:undefined});assert.equal((await mismatch.handlers.profile(new Request(origin))).status,503);\n  const failed=fixture({saveFail:true});assert.equal((await failed.handlers.updateAccount(request({display_name:\"تازه\"}))).status,503);assert.equal(failed.calls.length,2);\n  const noConfig=adapters.createProfileRouteHandlers({appOrigin:undefined,getService:async()=>{throw Error(\"must not open\");}});assert.equal((await noConfig.account(new Request(origin))).status,503);\n});\n\ntest(\"query-driven proxy/authority attempts are rejected without upstream activity\",async()=>{\n  const f=fixture();\n  for(const method of [\"account\",\"profile\",\"capabilities\"] as const){const r=await f.handlers[method](new Request(origin+\"/?rest_route=/wp/v2/users&owner=99\"));assert.equal(r.status,400);}\n  const r=await f.handlers.updateAccount(new Request(origin+\"/?owner=99\",{method:\"POST\",headers:{origin,\"content-type\":\"application/json\"},body:\"{}\"}));assert.equal(r.status,400);assert.equal(f.calls.length,0);\n});\n\ntest(\"multipart production adapter accepts fixed public-avatar bytes without serializing credentials\",async()=>{\n  const f=fixture({role:\"client\"});const data=new FormData();data.append(\"file\",new File([\"boundary-only-fixture\"],\"avatar.png\",{type:\"image/png\"}));data.append(\"purpose\",\"public-avatar\");\n  const r=await f.handlers.upload(new Request(origin+\"/api/profile/media\",{method:\"POST\",headers:{origin},body:data}));assert.equal(r.status,200);const body=await r.json();assert.equal(body.media.purpose,\"public-avatar\");assert.equal(body.media.type,\"image\");assert.ok(!JSON.stringify(body).includes(\"private-access\"));assert.deepEqual(f.calls.map(c=>[c.path,c.method]),[[\"uploads\",\"POST\"]]);\n});\n\ntest(\"bodyless DELETE checks CSRF and sends only an empty revision object\",async()=>{\n  const f=fixture();\n  const r=await f.handlers.deleteGallery(new Request(origin+\"/api/profile/gallery/media/31\",{method:\"DELETE\",headers:{origin}}),\"31\");assert.equal(r.status,200);assert.deepEqual(f.calls.at(-1)!.body,{});\n  const denial=fixture();const bad=await denial.handlers.deleteGallery(new Request(origin,{method:\"DELETE\"}),\"31\");assert.equal(bad.status,403);assert.equal(denial.calls.length,0);\n});\n\ntest(\"logout during a completed upstream mutation reports reload rather than replay or rollback\",async()=>{\n  let release!:()=>void;let started!:()=>void;let persisted=false;\n  const wait=new Promise<void>(r=>{release=r;});const entered=new Promise<void>(r=>{started=r;});\n  const f=fixture({response:async(path,method)=>{if(method===\"POST\"){persisted=true;started();await wait;return {...rawProfile,status:\"pending\"};}return rawAccount;}});\n  const pending=f.handlers.updateProfile(request({bio:\"تازه\"}));await entered;await f.auth.logout();release();const r=await pending;\n  assert.equal(r.status,401);assert.equal((await r.json()).error.reloadRequired,true);assert.equal(persisted,true);assert.equal(f.calls.filter(c=>c.method===\"POST\").length,1);assert.equal(f.saves.length,0);\n});\n\ntest(\"logout during owner preflight prevents the later mutation from being sent\",async()=>{\n  let release!:()=>void; let started!:()=>void;\n  const wait=new Promise<void>(r=>{release=r;});const entered=new Promise<void>(r=>{started=r;});\n  const f=fixture({response:async(path,method)=>{if(path===\"account/me\" && method===\"GET\"){started();await wait;return rawAccount;}return rawProfile;}});\n  const pending=f.handlers.updateProfile(request({bio:\"تازه\"}));await entered;await f.auth.logout();release();\n  const r=await pending;assert.equal(r.status,401);assert.equal(f.calls.filter(c=>c.method===\"POST\").length,0);\n});\n\ntest(\"fixed profile/submit/gallery/delete paths preserve draft/pending truth and return safe stale-revision errors without replay\",async()=>{\n  const f=fixture();\n  for(const [method,body,id] of [[\"updateProfile\",{bio:\"تازه\"},undefined],[\"submit\",{},undefined],[\"addGallery\",{media_id:31,expected_revision:0},undefined],[\"deleteGallery\",{expected_revision:1},\"31\"]] as const){const r=method===\"deleteGallery\"?await f.handlers.deleteGallery(request(body),id!):await f.handlers[method](request(body));assert.equal(r.status,200);}\n  assert.deepEqual(f.calls.filter(c=>c.method!==\"GET\").map(c=>c.path),[\"profile/me\",\"profile/me/submit\",\"profile/me/gallery\",\"profile/me/gallery/media/31\"]);\n  const conflict=fixture({response:(_path,method)=>{if(method===\"POST\")throw new WordPressApiError({status:409,code:\"gallery_revision_conflict\",message:\"private-access 09123456789\"});}});\n  const r=await conflict.handlers.addGallery(request({media_id:31,expected_revision:1}));assert.equal(r.status,409);assert.equal((await r.json()).error.code,\"gallery_revision_conflict\");assert.equal(conflict.calls.filter(c=>c.method===\"POST\").length,1);\n  const uncertain=fixture({response:(_path,method)=>{if(method===\"POST\")throw Error(\"private-access 09123456789 /server/path\");}});\n  const e=await uncertain.handlers.updateProfile(request({bio:\"تازه\"}));assert.equal(e.status,503);const text=await e.text();assert.ok(!text.includes(\"09123456789\"));assert.equal(uncertain.calls.filter(c=>c.method===\"POST\").length,1);\n});\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/services/profile/profile-request-policy.test.ts": {
      "sha256": "adafdc2cc860d650fedd1128cde7b27d714e81ca9a0b0212f38d5709ef1c7da2",
      "text": "import assert from \"node:assert/strict\";\nimport { test } from \"node:test\";\nimport * as policy from \"./profile-request-policy.ts\";\nconst origin = \"https://app.example\";\nconst req = (body: BodyInit, type = \"application/json\", headers: Record<string,string> = {}) => new Request(origin + \"/api/profile/me\", { method: \"POST\", headers: { origin, \"content-type\": type, ...headers }, body });\nfunction form(purpose = \"public-avatar\", filename = \"avatar.png\", mime = \"image/png\") {\n  const data = new FormData(); data.append(\"file\", new File([new Uint8Array([1,2,3])], filename, { type: mime })); data.append(\"purpose\", purpose); return data;\n}\nfunction multipart(data: FormData) { return new Request(origin + \"/api/profile/media\", { method: \"POST\", headers: { origin }, body: data }); }\n\ntest(\"JSON boundary shares exact Origin and Fetch Metadata policy and bounds actual bytes to 16KiB\", async () => {\n  assert.equal(typeof policy.parseProfileJson, \"function\", \"bounded profile request reader missing\");\n  assert.deepEqual(await policy.parseProfileJson(req(JSON.stringify({bio: \"ب\".repeat(4000)})), origin, \"profile\"), { bio: \"ب\".repeat(4000) });\n  for (const headers of [{origin: \"https://evil.example\"}, {origin: \"null\"}, {\"sec-fetch-site\": \"cross-site\"}] as Record<string,string>[]) await assert.rejects(policy.parseProfileJson(req(\"{}\", \"application/json\", headers), origin, \"submit\"), { status: 403 });\n  await assert.rejects(policy.parseProfileJson(req(\"{}\", \"text/plain\"), origin, \"submit\"), { status: 415 });\n  await assert.rejects(policy.parseProfileJson(req(\" \".repeat(16385), \"application/json\", {\"content-length\":\"1\"}), origin, \"submit\"), { status: 413 });\n  await assert.rejects(policy.parseProfileJson(req(JSON.stringify({ bio: \"\\ud800\" })), origin, \"profile\"));\n});\n\ntest(\"multipart accepts only one public-purpose image and rejects repeats, unknown authority and unsafe filenames\", async () => {\n  const valid = await policy.parseProfileMultipart(multipart(form()), origin);\n  assert.equal(valid.purpose, \"public-avatar\"); assert.equal(valid.file.name, \"avatar.png\");\n  for (const extra of [\"purpose\", \"file\", \"owner\", \"context\", \"status\"]) {\n    const data = form(); data.append(extra, extra === \"file\" ? new File([\"x\"], \"b.png\", {type:\"image/png\"}) : \"public-avatar\");\n    await assert.rejects(policy.parseProfileMultipart(multipart(data), origin));\n  }\n  for (const data of [form(\"private\"), form(\"public-avatar\", \"bad.svg\", \"image/svg+xml\"), form(\"public-avatar\", \"movie.mp4\", \"video/mp4\"), form(\"public-avatar\", \"x\".repeat(201)+\".png\")]) await assert.rejects(policy.parseProfileMultipart(multipart(data), origin));\n  const empty = new FormData(); empty.append(\"file\", new File([], \"empty.png\", {type:\"image/png\"})); empty.append(\"purpose\", \"public-avatar\");\n  await assert.rejects(policy.parseProfileMultipart(multipart(empty), origin));\n  await assert.rejects(policy.parseProfileMultipart(req(\"broken\", \"multipart/form-data; boundary=bad\"), origin));\n  await assert.rejects(policy.parseProfileMultipart(req(\"broken\", \"multipart/form-data\"), origin));\n});\n\ntest(\"streamed multipart overflow cancels the reader before platform allocation despite a fake Content-Length\", async () => {\n  let cancelled = false;\n  const stream = new ReadableStream<Uint8Array>({ pull(c) { c.enqueue(new Uint8Array(1024*1024)); }, cancel() { cancelled = true; } });\n  const request = new Request(origin, { method: \"POST\", headers: {origin,\"content-type\":\"multipart/form-data; boundary=safe\",\"content-length\":\"1\"}, body: stream, duplex:\"half\" } as RequestInit);\n  await assert.rejects(policy.parseProfileMultipart(request, origin), { status: 413 });\n  assert.equal(cancelled, true);\n});\n\ntest(\"bounded request reader handles abort and a stalled body without hanging\", async () => {\n  let cancelled = false;\n  const stream = () => new ReadableStream<Uint8Array>({ cancel() { cancelled = true; } });\n  const stalled = new Request(origin, {method:\"POST\", headers:{origin,\"content-type\":\"application/json\"},body:stream(),duplex:\"half\"} as RequestInit);\n  await assert.rejects(policy.readBoundedBody(stalled, 16384, 10), { code: \"body_timeout\" });\n  assert.equal(cancelled, true);\n  const controller = new AbortController();\n  const aborted = new Request(origin, {method:\"POST\",body:stream(),signal:controller.signal,duplex:\"half\"} as RequestInit);\n  const pending = policy.readBoundedBody(aborted, 16384, 1000); controller.abort();\n  await assert.rejects(pending, {code:\"request_aborted\"});\n});\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/services/profile/profile-route-adapters.ts": {
      "sha256": "f15ad1f34f12fd458a33957032350100e4c51f16ecd1d2a6bf0f019c02e10a92",
      "text": "import type { ProfileService } from \"./profile-service.ts\";\nimport { ProfileBoundaryError, parseMediaId, type InputKind } from \"./profile-contracts.ts\";\nimport { parseProfileJson, parseProfileMultipart } from \"./profile-request-policy.ts\";\nimport { safeProfileError } from \"./profile-errors.ts\";\n\nexport interface ProfileRouteDependencies {\n  appOrigin: string | undefined;\n  getService(readOnly: boolean): Promise<ProfileService>;\n}\nconst headers = { \"Cache-Control\": \"private, no-store\", Pragma: \"no-cache\", Vary: \"Cookie\" };\nfunction json(body: unknown, status = 200) { return Response.json(body, { status, headers }); }\nfunction failure(error: unknown, mutation = false) {\n  const safe = safeProfileError(error, mutation);\n  return json({ error: { code: safe.code, message: safe.message, reloadRequired: mutation } }, safe.status);\n}\n\nexport function createProfileRouteHandlers(dependencies: ProfileRouteDependencies) {\n  function origin(request: Request): string {\n    if (!dependencies.appOrigin) throw new ProfileBoundaryError(\"profile_unavailable\", 503);\n    if (new URL(request.url).search) throw new ProfileBoundaryError(\"invalid_request\", 400);\n    return dependencies.appOrigin;\n  }\n  async function run(operation: (s: ProfileService) => Promise<unknown>, mutation = false): Promise<Response> {\n    try { return json(await operation(await dependencies.getService(!mutation))); }\n    catch (error) { return failure(error, mutation); }\n  }\n  async function read(request: Request, operation: (s: ProfileService) => Promise<unknown>): Promise<Response> {\n    try { origin(request); return await run(operation); }\n    catch (error) { return failure(error); }\n  }\n  async function write(\n    request: Request, kind: InputKind,\n    operation: (s: ProfileService, body: Record<string, unknown>) => Promise<unknown>,\n  ): Promise<Response> {\n    // CSRF, bounded parsing, and authority validation precede session/upstream access.\n    try {\n      const body = await parseProfileJson(request, origin(request), kind);\n      return await run(s => operation(s, body), true);\n    } catch (error) { return failure(error, true); }\n  }\n  return {\n    account: (request: Request) => read(request, async s => ({ account: await s.account() })),\n    profile: (request: Request) => read(request, async s => ({ profile: await s.profile() })),\n    capabilities: (request: Request) => read(request, async s => ({ capabilities: await s.capabilities() })),\n    updateAccount: (request: Request) => write(request, \"account\", async (s, body) => ({ account: await s.updateAccount(body) })),\n    updateProfile: (request: Request) => write(request, \"profile\", async (s, body) => ({ profile: await s.updateProfile(body) })),\n    submit: (request: Request) => write(request, \"submit\", async s => ({ profile: await s.submit() })),\n    addGallery: (request: Request) => write(request, \"gallery\", async (s, body) => ({ gallery: await s.addGallery(body) })),\n    async deleteGallery(request: Request, id: string) {\n      try {\n        origin(request);\n        parseMediaId(id);\n        // Optional revision body; absence is an empty object, NOT an alternate query input.\n        const normalizedHeaders = new Headers(request.headers);\n        normalizedHeaders.set(\"content-type\", \"application/json\");\n        const normalized = request.body === null ? new Request(request.url, {\n          method: \"DELETE\", headers: normalizedHeaders, body: \"{}\", signal: request.signal,\n        }) : request;\n        return await write(normalized, \"delete\", async (s, body) => ({ gallery: await s.deleteGallery(id, body) }));\n      } catch (error) { return failure(error, true); }\n    },\n    async upload(request: Request) {\n      try {\n        const input = await parseProfileMultipart(request, origin(request));\n        return await run(async s => ({ media: await s.upload(input) }), true);\n      } catch (error) { return failure(error, true); }\n    },\n  };\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/services/profile/profile-errors.ts": {
      "sha256": "ef1f07c0e533087c3b3ced370ace13dcd59052f4527539af8071c6d23bbb238f",
      "text": "import { AuthCoordinatorError } from \"../auth/auth-coordinator.ts\";\nimport { AuthRequestPolicyError } from \"../../lib/auth-request-policy.ts\";\nimport { WordPressApiError } from \"../wordpress/errors.ts\";\nimport { ProfileBoundaryError } from \"./profile-contracts.ts\";\n\nconst backendStatus: Record<string, number> = {\n  unauthenticated:401, forbidden:403, no_profile:404, gallery_media_not_found:404,\n  invalid_profile_state:409, profile_link_conflict:409, duplicate_media:409, gallery_busy:409,\n  gallery_revision_conflict:409, gallery_revision_exhausted:409, gallery_storage_unavailable:409,\n  invalid_availability:422, invalid_categories:422, invalid_city:422, invalid_display_name:422,\n  invalid_experience:422, invalid_media:422, invalid_taxonomy:422, profile_incomplete:422,\n  unknown_field:422, invalid_title:422, invalid_bio:422, invalid_skills:422, invalid_price_hint:422,\n  invalid_address:422, gallery_full:422, invalid_gallery:422, invalid_revision:422,\n  empty_upload:422, invalid_purpose:422, invalid_upload:422, upload_incomplete:422,\n  image_decoder_unavailable_or_invalid:415, invalid_image:415, mime_not_allowed:415, video_unsupported:415,\n  too_large:413, media_detection_unavailable:503,\n};\n/** Never reuse backend message/data/cause, even when transport redacted tokens. */\nexport function safeProfileError(error: unknown, mutation = false): ProfileBoundaryError {\n  if (error instanceof ProfileBoundaryError) return error;\n  if (error instanceof AuthRequestPolicyError || error instanceof AuthCoordinatorError) return new ProfileBoundaryError(error.code, error.status);\n  if (error instanceof WordPressApiError && Object.hasOwn(backendStatus,error.code)) return new ProfileBoundaryError(error.code,backendStatus[error.code]);\n  return new ProfileBoundaryError(mutation ? \"operation_uncertain\" : \"profile_unavailable\",503);\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/store/ui.ts": {
      "sha256": "882786f3ac2a26f2bcc81b75fe7fef82bf0eb2ed6a3d5108ee66960e070f6d13",
      "text": "\"use client\";\n\nimport { create } from \"zustand\";\n\ninterface UIState {\n  menuOpen: boolean;\n  setMenuOpen: (open: boolean) => void;\n  city: string;\n  setCity: (city: string) => void;\n  splashDone: boolean;\n  setSplashDone: (done: boolean) => void;\n  walletBalance: number;\n  deductWallet: (amount: number) => void;\n  unlockedLeads: string[];\n  unlockLead: (id: string) => void;\n}\n\nexport const useUIStore = create<UIState>((set) => ({\n  menuOpen: false,\n  setMenuOpen: (menuOpen) => set({ menuOpen }),\n  city: \"تهران\",\n  setCity: (city) => set({ city }),\n  splashDone: false,\n  setSplashDone: (splashDone) => set({ splashDone }),\n  walletBalance: 480_000,\n  deductWallet: (amount) =>\n    set((s) => ({ walletBalance: Math.max(0, s.walletBalance - amount) })),\n  unlockedLeads: [\"l3\"],\n  unlockLead: (id) =>\n    set((s) => ({ unlockedLeads: [...s.unlockedLeads, id] })),\n}));\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/app/layout.tsx": {
      "sha256": "2e3328f950b7f1d8f867e5c7d19e1c2f120746ca2f978b374e9a706bf3b4cf12",
      "text": "import type { Metadata, Viewport } from \"next\";\nimport localFont from \"next/font/local\";\nimport \"./globals.css\";\nimport { Providers } from \"@/components/layout/Providers\";\nimport { AppShell } from \"@/components/layout/AppShell\";\nimport { SITE_URL, orgJsonLd, serializeJsonLd, webSiteJsonLd } from \"@/lib/seo\";\n\nconst yekan = localFont({\n  src: \"../../public/fonts/Yekan.woff\",\n  variable: \"--font-yekan-face\",\n  display: \"swap\",\n});\n\nexport const metadata: Metadata = {\n  metadataBase: new URL(SITE_URL),\n  title: {\n    default: \"کاربان | فهرست متخصصان ساختمان\",\n    template: \"%s | کاربان\",\n  },\n  description: \"فهرست عمومی متخصصان و خدمات ساختمانی کاربان.\",\n  applicationName: \"کاربان\",\n  keywords: [\"استادکار\", \"متخصص ساختمان\", \"برق‌کار\", \"لوله‌کش\", \"نقاشی ساختمان\", \"بازسازی خانه\"],\n  alternates: { canonical: \"/\" },\n  openGraph: {\n    type: \"website\",\n    locale: \"fa_IR\",\n    siteName: \"کاربان\",\n    title: \"کاربان | فهرست متخصصان ساختمان\",\n    description: \"فهرست عمومی متخصصان و خدمات ساختمانی کاربان.\",\n    url: SITE_URL,\n  },\n  twitter: {\n    card: \"summary\",\n    title: \"کاربان | فهرست متخصصان ساختمان\",\n    description: \"فهرست عمومی متخصصان و خدمات ساختمانی کاربان.\",\n  },\n  robots: { index: true, follow: true, googleBot: { index: true, follow: true, \"max-image-preview\": \"large\" } },\n  appleWebApp: { capable: true, statusBarStyle: \"black-translucent\", title: \"کاربان\" },\n};\n\nexport const viewport: Viewport = {\n  themeColor: [\n    { media: \"(prefers-color-scheme: dark)\", color: \"#050b10\" },\n    { media: \"(prefers-color-scheme: light)\", color: \"#ffffff\" },\n  ],\n  width: \"device-width\",\n  initialScale: 1,\n  maximumScale: 1,\n  viewportFit: \"cover\",\n};\n\nexport default function RootLayout({ children }: LayoutProps<\"/\">) {\n  return (\n    <html lang=\"fa\" dir=\"rtl\" suppressHydrationWarning className={`${yekan.variable} h-full antialiased`}>\n      <body className=\"min-h-full flex flex-col bg-surface text-fg\">\n        <script type=\"application/ld+json\">{serializeJsonLd(orgJsonLd())}</script>\n        <script type=\"application/ld+json\">{serializeJsonLd(webSiteJsonLd())}</script>\n        <Providers><AppShell>{children}</AppShell></Providers>\n      </body>\n    </html>\n  );\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/app/page.tsx": {
      "sha256": "ce8a7eb024c20bba978a4ba2cdad7603c18a8b3ec098d4261dee6a5d4f89920c",
      "text": "import Link from \"next/link\";\nimport { ArrowLeft, ListFilter, ShieldCheck } from \"lucide-react\";\nimport { Hero } from \"@/components/sections/Hero\";\nimport { CategoryGrid } from \"@/components/sections/CategoryGrid\";\nimport { PublicDataError } from \"@/components/sections/PublicDataState\";\nimport { SpecialistList } from \"@/components/sections/SpecialistList\";\nimport { Reveal } from \"@/components/motion/Reveal\";\nimport { LogoMark } from \"@/components/brand/Logo\";\nimport type { PublicSpecialistCatalog, PublicTerm } from \"@/lib/contracts/specialists\";\nimport { faNum } from \"@/lib/utils\";\nimport { loadPublicSpecialists } from \"@/services/wordpress/public-specialists\";\nimport { loadPublicTerms } from \"@/services/wordpress/taxonomies\";\n\nexport const dynamic = \"force-dynamic\";\nexport const revalidate = 0;\n\ntype HomeData = { catalog: PublicSpecialistCatalog; categories: PublicTerm[]; cities: PublicTerm[] };\n\nasync function loadHomeData(): Promise<HomeData | null> {\n  try {\n    const [catalog, categories, cities] = await Promise.all([\n      loadPublicSpecialists({ page: \"1\", per_page: \"6\" }),\n      loadPublicTerms(\"job_category\"),\n      loadPublicTerms(\"city\"),\n    ]);\n    return { catalog, categories, cities };\n  } catch {\n    return null;\n  }\n}\n\nexport default async function HomePage() {\n  const data = await loadHomeData();\n  if (!data) return <PublicDataError />;\n\n  const { catalog, categories, cities } = data;\n  return (\n    <>\n      <Hero cities={cities} />\n      <CategoryGrid categories={categories} />\n      <SpecialistList specialists={catalog.items} title=\"متخصصان منتشرشده\" description={`${faNum(catalog.total)} متخصص در فهرست عمومی`} showMoreLink />\n      <section className=\"px-4 py-10 sm:px-6\" aria-labelledby=\"why-title\">\n        <div className=\"mx-auto max-w-5xl\">\n          <h2 id=\"why-title\" className=\"mb-2 text-xl font-bold sm:text-2xl\">جستجوی روشن و قابل‌بررسی</h2>\n          <p className=\"mb-7 max-w-xl text-sm leading-relaxed text-muted\">برای انتخاب آگاهانه، فقط اطلاعاتی را نمایش می‌دهیم که در پروفایل عمومی متخصص منتشر شده‌اند.</p>\n          <Reveal stagger={0.12} className=\"grid gap-4 sm:grid-cols-2\">\n            {[\n              { icon: ListFilter, title: \"فیلتر بر اساس دسته و شهر\", text: \"نتیجه‌ها با دسته‌بندی و شهر ثبت‌شده در فهرست عمومی محدود می‌شوند.\" },\n              { icon: ShieldCheck, title: \"نشان تأیید در صورت انتشار\", text: \"نشان تأیید فقط زمانی دیده می‌شود که در دادهٔ عمومی پروفایل ثبت شده باشد.\" },\n            ].map(({ icon: Icon, title, text }) => <div key={title} className=\"rounded-3xl border border-line bg-card p-6\"><span className=\"mb-4 flex h-12 w-12 items-center justify-center rounded-2xl bg-accent/10 text-accent\"><Icon className=\"h-6 w-6\" /></span><h3 className=\"mb-2 font-bold text-fg\">{title}</h3><p className=\"text-sm leading-relaxed text-muted\">{text}</p></div>)}\n          </Reveal>\n        </div>\n      </section>\n      <section className=\"px-4 py-10 sm:px-6\">\n        <Reveal className=\"mx-auto max-w-5xl\"><div className=\"relative overflow-hidden rounded-4xl border border-primary/25 bg-gradient-to-l from-primary/15 via-card to-card p-7 sm:p-10\"><LogoMark className=\"pointer-events-none absolute -left-10 -top-10 h-48 w-48 text-primary/8\" /><div className=\"relative flex flex-col items-start gap-5 sm:flex-row sm:items-center sm:justify-between\"><div><h2 className=\"text-xl font-bold sm:text-2xl\">دنبال تخصص مشخصی هستی؟</h2><p className=\"mt-2 max-w-md text-sm leading-relaxed text-muted\">دسته‌بندی، شهر یا عبارت جستجو را انتخاب کن تا فهرست عمومی را دقیق‌تر ببینی.</p></div><Link href=\"/search\" className=\"inline-flex h-12 items-center gap-2 rounded-2xl bg-primary px-7 font-medium text-primary-fg shadow-[0_10px_28px_-8px_var(--glow)] transition-colors duration-200 hover:bg-primary-hover active:scale-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary\">جستجوی متخصص<ArrowLeft className=\"h-4.5 w-4.5\" /></Link></div></div></Reveal>\n      </section>\n    </>\n  );\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/app/pro/page.tsx": {
      "sha256": "df2823af7d5653ed7d7b9cc76b0b113e7d520e09316b2d5c49e6dd4029ac5d1d",
      "text": "import type {Metadata} from 'next';\nimport {redirect} from 'next/navigation';\nimport {ProDashboard} from '@/components/sections/ProDashboard';\nimport {OwnerUnavailable,SessionRecovery} from '@/components/sections/owner/SessionRecovery';\nimport {readOwnerAccount} from '@/services/profile/profile-bff.server';\nimport {loadAccountEntry} from '@/lib/owner-ui';\nexport const dynamic='force-dynamic';\nexport const metadata:Metadata={title:'داشبورد متخصص',robots:{index:false}};\nexport default async function ProPage(){\n const screen=await loadAccountEntry('specialist',readOwnerAccount,'/pro');\n if(screen.kind==='redirect')redirect(screen.location);\n if(screen.kind==='recovery')return <SessionRecovery target={screen.target} />;\n if(screen.kind==='unavailable')return <OwnerUnavailable />;\n return <ProDashboard displayName={screen.account.displayName} />;\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/app/pro/profile/page.tsx": {
      "sha256": "61616f78d569ccbc9cc3fa56c04827468162dcf1aed4ec820ade0f4c6bb45224",
      "text": "import type {Metadata} from 'next';\nimport {OwnerPage} from '@/components/sections/owner/OwnerPage.server';\nexport const dynamic='force-dynamic';\nexport const metadata:Metadata={title:'ویرایش پروفایل حرفه‌ای',robots:{index:false,follow:false}};\nexport default function ProfilePage(){return <OwnerPage kind=\"profile\" />;}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/app/auth/verify/page.tsx": {
      "sha256": "7651dc0a8b96c07783381f9aeda063dbeec746f099664049852f909862e036d1",
      "text": "import type { Metadata } from \"next\";\nimport { OtpForm } from \"@/components/sections/auth/OtpForm\";\n\nexport const metadata: Metadata = {\n  title: \"تایید کد\",\n  robots: { index: false },\n};\n\nexport default function VerifyPage() {\n  return <OtpForm />;\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/app/auth/select-role/page.tsx": {
      "sha256": "e558419e59e6fda056bc1e146406aae4494c7435d5fa17c70296424daacfbcf7",
      "text": "import { redirect } from \"next/navigation\";\n\nexport default function SelectRolePage() {\n  // Role intent is selected before OTP issuance; this legacy route cannot alter it.\n  redirect(\"/auth/login\");\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/app/auth/recover/page.tsx": {
      "sha256": "8121077afee69203669c00599358e847e5aca17736c85e6b901173adb72b682a",
      "text": "import type {Metadata} from 'next';\nimport {SessionRecovery} from '@/components/sections/owner/SessionRecovery';\nimport {recoveryTarget} from '@/lib/owner-ui';\nexport const dynamic='force-dynamic';\nexport const metadata:Metadata={title:'بازیابی نشست',robots:{index:false,follow:false}};\nexport default async function RecoveryPage({searchParams}:{searchParams:Promise<Record<string,string|string[]|undefined>>}) {\n const params=await searchParams;\n return <SessionRecovery target={recoveryTarget(params.returnTo)} />;\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/app/auth/login/page.tsx": {
      "sha256": "8a5ea74391814feface5486b723375645337c7d7fa603457b0e2685a54814014",
      "text": "import type { Metadata } from \"next\";\nimport { LoginForm } from \"@/components/sections/auth/LoginForm\";\n\nexport const metadata: Metadata = {\n  title: \"ورود / ثبت‌نام\",\n  robots: { index: false },\n};\n\nexport default function LoginPage() {\n  return <LoginForm />;\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/app/specialists/[slug]/page.tsx": {
      "sha256": "3ddfc6878815f0fb98034212525602cd29229089239af13fb6aa7488be7cc10a",
      "text": "import { notFound } from \"next/navigation\";\nimport type { Metadata } from \"next\";\nimport { SpecialistProfile } from \"@/components/sections/SpecialistProfile\";\nimport { PublicDataError } from \"@/components/sections/PublicDataState\";\nimport type { PublicSpecialistDetail } from \"@/lib/contracts/specialists\";\nimport { loadCachedPublicSpecialistDetail } from \"@/lib/public-specialist-detail\";\nimport { breadcrumbJsonLd, serializeJsonLd, specialistJsonLd } from \"@/lib/seo\";\nimport { isPublicSpecialistNotFound } from \"@/services/wordpress/public-specialists\";\n\nexport const dynamic = \"force-dynamic\";\nexport const revalidate = 0;\n\ntype DetailResult =\n  | { specialist: PublicSpecialistDetail; error: null }\n  | { specialist: null; error: unknown };\n\nasync function loadDetail(slug: string): Promise<DetailResult> {\n  try {\n    return { specialist: await loadCachedPublicSpecialistDetail(slug), error: null };\n  } catch (error) {\n    return { specialist: null, error };\n  }\n}\n\nexport async function generateMetadata({ params }: PageProps<\"/specialists/[slug]\">): Promise<Metadata> {\n  const { slug } = await params;\n  const result = await loadDetail(slug);\n  if (!result.specialist) {\n    return isPublicSpecialistNotFound(result.error)\n      ? { title: \"متخصص پیدا نشد\", robots: { index: false, follow: false } }\n      : { title: \"پروفایل متخصص\" };\n  }\n\n  const { specialist } = result;\n  const location = specialist.cities[0] ? ` در ${specialist.cities[0]}` : \"\";\n  const description = specialist.description ?? specialist.bio ?? `پروفایل عمومی ${specialist.title}${location} در کاربان.`;\n  const title = `${specialist.title}${location}`;\n  return { title, description, alternates: { canonical: `/specialists/${encodeURIComponent(specialist.slug)}` }, openGraph: { title, description, type: \"profile\" } };\n}\n\nexport default async function SpecialistPage({ params }: PageProps<\"/specialists/[slug]\">) {\n  const { slug } = await params;\n  const result = await loadDetail(slug);\n  if (!result.specialist) {\n    if (isPublicSpecialistNotFound(result.error)) notFound();\n    return <PublicDataError title=\"پروفایل متخصص بارگذاری نشد\" description=\"اطلاعات عمومی این پروفایل در دسترس نیست. دوباره تلاش کنید.\" />;\n  }\n\n  const { specialist } = result;\n  const path = `/specialists/${encodeURIComponent(specialist.slug)}`;\n  const breadcrumbs = breadcrumbJsonLd([\n    { name: \"کاربان\", path: \"/\" },\n    { name: \"متخصصان\", path: \"/search\" },\n    { name: specialist.title, path },\n  ]);\n  return (\n    <>\n      <script type=\"application/ld+json\">{serializeJsonLd(specialistJsonLd(specialist))}</script>\n      <script type=\"application/ld+json\">{serializeJsonLd(breadcrumbs)}</script>\n      <SpecialistProfile specialist={specialist} />\n    </>\n  );\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/app/search/page.tsx": {
      "sha256": "eb7f872c77c8eafaee608bc97f848b0305e58c62822111727412954815fdde18",
      "text": "import type { Metadata } from \"next\";\nimport Link from \"next/link\";\nimport { ChevronLeft, ChevronRight, SlidersHorizontal } from \"lucide-react\";\nimport { PublicDataError } from \"@/components/sections/PublicDataState\";\nimport { SpecialistList } from \"@/components/sections/SpecialistList\";\nimport type { PublicSpecialistCatalog, PublicSpecialistSearchInput, PublicTerm } from \"@/lib/contracts/specialists\";\nimport { buildCatalogPaginationWindow } from \"@/lib/public-specialist-pagination\";\nimport { buildSpecialistPaginationQuery, parseSpecialistSearchParams } from \"@/lib/specialist-search\";\nimport { faNum } from \"@/lib/utils\";\nimport { loadPublicSpecialists } from \"@/services/wordpress/public-specialists\";\nimport { loadPublicTerms } from \"@/services/wordpress/taxonomies\";\n\nexport const dynamic = \"force-dynamic\";\nexport const revalidate = 0;\n\nexport const metadata: Metadata = {\n  title: \"جستجوی متخصص ساختمان\",\n  description: \"فهرست عمومی متخصصان ساختمان را بر اساس عبارت جستجو، دسته‌بندی، شهر و نشان تأیید فیلتر کنید.\",\n  alternates: { canonical: \"/search\" },\n};\n\ntype SearchPageProps = { searchParams: Promise<PublicSpecialistSearchInput> };\ntype SearchData = { catalog: PublicSpecialistCatalog; categories: PublicTerm[]; cities: PublicTerm[] };\n\nasync function loadSearchData(input: PublicSpecialistSearchInput): Promise<SearchData | null> {\n  try {\n    const [catalog, categories, cities] = await Promise.all([\n      loadPublicSpecialists(input),\n      loadPublicTerms(\"job_category\"),\n      loadPublicTerms(\"city\"),\n    ]);\n    return { catalog, categories, cities };\n  } catch {\n    return null;\n  }\n}\n\nexport default async function SearchPage({ searchParams }: SearchPageProps) {\n  const rawParams = await searchParams;\n  const params = parseSpecialistSearchParams(rawParams);\n  const data = await loadSearchData(rawParams);\n  if (!data) return <PublicDataError title=\"نتیجه‌های جستجو بارگذاری نشد\" description=\"اطلاعات عمومی متخصصان در دسترس نیست. دوباره تلاش کنید.\" />;\n\n  const { catalog, categories, cities } = data;\n  const pagination = buildCatalogPaginationWindow(catalog.page, catalog.pages);\n  const previousPage = catalog.page > 1 ? catalog.page - 1 : null;\n  const nextPage = catalog.page < catalog.pages ? catalog.page + 1 : null;\n  return (\n    <div className=\"mx-auto max-w-5xl\">\n      <div className=\"px-4 pt-6 sm:px-6\">\n        <h1 className=\"text-2xl font-bold\">جستجوی متخصص</h1>\n        <p className=\"mt-1.5 text-sm text-muted\">{faNum(catalog.total)} متخصص در فهرست عمومی پیدا شد</p>\n        <form method=\"get\" className=\"mt-5 rounded-3xl border border-line bg-card p-4\" aria-label=\"فیلتر متخصصان\">\n          <div className=\"grid gap-3 sm:grid-cols-2 lg:grid-cols-4\">\n            <label className=\"text-sm font-medium text-fg\">عبارت جستجو<input name=\"q\" defaultValue={params.q} className=\"mt-1.5 h-11 w-full rounded-xl border border-line bg-elev px-3 text-fg outline-none transition-colors duration-200 focus:border-primary focus:ring-2 focus:ring-primary/30\" placeholder=\"نام یا تخصص\" /></label>\n            <label className=\"text-sm font-medium text-fg\">دسته‌بندی<select name=\"category\" defaultValue={params.category} className=\"mt-1.5 h-11 w-full rounded-xl border border-line bg-elev px-3 text-fg outline-none transition-colors duration-200 focus:border-primary focus:ring-2 focus:ring-primary/30\"><option value=\"\">همهٔ دسته‌ها</option>{categories.map((term) => <option key={term.id} value={term.slug}>{term.name}</option>)}</select></label>\n            <label className=\"text-sm font-medium text-fg\">شهر<select name=\"city\" defaultValue={params.city} className=\"mt-1.5 h-11 w-full rounded-xl border border-line bg-elev px-3 text-fg outline-none transition-colors duration-200 focus:border-primary focus:ring-2 focus:ring-primary/30\"><option value=\"\">همهٔ شهرها</option>{cities.map((term) => <option key={term.id} value={term.slug}>{term.name}</option>)}</select></label>\n            <div className=\"flex flex-col justify-end gap-3\"><label className=\"inline-flex items-center gap-2 text-sm text-fg\"><input name=\"verified\" value=\"1\" type=\"checkbox\" defaultChecked={params.verified} className=\"h-4 w-4 rounded border-line accent-primary\" />فقط دارای نشان تأیید</label><button type=\"submit\" className=\"inline-flex h-11 items-center justify-center gap-2 rounded-xl bg-primary px-4 text-sm font-medium text-primary-fg transition-colors duration-200 hover:bg-primary-hover active:scale-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary\"><SlidersHorizontal className=\"h-4 w-4\" />اعمال فیلتر</button></div>\n          </div>\n        </form>\n      </div>\n      <SpecialistList specialists={catalog.items} title=\"نتیجه‌های جستجو\" description={catalog.total === 0 ? \"\" : `صفحهٔ ${faNum(catalog.page)} از ${faNum(catalog.pages)}`} />\n      {pagination.length > 1 && <nav className=\"mb-10 flex flex-wrap justify-center gap-2 px-4\" aria-label=\"صفحه‌بندی نتایج\">\n        {previousPage === null ? <span aria-hidden className=\"flex h-10 min-w-10 items-center justify-center rounded-xl border border-line text-faint\"><ChevronRight className=\"h-4 w-4\" /></span> : <Link aria-label=\"صفحهٔ قبل\" href={`/search?${buildSpecialistPaginationQuery(params, previousPage)}`} className=\"flex h-10 min-w-10 items-center justify-center rounded-xl border border-line bg-card text-fg transition-colors duration-200 hover:border-primary/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary\"><ChevronRight className=\"h-4 w-4\" /></Link>}\n        {pagination.map((token, index) => token === \"ellipsis\" ? <span key={`ellipsis-${index}`} aria-hidden className=\"flex h-10 min-w-8 items-center justify-center text-muted\">…</span> : <Link key={token} href={`/search?${buildSpecialistPaginationQuery(params, token)}`} aria-current={token === catalog.page ? \"page\" : undefined} className={`flex h-10 min-w-10 items-center justify-center rounded-xl border px-3 text-sm transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary ${token === catalog.page ? \"border-primary bg-primary text-primary-fg\" : \"border-line bg-card text-fg hover:border-primary/50\"}`}>{faNum(token)}</Link>)}\n        {nextPage === null ? <span aria-hidden className=\"flex h-10 min-w-10 items-center justify-center rounded-xl border border-line text-faint\"><ChevronLeft className=\"h-4 w-4\" /></span> : <Link aria-label=\"صفحهٔ بعد\" href={`/search?${buildSpecialistPaginationQuery(params, nextPage)}`} className=\"flex h-10 min-w-10 items-center justify-center rounded-xl border border-line bg-card text-fg transition-colors duration-200 hover:border-primary/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary\"><ChevronLeft className=\"h-4 w-4\" /></Link>}\n      </nav>}\n    </div>\n  );\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/app/dashboard/page.tsx": {
      "sha256": "84615d35ed8a2d077180152e2899d62fddfb4e643e8d60c8396a6c2e8b2f0689",
      "text": "import type {Metadata} from 'next';\nimport {redirect} from 'next/navigation';\nimport {ClientDashboard} from '@/components/sections/ClientDashboard';\nimport {OwnerUnavailable,SessionRecovery} from '@/components/sections/owner/SessionRecovery';\nimport {readOwnerAccount} from '@/services/profile/profile-bff.server';\nimport {loadAccountEntry} from '@/lib/owner-ui';\nexport const dynamic='force-dynamic';\nexport const metadata:Metadata={title:'داشبورد کارفرما',robots:{index:false}};\nexport default async function DashboardPage(){\n const screen=await loadAccountEntry('client',readOwnerAccount,'/dashboard');\n if(screen.kind==='redirect')redirect(screen.location);\n if(screen.kind==='recovery')return <SessionRecovery target={screen.target} />;\n if(screen.kind==='unavailable')return <OwnerUnavailable />;\n return <ClientDashboard displayName={screen.account.displayName} />;\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/app/account/page.tsx": {
      "sha256": "84ec863c4ed4ff7ee52c7aaa6587e1a547b572242536b92335bf9687a4266468",
      "text": "import type {Metadata} from 'next';\nimport {OwnerPage} from '@/components/sections/owner/OwnerPage.server';\nexport const dynamic='force-dynamic';\nexport const metadata:Metadata={title:'حساب شخصی',robots:{index:false,follow:false}};\nexport default function AccountPage(){return <OwnerPage kind=\"account\" />;}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/components/blocks/PortfolioGallery.tsx": {
      "sha256": "3b86ed1bd6778680fa2d98b0f82e899d8dccd4a001d61bd5d0b7e84e55e483d3",
      "text": "\"use client\";\n/* eslint-disable @next/next/no-img-element -- Normalized WordPress public media has deployment-dependent hosts. */\nimport {useEffect,useRef,useState} from 'react';\nimport {useGSAP} from '@gsap/react';\nimport gsap from 'gsap';\nimport {createPortfolioDialogSession} from '@/lib/portfolio-dialog';\nimport {Button} from '@/components/ui/Button';\nimport type {PublicPortfolioImage} from '@/lib/contracts/specialists';\n\nexport function PortfolioGallery({items}:{items:PublicPortfolioImage[]}) {\n const [selected,setSelected]=useState<number|null>(null);\n const dialog=useRef<HTMLDialogElement>(null);\n const art=useRef<HTMLElement>(null);\n const session=useRef(createPortfolioDialogSession());\n useEffect(()=>{const current=session.current;return ()=>current.close();},[]);\n useEffect(()=>{\n  if(selected===null){session.current.close();return;}\n  const element=dialog.current;\n  const previous=document.activeElement;\n  if(element)session.current.show(element,previous instanceof HTMLElement?previous:null);\n },[selected]);\n useGSAP(()=>{\n  if(selected===null || window.matchMedia('(prefers-reduced-motion: reduce)').matches)return;\n  gsap.fromTo(art.current,{y:10,scale:0.98,autoAlpha:0.5},{y:0,scale:1,autoAlpha:1,duration:0.24,ease:'power2.out'});\n },{scope:dialog,dependencies:[selected]});\n const image=selected===null?null:items[selected];\n return <>\n  <div className=\"grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3\">{items.map((item,index)=><figure key={item.id} className=\"min-w-0 overflow-hidden rounded-3xl border border-line bg-card\"><button type=\"button\" aria-label={`مشاهده ${item.caption||'نمونه کار'}`} onClick={()=>setSelected(index)} className=\"block w-full transition-opacity duration-200 hover:opacity-85 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-accent active:opacity-70\"><img src={item.url} alt={item.caption||'نمونه کار منتشرشده'} loading=\"lazy\" decoding=\"async\" className=\"aspect-[4/3] w-full object-cover\" /></button>{item.caption&&<figcaption className=\"break-words p-3 text-sm leading-7 text-fg-soft\">{item.caption}</figcaption>}</figure>)}</div>\n  {image&&<dialog ref={dialog} aria-label=\"تصویر نمونه کار\" onClose={()=>setSelected(null)} onClick={event=>{if(event.target===event.currentTarget)setSelected(null);}} className=\"m-auto max-h-[90dvh] w-[min(92vw,56rem)] overflow-auto rounded-3xl border border-line bg-card p-4 text-fg backdrop:bg-black/75\">\n   <div className=\"mb-3 flex flex-wrap gap-2\"><Button autoFocus variant=\"secondary\" onClick={()=>setSelected(null)}>بستن گالری</Button>{items.length>1&&<><Button variant=\"outline\" onClick={()=>setSelected(current=>current===null?null:(current+items.length-1)%items.length)}>قبلی</Button><Button variant=\"outline\" onClick={()=>setSelected(current=>current===null?null:(current+1)%items.length)}>بعدی</Button></>}</div>\n   <figure ref={art}><img src={image.url} alt={image.caption||'نمونه کار منتشرشده'} className=\"max-h-[65dvh] w-full object-contain\" />{image.caption&&<figcaption className=\"mt-3 break-words text-sm leading-7\">{image.caption}</figcaption>}</figure>\n  </dialog>}\n </>;\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/components/blocks/InstallApp.tsx": {
      "sha256": "a63a6efd7c137b1fcb64393724c4d35b3a212bd68114f695b2b961bcb5cd7811",
      "text": "\"use client\";\n\nimport { useEffect, useRef, useState } from \"react\";\nimport { usePathname } from \"next/navigation\";\nimport { useGSAP } from \"@gsap/react\";\nimport gsap from \"gsap\";\nimport { Download, Share, SquarePlus, X, Zap, WifiOff, BellRing } from \"lucide-react\";\nimport { useInstallPrompt } from \"@/hooks/useInstallPrompt\";\nimport { BottomSheet } from \"@/components/ui/BottomSheet\";\nimport { cn } from \"@/lib/utils\";\n\n/* ============================================================\n   Install surfaces — powered by useInstallPrompt():\n   1. <InstallButton>  — persistent header utility icon\n   2. <InstallBanner>  — smart engagement-gated glass banner\n   Both open the native Chromium prompt, or the iOS fallback\n   sheet with Persian \"Share → Add to Home Screen\" steps.\n   ============================================================ */\n\nconst BENEFITS = [\n  { icon: Zap, text: \"باز شدن فوری، مثل اپ‌های بومی\" },\n  { icon: WifiOff, text: \"دسترسی سریع حتی با اینترنت ضعیف\" },\n  { icon: BellRing, text: \"همیشه یک لمس تا استادکارها فاصله داری\" },\n];\n\nfunction IosGuideSheet({ open, onClose }: { open: boolean; onClose: () => void }) {\n  return (\n    <BottomSheet open={open} onClose={onClose} title=\"نصب کاربان روی آیفون\">\n      <ol className=\"space-y-4 pb-2 text-sm text-fg-soft\">\n        <li className=\"flex items-center gap-3\">\n          <span className=\"flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-accent/12 text-accent\">\n            <Share className=\"h-5 w-5\" />\n          </span>\n          <span>\n            در نوار پایین سافاری روی دکمه <b className=\"text-fg\">اشتراک‌گذاری</b> بزن\n          </span>\n        </li>\n        <li className=\"flex items-center gap-3\">\n          <span className=\"flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-accent/12 text-accent\">\n            <SquarePlus className=\"h-5 w-5\" />\n          </span>\n          <span>\n            گزینه <b className=\"text-fg\">«Add to Home Screen»</b> را انتخاب کن\n          </span>\n        </li>\n        <li className=\"flex items-center gap-3\">\n          <span className=\"flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-primary text-primary-fg font-bold\">\n            ۳\n          </span>\n          <span>\n            روی <b className=\"text-fg\">افزودن</b> بزن — کاربان کنار بقیه اپ‌هایت نشسته!\n          </span>\n        </li>\n      </ol>\n    </BottomSheet>\n  );\n}\n\n/** Header utility icon — low-pressure, always discoverable. */\nexport function InstallButton({ className }: { className?: string }) {\n  const { canPrompt, isIosSafari, isInstalled, promptInstall } = useInstallPrompt();\n  const [iosOpen, setIosOpen] = useState(false);\n  const [seen, setSeen] = useState(false);\n  const btnRef = useRef<HTMLButtonElement>(null);\n  const { contextSafe } = useGSAP({ scope: btnRef });\n\n  const onClick = contextSafe(async () => {\n    setSeen(true);\n    gsap.fromTo(\n      btnRef.current,\n      { scale: 0.88 },\n      { scale: 1, duration: 0.55, ease: \"elastic.out(1.2, 0.45)\" },\n    );\n    if (canPrompt) await promptInstall();\n    else if (isIosSafari) setIosOpen(true);\n  });\n\n  if (isInstalled || (!canPrompt && !isIosSafari)) return null;\n\n  return (\n    <>\n      <button\n        ref={btnRef}\n        onClick={onClick}\n        aria-label=\"نصب اپلیکیشن کاربان\"\n        title=\"نصب اپلیکیشن\"\n        className={cn(\n          \"relative flex h-10 w-10 items-center justify-center rounded-2xl bg-accent/10 text-accent hover:bg-accent/20\",\n          className,\n        )}\n      >\n        <Download className=\"h-4.5 w-4.5\" />\n        {/* attention dot until first interaction */}\n        {!seen && (\n          <span className=\"absolute -top-0.5 -right-0.5 flex h-2.5 w-2.5\">\n            <span className=\"absolute inline-flex h-full w-full animate-ping rounded-full bg-primary opacity-70\" />\n            <span className=\"relative inline-flex h-2.5 w-2.5 rounded-full bg-primary\" />\n          </span>\n        )}\n      </button>\n      <IosGuideSheet open={iosOpen} onClose={() => setIosOpen(false)} />\n    </>\n  );\n}\n\n/** Smart banner — appears only after engagement (2nd route or 30s dwell),\n    remembers dismissal for 14 days. */\nexport function InstallBanner() {\n  const { canPrompt, isIosSafari, isInstalled, bannerDismissed, promptInstall, dismiss } =\n    useInstallPrompt();\n  const [engaged, setEngaged] = useState(false);\n  const [iosOpen, setIosOpen] = useState(false);\n  const pathname = usePathname();\n  const rootRef = useRef<HTMLDivElement>(null);\n  const views = useRef(0);\n  const { contextSafe } = useGSAP({ scope: rootRef });\n\n  // Engagement gate: 2nd page view OR 30s dwell — never on landing hit.\n  useEffect(() => {\n    views.current += 1;\n    if (views.current >= 2) setEngaged(true);\n  }, [pathname]);\n  useEffect(() => {\n    const t = setTimeout(() => setEngaged(true), 30_000);\n    return () => clearTimeout(t);\n  }, []);\n\n  const visible =\n    engaged && !isInstalled && !bannerDismissed && (canPrompt || isIosSafari);\n\n  useGSAP(\n    () => {\n      if (!rootRef.current) return;\n      if (visible) {\n        gsap.fromTo(\n          rootRef.current,\n          { yPercent: 130, opacity: 0 },\n          { yPercent: 0, opacity: 1, duration: 0.7, ease: \"back.out(1.4)\", delay: 0.4 },\n        );\n      }\n    },\n    { dependencies: [visible] },\n  );\n\n  const onInstall = contextSafe(async () => {\n    if (canPrompt) {\n      const accepted = await promptInstall();\n      if (!accepted) dismiss();\n    } else if (isIosSafari) {\n      setIosOpen(true);\n    }\n  });\n\n  const onDismiss = contextSafe(() => {\n    gsap.to(rootRef.current, {\n      yPercent: 130,\n      opacity: 0,\n      duration: 0.35,\n      ease: \"power3.in\",\n      onComplete: dismiss,\n    });\n  });\n\n  if (!visible) return <IosGuideSheet open={iosOpen} onClose={() => setIosOpen(false)} />;\n\n  return (\n    <>\n      <div\n        ref={rootRef}\n        role=\"complementary\"\n        aria-label=\"نصب اپلیکیشن\"\n        className=\"glass gpu fixed inset-x-3 z-[60] mx-auto max-w-md rounded-3xl p-4 shadow-[0_18px_50px_-12px_var(--shade-strong)] bottom-[calc(var(--bottom-nav-h)+1.25rem)] md:bottom-6\"\n      >\n        <button\n          onClick={onDismiss}\n          aria-label=\"بستن پیشنهاد نصب\"\n          className=\"absolute left-3 top-3 flex h-7 w-7 items-center justify-center rounded-lg text-muted hover:bg-wash hover:text-fg\"\n        >\n          <X className=\"h-4 w-4\" />\n        </button>\n        <p className=\"pl-8 text-[15px] font-bold text-fg\">\n          کاربان را روی گوشی‌ات داشته باش\n        </p>\n        <ul className=\"mt-2.5 space-y-1.5\">\n          {BENEFITS.map(({ icon: Icon, text }) => (\n            <li key={text} className=\"flex items-center gap-2 text-[13px] text-muted\">\n              <Icon className=\"h-3.5 w-3.5 shrink-0 text-accent\" />\n              {text}\n            </li>\n          ))}\n        </ul>\n        <div className=\"mt-3.5 flex items-center gap-2.5\">\n          <button\n            onClick={onInstall}\n            className=\"flex h-11 flex-1 items-center justify-center gap-2 rounded-2xl bg-primary font-medium text-primary-fg shadow-[0_8px_24px_-8px_var(--glow)] hover:bg-primary-hover active:scale-95\"\n          >\n            <Download className=\"h-4.5 w-4.5\" />\n            نصب رایگان\n          </button>\n          <button\n            onClick={onDismiss}\n            className=\"h-11 rounded-2xl px-4 text-sm text-muted hover:bg-wash\"\n          >\n            بعداً\n          </button>\n        </div>\n      </div>\n      <IosGuideSheet open={iosOpen} onClose={() => setIosOpen(false)} />\n    </>\n  );\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/components/blocks/ProjectWizard.tsx": {
      "sha256": "0b2f033f7ced20f258e7c665d4e9a9be2b796d0b12f93169beaf5322ab5da854",
      "text": "\"use client\";\n\nimport { useEffect, useRef, useState } from \"react\";\nimport { createPortal } from \"react-dom\";\nimport { useGSAP } from \"@gsap/react\";\nimport gsap from \"gsap\";\nimport {\n  Camera,\n  Check,\n  ChevronLeft,\n  ChevronRight,\n  MapPin,\n  PenLine,\n  Wallet,\n  X,\n} from \"lucide-react\";\nimport { Button } from \"@/components/ui/Button\";\nimport { Input } from \"@/components/ui/Input\";\nimport { CATEGORIES } from \"@/lib/data\";\nimport { cn, faNum, faPrice } from \"@/lib/utils\";\n\nconst STEPS = [\n  { id: 0, title: \"عنوان پروژه\", icon: PenLine },\n  { id: 1, title: \"موقعیت مکانی\", icon: MapPin },\n  { id: 2, title: \"بودجه\", icon: Wallet },\n  { id: 3, title: \"تصاویر\", icon: Camera },\n] as const;\n\nconst BUDGET_PRESETS = [5_000_000, 15_000_000, 30_000_000, 50_000_000, 100_000_000];\n\n/**\n * Post Project Wizard — full-screen modal; steps slide horizontally\n * with GSAP (no reloads), progress dots morph, and the final step\n * celebrates with a springy check.\n */\nexport function ProjectWizard({\n  open,\n  onClose,\n}: {\n  open: boolean;\n  onClose: () => void;\n}) {\n  const [step, setStep] = useState(0);\n  const [done, setDone] = useState(false);\n  const [budget, setBudget] = useState(BUDGET_PRESETS[1]);\n  const [pin, setPin] = useState({ x: 50, y: 45 });\n  const [canPortal, setCanPortal] = useState(false);\n  const rootRef = useRef<HTMLDivElement>(null);\n  const trackRef = useRef<HTMLDivElement>(null);\n  const { contextSafe } = useGSAP({ scope: rootRef });\n\n  useEffect(() => setCanPortal(true), []);\n\n  useGSAP(\n    () => {\n      const root = rootRef.current;\n      if (!root) return;\n      if (open) {\n        gsap.set(root, { display: \"flex\" });\n        gsap.fromTo(root, { opacity: 0 }, { opacity: 1, duration: 0.3 });\n        gsap.fromTo(\n          \".wizard-panel\",\n          { y: 60, scale: 0.95, autoAlpha: 0 },\n          { y: 0, scale: 1, autoAlpha: 1, duration: 0.6, ease: \"back.out(1.3)\" },\n        );\n      } else {\n        gsap.to(root, {\n          opacity: 0,\n          duration: 0.25,\n          onComplete: () => {\n            gsap.set(root, { display: \"none\" });\n            setStep(0);\n            setDone(false);\n          },\n        });\n      }\n    },\n    { dependencies: [open] },\n  );\n\n  /** slide the steps track; RTL layout → step N sits at x = +N*100% */\n  const goTo = contextSafe((next: number) => {\n    if (next < 0 || next >= STEPS.length) return;\n    setStep(next);\n    gsap.to(trackRef.current, {\n      xPercent: next * 100,\n      duration: 0.65,\n      ease: \"power4.inOut\",\n    });\n  });\n\n  const finish = contextSafe(() => {\n    setDone(true);\n    gsap.fromTo(\n      \".wizard-done\",\n      { scale: 0.4, autoAlpha: 0 },\n      { scale: 1, autoAlpha: 1, duration: 0.8, ease: \"elastic.out(1, 0.45)\", delay: 0.1 },\n    );\n  });\n\n  // Portal only after mount — SSR HTML must match first client render.\n  if (!canPortal) return null;\n\n  return createPortal(\n    <div\n      ref={rootRef}\n      className=\"fixed inset-0 z-[70] hidden items-end justify-center bg-(--backdrop) backdrop-blur-md sm:items-center\"\n      role=\"dialog\"\n      aria-modal=\"true\"\n      aria-label=\"ثبت پروژه جدید\"\n    >\n      <div className=\"wizard-panel relative flex max-h-[92dvh] w-full max-w-lg flex-col overflow-hidden rounded-t-4xl border border-line bg-card sm:rounded-4xl\">\n        {/* header */}\n        <div className=\"flex items-center justify-between px-5 pt-5\">\n          <h2 className=\"text-lg font-bold\">\n            {done ? \"ثبت شد!\" : \"ثبت پروژه جدید\"}\n          </h2>\n          <button\n            onClick={onClose}\n            aria-label=\"بستن\"\n            className=\"flex h-9 w-9 items-center justify-center rounded-xl bg-elev-2 text-muted hover:bg-elev-3 hover:text-fg\"\n          >\n            <X className=\"h-4.5 w-4.5\" />\n          </button>\n        </div>\n\n        {done ? (\n          <div className=\"wizard-done flex flex-col items-center px-6 py-14 text-center\">\n            <span className=\"mb-5 flex h-20 w-20 items-center justify-center rounded-full bg-success/15 text-success\">\n              <Check className=\"h-10 w-10\" strokeWidth={3} />\n            </span>\n            <h3 className=\"text-xl font-bold\">پروژه‌ات ثبت شد</h3>\n            <p className=\"mt-2.5 max-w-xs text-sm leading-relaxed text-muted\">\n              به‌زودی متخصصان واجد شرایط محله‌ات پیشنهادشان را برایت ارسال می‌کنند.\n            </p>\n            <Button className=\"mt-7 px-10\" onClick={onClose}>\n              عالیه!\n            </Button>\n          </div>\n        ) : (\n          <>\n            {/* progress */}\n            <div className=\"flex items-center justify-center gap-2 px-5 pt-5\">\n              {STEPS.map((s, i) => (\n                <div key={s.id} className=\"flex items-center gap-2\">\n                  <button\n                    onClick={() => i < step && goTo(i)}\n                    aria-label={s.title}\n                    aria-current={i === step ? \"step\" : undefined}\n                    className={cn(\n                      \"flex h-9 items-center gap-1.5 rounded-full px-3 text-xs font-medium transition-all duration-400\",\n                      i === step\n                        ? \"bg-primary text-primary-fg shadow-[0_6px_16px_-4px_var(--glow)]\"\n                        : i < step\n                          ? \"bg-success/15 text-emerald-700 dark:text-emerald-400\"\n                          : \"bg-elev-2 text-faint\",\n                    )}\n                  >\n                    {i < step ? <Check className=\"h-3.5 w-3.5\" /> : <s.icon className=\"h-3.5 w-3.5\" />}\n                    <span className={cn(i !== step && \"hidden sm:inline\")}>{s.title}</span>\n                  </button>\n                  {i < STEPS.length - 1 && (\n                    <span\n                      className={cn(\n                        \"h-0.5 w-4 rounded-full transition-colors duration-400\",\n                        i < step ? \"bg-success/50\" : \"bg-elev-3\",\n                      )}\n                    />\n                  )}\n                </div>\n              ))}\n            </div>\n\n            {/* sliding steps track */}\n            <div className=\"flex-1 overflow-hidden\">\n              <div ref={trackRef} className=\"flex h-full\">\n                {/* Step 1 — Title */}\n                <div className=\"w-full shrink-0 space-y-4 px-6 py-7\">\n                  <Input\n                    id=\"pw-title\"\n                    label=\"عنوان پروژه\"\n                    placeholder=\"مثلا: برق‌کشی واحد ۱۰۰ متری\"\n                    icon={<PenLine className=\"h-4 w-4\" />}\n                  />\n                  <div>\n                    <label className=\"mb-2 block text-sm font-medium text-fg-soft\">\n                      دسته‌بندی\n                    </label>\n                    <div className=\"flex flex-wrap gap-2\">\n                      {CATEGORIES.slice(0, 6).map((c, i) => (\n                        <button\n                          key={c.id}\n                          className={cn(\n                            \"rounded-full border px-3.5 py-1.5 text-[13px] transition-all\",\n                            i === 0\n                              ? \"border-primary/60 bg-primary/12 text-primary\"\n                              : \"border-line bg-elev text-muted hover:border-primary/40\",\n                          )}\n                        >\n                          {c.title}\n                        </button>\n                      ))}\n                    </div>\n                  </div>\n                  <textarea\n                    rows={3}\n                    placeholder=\"توضیحات بیشتر پروژه (اختیاری)...\"\n                    className=\"w-full rounded-2xl border border-line bg-elev p-4 text-[15px] text-fg placeholder:text-faint focus:border-primary/70 focus:outline-none\"\n                  />\n                </div>\n\n                {/* Step 2 — Location pinning */}\n                <div className=\"w-full shrink-0 px-6 py-7\">\n                  <p className=\"mb-3 text-sm text-muted\">\n                    روی نقشه ضربه بزن تا محل پروژه مشخص شود\n                  </p>\n                  <div\n                    className=\"relative h-56 cursor-crosshair overflow-hidden rounded-3xl border border-line\"\n                    style={{\n                      background:\n                        \"radial-gradient(80% 80% at 30% 20%, #0d2436, #050b10)\",\n                    }}\n                    onClick={(e) => {\n                      const r = e.currentTarget.getBoundingClientRect();\n                      setPin({\n                        x: ((e.clientX - r.left) / r.width) * 100,\n                        y: ((e.clientY - r.top) / r.height) * 100,\n                      });\n                    }}\n                  >\n                    {/* fake streets */}\n                    <div\n                      aria-hidden\n                      className=\"absolute inset-0 opacity-15\"\n                      style={{\n                        backgroundImage:\n                          \"linear-gradient(0deg, #2a5570 1.5px, transparent 1.5px), linear-gradient(90deg, #2a5570 1.5px, transparent 1.5px), linear-gradient(45deg, transparent 48%, #2a5570 49%, #2a5570 51%, transparent 52%)\",\n                        backgroundSize: \"56px 56px, 72px 72px, 120px 120px\",\n                      }}\n                    />\n                    {/* pin */}\n                    <span\n                      className=\"absolute z-10 -translate-x-1/2 -translate-y-full transition-all duration-300 ease-out\"\n                      style={{ left: `${pin.x}%`, top: `${pin.y}%` }}\n                    >\n                      <MapPin className=\"h-9 w-9 fill-primary/25 text-primary drop-shadow-[0_4px_8px_var(--glow)]\" />\n                      <span className=\"absolute -bottom-0.5 left-1/2 h-1.5 w-4 -translate-x-1/2 rounded-[100%] bg-ink-950/60 blur-[2px]\" />\n                    </span>\n                    <span className=\"absolute bottom-3 right-3 rounded-xl bg-(--backdrop) px-3 py-1.5 text-xs text-fg-soft backdrop-blur\">\n                      تهران، سعادت‌آباد\n                    </span>\n                  </div>\n                </div>\n\n                {/* Step 3 — Budget */}\n                <div className=\"w-full shrink-0 px-6 py-7\">\n                  <p className=\"mb-5 text-sm text-muted\">بودجه حدودی پروژه‌ات چقدر است؟</p>\n                  <div className=\"mb-6 text-center\">\n                    <span className=\"text-3xl font-bold text-gold\">{faPrice(budget)}</span>\n                    <span className=\"mr-2 text-sm text-muted\">تومان</span>\n                  </div>\n                  <div className=\"grid grid-cols-2 gap-2.5 sm:grid-cols-3\">\n                    {BUDGET_PRESETS.map((b) => (\n                      <button\n                        key={b}\n                        onClick={() => setBudget(b)}\n                        className={cn(\n                          \"rounded-2xl border px-3 py-3 text-sm transition-all\",\n                          budget === b\n                            ? \"border-primary/60 bg-primary/12 font-bold text-primary\"\n                            : \"border-line bg-elev text-muted hover:border-primary/30\",\n                        )}\n                      >\n                        {faPrice(b)}\n                      </button>\n                    ))}\n                    <button className=\"rounded-2xl border border-dashed border-line px-3 py-3 text-sm text-faint hover:border-primary/40 hover:text-primary\">\n                      مبلغ دلخواه\n                    </button>\n                  </div>\n                </div>\n\n                {/* Step 4 — Photos */}\n                <div className=\"w-full shrink-0 px-6 py-7\">\n                  <p className=\"mb-4 text-sm text-muted\">\n                    عکس از محل کار به متخصص کمک می‌کند قیمت دقیق‌تری بدهد\n                  </p>\n                  <div className=\"grid grid-cols-3 gap-2.5\">\n                    <button className=\"flex aspect-square flex-col items-center justify-center gap-2 rounded-2xl border-2 border-dashed border-primary/40 bg-primary/5 text-primary hover:bg-primary/10\">\n                      <Camera className=\"h-6 w-6\" />\n                      <span className=\"text-xs\">افزودن عکس</span>\n                    </button>\n                    {[38, 220].map((h) => (\n                      <div\n                        key={h}\n                        className=\"aspect-square rounded-2xl border border-line\"\n                        style={{\n                          background: `linear-gradient(140deg, hsl(${h} 35% 26%), hsl(${h + 40} 40% 15%))`,\n                        }}\n                      />\n                    ))}\n                  </div>\n                  <p className=\"mt-4 text-xs text-faint\">\n                    حداکثر {faNum(6)} تصویر — فرمت JPG یا PNG\n                  </p>\n                </div>\n              </div>\n            </div>\n\n            {/* footer nav */}\n            <div className=\"flex gap-2.5 border-t border-line px-5 py-4 pb-[max(1rem,env(safe-area-inset-bottom))]\">\n              {step > 0 && (\n                <Button variant=\"secondary\" onClick={() => goTo(step - 1)} className=\"gap-1 px-5\">\n                  <ChevronRight className=\"h-4 w-4\" />\n                  قبلی\n                </Button>\n              )}\n              <Button\n                className=\"flex-1 gap-1\"\n                onClick={() => (step === STEPS.length - 1 ? finish() : goTo(step + 1))}\n              >\n                {step === STEPS.length - 1 ? \"ثبت نهایی پروژه\" : \"مرحله بعد\"}\n                {step < STEPS.length - 1 && <ChevronLeft className=\"h-4 w-4\" />}\n              </Button>\n            </div>\n          </>\n        )}\n      </div>\n    </div>,\n    document.body,\n  );\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/components/ui/BottomSheet.tsx": {
      "sha256": "eba012634b2b095a7f01f875e90e04ac5581b46915bf694b785abfd7d3eeb556",
      "text": "\"use client\";\n\nimport { useEffect, useRef, useState, type ReactNode } from \"react\";\nimport { createPortal } from \"react-dom\";\nimport { X } from \"lucide-react\";\nimport { useGSAP } from \"@gsap/react\";\nimport gsap from \"gsap\";\nimport { cn } from \"@/lib/utils\";\n\n/**\n * GSAP-powered bottom sheet:\n * backdrop fades in with blur, panel slides up with a slight bounce\n * (back.out overshoot), closes with a quick power slide-down.\n */\nexport function BottomSheet({\n  open,\n  onClose,\n  title,\n  children,\n  className,\n}: {\n  open: boolean;\n  onClose: () => void;\n  title?: string;\n  children: ReactNode;\n  className?: string;\n}) {\n  const rootRef = useRef<HTMLDivElement>(null);\n  const backdropRef = useRef<HTMLDivElement>(null);\n  const panelRef = useRef<HTMLDivElement>(null);\n  const mounted = useRef(false);\n  const [canPortal, setCanPortal] = useState(false);\n\n  useEffect(() => {\n    mounted.current = true;\n    setCanPortal(true);\n  }, []);\n\n  useGSAP(\n    () => {\n      const root = rootRef.current;\n      const backdrop = backdropRef.current;\n      const panel = panelRef.current;\n      if (!root || !backdrop || !panel) return;\n\n      if (open) {\n        gsap.set(root, { display: \"block\" });\n        gsap.fromTo(\n          backdrop,\n          { opacity: 0 },\n          { opacity: 1, duration: 0.35, ease: \"power2.out\" },\n        );\n        gsap.fromTo(\n          panel,\n          { yPercent: 110 },\n          { yPercent: 0, duration: 0.6, ease: \"back.out(1.15)\" },\n        );\n      } else if (mounted.current) {\n        gsap.to(backdrop, { opacity: 0, duration: 0.28, ease: \"power2.in\" });\n        gsap.to(panel, {\n          yPercent: 110,\n          duration: 0.38,\n          ease: \"power3.in\",\n          onComplete: () => gsap.set(root, { display: \"none\" }),\n        });\n      } else {\n        gsap.set(root, { display: \"none\" });\n      }\n    },\n    { dependencies: [open] },\n  );\n\n  // Escape to close\n  useEffect(() => {\n    if (!open) return;\n    const onKey = (e: KeyboardEvent) => e.key === \"Escape\" && onClose();\n    window.addEventListener(\"keydown\", onKey);\n    return () => window.removeEventListener(\"keydown\", onKey);\n  }, [open, onClose]);\n\n  // Portal only after mount — SSR HTML must match first client render.\n  if (!canPortal) return null;\n\n  return createPortal(\n    <div ref={rootRef} className=\"fixed inset-0 z-[70] hidden\" role=\"dialog\" aria-modal=\"true\">\n      <div\n        ref={backdropRef}\n        onClick={onClose}\n        className=\"absolute inset-0 bg-(--backdrop) backdrop-blur-sm\"\n      />\n      <div\n        ref={panelRef}\n        className={cn(\n          \"gpu absolute inset-x-0 bottom-0 mx-auto max-w-lg rounded-t-4xl border border-b-0 border-line bg-card px-5 pb-[max(1.25rem,env(safe-area-inset-bottom))] pt-3 shadow-[0_-24px_60px_-16px_var(--shade-strong)]\",\n          className,\n        )}\n      >\n        {/* grabber */}\n        <div className=\"mx-auto mb-4 h-1.5 w-12 rounded-full bg-elev-3\" />\n        <div className=\"mb-4 flex items-center justify-between\">\n          {title && <h3 className=\"text-lg font-bold text-fg\">{title}</h3>}\n          <button\n            onClick={onClose}\n            aria-label=\"بستن\"\n            className=\"flex h-9 w-9 items-center justify-center rounded-xl bg-elev-2 text-muted hover:bg-elev-3 hover:text-fg\"\n          >\n            <X className=\"h-4.5 w-4.5\" />\n          </button>\n        </div>\n        {children}\n      </div>\n    </div>,\n    document.body,\n  );\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/components/ui/Tabs.tsx": {
      "sha256": "695fd7b5e23320c7fd4854855379c32e5ddd340fd568086b0b73ce524598d3f5",
      "text": "\"use client\";\n\nimport { useRef } from \"react\";\nimport { useGSAP } from \"@gsap/react\";\nimport gsap from \"gsap\";\nimport { cn } from \"@/lib/utils\";\n\nexport interface Tab {\n  id: string;\n  label: string;\n}\n\n/**\n * Animated tabs — a golden underline glides between tabs and the\n * incoming panel slides in from the tab direction with a fade.\n */\nexport function Tabs({\n  tabs,\n  active,\n  onChange,\n  className,\n}: {\n  tabs: Tab[];\n  active: string;\n  onChange: (id: string) => void;\n  className?: string;\n}) {\n  const listRef = useRef<HTMLDivElement>(null);\n  const underlineRef = useRef<HTMLSpanElement>(null);\n  const { contextSafe } = useGSAP({ scope: listRef });\n\n  const moveUnderline = contextSafe((target: HTMLElement) => {\n    const list = listRef.current;\n    const underline = underlineRef.current;\n    if (!list || !underline) return;\n    const listRect = list.getBoundingClientRect();\n    const rect = target.getBoundingClientRect();\n    gsap.to(underline, {\n      width: rect.width * 0.6,\n      left: rect.left - listRect.left + rect.width * 0.2,\n      duration: 0.5,\n      ease: \"elastic.out(1, 0.7)\",\n    });\n  });\n\n  useGSAP(\n    () => {\n      const list = listRef.current;\n      if (!list) return;\n      const activeEl = list.querySelector<HTMLElement>(`[data-tab=\"${active}\"]`);\n      if (activeEl) {\n        const listRect = list.getBoundingClientRect();\n        const rect = activeEl.getBoundingClientRect();\n        gsap.set(underlineRef.current, {\n          width: rect.width * 0.6,\n          left: rect.left - listRect.left + rect.width * 0.2,\n        });\n      }\n    },\n    { scope: listRef },\n  );\n\n  return (\n    <div\n      ref={listRef}\n      role=\"tablist\"\n      className={cn(\n        \"relative flex items-center gap-1 border-b border-line\",\n        className,\n      )}\n    >\n      {tabs.map((tab) => (\n        <button\n          key={tab.id}\n          role=\"tab\"\n          data-tab={tab.id}\n          aria-selected={active === tab.id}\n          onClick={(e) => {\n            onChange(tab.id);\n            moveUnderline(e.currentTarget);\n          }}\n          className={cn(\n            \"relative px-4 py-3 text-sm font-medium transition-colors duration-300\",\n            active === tab.id ? \"text-primary\" : \"text-muted hover:text-fg\",\n          )}\n        >\n          {tab.label}\n        </button>\n      ))}\n      <span\n        ref={underlineRef}\n        aria-hidden\n        className=\"absolute bottom-0 h-0.5 rounded-full bg-primary shadow-[0_0_10px_1px_var(--glow)]\"\n      />\n    </div>\n  );\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/components/ui/Avatar.tsx": {
      "sha256": "fb01ebb3ee9909ace8e4113903c355b3aa7d273d9e509c5ec6860b74d795df28",
      "text": "import { cn } from \"@/lib/utils\";\n\nconst BRAND_GRADIENTS = [\n  \"linear-gradient(135deg, #0072b6, #064e7a)\",\n  \"linear-gradient(135deg, #f2cb1f, #a9880c)\",\n  \"linear-gradient(135deg, #2e95e6, #0b4265)\",\n  \"linear-gradient(135deg, #d4ae0b, #775c14)\",\n  \"linear-gradient(135deg, #005c94, #050b10)\",\n  \"linear-gradient(135deg, #f7db44, #8c6f11)\",\n];\n\n/** Public avatars use the safe normalized URL when available, with initials as fallback. */\nexport function Avatar({\n  name,\n  src,\n  hue = 45,\n  className,\n}: {\n  name: string;\n  src?: string | null;\n  hue?: number;\n  className?: string;\n}) {\n  const initials = name\n    .split(\" \")\n    .filter(Boolean)\n    .slice(0, 2)\n    .map((part) => part[0])\n    .join(\"‌\");\n  const index = Math.abs(hue) % BRAND_GRADIENTS.length;\n  const onYellow = index % 2 === 1;\n\n  return (\n    <div\n      className={cn(\n        \"relative flex h-14 w-14 shrink-0 items-center justify-center overflow-hidden rounded-2xl text-lg font-bold\",\n        onYellow ? \"text-black/85\" : \"text-white/90\",\n        className,\n      )}\n      style={{ background: BRAND_GRADIENTS[index] }}\n    >\n      {src ? (\n        <img src={src} alt=\"\" className=\"absolute inset-0 h-full w-full object-cover\" />\n      ) : (\n        <span aria-hidden>{initials}</span>\n      )}\n      <span className=\"sr-only\">{name}</span>\n      <span className=\"pointer-events-none absolute inset-0 bg-gradient-to-b from-white/15 to-transparent\" />\n    </div>\n  );\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/components/ui/ThemeToggle.tsx": {
      "sha256": "5333d445fa8d910452b76f817c0b36fa0bcc473a65bbc3ea1d537fbe738e16e4",
      "text": "\"use client\";\n\nimport { useEffect, useRef, useState } from \"react\";\nimport { useTheme } from \"next-themes\";\nimport { useGSAP } from \"@gsap/react\";\nimport gsap from \"gsap\";\nimport { cn } from \"@/lib/utils\";\n\n/**\n * ThemeToggle — GSAP sun↔moon morph:\n * on click the icon spins a full 360°, squashes to 0, swaps shape at the\n * midpoint, then elastic-pops back while the sun rays fan out (or the\n * moon crater fades in). Renders a neutral placeholder until mounted to\n * avoid any hydration mismatch.\n */\nexport function ThemeToggle({ className }: { className?: string }) {\n  const { resolvedTheme, setTheme } = useTheme();\n  const [mounted, setMounted] = useState(false);\n  const btnRef = useRef<HTMLButtonElement>(null);\n  const iconRef = useRef<SVGSVGElement>(null);\n  const { contextSafe } = useGSAP({ scope: btnRef });\n\n  useEffect(() => setMounted(true), []);\n\n  const isDark = resolvedTheme === \"dark\";\n\n  const toggle = contextSafe(() => {\n    const next = isDark ? \"light\" : \"dark\";\n    const icon = iconRef.current;\n\n    gsap\n      .timeline()\n      // wind up: spin + shrink\n      .to(icon, {\n        rotate: 180,\n        scale: 0,\n        duration: 0.28,\n        ease: \"power3.in\",\n        // swap the theme (and therefore the icon shape) at the midpoint\n        onComplete: () => setTheme(next),\n      })\n      // release: finish the 360° with an elastic pop\n      .to(icon, {\n        rotate: 360,\n        scale: 1,\n        duration: 0.75,\n        ease: \"elastic.out(1.1, 0.5)\",\n      })\n      .set(icon, { rotate: 0 });\n\n    // button itself gives a satisfying squash\n    gsap\n      .timeline()\n      .to(btnRef.current, { scale: 0.88, duration: 0.12, ease: \"power2.out\" })\n      .to(btnRef.current, { scale: 1, duration: 0.6, ease: \"elastic.out(1.2, 0.4)\" });\n  });\n\n  return (\n    <button\n      ref={btnRef}\n      onClick={mounted ? toggle : undefined}\n      aria-label={mounted && isDark ? \"حالت روشن\" : \"حالت تاریک\"}\n      title={mounted && isDark ? \"حالت روشن\" : \"حالت تاریک\"}\n      className={cn(\n        \"relative flex h-10 w-10 items-center justify-center rounded-2xl bg-wash text-primary hover:bg-wash-2\",\n        className,\n      )}\n    >\n      <svg\n        ref={iconRef}\n        viewBox=\"0 0 24 24\"\n        fill=\"none\"\n        stroke=\"currentColor\"\n        strokeWidth=\"2\"\n        strokeLinecap=\"round\"\n        strokeLinejoin=\"round\"\n        className=\"gpu h-5 w-5 will-change-transform\"\n        aria-hidden\n      >\n        {/* Neutral circle until mounted (identical SSR/client markup) */}\n        {!mounted ? (\n          <circle cx=\"12\" cy=\"12\" r=\"5\" />\n        ) : isDark ? (\n          /* moon — crescent */\n          <path d=\"M12 3a6.364 6.364 0 0 0 9 9 9 9 0 1 1-9-9Z\" fill=\"currentColor\" fillOpacity=\"0.15\" />\n        ) : (\n          /* sun — disc + rays */\n          <>\n            <circle cx=\"12\" cy=\"12\" r=\"4\" fill=\"currentColor\" fillOpacity=\"0.15\" />\n            <path d=\"M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41\" />\n          </>\n        )}\n      </svg>\n    </button>\n  );\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/components/ui/Badge.tsx": {
      "sha256": "115e40e765da2d144a80ee94ddebd3e6d3cbb898de5971aebfcd5c2f7d019ce4",
      "text": "import { type ReactNode } from \"react\";\nimport { BadgeCheck } from \"lucide-react\";\nimport { cn } from \"@/lib/utils\";\nimport type { ProjectStatus } from \"@/lib/data\";\n\ntype Tone = \"brand\" | \"success\" | \"alert\" | \"warn\" | \"neutral\" | \"info\";\n\nconst tones: Record<Tone, string> = {\n  brand: \"bg-primary/15 text-primary border-primary/25\",\n  success:\n    \"bg-success/15 text-emerald-700 dark:text-emerald-400 border-success/25\",\n  alert: \"bg-alert/15 text-red-700 dark:text-red-400 border-alert/25\",\n  warn: \"bg-warn/15 text-amber-700 dark:text-amber-400 border-warn/25\",\n  neutral: \"bg-wash text-fg-soft border-line\",\n  info: \"bg-azure-500/15 text-azure-700 dark:text-azure-400 border-azure-500/25\",\n};\n\nexport function Badge({\n  tone = \"neutral\",\n  className,\n  children,\n}: {\n  tone?: Tone;\n  className?: string;\n  children: ReactNode;\n}) {\n  return (\n    <span\n      className={cn(\n        \"inline-flex items-center gap-1 rounded-full border px-2.5 py-0.5 text-xs font-medium\",\n        tones[tone],\n        className,\n      )}\n    >\n      {children}\n    </span>\n  );\n}\n\nconst statusTone: Record<ProjectStatus, Tone> = {\n  \"در انتظار\": \"warn\",\n  \"در حال انجام\": \"info\",\n  \"تکمیل شده\": \"success\",\n  \"لغو شده\": \"alert\",\n};\n\nexport function StatusBadge({ status }: { status: ProjectStatus }) {\n  return <Badge tone={statusTone[status]}>{status}</Badge>;\n}\n\n/** Brand-blue verified checkmark — the trust anchor of Karban. */\nexport function VerifiedBadge({ className }: { className?: string }) {\n  return (\n    <span\n      className={cn(\n        \"inline-flex items-center gap-1 text-accent\",\n        className,\n      )}\n      title=\"هویت تایید شده\"\n    >\n      <BadgeCheck className=\"h-4.5 w-4.5 fill-accent/20\" />\n      <span className=\"sr-only\">هویت تایید شده</span>\n    </span>\n  );\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/components/ui/Rating.tsx": {
      "sha256": "b659b0f4b27817470c344a330968b24b7ea90172ee1ecd80041d26a94d7d9e4a",
      "text": "import { Star } from \"lucide-react\";\nimport { cn, faNum } from \"@/lib/utils\";\n\nexport function Rating({\n  value,\n  count,\n  className,\n}: {\n  value: number | null;\n  count?: number;\n  className?: string;\n}) {\n  if (value === null || count === undefined || count <= 0) return null;\n\n  return (\n    <span className={cn(\"inline-flex items-center gap-1\", className)}>\n      <Star className=\"h-4 w-4 fill-primary text-primary\" />\n      <span className=\"text-sm font-medium text-fg\">{faNum(value.toFixed(1))}</span>\n      <span className=\"text-xs text-muted\">({faNum(count)} نظر)</span>\n    </span>\n  );\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/components/ui/Button.tsx": {
      "sha256": "9895dc28922f91589a2e2573f5835867c537583b05fe73f884f555f253964b94",
      "text": "\"use client\";\n\nimport { forwardRef, useRef, type ButtonHTMLAttributes } from \"react\";\nimport { useGSAP } from \"@gsap/react\";\nimport gsap from \"gsap\";\nimport {tapFeedback} from '@/lib/tap-feedback';\nimport { cn } from \"@/lib/utils\";\n\ntype Variant = \"primary\" | \"secondary\" | \"accent\" | \"ghost\" | \"outline\" | \"danger\";\ntype Size = \"sm\" | \"md\" | \"lg\" | \"icon\";\n\nexport interface ButtonProps extends ButtonHTMLAttributes<HTMLButtonElement> {\n  variant?: Variant;\n  size?: Size;\n}\n\nconst variants: Record<Variant, string> = {\n  primary:\n    \"bg-primary text-primary-fg font-medium hover:bg-primary-hover shadow-[0_8px_24px_-8px_var(--glow)] hover:shadow-[0_12px_32px_-8px_var(--glow)]\",\n  secondary:\n    \"bg-elev-2 text-fg hover:bg-elev-3 border border-line\",\n  /* Brand blue — secondary CTAs, informational actions */\n  accent:\n    \"bg-accent text-accent-fg font-medium hover:bg-accent-strong\",\n  ghost: \"bg-transparent text-fg-soft hover:bg-wash\",\n  /* Blue outline — yellow text on white fails contrast, blue passes AA */\n  outline:\n    \"bg-transparent border border-accent/60 text-accent hover:bg-accent/10\",\n  danger: \"bg-alert/90 text-white hover:bg-alert\",\n};\n\nconst sizes: Record<Size, string> = {\n  sm: \"h-9 px-4 text-sm rounded-xl gap-1.5\",\n  md: \"h-11 px-5 text-[15px] rounded-2xl gap-2\",\n  lg: \"h-13 px-7 text-base rounded-2xl gap-2.5\",\n  icon: \"h-11 w-11 rounded-2xl\",\n};\n\n/**\n * Button with a satisfying GSAP tap spring:\n * press → scale 0.95, release → springs back with elastic overshoot.\n */\nexport const Button = forwardRef<HTMLButtonElement, ButtonProps>(\n  function Button({ className, variant = \"primary\", size = \"md\", ...props }, ref) {\n    const innerRef = useRef<HTMLButtonElement>(null);\n    const { contextSafe } = useGSAP({ scope: innerRef });\n\n    const press = contextSafe(() => {\n      gsap.to(innerRef.current, tapFeedback(window.matchMedia('(prefers-reduced-motion: reduce)').matches,true));\n    });\n    const release = contextSafe(() => {\n      gsap.to(innerRef.current, tapFeedback(window.matchMedia('(prefers-reduced-motion: reduce)').matches,false));\n    });\n\n    return (\n      <button\n        ref={(node) => {\n          innerRef.current = node;\n          if (typeof ref === \"function\") ref(node);\n          else if (ref) ref.current = node;\n        }}\n        onPointerDown={press}\n        onPointerUp={release}\n        onPointerLeave={release}\n        className={cn(\n          \"inline-flex select-none items-center justify-center whitespace-nowrap will-change-transform\",\n          \"disabled:pointer-events-none disabled:opacity-45\",\n          variants[variant],\n          sizes[size],\n          className,\n        )}\n        {...props}\n      />\n    );\n  },\n);\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/components/ui/Input.tsx": {
      "sha256": "3f451c464a8da50a7f90e34fab0df39d290ce2bf2c1044305597f0a24274d7e6",
      "text": "\"use client\";\n\nimport { forwardRef, type InputHTMLAttributes, type ReactNode } from \"react\";\nimport { cn } from \"@/lib/utils\";\n\nexport interface InputProps extends InputHTMLAttributes<HTMLInputElement> {\n  label?: string;\n  icon?: ReactNode;\n  error?: string;\n}\n\nexport const Input = forwardRef<HTMLInputElement, InputProps>(function Input(\n  { className, label, icon, error, id, ...props },\n  ref,\n) {\n  return (\n    <div className=\"w-full\">\n      {label && (\n        <label\n          htmlFor={id}\n          className=\"mb-2 block text-sm font-medium text-fg-soft\"\n        >\n          {label}\n        </label>\n      )}\n      <div className=\"group relative\">\n        {icon && (\n          <span className=\"pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-muted transition-colors group-focus-within:text-accent\">\n            {icon}\n          </span>\n        )}\n        <input\n          ref={ref}\n          id={id}\n          className={cn(\n            \"h-12 w-full rounded-2xl border border-line bg-elev px-4 text-[15px] text-fg\",\n            \"placeholder:text-faint transition-all duration-300\",\n            \"focus:border-accent/70 focus:bg-elev-2 focus:shadow-[0_0_0_4px_var(--accent-glow)] focus:outline-none\",\n            icon && \"pr-11\",\n            error && \"border-alert/70\",\n            className,\n          )}\n          {...props}\n        />\n      </div>\n      {error && <p className=\"mt-1.5 text-xs text-alert\">{error}</p>}\n    </div>\n  );\n});\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/components/ui/Skeleton.tsx": {
      "sha256": "651d4875cd4970241cd3d181176a9ee39b6f74a0a3591154a545ae104bf2f3cd",
      "text": "import { cn } from \"@/lib/utils\";\n\nexport function Skeleton({ className }: { className?: string }) {\n  return <div className={cn(\"skeleton rounded-xl\", className)} aria-hidden />;\n}\n\n/** Full specialist-card shaped skeleton for initial loading states. */\nexport function SpecialistCardSkeleton() {\n  return (\n    <div className=\"rounded-3xl border border-line bg-card p-4\">\n      <div className=\"flex items-start gap-3.5\">\n        <Skeleton className=\"h-16 w-16 shrink-0 rounded-2xl\" />\n        <div className=\"flex-1 space-y-2.5 pt-1\">\n          <Skeleton className=\"h-4 w-2/5\" />\n          <Skeleton className=\"h-3 w-3/5\" />\n          <Skeleton className=\"h-3 w-1/3\" />\n        </div>\n      </div>\n      <div className=\"mt-4 flex gap-2.5\">\n        <Skeleton className=\"h-10 flex-1 rounded-2xl\" />\n        <Skeleton className=\"h-10 w-24 rounded-2xl\" />\n      </div>\n    </div>\n  );\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/components/sections/Hero.tsx": {
      "sha256": "c602fe01968659e909fe80fb4446fe3c8ced22daca2a290ca8397d306bd97bb3",
      "text": "\"use client\";\n\nimport { useRef, useState } from \"react\";\nimport { useRouter } from \"next/navigation\";\nimport { useGSAP } from \"@gsap/react\";\nimport gsap from \"gsap\";\nimport { MapPin, Search } from \"lucide-react\";\nimport { Button } from \"@/components/ui/Button\";\nimport type { PublicTerm } from \"@/lib/contracts/specialists\";\n\nexport function Hero({ cities }: { cities: PublicTerm[] }) {\n  const ref = useRef<HTMLDivElement>(null);\n  const router = useRouter();\n  const [query, setQuery] = useState(\"\");\n  const [city, setCity] = useState(\"\");\n\n  useGSAP(\n    () => {\n      const splashPending = !sessionStorage.getItem(\"karban-splash-done\");\n      const timeline = gsap.timeline({ defaults: { ease: \"power3.out\" }, delay: splashPending ? 2.2 : 0.15 });\n      timeline\n        .fromTo(\".hero-line\", { y: 60, autoAlpha: 0 }, { y: 0, autoAlpha: 1, duration: 0.9, stagger: 0.12 })\n        .fromTo(\".hero-search\", { y: 44, autoAlpha: 0, scale: 0.94 }, { y: 0, autoAlpha: 1, scale: 1, duration: 0.8, ease: \"back.out(1.4)\" }, \"-=0.45\");\n      gsap.to(\".hero-orb\", { y: -34, x: 22, scale: 1.12, duration: 6, yoyo: true, repeat: -1, ease: \"sine.inOut\" });\n    },\n    { scope: ref },\n  );\n\n  function submit(event: React.FormEvent<HTMLFormElement>) {\n    event.preventDefault();\n    const params = new URLSearchParams();\n    if (query.trim()) params.set(\"q\", query.trim());\n    if (city) params.set(\"city\", city);\n    router.push(`/search${params.size ? `?${params}` : \"\"}`);\n  }\n\n  return (\n    <section ref={ref} className=\"relative overflow-hidden px-4 pb-14 pt-10 sm:px-6 sm:pt-16\">\n      <div className=\"hero-orb pointer-events-none absolute -top-24 left-1/2 h-96 w-96 -translate-x-1/2 rounded-full bg-primary/12 blur-[110px]\" />\n      <div className=\"pointer-events-none absolute -bottom-32 -right-24 h-72 w-72 rounded-full bg-azure-600/10 blur-[90px]\" />\n      <div className=\"relative mx-auto max-w-3xl text-center\">\n        <p className=\"hero-line mb-5 text-sm font-medium text-accent opacity-0\">فهرست عمومی متخصصان ساختمان</p>\n        <h1 className=\"text-[clamp(1.9rem,6vw,3.4rem)] font-bold leading-[1.35]\">\n          <span className=\"hero-line block opacity-0\">متخصص مورد نیازت را</span>\n          <span className=\"hero-line block opacity-0\">با دسته‌بندی و شهر پیدا کن</span>\n        </h1>\n        <p className=\"hero-line mx-auto mt-5 max-w-md text-[clamp(0.9rem,2.5vw,1.05rem)] leading-relaxed text-muted opacity-0\">\n          اطلاعات منتشرشدهٔ متخصصان را جستجو کن و پروفایل عمومی هرکدام را ببین.\n        </p>\n        <form onSubmit={submit} className=\"hero-search glass mx-auto mt-9 flex max-w-xl flex-col gap-2.5 rounded-3xl p-3 opacity-0 sm:flex-row sm:items-center\">\n          <div className=\"relative flex-1\">\n            <Search className=\"pointer-events-none absolute right-3.5 top-1/2 h-4.5 w-4.5 -translate-y-1/2 text-primary\" />\n            <input value={query} onChange={(event) => setQuery(event.target.value)} placeholder=\"جستجوی نام یا تخصص\" aria-label=\"جستجو در متخصصان\" className=\"h-12 w-full rounded-2xl bg-elev pr-11 pl-4 text-[15px] text-fg placeholder:text-faint focus:bg-elev-2 focus:outline-none focus:ring-2 focus:ring-primary/50\" />\n          </div>\n          <div className=\"relative flex-1 sm:max-w-44\">\n            <MapPin className=\"pointer-events-none absolute right-3.5 top-1/2 h-4.5 w-4.5 -translate-y-1/2 text-primary\" />\n            <select value={city} onChange={(event) => setCity(event.target.value)} aria-label=\"شهر\" className=\"h-12 w-full appearance-none rounded-2xl bg-elev pr-11 pl-4 text-[15px] text-fg focus:bg-elev-2 focus:outline-none focus:ring-2 focus:ring-primary/50\">\n              <option value=\"\">همهٔ شهرها</option>\n              {cities.map((term) => <option key={term.id} value={term.slug}>{term.name}</option>)}\n            </select>\n          </div>\n          <Button type=\"submit\" size=\"lg\" className=\"h-12 shrink-0 sm:px-8\">جستجو</Button>\n        </form>\n      </div>\n    </section>\n  );\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/components/sections/CategoryGrid.tsx": {
      "sha256": "2c60be86c5bad103b4f76f66f332b636ba089b059af9379f80c7888bcf754de0",
      "text": "\"use client\";\n\nimport Link from \"next/link\";\nimport {\n  Flame,\n  Grid3x3,\n  Hammer,\n  House,\n  Layers,\n  Mountain,\n  Paintbrush,\n  Thermometer,\n  Trees,\n  Umbrella,\n  Wrench,\n  Zap,\n  type LucideIcon,\n} from \"lucide-react\";\nimport { TapCard } from \"@/components/motion/TapCard\";\nimport { Reveal } from \"@/components/motion/Reveal\";\nimport type { PublicTerm } from \"@/lib/contracts/specialists\";\n\nconst ICONS: readonly LucideIcon[] = [Zap, Wrench, Paintbrush, Grid3x3, Hammer, Thermometer, Flame, Layers, Mountain, House, Umbrella, Trees];\n\n/** Category links use the supplied public taxonomy slugs, never local fixtures. */\nexport function CategoryGrid({ categories }: { categories: PublicTerm[] }) {\n  return (\n    <section className=\"px-4 py-10 sm:px-6\" aria-labelledby=\"cats-title\">\n      <div className=\"mx-auto max-w-5xl\">\n        <div className=\"mb-7 flex items-end justify-between\">\n          <div>\n            <h2 id=\"cats-title\" className=\"text-xl font-bold sm:text-2xl\">دسته‌بندی خدمات</h2>\n            <p className=\"mt-1.5 text-sm text-muted\">جستجو را با دسته‌بندی مورد نیازت شروع کن</p>\n          </div>\n          <Link href=\"/search\" className=\"text-sm text-primary hover:text-accent\">مشاهده همه</Link>\n        </div>\n        {categories.length === 0 ? (\n          <p className=\"rounded-3xl border border-dashed border-line bg-card p-6 text-sm text-muted\">دسته‌بندی منتشرشده‌ای برای نمایش وجود ندارد.</p>\n        ) : (\n          <Reveal stagger={0.06} className=\"grid grid-cols-3 gap-2.5 sm:grid-cols-4 sm:gap-3.5 lg:grid-cols-6\">\n            {categories.map((category, index) => {\n              const Icon = ICONS[index % ICONS.length] ?? Hammer;\n              return (\n                <TapCard key={category.id}>\n                  <Link href={`/search?category=${encodeURIComponent(category.slug)}`} className=\"group flex flex-col items-center gap-2.5 rounded-3xl border border-line bg-card px-2 py-5 text-center transition-colors duration-300 hover:border-primary/40 hover:bg-elev-2/80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary\">\n                    <span className=\"flex h-12 w-12 items-center justify-center rounded-2xl bg-primary/10 text-primary transition-all duration-300 group-hover:scale-110 group-hover:bg-primary group-hover:text-primary-fg group-hover:shadow-[0_8px_20px_-6px_var(--glow)]\"><Icon className=\"h-5.5 w-5.5\" /></span>\n                    <span className=\"text-[13px] font-medium text-fg-soft\">{category.name}</span>\n                  </Link>\n                </TapCard>\n              );\n            })}\n          </Reveal>\n        )}\n      </div>\n    </section>\n  );\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/components/sections/ProDashboard.tsx": {
      "sha256": "b8b61ee79dd17a0cd592ff4d2ac42df889ec36f41f07eb4e6102c9421f80e026",
      "text": "import Link from 'next/link';\nimport {ArrowLeft,UserRound,FilePenLine} from 'lucide-react';\nimport {WorkspaceHeader,WorkspacePanel,workspaceClass,workspaceLink,primaryWorkspaceLink} from './owner/AccountWorkspace';\n\nexport function ProDashboard({displayName}:{displayName:string}) {\n return <section className={workspaceClass} dir=\"rtl\">\n  <WorkspaceHeader role=\"specialist\" current=\"/pro\" title=\"داشبورد متخصص\" description={`${displayName}، معرفی حرفه‌ای، خدمات و نمونه‌کارهایتان را در پروفایل مدیریت کنید.`} />\n  <WorkspacePanel title=\"معرفی حرفه‌ای شما در کاربان\" description=\"اطلاعات حرفه‌ای را تکمیل و ذخیره کنید. ارسال نسخه ذخیره‌شده برای بررسی، مرحله‌ای جدا از ذخیره است و به معنی انتشار نیست.\">\n   <div className=\"flex flex-col items-stretch gap-3 sm:flex-row sm:flex-wrap sm:items-center\"><Link href=\"/pro/profile\" className={primaryWorkspaceLink}><FilePenLine size={18} aria-hidden=\"true\" />تکمیل پروفایل حرفه‌ای<ArrowLeft size={18} aria-hidden=\"true\" /></Link><Link href=\"/account\" className={workspaceLink}><UserRound size={18} aria-hidden=\"true\" />حساب شخصی</Link></div>\n  </WorkspacePanel>\n  <section className=\"space-y-2 rounded-3xl bg-elev p-5 sm:p-7\"><h2 className=\"font-bold text-fg-soft\">فرصت‌های کاری و خدمات مالی</h2><p className=\"max-w-2xl text-sm leading-8 text-muted\">این بخش هنوز به سرویس واقعی متصل نیست. فرصت کاری، اعتبار خرید یا پرداختی برای نمایش در دسترس نیست.</p></section>\n </section>;\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/components/sections/SpecialistList.tsx": {
      "sha256": "4728d444669c1605b2ae593e1de534da32fc2486a0c11d19f15fb9e4a810b76d",
      "text": "\"use client\";\n\nimport Link from \"next/link\";\nimport { MapPin } from \"lucide-react\";\nimport { Avatar } from \"@/components/ui/Avatar\";\nimport { Badge, VerifiedBadge } from \"@/components/ui/Badge\";\nimport { Rating } from \"@/components/ui/Rating\";\nimport { TapCard } from \"@/components/motion/TapCard\";\nimport { Reveal } from \"@/components/motion/Reveal\";\nimport { PublicDataEmpty } from \"@/components/sections/PublicDataState\";\nimport type { PublicSpecialistCard } from \"@/lib/contracts/specialists\";\n\nfunction availabilityBadge(availability: PublicSpecialistCard[\"availability\"]) {\n  if (availability === \"available\") return <Badge tone=\"success\">آمادهٔ کار</Badge>;\n  if (availability === \"busy\") return <Badge tone=\"warn\">مشغول</Badge>;\n  if (availability === \"away\") return <Badge tone=\"neutral\">فعلاً در دسترس نیست</Badge>;\n  return null;\n}\n\nexport function SpecialistCard({ specialist }: { specialist: PublicSpecialistCard }) {\n  const places = specialist.cities.join(\"، \");\n\n  return (\n    <TapCard>\n      <article className=\"group rounded-3xl border border-line bg-card p-4 transition-colors duration-300 hover:border-primary/35\">\n        <div className=\"flex items-start gap-3.5\">\n          <div className=\"relative\">\n            <Avatar name={specialist.title} src={specialist.avatarUrl} hue={specialist.id} className=\"h-16 w-16 rounded-2xl text-xl\" />\n            {specialist.availability === \"available\" && <span className=\"absolute -bottom-0.5 -left-0.5 h-3.5 w-3.5 rounded-full border-2 border-ink-900 bg-success\" title=\"آمادهٔ کار\" />}\n          </div>\n          <div className=\"min-w-0 flex-1\">\n            <div className=\"flex items-center gap-1.5\">\n              <h3 className=\"truncate font-bold text-fg\">{specialist.title}</h3>\n              {specialist.verified && <VerifiedBadge />}\n            </div>\n            {specialist.categories.length > 0 && <p className=\"mt-0.5 truncate text-sm text-muted\">{specialist.categories.join(\"، \")}</p>}\n            <div className=\"mt-2 flex flex-wrap items-center gap-x-3 gap-y-1\">\n              <Rating value={specialist.rating?.average ?? null} count={specialist.rating?.count} />\n              {places && <span className=\"inline-flex items-center gap-1 text-xs text-muted\"><MapPin className=\"h-3.5 w-3.5 text-primary/70\" />{places}</span>}\n            </div>\n          </div>\n        </div>\n        <div className=\"mt-3 flex flex-wrap gap-1.5\">\n          {specialist.categories.map((category) => <Badge key={category} tone=\"brand\">{category}</Badge>)}\n          {availabilityBadge(specialist.availability)}\n        </div>\n        <div className=\"mt-4 flex gap-2.5\">\n          <Link prefetch={false} href={`/specialists/${encodeURIComponent(specialist.slug)}`} className=\"flex h-9 flex-1 items-center justify-center rounded-xl border border-line bg-elev-2 text-sm text-fg transition-colors duration-200 hover:bg-elev-3 active:scale-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary\">مشاهدهٔ پروفایل</Link>\n        </div>\n      </article>\n    </TapCard>\n  );\n}\n\nexport function SpecialistList({\n  specialists,\n  title = \"متخصصان منتشرشده\",\n  description,\n  showMoreLink = false,\n}: {\n  specialists: PublicSpecialistCard[];\n  title?: string;\n  description?: string;\n  showMoreLink?: boolean;\n}) {\n  return (\n    <section className=\"px-4 py-10 sm:px-6\" aria-labelledby=\"specs-title\">\n      <div className=\"mx-auto max-w-5xl\">\n        <div className=\"mb-7 flex items-end justify-between gap-4\">\n          <div>\n            <h2 id=\"specs-title\" className=\"text-xl font-bold sm:text-2xl\">{title}</h2>\n            {description && <p className=\"mt-1.5 text-sm text-muted\">{description}</p>}\n          </div>\n          {showMoreLink && <Link href=\"/search\" className=\"text-sm text-primary hover:text-accent\">مشاهده همه</Link>}\n        </div>\n        {specialists.length === 0 ? (\n          <PublicDataEmpty title=\"متخصصی پیدا نشد\" description=\"فیلترها را تغییر بده یا عبارت دیگری جستجو کن.\" />\n        ) : (\n          <Reveal stagger={0.09} className=\"grid gap-4 sm:grid-cols-2 lg:grid-cols-3\">\n            {specialists.map((specialist) => <SpecialistCard key={specialist.id} specialist={specialist} />)}\n          </Reveal>\n        )}\n      </div>\n    </section>\n  );\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/components/sections/PublicDataState.tsx": {
      "sha256": "8b709052b2ae1bc825bfac9977a35dec37c677fe53a8ec22a5eec818d83a09bc",
      "text": "\"use client\";\n\nimport { useRouter } from \"next/navigation\";\nimport { RefreshCw } from \"lucide-react\";\nimport { Button } from \"@/components/ui/Button\";\n\nexport function PublicDataError({\n  title = \"بارگذاری اطلاعات ممکن نشد\",\n  description = \"ارتباط با اطلاعات عمومی کاربان برقرار نشد. دوباره تلاش کنید.\",\n}: {\n  title?: string;\n  description?: string;\n}) {\n  const router = useRouter();\n\n  return (\n    <section className=\"mx-auto max-w-5xl px-4 py-10 sm:px-6\" aria-live=\"polite\">\n      <div className=\"rounded-3xl border border-line bg-card p-6 text-center sm:p-8\">\n        <h2 className=\"text-lg font-bold text-fg\">{title}</h2>\n        <p className=\"mx-auto mt-2 max-w-md text-sm leading-relaxed text-muted\">\n          {description}\n        </p>\n        <Button\n          type=\"button\"\n          variant=\"secondary\"\n          className=\"mt-5 gap-2\"\n          onClick={() => router.refresh()}\n        >\n          <RefreshCw className=\"h-4 w-4\" />\n          تلاش دوباره\n        </Button>\n      </div>\n    </section>\n  );\n}\n\nexport function PublicDataEmpty({\n  title,\n  description,\n}: {\n  title: string;\n  description: string;\n}) {\n  return (\n    <section className=\"rounded-3xl border border-dashed border-line bg-card p-8 text-center\" aria-live=\"polite\">\n      <h2 className=\"text-lg font-bold text-fg\">{title}</h2>\n      <p className=\"mx-auto mt-2 max-w-md text-sm leading-relaxed text-muted\">{description}</p>\n    </section>\n  );\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/components/sections/SpecialistProfile.tsx": {
      "sha256": "ee2c1a82d6d1b689ca046ee597cbcafd9f7570b20e5f5b0dfe638c999ebd5b56",
      "text": "\"use client\";\n\nimport { useRef, useState } from \"react\";\nimport { useGSAP } from \"@gsap/react\";\nimport gsap from \"gsap\";\nimport { BriefcaseBusiness, CalendarClock, MapPin, Phone, Timer } from \"lucide-react\";\nimport { Avatar } from \"@/components/ui/Avatar\";\nimport { Badge, VerifiedBadge } from \"@/components/ui/Badge\";\nimport { Button } from \"@/components/ui/Button\";\nimport { Rating } from \"@/components/ui/Rating\";\nimport { PortfolioGallery } from '@/components/blocks/PortfolioGallery';\nimport { PublicDataEmpty } from \"@/components/sections/PublicDataState\";\nimport type { PublicSpecialistDetail } from \"@/lib/contracts/specialists\";\nimport { faNum } from \"@/lib/utils\";\n\nfunction availabilityLabel(availability: PublicSpecialistDetail[\"availability\"]): string | null {\n  if (availability === \"available\") return \"آمادهٔ کار\";\n  if (availability === \"busy\") return \"مشغول\";\n  if (availability === \"away\") return \"فعلاً در دسترس نیست\";\n  return null;\n}\n\nexport function SpecialistProfile({ specialist }: { specialist: PublicSpecialistDetail }) {\n  const rootRef = useRef<HTMLDivElement>(null);\n  const [phoneVisible, setPhoneVisible] = useState(false);\n  const location = specialist.cities.join(\"، \");\n  const availability = availabilityLabel(specialist.availability);\n  const summary = specialist.description ?? specialist.bio;\n  const stats = [\n    specialist.experienceYears === null ? null : { icon: CalendarClock, value: `${faNum(specialist.experienceYears)} سال`, label: \"سابقهٔ کار\" },\n    specialist.responseMinutes === null ? null : { icon: Timer, value: `${faNum(specialist.responseMinutes)} دقیقه`, label: \"زمان پاسخ\" },\n    specialist.priceHint ? { icon: BriefcaseBusiness, value: specialist.priceHint, label: \"بازهٔ قیمت\" } : null,\n  ].filter((item): item is NonNullable<typeof item> => item !== null);\n\n  useGSAP(\n    () => {\n      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;\n      gsap.timeline({ defaults: { ease: \"power3.out\" } })\n        .fromTo(\".profile-cover\", { scaleY: 0.6, transformOrigin: \"top\", autoAlpha: 0 }, { scaleY: 1, autoAlpha: 1, duration: 0.7 })\n        .fromTo(\".profile-avatar\", { scale: 0.5, autoAlpha: 0 }, { scale: 1, autoAlpha: 1, duration: 0.7, ease: \"back.out(1.7)\" }, \"-=0.35\")\n        .fromTo(\".profile-head > *\", { y: 24, autoAlpha: 0 }, { y: 0, autoAlpha: 1, duration: 0.6, stagger: 0.08 }, \"-=0.4\");\n    },\n    { scope: rootRef },\n  );\n\n  return (\n    <div ref={rootRef} className=\"mx-auto max-w-4xl\">\n      <div className=\"profile-cover relative mx-3 mt-2 h-40 overflow-hidden rounded-4xl sm:mx-6 sm:h-52\">\n        <div className=\"absolute inset-0 bg-[radial-gradient(100%_120%_at_80%_0%,rgb(0_114_182_/_0.45),transparent_55%),radial-gradient(90%_100%_at_10%_100%,rgb(245_184_0_/_0.25),transparent_50%),linear-gradient(150deg,#102431,#050b10)]\" />\n        <div aria-hidden className=\"absolute inset-0 opacity-[0.06]\" style={{ backgroundImage: \"linear-gradient(0deg, white 1px, transparent 1px), linear-gradient(90deg, white 1px, transparent 1px)\", backgroundSize: \"28px 28px\" }} />\n        {availability && <Badge tone={specialist.availability === \"available\" ? \"success\" : \"neutral\"} className=\"absolute left-4 top-4 backdrop-blur\">{availability}</Badge>}\n      </div>\n      <div className=\"relative px-5 pb-24 sm:px-8 md:pb-8\">\n        <div className=\"profile-avatar -mt-12 inline-block rounded-[1.4rem] border-4 border-surface sm:-mt-14\"><Avatar name={specialist.title} src={specialist.avatarUrl} hue={specialist.id} className=\"h-24 w-24 rounded-[1.1rem] text-3xl sm:h-28 sm:w-28\" /></div>\n        <div className=\"profile-head mt-3\">\n          <div className=\"flex flex-wrap items-center gap-2\"><h1 className=\"text-2xl font-bold text-fg\">{specialist.title}</h1>{specialist.verified && <VerifiedBadge className=\"[&_svg]:h-6 [&_svg]:w-6\" />}</div>\n          {specialist.categories.length > 0 && <p className=\"mt-1 text-muted\">{specialist.categories.join(\"، \")}</p>}\n          <div className=\"mt-2.5 flex flex-wrap items-center gap-x-4 gap-y-1.5 text-sm\"><Rating value={specialist.rating?.average ?? null} count={specialist.rating?.count} />{location && <span className=\"inline-flex items-center gap-1 text-muted\"><MapPin className=\"h-4 w-4 text-primary/80\" />{location}</span>}</div>\n          {specialist.address && <p className=\"mt-2 text-sm text-muted\">{specialist.address}</p>}\n        </div>\n        {stats.length > 0 && <div className={`mt-6 grid gap-2.5 ${stats.length === 1 ? \"grid-cols-1\" : stats.length === 2 ? \"grid-cols-2\" : \"grid-cols-3\"}`}>{stats.map(({ icon: Icon, value, label }) => <div key={label} className=\"rounded-3xl border border-line bg-card p-3.5 text-center\"><Icon className=\"mx-auto mb-1.5 h-5 w-5 text-primary\" /><div className=\"text-sm font-bold text-fg\">{value}</div><div className=\"mt-0.5 text-[11px] text-faint\">{label}</div></div>)}</div>}\n        <div className=\"py-7\">\n          {summary ? <p className=\"leading-8 text-fg-soft\">{summary}</p> : <PublicDataEmpty title=\"توضیحی منتشر نشده است\" description=\"این متخصص هنوز توضیح عمومی برای پروفایل خود ثبت نکرده است.\" />}\n          {specialist.skills && <div className=\"mt-6\"><h2 className=\"mb-3 font-bold text-fg\">مهارت‌ها</h2><p className=\"leading-8 text-fg-soft\">{specialist.skills}</p></div>}\n          <section className=\"mt-8\"><h2 className=\"mb-4 text-lg font-bold\">نمونه کارها</h2>{Array.isArray(specialist.gallery) ? <PortfolioGallery items={specialist.gallery} /> : <PublicDataEmpty title={specialist.gallery==='empty'?'نمونه کاری منتشر نشده است':'گالری در دسترس نیست'} description=\"فقط تصاویر عمومی منتشرشده در این بخش نمایش داده می‌شوند.\" />}</section>\n          <section className=\"mt-8\"><h2 className=\"mb-3 font-bold\">نظرها</h2><p className=\"text-sm text-muted\">نظرهای واقعی فعلاً در دسترس نیست.</p></section>\n        </div>\n      </div>\n      {specialist.phoneDisplay && <div className=\"fixed inset-x-3 bottom-[calc(var(--bottom-nav-h)+1.25rem)] z-40 mx-auto max-w-md md:static md:mx-8 md:mb-10 md:max-w-none\">{phoneVisible ? <a href={`tel:${specialist.phoneDisplay}`} dir=\"ltr\" className=\"flex h-13 w-full items-center justify-center gap-2 rounded-2xl bg-primary text-base font-medium text-primary-fg shadow-[0_10px_28px_-8px_var(--glow)] transition-colors duration-200 hover:bg-primary-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary\"><Phone className=\"h-5 w-5\" />{specialist.phoneDisplay}</a> : <Button size=\"lg\" className=\"h-13 w-full gap-2 text-base\" onClick={() => setPhoneVisible(true)}><Phone className=\"h-5 w-5\" />نمایش شمارهٔ تماس</Button>}</div>}\n    </div>\n  );\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/components/sections/ClientDashboard.tsx": {
      "sha256": "9b2a42faf8c4022deb0fe8f9945f67872fb045150844b33e70e298220168d046",
      "text": "import Link from 'next/link';\nimport {ArrowLeft,Search,UserRound} from 'lucide-react';\nimport {WorkspaceHeader,WorkspacePanel,workspaceClass,workspaceLink,primaryWorkspaceLink} from './owner/AccountWorkspace';\n\nexport function ClientDashboard({displayName}:{displayName:string}) {\n return <section className={workspaceClass} dir=\"rtl\">\n  <WorkspaceHeader role=\"client\" current=\"/dashboard\" title={`سلام، ${displayName}`} description=\"متخصص مناسب کارتان را پیدا کنید یا اطلاعات حساب شخصی را به‌روز نگه دارید.\" />\n  <WorkspacePanel title=\"از انتخاب متخصص شروع کنید\" description=\"تخصص و شهر مورد نیازتان را در جستجو انتخاب کنید و پروفایل متخصصان را ببینید.\">\n   <div className=\"flex flex-col items-stretch gap-3 sm:flex-row sm:flex-wrap sm:items-center\"><Link href=\"/search\" className={primaryWorkspaceLink}><Search size={18} aria-hidden=\"true\" />جستجوی متخصصان<ArrowLeft size={18} aria-hidden=\"true\" /></Link><Link href=\"/account\" className={workspaceLink}><UserRound size={18} aria-hidden=\"true\" />ویرایش حساب شخصی</Link></div>\n  </WorkspacePanel>\n  <section className=\"space-y-2 rounded-3xl bg-elev p-5 sm:p-7\"><h2 className=\"font-bold text-fg-soft\">پروژه‌ها و خدمات مالی</h2><p className=\"max-w-2xl text-sm leading-8 text-muted\">این بخش هنوز به سرویس واقعی متصل نیست. پروژه، پیشنهاد یا اطلاعات مالی برای نمایش در دسترس نیست.</p></section>\n </section>;\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/components/sections/owner/OwnerEditor.tsx": {
      "sha256": "45bd9e24f82db0479f8c4d7572d0e216e50daae1cba7f1250623799c41c35c49",
      "text": "\"use client\";\n/* eslint-disable @next/next/no-img-element -- Safe normalized WordPress image URLs. */\nimport {useEffect,useMemo,useRef,useState} from 'react';\nimport Link from 'next/link';\nimport {Button} from '@/components/ui/Button';\nimport {useAuthSummary} from '@/components/layout/useAuthSummary';\nimport {createActionGate,createOwnerClient,settleOwnerAction,OwnerClientError} from '@/lib/owner-client';\nimport {ownerErrorText,type OwnerScreen} from '@/lib/owner-ui';\nimport type {AccountDto,ProfileDto,UploadDto} from '@/services/profile/profile-contracts';\nimport {AccountForm,ProfessionalForm} from './OwnerForms';\nimport {MediaUpload} from './MediaUpload';\nimport {WorkspaceHeader,SavedProfileSummary,ProfileReviewPanel,workspaceClass,workspaceLink} from './AccountWorkspace';\n\ntype Ready=Extract<OwnerScreen,{kind:'ready'}>;\nexport function OwnerEditor({initial}:{initial:Ready}) {\n const summary=useAuthSummary();const client=useMemo(()=>createOwnerClient(fetch,summary.refresh),[summary.refresh]);\n const [account,setAccount]=useState(initial.account);const [profile,setProfile]=useState(initial.profile);\n const [capabilities,setCapabilities]=useState(initial.capabilities);\n const [pending,setPending]=useState(false);const [blocked,setBlocked]=useState(false);const [error,setError]=useState<OwnerClientError|null>(null);const [notice,setNotice]=useState('');const [revision,setRevision]=useState(0);\n const gate=useRef(createActionGate());const professional=initial.profile!==null;\n useEffect(()=>{const g=gate.current;return ()=>g.cancel();},[]);\n useEffect(()=>{if(summary.logoutPending||summary.logoutError)gate.current.cancel();},[summary.logoutPending,summary.logoutError]);\n useEffect(()=>{\n  const controller=new AbortController();\n  client.capabilities(controller.signal).then(value=>{if(!controller.signal.aborted)setCapabilities(value);}).catch(()=>{if(!controller.signal.aborted)setCapabilities(null);});\n  return ()=>controller.abort();\n },[client]);\n const apply=(next:AccountDto|ProfileDto)=>{if('displayName' in next)setAccount(next);else setProfile(next);setRevision(n=>n+1);};\n const read=async():Promise<AccountDto|ProfileDto>=>professional?client.profile():client.account();\n const act=async<T,>(operation:()=>Promise<T>,accept:(value:T)=>void,message:string,authoritativeRead=false):Promise<boolean>=>{\n  if(blocked&&!authoritativeRead)return false;\n  const action=gate.current.begin();if(!action)return false;\n  setPending(true);setError(null);setNotice('');\n  try{\n   const outcome=await settleOwnerAction(operation,read,blocked);\n   if(!action.current())return false;\n   if(outcome.ok){accept(outcome.value);setNotice(message);if(authoritativeRead)setBlocked(false);return true;}\n   setError(outcome.error);if(outcome.state)apply(outcome.state);setBlocked(outcome.reloadFailed);\n   return false;\n  }finally{if(action.current())setPending(false);action.finish();}\n };\n const reload=()=>act(read,apply,'اطلاعات تازه خوانده شد. تغییرات ذخیره‌نشده را دوباره بررسی کنید.',true);\n const assignAvatar=(asset:UploadDto)=>professional?\n  act(()=>client.saveProfile({avatar_id:asset.id}),value=>apply(value),'آواتار حرفه‌ای ذخیره شد؛ انتشار از وضعیت پروفایل پیروی می‌کند.'):\n  act(()=>client.saveAccount({avatar_id:asset.id}),value=>apply(value),'آواتار حساب شخصی ذخیره شد.');\n const upload=async(file:File,purpose:'public-avatar'|'public-portfolio')=>{\n  if(blocked)throw new OwnerClientError(409,'operation_uncertain',true);\n  const action=gate.current.begin();if(!action)throw new OwnerClientError(409,'gallery_busy');\n  setPending(true);setError(null);setNotice('');\n  try{\n   const outcome=await settleOwnerAction(()=>client.upload(file,purpose),read,blocked);\n   if(!action.current())throw new OwnerClientError(401,'unauthenticated');\n   if(outcome.ok)return outcome.value;\n   setError(outcome.error);if(outcome.state)apply(outcome.state);setBlocked(outcome.reloadFailed);\n   throw outcome.error;\n  }finally{if(action.current())setPending(false);action.finish();}\n };\n if(summary.logoutPending||summary.logoutError||!summary.account||summary.account.id!==account.id||summary.account.role!==account.role) return <section className=\"mx-auto max-w-xl space-y-4 px-5 py-12\"><h1 className=\"text-xl font-bold\">{summary.logoutPending?'در حال خروج از حساب':'بررسی دسترسی حساب'}</h1><p className=\"leading-8 text-muted\">{summary.error?'خلاصه حساب در دسترس نیست. اطلاعات خصوصی تا بررسی نشست نمایش داده نمی‌شود.':'برای مشاهده و ویرایش، نشست معتبر لازم است.'}</p><Link className=\"owner-link\" href=\"/auth/login\">ورود به حساب</Link></section>;\n const avatar=professional?profile?.avatar:account.avatar;\n const disabled=pending||blocked;\n return <div className={workspaceClass} dir=\"rtl\" aria-busy={pending}>\n  <WorkspaceHeader role={account.role} current={professional?'/pro/profile':'/account'} title={professional?'پروفایل حرفه‌ای':'حساب شخصی'} description={professional?'پروفایل عمومی کسب‌وکار از اطلاعات حساب شخصی جداست. اطلاعات را ذخیره کنید و وضعیت بررسی را جداگانه ببینید.':'نام نمایشی، شهر و آواتار شخصی را مدیریت کنید؛ نقش و شماره ورود ثابت می‌ماند.'} />\n  <div className=\"flex flex-wrap items-center justify-between gap-3 rounded-2xl bg-elev p-4\"><p className=\"text-sm leading-7 text-muted\">{pending?'عملیات در حال انجام است؛ لطفاً صبر کنید.':blocked?'برای ادامه، وضعیت سرور را دوباره بخوانید.':'برای دریافت آخرین وضعیت ذخیره‌شده از سرور'}</p><Button variant=\"ghost\" disabled={pending} onClick={()=>void reload()}>بارگذاری دوباره وضعیت</Button>{error?.code==='refresh_required'&&<Link className={workspaceLink} href={`/auth/recover?returnTo=${professional?'/pro/profile':'/account'}`}>بازیابی نشست؛ بدون تکرار تغییرات</Link>}{error?.status===401&&error.code!=='refresh_required'&&<Link className={workspaceLink} href=\"/auth/login\">ورود دوباره</Link>}</div>\n  {error&&<p role=\"alert\" className=\"rounded-2xl border border-alert/30 p-4 text-sm leading-8 text-alert\">{ownerErrorText(error)}{blocked?' خواندن وضعیت موفق نبود؛ تا بارگذاری دوباره، تغییرات غیرفعال است.':''}</p>}\n  {notice&&<p role=\"status\" className=\"rounded-2xl border border-accent/30 p-4 text-sm leading-8 text-fg-soft\">{notice}</p>}\n  {initial.optionsUnavailable&&<p role=\"status\" className=\"text-sm leading-7 text-alert\">فهرست شهرها یا دسته‌ها خوانده نشد؛ فرم تا بارگذاری دوباره صفحه غیرفعال است.</p>}\n  {profile&&<SavedProfileSummary profile={profile} />}\n  <section className=\"rounded-3xl border border-line bg-card p-5 sm:p-7\">{profile?<ProfessionalForm key={revision} profile={profile} cities={initial.cities} categories={initial.categories} disabled={disabled||initial.optionsUnavailable} onSave={async input=>{await act(()=>client.saveProfile(input),value=>apply(value),'تغییرات ذخیره شد؛ وضعیت انتشار را بررسی کنید.');}} />:<AccountForm key={revision} account={account} cities={initial.cities} disabled={disabled||initial.optionsUnavailable} onSave={async input=>{await act(()=>client.saveAccount(input),value=>apply(value),'اطلاعات شخصی ذخیره شد و خلاصه حساب تازه شد.');}} />}</section>\n  <section className=\"space-y-4 rounded-[2rem] border border-line bg-card p-5 sm:p-7\"><h2 className=\"text-lg font-bold\">{professional?'آواتار حرفه‌ای':'آواتار حساب شخصی'}</h2>{avatar?<><img src={avatar.url} alt=\"آواتار فعلی\" className=\"h-24 w-24 rounded-2xl object-cover\" /><Button variant=\"outline\" disabled={disabled} onClick={()=>void (professional?act(()=>client.saveProfile({avatar_id:null}),value=>apply(value),'ارجاع آواتار پاک شد؛ فایل حذف نشده است.'):act(()=>client.saveAccount({avatar_id:null}),value=>apply(value),'ارجاع آواتار پاک شد؛ فایل حذف نشده است.'))}>پاک کردن آواتار</Button></>:<p className=\"text-sm text-muted\">آواتاری ثبت نشده است.</p>}<MediaUpload purpose=\"public-avatar\" capabilities={capabilities} disabled={disabled} upload={upload} assign={assignAvatar} /></section>\n  {profile&&<section className=\"space-y-4 rounded-[2rem] border border-line bg-card p-5 sm:p-7\"><h2 className=\"text-lg font-bold\">گالری نمونه کار</h2><p className=\"text-sm leading-7 text-muted\">حداکثر {Math.min(20,capabilities?.maxGalleryItems??20).toLocaleString('fa-IR')} تصویر. جدا کردن فقط ارجاع را حذف می‌کند؛ فایل عمومی حذف نمی‌شود.</p>{!profile.galleryAvailable&&<p role=\"status\" className=\"text-sm leading-8 text-alert\">ذخیره‌سازی استاندارد گالری در دسترس نیست؛ تصاویر عمومی معتبر فقط خواندنی هستند. انتقال خودکار داده‌های قدیمی انجام نمی‌شود.</p>}{profile.gallery.length===0&&<p className=\"text-sm text-muted\">تصویری در گالری ثبت نشده است.</p>}<div className=\"grid gap-4 sm:grid-cols-2 lg:grid-cols-3\">{profile.gallery.map(item=><figure key={item.id} className=\"min-w-0 rounded-3xl border border-line bg-elev p-3\"><img src={item.url} alt={item.caption||'نمونه کار ثبت‌شده'} className=\"aspect-[4/3] w-full rounded-xl object-cover\" /><figcaption className=\"my-3 break-words text-sm leading-7\">{item.caption||'نمونه کار متصل‌شده'}</figcaption><Button variant=\"outline\" disabled={disabled||!profile.galleryAvailable} onClick={()=>void act(()=>client.detachGallery(item.id,profile),gallery=>setProfile(value=>value?{...value,...gallery}:value),'ارجاع تصویر جدا شد؛ فایل عمومی حذف نشده است.')}>جدا کردن از گالری</Button></figure>)}</div><MediaUpload purpose=\"public-portfolio\" capabilities={capabilities} disabled={disabled||!profile.galleryAvailable||profile.gallery.length>=Math.min(20,capabilities?.maxGalleryItems??20)} upload={upload} assign={(asset,caption)=>act(()=>client.addGallery(asset.id,caption,profile),gallery=>setProfile(value=>value?{...value,...gallery}:value),'تصویر به گالری متصل شد؛ وضعیت انتشار را بررسی کنید.')} /></section>}\n  {profile&&<ProfileReviewPanel status={profile.status} disabled={disabled} onSubmit={()=>void act(()=>client.submitProfile(),value=>apply(value),'پاسخ ارسال دریافت شد؛ وضعیت فعلی از سرور خوانده شده است.')} />}\n </div>;\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/components/sections/owner/OwnerPage.server.tsx": {
      "sha256": "32437fce99371f84d0e6ee3d0bd8badd4d160efc1f7e212a516ec732790a54ff",
      "text": "import 'server-only';\nimport {redirect} from 'next/navigation';\nimport {readOwnerAccount,readOwnerProfile,readOwnerMediaCapabilities} from '@/services/profile/profile-bff.server';\nimport {loadPublicTerms} from '@/services/wordpress/taxonomies';\nimport {loadOwnerScreen} from '@/lib/owner-ui';\nimport {OwnerEditor} from './OwnerEditor';\nimport {OwnerUnavailable,SessionRecovery} from './SessionRecovery';\n\nexport async function OwnerPage({kind}:{kind:'account'|'profile'}) {\n const screen=await loadOwnerScreen(kind,{\n  account:readOwnerAccount,profile:readOwnerProfile,capabilities:readOwnerMediaCapabilities,\n  cities:()=>loadPublicTerms('city'),categories:()=>loadPublicTerms('job_category'),\n });\n if(screen.kind==='redirect')redirect(screen.location);\n if(screen.kind==='recovery')return <SessionRecovery target={screen.target} />;\n if(screen.kind==='unavailable')return <OwnerUnavailable />;\n return <OwnerEditor initial={screen} />;\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/components/sections/owner/OwnerForms.tsx": {
      "sha256": "6d64b9dcec757af80c1817634192275058f42b21c7946e555f11cef0cefab789",
      "text": "\"use client\";\n\nimport type { FormEvent, ReactNode } from 'react';\nimport { Button } from '@/components/ui/Button';\nimport { Input } from '@/components/ui/Input';\nimport { accountInput, profileInput } from '@/lib/owner-ui';\nimport type { AccountDto, ProfileDto } from '@/services/profile/profile-contracts';\nimport type { PublicTerm } from '@/lib/contracts/specialists';\n\nconst control='w-full min-h-12 rounded-2xl border border-line bg-elev px-4 py-3 text-fg transition-[border-color,opacity] duration-200 hover:border-accent/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent disabled:opacity-50';\nfunction SelectField({id,label,children,defaultValue}:{id:string;label:string;children:ReactNode;defaultValue:string|number}) {\n  return <label htmlFor={id} className=\"block text-sm text-fg-soft\">{label}<select id={id} name={id} defaultValue={defaultValue} className={`${control} mt-2`}>{children}</select></label>;\n}\nfunction Terms({terms}:{terms:PublicTerm[]}) { return terms.map(term=><option key={term.id} value={term.id}>{term.name}</option>); }\nfunction FormGroup({title,description,children}:{title:string;description?:string;children:ReactNode}) {\n return <fieldset className=\"min-w-0 space-y-5 border-t border-line pt-5\"><legend className=\"pe-3 text-base font-bold\">{title}</legend>{description&&<p className=\"text-sm leading-7 text-muted\">{description}</p>}{children}</fieldset>;\n}\nfunction submit(event:FormEvent<HTMLFormElement>,parse:(form:FormData)=>Record<string,unknown>,save:(input:Record<string,unknown>)=>Promise<void>) {\n  event.preventDefault();\n  const form=event.currentTarget;\n  try { const input=parse(new FormData(form)); void save(input); }\n  catch { const feedback=form.querySelector<HTMLElement>('[data-validation]');if(feedback){feedback.textContent='ورودی معتبر نیست؛ محدودیت متن و اعداد را بررسی کنید. متن چندخطی پذیرفته نمی‌شود.';feedback.focus();} }\n}\nexport function AccountForm({account,cities,disabled,onSave}:{account:AccountDto;cities:PublicTerm[];disabled:boolean;onSave:(input:Record<string,unknown>)=>Promise<void>}) {\n return <form onSubmit={event=>submit(event,accountInput,onSave)} className=\"space-y-5\">\n  <fieldset disabled={disabled} className=\"min-w-0 space-y-7\"><legend className=\"mb-5 text-lg font-bold\">اطلاعات شخصی</legend>\n   <div className=\"grid gap-5 sm:grid-cols-2\"><Input id=\"display_name\" name=\"display_name\" label=\"نام نمایشی (حداکثر ۱۰۰ نویسه)\" defaultValue={account.displayName} required maxLength={100} autoComplete=\"name\" /><SelectField id=\"account_city_id\" label=\"شهر شخصی (اختیاری)\" defaultValue={account.location?.id??''}><option value=\"\">پاک کردن شهر</option><Terms terms={cities} />{account.location&&!cities.some(t=>t.id===account.location?.id)&&<option value={account.location.id}>{account.location.name}</option>}</SelectField></div>\n   <FormGroup title=\"شناسه‌های ورود\" description=\"شماره ورود و نقش حساب از این فرم تغییر نمی‌کنند.\"><div className=\"grid gap-5 sm:grid-cols-2\"><Input id=\"login-phone\" label=\"شماره ورود؛ فقط خواندنی\" value={account.loginPhoneMasked??'در دسترس نیست'} readOnly dir=\"ltr\" /><Input id=\"account-role\" label=\"نقش حساب؛ فقط خواندنی\" value={account.role==='specialist'?'متخصص':'کارفرما'} readOnly /></div></FormGroup>\n   <div className=\"space-y-4 border-t border-line pt-5\"><p className=\"text-sm leading-7 text-muted\">آواتار حساب شخصی از تصویر پروفایل حرفه‌ای مستقل است. تغییر نام و شهر، نقش یا شماره ورود را تغییر نمی‌دهد.</p><Button type=\"submit\">ذخیره اطلاعات شخصی</Button></div>\n  </fieldset><p data-validation role=\"alert\" tabIndex={-1} className=\"text-sm text-alert\" />\n </form>;\n}\nexport function ProfessionalForm({profile,cities,categories,disabled,onSave}:{profile:ProfileDto;cities:PublicTerm[];categories:PublicTerm[];disabled:boolean;onSave:(input:Record<string,unknown>)=>Promise<void>}) {\n return <form onSubmit={event=>submit(event,profileInput,onSave)} className=\"space-y-5\">\n  <fieldset disabled={disabled} className=\"min-w-0 space-y-8\"><legend className=\"mb-5 text-lg font-bold\">اطلاعات حرفه‌ای</legend>\n   <FormGroup title=\"معرفی و مهارت‌ها\" description=\"متن بدون HTML و بدون خط جدید وارد کنید؛ خالی گذاشتن موارد اختیاری آن‌ها را پاک می‌کند.\">\n    <Input id=\"title\" name=\"title\" label=\"عنوان حرفه‌ای (حداکثر ۱۶۰ نویسه)\" defaultValue={profile.title} required maxLength={160} />\n    {([{name:'bio',label:'معرفی؛ حداکثر ۴۰۰۰ نویسه',max:4000,value:profile.bio},{name:'skills',label:'مهارت‌ها؛ حداکثر ۱۰۰۰ نویسه',max:1000,value:profile.skills}] as const).map(field=><label key={field.name} htmlFor={field.name} className=\"block text-sm text-fg-soft\">{field.label}<textarea id={field.name} name={field.name} defaultValue={field.value} maxLength={field.max} rows={3} className={`${control} mt-2 resize-y`} /></label>)}\n   </FormGroup>\n   <FormGroup title=\"خدمات و محدوده فعالیت\">\n    <fieldset className=\"min-w-0 rounded-2xl border border-line p-4\"><legend className=\"px-2 text-sm\">دسته‌های خدمت؛ حداکثر ۱۰ دسته</legend><div className=\"grid gap-2 sm:grid-cols-2\">{[...categories,...profile.categories.filter(c=>!categories.some(t=>t.id===c.id))].map(category=><label key={category.id} className=\"flex min-h-11 cursor-pointer items-center gap-3 rounded-xl px-2 text-sm hover:bg-wash focus-within:ring-2 focus-within:ring-accent\"><input type=\"checkbox\" name=\"category_ids\" value={category.id} defaultChecked={profile.categories.some(c=>c.id===category.id)} className=\"h-5 w-5 shrink-0 accent-accent\" />{category.name}</label>)}</div></fieldset>\n    <SelectField id=\"city_id\" label=\"شهر خدمت (اختیاری)\" defaultValue={profile.cities[0]?.id??''}><option value=\"\">پاک کردن شهر خدمت</option><Terms terms={cities} />{profile.cities.filter(c=>!cities.some(t=>t.id===c.id)).map(c=><option key={c.id} value={c.id}>{c.name}</option>)}</SelectField>\n   </FormGroup>\n   <FormGroup title=\"شرایط همکاری\"><div className=\"grid gap-5 sm:grid-cols-2\"><SelectField id=\"availability\" label=\"وضعیت دسترسی (اختیاری)\" defaultValue={profile.availability}><option value=\"\">مشخص نشده</option><option value=\"available\">آماده کار</option><option value=\"busy\">مشغول</option><option value=\"away\">در دسترس نیستم</option></SelectField><Input id=\"experience_years\" name=\"experience_years\" label=\"سابقه کار؛ ۰ تا ۸۰ سال (اختیاری)\" type=\"number\" min={0} max={80} step={1} defaultValue={profile.experienceYears??''} /></div><Input id=\"price_hint\" name=\"price_hint\" label=\"توضیح قیمت؛ حداکثر ۲۰۰ نویسه (اختیاری)\" maxLength={200} defaultValue={profile.priceHint} /></FormGroup>\n   <FormGroup title=\"نشانی خصوصی\" description=\"این نشانی عمومی نمایش داده نمی‌شود و از شهر خدمت جداست.\"><label htmlFor=\"address\" className=\"block text-sm text-fg-soft\">نشانی خصوصی؛ حداکثر ۵۰۰ نویسه<textarea id=\"address\" name=\"address\" defaultValue={profile.address} maxLength={500} rows={3} className={`${control} mt-2 resize-y`} /></label></FormGroup>\n   <div className=\"space-y-4 border-t border-line pt-5\"><p className=\"text-sm leading-7 text-muted\">ذخیره، انتشار نیست. پس از ذخیره، وضعیت تازه پروفایل را بررسی کنید.</p><Button type=\"submit\">ذخیره پیش‌نویس تغییرات</Button></div>\n  </fieldset><p data-validation role=\"alert\" tabIndex={-1} className=\"text-sm text-alert\" />\n </form>;\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/components/sections/owner/MediaUpload.tsx": {
      "sha256": "1994979598bcea28eec1567d34201ef9bf61757a5acd19588bbcf39854ba2857",
      "text": "\"use client\";\n/* eslint-disable @next/next/no-img-element -- Local object URLs and normalized public WordPress media. */\nimport {useEffect,useId,useRef,useState} from 'react';\nimport {Button} from '@/components/ui/Button';\nimport {createActionGate,OwnerClientError} from '@/lib/owner-client';\nimport {ownerErrorText,uploadOutcomeUncertain} from '@/lib/owner-ui';\nimport {uploadPresentation,workspaceLink} from './AccountWorkspace';\nimport type {MediaCapabilitiesDto,PublicMediaPurpose,UploadDto} from '@/services/profile/profile-contracts';\n\nexport function MediaUpload({purpose,capabilities,disabled,upload,assign}:{purpose:PublicMediaPurpose;capabilities:MediaCapabilitiesDto|null;disabled:boolean;upload:(file:File,purpose:PublicMediaPurpose)=>Promise<UploadDto>;assign:(media:UploadDto,caption:string)=>Promise<boolean>}) {\n const id=useId();const [consent,setConsent]=useState(false);const [file,setFile]=useState<File|null>(null);\n const [preview,setPreview]=useState('');const [asset,setAsset]=useState<UploadDto|null>(null);const [caption,setCaption]=useState('');\n const [pending,setPending]=useState(false);const [error,setError]=useState('');\n const [uncertain,setUncertain]=useState(false);\n const gate=useRef(createActionGate());\n useEffect(()=>{const g=gate.current;return ()=>g.cancel();},[]);\n useEffect(()=>{\n  if(!file)return;\n  const url=URL.createObjectURL(file);setPreview(url);\n  return ()=>{URL.revokeObjectURL(url);};\n },[file]);\n const supported=capabilities?.purposes.includes(purpose)===true;\n const send=async()=>{\n  if(!file||!consent||!supported||disabled||uncertain)return;\n  const action=gate.current.begin();if(!action)return;setPending(true);setError('');\n  try{\n   const next=await upload(file,purpose);\n   if(action.current()){setAsset(next);setFile(null);setPreview('');}\n  }catch(cause){if(action.current()){const e=cause instanceof OwnerClientError?cause:new OwnerClientError(503,'operation_uncertain',true);setError(ownerErrorText(e));if(uploadOutcomeUncertain(e))setUncertain(true);}}\n  finally{if(action.current())setPending(false);action.finish();}\n };\n const attach=async()=>{\n  if(!asset||disabled)return;const action=gate.current.begin();if(!action)return;setPending(true);\n  try{const success=await assign(asset,caption);if(action.current()&&success){setAsset(null);setCaption('');}}\n  finally{if(action.current())setPending(false);action.finish();}\n };\n return <section className=\"space-y-4 rounded-3xl border border-line bg-elev p-4 sm:p-6\" aria-busy={pending}>\n  <h3 className=\"font-bold\">{purpose==='public-avatar'?'بارگذاری تصویر آواتار':'بارگذاری تصویر نمونه کار'}</h3>\n  <ol aria-label=\"مراحل افزودن تصویر\" className=\"flex flex-wrap gap-x-6 gap-y-2 text-sm text-muted\"><li>انتخاب تصویر</li><li>بارگذاری فایل</li><li>اتصال به پروفایل</li></ol>\n  <p role=\"status\" className=\"rounded-2xl border border-line bg-card px-4 py-3 text-sm leading-7\">{uploadPresentation({selected:Boolean(file),uploaded:Boolean(asset),pending,uncertain})}</p>\n  <p id={`${id}-disclosure`} className=\"text-sm leading-8 text-fg-soft\">نشانی فایل بارگذاری‌شده عمومی است، حتی اگر پروفایل پیش‌نویس یا در انتظار بررسی باشد. تصویر مدارک هویتی یا فایل خصوصی نفرستید. بارگذاری به‌تنهایی تصویر را به حساب یا گالری وصل نمی‌کند و پروفایل را منتشر نمی‌کند.</p>\n  <p className=\"text-xs leading-7 text-muted\">ویدیو پشتیبانی نمی‌شود. پذیرش WebP به کُدک واقعی سرور وابسته است و ممکن است با خطای پردازش رد شود.</p>\n  {!supported?<p role=\"status\" className=\"text-sm text-muted\">قابلیت بارگذاری در دسترس نیست.</p>:<>\n   <p className=\"text-xs leading-7 text-muted\">حداکثر حجم: {capabilities.maxBytes.toLocaleString('fa-IR')} بایت؛ ضلع: {capabilities.maxDimension.toLocaleString('fa-IR')} پیکسل؛ مجموع: {capabilities.maxPixels.toLocaleString('fa-IR')} پیکسل. هر بار یک تصویر.</p>\n   <label className=\"flex min-h-11 cursor-pointer items-start gap-3 rounded-2xl border border-line bg-card p-4 text-sm leading-7 focus-within:ring-2 focus-within:ring-accent hover:border-accent/50\"><input type=\"checkbox\" checked={consent} onChange={event=>setConsent(event.target.checked)} disabled={pending||disabled} className=\"mt-1 h-5 w-5 shrink-0 accent-accent\" />عمومی بودن فایل را می‌دانم و تصویر خصوصی بارگذاری نمی‌کنم.</label>\n   <label htmlFor={`${id}-file`} className=\"block text-sm text-fg-soft\">انتخاب تصویر</label><input id={`${id}-file`} type=\"file\" accept={capabilities.imageMimes.join(',')} aria-describedby={`${id}-disclosure`} disabled={!consent||pending||disabled||Boolean(asset)||uncertain} onChange={event=>{const selected=event.target.files?.[0];setError('');if(!selected){setFile(null);setPreview('');return;}if(!capabilities.imageMimes.includes(selected.type as never)||selected.size<1||selected.size>capabilities.maxBytes){setError('نوع یا حجم فایل مطابق قابلیت اعلام‌شده نیست.');setFile(null);setPreview('');event.target.value='';return;}setFile(selected);}} className=\"w-full min-w-0 rounded-2xl border border-line bg-card p-3 text-sm text-fg transition-opacity duration-200 hover:border-accent/50 focus-visible:outline-2 focus-visible:outline-accent disabled:cursor-not-allowed disabled:opacity-50 file:me-3 file:rounded-xl file:border-0 file:bg-accent file:p-2 file:text-accent-fg\" />\n   {preview&&file&&<img src={preview} alt=\"پیش‌نمایش تصویر انتخاب‌شده؛ هنوز بارگذاری نشده\" className=\"h-36 w-36 rounded-2xl object-cover\" />}\n   <Button type=\"button\" onClick={()=>void send()} disabled={!file||!consent||pending||disabled||Boolean(asset)||uncertain}>{pending?'در حال انجام؛ لطفاً صبر کنید':'فقط بارگذاری تصویر'}</Button>\n  </>}\n  {asset&&<div className=\"space-y-3 rounded-2xl border border-accent/40 p-4\"><img src={asset.url} alt=\"تصویر بارگذاری‌شده برای اتصال\" className=\"h-28 w-28 rounded-xl object-cover\" /><p role=\"status\" className=\"text-sm leading-7\">فایل شماره {asset.id.toLocaleString('fa-IR')} بارگذاری شده است. بارگذاری به‌تنهایی اتصال نیست؛ نتیجه اتصال را در وضعیت تازه بررسی کنید. اگر اتصال خطا داد، فقط اتصال را دوباره انتخاب کنید؛ فایل را دوباره بارگذاری نکنید.</p><a href={asset.url} target=\"_blank\" rel=\"noopener noreferrer\" className={`${workspaceLink} break-all text-accent underline`}>مشاهده فایل عمومی بارگذاری‌شده</a>{purpose==='public-portfolio'&&<label htmlFor={`${id}-caption`} className=\"block text-sm\">توضیح تصویر؛ حداکثر ۳۰۰ نویسه<input id={`${id}-caption`} value={caption} maxLength={300} onChange={event=>setCaption(event.target.value)} className=\"mt-2 min-h-12 w-full rounded-2xl border border-line bg-card p-3 hover:border-accent/50 focus-visible:outline-2 focus-visible:outline-accent\" /></label>}<Button type=\"button\" disabled={pending||disabled} onClick={()=>void attach()}>{purpose==='public-avatar'?'استفاده به عنوان آواتار':'افزودن به گالری'}</Button></div>}\n  {uncertain&&<p role=\"alert\" className=\"text-sm leading-7 text-alert\">نتیجه بارگذاری قطعی نیست. برای جلوگیری از فایل تکراری دوباره بارگذاری نکنید؛ وضعیت را بررسی و صفحه را صریحاً بارگذاری کنید.</p>}\n  {error&&<p role=\"alert\" className=\"text-sm leading-7 text-alert\">{error}</p>}\n </section>;\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/components/sections/owner/SessionRecovery.tsx": {
      "sha256": "fe5ce041c3a5641f6ffc574d47986108bb84c351dccf0f3f7184e49d01d6b687",
      "text": "\"use client\";\nimport {useEffect,useMemo,useRef,useState} from 'react';\nimport {useRouter} from 'next/navigation';\nimport Link from 'next/link';\nimport {Button} from '@/components/ui/Button';\nimport {useAuthSummary} from '@/components/layout/useAuthSummary';\nimport {createOwnerClient,createActionGate,OwnerClientError} from '@/lib/owner-client';\nimport {ownerErrorText,recoveryTarget,type OwnerTarget} from '@/lib/owner-ui';\n\nexport function SessionRecovery({target}:{target:OwnerTarget}) {\n const router=useRouter();const {refresh}=useAuthSummary();\n const client=useMemo(()=>createOwnerClient(fetch,refresh),[refresh]);\n const gate=useRef(createActionGate());const [pending,setPending]=useState(false);const [error,setError]=useState('');\n useEffect(()=>{const g=gate.current;return ()=>g.cancel();},[]);\n const recover=async()=>{\n  const action=gate.current.begin();if(!action)return;setPending(true);setError('');\n  try{\n   const destination=recoveryTarget(target);\n   if(destination==='/pro/profile')await client.recoverProfile();else await client.recoverAccount();\n   if(!action.current())return;\n   router.replace(destination);router.refresh();\n  }catch(cause){if(action.current())setError(ownerErrorText(cause instanceof OwnerClientError?cause:new OwnerClientError(503,'auth_unavailable')));}\n  finally{if(action.current())setPending(false);action.finish();}\n };\n return <section className=\"mx-auto max-w-xl space-y-5 px-5 py-12\"><h1 className=\"text-2xl font-bold\">بازیابی نشست</h1><p className=\"leading-8 text-muted\">اعتبار دسترسی تمام شده است. با انتخاب بازیابی، نشست بررسی و اطلاعات تازه خوانده می‌شود. ذخیره، ارسال پروفایل یا بارگذاری فایل خودکار تکرار نمی‌شود.</p><Button onClick={()=>void recover()} disabled={pending} aria-busy={pending}>{pending?'در حال بررسی نشست...':'بازیابی نشست و خواندن اطلاعات'}</Button>{error&&<p role=\"alert\" className=\"text-sm leading-7 text-alert\">{error}</p>}<Link href=\"/auth/login\" className=\"owner-link\">ورود دوباره</Link></section>;\n}\nexport function OwnerUnavailable(){return <section className=\"mx-auto max-w-xl space-y-4 px-5 py-12\"><h1 className=\"text-2xl font-bold\">اطلاعات حساب در دسترس نیست</h1><p className=\"leading-8 text-muted\">سرویس یا تنظیمات اتصال آماده نیست. این وضعیت به معنی خروج از حساب نیست.</p><Button variant=\"outline\" onClick={()=>window.location.reload()}>بارگذاری دوباره اطلاعات</Button><Link href=\"/\" className=\"owner-link\">خانه</Link></section>;}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/components/sections/owner/AccountWorkspace.tsx": {
      "sha256": "39b8b21fdde3e5011fd7c7897709d8c5d1633e7f5eddf78aff2d5d0a76f304f2",
      "text": "import type {ReactNode} from 'react';\nimport Link from 'next/link';\nimport {accountLinks,type OwnerTarget} from '@/lib/owner-ui';\nimport type {RegistrationRole} from '@/lib/contracts/auth';\nimport type {ProfileDto,ProfileStatus} from '@/services/profile/profile-contracts';\nimport {Button} from '@/components/ui/Button';\nimport {Check,Minus,ImageIcon} from 'lucide-react';\n\nconst statusLabel={draft:'پیش‌نویس',pending:'در انتظار بررسی',publish:'منتشرشده'};\n/** Facts from the last authoritative ProfileDto, never unsaved form values or a score. */\nexport function savedProfileChecklist(profile:ProfileDto) {\n return [{label:'عنوان حرفه‌ای',complete:profile.title.trim().length>0},{label:'دسته خدمت',complete:profile.categories.length>0},{label:'شهر خدمت',complete:profile.cities.length>0}];\n}\nexport function reviewPresentation(status:ProfileStatus,disabled:boolean) {\n return {disabled:disabled||status==='pending',label:status==='pending'?'در انتظار بررسی':'ارسال برای بررسی'};\n}\nexport function uploadPresentation({selected,uploaded,pending,uncertain}:{selected:boolean;uploaded:boolean;pending:boolean;uncertain:boolean}) {\n if(uncertain)return 'نتیجه بارگذاری قطعی نیست؛ پیش از اقدام دوباره وضعیت را بررسی کنید.';\n if(pending)return 'عملیات در حال انجام است؛ لطفاً صبر کنید.';\n if(uploaded)return 'فایل بارگذاری شده؛ هنوز متصل نشده است.';\n if(selected)return 'تصویر انتخاب شده؛ هنوز بارگذاری نشده است.';\n return 'هنوز تصویری انتخاب نشده است.';\n}\n\n// Account-scoped interaction treatment; shared primitives and recovery links stay unchanged.\nexport const workspaceClass='mx-auto max-w-5xl space-y-7 px-4 py-8 text-start sm:px-6 sm:py-10 [&_button]:max-w-full [&_button]:whitespace-normal [&_button]:h-auto [&_button]:min-h-11 [&_button]:py-2 [&_button]:transition-[transform,opacity] [&_button]:duration-200 [&_button]:ease-[cubic-bezier(0.2,0,0,1)] [&_button:active]:scale-[0.98] motion-reduce:[&_button:active]:scale-100';\nexport const workspaceLink='inline-flex min-h-11 items-center justify-center gap-2 rounded-2xl border border-line px-4 py-2 text-sm text-fg-soft hover:bg-wash hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent active:scale-[0.98] motion-reduce:active:scale-100';\nexport const primaryWorkspaceLink=`${workspaceLink} border-transparent bg-primary font-bold text-primary-fg hover:bg-primary-hover hover:text-primary-fg`;\n\nexport function WorkspaceHeader({role,current,title,description}:{role:RegistrationRole;current:OwnerTarget;title:string;description:string}) {\n return <header className=\"space-y-5 border-b border-line pb-6\">\n  <div className=\"flex flex-wrap items-center gap-x-3 gap-y-2 text-sm\"><span className=\"rounded-xl bg-elev px-3 py-2 font-medium text-fg-soft\">فضای کار {role==='specialist'?'متخصص':'کارفرما'}</span><span className=\"text-muted\">حساب کاربان</span></div>\n  <div><h1 className=\"break-words text-[clamp(1.5rem,3vw,2rem)] leading-relaxed font-bold\">{title}</h1><p className=\"mt-2 max-w-2xl text-sm leading-8 text-muted\">{description}</p></div>\n  <nav aria-label=\"بخش‌های حساب\" className=\"flex flex-wrap gap-2\">{accountLinks(role).map(link=><Link key={link.href} href={link.href} aria-current={current===link.href?'page':undefined} className={`${workspaceLink} ${current===link.href?'border-accent/40 bg-accent/10 font-bold text-accent':''}`}>{link.label}</Link>)}</nav>\n </header>;\n}\nexport function WorkspacePanel({title,description,children}:{title:string;description?:string;children?:ReactNode}) {\n return <section className=\"space-y-4 rounded-3xl border border-line bg-card p-5 sm:p-7\"><div><h2 className=\"text-lg font-bold\">{title}</h2>{description&&<p className=\"mt-2 max-w-2xl text-sm leading-8 text-muted\">{description}</p>}</div>{children}</section>;\n}\n\nexport function SavedProfileSummary({profile}:{profile:ProfileDto}) {\n return <WorkspacePanel title=\"اطلاعات ذخیره‌شده\" description=\"این خلاصه از آخرین پاسخ سرور است؛ تغییرات ذخیره‌نشده فرم در آن محاسبه نمی‌شود.\">\n  <div className=\"flex items-start gap-4\">\n   {/* eslint-disable-next-line @next/next/no-img-element -- Normalized public WordPress avatar. */}\n   {profile.avatar?<img src={profile.avatar.url} alt=\"آواتار حرفه‌ای ذخیره‌شده\" className=\"h-16 w-16 shrink-0 rounded-2xl object-cover sm:h-20 sm:w-20\" />:<span className=\"flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl bg-elev text-muted sm:h-20 sm:w-20\"><ImageIcon size={26} aria-hidden=\"true\" /><span className=\"sr-only\">آواتاری ثبت نشده است.</span></span>}\n   <div className=\"min-w-0 space-y-2\"><h3 className=\"break-words text-lg font-bold\">{profile.title||'عنوان حرفه‌ای ثبت نشده است'}</h3><p className=\"inline-flex rounded-xl border border-line bg-elev px-3 py-1 text-sm font-medium\">وضعیت: {statusLabel[profile.status]}</p><p className=\"text-sm leading-7 text-muted\">تایید هویت: {profile.verified===undefined?'اطلاعات قابل نمایش نیست':profile.verified?'تاییدشده؛ فقط خواندنی':'تایید نشده؛ فقط خواندنی'}</p></div>\n  </div>\n  <div className=\"space-y-4 border-t border-line pt-4\"><h3 className=\"text-sm font-bold\">موارد لازم برای درخواست بررسی</h3><ul className=\"grid gap-3 sm:grid-cols-3\">{savedProfileChecklist(profile).map(item=><li key={item.label} className=\"flex items-center gap-2 text-sm\">{item.complete?<Check size={18} className=\"shrink-0 text-accent\" aria-hidden=\"true\" />:<Minus size={18} className=\"shrink-0 text-muted\" aria-hidden=\"true\" />}<span>{item.label}<span className=\"mt-1 block text-xs text-muted\">{item.complete?'ذخیره شده':'ثبت نشده'}</span></span></li>)}</ul><p className=\"text-sm leading-7 text-muted\">تصاویر اختیاری: آواتار {profile.avatar?'ثبت شده':'ثبت نشده'}؛ نمونه کار {profile.gallery.length>0?'ثبت شده':'ثبت نشده'}. این موارد نشان تایید یا تضمین انتشار نیستند.</p></div>\n  <div className=\"space-y-2 border-t border-line pt-4\"><Link href={`/specialists/${encodeURIComponent(profile.slug)}`} className={workspaceLink}>نشانی عمومی ثابت پروفایل</Link><p className=\"text-xs leading-7 text-muted\">نشانی تا زمان انتشار ممکن است عمومی قابل مشاهده نباشد.</p></div>\n </WorkspacePanel>;\n}\nexport function ProfileReviewPanel({status,disabled,onSubmit}:{status:ProfileStatus;disabled:boolean;onSubmit:()=>void}) {\n const action=reviewPresentation(status,disabled);\n return <WorkspacePanel title=\"ارسال نسخه ذخیره‌شده برای بررسی\" description=\"ابتدا تغییرات فرم را ذخیره کنید؛ این دکمه فقط نسخه ذخیره‌شده را می‌فرستد. ذخیره، انتشار نیست. تغییر پروفایل منتشرشده ممکن است آن را به انتظار بررسی برگرداند. ارسال برای بررسی نیز به معنی انتشار یا تایید نیست.\">\n  {status==='pending'&&<p className=\"text-sm leading-7 text-muted\">پروفایل در انتظار بررسی است؛ ارسال دوباره در این وضعیت غیرفعال است.</p>}\n  <Button type=\"button\" variant=\"outline\" disabled={action.disabled} onClick={onSubmit}>{action.label}</Button>\n </WorkspacePanel>;\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/components/sections/auth/LoginForm.tsx": {
      "sha256": "c4a8b174b122f26e9157f3ca9603a56ee7c9ed9cba23d1d63d7d45e62417874c",
      "text": "\"use client\";\n\nimport { useEffect, useRef, useState } from \"react\";\nimport { useRouter } from \"next/navigation\";\nimport { useGSAP } from \"@gsap/react\";\nimport gsap from \"gsap\";\nimport { ArrowLeft, HardHat, Smartphone, UserRound } from \"lucide-react\";\nimport { Button } from \"@/components/ui/Button\";\nimport { LogoMark } from \"@/components/brand/Logo\";\nimport { cn, faNum } from \"@/lib/utils\";\nimport { buildOtpRequest, parseAuthChallenge, mapAuthError } from \"@/lib/auth-ui\";\nimport type { RegistrationRole } from \"@/lib/contracts/auth\";\nimport { useAuthFlow } from \"./AuthFlowContext\";\nimport {createActionGate} from \"@/lib/owner-client\";\n\nconst ROLES: Array<{ id: RegistrationRole; title: string; text: string; icon: typeof UserRound }> = [\n  { id: \"client\", title: \"کارفرما هستم\", text: \"پروژه دارم و دنبال متخصص مطمئن می‌گردم\", icon: UserRound },\n  { id: \"specialist\", title: \"متخصص ساختمانی هستم\", text: \"مهارت دارم و دنبال پروژه و مشتری جدیدم\", icon: HardHat },\n];\n\nfunction asDigits(value: string): string {\n  return value.replace(/[۰-۹]/gu, (digit) => String(\"۰۱۲۳۴۵۶۷۸۹\".indexOf(digit)));\n}\n\nexport function LoginForm() {\n  const [phone, setPhone] = useState(\"\");\n  const [role, setRole] = useState<RegistrationRole>(\"client\");\n  const [pending, setPending] = useState(false);\n  const [error, setError] = useState(\"\");\n  const [challengeNotice, setChallengeNotice] = useState<{ codeLength: 5 | 6; isSimulated: boolean } | null>(null);\n  const router = useRouter();\n  const rootRef = useRef<HTMLDivElement>(null);\n  const { setFlow } = useAuthFlow();\n  const gate=useRef(createActionGate());\n  useEffect(()=>{const g=gate.current;return ()=>g.cancel();},[]);\n\n  useGSAP(() => {\n    if(window.matchMedia(\"(prefers-reduced-motion: reduce)\").matches){gsap.set(\".auth-logo,.auth-el\",{autoAlpha:1});return;}\n    gsap\n      .timeline({ defaults: { ease: \"power3.out\" } })\n      .fromTo(\".auth-logo\", { scale: 0.5, autoAlpha: 0, rotate: -20 }, { scale: 1, autoAlpha: 1, rotate: 0, duration: 0.9, ease: \"elastic.out(1, 0.5)\" })\n      .fromTo(\".auth-el\", { y: 28, autoAlpha: 0 }, { y: 0, autoAlpha: 1, duration: 0.6, stagger: 0.09 }, \"-=0.4\");\n  }, { scope: rootRef });\n\n  const valid = /^09\\d{9}$/.test(asDigits(phone));\n  const requestCode = async () => {\n    if (!valid || pending) return;\n    const action=gate.current.begin();if(!action)return;\n    setPending(true);\n    setError(\"\");\n    try {\n      const response = await fetch(\"/api/auth/request\", {\n        method: \"POST\",\n        credentials: \"same-origin\",\n        headers: { \"Content-Type\": \"application/json\", \"Sec-Fetch-Site\": \"same-origin\" },\n        body: JSON.stringify(buildOtpRequest(phone, role)),\n      });\n      const body = await response.json().catch(() => null) as { challenge?: unknown; error?: { code?: unknown } } | null;\n      if(!action.current())return;\n      if (!response.ok || !body?.challenge) {\n        setError(mapAuthError(response.status, body?.error?.code));\n        return;\n      }\n      const challenge = parseAuthChallenge(body.challenge);\n      setFlow(phone, role);\n      setChallengeNotice({ codeLength: challenge.codeLength, isSimulated: challenge.isSimulated });\n      router.push(\"/auth/verify\");\n    } catch {\n      if(action.current())setError(mapAuthError(503, \"auth_unavailable\"));\n    } finally {\n      if(action.current())setPending(false);\n      action.finish();\n    }\n  };\n\n  return (\n    <div ref={rootRef} className=\"mx-auto flex min-h-[70dvh] w-full max-w-sm flex-col justify-center px-6 py-10\">\n      <LogoMark className=\"auth-logo mx-auto mb-7 h-16 w-16 text-primary opacity-0\" />\n      <h1 className=\"auth-el text-center text-2xl font-bold opacity-0\">ورود به <span className=\"text-gold\">کاربان</span></h1>\n      <p className=\"auth-el mt-2.5 text-center text-sm leading-relaxed text-muted opacity-0\">شماره موبایلت را وارد کن؛ کد تایید برایت ارسال می‌شود</p>\n\n      <div className=\"auth-el mt-7 grid gap-2 opacity-0\" role=\"radiogroup\" aria-label=\"نقش حساب\">\n        {ROLES.map(({ id, title, text, icon: Icon }) => (\n          <button\n            key={id}\n            type=\"button\"\n            disabled={pending}\n            role=\"radio\"\n            aria-checked={role === id}\n            onClick={() => setRole(id)}\n            className={cn(\"flex items-center gap-3 rounded-2xl border p-3 text-right transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary\", role === id ? \"border-primary/70 bg-primary/10\" : \"border-line bg-elev hover:border-primary/40\")}\n          >\n            <span className={cn(\"flex h-10 w-10 shrink-0 items-center justify-center rounded-xl\", role === id ? \"bg-primary text-primary-fg\" : \"bg-wash text-muted\")}><Icon className=\"h-5 w-5\" /></span>\n            <span><span className=\"block text-sm font-bold text-fg\">{title}</span><span className=\"mt-0.5 block text-xs text-muted\">{text}</span></span>\n          </button>\n        ))}\n      </div>\n\n      <form className=\"auth-el mt-5 opacity-0\" onSubmit={(event) => { event.preventDefault(); void requestCode(); }}>\n        <div className=\"group relative\">\n          <Smartphone className=\"pointer-events-none absolute right-4 top-1/2 h-5 w-5 -translate-y-1/2 text-muted transition-colors group-focus-within:text-primary\" />\n          <input disabled={pending} type=\"tel\" inputMode=\"tel\" dir=\"ltr\" autoFocus maxLength={11} value={phone} onChange={(event) => { setPhone(event.target.value.replace(/[^0-9۰-۹]/gu, \"\")); setError(\"\"); }} placeholder=\"09xx xxx xxxx\" aria-label=\"شماره موبایل\" className=\"h-14 w-full rounded-2xl border border-line bg-elev pl-4 pr-12 text-center text-lg tracking-[0.15em] text-fg placeholder:text-faint placeholder:tracking-normal focus:border-primary/70 focus:shadow-[0_0_0_4px_var(--glow-soft)] focus:outline-none\" />\n        </div>\n        <Button type=\"submit\" size=\"lg\" disabled={!valid || pending} className=\"mt-5 w-full gap-2\">\n          {pending ? <><span className=\"h-4 w-4 animate-spin rounded-full border-2 border-primary-fg/40 border-t-primary-fg\" /> در حال ارسال...</> : <>دریافت کد تایید <ArrowLeft className=\"h-4.5 w-4.5\" /></>}\n        </Button>\n      </form>\n      {error && <p role=\"alert\" className=\"mt-3 text-center text-xs text-alert\">{error}</p>}\n      {challengeNotice && <p className=\"mt-3 text-center text-xs text-muted\">کد {faNum(challengeNotice.codeLength)} رقمی آماده شد{challengeNotice.isSimulated ? \" (حالت شبیه‌سازی)\" : \"\"}</p>}\n      <p className=\"auth-el mt-6 text-center text-xs leading-relaxed text-faint opacity-0\">با ورود، <button type=\"button\" className=\"text-primary hover:text-accent\">قوانین کاربان</button> را می‌پذیری.</p>\n    </div>\n  );\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/components/sections/auth/OtpForm.tsx": {
      "sha256": "3694726293b87d2bc18f3d862f2c117ed5f62d7486847c4debdf5bb056742a4f",
      "text": "\"use client\";\n\nimport { useCallback, useEffect, useRef, useState } from \"react\";\nimport { useRouter } from \"next/navigation\";\nimport { useGSAP } from \"@gsap/react\";\nimport gsap from \"gsap\";\nimport { PencilLine } from \"lucide-react\";\nimport { Button } from \"@/components/ui/Button\";\nimport { cn, faNum } from \"@/lib/utils\";\nimport { buildOtpRequest, canResendCode, readVerificationChallenge, mapAuthError, otpSlots, parseAuthChallenge, parseAuthResult, type AuthChallengePresentation } from \"@/lib/auth-ui\";\nimport { useAuthSummary } from '@/components/layout/useAuthSummary';\nimport { createActionGate } from '@/lib/owner-client';\nimport { useAuthFlow } from \"./AuthFlowContext\";\n\nconst RING_R = 26;\nconst RING_C = 2 * Math.PI * RING_R;\n\ntype ApiBody = { challenge?: unknown; error?: { code?: unknown } };\n\nfunction asDigit(value: string): string {\n  return value.replace(/[^0-9۰-۹]/gu, \"\").slice(-1);\n}\n\nfunction secondsUntil(deadline: number): number {\n  return Math.max(0, Math.ceil((deadline - Date.now()) / 1000));\n}\n\nfunction safeChallengeError(cause: unknown): string {\n  return mapAuthError(503, cause instanceof Error ? cause.message : \"auth_unavailable\");\n}\n\nexport function OtpForm() {\n  const { phone, role, clearFlow } = useAuthFlow();\n  const [challenge, setChallenge] = useState<AuthChallengePresentation | null>(null);\n  const [digits, setDigits] = useState<string[]>([]);\n  const [seconds, setSeconds] = useState(0);\n  const [durationSeconds, setDurationSeconds] = useState(60);\n  const [pending, setPending] = useState(true);\n  const [status, setStatus] = useState<\"idle\" | \"error\" | \"success\">(\"idle\");\n  const [error, setError] = useState(\"\");\n  const inputsRef = useRef<(HTMLInputElement | null)[]>([]);\n  const rootRef = useRef<HTMLDivElement>(null);\n  const router = useRouter();\n  const {refresh: refreshSummary} = useAuthSummary();\n  const actionGate = useRef(createActionGate());\n  useEffect(()=>{ const gate=actionGate.current; return ()=>gate.cancel(); },[]);\n  const { contextSafe } = useGSAP({ scope: rootRef });\n\n  useGSAP(() => {\n    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) { gsap.set('.otp-box, .otp-el',{autoAlpha:1}); return; }\n    gsap.fromTo(\".otp-box\", { y: 30, autoAlpha: 0, scale: 0.8 }, { y: 0, autoAlpha: 1, scale: 1, duration: 0.6, stagger: 0.07, ease: \"back.out(1.8)\" });\n    gsap.fromTo(\".otp-el\", { y: 20, autoAlpha: 0 }, { y: 0, autoAlpha: 1, duration: 0.55, stagger: 0.09, ease: \"power3.out\" });\n  }, { scope: rootRef, dependencies: [challenge?.codeLength] });\n\n  const applyChallenge = useCallback((next: AuthChallengePresentation) => {\n    setChallenge(next);\n    setDigits(Array(next.codeLength).fill(\"\"));\n    const remaining = secondsUntil(next.expiresAt);\n    setDurationSeconds(Math.max(1, remaining));\n    setSeconds(remaining);\n    setStatus(\"idle\");\n    setError(\"\");\n    inputsRef.current = [];\n  }, []);\n\n  useEffect(() => {\n    const controller = new AbortController();\n    setPending(true);\n    readVerificationChallenge(fetch,controller.signal)\n      .then(next=>{if(!controller.signal.aborted) applyChallenge(next);})\n      .catch((cause: unknown) => {\n        if(controller.signal.aborted) return;\n        setError(cause instanceof Error ? cause.message : mapAuthError(503,'auth_unavailable'));\n      })\n      .finally(() => {if(!controller.signal.aborted)setPending(false);});\n    return () => controller.abort();\n  }, [applyChallenge]);\n\n  useEffect(() => {\n    if (!challenge) return;\n    const tick = () => setSeconds(secondsUntil(challenge.expiresAt));\n    tick();\n    const timer = window.setInterval(tick, 1000);\n    return () => window.clearInterval(timer);\n  }, [challenge]);\n\n  const shake = contextSafe(() => {\n    if(window.matchMedia('(prefers-reduced-motion: reduce)').matches)return;\n    gsap.fromTo(\".otp-row\", { x: 0 }, { x: 10, duration: 0.07, repeat: 5, yoyo: true, ease: \"power2.inOut\", onComplete: () => gsap.set(\".otp-row\", { x: 0 }) });\n  });\n\n  const verify = async (code: string) => {\n    if (!challenge || pending || code.length !== challenge.codeLength) return;\n    const action=actionGate.current.begin();if(!action)return;\n    setPending(true);\n    setError(\"\");\n    setStatus(\"idle\");\n    try {\n      const response = await fetch(\"/api/auth/verify\", {\n        method: \"POST\",\n        credentials: \"same-origin\",\n        headers: { \"Content-Type\": \"application/json\", \"Sec-Fetch-Site\": \"same-origin\" },\n        body: JSON.stringify({ code }),\n      });\n      const body = await response.json().catch(() => null) as Record<string, unknown> | null;\n      if(!action.current())return;\n      if (!response.ok) {\n        const apiError = body?.error as { code?: unknown } | undefined;\n        setStatus(\"error\");\n        setError(mapAuthError(response.status, apiError?.code));\n        shake();\n        return;\n      }\n      const result = parseAuthResult(body);\n      await refreshSummary();\n      if(!action.current())return;\n      setStatus(\"success\");\n      clearFlow();\n      router.replace(result.onboardingTo??result.redirectTo);\n      router.refresh();\n    } catch (cause: unknown) {\n      if(!action.current())return;\n      setStatus(\"error\");\n      setError(cause instanceof Error && cause.message === \"invalid_auth_result\" ? \"پاسخ ورود معتبر نیست.\" : mapAuthError(503, \"auth_unavailable\"));\n      shake();\n    } finally {\n      if(action.current())setPending(false);\n      action.finish();\n    }\n  };\n\n  const setDigit = (index: number, value: string) => {\n    if (!challenge || pending) return;\n    const next = [...digits];\n    next[index] = asDigit(value);\n    setDigits(next);\n    setStatus(\"idle\");\n    setError(\"\");\n    if (next[index] && index < next.length - 1) inputsRef.current[index + 1]?.focus();\n    const code = next.join(\"\");\n    if (code.length === challenge.codeLength) void verify(code);\n  };\n\n  const onPaste = (event: React.ClipboardEvent) => {\n    if (!challenge || pending) return;\n    const text = event.clipboardData.getData(\"text\").replace(/[^0-9۰-۹]/gu, \"\").slice(0, challenge.codeLength);\n    if (!text) return;\n    event.preventDefault();\n    const next = Array(challenge.codeLength).fill(\"\");\n    text.split(\"\").forEach((digit, index) => { next[index] = digit; });\n    setDigits(next);\n    inputsRef.current[Math.min(text.length, challenge.codeLength - 1)]?.focus();\n    if (text.length === challenge.codeLength) void verify(text);\n  };\n\n  const resend = async () => {\n    if (!canResendCode(phone,pending,seconds)) return;\n    const action=actionGate.current.begin();if(!action)return;\n    setPending(true);\n    setError(\"\");\n    try {\n      const response = await fetch(\"/api/auth/request\", {\n        method: \"POST\",\n        credentials: \"same-origin\",\n        headers: { \"Content-Type\": \"application/json\", \"Sec-Fetch-Site\": \"same-origin\" },\n        body: JSON.stringify(buildOtpRequest(phone, role)),\n      });\n      const body = await response.json().catch(() => null) as ApiBody | null;\n      if(!action.current())return;\n      if (!response.ok) {setError(mapAuthError(response.status,body?.error?.code));return;}\n      if (!body?.challenge) throw new Error(\"invalid_challenge\");\n      applyChallenge(parseAuthChallenge(body.challenge));\n    } catch (cause: unknown) {\n      if(action.current())setError(safeChallengeError(cause));\n    } finally {\n      if(action.current())setPending(false);\n      action.finish();\n    }\n  };\n\n  const slots = challenge ? otpSlots(challenge.codeLength) : [];\n  const progress = challenge ? Math.min(1, seconds / durationSeconds) : 0;\n\n  return (\n    <div ref={rootRef} className=\"mx-auto flex min-h-[70dvh] w-full max-w-sm flex-col justify-center px-6 py-10 text-center\">\n      <h1 className=\"otp-el text-2xl font-bold opacity-0\">کد تایید را وارد کن</h1>\n      <p className=\"otp-el mt-2.5 text-sm text-muted opacity-0\">کد {challenge ? faNum(challenge.codeLength) : \"\"} رقمی ارسال شد <button type=\"button\" onClick={() => router.push(\"/auth/login\")} className=\"mr-1.5 inline-flex items-center gap-0.5 text-primary hover:text-accent\"><PencilLine className=\"h-3 w-3\" /> ویرایش</button></p>\n\n      <div className=\"otp-row mt-9 flex justify-center gap-2\" dir=\"ltr\" onPaste={onPaste} aria-busy={pending}>\n        {slots.map((index) => (\n          <input key={index} ref={(element) => { inputsRef.current[index] = element; }} value={digits[index] ?? \"\"} autoFocus={index === 0} inputMode=\"numeric\" maxLength={1} disabled={!challenge || pending} onChange={(event) => setDigit(index, event.target.value)} onKeyDown={(event) => { if (event.key === \"Backspace\" && !digits[index] && index > 0) inputsRef.current[index - 1]?.focus(); }} aria-label={`رقم ${faNum(index + 1)}`} className={cn(\"otp-box h-14 w-11 rounded-2xl border bg-elev text-center text-xl font-bold text-fg opacity-0 transition-colors duration-300 focus:outline-none sm:w-12\", status === \"error\" ? \"border-alert/80\" : status === \"success\" ? \"border-success\" : \"border-line focus:border-primary/80 focus:shadow-[0_0_0_4px_var(--glow-soft)]\")} />\n        ))}\n      </div>\n      {error && <p role=\"alert\" className=\"mt-3 text-xs text-alert\">{error}</p>}\n      {status === \"success\" && <p className=\"mt-3 text-xs text-success\">ورود با موفقیت انجام شد.</p>}\n      {challenge?.isSimulated && <p className=\"mt-2 text-xs text-muted\">حالت شبیه‌سازی فعال است؛ کد در پنل محلی نمایش داده نمی‌شود.</p>}\n\n      <div className=\"otp-el mt-9 flex flex-col items-center gap-3 opacity-0\">\n        <div className=\"relative h-16 w-16\"><svg viewBox=\"0 0 64 64\" className=\"h-full w-full -rotate-90\"><circle cx=\"32\" cy=\"32\" r={RING_R} fill=\"none\" stroke=\"var(--elev-3)\" strokeWidth=\"4\" /><circle cx=\"32\" cy=\"32\" r={RING_R} fill=\"none\" stroke={seconds > 10 ? \"var(--primary)\" : \"var(--color-alert)\"} strokeWidth=\"4\" strokeLinecap=\"round\" strokeDasharray={RING_C} strokeDashoffset={RING_C * (1 - progress)} className=\"transition-[stroke-dashoffset,stroke] duration-1000 ease-linear\" /></svg><span className=\"absolute inset-0 flex items-center justify-center text-sm font-bold text-fg-soft\">{faNum(seconds)}</span></div>\n        {!phone ? <p className=\"text-xs leading-6 text-muted\">برای ارسال مجدد، <a className=\"text-accent underline\" href=\"/auth/login\">شماره را دوباره وارد کنید</a>. تایید همین کد به ورود دوباره شماره نیاز ندارد.</p> : seconds > 0 ? <p className=\"text-xs text-faint\">تا دریافت مجدد کد</p> : <Button variant=\"outline\" size=\"sm\" onClick={() => void resend()} disabled={pending}>ارسال مجدد کد</Button>}\n      </div>\n    </div>\n  );\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/components/sections/auth/AuthFlowContext.tsx": {
      "sha256": "1d40630222acb25bbb440bff0946d745b2a1f8d08ba3f3da8d5babd7286c5c96",
      "text": "\"use client\";\n\nimport { createContext, useContext, useMemo, useState, type ReactNode } from \"react\";\nimport type { RegistrationRole } from \"@/lib/contracts/auth\";\n\ninterface AuthFlowValue {\n  phone: string;\n  role: RegistrationRole;\n  setFlow: (phone: string, role: RegistrationRole) => void;\n  clearFlow: () => void;\n}\n\nconst AuthFlowContext = createContext<AuthFlowValue | null>(null);\n\nexport function AuthFlowProvider({ children }: { children: ReactNode }) {\n  const [flow, setFlowState] = useState<{ phone: string; role: RegistrationRole }>({ phone: \"\", role: \"client\" });\n  const value = useMemo<AuthFlowValue>(() => ({\n    ...flow,\n    setFlow: (phone, role) => setFlowState({ phone, role }),\n    clearFlow: () => setFlowState({ phone: \"\", role: \"client\" }),\n  }), [flow]);\n  return <AuthFlowContext.Provider value={value}>{children}</AuthFlowContext.Provider>;\n}\n\nexport function useAuthFlow(): AuthFlowValue {\n  const value = useContext(AuthFlowContext);\n  if (!value) throw new Error(\"AuthFlowProvider is missing\");\n  return value;\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/components/sections/auth/RoleSelect.tsx": {
      "sha256": "3ffbd4d06bcd105af9862e6d19d652f87422785155c6439479ba542c2574649b",
      "text": "\"use client\";\n\nimport { useRef } from \"react\";\nimport { useRouter } from \"next/navigation\";\nimport { useGSAP } from \"@gsap/react\";\nimport gsap from \"gsap\";\nimport { ArrowLeft, HardHat, UserRound } from \"lucide-react\";\nimport { cn } from \"@/lib/utils\";\n\nconst ROLES = [\n  {\n    id: \"client\",\n    icon: UserRound,\n    title: \"کارفرما هستم\",\n    text: \"پروژه دارم و دنبال استادکار مطمئن می‌گردم\",\n    href: \"/dashboard\",\n    accent: \"from-azure-500/25\",\n    glow: \"56, 150, 255\",\n  },\n  {\n    id: \"pro\",\n    icon: HardHat,\n    title: \"متخصص ساختمانی هستم\",\n    text: \"مهارت دارم و دنبال پروژه و مشتری جدیدم\",\n    href: \"/pro\",\n    accent: \"from-primary/30\",\n    glow: \"245, 184, 0\",\n  },\n] as const;\n\n/**\n * Role selection — the \"aha\" moment.\n * Cards tilt in 3D toward the pointer (perspective transform driven by\n * GSAP), a golden border-glow follows the cursor, and tap fires a\n * squash-and-launch into the chosen dashboard.\n */\nexport function RoleSelect() {\n  const rootRef = useRef<HTMLDivElement>(null);\n  const router = useRouter();\n  const { contextSafe } = useGSAP({ scope: rootRef });\n\n  useGSAP(\n    () => {\n      gsap\n        .timeline({ defaults: { ease: \"power3.out\" } })\n        .fromTo(\".role-title\", { y: 30, autoAlpha: 0 }, { y: 0, autoAlpha: 1, duration: 0.7 })\n        .fromTo(\n          \".role-card\",\n          { y: 70, autoAlpha: 0, rotateX: -14 },\n          { y: 0, autoAlpha: 1, rotateX: 0, duration: 0.9, stagger: 0.14, ease: \"back.out(1.5)\" },\n          \"-=0.35\",\n        );\n    },\n    { scope: rootRef },\n  );\n\n  const tilt = contextSafe((e: React.PointerEvent<HTMLButtonElement>) => {\n    if (e.pointerType !== \"mouse\") return;\n    const card = e.currentTarget;\n    const rect = card.getBoundingClientRect();\n    const px = (e.clientX - rect.left) / rect.width;\n    const py = (e.clientY - rect.top) / rect.height;\n    gsap.to(card, {\n      rotateY: (px - 0.5) * -14,\n      rotateX: (py - 0.5) * 10,\n      duration: 0.45,\n      ease: \"power2.out\",\n      transformPerspective: 900,\n    });\n    card.style.setProperty(\"--mx\", `${px * 100}%`);\n    card.style.setProperty(\"--my\", `${py * 100}%`);\n  });\n\n  const untilt = contextSafe((e: React.PointerEvent<HTMLButtonElement>) => {\n    gsap.to(e.currentTarget, {\n      rotateX: 0,\n      rotateY: 0,\n      duration: 0.8,\n      ease: \"elastic.out(1, 0.4)\",\n    });\n  });\n\n  const choose = contextSafe((e: React.PointerEvent<HTMLButtonElement>, href: string) => {\n    const card = e.currentTarget;\n    gsap\n      .timeline({ onComplete: () => router.push(href) })\n      .to(card, { scale: 0.94, duration: 0.12, ease: \"power2.out\" })\n      .to(card, { scale: 1.04, autoAlpha: 0.9, duration: 0.28, ease: \"back.out(2)\" });\n  });\n\n  return (\n    <div\n      ref={rootRef}\n      className=\"mx-auto flex min-h-[75dvh] w-full max-w-2xl flex-col justify-center px-5 py-10\"\n      style={{ perspective: \"1000px\" }}\n    >\n      <div className=\"role-title text-center opacity-0\">\n        <h1 className=\"text-2xl font-bold sm:text-3xl\">\n          خوش آمدی! <span className=\"text-gold\">نقش تو</span> در کاربان چیست؟\n        </h1>\n        <p className=\"mt-3 text-sm text-muted\">\n          بعداً می‌توانی از تنظیمات، نقش دیگری هم اضافه کنی\n        </p>\n      </div>\n\n      <div className=\"mt-10 grid gap-4 sm:grid-cols-2 sm:gap-5\">\n        {ROLES.map(({ id, icon: Icon, title, text, href, accent, glow }) => (\n          <button\n            key={id}\n            onPointerMove={tilt}\n            onPointerLeave={untilt}\n            onPointerUp={(e) => choose(e, href)}\n            className={cn(\n              \"role-card gpu group relative overflow-hidden rounded-4xl border border-line p-7 text-right opacity-0 will-change-transform\",\n              \"bg-gradient-to-b to-card\",\n              accent,\n              \"hover:border-transparent\",\n            )}\n            style={\n              {\n                \"--mx\": \"50%\",\n                \"--my\": \"50%\",\n              } as React.CSSProperties\n            }\n          >\n            {/* cursor-following border glow */}\n            <span\n              aria-hidden\n              className=\"pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-500 group-hover:opacity-100\"\n              style={{\n                background: `radial-gradient(240px circle at var(--mx) var(--my), rgb(${glow} / 0.22), transparent 65%)`,\n              }}\n            />\n            <span\n              aria-hidden\n              className=\"pointer-events-none absolute inset-0 rounded-4xl opacity-0 transition-opacity duration-500 group-hover:opacity-100\"\n              style={{\n                padding: \"1.5px\",\n                background: `radial-gradient(200px circle at var(--mx) var(--my), rgb(${glow} / 0.75), transparent 70%)`,\n                WebkitMask:\n                  \"linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0)\",\n                WebkitMaskComposite: \"xor\",\n                maskComposite: \"exclude\",\n              }}\n            />\n\n            <span className=\"relative z-10 mb-14 flex h-16 w-16 items-center justify-center rounded-3xl bg-wash text-primary transition-all duration-500 group-hover:scale-110 group-hover:bg-primary group-hover:text-primary-fg group-hover:shadow-[0_14px_34px_-8px_var(--glow)] sm:mb-20\">\n              <Icon className=\"h-8 w-8\" />\n            </span>\n\n            <span className=\"relative z-10 block text-xl font-bold text-fg\">\n              {title}\n            </span>\n            <span className=\"relative z-10 mt-2 block text-sm leading-relaxed text-muted\">\n              {text}\n            </span>\n\n            <span className=\"relative z-10 mt-6 inline-flex items-center gap-1.5 text-sm font-medium text-primary\">\n              ادامه\n              <ArrowLeft className=\"h-4 w-4 transition-transform duration-300 group-hover:-translate-x-1\" />\n            </span>\n          </button>\n        ))}\n      </div>\n    </div>\n  );\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/components/layout/useAuthSummary.tsx": {
      "sha256": "29d6134e05edd3fd4c639bdd182ce399f6bdfc32d895b0d34be7e2283876696c",
      "text": "\"use client\";\n\nimport { createContext, useContext, useEffect, useRef, useSyncExternalStore, type ReactNode } from \"react\";\nimport { parseAccountSummary } from \"@/lib/auth-ui\";\nimport { createAuthSummaryStore, type AuthSummaryReader, type AuthSummaryStore } from \"./auth-summary-store\";\n\nfunction createBrowserReader(): AuthSummaryReader {\n  return {\n    async read() {\n      const response = await fetch(\"/api/auth/me\", { credentials: \"same-origin\", cache: \"no-store\" });\n      if (response.status === 401) return null;\n      if (!response.ok) throw new Error(\"account_unavailable\");\n      return parseAccountSummary(await response.json());\n    },\n    async logout() {\n      const response = await fetch(\"/api/auth/logout\", {\n        method: \"POST\",\n        credentials: \"same-origin\",\n        headers: { \"Content-Type\": \"application/json\", \"Sec-Fetch-Site\": \"same-origin\" },\n        body: \"{}\",\n      });\n      if (!response.ok) throw new Error(\"logout_failed\");\n    },\n  };\n}\n\nconst AuthSummaryContext = createContext<AuthSummaryStore | null>(null);\n\nexport function AuthSummaryProvider({ children }: { children: ReactNode }) {\n  const storeRef = useRef<AuthSummaryStore | null>(null);\n  if (!storeRef.current) storeRef.current = createAuthSummaryStore(createBrowserReader());\n  const store = storeRef.current;\n\n  useEffect(() => {\n    void store.load();\n  }, [store]);\n\n  return <AuthSummaryContext.Provider value={store}>{children}</AuthSummaryContext.Provider>;\n}\n\nexport function useAuthSummary() {\n  const store = useContext(AuthSummaryContext);\n  if (!store) throw new Error(\"AuthSummaryProvider is missing\");\n  const snapshot = useSyncExternalStore(store.subscribe, store.getSnapshot, store.getSnapshot);\n  return {\n    ...snapshot,\n    refresh: store.load,\n    clearAccount: store.clearAccount,\n    logout: store.logout,\n  };\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/components/layout/BottomNav.tsx": {
      "sha256": "d7ad905bb205dc637a7405a137d915d0f4c01a6edd2ce535e94ce1a4ed257fb6",
      "text": "\"use client\";\n\nimport { useRef } from \"react\";\nimport Link from \"next/link\";\nimport { usePathname } from \"next/navigation\";\nimport { useGSAP } from \"@gsap/react\";\nimport gsap from \"gsap\";\nimport { Home, LayoutDashboard, PlusCircle, Search, UserRound } from \"lucide-react\";\nimport { Magnetic } from \"@/components/motion/Magnetic\";\nimport { useAuthSummary } from \"./useAuthSummary\";\nimport { cn } from \"@/lib/utils\";\n\nexport function BottomNav() {\n  const ref = useRef<HTMLElement>(null);\n  const blobRef = useRef<HTMLDivElement>(null);\n  const pathname = usePathname();\n  const { account, pending } = useAuthSummary();\n  const { contextSafe } = useGSAP({ scope: ref });\n  const homeHref = account?.role === \"specialist\" ? \"/pro\" : account?.role === \"client\" ? \"/dashboard\" : \"/auth/login\";\n  const homeLabel = account ? \"داشبورد\" : \"ورود\";\n  const tabs = [\n    { href: \"/\", label: \"خانه\", icon: Home },\n    { href: \"/search\", label: \"جستجو\", icon: Search },\n    { href: homeHref, label: account ? \"داشبورد\" : \"ورود امن\", icon: PlusCircle, fab: true },\n    { href: account?.role === \"specialist\" ? \"/pro/profile\" : \"/search\", label: account?.role === \"specialist\" ? \"پروفایل حرفه‌ای\" : \"متخصصان\", icon: LayoutDashboard },\n    { href: account ? '/account' : '/auth/login', label: account ? 'حساب شخصی' : homeLabel, icon: UserRound, key: \"dash\" },\n  ] as const;\n  const activeIndex = tabs.findIndex((tab, index) => !(\"fab\" in tab && tab.fab) && tab.href === pathname && !(index === 4 && pathname === \"/\"));\n\n  const moveBlob = contextSafe((target: HTMLElement) => {\n    const blob = blobRef.current;\n    const nav = ref.current;\n    if (!blob || !nav) return;\n    const navRect = nav.getBoundingClientRect();\n    const rect = target.getBoundingClientRect();\n    gsap.timeline().to(blob, { left: rect.left - navRect.left + rect.width / 2, scaleX: 1.9, scaleY: 0.65, duration: 0.32, ease: \"power2.in\" }).to(blob, { scaleX: 1, scaleY: 1, duration: 0.55, ease: \"elastic.out(1.1, 0.5)\" });\n  });\n\n  useGSAP(() => {\n    const nav = ref.current;\n    const blob = blobRef.current;\n    if (!nav || !blob) return;\n    const links = nav.querySelectorAll<HTMLElement>(\"[data-tab]\");\n    const active = links[activeIndex >= 0 ? activeIndex : 0];\n    if (!active) return;\n    const navRect = nav.getBoundingClientRect();\n    const rect = active.getBoundingClientRect();\n    gsap.set(blob, { left: rect.left - navRect.left + rect.width / 2, opacity: activeIndex >= 0 ? 1 : 0 });\n  }, { dependencies: [pathname, account?.role], scope: ref });\n\n  return (\n    <nav ref={ref} aria-label=\"ناوبری اصلی\" aria-busy={pending} className=\"glass fixed inset-x-3 bottom-3 z-50 mx-auto flex h-(--bottom-nav-h) max-w-md items-center justify-around rounded-3xl px-2 pb-[env(safe-area-inset-bottom)] shadow-[0_18px_50px_-12px_var(--shade-strong)] md:hidden\">\n      <div ref={blobRef} aria-hidden className=\"gpu absolute top-1.5 h-1.5 w-9 -translate-x-1/2 rounded-full bg-primary opacity-0 shadow-[0_0_14px_2px_var(--glow)]\" style={{ left: \"50%\" }} />\n      {tabs.map((tab, index) => {\n        const Icon = tab.icon;\n        const isFab = \"fab\" in tab && tab.fab;\n        const active = index === activeIndex;\n        if (isFab) return <Magnetic key={`fab-${index}`} strength={0.4}><Link href={tab.href} aria-label={tab.label} className=\"pulse-cta -mt-7 flex h-14 w-14 items-center justify-center rounded-2xl bg-primary text-primary-fg shadow-[0_10px_28px_-6px_var(--glow)]\" style={{ animation: \"pulse-ring 2.5s cubic-bezier(0.4,0,0.6,1) infinite\" }}><PlusCircle className=\"h-7 w-7\" /></Link></Magnetic>;\n        return <Link key={`${tab.href}-${index}`} href={tab.href} data-tab aria-current={active ? \"page\" : undefined} onClick={(event) => moveBlob(event.currentTarget)} className={cn(\"flex flex-col items-center gap-1 rounded-2xl px-3 py-1.5 text-[10px]\", active ? \"text-primary\" : \"text-muted hover:text-fg\")}><Icon className={cn(\"h-5.5 w-5.5 transition-transform duration-300\", active && \"-translate-y-0.5\")} /><span className=\"font-medium\">{tab.label}</span></Link>;\n      })}\n    </nav>\n  );\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/components/layout/AppShell.tsx": {
      "sha256": "8cab98b6a21320a71117269c9f781b2ac797e09921ea0974e73fefdcd51fd8a7",
      "text": "\"use client\";\n\nimport { type ReactNode } from \"react\";\nimport { SmoothScroll } from \"./SmoothScroll\";\nimport { Splash } from \"./Splash\";\nimport { Header } from \"./Header\";\nimport { MobileMenu } from \"./MobileMenu\";\nimport { BottomNav } from \"./BottomNav\";\nimport { InstallBanner } from \"@/components/blocks/InstallApp\";\n\n/** Client shell: smooth scroll + splash + chrome around every page. */\nexport function AppShell({ children }: { children: ReactNode }) {\n  return (\n    <SmoothScroll>\n      <Splash />\n      <Header />\n      <MobileMenu />\n      <main className=\"flex-1 pb-[calc(var(--bottom-nav-h)+2rem)] pt-(--header-h) md:pb-8\">\n        {children}\n      </main>\n      <BottomNav />\n      <InstallBanner />\n    </SmoothScroll>\n  );\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/components/layout/Splash.tsx": {
      "sha256": "e671b046a4526c56117df3b1e307a969511a80edeabb5a9158bb1a9b43efa19c",
      "text": "\"use client\";\n\nimport { useRef } from \"react\";\nimport { useGSAP } from \"@gsap/react\";\nimport gsap from \"gsap\";\nimport { LogoMark, LogoWordmark } from \"@/components/brand/Logo\";\nimport { useUIStore } from \"@/store/ui\";\n\n/**\n * Splash — brand entrance choreography:\n * 1. golden mark scales in with elastic pop + slow rotation settle\n * 2. wordmark clips in from the mark\n * 3. tagline fades, then the whole veil wipes upward revealing the app\n * Plays once per browser session (persisted in sessionStorage).\n */\nconst SPLASH_KEY = \"karban-splash-done\";\n\nexport function Splash() {\n  const rootRef = useRef<HTMLDivElement>(null);\n  const splashDone = useUIStore((s) => s.splashDone);\n  const setSplashDone = useUIStore((s) => s.setSplashDone);\n\n  useGSAP(\n    () => {\n      if (splashDone) return;\n      // already seen this session → skip instantly\n      if (sessionStorage.getItem(SPLASH_KEY)) {\n        setSplashDone(true);\n        return;\n      }\n      const tl = gsap.timeline({\n        defaults: { ease: \"power3.out\" },\n        onComplete: () => {\n          sessionStorage.setItem(SPLASH_KEY, \"1\");\n          setSplashDone(true);\n        },\n      });\n\n      tl.fromTo(\n        \".splash-mark\",\n        { scale: 0.4, autoAlpha: 0, rotate: -30 },\n        { scale: 1, autoAlpha: 1, rotate: 0, duration: 1.1, ease: \"elastic.out(1, 0.5)\" },\n      )\n        .fromTo(\n          \".splash-word\",\n          { autoAlpha: 0, x: -24, clipPath: \"inset(0 0 0 100%)\" },\n          { autoAlpha: 1, x: 0, clipPath: \"inset(0 0 0 0%)\", duration: 0.7 },\n          \"-=0.55\",\n        )\n        .fromTo(\n          \".splash-tag\",\n          { autoAlpha: 0, y: 14 },\n          { autoAlpha: 1, y: 0, duration: 0.5 },\n          \"-=0.25\",\n        )\n        .to(\".splash-glow\", { scale: 1.6, opacity: 0.35, duration: 0.8 }, \"<\")\n        .to(rootRef.current, {\n          yPercent: -100,\n          duration: 0.85,\n          delay: 0.45,\n          ease: \"power4.inOut\",\n        });\n    },\n    { scope: rootRef },\n  );\n\n  if (splashDone) return null;\n\n  return (\n    <div\n      ref={rootRef}\n      aria-hidden\n      className=\"gpu fixed inset-0 z-[100] flex flex-col items-center justify-center bg-ink-950\"\n    >\n      {/* radial brand glow */}\n      <div className=\"splash-glow pointer-events-none absolute h-72 w-72 rounded-full bg-brand-500/20 blur-[90px]\" />\n      <div className=\"relative flex items-center gap-4\">\n        <LogoMark className=\"splash-mark h-16 w-16 text-brand-500 opacity-0\" />\n        <LogoWordmark className=\"splash-word h-12 w-auto text-white opacity-0\" />\n      </div>\n      <p className=\"splash-tag mt-6 text-sm text-slate-400 opacity-0\">\n        شبکه متخصصان ساختمان ایران\n      </p>\n    </div>\n  );\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/components/layout/SmoothScroll.tsx": {
      "sha256": "e9a99d909aa0a84929a015bc88e016d0a5dd1efdb5e35cc149309b99fccbd96e",
      "text": "\"use client\";\n\nimport { useEffect, useRef, type ReactNode } from \"react\";\nimport gsap from \"gsap\";\nimport { ScrollTrigger } from \"gsap/ScrollTrigger\";\nimport Lenis from \"lenis\";\n\ngsap.registerPlugin(ScrollTrigger);\n\n/**\n * Lenis inertia scrolling wired into GSAP's ticker so that\n * ScrollTrigger and the smooth scroll share a single rAF loop.\n */\nexport function SmoothScroll({ children }: { children: ReactNode }) {\n  const lenisRef = useRef<Lenis | null>(null);\n\n  useEffect(() => {\n    const lenis = new Lenis({\n      duration: 1.15,\n      easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),\n      touchMultiplier: 1.6,\n    });\n    lenisRef.current = lenis;\n\n    lenis.on(\"scroll\", ScrollTrigger.update);\n\n    const tick = (time: number) => lenis.raf(time * 1000);\n    gsap.ticker.add(tick);\n    gsap.ticker.lagSmoothing(0);\n\n    return () => {\n      gsap.ticker.remove(tick);\n      lenis.destroy();\n      lenisRef.current = null;\n    };\n  }, []);\n\n  return <>{children}</>;\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/components/layout/Header.tsx": {
      "sha256": "8d707a9905eec11801fa86cda533092f3a630c0c6c1362a74473ef45879140e8",
      "text": "\"use client\";\n\nimport { useRef, useState } from \"react\";\nimport Link from \"next/link\";\nimport { useRouter } from \"next/navigation\";\nimport { useGSAP } from \"@gsap/react\";\nimport gsap from \"gsap\";\nimport { ScrollTrigger } from \"gsap/ScrollTrigger\";\nimport { LogOut, MapPin, User, X } from \"lucide-react\";\nimport { Logo, LogoMark } from \"@/components/brand/Logo\";\nimport { Magnetic } from \"@/components/motion/Magnetic\";\nimport { ThemeToggle } from \"@/components/ui/ThemeToggle\";\nimport { InstallButton } from \"@/components/blocks/InstallApp\";\nimport { useUIStore } from \"@/store/ui\";\nimport { useAuthSummary } from \"./useAuthSummary\";\nimport { getLogoutPresentation } from \"./auth-summary-view\";\nimport { accountLinks } from '@/lib/owner-ui';\nimport { cn } from \"@/lib/utils\";\n\ngsap.registerPlugin(ScrollTrigger);\n\nexport function Header() {\n  const ref = useRef<HTMLElement>(null);\n  const { menuOpen, setMenuOpen } = useUIStore();\n  const { account, error: accountError, logout, logoutPending, logoutError } = useAuthSummary();\n  const [accountOpen, setAccountOpen] = useState(false);\n  const router = useRouter();\n\n  useGSAP(() => {\n    const element = ref.current;\n    if (!element) return;\n    ScrollTrigger.create({ start: 80, onEnter: () => element.classList.add(\"is-shrunk\"), onLeaveBack: () => element.classList.remove(\"is-shrunk\") });\n  }, { scope: ref });\n\n  const handleLogout = async () => {\n    const destination = await logout();\n    setAccountOpen(false);\n    if (destination) router.push(destination);\n  };\n\n  const links = account ? accountLinks(account.role!) : [];\n  const logoutStatus = getLogoutPresentation({ logoutPending, logoutError });\n\n  return (\n    <header ref={ref} className={cn(\"group/header fixed inset-x-0 top-0 z-50 transition-all duration-500\", \"[&.is-shrunk]:shadow-[0_10px_40px_-12px_var(--shade)]\")}>\n      <div className={cn(\"glass mx-auto flex h-(--header-h) max-w-6xl items-center justify-between gap-3 px-4 transition-all duration-500 sm:px-6\", \"mt-0 rounded-none border-x-0 border-t-0\", \"group-[.is-shrunk]/header:mt-2.5 group-[.is-shrunk]/header:h-14 group-[.is-shrunk]/header:max-w-[calc(100%-1.25rem)] group-[.is-shrunk]/header:rounded-3xl group-[.is-shrunk]/header:border sm:group-[.is-shrunk]/header:max-w-4xl\")}>\n        <Link href=\"/\" aria-label=\"کاربان — صفحه اصلی\" className=\"shrink-0\"><Logo markClassName=\"h-9 w-9 transition-all duration-500 group-[.is-shrunk]/header:h-7 group-[.is-shrunk]/header:w-7\" wordmarkClassName=\"hidden h-6 sm:block\" /></Link>\n        <div className=\"flex items-center gap-1.5 sm:gap-2.5\">\n          <Link href=\"/search\" className=\"flex h-10 items-center gap-1.5 rounded-2xl bg-wash px-3 text-sm text-fg-soft transition-colors duration-200 hover:bg-wash-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary\"><MapPin className=\"h-4 w-4 text-primary\" /><span>جستجو بر اساس شهر</span></Link>\n          <InstallButton className=\"hidden sm:flex\" />\n          <Magnetic strength={0.3}><ThemeToggle /></Magnetic>\n          <div className=\"relative\">\n            {logoutStatus.state === \"pending\" ? (\n              <span role=\"status\" aria-busy=\"true\" aria-label=\"در حال خروج\" className=\"flex h-10 items-center gap-1.5 rounded-2xl border border-line bg-wash px-2 text-xs text-muted\"><span className=\"h-4 w-4 animate-spin rounded-full border-2 border-muted/30 border-t-primary\" />در حال خروج...</span>\n            ) : logoutStatus.state === \"error\" ? (\n              <div className=\"flex items-center gap-2 rounded-2xl border border-alert/30 bg-alert/10 px-2 py-1.5\"><span role=\"alert\" className=\"text-[11px] text-alert\">خروج انجام نشد</span><Link href=\"/auth/login\" className=\"text-[11px] text-primary hover:text-accent\">ورود</Link></div>\n            ) : account ? (\n              <>\n                <Magnetic strength={0.3}><button type=\"button\" onClick={() => setAccountOpen((value) => !value)} aria-label={`حساب ${account.displayName}`} aria-expanded={accountOpen} className=\"flex h-10 max-w-32 items-center gap-1.5 rounded-2xl border border-primary/30 bg-primary/10 px-2 text-primary transition-colors hover:bg-primary/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary\"><User className=\"h-4.5 w-4.5 shrink-0\" /><span className=\"truncate text-xs font-bold\">{account.displayName}</span></button></Magnetic>\n                {accountOpen && <div className=\"absolute left-0 top-12 z-10 min-w-44 rounded-2xl border border-line bg-card p-2 text-right shadow-xl\">{links.map(link=><Link key={link.href} href={link.href} onClick={() => setAccountOpen(false)} className=\"block rounded-xl px-3 py-2 text-sm text-fg-soft hover:bg-wash\">{link.label}</Link>)}<button type=\"button\" onClick={() => void handleLogout()} disabled={logoutPending} aria-busy={logoutPending} className=\"flex w-full items-center gap-2 rounded-xl px-3 py-2 text-sm text-alert hover:bg-alert/10 disabled:cursor-wait disabled:opacity-50\"><LogOut className=\"h-4 w-4\" />{logoutPending ? \"در حال خروج...\" : \"خروج\"}</button></div>}\n              </>\n            ) : (\n              <Magnetic strength={0.3}><Link href=\"/auth/login\" aria-label={accountError ? \"ورود یا ثبت‌نام؛ حساب در دسترس نیست\" : \"ورود یا ثبت‌نام\"} className=\"flex h-10 w-10 items-center justify-center rounded-2xl border border-primary/30 bg-primary/10 text-primary transition-colors duration-200 hover:bg-primary/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary\"><User className=\"h-4.5 w-4.5\" /></Link></Magnetic>\n            )}\n          </div>\n          <Magnetic strength={0.3}><button type=\"button\" onClick={() => setMenuOpen(!menuOpen)} aria-label={menuOpen ? \"بستن منو\" : \"باز کردن منو\"} aria-expanded={menuOpen} className=\"relative flex h-10 w-10 items-center justify-center rounded-2xl bg-primary text-primary-fg shadow-[0_6px_20px_-6px_var(--glow)] transition-transform duration-200 active:scale-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2\"><LogoMark className={cn(\"absolute h-5.5 w-5.5 transition-all duration-500\", menuOpen ? \"rotate-90 scale-0 opacity-0\" : \"rotate-0 scale-100 opacity-100\")} /><span className={cn(\"absolute flex h-5 w-5 items-center justify-center transition-all duration-500\", menuOpen ? \"rotate-0 scale-100 opacity-100\" : \"-rotate-90 scale-0 opacity-0\")}><X className=\"h-5 w-5\" /></span></button></Magnetic>\n        </div>\n      </div>\n    </header>\n  );\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/components/layout/MobileMenu.tsx": {
      "sha256": "6dfbc008cc1aa7305d1a75a0854d83238a65266d6b9c2c65dadbc3abbafe683a",
      "text": "\"use client\";\n\nimport { useRef } from \"react\";\nimport Link from \"next/link\";\nimport { usePathname, useRouter } from \"next/navigation\";\nimport { useGSAP } from \"@gsap/react\";\nimport gsap from \"gsap\";\nimport { ArrowUpLeft, Home, LayoutDashboard, LogIn, LogOut, Search, UserRound } from \"lucide-react\";\nimport { LogoMark } from \"@/components/brand/Logo\";\nimport { useUIStore } from \"@/store/ui\";\nimport { useAuthSummary } from \"./useAuthSummary\";\nimport { getLogoutPresentation } from \"./auth-summary-view\";\nimport { accountLinks } from '@/lib/owner-ui';\nimport { cn, faNum } from \"@/lib/utils\";\n\nconst PUBLIC_ITEMS = [\n  { href: \"/\", label: \"خانه\", sub: \"جستجوی متخصص\", icon: Home },\n  { href: \"/search\", label: \"متخصصان\", sub: \"فهرست منتشرشده\", icon: UserRound },\n  { href: \"/search\", label: \"جستجو\", sub: \"پیدا کردن متخصص\", icon: Search },\n] as const;\n\nexport function MobileMenu() {\n  const rootRef = useRef<HTMLDivElement>(null);\n  const tlRef = useRef<gsap.core.Timeline | null>(null);\n  const { menuOpen, setMenuOpen } = useUIStore();\n  const { account, pending: accountPending, error: accountError, logout, logoutPending, logoutError } = useAuthSummary();\n  const pathname = usePathname();\n  const router = useRouter();\n\n  useGSAP(() => {\n    const items = gsap.utils.toArray<HTMLElement>(\".menu-item\");\n    const tl = gsap.timeline({ paused: true });\n    tl.set(rootRef.current, { display: \"flex\" })\n      .fromTo(\".menu-backdrop\", { opacity: 0, backdropFilter: \"blur(0px)\" }, { opacity: 1, backdropFilter: \"blur(22px)\", duration: 0.5, ease: \"power2.out\" })\n      .fromTo(\".menu-watermark\", { scale: 0.6, autoAlpha: 0, rotate: 20 }, { scale: 1, autoAlpha: 0.06, rotate: 0, duration: 1.1, ease: \"power3.out\" }, \"-=0.3\")\n      .fromTo(items, { y: 90, autoAlpha: 0, rotate: -6 }, { y: 0, autoAlpha: 1, rotate: 0, duration: 0.85, stagger: 0.075, ease: \"back.out(1.6)\" }, \"-=0.9\")\n      .fromTo(\".menu-footer\", { y: 30, autoAlpha: 0 }, { y: 0, autoAlpha: 1, duration: 0.5, ease: \"power3.out\" }, \"-=0.5\");\n    tlRef.current = tl;\n  }, { scope: rootRef, dependencies: [account?.role, accountPending] });\n\n  useGSAP(() => {\n    const tl = tlRef.current;\n    if (!tl) return;\n    if (menuOpen) {\n      document.documentElement.classList.add(\"overflow-hidden\");\n      tl.timeScale(1).play();\n    } else {\n      document.documentElement.classList.remove(\"overflow-hidden\");\n      tl.timeScale(1.8).reverse();\n    }\n  }, { dependencies: [menuOpen] });\n\n  const logoutStatus = getLogoutPresentation({ logoutPending, logoutError });\n  const items = account\n    ? [...PUBLIC_ITEMS, ...accountLinks(account.role!).map(link=>({...link,sub:'اطلاعات واقعی حساب',icon:LayoutDashboard}))]\n    : PUBLIC_ITEMS;\n\n  const handleLogout = async () => {\n    const destination = await logout();\n    if (destination) {\n      setMenuOpen(false);\n      router.push(destination);\n    }\n  };\n\n  return (\n    <div ref={rootRef} className=\"fixed inset-0 z-[60] hidden flex-col\" role=\"dialog\" aria-modal=\"true\" aria-label=\"منوی اصلی\" aria-busy={accountPending || logoutPending}>\n      <div className=\"menu-backdrop absolute inset-0 bg-(--backdrop)\" onClick={() => setMenuOpen(false)} />\n      <LogoMark className=\"menu-watermark pointer-events-none absolute -left-24 top-1/2 h-[34rem] w-[34rem] -translate-y-1/2 text-primary opacity-0\" />\n      <nav className=\"relative z-10 mx-auto flex min-h-0 w-full max-w-lg flex-1 flex-col gap-2 overflow-y-auto px-7 pb-4 pt-20\">\n        {items.map(({ href, label, sub, icon: Icon }, i) => {\n          const active = pathname === href;\n          return <Link key={`${href}-${i}`} href={href} onClick={() => setMenuOpen(false)} className={cn(\"menu-item group/item flex items-center justify-between rounded-3xl border border-transparent p-4 opacity-0 hover:border-primary/25 hover:bg-wash\", active && \"border-primary/30 bg-primary/8\")}>\n            <span className=\"flex items-center gap-4\"><span className={cn(\"flex h-12 w-12 items-center justify-center rounded-2xl transition-colors duration-300\", active ? \"bg-primary text-primary-fg\" : \"bg-wash text-primary group-hover/item:bg-primary group-hover/item:text-primary-fg\")}><Icon className=\"h-5.5 w-5.5\" /></span><span><span className=\"block text-xl font-bold text-fg\">{label}</span><span className=\"block text-xs text-muted\">{sub}</span></span></span>\n            <span className=\"flex items-center gap-2\"><span className=\"text-xs text-faint\">{faNum(`0${i + 1}`)}</span><ArrowUpLeft className=\"h-4.5 w-4.5 text-faint transition-all duration-300 group-hover/item:-translate-y-0.5 group-hover/item:translate-x-[-2px] group-hover/item:text-primary\" /></span>\n          </Link>;\n        })}\n        {!account && <Link href=\"/auth/login\" onClick={() => setMenuOpen(false)} className=\"menu-item group/item flex items-center justify-between rounded-3xl border border-transparent p-4 opacity-0 hover:border-primary/25 hover:bg-wash\"><span className=\"flex items-center gap-4\"><span className=\"flex h-12 w-12 items-center justify-center rounded-2xl bg-wash text-primary\"><LogIn className=\"h-5.5 w-5.5\" /></span><span><span className=\"block text-xl font-bold text-fg\">ورود / ثبت‌نام</span><span className=\"block text-xs text-muted\">با شماره موبایل</span></span></span><ArrowUpLeft className=\"h-4.5 w-4.5 text-faint\" /></Link>}\n      </nav>\n      <div className=\"menu-footer relative z-10 flex items-center justify-between px-8 pb-[max(1.5rem,env(safe-area-inset-bottom))] pt-4 opacity-0\">\n        <p className=\"text-xs text-faint\">کاربان © ۱۴۰۵ — ساخت ایران</p>\n        {logoutStatus.state === \"pending\" ? <span role=\"status\" aria-busy=\"true\" className=\"inline-flex items-center gap-1.5 rounded-xl px-3 py-2 text-xs text-muted\"><span className=\"h-3.5 w-3.5 animate-spin rounded-full border-2 border-muted/30 border-t-primary\" />{logoutStatus.label}</span> : logoutStatus.state === \"error\" ? <span role=\"alert\" className=\"rounded-xl bg-alert/10 px-3 py-2 text-xs text-alert\">{logoutStatus.label}</span> : account ? <button type=\"button\" onClick={() => void handleLogout()} disabled={logoutPending} aria-busy={logoutPending} className=\"inline-flex items-center gap-1.5 rounded-xl px-3 py-2 text-xs text-alert hover:bg-alert/10 disabled:cursor-wait disabled:opacity-50\"><LogOut className=\"h-3.5 w-3.5\" /> خروج</button> : <span className={cn(\"text-xs\", accountError ? \"text-alert\" : \"text-muted\")}>{accountError ? \"حساب در دسترس نیست\" : accountPending ? \"در حال بررسی حساب\" : \"ورود امن\"}</span>}\n      </div>\n    </div>\n  );\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/components/layout/Providers.tsx": {
      "sha256": "e00a3097131ed3797e5aa7863a4eb43f6606f3977b07e208f5c2f22fb60301b7",
      "text": "\"use client\";\n\nimport { type ReactNode } from \"react\";\nimport { ThemeProvider } from \"next-themes\";\nimport { AuthSummaryProvider } from \"@/components/layout/useAuthSummary\";\nimport { AuthFlowProvider } from \"@/components/sections/auth/AuthFlowContext\";\n\nexport function Providers({ children }: { children: ReactNode }) {\n  return (\n    <ThemeProvider\n      attribute=\"class\"\n      defaultTheme=\"dark\"\n      enableSystem={false}\n      disableTransitionOnChange={false}\n    >\n      <AuthSummaryProvider><AuthFlowProvider>{children}</AuthFlowProvider></AuthSummaryProvider>\n    </ThemeProvider>\n  );\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/components/brand/Logo.tsx": {
      "sha256": "441d9de4f427c29256fd3fb74b2e75035e4cee7718b837677e97e82c6370d03e",
      "text": "import { cn } from \"@/lib/utils\";\n\n/**\n * Karban brand mark — the circular monogram (from logo/SVG/logo2.svg).\n * Fill follows `currentColor` so it can be tinted via text color.\n */\nexport function LogoMark({ className }: { className?: string }) {\n  return (\n    <svg\n      viewBox=\"0 0 159.62 159.62\"\n      fill=\"currentColor\"\n      aria-hidden=\"true\"\n      className={cn(\"h-9 w-9\", className)}\n    >\n      <path d=\"M84.36,137.7h-19.64c-10.84,0-19.62-8.78-19.62-19.62V51.87c0-4.57-1.85-8.7-4.85-11.7-3-3-7.12-4.84-11.7-4.85h0s0,0,0,0c-10.29,0-19.59,6.28-23.28,15.89C1.74,60.44-.14,70.48,0,80.98c.61,42.43,34.87,77.3,77.29,78.6,22.27.68,42.55-7.78,57.42-21.88h-50.36Z\" />\n      <path d=\"M28.56,32.25h0s27.9,0,27.9,0c10.84,0,19.62,8.78,19.62,19.62v11.47l-27.9,17.43v6.47l27.18,16.98.72.45v29.94h8.28v-35.04l-25.04-15.65,13.18-8.23,48.46-30.28c1.81-1.13,3.79-1.66,5.71-1.66,2.83,0,5.52,1.12,7.52,3.03,2,1.91,3.31,4.65,3.31,7.79v34.29h-3.08v-5.02c0-2.29-.92-4.19-2.36-5.57-1.44-1.37-3.39-2.18-5.39-2.18-1.36,0-2.75.36-4.08,1.19l-25.81,16.13-23.43-14.63-8.22,5.13,65.85,41.15.57.35c2.09,1.31,3.7,3.18,4.72,5.35.33.7.62,1.43.82,2.19.17.66.27,1.35.33,2.04,13.74-14.34,22.2-33.78,22.2-55.2C159.62,35.73,123.89,0,79.81,0,53.56,0,30.27,12.68,15.72,32.25h12.84Z\" />\n    </svg>\n  );\n}\n\n/**\n * Karban wordmark — the Persian lettering (from logo/SVG/logo1.svg).\n */\nexport function LogoWordmark({ className }: { className?: string }) {\n  return (\n    <svg\n      viewBox=\"0 0 264.48 110.35\"\n      fill=\"currentColor\"\n      aria-hidden=\"true\"\n      className={cn(\"h-8 w-auto\", className)}\n    >\n      <path d=\"M163.37,52.89c0,12.66-6.52,24.44-17.27,31.16l-41.13,25.7,42.24.23h.1c10.52,0,19.06-8.52,19.06-19.06v-38.03h0v-11.62h-3v11.62Z\" />\n      <path d=\"M50.89,102.93l27.9-17.42v-53.05l-2.29,1.43-26.38,16.49-13.63-8.52-19.71,12.12,16.62,10.39,15.21-9.52v45.96l-8.07,5.04v-26.65l-.71-.44-27.19-16.99-1.78-1.11c-4.88-3.04-7.84-8.4-7.84-14.16h0v-7.76H0v37.71c0,5.9,3.04,11.39,8.04,14.52l30.91,19.31.79-.44.06-.03v.02s.34-.21.34-.21l.37-.21v-.03l10.36-6.48h0Z\" />\n      <polygon points=\"105.51 96.85 91.1 87.85 71.38 99.97 87.99 110.35 107.55 98.12 105.51 96.85\" />\n      <path d=\"M70.73,3c4.46,0,8.48,1.8,11.4,4.72,2.92,2.92,4.72,6.94,4.72,11.4v56.08l28.64,17.9.78-.43.07-.04h0s.04-.02.04-.02l.67-.37v-.05l9.62-6.01.75-.47,14.44-9.02c8.37-5.23,13.46-14.41,13.46-24.28v-18.89l-30.19-18.86v68.95l-8.07,5.04V19.12c0-10.56-8.56-19.12-19.12-19.12h-27.19s-7.13,0-7.13,0v3h7.13Z\" />\n      <path d=\"M261.26,21.48c-1.95-1.86-4.57-2.95-7.33-2.95-1.87,0-3.8.51-5.57,1.62l-47.22,29.51-12.85,8.02,24.4,15.25v34.15h-8.07v-29.18l-.71-.44-26.48-16.55v-6.31l27.19-16.99v-18.49c0-10.56-8.56-19.12-19.12-19.12h-27.19s-7.13,0-7.13,0v3h7.13c4.46,0,8.48,1.8,11.4,4.72,2.92,2.92,4.72,6.94,4.72,11.4v71.84c0,10.56,8.56,19.12,19.12,19.12h70.92v-1.5c0-1.06-.14-2.1-.4-3.11-.19-.74-.47-1.45-.8-2.13-.99-2.11-2.56-3.94-4.6-5.21l-.55-.34-64.17-40.1,8.01-5,22.83,14.26,25.15-15.72c1.29-.8,2.64-1.16,3.97-1.16,1.95,0,3.86.79,5.26,2.12,1.4,1.34,2.29,3.19,2.3,5.43v4.89h3V29.08c0-3.06-1.27-5.74-3.22-7.6Z\" />\n    </svg>\n  );\n}\n\n/** Combined lockup: mark + wordmark. */\nexport function Logo({\n  className,\n  markClassName,\n  wordmarkClassName,\n}: {\n  className?: string;\n  markClassName?: string;\n  wordmarkClassName?: string;\n}) {\n  return (\n    <span className={cn(\"inline-flex items-center gap-2.5\", className)}>\n      <LogoMark className={cn(\"text-primary\", markClassName)} />\n      <LogoWordmark className={cn(\"text-fg\", wordmarkClassName)} />\n      <span className=\"sr-only\">کاربان</span>\n    </span>\n  );\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/components/motion/TapCard.tsx": {
      "sha256": "744be5f664ce20097d2bb4348dffe41b8e15bb4d1bd55505417b1ed4fc8da959",
      "text": "\"use client\";\n\nimport { useRef, type HTMLAttributes } from \"react\";\nimport { useGSAP } from \"@gsap/react\";\nimport gsap from \"gsap\";\nimport { cn } from \"@/lib/utils\";\n\n/**\n * TapCard — wraps any card with the Karban tap feedback loop:\n * press → scale 0.97, release → elastic spring back.\n */\nexport function TapCard({\n  className,\n  children,\n  ...props\n}: HTMLAttributes<HTMLDivElement>) {\n  const ref = useRef<HTMLDivElement>(null);\n  const { contextSafe } = useGSAP({ scope: ref });\n\n  const press = contextSafe(() =>\n    gsap.to(ref.current, { scale: 0.97, duration: 0.14, ease: \"power2.out\" }),\n  );\n  const release = contextSafe(() =>\n    gsap.to(ref.current, {\n      scale: 1,\n      duration: 0.6,\n      ease: \"elastic.out(1.05, 0.4)\",\n    }),\n  );\n\n  return (\n    <div\n      ref={ref}\n      onPointerDown={press}\n      onPointerUp={release}\n      onPointerLeave={release}\n      className={cn(\"gpu select-none will-change-transform\", className)}\n      {...props}\n    >\n      {children}\n    </div>\n  );\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/components/motion/Reveal.tsx": {
      "sha256": "b4290729037d5f8d381dfedd04e5d286fde597c4d3a57459630bc5a08bc8d1c1",
      "text": "\"use client\";\n\nimport { useRef, type ReactNode } from \"react\";\nimport { useGSAP } from \"@gsap/react\";\nimport gsap from \"gsap\";\nimport { ScrollTrigger } from \"gsap/ScrollTrigger\";\nimport { cn } from \"@/lib/utils\";\n\ngsap.registerPlugin(ScrollTrigger);\n\n/**\n * Reveal — children fade + slide up as they enter the viewport.\n * `stagger` animates direct children sequentially (used for grids).\n */\nexport function Reveal({\n  children,\n  stagger = 0,\n  y = 32,\n  delay = 0,\n  once = true,\n  className,\n}: {\n  children: ReactNode;\n  stagger?: number;\n  y?: number;\n  delay?: number;\n  once?: boolean;\n  className?: string;\n}) {\n  const ref = useRef<HTMLDivElement>(null);\n\n  useGSAP(\n    () => {\n      const el = ref.current;\n      if (!el) return;\n      const targets = stagger > 0 ? Array.from(el.children) : el;\n      gsap.fromTo(\n        targets,\n        { autoAlpha: 0, y },\n        {\n          autoAlpha: 1,\n          y: 0,\n          duration: 0.9,\n          delay,\n          stagger,\n          ease: \"power3.out\",\n          clearProps: \"transform\",\n          scrollTrigger: {\n            trigger: el,\n            start: \"top 88%\",\n            once,\n          },\n        },\n      );\n    },\n    { scope: ref },\n  );\n\n  return (\n    <div ref={ref} className={cn(className)}>\n      {children}\n    </div>\n  );\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/src/components/motion/Magnetic.tsx": {
      "sha256": "d6713468929b5e22dacf05ed629a8f54c3090196563dc9c120c06b5b30250601",
      "text": "\"use client\";\n\nimport { useRef, type ReactNode } from \"react\";\nimport { useGSAP } from \"@gsap/react\";\nimport gsap from \"gsap\";\nimport { cn } from \"@/lib/utils\";\n\n/**\n * Magnetic — the element is gently pulled toward the pointer within\n * its bounds and springs back on leave. Also fires a quick tap pulse\n * on touch devices where hover doesn't exist.\n */\nexport function Magnetic({\n  children,\n  strength = 0.35,\n  className,\n}: {\n  children: ReactNode;\n  strength?: number;\n  className?: string;\n}) {\n  const ref = useRef<HTMLDivElement>(null);\n  const { contextSafe } = useGSAP({ scope: ref });\n\n  const onMove = contextSafe((e: React.PointerEvent) => {\n    if (e.pointerType !== \"mouse\") return;\n    const el = ref.current;\n    if (!el) return;\n    const rect = el.getBoundingClientRect();\n    const x = (e.clientX - rect.left - rect.width / 2) * strength;\n    const y = (e.clientY - rect.top - rect.height / 2) * strength;\n    gsap.to(el, { x, y, duration: 0.4, ease: \"power3.out\" });\n  });\n\n  const onLeave = contextSafe(() => {\n    gsap.to(ref.current, {\n      x: 0,\n      y: 0,\n      duration: 0.7,\n      ease: \"elastic.out(1, 0.35)\",\n    });\n  });\n\n  const onTap = contextSafe((e: React.PointerEvent) => {\n    if (e.pointerType === \"mouse\") return;\n    gsap\n      .timeline()\n      .to(ref.current, { scale: 0.88, duration: 0.1, ease: \"power2.out\" })\n      .to(ref.current, { scale: 1, duration: 0.5, ease: \"elastic.out(1.2, 0.4)\" });\n  });\n\n  return (\n    <div\n      ref={ref}\n      onPointerMove={onMove}\n      onPointerLeave={onLeave}\n      onPointerDown={onTap}\n      className={cn(\"gpu inline-block will-change-transform\", className)}\n    >\n      {children}\n    </div>\n  );\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/tests/wordpress/task-9a-sms.test.php": {
      "sha256": "e9986df8f92027f202ba36cf0b642a684deb200f591c64d6a6ec0c16ce4b8af1",
      "text": "<?php\n/** Task9A: real SmsService and registered AdminPanel callbacks; fake WP HTTP/options/DB only. No WP bootstrap. */\ndeclare(strict_types=1);\ndefine('ABSPATH', __DIR__ . '/');\ndefine('ARRAY_A', 'ARRAY_A');\ndefine('NAHAN_CORE_DIR', '/Applications/XAMPP/xamppfiles/htdocs/karban/wp-content/plugins/karban-core/');\nclass WP_Error {\n public function __construct(public string $code='', public string $message='', public mixed $data=null) {}\n public function get_error_code() { return $this->code; }\n public function get_error_data() { return $this->data; }\n}\nfunction is_wp_error($v) { return $v instanceof WP_Error; }\nfunction get_option($k,$d=false) { return $GLOBALS['options'][$k] ?? $d; }\nfunction register_setting($g,$k,$args=[]) { $GLOBALS['registered'][$k]=$args; }\nfunction update_option($k,$v,$autoload=null) {\n if (isset($GLOBALS['registered'][$k]['sanitize_callback'])) $v=($GLOBALS['registered'][$k]['sanitize_callback'])($v);\n if ($GLOBALS['fail_write']) return false;\n if (array_key_exists($k,$GLOBALS['options']) && $GLOBALS['options'][$k] === $v) return false;\n $GLOBALS['options'][$k]=$v; $GLOBALS['autoload'][$k]=$autoload; $GLOBALS['writes'][]=[$k,$autoload]; return true;\n}\nfunction wp_set_option_autoload($k,$v) { if ($GLOBALS['fail_autoload']) { $GLOBALS['wpdb']->last_error='synthetic-private-storage-error'; return false; } $GLOBALS['autoload'][$k]=$v; return true; }\nfunction add_settings_error($setting,$code,$message,$type='error') { $GLOBALS['settings_errors'][]=[$setting,$code,$message,$type]; }\nfunction current_user_can($cap) { return $cap==='manage_options' && $GLOBALS['admin']; }\nfunction wp_verify_nonce($nonce,$action) { return $nonce==='fixture-nonce' && $action==='nahan-settings-options'; }\nfunction wp_unslash($v) { return is_array($v) ? array_map('wp_unslash',$v) : (is_string($v) ? stripslashes($v) : $v); }\nfinal class ControlledStop extends RuntimeException {}\nfunction wp_die($message) { throw new ControlledStop('Controlled stop: '.$message); }\nfunction settings_fields($g) { echo '<input type=\"hidden\" name=\"_wpnonce\" value=\"fixture-nonce\" />'; }\nfunction submit_button() { echo '<button>Save</button>'; }\nfunction esc_html($v) { return htmlspecialchars((string)$v,ENT_QUOTES,'UTF-8'); }\nfunction esc_attr($v) { return esc_html($v); }\nfunction esc_textarea($v) { return esc_html($v); }\nfunction checked($a,$b,$echo=false) { return $a===$b?'checked=\"checked\"':''; }\nfunction wp_json_encode($v) { return json_encode($v,JSON_THROW_ON_ERROR); }\nfunction wp_remote_post($url,$args) { $GLOBALS['http'][]=[$url,$args]; return $GLOBALS['response']; }\nfunction wp_remote_retrieve_response_code($r) { return $r['response']['code']??0; }\nfunction wp_remote_retrieve_body($r) { return $r['body']??''; }\nfunction wp_generate_uuid4() { static $i=0; return 'fixture-tracking-'.++$i; }\nfunction current_time($t,$gmt=false) { return gmdate('Y-m-d H:i:s'); }\nfunction sanitize_text_field($v) { return $v; }\nfunction wp_parse_url($v) { return parse_url($v); }\nfinal class FixtureDb {\n public string $prefix='wp_'; public string $last_error=''; public int $insert_id=0; public array $rows=[]; public array $rate=[]; public array $mutations=[]; public int|false $invalidate_result=1;\n public function prepare($sql,...$args) { return [$sql,$args]; }\n public function get_col($sql,$column=0) { return ['id','delivery_mode','code_length']; }\n public function get_row($q,$mode=null) {\n  [$sql,$args]=$q;\n  if (str_contains($sql,'rate_limits')) return $this->rate[$args[0].$args[1]]??null;\n  foreach($this->rows as $row) if ($row['tracking_code']===$args[0]) return $row;\n  return null;\n }\n public function insert($table,$row,$formats=null) {\n  $row['id']=++$this->insert_id;\n  if (str_contains($table,'rate_limits')) $this->rate[$row['bucket'].$row['identifier']]=$row;\n  else { $row['consumed_at']=null; $this->rows[$row['id']]=$row; }\n  return 1;\n }\n public function update($table,$row,$where,$f=null,$wf=null) { foreach($this->rate as &$r) if ($r['id']===$where['id']) $r=array_merge($r,$row); return 1; }\n public function query($q) {\n  $this->mutations[]=$q; [$sql,$args]=$q;\n  if (str_starts_with($sql,'DELETE') && str_contains($sql,'tracking_code = %s') && str_contains($sql,'code_hash = %s') && str_contains($sql,'consumed_at IS NULL')) {\n   if ($this->invalidate_result!==1) return $this->invalidate_result;\n   foreach($this->rows as $id=>$r) if ($r['tracking_code']===$args[0] && $r['code_hash']===$args[1] && $r['consumed_at']===null) { unset($this->rows[$id]); return 1; }\n   return 0;\n  }\n  throw new RuntimeException('Unexpected mutation');\n }\n public function delete($t,$where,$format=null) { throw new RuntimeException('Must not broadly delete challenges or clear throttle'); }\n}\nrequire_once NAHAN_CORE_DIR.'includes/class-helpers.php';\nrequire_once NAHAN_CORE_DIR.'includes/class-rate-limiter.php';\nrequire_once NAHAN_CORE_DIR.'includes/admin/class-settings.php';\nrequire_once NAHAN_CORE_DIR.'includes/admin/class-admin-panel.php';\nrequire_once NAHAN_CORE_DIR.'includes/auth/class-sms-service.php';\nrequire_once NAHAN_CORE_DIR.'includes/class-local-development-gate.php';\nrequire_once NAHAN_CORE_DIR.'includes/auth/class-otp-schema.php';\nrequire_once NAHAN_CORE_DIR.'includes/auth/class-otp-manager.php';\nuse Nahan\\Core\\Admin\\Settings;\nuse Nahan\\Core\\Admin\\AdminPanel;\nuse Nahan\\Core\\Auth\\SmsService;\nuse Nahan\\Core\\Auth\\OtpManager;\nuse Nahan\\Core\\LocalDevelopmentGate;\nfunction expect($b,$why) { if (!$b) throw new RuntimeException($why); }\nfunction same($want,$got,$why) { expect($want===$got,$why); }\nfunction error_safe($r,$code=null) {\n expect($r instanceof WP_Error,'Must fail closed'); if ($code!==null) same($code,$r->code,'Safe error code');\n foreach(['fixture-key','private-transport','private-provider','09121234567','+989121234567','54321'] as $private) expect(!str_contains(json_encode($r),$private),'Error must not expose sensitive data');\n}\nfunction reset_fixture() {\n $GLOBALS['options']=['nahan_sms_driver'=>'faraz_ippanel','nahan_sms_faraz_apikey'=>'fixture-key','nahan_sms_faraz_pattern_code'=>'fixture-pattern','nahan_sms_faraz_originator'=>'+983000505','nahan_sms_faraz_variable'=>'login_code'];\n $GLOBALS['http']=[]; $GLOBALS['registered']=[]; $GLOBALS['writes']=[]; $GLOBALS['autoload']=[]; $GLOBALS['settings_errors']=[];\n $GLOBALS['fail_write']=false; $GLOBALS['fail_autoload']=false; $GLOBALS['admin']=true; $GLOBALS['wpdb']=new FixtureDb();\n $GLOBALS['response']=['response'=>['code'=>200],'body'=>'{\"data\":{\"message_outbox_ids\":[12345]},\"meta\":{\"status\":true}}'];\n $_POST=['_wpnonce'=>'fixture-nonce','option_page'=>'nahan-settings']; $_SERVER=[];\n return new SmsService(new Settings());\n}\nfunction panel() { $p=new AdminPanel(new Settings()); $p->register_settings(); return $p; }\nfunction save($key,$value) { expect(isset($GLOBALS['registered']['nahan_'.$key]['sanitize_callback']),'Actual registered sanitizer required'); update_option('nahan_'.$key,$value); return get_option('nahan_'.$key); }\n$tests=[];\n$tests['fixed Edge HTTP contract and dynamic OTP parameter']=function() {\n $s=reset_fixture(); same(true,$s->send_otp('۰۹۱۲۱۲۳۴۵۶۷','54321'),'Documented acceptance'); same(1,count($GLOBALS['http']),'One transport only');\n [$url,$args]=$GLOBALS['http'][0]; same('https://edge.ippanel.com/v1/api/send',$url,'Fixed HTTPS endpoint'); same('fixture-key',$args['headers']['Authorization'],'Raw key without Bearer');\n same('application/json',$args['headers']['Content-Type'],'JSON content'); same('application/json',$args['headers']['Accept'],'JSON accept'); same(0,$args['redirection'],'Never follow redirects'); expect($args['timeout']>0 && $args['timeout']<=10,'Bounded timeout'); expect(($args['limit_response_size']??PHP_INT_MAX)<=16384,'Bound HTTP response');\n same(['sending_type'=>'pattern','from_number'=>'+983000505','code'=>'fixture-pattern','recipients'=>['+989121234567'],'params'=>['login_code'=>'54321']],json_decode($args['body'],true),'Exact typed provider payload');\n};\n$tests['invalid configuration and inputs never call HTTP or log success']=function() {\n $cases=[['sms_faraz_apikey',''],['sms_faraz_apikey',\"key\\r\\nInjected: x\"],['sms_faraz_apikey','has space'],['sms_faraz_apikey',str_repeat('x',513)],['sms_faraz_pattern_code',''],['sms_faraz_pattern_code',\"a\\nb\"],['sms_faraz_pattern_code',str_repeat('p',129)],['sms_faraz_originator','3000505'],['sms_faraz_originator','+0123456'],['sms_faraz_variable','x.y'],['sms_faraz_variable',''],['sms_faraz_variable',str_repeat('a',65)],['sms_driver','log'],['sms_driver','unknown']];\n foreach($cases as [$k,$v]) { $s=reset_fixture(); $GLOBALS['options']['nahan_'.$k]=$v; error_safe($s->send_otp('09121234567','54321')); same([],$GLOBALS['http'],'Invalid setting blocks HTTP'); }\n foreach(['not-phone','09121234567,09121111111'] as $phone) { $s=reset_fixture(); error_safe($s->send_otp($phone,'54321')); same([],$GLOBALS['http'],'One valid phone only'); }\n $s=reset_fixture(); unset($GLOBALS['options']['nahan_sms_faraz_variable']); same(true,$s->send_otp('09121234567','54321'),'Variable default code'); same(['code'=>'54321'],json_decode($GLOBALS['http'][0][1]['body'],true)['params'],'Default variable');\n foreach(['log','unknown','kavenegar'] as $driver) { $s=reset_fixture(); $GLOBALS['options']['nahan_sms_driver']=$driver; error_safe($s->send_by_pattern('09121234567','',['code'=>'54321'])); same([],$GLOBALS['http'],'Missing pattern cannot fall back'); }\n};\n$tests['strict documented acceptance and safe rejection without retries']=function() {\n $bodies=['{\"meta\":{\"status\":false},\"data\":{\"message_outbox_ids\":[1]}}','{\"meta\":{\"status\":\"true\"},\"data\":{\"message_outbox_ids\":[1]}}','{\"meta\":{\"status\":true},\"data\":{\"message_outbox_ids\":[]}}','{\"meta\":{\"status\":true},\"data\":{\"message_outbox_ids\":[\"bad\"]}}','{\"meta\":{\"status\":true},\"data\":{\"message_outbox_ids\":[0]}}','{\"meta\":{\"status\":true},\"data\":{\"message_outbox_ids\":[1.5]}}','{\"meta\":{\"status\":true},\"data\":{\"message_outbox_ids\":{\"x\":1}}}','invalid-json',str_repeat('x',16385),'null','{\"meta\":{\"status\":true},\"data\":{\"message_outbox_ids\":[true]}}'];\n foreach($bodies as $body) { $s=reset_fixture(); $GLOBALS['response']['body']=$body; error_safe($s->send_otp('09121234567','54321'),'sms_provider_error'); same(1,count($GLOBALS['http']),'Never retry malformed response'); }\n foreach([301,401,422,500] as $http) { $s=reset_fixture(); $GLOBALS['response']['response']['code']=$http; error_safe($s->send_otp('09121234567','54321'),'sms_provider_error'); same(1,count($GLOBALS['http']),'No HTTP retry'); }\n $s=reset_fixture(); $GLOBALS['response']=new WP_Error('timeout','private-transport fixture-key 54321',['private-provider']); error_safe($s->send_otp('09121234567','54321'),'sms_transport_error'); same(1,count($GLOBALS['http']),'Timeout not retried');\n};\n$tests['readiness is internal boolean and text is explicitly unsupported']=function() {\n $s=reset_fixture(); expect(method_exists($s,'is_otp_configured'),'Internal readiness seam'); same(true,$s->is_otp_configured(),'Valid provider ready'); same([],$GLOBALS['http'],'Readiness never pings');\n unset($GLOBALS['options']['nahan_sms_faraz_apikey']); same(false,$s->is_otp_configured(),'Missing secret not ready'); error_safe($s->send_text('09121234567','notification'),'sms_text_unsupported'); same([],$GLOBALS['http'],'No text transport for Faraz');\n};\n$tests['registered form masks both SMS keys, escapes fields and renders nonce']=function() {\n reset_fixture(); $GLOBALS['options']['nahan_sms_kavenegar_apikey']='fixture-legacy-secret'; $GLOBALS['options']['nahan_sms_faraz_pattern_code']='\\\"><script>bad</script>'; $p=panel(); ob_start(); $p->render_settings(); $html=ob_get_clean();\n expect(!str_contains($html,'fixture-key')&&!str_contains($html,'fixture-legacy-secret'),'Never render saved SMS keys');\n foreach(['faraz','kavenegar'] as $driver) { expect((bool)preg_match('/<input[^>]*type=\"password\"[^>]*name=\"nahan_sms_'.$driver.'_apikey\"[^>]*value=\"\"[^>]*autocomplete=\"off\"/',$html),'Blank masked key field'); expect(str_contains($html,'name=\"nahan_sms_'.$driver.'_apikey_clear\"'),'Explicit separate clear intent'); }\n expect(str_contains($html,'data-configured=\"yes\"'),'Safe presence indicator'); expect(str_contains($html,'name=\"_wpnonce\"'),'Settings API nonce'); expect(!str_contains($html,'<script>bad</script>'),'Escaped field values'); same([],$GLOBALS['http'],'Render never sends');\n $GLOBALS['admin']=false; try { $p->render_settings(); throw new LogicException('Must deny'); } catch(RuntimeException $e) { expect(!$e instanceof LogicException,'Low capability render denied'); }\n};\n$tests['registered sanitizers retain blank and invalid keys; explicit clear only']=function() {\n reset_fixture(); panel(); same('fixture-key',save('sms_faraz_apikey',''),'Blank retains'); same(false,$GLOBALS['autoload']['nahan_sms_faraz_apikey'],'Retained key nonautoload');\n same('replacement-key',save('sms_faraz_apikey','replacement-key'),'Change key'); same(false,$GLOBALS['autoload']['nahan_sms_faraz_apikey'],'New key nonautoload');\n foreach([\"bad\\r\\nheader\",'spaces invalid',[],str_repeat('a',513)] as $bad) same('replacement-key',save('sms_faraz_apikey',$bad),'Invalid retains');\n $_POST['nahan_sms_faraz_apikey_clear']='1'; same('',save('sms_faraz_apikey',''),'Explicit clear'); same([],$GLOBALS['http'],'Sanitizers never send');\n reset_fixture(); panel(); unset($GLOBALS['options']['nahan_sms_faraz_apikey']); same('new-fixture-key',save('sms_faraz_apikey','new-fixture-key'),'First save'); same(false,$GLOBALS['autoload']['nahan_sms_faraz_apikey'],'First save disables autoload');\n};\n$tests['capability nonce allowlist and strict field validation']=function() {\n foreach([['admin',false],['nonce','wrong']] as [$k,$v]) { reset_fixture(); panel(); if($k==='admin') $GLOBALS['admin']=$v; else $_POST['_wpnonce']=$v; $_POST['nahan_sms_faraz_apikey_clear']='1'; foreach(['sms_faraz_apikey'=>'replacement-key','sms_driver'=>'log'] as $key=>$value) { try { save($key,$value); throw new LogicException('Must deny save'); } catch(ControlledStop $e) {} } same('fixture-key',get_option('nahan_sms_faraz_apikey'),'Unauthorized change/clear retained'); same('faraz_ippanel',get_option('nahan_sms_driver'),'Unauthorized driver retained'); same([],$GLOBALS['writes'],'No unauthorized writes'); }\n reset_fixture(); panel(); foreach(['unknown',[],\"faraz_ippanel\\n\"] as $bad) same('faraz_ippanel',save('sms_driver',$bad),'Driver strict allowlist');\n foreach(['sms_faraz_pattern_code'=>\"bad\\npattern\",'sms_faraz_originator'=>'3000','sms_faraz_variable'=>'bad.name'] as $key=>$bad) { $old=get_option('nahan_'.$key); same($old,save($key,$bad),'Invalid field retains'); }\n same('verification-code',save('sms_faraz_variable','verification-code'),'Approved variable name'); same('log',save('sms_driver','log'),'Allowlist log retained for non-OTP'); expect(count($GLOBALS['settings_errors'])>0,'Safe validation errors reported');\n};\n$tests['failed checked option writes cannot report configured success']=function() {\n foreach(['fail_write','fail_autoload'] as $failure) { reset_fixture(); panel(); $GLOBALS[$failure]=true; try { save('sms_faraz_apikey',$failure==='fail_write'?'replacement-key':''); throw new LogicException('Must stop failed persistence'); } catch(ControlledStop $e) { expect(!str_contains($e->getMessage(),'private'),'Storage failure safe'); } same('fixture-key',get_option('nahan_sms_faraz_apikey'),'Failure retains old value'); }\n};\n$tests['real manager invalidates only failed persisted challenge and retains throttle']=function() {\n $s=reset_fixture(); $db=$GLOBALS['wpdb']; $db->rows[100]=['id'=>100,'tracking_code'=>'unrelated','code_hash'=>'hash','consumed_at'=>null];\n $GLOBALS['response']=new WP_Error('timeout','private-transport');\n $gate=new LocalDevelopmentGate(['local_development'=>false,'local_dev_otp'=>false,'environment_type'=>'production','site_url'=>'https://example.test','remote_addr'=>'127.0.0.1']);\n $m=new OtpManager($s,$gate); error_safe($m->request('09121234567','192.0.2.1'),'sms_transport_error'); same([100],array_keys($db->rows),'Only failed challenge removed'); same(1,count($db->mutations),'One checked CAS invalidation'); same(1,count($GLOBALS['http']),'One request'); error_safe($m->request('09121234567','192.0.2.1'),'otp_throttled'); same(1,count($GLOBALS['http']),'Failure retains throttle');\n foreach([0,false] as $failed) { $s=reset_fixture(); $GLOBALS['response']=new WP_Error('timeout','private-transport'); $GLOBALS['wpdb']->invalidate_result=$failed; error_safe((new OtpManager($s,$gate))->request('09121234567','192.0.2.1'),'otp_storage_unavailable'); }\n $s=reset_fixture(); $result=(new OtpManager($s,$gate))->request('09121234567','192.0.2.1'); expect(is_array($result),'Accepted request gets tracking only'); same('sms',$result['delivery_mode'],'Normal provenance'); same(5,$result['code_length'],'Normal five-digit mode'); expect(!isset($result['code']),'No code returned'); $row=array_values($GLOBALS['wpdb']->rows)[0]; $body=json_decode($GLOBALS['http'][0][1]['body'],true); same(hash('sha256',$body['params']['login_code']),$row['code_hash'],'Standard hashed persisted OTP'); same(120,$result['expires_in'],'Standard TTL');\n};\n$tests['numeric variable names still encode params as a JSON object']=function() {\n $s=reset_fixture(); $GLOBALS['options']['nahan_sms_faraz_variable']='0'; same(true,$s->send_otp('09121234567','54321'),'Numeric identifier allowed'); $body=json_decode($GLOBALS['http'][0][1]['body']); expect($body->params instanceof stdClass,'Params must be object, never a JSON array'); same('54321',$body->params->{'0'},'Exact numeric variable mapping');\n};\n$tests['object-shaped IDs cannot be mistaken for a list']=function() {\n $s=reset_fixture(); $GLOBALS['response']['body']='{\"meta\":{\"status\":true},\"data\":{\"message_outbox_ids\":{\"0\":12345}}}'; error_safe($s->send_otp('09121234567','54321'),'sms_provider_error');\n};\n$tests['invalid legacy key cannot bypass boundaries']=function() {\n foreach(['',\"key\\r\\nheader\"] as $key) { $s=reset_fixture(); $GLOBALS['options']['nahan_sms_driver']='kavenegar'; $GLOBALS['options']['nahan_sms_kavenegar_pattern']='fixture-pattern'; $GLOBALS['options']['nahan_sms_kavenegar_apikey']=$key; error_safe($s->send_otp('09121234567','54321'),'sms_misconfigured'); same([],$GLOBALS['http'],'Invalid legacy credentials block HTTP too'); }\n};\n$tests['unauthorized first-time settings cannot write even defaults']=function() {\n foreach([false,true] as $cap) { reset_fixture(); panel(); $GLOBALS['options']=[]; $GLOBALS['admin']=$cap; $_POST['_wpnonce']='wrong'; try { save('sms_faraz_apikey','new-fixture-key'); } catch(ControlledStop $e) {} same([],$GLOBALS['writes'],'Unauthorized outer Settings API update must not create option'); }\n};\n$tests['OTP log driver neither logs nor reports success']=function() {\n $s=reset_fixture(); $GLOBALS['options']['nahan_sms_driver']='log'; $file=tempnam(getenv('TMPDIR'),'task9a-log-'); $before=ini_get('error_log'); ini_set('error_log',$file);\n try { error_safe($s->send_otp('09121234567','54321'),'sms_misconfigured'); error_safe($s->send_by_pattern('09121234567','fixture-pattern',['code'=>'54321']),'sms_misconfigured'); same('',file_get_contents($file),'OTP paths must not log codes or full phones'); } finally { ini_set('error_log',$before); unlink($file); }\n};\n$tests['first invalid secret save cannot create an autoloaded option']=function() {\n reset_fixture(); panel(); unset($GLOBALS['options']['nahan_sms_faraz_apikey']); same('',save('sms_faraz_apikey',\"invalid\\r\\nheader\"),'Invalid new key not saved'); same(false,$GLOBALS['autoload']['nahan_sms_faraz_apikey']??null,'Even retained empty secret option must not autoload');\n};\n$tests['all real OTP drivers reject malformed phones before HTTP']=function() {\n $s=reset_fixture(); $GLOBALS['options']['nahan_sms_driver']='kavenegar'; $GLOBALS['options']['nahan_sms_kavenegar_apikey']='fixture-legacy-key'; $GLOBALS['options']['nahan_sms_kavenegar_pattern']='fixture-pattern'; error_safe($s->send_otp('not-phone','54321'),'sms_invalid_phone'); same([],$GLOBALS['http'],'Legacy OTP must validate phone too');\n};\n$tests['legacy OTP acceptance preserved and legacy transport details redacted']=function() {\n $s=reset_fixture(); $GLOBALS['options']['nahan_sms_driver']='kavenegar'; $GLOBALS['options']['nahan_sms_kavenegar_apikey']='fixture-legacy-key'; $GLOBALS['options']['nahan_sms_kavenegar_pattern']='fixture-pattern';\n $GLOBALS['response']=['response'=>['code'=>200],'body'=>'{\"return\":{\"status\":200}}']; same(true,$s->send_otp('09121234567','54321'),'Existing accepted Kavenegar response');\n $GLOBALS['response']=['response'=>['code'=>422],'body'=>'{\"return\":{\"status\":422,\"message\":\"private-provider fixture-key 54321\"}}']; error_safe($s->send_otp('09121234567','54321'),'sms_provider_error');\n $GLOBALS['response']=new WP_Error('timeout','private-transport fixture-key 54321'); error_safe($s->send_otp('09121234567','54321'),'sms_transport_error');\n};\n// Installed options.php lines 336–345: trim the slashed scalar, then unslash,\n// then call update_option. Keep the ORIGINAL slashed POST field for the sanitizer.\nfunction settings_post_save($key,$raw,$present=true) {\n $option='nahan_'.$key; $_POST['option_page']='nahan-settings'; $_POST['action']='update';\n if ($present) $_POST[$option]=is_string($raw)?addslashes($raw):$raw; else unset($_POST[$option]);\n $value=null;\n if (isset($_POST[$option])) { $value=$_POST[$option]; if (!is_array($value)) $value=trim($value); $value=wp_unslash($value); }\n update_option($option,$value); return get_option($option);\n}\n$tests['options.php preprocessing cannot repair malformed submitted SMS keys']=function() {\n foreach(['sms_faraz_apikey','sms_kavenegar_apikey'] as $key) {\n  foreach([' replacement-key','replacement-key ',\"\\r\\nreplacement-key\\r\\n\",\"\\treplacement-key\\t\",' ',\"\\r\\n\",\"\\t\",['not-scalar']] as $raw) {\n   reset_fixture(); panel(); $GLOBALS['options']['nahan_'.$key]='prior-fixture-key'; $GLOBALS['autoload']['nahan_'.$key]=true;\n   same('prior-fixture-key',settings_post_save($key,$raw),'Malformed raw key must retain prior key despite normalized argument');\n   expect(count($GLOBALS['settings_errors'])>0,'Whitespace is invalid, not silently blank-retain or repaired-valid'); same(false,$GLOBALS['autoload']['nahan_'.$key],'Retention keeps non-autoload storage');\n   $p=new AdminPanel(new Settings()); ob_start(); $p->render_settings(); $html=ob_get_clean(); expect(str_contains($html,'data-configured=\"yes\"'),'Retained configured indicator'); expect(!str_contains($html,'prior-fixture-key'),'Retained secret never rendered'); same([],$GLOBALS['http'],'No transport during settings processing');\n  }\n }\n};\n$tests['options.php slashed exact valid blank missing and explicit clear retain semantics']=function() {\n foreach(['sms_faraz_apikey','sms_kavenegar_apikey'] as $key) {\n  reset_fixture(); panel(); $GLOBALS['options']['nahan_'.$key]='prior-fixture-key';\n  // Printable quote/backslash bytes prove correct, exactly-once unslashing.\n  $valid=\"fixture-'quoted'-\\\\\\\\key\";\n  same($valid,settings_post_save($key,$valid),'Exact valid raw key persists byte-for-byte'); same(false,$GLOBALS['autoload']['nahan_'.$key],'Exact valid key not autoloaded');\n  same($valid,settings_post_save($key,''),'Exactly empty retains'); same($valid,settings_post_save($key,null,false),'Missing field retains'); same([],$GLOBALS['settings_errors'],'True blank/missing are not malformed');\n  $_POST['nahan_'.$key.'_clear']='1'; same('',settings_post_save($key,\"\\tmalformed\\r\\n\"),'Explicit authorized clear remains deliberate'); same(false,$GLOBALS['autoload']['nahan_'.$key],'Cleared option not autoloaded'); same([],$GLOBALS['http'],'No settings transport');\n }\n};\n$tests['raw settings submission cannot bypass capability nonce or direct-call validation']=function() {\n foreach([false,true] as $admin) {\n  reset_fixture(); panel(); $GLOBALS['options']=[]; $GLOBALS['admin']=$admin; if($admin) $_POST['_wpnonce']='wrong'; $_POST['nahan_sms_faraz_apikey_clear']='1';\n  try { settings_post_save('sms_faraz_apikey','new-fixture-key'); throw new LogicException('Must reject unauthorized initial save'); } catch(ControlledStop $e) {}\n  same([],$GLOBALS['writes'],'Unauthorized initial settings POST writes nothing'); same([],$GLOBALS['options'],'Unauthorized clear cannot create option');\n }\n reset_fixture(); panel(); unset($_POST['option_page']); $_POST['nahan_sms_faraz_apikey']='unrelated-post-value';\n same('direct-valid-key',save('sms_faraz_apikey','direct-valid-key'),'Non-settings programmatic context validates its actual argument');\n same('direct-valid-key',save('sms_faraz_apikey',' direct-invalid-key '),'Programmatic malformed key remains rejected');\n};\n$failed=0; foreach($tests as $name=>$test) { try { $test(); echo \"PASS $name\\n\"; } catch(Throwable $e) { $failed++; echo \"FAIL $name: \".$e->getMessage().\"\\n\"; } } echo count($tests).' tests; '.$failed.\" failures\\n\"; exit($failed?1:0);\n"
