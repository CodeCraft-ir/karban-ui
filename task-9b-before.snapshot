    "/Users/binam/project/پرهیزکاری/karban-uiux/web/tests/wordpress/task-4b-transactional-financial.test.php": {
      "sha256": "24d6fa0591ed22d540357101530758e28433e113e879e3d60773a8a14d5c0f7e",
      "text": "<?php\n/**\n * Standalone Task 4B contract tests. They do not bootstrap WordPress or touch a database.\n * Run: php tests/wordpress/task-4b-transactional-financial.test.php\n *\n * These stubs assert the SQL/state-machine boundary only. They cannot prove MySQL locking.\n */\ndeclare( strict_types=1 );\n\nnamespace {\n\tdefine( 'ABSPATH', __DIR__ . '/' );\n\tdefine( 'ARRAY_A', 'ARRAY_A' );\n\tdefine( 'NAHAN_CORE_DIR', '/Applications/XAMPP/xamppfiles/htdocs/karban/wp-content/plugins/karban-core/' );\n\n\tfinal class WP_Error {\n\t\tpublic function __construct( public string $code = '', public string $message = '', public array $data = [] ) {}\n\t\tpublic function get_error_code(): string { return $this->code; }\n\t\tpublic function get_error_data(): array { return $this->data; }\n\t}\n\tfunction is_wp_error( mixed $value ): bool { return $value instanceof WP_Error; }\n\tfunction wp_json_encode( mixed $value ): string { return json_encode( $value, JSON_THROW_ON_ERROR ); }\n\tfunction current_time( string $type, bool $gmt = false ): string { return '2026-10-18 00:00:00'; }\n\tfunction get_option( string $key, mixed $default = false ): mixed { global $test_options; return $test_options[ $key ] ?? $default; }\n\tfunction update_option( string $key, mixed $value ): bool {\n\t\tglobal $test_options;\n\t\tif ( array_key_exists( $key, $test_options ) && $test_options[ $key ] === $value ) return false;\n\t\t$test_options[ $key ] = $value;\n\t\treturn true;\n\t}\n\tfunction wp_get_post_terms( int $post_id, string $taxonomy, array $args = [] ): array { return []; }\n\tfunction get_term_meta( int $term_id, string $key, bool $single = false ): mixed { return ''; }\n\tfunction do_action( string $hook, mixed ...$args ): void { global $actions; $actions[] = [ $hook, $args ]; }\n\tfunction get_post( int $post_id ): ?object { global $test_posts; return $test_posts[ $post_id ] ?? null; }\n\n\tfinal class TestWpdb {\n\t\tpublic string $prefix = 'wp_';\n\t\tpublic string $users = 'wp_users';\n\t\t/** @var list<string> */ public array $queries = [];\n\t\t/** @var list<array{table:string,data:array}> */ public array $inserts = [];\n\t\t/** @var list<array{query:string,args:list<mixed>}> */ public array $prepare_calls = [];\n\t\tpublic int $insert_id = 0;\n\t\tpublic string $last_error = 'synthetic database detail';\n\t\tpublic int|false $commit_result = 1;\n\t\tpublic bool $user_exists = true;\n\t\tpublic string $engine = 'InnoDB';\n\t\tpublic int $balance = 0;\n\t\tpublic ?array $lead_row = null;\n\t\tpublic ?array $subscription_row = null;\n\t\tpublic int $allowance_used = 0;\n\t\t/** @var list<array{id:int}> */ public array $allowance_rows = [];\n\t\tpublic bool $allowance_read_failed = false;\n\t\tpublic int|false $update_result = 1;\n\t\t/** @var array<string,int|false> */ public array $insert_outcomes = [];\n\t\t/** @var list<string> */ public array $columns = [ 'id', 'user_id', 'amount', 'balance_after', 'type', 'reference_type', 'reference_id', 'description', 'meta', 'created_at', 'effect_key' ];\n\t\t/** @var array<string,list<array{Key_name:string,Non_unique:int,Seq_in_index:int,Column_name:string,Sub_part:null|int}>> */ public array $index_rows = [\n\t\t\t'wp_nahan_wallet_transactions' => [\n\t\t\t\t[ 'Key_name' => 'PRIMARY', 'Non_unique' => 0, 'Seq_in_index' => 1, 'Column_name' => 'id', 'Sub_part' => null ],\n\t\t\t\t[ 'Key_name' => 'effect_key', 'Non_unique' => 0, 'Seq_in_index' => 1, 'Column_name' => 'effect_key', 'Sub_part' => null ],\n\t\t\t],\n\t\t\t'wp_nahan_leads_unlocked' => [\n\t\t\t\t[ 'Key_name' => 'PRIMARY', 'Non_unique' => 0, 'Seq_in_index' => 1, 'Column_name' => 'id', 'Sub_part' => null ],\n\t\t\t\t[ 'Key_name' => 'unlock_unique', 'Non_unique' => 0, 'Seq_in_index' => 1, 'Column_name' => 'specialist_user_id', 'Sub_part' => null ],\n\t\t\t\t[ 'Key_name' => 'unlock_unique', 'Non_unique' => 0, 'Seq_in_index' => 2, 'Column_name' => 'target_type', 'Sub_part' => null ],\n\t\t\t\t[ 'Key_name' => 'unlock_unique', 'Non_unique' => 0, 'Seq_in_index' => 3, 'Column_name' => 'target_id', 'Sub_part' => null ],\n\t\t\t],\n\t\t];\n\t\tpublic bool $migration_has_conflict = false;\n\n\t\tpublic function prepare( string $query, mixed ...$args ): string {\n\t\t\t$this->prepare_calls[] = [ 'query' => $query, 'args' => $args ];\n\t\t\treturn $query;\n\t\t}\n\t\tpublic function get_row( string $query, mixed $output = null ): ?array {\n\t\t\t$this->queries[] = $query;\n\t\t\tif ( str_contains( $query, 'SHOW TABLE STATUS' ) ) return [ 'Engine' => $this->engine ];\n\t\t\tif ( str_contains( $query, 'FROM wp_nahan_wallet_transactions' ) ) return [ 'balance_after' => $this->balance ];\n\t\t\tif ( str_contains( $query, 'FROM wp_nahan_leads_unlocked' ) ) return $this->lead_row;\n\t\t\tif ( str_contains( $query, 'FROM wp_nahan_subscriptions' ) ) return $this->subscription_row;\n\t\t\tif ( str_contains( $query, 'HAVING COUNT(*) > 1' ) ) return $this->migration_has_conflict ? [ 'effect_key' => 'duplicate' ] : null;\n\t\t\treturn null;\n\t\t}\n\t\tpublic function get_var( string $query ): mixed {\n\t\t\t$this->queries[] = $query;\n\t\t\tif ( str_contains( $query, 'FROM wp_users' ) ) return $this->user_exists ? 7 : null;\n\t\t\tif ( str_contains( $query, 'COUNT(*)' ) ) return $this->allowance_used;\n\t\t\treturn null;\n\t\t}\n\t\tpublic function get_col( string $query, mixed $column = 0 ): array {\n\t\t\t$this->queries[] = $query;\n\t\t\tif ( str_contains( $query, 'SHOW COLUMNS' ) ) return $this->columns;\n\t\t\tif ( str_contains( $query, 'SHOW INDEX' ) ) foreach ( $this->index_rows as $table => $rows ) if ( str_contains( $query, $table ) ) return array_map( static fn( array $row ): string => $row['Key_name'], $rows );\n\t\t\treturn [];\n\t\t}\n\t\tpublic function get_results( string $query, mixed $output = null ): array|false|null {\n\t\t\t$this->queries[] = $query;\n\t\t\tif ( str_contains( $query, 'SHOW INDEX' ) ) foreach ( $this->index_rows as $table => $rows ) if ( str_contains( $query, $table ) ) return $rows;\n\t\t\tif ( str_contains( $query, 'FROM wp_nahan_leads_unlocked' ) && str_contains( $query, 'FOR UPDATE' ) ) {\n\t\t\t\treturn $this->allowance_read_failed ? null : $this->allowance_rows;\n\t\t\t}\n\t\t\treturn [];\n\t\t}\n\t\tpublic function insert( string $table, array $data, ?array $format = null ): int|false {\n\t\t\t$this->inserts[] = compact( 'table', 'data' );\n\t\t\t$result = $this->insert_outcomes[ $table ] ?? 1;\n\t\t\tif ( 1 === $result ) $this->insert_id++;\n\t\t\treturn $result;\n\t\t}\n\t\tpublic function update( string $table, array $data, array $where, ?array $format = null, ?array $where_format = null ): int|false {\n\t\t\t$this->queries[] = \"UPDATE {$table}\";\n\t\t\treturn $this->update_result;\n\t\t}\n\t\tpublic function query( string $query ): int|false {\n\t\t\t$this->queries[] = $query;\n\t\t\tif ( 'COMMIT' === $query ) return $this->commit_result;\n\t\t\treturn 1;\n\t\t}\n\t\tpublic function get_charset_collate(): string { return ''; }\n\t}\n\n\tfunction reset_fixture(): TestWpdb {\n\t\tglobal $wpdb, $test_options, $test_posts, $actions;\n\t\t$test_options = [\n\t\t\t'nahan_lead_default_price' => 50000,\n\t\t\t'nahan_subscription_plans' => [ 'pro' => [ 'name' => 'Pro', 'price' => 500000, 'period' => 30, 'leads' => 2 ] ],\n\t\t];\n\t\t$test_posts = [\n\t\t\t100 => (object) [ 'ID' => 100, 'post_type' => 'nahan_project', 'post_status' => 'publish', 'post_author' => 88 ],\n\t\t\t101 => (object) [ 'ID' => 101, 'post_type' => 'nahan_specialist', 'post_status' => 'publish', 'post_author' => 89 ],\n\t\t];\n\t\t$actions = [];\n\t\t$wpdb = new TestWpdb();\n\t\treturn $wpdb;\n\t}\n\tfunction assert_true( bool $condition, string $message ): void { if ( ! $condition ) throw new \\RuntimeException( $message ); }\n\tfunction assert_same( mixed $expected, mixed $actual, string $message ): void {\n\t\tif ( $expected !== $actual ) throw new \\RuntimeException( $message . '\\nExpected: ' . var_export( $expected, true ) . '\\nActual: ' . var_export( $actual, true ) );\n\t}\n\tfunction assert_error( mixed $actual, string $code, int $status, string $message ): void {\n\t\tassert_true( $actual instanceof WP_Error, $message . ' must return WP_Error' );\n\t\tassert_same( $code, $actual->get_error_code(), $message . ' code' );\n\t\tassert_same( $status, $actual->get_error_data()['status'] ?? null, $message . ' status' );\n\t}\n\tfunction query_index( TestWpdb $wpdb, string $needle ): int {\n\t\tforeach ( $wpdb->queries as $index => $query ) if ( str_contains( $query, $needle ) ) return $index;\n\t\tthrow new \\RuntimeException( \"Missing SQL boundary: {$needle}\" );\n\t}\n}\n\nnamespace Nahan\\Core\\Payments {\n\trequire_once NAHAN_CORE_DIR . 'includes/class-helpers.php';\n\trequire_once NAHAN_CORE_DIR . 'includes/payments/class-transactional-unit-of-work.php';\n\trequire_once NAHAN_CORE_DIR . 'includes/payments/class-wallet-manager.php';\n\trequire_once NAHAN_CORE_DIR . 'includes/payments/class-subscription-manager.php';\n\trequire_once NAHAN_CORE_DIR . 'includes/payments/class-lead-manager.php';\n\trequire_once NAHAN_CORE_DIR . 'includes/payments/class-financial-schema.php';\n\n\t$tests = [];\n\t$tests['no-history wallet debit locks the existing account before a balance read and ledger insert'] = static function (): void {\n\t\t$wpdb = \\reset_fixture();\n\t\t$uow = new TransactionalUnitOfWork();\n\t\t$wallet = new WalletManager( $uow );\n\t\t$result = $wallet->debit( 7, 100, WalletManager::TX_LEAD );\n\t\tassert_error( $result, 'insufficient_funds', 402, 'Empty wallet debit' );\n\t\tassert_true( query_index( $wpdb, 'START TRANSACTION' ) < query_index( $wpdb, 'FROM wp_users' ), 'Transaction must start before the no-history account lock.' );\n\t\tassert_true( query_index( $wpdb, 'FROM wp_users' ) < query_index( $wpdb, 'FROM wp_nahan_wallet_transactions' ), 'Existing user row must lock before any ledger balance read.' );\n\t\tassert_true( str_contains( implode( \"\\n\", $wpdb->queries ), 'FOR UPDATE' ), 'Account lock must be a locking read, not a latest-ledger lock.' );\n\t\tassert_same( [], $wpdb->inserts, 'Insufficient balance must create no ledger row.' );\n\t\tassert_true( in_array( 'ROLLBACK', $wpdb->queries, true ), 'Insufficient balance must roll back the outer unit of work.' );\n\t};\n\t$tests['stale concurrent wallet loser rechecks the locked balance and makes no write'] = static function (): void {\n\t\t$wpdb = \\reset_fixture();\n\t\t$wpdb->balance = 50;\n\t\t$result = ( new WalletManager( new TransactionalUnitOfWork() ) )->debit( 7, 100, WalletManager::TX_LEAD );\n\t\tassert_error( $result, 'insufficient_funds', 402, 'Loser after account serialization' );\n\t\tassert_same( [], $wpdb->inserts, 'A loser must not create a negative ledger row.' );\n\t\tassert_true( str_contains( implode( \"\\n\", $wpdb->queries ), 'FOR UPDATE' ), 'The loser must read after acquiring a lock boundary.' );\n\t};\n\t$tests['already-unlocked lead returns its entitlement without a second debit'] = static function (): void {\n\t\t$wpdb = \\reset_fixture();\n\t\t$wpdb->balance = 90000;\n\t\t$wpdb->lead_row = [ 'id' => 44, 'expires_at' => null ];\n\t\t$uow = new TransactionalUnitOfWork();\n\t\t$lead = new LeadManager( new WalletManager( $uow ), new SubscriptionManager( new WalletManager( $uow ), $uow ), $uow );\n\t\t$result = $lead->unlock( 7, LeadManager::TARGET_PROJECT, 100 );\n\t\tassert_true( ! \\is_wp_error( $result ), 'Existing entitlement must be a safe successful idempotent result.' );\n\t\tassert_same( true, $result['already'] ?? null, 'Existing entitlement marker.' );\n\t\tassert_same( [], $wpdb->inserts, 'Duplicate lead request must not debit or insert.' );\n\t\tassert_true( query_index( $wpdb, 'FROM wp_users' ) < query_index( $wpdb, 'FROM wp_nahan_leads_unlocked' ), 'Account is locked before entitlement lookup.' );\n\t};\n\t$tests['lead wallet charge joins one outer transaction and rolls back on entitlement insert failure'] = static function (): void {\n\t\t$wpdb = \\reset_fixture();\n\t\t$wpdb->balance = 90000;\n\t\t$wpdb->insert_outcomes['wp_nahan_leads_unlocked'] = false;\n\t\t$uow = new TransactionalUnitOfWork();\n\t\t$wallet = new WalletManager( $uow );\n\t\t$lead = new LeadManager( $wallet, new SubscriptionManager( $wallet, $uow ), $uow );\n\t\t$result = $lead->unlock( 7, LeadManager::TARGET_PROJECT, 100 );\n\t\tassert_error( $result, 'financial_storage_unavailable', 503, 'Lead insert failure' );\n\t\tassert_same( 1, count( array_filter( $wpdb->queries, static fn( string $query ): bool => 'START TRANSACTION' === $query ) ), 'Nested wallet debit must not start a nested transaction.' );\n\t\tassert_same( 0, count( array_filter( $wpdb->queries, static fn( string $query ): bool => 'COMMIT' === $query ) ), 'Failed entitlement must not commit its debit.' );\n\t\tassert_true( in_array( 'ROLLBACK', $wpdb->queries, true ), 'Failed entitlement must roll back the debit.' );\n\t};\n\t$tests['commit failure returns a safe error and rolls back'] = static function (): void {\n\t\t$wpdb = \\reset_fixture();\n\t\t$wpdb->balance = 100;\n\t\t$wpdb->commit_result = false;\n\t\t$result = ( new WalletManager( new TransactionalUnitOfWork() ) )->credit( 7, 10, WalletManager::TX_DEPOSIT );\n\t\tassert_error( $result, 'financial_commit_failed', 503, 'Commit failure' );\n\t\tassert_true( in_array( 'ROLLBACK', $wpdb->queries, true ), 'Commit failure needs explicit rollback.' );\n\t\tassert_true( ! str_contains( $result->message, $wpdb->last_error ), 'Database details must not escape a safe error.' );\n\t};\n\t$tests['subscription allowance locks active subscription before reserving a zero-price lead'] = static function (): void {\n\t\t$wpdb = \\reset_fixture();\n\t\t$wpdb->subscription_row = [ 'id' => 22, 'plan_slug' => 'pro', 'starts_at' => '2026-10-01 00:00:00', 'ends_at' => '2026-11-01 00:00:00' ];\n\t\t$wpdb->allowance_rows = [ [ 'id' => 1 ] ];\n\t\t$uow = new TransactionalUnitOfWork();\n\t\t$wallet = new WalletManager( $uow );\n\t\t$lead = new LeadManager( $wallet, new SubscriptionManager( $wallet, $uow ), $uow );\n\t\t$result = $lead->unlock( 7, LeadManager::TARGET_CONTACT, 101 );\n\t\tassert_true( ! \\is_wp_error( $result ), 'Allowance unlock should succeed.' );\n\t\tassert_same( true, $result['used_subscription'] ?? null, 'Allowance result marker.' );\n\t\tassert_same( 0, $result['price'] ?? null, 'Allowance consumes no wallet balance.' );\n\t\tassert_same( 1, count( $wpdb->inserts ), 'Only entitlement is written.' );\n\t\tassert_same( 'wp_nahan_leads_unlocked', $wpdb->inserts[0]['table'], 'Allowance must write an entitlement.' );\n\t\tassert_true( str_contains( implode( \"\\n\", $wpdb->queries ), 'wp_nahan_subscriptions' ) && str_contains( implode( \"\\n\", $wpdb->queries ), 'FOR UPDATE' ), 'Active subscription is part of the lock boundary.' );\n\t};\n\t$tests['invalid target is rejected before any financial write'] = static function (): void {\n\t\t$wpdb = \\reset_fixture();\n\t\t$result = ( new LeadManager( new WalletManager( new TransactionalUnitOfWork() ), new SubscriptionManager( new WalletManager( new TransactionalUnitOfWork() ) ) ) )->unlock( 7, LeadManager::TARGET_PROJECT, 999 );\n\t\tassert_error( $result, 'invalid_target', 422, 'Missing unpublished target' );\n\t\tassert_same( [], $wpdb->inserts, 'Invalid target cannot debit.' );\n\t};\n\t$tests['non-transactional table engine is explicitly rejected before mutations'] = static function (): void {\n\t\t$wpdb = \\reset_fixture();\n\t\t$wpdb->engine = 'MyISAM';\n\t\t$result = ( new WalletManager( new TransactionalUnitOfWork() ) )->credit( 7, 10, WalletManager::TX_DEPOSIT );\n\t\tassert_error( $result, 'financial_transaction_unsupported', 503, 'Non-InnoDB engine' );\n\t\tassert_true( ! in_array( 'START TRANSACTION', $wpdb->queries, true ), 'Engine check must happen before BEGIN.' );\n\t\tassert_same( [], $wpdb->inserts, 'Unsupported engine cannot mutate money.' );\n\t};\n\t$tests['migration audits legacy duplicates and blocks a uniqueness change for review'] = static function (): void {\n\t\t$wpdb = \\reset_fixture();\n\t\t$wpdb->index_rows = [ 'wp_nahan_wallet_transactions' => [], 'wp_nahan_leads_unlocked' => [] ];\n\t\t$wpdb->migration_has_conflict = true;\n\t\t$result = ( new FinancialSchema() )->upgrade();\n\t\tassert_error( $result, 'financial_schema_conflict', 409, 'Legacy duplicate audit' );\n\t\tassert_true( ! str_contains( implode( \"\\n\", $wpdb->queries ), 'ADD UNIQUE KEY' ), 'Conflicting history must never be deduplicated or constrained automatically.' );\n\t\tassert_same( false, \\get_option( FinancialSchema::OPTION, false ), 'Conflicted schema must not record a migration version.' );\n\t};\n\t$tests['migration rejects a same-named non-unique index without recording readiness'] = static function (): void {\n\t\t$wpdb = \\reset_fixture();\n\t\t$wpdb->index_rows['wp_nahan_wallet_transactions'][1]['Non_unique'] = 1;\n\t\t$result = ( new FinancialSchema() )->upgrade();\n\t\tassert_error( $result, 'financial_schema_conflict', 409, 'Incompatible same-named index' );\n\t\tassert_true( ! str_contains( implode( \"\\n\", $wpdb->queries ), 'ADD UNIQUE KEY' ), 'An incompatible existing index must never be replaced automatically.' );\n\t\tassert_same( false, \\get_option( FinancialSchema::OPTION, false ), 'Incompatible index must not record a migration version.' );\n\t};\n\t$tests['migration is idempotent when its version is already recorded'] = static function (): void {\n\t\t\\reset_fixture();\n\t\tglobal $test_options;\n\t\t$test_options[ FinancialSchema::OPTION ] = FinancialSchema::VERSION;\n\t\tassert_same( true, ( new FinancialSchema() )->upgrade(), 'Repeated verified migration must remain successful.' );\n\t};\n\n\t$tests['allowance read failure denies the unlock and rolls back without a free entitlement'] = static function (): void {\n\t\t$wpdb = \\reset_fixture();\n\t\t$wpdb->subscription_row = [ 'id' => 22, 'plan_slug' => 'pro', 'starts_at' => '2026-10-01 00:00:00', 'ends_at' => '2026-11-01 00:00:00' ];\n\t\t$wpdb->allowance_read_failed = true;\n\t\t$uow = new TransactionalUnitOfWork();\n\t\t$wallet = new WalletManager( $uow );\n\t\t$result = ( new LeadManager( $wallet, new SubscriptionManager( $wallet, $uow ), $uow ) )->unlock( 7, LeadManager::TARGET_CONTACT, 101 );\n\t\tassert_error( $result, 'financial_storage_unavailable', 503, 'Allowance read failure' );\n\t\tassert_same( [], $wpdb->inserts, 'An unreadable allowance state must never grant an entitlement.' );\n\t\tassert_true( in_array( 'ROLLBACK', $wpdb->queries, true ), 'Allowance read failure must roll back.' );\n\t};\n\t$tests['locked allowance rows at the cap fall back to a wallet debit instead of a free lead'] = static function (): void {\n\t\t$wpdb = \\reset_fixture();\n\t\t$wpdb->balance = 90000;\n\t\t$wpdb->subscription_row = [ 'id' => 22, 'plan_slug' => 'pro', 'starts_at' => '2026-10-01 00:00:00', 'ends_at' => '2026-11-01 00:00:00' ];\n\t\t$wpdb->allowance_rows = [ [ 'id' => 1 ], [ 'id' => 2 ] ];\n\t\t$uow = new TransactionalUnitOfWork();\n\t\t$wallet = new WalletManager( $uow );\n\t\t$result = ( new LeadManager( $wallet, new SubscriptionManager( $wallet, $uow ), $uow ) )->unlock( 7, LeadManager::TARGET_CONTACT, 101 );\n\t\tassert_true( ! \\is_wp_error( $result ), 'Capped allowance must continue through the paid path.' );\n\t\tassert_same( false, $result['used_subscription'] ?? null, 'Capped allowance must not be free.' );\n\t\tassert_same( 25000, $result['price'] ?? null, 'Capped contact unlock price.' );\n\t\tassert_same( 2, count( $wpdb->inserts ), 'Capped allowance must write both debit and entitlement.' );\n\t\tassert_same( -25000, $wpdb->inserts[0]['data']['amount'] ?? null, 'Capped allowance wallet debit.' );\n\t};\n\t$tests['migration refuses to record readiness when an existing financial table is non-transactional'] = static function (): void {\n\t\t$wpdb = \\reset_fixture();\n\t\t$wpdb->engine = 'MyISAM';\n\t\t$result = ( new FinancialSchema() )->upgrade();\n\t\tassert_error( $result, 'financial_schema_engine_unsupported', 503, 'Legacy non-InnoDB schema' );\n\t\tassert_same( false, \\get_option( FinancialSchema::OPTION, false ), 'Rejected engine must not record a schema version.' );\n\t};\n\t$tests['cancellation serializes on the account lock and rolls back a failed update'] = static function (): void {\n\t\t$wpdb = \\reset_fixture();\n\t\t$wpdb->subscription_row = [ 'id' => 22, 'user_id' => 7, 'plan_slug' => 'pro', 'status' => 'active' ];\n\t\t$uow = new TransactionalUnitOfWork();\n\t\t$wallet = new WalletManager( $uow );\n\t\t$subscriptions = new SubscriptionManager( $wallet, $uow );\n\t\tassert_same( true, $subscriptions->cancel( 22, 7 ), 'Cancellation must succeed when its transition is stored.' );\n\t\tassert_true( query_index( $wpdb, 'START TRANSACTION' ) < query_index( $wpdb, 'FROM wp_users' ), 'Cancellation must start and lock the account.' );\n\t\tassert_true( query_index( $wpdb, 'FROM wp_users' ) < query_index( $wpdb, 'FROM wp_nahan_subscriptions' ), 'Cancellation must lock its subscription after the account.' );\n\t\tassert_true( in_array( 'COMMIT', $wpdb->queries, true ), 'Successful cancellation must commit before its hook.' );\n\n\t\t$wpdb = \\reset_fixture();\n\t\t$wpdb->subscription_row = [ 'id' => 22, 'user_id' => 7, 'plan_slug' => 'pro', 'status' => 'active' ];\n\t\t$wpdb->update_result = false;\n\t\t$uow = new TransactionalUnitOfWork();\n\t\t$wallet = new WalletManager( $uow );\n\t\tassert_same( false, ( new SubscriptionManager( $wallet, $uow ) )->cancel( 22, 7 ), 'Failed cancellation storage must not be reported as cancelled.' );\n\t\tassert_true( in_array( 'ROLLBACK', $wpdb->queries, true ), 'Failed cancellation update must roll back.' );\n\t\tassert_same( [], $GLOBALS['actions'], 'Failed cancellation must not fire its hook.' );\n\t};\n\t$tests['ignored nested financial error poisons the outer transaction and prevents commit'] = static function (): void {\n\t\t$wpdb = \\reset_fixture();\n\t\t$uow = new TransactionalUnitOfWork();\n\t\t$result = $uow->run_for_user( 7, [ 'wp_nahan_wallet_transactions' ], static function () use ( $uow ) {\n\t\t\t$uow->run_for_user( 7, [ 'wp_nahan_wallet_transactions' ], static fn() => new \\WP_Error( 'inner_failure', 'inner failure', [ 'status' => 503 ] ) );\n\t\t\treturn [ 'outer' => 'ignored inner failure' ];\n\t\t} );\n\t\tassert_error( $result, 'inner_failure', 503, 'Ignored nested error' );\n\t\tassert_true( in_array( 'ROLLBACK', $wpdb->queries, true ), 'Ignored nested error must roll back.' );\n\t\tassert_same( 0, count( array_filter( $wpdb->queries, static fn( string $query ): bool => 'COMMIT' === $query ) ), 'Rollback-only outer work must not commit.' );\n\t};\n\n\t$failed = 0;\n\tforeach ( $tests as $name => $test ) {\n\t\ttry { $test(); fwrite( STDOUT, \"PASS {$name}\\n\" ); }\n\t\tcatch ( \\Throwable $error ) { $failed++; fwrite( STDERR, \"FAIL {$name}: {$error->getMessage()}\\n\" ); }\n\t}\n\texit( $failed === 0 ? 0 : 1 );\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/tests/wordpress/public-profile-guard.test.php": {
      "sha256": "87aef3a3ba8fcf147d4d26d4eacc2f479f7119a28d701ea7cb99993b2b214676",
      "text": "<?php\n/**\n * Deterministic boundary test for the public specialist profile guard.\n *\n * Usage:\n *   /Applications/XAMPP/xamppfiles/bin/php tests/wordpress/public-profile-guard.test.php /path/to/karban-core\n *\n * This deliberately does not bootstrap WordPress or connect to a database.\n */\n\ndeclare(strict_types=1);\n\nnamespace Nahan\\Core\\RestApi {\n    final class RestHelper {\n        public const NAMESPACE = 'nahan/v1';\n\n        public static function authed_callback(): callable {\n            return static fn (): bool => true;\n        }\n\n        public static function role_callback(string $role): callable {\n            return static fn (): bool => true;\n        }\n\n        public static function ok($data, int $status = 200): \\WP_REST_Response {\n            return new \\WP_REST_Response([\n                'success' => true,\n                'data' => $data,\n            ], $status);\n        }\n\n        public static function fail(string $code, string $message, int $status = 400, $extra = []): \\WP_REST_Response {\n            return new \\WP_REST_Response([\n                'success' => false,\n                'error' => array_merge([\n                    'code' => $code,\n                    'message' => $message,\n                ], $extra),\n            ], $status);\n        }\n    }\n}\n\nnamespace Nahan\\Core {\n    final class Helpers {\n        public static function client_ip(): string {\n            return '127.0.0.1';\n        }\n\n        public static function now_mysql(): string {\n            return '2026-10-18 00:00:00';\n        }\n    }\n\n    final class Roles {\n        public const SPECIALIST = 'specialist';\n    }\n}\n\nnamespace {\n    if ($argc !== 2) {\n        fwrite(STDERR, \"Usage: php public-profile-guard.test.php /path/to/karban-core\\n\");\n        exit(2);\n    }\n\n    $pluginDir = rtrim($argv[1], '/');\n    $routeFile = $pluginDir . '/rest-api/profile-routes.php';\n    if (!is_file($routeFile)) {\n        fwrite(STDERR, \"Plugin route file not found: {$routeFile}\\n\");\n        exit(2);\n    }\n\n    define('ABSPATH', __DIR__ . '/');\n    define('OBJECT', 'OBJECT');\n\n    final class WP_REST_Response {\n        private array $data;\n        private int $status;\n\n        public function __construct(array $data, int $status = 200) {\n            $this->data = $data;\n            $this->status = $status;\n        }\n\n        public function get_data(): array {\n            return $this->data;\n        }\n\n        public function get_status(): int {\n            return $this->status;\n        }\n    }\n\n    final class WP_Post {\n        public int $ID;\n        public string $post_type;\n        public string $post_status;\n        public string $post_password;\n\n        public function __construct(int $id, string $type, string $status, string $password = '') {\n            $this->ID = $id;\n            $this->post_type = $type;\n            $this->post_status = $status;\n            $this->post_password = $password;\n        }\n    }\n\n    final class FakeRequest implements \\ArrayAccess {\n        private array $params;\n\n        public function __construct(array $params = []) {\n            $this->params = $params;\n        }\n\n        public function get_param(string $key) {\n            return $this->params[$key] ?? null;\n        }\n\n        public function offsetExists(mixed $offset): bool {\n            return array_key_exists((string) $offset, $this->params);\n        }\n\n        public function offsetGet(mixed $offset): mixed {\n            return $this->params[(string) $offset] ?? null;\n        }\n\n        public function offsetSet(mixed $offset, mixed $value): void {\n            throw new \\LogicException('Requests are immutable in this test.');\n        }\n\n        public function offsetUnset(mixed $offset): void {\n            throw new \\LogicException('Requests are immutable in this test.');\n        }\n    }\n\n    final class WP_Query {\n        public array $posts = [];\n        public int $found_posts = 0;\n        public int $max_num_pages = 0;\n\n        public function __construct(array $args) {\n            $GLOBALS['captured_list_queries'][] = $args;\n        }\n    }\n\n    final class FakeWpdb {\n        public string $prefix = 'wp_';\n        public array $inserts = [];\n\n        public function insert(string $table, array $data, array $format): int {\n            $this->inserts[] = compact('table', 'data', 'format');\n            return 1;\n        }\n    }\n\n    $GLOBALS['registered_routes'] = [];\n    $GLOBALS['captured_list_queries'] = [];\n    $GLOBALS['post_for_slug'] = null;\n    $GLOBALS['formatter_calls'] = [];\n    $GLOBALS['wpdb'] = new FakeWpdb();\n\n    function register_rest_route(string $namespace, string $route, array $definition): void {\n        $GLOBALS['registered_routes'][$namespace . $route] = $definition;\n    }\n\n    function get_page_by_path(string $slug, string $output, string $postType) {\n        return $GLOBALS['post_for_slug'];\n    }\n\n    function is_user_logged_in(): bool {\n        return false;\n    }\n\n    function get_current_user_id(): int {\n        return 0;\n    }\n\n    function nahan_format_specialist_full(int $id): array {\n        $GLOBALS['formatter_calls'][] = $id;\n        return ['id' => $id, 'formatted' => true];\n    }\n\n    require $routeFile;\n\n    function assert_same($expected, $actual, string $message): void {\n        if ($expected !== $actual) {\n            throw new \\RuntimeException(\n                $message . \"\\nExpected: \" . var_export($expected, true) . \"\\nActual: \" . var_export($actual, true)\n            );\n        }\n    }\n\n    function assert_true(bool $condition, string $message): void {\n        if (!$condition) {\n            throw new \\RuntimeException($message);\n        }\n    }\n\n    function reset_public_detail_state(): void {\n        $GLOBALS['wpdb']->inserts = [];\n        $GLOBALS['formatter_calls'] = [];\n    }\n\n    $detailRoute = $GLOBALS['registered_routes']['nahan/v1/specialists/(?P<slug>[^/]+)'] ?? null;\n    $listRoute = $GLOBALS['registered_routes']['nahan/v1/specialists'] ?? null;\n    assert_true(is_array($detailRoute), 'The real public detail route must be registered.');\n    assert_true(is_array($listRoute), 'The real public list route must be registered.');\n\n    $detail = $detailRoute['callback'];\n    $rejectedCases = [\n        'missing' => null,\n        'draft' => new WP_Post(101, 'nahan_specialist', 'draft'),\n        'pending' => new WP_Post(102, 'nahan_specialist', 'pending'),\n        'private' => new WP_Post(103, 'nahan_specialist', 'private'),\n        'future' => new WP_Post(104, 'nahan_specialist', 'future'),\n        'trash' => new WP_Post(105, 'nahan_specialist', 'trash'),\n        'wrong type' => new WP_Post(106, 'post', 'publish'),\n        'password protected' => new WP_Post(107, 'nahan_specialist', 'publish', 'secret'),\n    ];\n\n    foreach ($rejectedCases as $label => $post) {\n        reset_public_detail_state();\n        $GLOBALS['post_for_slug'] = $post;\n        $response = $detail(new FakeRequest(['slug' => 'guard-case']));\n        assert_same(404, $response->get_status(), \"{$label} public detail must be not_found.\");\n        assert_same('not_found', $response->get_data()['error']['code'] ?? null, \"{$label} must preserve the existing not_found envelope.\");\n        assert_same(0, count($GLOBALS['wpdb']->inserts), \"{$label} must not record a profile view.\");\n        assert_same([], $GLOBALS['formatter_calls'], \"{$label} must not access the shared formatter.\");\n    }\n\n    reset_public_detail_state();\n    $GLOBALS['post_for_slug'] = new WP_Post(108, 'nahan_specialist', 'publish');\n    $response = $detail(new FakeRequest(['slug' => 'published-specialist']));\n    assert_same(200, $response->get_status(), 'A published password-free specialist must succeed.');\n    assert_same(['success' => true, 'data' => ['id' => 108, 'formatted' => true]], $response->get_data(), 'A published specialist must preserve formatter output.');\n    assert_same(1, count($GLOBALS['wpdb']->inserts), 'A published specialist must retain view insertion.');\n    assert_same([108], $GLOBALS['formatter_calls'], 'A published specialist must call the shared formatter once.');\n\n    $list = $listRoute['callback'];\n    $GLOBALS['captured_list_queries'] = [];\n    $list(new FakeRequest());\n    $args = $GLOBALS['captured_list_queries'][0] ?? null;\n    assert_true(is_array($args), 'The public list must construct a WP_Query.');\n    assert_same('publish', $args['post_status'] ?? null, 'The public list must query published specialists only.');\n    assert_true(array_key_exists('has_password', $args), 'The public list must explicitly exclude password-protected specialists.');\n    assert_same(false, $args['has_password'], 'The public list must set has_password to false.');\n\n    fwrite(STDOUT, \"PASS public profile publication/password guard\\n\");\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/tests/wordpress/task-4a-local-otp.test.php": {
      "sha256": "14d09bf8835c25236e25e8713ba66869003425889712372b69810d9130813463",
      "text": "<?php\n/**\n * Standalone Task 4A tests. These deliberately do not bootstrap WordPress or touch a database.\n * Run: php tests/wordpress/task-4a-local-otp.test.php\n */\ndeclare( strict_types=1 );\n\nnamespace {\n\tdefine( 'ABSPATH', __DIR__ . '/' );\n\tdefine( 'ARRAY_A', 'ARRAY_A' );\n\tdefine( 'NAHAN_CORE_DIR', '/Applications/XAMPP/xamppfiles/htdocs/karban/wp-content/plugins/karban-core/' );\n\n\tfinal class WP_Error {\n\t\tpublic function __construct( public string $code = '', public string $message = '', public array $data = [] ) {}\n\t\tpublic function get_error_code(): string { return $this->code; }\n\t\tpublic function get_error_data(): array { return $this->data; }\n\t}\n\tfunction is_wp_error( mixed $value ): bool { return $value instanceof WP_Error; }\n\tfunction wp_generate_uuid4(): string { static $i = 0; return sprintf( '00000000-0000-4000-8000-%012d', ++$i ); }\n\tfunction current_time( string $type, bool $gmt = false ): string { return '2026-10-18 00:00:00'; }\n\tfunction sanitize_text_field( string $value ): string { return $value; }\n\tfunction wp_unslash( string $value ): string { return $value; }\n\tfunction get_option( string $key, mixed $default = false ): mixed { global $test_options; return $test_options[ $key ] ?? $default; }\n\tfunction update_option( string $key, mixed $value ): bool { global $test_options; $test_options[ $key ] = $value; return true; }\n\tfunction delete_option( string $key ): bool { global $test_options; unset( $test_options[ $key ] ); return true; }\n\tfunction wp_parse_url( string $url ): array|false { return parse_url( $url ); }\n\tfunction wp_json_encode( mixed $value ): string { return json_encode( $value, JSON_THROW_ON_ERROR ); }\n\tfunction dbDelta( string $sql ): array { global $db_delta_calls; $db_delta_calls[] = $sql; return []; }\n\n\tfinal class TestWpdb {\n\t\tpublic string $prefix = 'wp_';\n\t\t/** @var list<array{table:string,data:array}> */ public array $inserts = [];\n\t\t/** @var list<string> */ public array $queries = [];\n\t\t/** @var list<array{query:string,args:list<mixed>}> */ public array $prepare_calls = [];\n\t\t/** @var list<array{table:string,where:array}> */ public array $deletes = [];\n\t\t/** @var list<string> */ public array $column_names = [ 'id', 'phone', 'code_hash', 'tracking_code', 'attempts', 'ip_address', 'user_agent', 'created_at', 'expires_at', 'consumed_at', 'delivery_mode', 'code_length' ];\n\t\tpublic ?array $row = null;\n\t\tpublic int|false $insert_result = 1;\n\t\tpublic int $consume_result = 1;\n\t\tpublic int $increment_result = 1;\n\t\tpublic string $last_error = 'synthetic-db-detail-must-not-leak';\n\t\tpublic function prepare( string $query, mixed ...$args ): string {\n\t\t\t$this->prepare_calls[] = [ 'query' => $query, 'args' => $args ];\n\t\t\treturn $query;\n\t\t}\n\t\tpublic function get_row( string $query, mixed $output = null ): ?array { return $this->row; }\n\t\tpublic function get_col( string $query, mixed $column = 0 ): array { return $this->column_names; }\n\t\tpublic function get_charset_collate(): string { return ''; }\n\t\tpublic function insert( string $table, array $data, ?array $format = null ): int|false {\n\t\t\t$this->inserts[] = compact( 'table', 'data' );\n\t\t\treturn $this->insert_result;\n\t\t}\n\t\tpublic function update( string $table, array $data, array $where, ?array $format = null, ?array $where_format = null ): int { throw new \\RuntimeException( 'OTP verification must use conditional query(), not update().' ); }\n\t\tpublic function delete( string $table, array $where, ?array $format = null ): int { $this->deletes[] = compact( 'table', 'where' ); return 1; }\n\t\tpublic function query( string $query ): int {\n\t\t\t$this->queries[] = $query;\n\t\t\tif ( str_contains( $query, 'attempts = attempts + 1' ) ) return $this->increment_result;\n\t\t\tif ( str_contains( $query, 'consumed_at = ' ) ) return $this->consume_result;\n\t\t\treturn 1;\n\t\t}\n\t}\n\n\tfunction reset_fixture(): TestWpdb {\n\t\tglobal $wpdb, $test_options, $db_delta_calls, $_SERVER;\n\t\t$test_options = [\n\t\t\t'nahan_otp_ttl' => 120,\n\t\t\t'nahan_otp_throttle_window' => 60,\n\t\t\t'nahan_otp_max_attempts' => 5,\n\t\t\t'nahan_sms_kavenegar_pattern' => '',\n\t\t];\n\t\t$db_delta_calls = [];\n\t\t$_SERVER = [];\n\t\t$wpdb = new TestWpdb();\n\t\treturn $wpdb;\n\t}\n\n\tfunction assert_true( bool $condition, string $message ): void { if ( ! $condition ) throw new \\RuntimeException( $message ); }\n\tfunction assert_same( mixed $expected, mixed $actual, string $message ): void { if ( $expected !== $actual ) throw new \\RuntimeException( $message . '\\nExpected: ' . var_export( $expected, true ) . '\\nActual: ' . var_export( $actual, true ) ); }\n\tfunction assert_error( mixed $actual, string $code, int $status, string $message ): void {\n\t\tassert_true( $actual instanceof WP_Error, $message . ' must return WP_Error' );\n\t\tassert_same( $code, $actual->get_error_code(), $message . ' code' );\n\t\tassert_same( $status, $actual->get_error_data()['status'] ?? null, $message . ' status' );\n\t}\n}\n\nnamespace Nahan\\Core\\Auth {\n\trequire_once NAHAN_CORE_DIR . 'includes/class-helpers.php';\n\trequire_once NAHAN_CORE_DIR . 'includes/class-rate-limiter.php';\n\trequire_once NAHAN_CORE_DIR . 'includes/admin/class-settings.php';\n\trequire_once NAHAN_CORE_DIR . 'includes/auth/class-sms-service.php';\n\trequire_once NAHAN_CORE_DIR . 'includes/class-local-development-gate.php';\n\trequire_once NAHAN_CORE_DIR . 'includes/auth/class-otp-schema.php';\n\trequire_once NAHAN_CORE_DIR . 'includes/auth/class-otp-manager.php';\n\n\tuse Nahan\\Core\\LocalDevelopmentGate;\n\tuse Nahan\\Core\\Admin\\Settings;\n\n\tfunction gate( array $overrides = [] ): LocalDevelopmentGate {\n\t\treturn new LocalDevelopmentGate( array_merge( [\n\t\t\t'local_development' => true,\n\t\t\t'local_dev_otp' => true,\n\t\t\t'environment_type' => 'local',\n\t\t\t'site_url' => 'http://localhost',\n\t\t\t'remote_addr' => '127.0.0.1',\n\t\t], $overrides ) );\n\t}\n\tfunction manager( LocalDevelopmentGate $gate, ?OtpSchema $schema = null, ?callable $send_otp = null ): OtpManager {\n\t\treturn new OtpManager( new SmsService( new Settings() ), $gate, $schema ?? new OtpSchema(), $send_otp );\n\t}\n\tfunction row( array $overrides = [] ): array {\n\t\treturn array_merge( [\n\t\t\t'id' => 13,\n\t\t\t'phone' => '09121234567',\n\t\t\t'code_hash' => hash( 'sha256', '145632' ),\n\t\t\t'tracking_code' => 'tracking',\n\t\t\t'attempts' => 0,\n\t\t\t'expires_at' => '2099-01-01 00:00:00',\n\t\t\t'consumed_at' => null,\n\t\t\t'delivery_mode' => 'local_simulated',\n\t\t\t'code_length' => 6,\n\t\t], $overrides );\n\t}\n\tfunction last_prepare(): array {\n\t\tglobal $wpdb;\n\t\t$prepared = end( $wpdb->prepare_calls );\n\t\tassert_true( is_array( $prepared ), 'Expected a prepared database mutation.' );\n\t\treturn $prepared;\n\t}\n\n\t$tests = [];\n\t$tests['gate is default-off and requires every server-owned predicate'] = static function (): void {\n\t\t\\reset_fixture();\n\t\tassert_true( ! ( new LocalDevelopmentGate( [ 'environment_type' => 'local', 'site_url' => 'http://localhost', 'remote_addr' => '127.0.0.1' ] ) )->is_otp_simulation_enabled(), 'Missing constants must be default-off.' );\n\t\tforeach ( [\n\t\t\t[ 'local_development' => false ], [ 'local_dev_otp' => false ], [ 'environment_type' => 'production' ],\n\t\t\t[ 'site_url' => 'https://example.test' ], [ 'site_url' => 'ftp://localhost' ], [ 'site_url' => 'http://localhost/?x=1' ],\n\t\t\t[ 'site_url' => 'http://user:pass@localhost' ], [ 'remote_addr' => '192.0.2.9' ],\n\t\t] as $override ) {\n\t\t\tassert_true( ! gate( $override )->is_otp_simulation_enabled(), 'A false/malformed predicate must fail closed.' );\n\t\t}\n\t\tassert_true( gate( [ 'remote_addr' => '::1' ] )->is_otp_simulation_enabled(), 'IPv6 loopback must be accepted.' );\n\t\tassert_true( ! gate( [ 'remote_addr' => '198.51.100.9', 'http_host' => 'localhost', 'http_x_forwarded_for' => '127.0.0.1' ] )->is_otp_simulation_enabled(), 'Host and forwarded headers must never enable local OTP.' );\n\t};\n\t$tests['local request persists fixed provenance and invokes no transport'] = static function (): void {\n\t\t$wpdb = \\reset_fixture();\n\t\t$transport_calls = [];\n\t\t$result = manager( gate(), null, static function ( string $phone, string $code ) use ( &$transport_calls ): bool {\n\t\t\t$transport_calls[] = [ $phone, $code ];\n\t\t\treturn true;\n\t\t} )->request( '09121234567', '203.0.113.4' );\n\t\tassert_true( ! \\is_wp_error( $result ), 'Local challenge must issue when gate and schema pass.' );\n\t\tassert_same( [], $transport_calls, 'Local request must skip all SMS/log transports.' );\n\t\tassert_same( 'local_simulated', $result['delivery_mode'], 'Challenge must expose safe local mode.' );\n\t\tassert_same( 6, $result['code_length'], 'Challenge must expose six digit length.' );\n\t\t$record = $wpdb->inserts[3]['data'] ?? null;\n\t\tassert_true( is_array( $record ), 'OTP insert must follow the three rate-limit records.' );\n\t\tassert_same( hash( 'sha256', '145632' ), $record['code_hash'], 'Fixed local code must use normal hash persistence.' );\n\t\tassert_same( 'local_simulated', $record['delivery_mode'], 'Record must persist local provenance.' );\n\t\tassert_same( 6, $record['code_length'], 'Record must persist six digit provenance.' );\n\t};\n\t$tests['production request persists random five digit SMS provenance and invokes transport once'] = static function (): void {\n\t\t$wpdb = \\reset_fixture();\n\t\tglobal $test_options;\n\t\t$test_options['nahan_sms_driver'] = 'unknown'; // Current production code must use the injected observer, not a real driver.\n\t\t$transport_calls = [];\n\t\t$result = manager( gate( [ 'environment_type' => 'production' ] ), null, static function ( string $phone, string $code ) use ( &$transport_calls ): bool {\n\t\t\t$transport_calls[] = [ $phone, $code ];\n\t\t\treturn true;\n\t\t} )->request( '09121234567', '203.0.113.4' );\n\t\tassert_true( ! \\is_wp_error( $result ), 'Production request must issue before the transport observer succeeds.' );\n\t\tassert_same( 1, count( $transport_calls ), 'Production request must invoke exactly one transport.' );\n\t\tassert_same( '09121234567', $transport_calls[0][0], 'Production transport phone.' );\n\t\tassert_true( 1 === preg_match( '/^\\d{5}$/', $transport_calls[0][1] ), 'Production request must generate exactly five random digits.' );\n\t\tassert_true( '145632' !== $transport_calls[0][1], 'Production request must not use the local fixed code.' );\n\t\t$record = $wpdb->inserts[3]['data'] ?? null;\n\t\tassert_true( is_array( $record ), 'Production request must persist an OTP row.' );\n\t\tassert_same( hash( 'sha256', $transport_calls[0][1] ), $record['code_hash'], 'Production row must hash the transported code.' );\n\t\tassert_same( 'sms', $record['delivery_mode'], 'Production row must persist SMS provenance.' );\n\t\tassert_same( 5, $record['code_length'], 'Production row must persist five digit provenance.' );\n\t};\n\t$tests['failed OTP insert returns a safe error before any local or production transport'] = static function (): void {\n\t\tforeach ( [ false, 0 ] as $insert_result ) {\n\t\t\tforeach ( [ 'local' => gate(), 'production' => gate( [ 'environment_type' => 'production' ] ) ] as $mode => $mode_gate ) {\n\t\t\t\t$wpdb = \\reset_fixture();\n\t\t\t\t$wpdb->insert_result = $insert_result;\n\t\t\t\t$transport_calls = [];\n\t\t\t\t$result = manager( $mode_gate, null, static function ( string $phone, string $code ) use ( &$transport_calls ): bool {\n\t\t\t\t\t$transport_calls[] = [ $phone, $code ];\n\t\t\t\t\treturn true;\n\t\t\t\t} )->request( '09121234567', '203.0.113.4' );\n\t\t\t\tassert_error( $result, 'otp_storage_unavailable', 503, \"{$mode} insert failure\" );\n\t\t\t\tassert_same( [], $transport_calls, \"{$mode} insert failure must not invoke transport\" );\n\t\t\t\tassert_true( ! str_contains( $result->message, $wpdb->last_error ), \"{$mode} insert failure must not expose database details\" );\n\t\t\t}\n\t\t}\n\t};\n\t$tests['missing schema blocks only local issue'] = static function (): void {\n\t\t\\reset_fixture();\n\t\tglobal $wpdb;\n\t\t$wpdb->column_names = [ 'id' ];\n\t\tassert_error( manager( gate() )->request( '09121234567', '203.0.113.4' ), 'otp_local_configuration_unavailable', 503, 'Local missing schema' );\n\t};\n\t$tests['stored provenance rejects disabled local challenge and normalizes Persian and Arabic digits'] = static function (): void {\n\t\t$wpdb = \\reset_fixture();\n\t\t$wpdb->row = row();\n\t\tassert_error( manager( gate( [ 'local_dev_otp' => false ] ) )->verify( 'tracking', '145632' ), 'otp_local_unavailable', 403, 'Disabled local challenge' );\n\t\t$wpdb->row = row();\n\t\tassert_error( manager( gate() )->verify( 'tracking', '14563' ), 'otp_invalid', 422, 'Wrong local digit length' );\n\t\t$wpdb->row = row();\n\t\tassert_same( '09121234567', manager( gate() )->verify( 'tracking', '۱۴۵۶۳۲' ), 'Persian local digits' );\n\t\t$wpdb->row = row();\n\t\tassert_same( '09121234567', manager( gate() )->verify( 'tracking', '١٤٥٦٣٢' ), 'Arabic local digits' );\n\t};\n\t$tests['verification preserves expiry attempts and conditional atomic boundaries'] = static function (): void {\n\t\t$wpdb = \\reset_fixture();\n\t\t$wpdb->row = row( [ 'consumed_at' => '2026-10-18 00:00:00' ] );\n\t\tassert_error( manager( gate() )->verify( 'tracking', '145632' ), 'otp_consumed', 410, 'Consumed row' );\n\t\t$wpdb->row = row( [ 'expires_at' => '2020-01-01 00:00:00' ] );\n\t\tassert_error( manager( gate() )->verify( 'tracking', '145632' ), 'otp_expired', 410, 'Expired row' );\n\t\t$wpdb->row = row( [ 'attempts' => 5 ] );\n\t\tassert_error( manager( gate() )->verify( 'tracking', '145632' ), 'otp_too_many_attempts', 429, 'Attempt limit' );\n\t\t$wpdb->row = row( [ 'code_hash' => hash( 'sha256', '000000' ), 'attempts' => 4 ] );\n\t\tassert_error( manager( gate() )->verify( 'tracking', '145632' ), 'otp_invalid', 422, 'Final failed attempt' );\n\t\t$increment = last_prepare();\n\t\tassert_true( str_contains( $increment['query'], 'attempts = attempts + 1' ) && str_contains( $increment['query'], 'attempts < %d' ), 'Failed attempt must bind a conditional atomic increment limit.' );\n\t\tassert_same( 5, end( $increment['args'] ), 'Failed attempt must bind the configured limit.' );\n\n\t\tforeach ( [ 'expiry' => 'A stale verifier loses after expiry.', 'attempt-limit' => 'A stale verifier loses after another verifier reaches the attempt limit.' ] as $interleaving => $message ) {\n\t\t\t$wpdb->row = row( [ 'attempts' => 4 ] );\n\t\t\t$wpdb->consume_result = 0;\n\t\t\t$result = manager( gate() )->verify( 'tracking', '145632' );\n\t\t\tassert_true( \\is_wp_error( $result ), $message );\n\t\t\t$consume = last_prepare();\n\t\t\tassert_true( str_contains( $consume['query'], 'consumed_at IS NULL' ), \"{$interleaving} consume must remain conditional.\" );\n\t\t\tassert_true( str_contains( $consume['query'], 'attempts < %d' ), \"{$interleaving} consume must recheck attempts.\" );\n\t\t\tassert_true( str_contains( $consume['query'], 'expires_at >= UTC_TIMESTAMP()' ), \"{$interleaving} consume must recheck expiry.\" );\n\t\t\tassert_same( 5, end( $consume['args'] ), \"{$interleaving} consume must bind the configured limit.\" );\n\t\t}\n\t};\n\t$tests['schema upgrade only records version after dbDelta and column verification'] = static function (): void {\n\t\t$wpdb = \\reset_fixture();\n\t\tassert_true( ( new OtpSchema() )->upgrade(), 'Schema upgrade should succeed when required columns verify.' );\n\t\tassert_same( OtpSchema::VERSION, \\get_option( OtpSchema::OPTION ), 'Verified upgrade must record version.' );\n\t\t\\reset_fixture(); global $wpdb;\n\t\t$wpdb->column_names = [ 'id', 'delivery_mode' ];\n\t\tassert_true( ! ( new OtpSchema() )->upgrade(), 'Incomplete schema must fail upgrade verification.' );\n\t\tassert_same( false, \\get_option( OtpSchema::OPTION, false ), 'Failed upgrade must not record version.' );\n\t};\n\n\t$failed = 0;\n\tforeach ( $tests as $name => $test ) {\n\t\ttry { $test(); fwrite( STDOUT, \"PASS {$name}\\n\" ); }\n\t\tcatch ( \\Throwable $error ) { $failed++; fwrite( STDERR, \"FAIL {$name}: {$error->getMessage()}\\n\" ); }\n\t}\n\texit( $failed === 0 ? 0 : 1 );\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/tests/wordpress/task-7a-seed-tools.test.php": {
      "sha256": "417932d5de1ed917c8ab43a865ad2df10a089ead163a631fadfc0392ed99b190",
      "text": "<?php\n/** Source-only fixtures: no WP bootstrap, database or network. */\nrequire __DIR__ . '/task-6a-admin.test.php';\nuse Nahan\\Core\\Development\\LocalSeedService;\nuse Nahan\\Core\\Development\\LocalSeedManifest;\n$failed = 0; $passed = 0;\nfunction scenario( string $name, callable $test ): void { global $failed, $passed; reset_fixture(); try { $test(); $passed++; echo \"PASS $name\\n\"; } catch ( Throwable $e ) { $failed++; echo \"FAIL $name: {$e->getMessage()}\\n\"; } }\nfunction seed_all(): array { $s = new LocalSeedService( gate() ); $p = $s->preview(); return $s->apply( $p['version'], $p['hash'], LocalSeedService::CONFIRMATION ); }\nfunction render_tools( $tool ): string { ob_start(); try { $tool->render(); return ob_get_contents(); } finally { ob_end_clean(); } }\nscenario( 'registered preview renders full safe manifest and provenance', function () {\n $t = registered_tools(); invoke( $GLOBALS['hooks']['admin_post_nahan_local_preview'] ); $html = render_tools( $t );\n foreach ( LocalSeedManifest::all()['taxonomies'] as $entries ) foreach ( $entries as $entry ) { assert_true( str_contains( $html, $entry['slug'] ), 'missing term ' . $entry['slug'] ); assert_true( str_contains( $html, $entry['name'] ), 'missing term name' ); }\n foreach ( LocalSeedManifest::all()['users'] as $u ) { assert_true( str_contains( $html, $u['seed_id'] ), 'missing account' ); if ( isset( $u['profile'] ) ) assert_true( str_contains( $html, $u['profile']['slug'] ), 'missing profile' ); }\n foreach ( ['2016', 'application-historical-2016-baseline', 'would_create', 'OTP'] as $text ) assert_true( str_contains( $html, $text ), 'missing preview detail ' . $text );\n});\nscenario( 'fresh creation links every profile both ways without phone mapping', function () {\n assert_same( 'success', seed_all()['status'], 'creation succeeds' );\n foreach ( $GLOBALS['posts'] as $p ) { assert_same( (string) $p->ID, (string) get_user_meta( $p->post_author, 'nahan_specialist_post', true ), 'account pointer' ); assert_same( (string) $p->post_author, (string) get_post_meta( $p->ID, 'user', true ), 'profile pointer' ); }\n foreach ( $GLOBALS['user_meta'] as $meta ) assert_true( ! isset( $meta['phone'] ) && ! isset( $meta['phone_number'] ), 'no synthetic login phone' );\n});\nforeach ( ['user-meta:nahan_specialist_post', 'post-meta:user', 'category-assignment'] as $failure ) scenario( 'checked partial repair ' . $failure, function () use ( $failure ) {\n $GLOBALS['fail'] = $failure; $r = seed_all(); assert_same( 'partial', $r['status'], 'failed required write is partial' ); assert_true( empty( $GLOBALS['filters'] ), 'finally restores outbound' );\n $GLOBALS['fail'] = null; $p = $GLOBALS['posts'][0]; $p->post_title = 'User edited'; $p->post_status = 'draft'; $count = count( $GLOBALS['posts'] ); $s = new LocalSeedService( gate() ); $before = $GLOBALS['writes']; $preview = $s->preview(); assert_same( $before, $GLOBALS['writes'], 'repair preview is read-only' ); assert_same( 'repair', $preview['plan']['users'][1]['profile']['action'], 'partial profile is classified repair' );\n $r = $s->apply( $preview['version'], $preview['hash'], LocalSeedService::CONFIRMATION ); assert_same( 'success', $r['status'], 'explicit repair succeeds' ); assert_same( 'User edited', $p->post_title, 'content preserved' ); assert_same( 'draft', $p->post_status, 'never republished' ); assert_same( 3, count( $GLOBALS['posts'] ), 'no duplicated profile' ); assert_same( (string) $p->ID, (string) get_user_meta( $p->post_author, 'nahan_specialist_post', true ), 'repaired account pointer' ); assert_same( (string) $p->post_author, (string) get_post_meta( $p->ID, 'user', true ), 'repaired profile pointer' ); assert_true( count( $GLOBALS['assignments'][$p->ID]['job_category'] ?? [] ) > 0, 'missing term repaired' );\n});\nforeach ( ['foreign-pointer','foreign-user','foreign-author','extra-role','unmarked','duplicate-owner'] as $conflict ) scenario( 'fail closed ' . $conflict, function () use ( $conflict ) {\n seed_all(); $p = $GLOBALS['posts'][0];\n if ( $conflict === 'foreign-pointer' ) $GLOBALS['user_meta'][$p->post_author]['nahan_specialist_post'] = 999;\n if ( $conflict === 'foreign-user' ) $GLOBALS['post_meta'][$p->ID]['user'] = 999;\n if ( $conflict === 'foreign-author' ) $p->post_author = 999;\n if ( $conflict === 'extra-role' ) $GLOBALS['users'][1]->roles[] = 'administrator';\n if ( $conflict === 'unmarked' ) unset( $GLOBALS['post_meta'][$p->ID]['_nahan_local_seed_id'] );\n if ( $conflict === 'duplicate-owner' ) { $copy = clone $p; $copy->ID = 999; $copy->post_name = 'other-profile'; $GLOBALS['posts'][] = $copy; }\n $before = $GLOBALS['writes']; expect_denied( static fn() => ( new LocalSeedService( gate() ) )->preview(), 'conflict must reject preview' ); assert_same( $before, $GLOBALS['writes'], 'conflict zero writes' );\n});\nscenario( 'saved partial results render completed items and safe retry guidance', function () {\n $t = registered_tools(); invoke( $GLOBALS['hooks']['admin_post_nahan_local_preview'] ); $_POST['confirmation'] = LocalSeedService::CONFIRMATION; $GLOBALS['fail'] = 'category-assignment'; invoke( $GLOBALS['hooks']['admin_post_nahan_local_apply'] ); $html = render_tools( $t );\n foreach ( ['partial','job_category:building-permits','karban-local-demo-client','profile:karban-local-demo-architect-profile','retry'] as $text ) assert_true( str_contains( $html, $text ), 'missing partial detail ' . $text );\n $GLOBALS['current_user'] = 92; $other = render_tools( $t ); assert_true( ! str_contains( $other, 'profile:karban-local-demo-architect-profile' ), 'other admin cannot see results' );\n $GLOBALS['current_user'] = 91; assert_true( str_contains( render_tools( $t ), 'profile:karban-local-demo-architect-profile' ), 'original admin retains results' );\n $GLOBALS['home_origin'] = 'http://localhost/other'; assert_true( ! str_contains( render_tools( $t ), 'profile:karban-local-demo-architect-profile' ), 'origin change hides persisted results' );\n $before = $GLOBALS['writes']; expect_denied( static fn() => $GLOBALS['hooks']['admin_post_nahan_local_apply'](), 'origin-bound preview rejected' ); assert_same( $before, $GLOBALS['writes'], 'origin mismatch zero writes' );\n});\nscenario( 'upgrade callback saves safe failure and render shows it', function () {\n $GLOBALS['wpdb']->indexes['wp_nahan_wallet_transactions'][0]['Non_unique'] = 1; $t = registered_tools(); $_POST += ['schema'=>'financial','confirmation'=>LocalSeedService::CONFIRMATION]; invoke( $GLOBALS['hooks']['admin_post_nahan_local_upgrade'] ); $html = render_tools( $t ); assert_true( str_contains( $html, 'financial' ) && str_contains( $html, 'failed' ), 'saved upgrade failure visible' );\n});\nscenario( 'preview includes demo display names and profile bio', function () {\n $t = registered_tools(); invoke( $GLOBALS['hooks']['admin_post_nahan_local_preview'] ); $html = render_tools( $t );\n foreach ( LocalSeedManifest::all()['users'] as $user ) { assert_true( str_contains( $html, $user['display_name'] ), 'display name visible' ); if ( isset( $user['profile'] ) ) assert_true( str_contains( $html, $user['profile']['bio'] ), 'bio visible' ); }\n});\nscenario( 'missing marked account demo flag is explicitly repair not silent existing', function () {\n seed_all(); unset( $GLOBALS['user_meta'][201]['_nahan_local_demo'] ); $p = (new LocalSeedService(gate()))->preview(); assert_same('repair', $p['plan']['users'][0]['action'], 'missing account demo flag visible');\n});\nscenario( 'foreign reverse claim fails closed', function () {\n seed_all(); $GLOBALS['user_meta'][201]['nahan_specialist_post'] = 301; $before = $GLOBALS['writes']; expect_denied( static fn() => (new LocalSeedService(gate()))->preview(), 'foreign claimant rejected' ); assert_same($before, $GLOBALS['writes'], 'no writes');\n});\nscenario( 'saved state remains separate for two admins and invalidates version hash', function () {\n $t=registered_tools(); invoke($GLOBALS['hooks']['admin_post_nahan_local_preview']); $GLOBALS['current_user']=92; invoke($GLOBALS['hooks']['admin_post_nahan_local_preview']); $GLOBALS['current_user']=91;\n assert_true(str_contains(render_tools($t),'application-historical-2016-baseline'), 'second admin does not replace first preview');\n foreach (['hash','version'] as $field) { $old=$GLOBALS['options']['nahan_local_seed_preview_91'][$field]; $GLOBALS['options']['nahan_local_seed_preview_91'][$field]='stale'; assert_true(!str_contains(render_tools($t),'application-historical-2016-baseline'), 'stale preview hidden'); $_POST['confirmation']=LocalSeedService::CONFIRMATION; $before=$GLOBALS['writes']; expect_denied(static fn()=>$GLOBALS['hooks']['admin_post_nahan_local_apply'](),'stale apply denied'); assert_same($before,$GLOBALS['writes'],'stale apply no writes'); $GLOBALS['options']['nahan_local_seed_preview_91'][$field]=$old; }\n});\nscenario( 'raw exception details never persist or render', function () {\n $t=registered_tools(); invoke($GLOBALS['hooks']['admin_post_nahan_local_preview']); $_POST['confirmation']=LocalSeedService::CONFIRMATION; $GLOBALS['fail']='raw-exception'; invoke($GLOBALS['hooks']['admin_post_nahan_local_apply']); assert_true(!str_contains(json_encode($GLOBALS['options']),'SELECT private_fixture'),'exception not persisted'); assert_true(!str_contains(render_tools($t),'SELECT private_fixture'),'exception not rendered'); assert_true(empty($GLOBALS['filters']),'finally cleans exception');\n});\nscenario( 'successful upgrade and seed results are visible only in their bound context', function () {\n $t=registered_tools(); $_POST += ['schema'=>'financial','confirmation'=>LocalSeedService::CONFIRMATION]; invoke($GLOBALS['hooks']['admin_post_nahan_local_upgrade']); assert_true(str_contains(render_tools($t),'financial upgrade: success'),'upgrade success visible');\n invoke($GLOBALS['hooks']['admin_post_nahan_local_preview']); invoke($GLOBALS['hooks']['admin_post_nahan_local_apply']); $html=render_tools($t); assert_true(str_contains($html,'profile / created / ID 301'),'completed profile visible'); assert_true(!str_contains($html,'unrevealed-random-password'),'no password rendered');\n $GLOBALS['current_user']=92; assert_true(!str_contains(render_tools($t),'financial upgrade: success'),'foreign upgrade hidden'); $GLOBALS['current_user']=91; $GLOBALS['options']['nahan_local_seed_last_result_91']['hash']='stale'; assert_true(!str_contains(render_tools($t),'profile / created / ID 301'),'stale result hidden');\n $GLOBALS['current_admin']=false; expect_denied(static fn()=>render_tools($t),'render requires manage_options');\n});\nscenario( 'repair never overwrites nonempty edited content terms or publication', function () {\n seed_all(); $p=$GLOBALS['posts'][0]; $p->post_title='Edited'; $p->post_content='Edited bio'; $p->post_status='pending'; $p->post_name='edited-slug'; $GLOBALS['assignments'][$p->ID]['city']=[999]; $GLOBALS['assignments'][$p->ID]['job_category']=[998]; unset($GLOBALS['post_meta'][$p->ID]['user']);\n assert_same('success',seed_all()['status'],'repair succeeds'); assert_same(['Edited','Edited bio','pending','edited-slug'],[$p->post_title,$p->post_content,$p->post_status,$p->post_name],'all content untouched'); assert_same([999],$GLOBALS['assignments'][$p->ID]['city'],'edited city preserved'); assert_same([998],$GLOBALS['assignments'][$p->ID]['job_category'],'edited category preserved');\n});\n// Fix round 1: real WP `any` excludes records that uniqueness must still inspect.\nforeach ( ['trash','auto-draft','inherit','fixture-internal'] as $status ) foreach ( ['unmarked-authored','unmarked-reverse','duplicate-marker'] as $kind ) foreach ( ['preview','apply'] as $operation ) scenario( 'all statuses fail closed ' . $status . ' ' . $kind . ' ' . $operation, function () use ( $status, $kind, $operation ) {\n seed_all(); $service=new LocalSeedService(gate()); $valid=$service->preview(); $original=$GLOBALS['posts'][0]; $account=$original->post_author;\n unset($GLOBALS['user_meta'][$account]['nahan_specialist_post']);\n if ('duplicate-marker' === $kind) {\n  $hidden=clone $original; $hidden->ID=999; $hidden->post_author=999; $hidden->post_name='hidden-other-slug'; $hidden->post_status=$status; $GLOBALS['posts'][]=$hidden; $GLOBALS['post_meta'][999]=['_nahan_local_seed_id'=>LocalSeedManifest::all()['users'][1]['profile']['seed_id']];\n } else {\n  $original->post_status=$status; $original->post_name='hidden-unmarked-other-slug'; unset($GLOBALS['post_meta'][$original->ID]['_nahan_local_seed_id']);\n  if ('unmarked-reverse' === $kind) { $original->post_author=999; $GLOBALS['post_meta'][$original->ID]['user']=(string)$account; } else { unset($GLOBALS['post_meta'][$original->ID]['user']); }\n }\n $before=$GLOBALS['writes']; $material=serialize([$GLOBALS['posts'],$GLOBALS['post_meta'],$GLOBALS['user_meta']]);\n if ('preview' === $operation) expect_denied(static fn()=>$service->preview(),'hidden ownership conflict must reject preview');\n else expect_denied(static fn()=>$service->apply($valid['version'],$valid['hash'],LocalSeedService::CONFIRMATION),'hidden ownership conflict must reject explicit apply');\n assert_same($before,$GLOBALS['writes'],'hidden conflict zero writes'); assert_same($material,serialize([$GLOBALS['posts'],$GLOBALS['post_meta'],$GLOBALS['user_meta']]),'no restore, republish or linkage edits');\n});\necho \"Task 7A: $passed passed; $failed failed\\n\"; exit( $failed ? 1 : 0 );\n"
    }
  }
}