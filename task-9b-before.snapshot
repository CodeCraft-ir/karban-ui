l_route('/profile/me','GET'))===403,'client profile denied');\nreset_fixture();$GLOBALS['uid']=0;check(status(call_route('/profile/me','GET'))===401,'anonymous profile denied');\nreset_fixture();$GLOBALS['uid']=3;check(status(call_route('/profile/me','GET'))===403,'admin without cap denied');\nreset_fixture();check(status(call_route('/account/me','POST',['display_name'=>'Name \\\\ path']))===200 && get_userdata(1)->display_name==='Name \\\\ path','account preserves backslash');\nreset_fixture();$GLOBALS['uid']=2;check(status(call_route('/profile/me','POST',['bio'=>'Bio \\\\ path']))===200 && get_post_meta(20,'bio')==='Bio \\\\ path','profile preserves backslash');\nreset_fixture();$GLOBALS['uid']=2;$GLOBALS['um'][2]['nahan_specialist_post']='20tampered';check(status(call_route('/profile/me','GET'))===409,'noncanonical pointer rejected');\nreset_fixture();$GLOBALS['uid']=2;$GLOBALS['pm'][20]['user']='2tampered';check(status(call_route('/profile/me','GET'))===409,'noncanonical backlink rejected');\nreset_fixture();$GLOBALS['uid']=2;$r=call_route('/account/me','GET');check(status($r)===200 && $r->data['data']['specialist']['id']===20,'pro account linkage');\nreset_fixture();$GLOBALS['uid']=2;unset($GLOBALS['um'][2]['nahan_specialist_post']);check(status(call_route('/profile/me','GET'))===404,'no implicit owner adoption');\nreset_fixture();$GLOBALS['uid']=2;check(status(call_route('/profile/me','POST',['bio'=>str_repeat('x',4001)]))===422,'bounded bio');\nreset_fixture();check(status(call_route('/account/me','POST',['display_name'=>\"bad\\x01name\"]))===422,'control chars rejected');\nforeach(['kashan','meshkat','barzok','niasar','qamsar','jowshaqan-qali','kamu-va-chugan'] as $slug){reset_fixture();$GLOBALS['terms'][10]->slug=$slug;$GLOBALS['tm'][10]=['_nahan_location_county'=>'kashan','_nahan_location_kind'=>'city'];check(status(call_route('/account/me','POST',['account_city_id'=>10]))===200,'seven-city metadata accepted '.$slug);}\nreset_fixture();$GLOBALS['terms'][10