      "text": "<?php\n/** Actual OTP verify callback provisioning contract. No WP bootstrap/DB/network. */\ndeclare(strict_types=1);\nnamespace Nahan\\Core { final class Plugin {public static $test;public static function instance(){return self::$test;}} }\nnamespace {\ndefine('ABSPATH',__DIR__.'/');define('NAHAN_CORE_DIR',rtrim($argv[1]??'','/').'/');\nclass WP_Error {public function __construct(private $c,private $m='',private $d=[]){}public function get_error_code(){return $this->c;}public function get_error_message(){return $this->m;}public function get_error_data(){return $this->d;}}\nclass WP_REST_Response {public function __construct(public $data,public $status=200){}}\nclass WP_User {public function __construct(public $ID,public $display_name,public $roles,public $user_login='') {}}\nclass Request {public function __construct(private $params=[]){}public function get_param($k){return $this->params[$k]??null;}}\nfunction is_wp_error($v){return $v instanceof WP_Error;}\nfunction register_rest_route($ns,$path,$args){$GLOBALS['routes'][$path]=$args;}\nfunction wp_slash($v){return is_string($v)?addslashes($v):(is_array($v)?array_map('wp_slash',$v):$v);}\nfunction get_users($args){$GLOBALS['user_query']=$args;return array_values(array_filter($GLOBALS['users'],fn($u)=>(string)get_user_meta($u->ID,$args['meta_key'],true)===(string)$args['meta_value']));}\nfunction get_userdata($id){return $GLOBALS['users'][$id]??null;}\nfunction get_user_meta($id,$key,$single=true){return $GLOBALS['um'][$id][$key]??'';}\nfunction update_user_meta($id,$key,$value){if($GLOBALS['fail']===$key)return false;if(get_user_meta($id,$key)===$value)return false;$GLOBALS['um'][$id][$key]=$value;return 1;}\nfunction get_post($id){return $GLOBALS['posts'][$id]??null;}\nfunction get_post_meta($id,$key,$single=true){return $GLOBALS['pm'][$id][$key]??'';}\nfunction update_post_meta($id,$key,$value){if($GLOBALS['fail']===$key)return false;if(get_post_meta($id,$key)===$value)return false;$GLOBALS['pm'][$id][$key]=$value;return 1;}\nfunction get_post_stati(){return array_fill_keys(['draft','pending','publish','private','future','trash','auto-draft','inherit','custom'],true);}\nfunction get_posts($args){$GLOBALS['post_queries'][]=$args;return array_values(array_filter($GLOBALS['posts'],function($p)use($args){if($p->post_type!==$args['post_type'])return false;if(isset($args['author'])&&(int)$p->post_author!==$args['author'])return false;if(isset($args['meta_key'])&&(string)get_post_meta($p->ID,$args['meta_key'])!==(string)$args['meta_value'])return false;return true;}));}\nfunction wp_insert_post($args,$error=false){$GLOBALS['insert_post_error_flag']=$error;if($GLOBALS['fail']==='post-error')return new WP_Error('sensitive-db','PRIVATE SQL');if($GLOBALS['fail']==='post-zero')return 0;$id=100+count($GLOBALS['posts']);$GLOBALS['posts'][$id]=(object)array_merge(['ID'=>$id,'post_name'=>'','post_password'=>''],$args);return $id;}\nfunction wp_generate_password($length=12,$special=true,$extra=false){return str_repeat('p',$length);}\nfunction wp_insert_user($args){$GLOBALS['created_users']++;if(strlen($args['user_login'])>60)return new WP_Error('user_login_too_long');if($GLOBALS['fail']==='insert-user')return new WP_Error('db','PRIVATE SQL');$id=10+count($GLOBALS['users']);$GLOBALS['users'][$id]=new WP_User($id,$args['display_name'],[$args['role']],$args['user_login']);return $id;}\nfunction username_exists($name){foreach($GLOBALS['users'] as $u)if($u->user_login===$name)return $u->ID;return false;}\nfunction add_option($key,$value,$deprecated='',$autoload=true){if($GLOBALS['lock_busy']||isset($GLOBALS['options'][$key]))return false;$GLOBALS['options'][$key]=$value;return true;}\nfunction delete_option($key){if(!isset($GLOBALS['options'][$key]))return false;unset($GLOBALS['options'][$key]);return true;}\nfunction get_option($key,$default=false){return $GLOBALS['options'][$key]??$default;}\nfunction check($v,$m){if(!$v)throw new RuntimeException($m);$GLOBALS['assertions']=($GLOBALS['assertions']??0)+1;}\nfunction reset_fixture(){\n $GLOBALS['users']=[];$GLOBALS['um']=[];$GLOBALS['posts']=[];$GLOBALS['pm']=[];$GLOBALS['options']=[];$GLOBALS['fail']='';$GLOBALS['created_users']=0;$GLOBALS['issued']=0;$GLOBALS['lock_busy']=false;$GLOBALS['post_queries']=[];\n \\Nahan\\Core\\Plugin::$test=(object)['otp'=>new class {public function verify_with_context($t,$code,$before){$context=['phone'=>'09123456789','delivery_mode'=>'local_simulated','code_length'=>6];$result=$before($context);return is_wp_error($result)?$result:$context;}},'jwt'=>new class {public function validate_context_for_issuance($ctx){$GLOBALS['validated_context']=$ctx;return true;}public function issue_pair($uid,$device,$ctx){$GLOBALS['issued']++;$GLOBALS['issued_context']=$ctx;return ['access_token'=>'fixture','refresh_token'=>'fixture'];}}];\n}\nfunction verify($role='specialist'){return ($GLOBALS['routes']['/auth/otp/verify']['callback'])(new Request(['tracking_code'=>'fixture','code'=>'145632','role'=>$role,'delivery_mode'=>'sms']));}\nfunction existing($role='nahan_specialist'){ $GLOBALS['users'][2]=new WP_User(2,'Existing',[$role]);$GLOBALS['um'][2]['nahan_phone']='09123456789';}\nrequire NAHAN_CORE_DIR.'includes/class-autoloader.php';\\Nahan\\Core\\Autoloader::register();require NAHAN_CORE_DIR.'rest-api/class-rest-helper.php';require NAHAN_CORE_DIR.'rest-api/auth-routes.php';\nforeach(['post-error','post-zero','insert-user','nahan_phone','user','nahan_specialist_post'] as $failure){reset_fixture();$GLOBALS['fail']=$failure;$r=verify();check($r->status>=400,'provisioning failure '.$failure);check($GLOBALS['issued']===0,'noJWT after '.$failure);check(!str_contains(json_encode($r->data),'PRIVATE SQL'),'safe failure');}\nreset_fixture();$r=verify();check($r->status===200 && $GLOBALS['issued']===1,'new specialist succeeds');$uid=$r->data['data']['user']['id'];$sid=get_user_meta($uid,'nahan_specialist_post');check($sid>0 && get_post_meta($sid,'user')===$uid && (int)get_post($sid)->post_author===$uid,'checked links');check($GLOBALS['insert_post_error_flag']===true,'wp_insert_post checked WP_Error mode');check(get_post_meta($sid,'phone_display')==='','login phone not copied');check(get_post($sid)->post_status==='draft','no publication');check(get_post($sid)->post_name!=='','stable server slug on provisioning');check($GLOBALS['issued_context']===$GLOBALS['validated_context'] && $GLOBALS['issued_context']['delivery_mode']==='local_simulated','trusted context preserved');\n$again=verify('client');check($again->data['data']['user']['id']===$uid && $again->data['data']['user']['roles']===['nahan_specialist'],'existing role immutable');check(count($GLOBALS['posts'])===1,'retry same profile');\nreset_fixture();existing('nahan_client');$r=verify();check($r->status===200 && $r->data['data']['user']['roles']===['nahan_client'] && !$GLOBALS['posts'],'client unchanged by intent');\nreset_fixture();existing();$r=verify('client');check($r->status===200 && count($GLOBALS['posts'])===1,'existing specialist missing profile repaired by own role');\nreset_fixture();$GLOBALS['fail']='nahan_specialist_post';$r=verify();check(count($GLOBALS['users'])===1 && count($GLOBALS['posts'])===1 && $GLOBALS['issued']===0,'partial account/profile retained');$GLOBALS['fail']='';$r=verify();check($r->status===200 && count($GLOBALS['users'])===1 && count($GLOBALS['posts'])===1,'partial pointer safely repaired');\nreset_fixture();$GLOBALS['fail']='user';$r=verify();check($GLOBALS['issued']===0,'failed user creation blocks JWT');\nreset_fixture();existing();$GLOBALS['fail']='user';$r=verify();check($GLOBALS['issued']===0 && count($GLOBALS['posts'])===1,'backlink partial blocksJWT');$GLOBALS['fail']='';$r=verify();check($r->status===200 && count($GLOBALS['posts'])===1,'marked backlink partial repair');\nreset_fixture();$GLOBALS['fail']='nahan_phone';verify();$GLOBALS['fail']='';$r=verify();check($r->status===409 && count($GLOBALS['users'])===1,'orphan username conflict not duplicate identity');\nreset_fixture();existing();$GLOBALS['users'][3]=new WP_User(3,'Duplicate',['nahan_client']);$GLOBALS['um'][3]['nahan_phone']='09123456789';$r=verify();check($r->status===409 && $GLOBALS['issued']===0,'duplicate phone conflict');\nreset_fixture();$GLOBALS['lock_busy']=true;$r=verify();check($r->status===409 && $GLOBALS['created_users']===0 && $GLOBALS['issued']===0,'concurrent registration fails conflict');\nforeach(['foreign-author','foreign-backlink','wrong-cpt','corrupt-pointer','reverse-claim','duplicate-profile','trash'] as $case){reset_fixture();existing();$GLOBALS['posts'][20]=(object)['ID'=>20,'post_type'=>'nahan_specialist','post_author'=>2,'post_status'=>'draft','post_name'=>'stable','post_password'=>''];$GLOBALS['pm'][20]['user']=2;$GLOBALS['um'][2]['nahan_specialist_post']=20;\n if($case==='foreign-author')$GLOBALS['posts'][20]->post_author=3;\n if($case==='foreign-backlink')$GLOBALS['pm'][20]['user']=3;\n if($case==='wrong-cpt')$GLOBALS['posts'][20]->post_type='page';\n if($case==='corrupt-pointer')$GLOBALS['um'][2]['nahan_specialist_post']='20wrong';\n if($case==='reverse-claim'){$GLOBALS['users'][3]=new WP_User(3,'Foreign',['nahan_specialist']);$GLOBALS['um'][3]['nahan_specialist_post']=20;}\n if($case==='duplicate-profile'){$GLOBALS['posts'][21]=clone $GLOBALS['posts'][20];$GLOBALS['posts'][21]->ID=21;$GLOBALS['pm'][21]['user']=2;}\n if($case==='trash')$GLOBALS['posts'][20]->post_status='trash';\n $r=verify();check($r->status===409 && $GLOBALS['issued']===0,'invalid provisioning ownership '.$case);\n}\nreset_fixture();$r=verify('client');check($r->status===200 && $r->data['data']['user']['roles']===['nahan_client'] && count($GLOBALS['posts'])===0,'new client account complete without profile');check(count($GLOBALS['options'])===0,'lock released after success');\nreset_fixture();existing();$GLOBALS['fail']='_nahan_registration_owner';$r=verify();check($r->status===503 && $GLOBALS['issued']===0,'marker write failure blocksJWT');$GLOBALS['fail']='';$r=verify();check($r->status===409 && count($GLOBALS['posts'])===1,'unmarked partial is not auto adopted or duplicated');\nreset_fixture();existing();$GLOBALS['posts'][20]=(object)['ID'=>20,'post_type'=>'nahan_specialist','post_author'=>2,'post_status'=>'pending','post_name'=>'edited-slug','post_password'=>''];$GLOBALS['pm'][20]['user']=2;$r=verify('client');check($r->status===200 && get_user_meta(2,'nahan_specialist_post')===20 && count($GLOBALS['posts'])===1,'unique owned valid profile recovered');check(get_post(20)->post_name==='edited-slug' && get_post(20)->post_status==='pending','recovery preserves content state');\nreset_fixture();existing();$GLOBALS['users'][2]->roles=['nahan_specialist','administrator'];$r=verify();check($r->status===409 && $GLOBALS['issued']===0 && $GLOBALS['users'][2]->roles===['nahan_specialist','administrator'],'mixed role fails without mutation');\nforeach(['custom','trash','auto-draft','inherit'] as $state){reset_fixture();existing();$GLOBALS['posts'][20]=(object)['ID'=>20,'post_type'=>'nahan_specialist','post_author'=>2,'post_status'=>$state,'post_name'=>'stable','post_password'=>''];$GLOBALS['pm'][20]['user']=2;$r=verify();check($r->status===409 && count($GLOBALS['posts'])===1 && $GLOBALS['issued']===0,'all registered statuses fail closed '.$state);}\necho 'PASS task7B provisioning '.$GLOBALS['assertions'].\" assertions\\n\";\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/tests/wordpress/task-4a2-credential-provenance.test.php": {
      "sha256": "a3ac1605c6d4be3dd3678559a5d1c150546caf9171bd48ee01c47392fd06dfe5",
      "text": "<?php\n/**\n * Standalone Task 4A2 source-stub tests. No WordPress bootstrap, database, SMS, or network.\n * Run: php tests/wordpress/task-4a2-credential-provenance.test.php\n */\ndeclare( strict_types=1 );\n\nnamespace {\n\tdefine( 'ABSPATH', __DIR__ . '/' );\n\tdefine( 'ARRAY_A', 'ARRAY_A' );\n\tdefine( 'NAHAN_CORE_DIR', '/Applications/XAMPP/xamppfiles/htdocs/karban/wp-content/plugins/karban-core/' );\n\n\tfinal class WP_Error {\n\t\tpublic function __construct( public string $code = '', public string $message = '', public array $data = [] ) {}\n\t\tpublic function get_error_code(): string { return $this->code; }\n\t\tpublic function get_error_message(): string { return $this->message; }\n\t\tpublic function get_error_data(): array { return $this->data; }\n\t}\n\tfinal class WP_REST_Response {\n\t\tpublic function __construct( public array $data, public int $status = 200 ) {}\n\t}\n\tfinal class WP_User {\n\t\tpublic function __construct( public int $ID, public string $display_name, public array $roles ) {}\n\t}\n\tfinal class TestRequest {\n\t\tpublic function __construct( private array $params ) {}\n\t\tpublic function get_param( string $key ): mixed { return $this->params[ $key ] ?? null; }\n\t\tpublic function get_params(): array { return $this->params; }\n\t}\n\tfunction is_wp_error( mixed $value ): bool { return $value instanceof WP_Error; }\n\tfunction wp_json_encode( mixed $value ): string { return json_encode( $value, JSON_THROW_ON_ERROR ); }\n\tfunction wp_parse_url( string $url ): array|false { return parse_url( $url ); }\n\tfunction sanitize_text_field( string $value ): string { return $value; }\n\tfunction wp_unslash( string $value ): string { return $value; }\n\tfunction current_time( string $type, bool $gmt = false ): string { return '2026-10-18 00:00:00'; }\n\tfunction wp_get_environment_type(): string { return 'production'; }\n\tfunction get_option( string $key, mixed $default = false ): mixed { global $test_options; return $test_options[ $key ] ?? $default; }\n\tfunction update_option( string $key, mixed $value ): bool { global $test_options; $test_options[ $key ] = $value; return true; }\n\tfunction get_transient( string $key ): mixed { return false; }\n\tfunction set_transient( string $key, mixed $value, int $seconds ): bool { return true; }\n\tfunction delete_transient( string $key ): bool { return true; }\n\tfunction dbDelta( string $sql ): array { global $db_delta_calls; $db_delta_calls[] = $sql; return []; }\n\tfunction get_bloginfo( string $show = '' ): string { global $test_options; return (string) ( $test_options['siteurl'] ?? '' ); }\n\tfunction __return_true(): bool { return true; }\n\tfunction register_rest_route( string $namespace, string $route, array $definition ): bool { global $registered_routes; $registered_routes[ $route ] = $definition; return true; }\n\tfunction get_users( array $args ): array { global $test_users; return $test_users; }\n\tfunction wp_generate_password( int $length = 12, bool $special_chars = true, bool $extra_special_chars = false ): string { return str_repeat( 'p', $length ); }\n\tfunction wp_insert_user( array $data ): int { global $user_insert_calls; $user_insert_calls++; return 77; }\n\tfunction update_user_meta( int $user_id, string $key, mixed $value ): bool { return true; }\n\tfunction get_userdata( int $user_id ): ?WP_User { global $test_users; return $test_users[0] ?? null; }\n\tfunction wp_insert_post( array $data ): int { return 88; }\n\tfunction update_post_meta( int $post_id, string $key, mixed $value ): bool { return true; }\n\n\tfinal class TestWpdb {\n\t\tpublic string $prefix = 'wp_';\n\t\t/** @var list<string> */ public array $queries = [];\n\t\t/** @var list<array{table:string,data:array}> */ public array $inserts = [];\n\t\t/** @var list<array{query:string,args:list<mixed>}> */ public array $prepare_calls = [];\n\t\t/** @var list<array{table:string,data:array,where:array}> */ public array $updates = [];\n\t\tpublic array $credential_columns = [ 'id', 'user_id', 'token_hash', 'device_id', 'user_agent', 'ip_address', 'created_at', 'expires_at', 'revoked_at', 'credential_mode', 'installation_origin', 'otp_code_length' ];\n\t\tpublic array $otp_columns = [ 'id', 'phone', 'code_hash', 'tracking_code', 'attempts', 'ip_address', 'user_agent', 'created_at', 'expires_at', 'consumed_at', 'delivery_mode', 'code_length' ];\n\t\tpublic string $refresh_engine = 'InnoDB';\n\t\tpublic ?array $refresh_row = null;\n\t\tpublic ?array $otp_row = null;\n\t\tpublic int|false $insert_result = 1;\n\t\t/** @var list<int|false> */ public array $insert_results = [];\n\t\tpublic int|false $start_result = 1;\n\t\tpublic int|false $commit_result = 1;\n\t\tpublic int|false $cas_result = 1;\n\t\tpublic int $ambient_transaction = 0;\n\t\tpublic ?string $throw_on_query = null;\n\t\tpublic int $rollback_count = 0;\n\t\tpublic string $last_error = '';\n\t\tpublic function prepare( string $query, mixed ...$args ): string { $this->prepare_calls[] = [ 'query' => $query, 'args' => $args ]; return $query; }\n\t\tpublic function get_col( string $query, mixed $column = 0 ): array { return str_contains( $query, 'refresh_tokens' ) ? $this->credential_columns : $this->otp_columns; }\n\t\tpublic function get_var( string $query ): mixed { return str_contains( $query, '@@session.in_transaction' ) ? $this->ambient_transaction : null; }\n\t\tpublic function get_row( string $query, mixed $output = null ): ?array { if ( str_contains( $query, 'SHOW TABLE STATUS' ) ) return [ 'Engine' => $this->refresh_engine ]; return str_contains( $query, 'otp_codes' ) ? $this->otp_row : $this->refresh_row; }\n\t\tpublic function insert( string $table, array $data, ?array $format = null ): int|false { $this->inserts[] = compact( 'table', 'data' ); return $this->insert_results ? array_shift( $this->insert_results ) : $this->insert_result; }\n\t\tpublic function query( string $query ): int|false {\n\t\t\t$this->queries[] = $query;\n\t\t\tif ( $this->throw_on_query === $query ) throw new \\RuntimeException( 'synthetic database exception' );\n\t\t\tif ( 'START TRANSACTION' === $query ) return $this->start_result;\n\t\t\tif ( 'COMMIT' === $query ) return $this->commit_result;\n\t\t\tif ( 'ROLLBACK' === $query ) { $this->rollback_count++; return 1; }\n\t\t\tif ( str_contains( $query, 'UPDATE' ) && str_contains( $query, 'revoked_at' ) ) return $this->cas_result;\n\t\t\tif ( str_contains( $query, 'consumed_at' ) ) return 1;\n\t\t\treturn 1;\n\t\t}\n\t\tpublic function update( string $table, array $data, array $where, ?array $format = null, ?array $where_format = null ): int|false { $this->updates[] = compact( 'table', 'data', 'where' ); return $this->cas_result; }\n\t\tpublic function delete( string $table, array $where, ?array $format = null ): int|false { return 1; }\n\t\tpublic function get_charset_collate(): string { return ''; }\n\t}\n\n\tfunction reset_fixture(): TestWpdb {\n\t\tglobal $wpdb, $test_options, $registered_routes, $db_delta_calls, $test_users, $user_insert_calls, $_SERVER;\n\t\t$test_options = [\n\t\t\t'nahan_jwt_secret' => str_repeat( 'a', 48 ),\n\t\t\t'nahan_jwt_access_ttl' => 900,\n\t\t\t'nahan_jwt_refresh_ttl' => 3600,\n\t\t\t'siteurl' => 'http://localhost:8080/karban/',\n\t\t\t'nahan_otp_max_attempts' => 5,\n\t\t];\n\t\t$registered_routes = []; $db_delta_calls = []; $user_insert_calls = 0;\n\t\t$test_users = [ new WP_User( 41, 'Existing user', [ 'client' ] ) ];\n\t\t$_SERVER = [ 'REMOTE_ADDR' => '127.0.0.1' ];\n\t\t$wpdb = new TestWpdb();\n\t\treturn $wpdb;\n\t}\n\tfunction assert_true( bool $condition, string $message ): void { if ( ! $condition ) throw new \\RuntimeException( $message ); }\n\tfunction assert_same( mixed $expected, mixed $actual, string $message ): void { if ( $expected !== $actual ) throw new \\RuntimeException( $message . \"\\nExpected: \" . var_export( $expected, true ) . \"\\nActual: \" . var_export( $actual, true ) ); }\n\tfunction assert_error( mixed $actual, string $code, int $status, string $message ): void { assert_true( $actual instanceof WP_Error, $message . ' must be a WP_Error.' ); assert_same( $code, $actual->get_error_code(), $message . ' code' ); assert_same( $status, $actual->get_error_data()['status'] ?? null, $message . ' status' ); }\n\tfunction jwt_payload( string $jwt ): array { $part = explode( '.', $jwt )[1] ?? ''; $part .= str_repeat( '=', ( 4 - strlen( $part ) % 4 ) % 4 ); return json_decode( base64_decode( strtr( $part, '-_', '+/' ) ), true, 512, JSON_THROW_ON_ERROR ); }\n}\n\nnamespace Nahan\\Core {\n\tfinal class Plugin {\n\t\tpublic static object $test_instance;\n\t\tpublic static function instance(): object { return self::$test_instance; }\n\t}\n}\n\nnamespace Nahan\\Core\\Auth {\n\trequire_once NAHAN_CORE_DIR . 'includes/class-helpers.php';\n\trequire_once NAHAN_CORE_DIR . 'includes/class-rate-limiter.php';\n\trequire_once NAHAN_CORE_DIR . 'includes/admin/class-settings.php';\n\trequire_once NAHAN_CORE_DIR . 'includes/class-local-development-gate.php';\n\trequire_once NAHAN_CORE_DIR . 'includes/auth/class-otp-schema.php';\n\trequire_once NAHAN_CORE_DIR . 'includes/auth/class-credential-schema.php';\n\trequire_once NAHAN_CORE_DIR . 'includes/auth/class-sms-service.php';\n\trequire_once NAHAN_CORE_DIR . 'includes/auth/class-otp-manager.php';\n\trequire_once NAHAN_CORE_DIR . 'includes/auth/class-jwt-auth.php';\n\trequire_once NAHAN_CORE_DIR . 'rest-api/class-rest-helper.php';\n\n\tuse Nahan\\Core\\Admin\\Settings;\n\tuse Nahan\\Core\\LocalDevelopmentGate;\n\n\tfunction local_gate( array $overrides = [] ): LocalDevelopmentGate {\n\t\treturn new LocalDevelopmentGate( array_merge( [\n\t\t\t'local_development' => true, 'local_dev_otp' => true, 'environment_type' => 'local',\n\t\t\t'site_url' => 'http://localhost:8080/karban/', 'remote_addr' => '127.0.0.1',\n\t\t], $overrides ) );\n\t}\n\tfunction otp_row( array $overrides = [] ): array {\n\t\treturn array_merge( [ 'id' => 7, 'phone' => '09121234567', 'code_hash' => hash( 'sha256', '145632' ), 'tracking_code' => 'trusted', 'attempts' => 0, 'expires_at' => '2099-01-01 00:00:00', 'consumed_at' => null, 'delivery_mode' => 'local_simulated', 'code_length' => 6 ], $overrides );\n\t}\n\tfunction jwt( LocalDevelopmentGate $gate ): JwtAuth { return new JwtAuth( new Settings(), $gate, new CredentialSchema() ); }\n\n\t$tests = [];\n\t$tests['legacy SMS credentials stay compatible without provenance columns'] = static function (): void {\n\t\t$wpdb = \\reset_fixture();\n\t\t$wpdb->credential_columns = [ 'id' ];\n\t\t$pair = jwt( local_gate() )->issue_pair( 41, 'device', [ 'delivery_mode' => 'sms', 'code_length' => 5 ] );\n\t\tassert_true( ! \\is_wp_error( $pair ), 'Normal legacy SMS issuance must not require the local credential migration.' );\n\t\tassert_same( 'access', jwt_payload( $pair['access_token'] )['type'], 'Normal token type.' );\n\t\tassert_true( ! isset( $wpdb->inserts[0]['data']['installation_origin'] ), 'Legacy SMS refresh insert must remain compatible with an old table.' );\n\t};\n\t$tests['trusted OTP context alone produces signed local provenance'] = static function (): void {\n\t\t$wpdb = \\reset_fixture();\n\t\t$wpdb->otp_row = otp_row();\n\t\t$manager = new OtpManager( new SmsService( new Settings() ), local_gate() );\n\t\t$context = $manager->verify_with_context( 'trusted', '145632' );\n\t\tassert_true( ! \\is_wp_error( $context ), 'Persisted local OTP must return trusted context.' );\n\t\tassert_same( [ 'phone' => '09121234567', 'delivery_mode' => 'local_simulated', 'code_length' => 6 ], $context, 'Context must contain only persisted OTP fields.' );\n\t\t$pair = jwt( local_gate() )->issue_pair( 41, 'device', $context );\n\t\tassert_true( ! \\is_wp_error( $pair ), 'Trusted local context must issue a pair.' );\n\t\t$claims = jwt_payload( $pair['access_token'] );\n\t\tassert_same( 'local_simulated', $claims['credential_mode'] ?? null, 'Local access JWT must carry signed provenance.' );\n\t\tassert_same( 'http://localhost:8080/karban', $claims['installation_origin'] ?? null, 'Local access JWT must carry canonical origin.' );\n\t\t$refresh = $wpdb->inserts[0]['data'];\n\t\tassert_same( 'local_simulated', $refresh['credential_mode'] ?? null, 'Refresh row must store local provenance.' );\n\t\tassert_same( 'http://localhost:8080/karban', $refresh['installation_origin'] ?? null, 'Refresh row must store canonical origin.' );\n\t\tassert_same( 6, $refresh['otp_code_length'] ?? null, 'Refresh row must retain trusted OTP length.' );\n\t};\n\t$tests['local verification can reject unavailable credentials before atomic consume'] = static function (): void {\n\t\t$wpdb = \\reset_fixture(); $wpdb->otp_row = otp_row(); $wpdb->credential_columns = [ 'id' ];\n\t\t$manager = new OtpManager( new SmsService( new Settings() ), local_gate() );\n\t\t$result = $manager->verify_with_context( 'trusted', '145632', static function ( array $context ) { return jwt( local_gate() )->validate_context_for_issuance( $context ); } );\n\t\tassert_error( $result, 'local_credentials_unavailable', 503, 'Missing credential schema must stop public local verification before consume.' );\n\t\tassert_true( ! array_filter( $wpdb->queries, static fn( string $q ): bool => str_contains( $q, 'consumed_at =' ) ), 'Unavailable local credentials must not consume a valid challenge.' );\n\t};\n\t$tests['local gate and canonical installation bind decode and refresh but not secret logout'] = static function (): void {\n\t\t$wpdb = \\reset_fixture();\n\t\t$pair = jwt( local_gate() )->issue_pair( 41, 'device', [ 'phone' => '09121234567', 'delivery_mode' => 'local_simulated', 'code_length' => 6 ] );\n\t\t$claims = jwt( local_gate( [ 'local_dev_otp' => false ] ) )->decode( $pair['access_token'] );\n\t\tassert_error( $claims, 'jwt_local_unavailable', 401, 'Local access must fail after gate off.' );\n\t\t$claims = jwt( local_gate( [ 'site_url' => 'http://localhost:8081/karban' ] ) )->decode( $pair['access_token'] );\n\t\tassert_error( $claims, 'jwt_local_unavailable', 401, 'Local access must fail after installation-origin change.' );\n\t\t$wpdb->refresh_row = [ 'id' => 9, 'user_id' => 41, 'device_id' => 'device', 'expires_at' => '2099-01-01 00:00:00', 'revoked_at' => null, 'credential_mode' => 'local_simulated', 'installation_origin' => 'http://localhost:8080/karban', 'otp_code_length' => 6 ];\n\t\tassert_error( jwt( local_gate( [ 'environment_type' => 'production' ] ) )->refresh( $pair['refresh_token'] ), 'invalid_refresh', 401, 'Copied/deactivated local refresh must fail.' );\n\t\tassert_true( jwt( local_gate( [ 'environment_type' => 'production' ] ) )->logout_refresh( $pair['refresh_token'] ), 'Raw refresh secret must still revoke its matching old row after access becomes unusable.' );\n\t};\n\t$tests['missing or weak signing secret causes no credential write'] = static function (): void {\n\t\tforeach ( [ '', 'too-short' ] as $secret ) {\n\t\t\t$wpdb = \\reset_fixture(); global $test_options; $test_options['nahan_jwt_secret'] = $secret;\n\t\t\t$result = jwt( local_gate() )->issue_pair( 41, 'device', [ 'delivery_mode' => 'local_simulated', 'code_length' => 6 ] );\n\t\t\tassert_error( $result, 'credentials_unavailable', 503, 'Invalid signer must fail safely.' );\n\t\t\tassert_same( [], $wpdb->inserts, 'Invalid signer must not create a refresh row.' );\n\t\t}\n\t};\n\t$tests['refresh insertion failure cannot mint a pair'] = static function (): void {\n\t\t$wpdb = \\reset_fixture(); $wpdb->insert_result = 0;\n\t\t$result = jwt( local_gate() )->issue_pair( 41 );\n\t\tassert_error( $result, 'credentials_unavailable', 503, 'Failed initial refresh insert must not return tokens.' );\n\t};\n\t$tests['refresh rotates through checked transaction CAS and rolls back every loser'] = static function (): void {\n\t\tforeach ( [ 'cas' => [ 'cas_result' => 0 ], 'insert' => [ 'insert_results' => [ 0 ] ], 'commit' => [ 'commit_result' => false ], 'engine' => [ 'refresh_engine' => 'MyISAM' ] ] as $case => $overrides ) {\n\t\t\t$wpdb = \\reset_fixture(); foreach ( $overrides as $property => $value ) { $wpdb->{$property} = $value; }\n\t\t\t$wpdb->refresh_row = [ 'id' => 9, 'user_id' => 41, 'device_id' => 'device', 'expires_at' => '2099-01-01 00:00:00', 'revoked_at' => null, 'credential_mode' => 'sms', 'installation_origin' => null, 'otp_code_length' => 5 ];\n\t\t\t$result = jwt( local_gate() )->refresh( 'raw-secret' );\n\t\t\tassert_true( \\is_wp_error( $result ), \"{$case} must not return a replacement pair.\" );\n\t\t\tassert_true( in_array( 'ROLLBACK', $wpdb->queries, true ) || 'engine' === $case, \"{$case} must rollback after transaction starts.\" );\n\t\t}\n\t};\n\t$tests['zero-result transaction commands are accepted only without an ambient transaction'] = static function (): void {\n\t\t$wpdb = \\reset_fixture(); $wpdb->start_result = 0; $wpdb->commit_result = 0;\n\t\t$wpdb->refresh_row = [ 'id' => 9, 'user_id' => 41, 'device_id' => 'device', 'expires_at' => '2099-01-01 00:00:00', 'revoked_at' => null, 'credential_mode' => 'sms', 'installation_origin' => null, 'otp_code_length' => 5 ];\n\t\t$result = jwt( local_gate() )->refresh( 'raw-secret' );\n\t\tassert_true( ! \\is_wp_error( $result ), 'WordPress may return zero rows for successful transaction-control statements.' );\n\t\t$wpdb = \\reset_fixture(); $wpdb->ambient_transaction = 1;\n\t\t$wpdb->refresh_row = [ 'id' => 9, 'user_id' => 41, 'device_id' => 'device', 'expires_at' => '2099-01-01 00:00:00', 'revoked_at' => null, 'credential_mode' => 'sms', 'installation_origin' => null, 'otp_code_length' => 5 ];\n\t\tassert_error( jwt( local_gate() )->refresh( 'raw-secret' ), 'refresh_unavailable', 503, 'An unowned ambient transaction must not be implicitly committed.' );\n\t\tassert_true( ! in_array( 'START TRANSACTION', $wpdb->queries, true ), 'Ambient transaction rejection must not issue START TRANSACTION.' );\n\t};\n\t$tests['successful refresh creates one replacement and query exceptions roll back safely'] = static function (): void {\n\t\t$wpdb = \\reset_fixture();\n\t\t$wpdb->refresh_row = [ 'id' => 9, 'user_id' => 41, 'device_id' => 'device', 'expires_at' => '2099-01-01 00:00:00', 'revoked_at' => null, 'credential_mode' => 'sms', 'installation_origin' => null, 'otp_code_length' => 5 ];\n\t\t$pair = jwt( local_gate() )->refresh( 'raw-secret' );\n\t\tassert_true( ! \\is_wp_error( $pair ) && 1 === count( $wpdb->inserts ), 'One winning rotation must create exactly one replacement pair/row.' );\n\t\tassert_true( in_array( 'COMMIT', $wpdb->queries, true ) && 0 === $wpdb->rollback_count, 'Winning rotation must commit without rollback.' );\n\t\t$wpdb = \\reset_fixture(); $wpdb->throw_on_query = 'COMMIT';\n\t\t$wpdb->refresh_row = [ 'id' => 9, 'user_id' => 41, 'device_id' => 'device', 'expires_at' => '2099-01-01 00:00:00', 'revoked_at' => null, 'credential_mode' => 'sms', 'installation_origin' => null, 'otp_code_length' => 5 ];\n\t\t$result = jwt( local_gate() )->refresh( 'raw-secret' );\n\t\tassert_error( $result, 'refresh_unavailable', 503, 'A database exception must not escape or return a pair.' );\n\t\tassert_same( 1, $wpdb->rollback_count, 'A database exception must roll back the refresh scope.' );\n\t};\n\t$tests['refresh rejects revoked and expired rows before any replacement'] = static function (): void {\n\t\tforeach ( [ [ 'revoked_at' => '2026-10-18 00:00:00', 'expires_at' => '2099-01-01 00:00:00' ], [ 'revoked_at' => null, 'expires_at' => '2020-01-01 00:00:00' ] ] as $state ) {\n\t\t\t$wpdb = \\reset_fixture(); $wpdb->refresh_row = array_merge( [ 'id' => 9, 'user_id' => 41, 'device_id' => 'device', 'credential_mode' => 'sms', 'installation_origin' => null, 'otp_code_length' => 5 ], $state );\n\t\t\tassert_true( \\is_wp_error( jwt( local_gate() )->refresh( 'raw-secret' ) ), 'Revoked/expired refresh must fail.' );\n\t\t\tassert_same( [], $wpdb->inserts, 'Revoked/expired refresh must create no replacement.' );\n\t\t}\n\t};\n\t$tests['credential schema readiness is versioned, verified, and refuses nontransactional storage'] = static function (): void {\n\t\t$wpdb = \\reset_fixture(); $schema = new CredentialSchema();\n\t\tassert_true( $schema->is_ready(), 'Complete InnoDB credential provenance schema must be ready.' );\n\t\t$wpdb->refresh_engine = 'MyISAM'; assert_true( ! $schema->is_ready(), 'Nontransactional refresh storage must be unavailable.' );\n\t\t$wpdb->refresh_engine = 'InnoDB'; $wpdb->credential_columns = [ 'id', 'credential_mode' ]; assert_true( ! $schema->is_ready(), 'Missing provenance columns must be unavailable.' );\n\t\tassert_true( str_contains( file_get_contents( NAHAN_CORE_DIR . 'includes/class-activator.php' ), 'CredentialSchema::create_table_sql' ), 'Fresh activation must use the reviewed credential schema generator.' );\n\t};\n\t$tests['local status exposes exactly safe readiness booleans and source registers guarded endpoint'] = static function (): void {\n\t\t$wpdb = \\reset_fixture();\n\t\t$status = jwt( local_gate() )->local_status();\n\t\tassert_same( [ 'otpReady' => true, 'credentialProvenanceReady' => true ], $status, 'Local readiness has exactly its two safe booleans.' );\n\t\tassert_error( jwt( local_gate( [ 'remote_addr' => '203.0.113.4' ] ) )->local_status(), 'local_status_unavailable', 404, 'Nonlocal status must not disclose readiness.' );\n\t\t$routes = file_get_contents( NAHAN_CORE_DIR . 'rest-api/auth-routes.php' );\n\t\tassert_true( str_contains( $routes, \"'/auth/local-status'\" ) && str_contains( $routes, \"'GET'\" ), 'Read-only local status route must exist.' );\n\t\tassert_true( str_contains( $routes, \"'/auth/logout/refresh'\" ), 'Refresh-secret logout route must exist.' );\n\t};\n\t$tests['refresh-secret logout only targets its hash and rejects scope inputs'] = static function (): void {\n\t\t$wpdb = \\reset_fixture(); $wpdb->cas_result = 1;\n\t\tassert_true( jwt( local_gate() )->logout_refresh( 'raw-secret' ), 'A refresh secret must revoke its own hash.' );\n\t\tassert_true( 1 === count( $wpdb->updates ) && array_key_exists( 'token_hash', $wpdb->updates[0]['where'] ) && array_key_exists( 'revoked_at', $wpdb->updates[0]['where'] ), 'Logout must conditionally mutate only the supplied token hash.' );\n\t\t$routes = file_get_contents( NAHAN_CORE_DIR . 'rest-api/auth-routes.php' );\n\t\t$logout_start = strpos( $routes, \"'/auth/logout/refresh'\" );\n\t\t$logout_end = strpos( $routes, \"register_rest_route( \\$ns, '/auth/logout',\", $logout_start );\n\t\t$logout = substr( $routes, $logout_start, $logout_end - $logout_start );\n\t\tassert_true( str_contains( $logout, \"'refresh_token'\" ), 'Narrow logout accepts the refresh secret.' );\n\t\tassert_true( ! str_contains( $logout, \"'all_devices'\" ) && ! str_contains( $logout, \"'user_id'\" ), 'Narrow logout must not offer account-wide scope inputs.' );\n\t\t$wpdb->cas_result = false;\n\t\tassert_error( jwt( local_gate() )->logout_refresh( 'raw-secret' ), 'logout_unavailable', 503, 'DB error must not claim durable revocation.' );\n\t};\n\n\t$tests['callable schema upgrade records its version only after stubbed verification'] = static function (): void {\n\t\t$wpdb = \\reset_fixture(); global $test_options, $db_delta_calls;\n\t\tassert_true( ( new CredentialSchema() )->upgrade(), 'Explicit verified schema upgrade must succeed in the source stub.' );\n\t\tassert_same( CredentialSchema::VERSION, $test_options[ CredentialSchema::OPTION ] ?? null, 'Only verified upgrade records its version.' );\n\t\tassert_same( 1, count( $db_delta_calls ), 'Migration is callable but only executed by an explicit test/admin caller.' );\n\t};\n\t$tests['registered local status and refresh logout callbacks expose only their narrow contracts'] = static function (): void {\n\t\t$wpdb = \\reset_fixture();\n\t\t\\Nahan\\Core\\Plugin::$test_instance = (object) [ 'jwt' => jwt( local_gate() ) ];\n\t\trequire_once NAHAN_CORE_DIR . 'rest-api/auth-routes.php';\n\t\tglobal $registered_routes;\n\t\t$status_route = $registered_routes['/auth/local-status'] ?? null;\n\t\tassert_true( is_array( $status_route ) && true === $status_route['permission_callback'](), 'Local gate authorizes the readiness callback.' );\n\t\t$status = $status_route['callback']();\n\t\tassert_same( [ 'success' => true, 'data' => [ 'otpReady' => true, 'credentialProvenanceReady' => true ] ], $status->data, 'Status callback must return exactly safe readiness booleans.' );\n\t\t$logout_route = $registered_routes['/auth/logout/refresh'] ?? null;\n\t\t$logout = $logout_route['callback']( new \\TestRequest( [ 'refresh_token' => 'raw-secret' ] ) );\n\t\tassert_same( [ 'success' => true, 'data' => [ 'logged_out' => true ] ], $logout->data, 'Refresh-secret logout returns only a safe acknowledgement.' );\n\t\t$rejected = $logout_route['callback']( new \\TestRequest( [ 'refresh_token' => 'raw-secret', 'all_devices' => true ] ) );\n\t\tassert_same( 422, $rejected->status, 'Refresh-secret logout rejects scope-extending request fields.' );\n\t\t\\Nahan\\Core\\Plugin::$test_instance = (object) [ 'jwt' => jwt( local_gate( [ 'remote_addr' => '203.0.113.4' ] ) ) ];\n\t\t$denied = $status_route['permission_callback']();\n\t\tassert_error( $denied, 'local_status_unavailable', 404, 'Remote callers cannot query local readiness.' );\n\t};\n\n\t$tests['actual public OTP verify callback binds trusted local context before consume and handles issuance errors'] = static function (): void {\n\t\tglobal $registered_routes;\n\t\t$verify_route = $registered_routes['/auth/otp/verify'] ?? null;\n\t\tassert_true( is_array( $verify_route ), 'The registered public OTP verify callback must be available.' );\n\n\t\t$wpdb = \\reset_fixture(); $wpdb->credential_columns = [ 'id' ]; $wpdb->otp_row = otp_row();\n\t\t\\Nahan\\Core\\Plugin::$test_instance = (object) [ 'otp' => new OtpManager( new SmsService( new Settings() ), local_gate() ), 'jwt' => jwt( local_gate() ) ];\n\t\t$blocked = $verify_route['callback']( new \\TestRequest( [ 'tracking_code' => 'trusted', 'code' => '145632', 'role' => 'specialist', 'device_id' => 'from-body' ] ) );\n\t\tassert_same( 503, $blocked->status, 'Local credential readiness failure must be a public failure response.' );\n\t\tassert_same( 'local_credentials_unavailable', $blocked->data['error']['code'] ?? null, 'The pre-consume validator must be run on the actual callback path.' );\n\t\tassert_true( ! array_filter( $wpdb->queries, static fn( string $query ): bool => str_contains( $query, 'consumed_at =' ) ), 'Readiness failure must not consume the local OTP.' );\n\t\tglobal $user_insert_calls; assert_same( 0, $user_insert_calls, 'Readiness failure must not create an account.' );\n\n\t\t$wpdb = \\reset_fixture(); $wpdb->otp_row = otp_row();\n\t\t\\Nahan\\Core\\Plugin::$test_instance = (object) [ 'otp' => new OtpManager( new SmsService( new Settings() ), local_gate() ), 'jwt' => jwt( local_gate() ) ];\n\t\t$success = $verify_route['callback']( new \\TestRequest( [ 'tracking_code' => 'trusted', 'code' => '145632', 'role' => 'specialist', 'device_id' => 'from-body', 'delivery_mode' => 'sms' ] ) );\n\t\tassert_same( true, $success->data['success'] ?? null, 'Actual local OTP verification must issue a successful response.' );\n\t\tassert_same( false, $success->data['data']['is_new'] ?? null, 'Existing users must retain their account rather than re-register.' );\n\t\tassert_same( [ 'client' ], $success->data['data']['user']['roles'] ?? null, 'Existing role must stay unchanged despite a requested registration role.' );\n\t\t$pair = $success->data['data']['tokens'] ?? null;\n\t\tassert_true( is_array( $pair ), 'Actual callback must return a token pair, not a helper/error object.' );\n\t\t$claims = jwt_payload( $pair['access_token'] );\n\t\tassert_same( 'local_simulated', $claims['credential_mode'] ?? null, 'Request payload provenance must not override persisted local provenance.' );\n\t\tassert_same( 'http://localhost:8080/karban', $claims['installation_origin'] ?? null, 'Actual callback must carry canonical installation provenance.' );\n\t\tassert_error( jwt( local_gate( [ 'local_dev_otp' => false ] ) )->decode( $pair['access_token'] ), 'jwt_local_unavailable', 401, 'Gate-off must invalidate callback-issued local access credentials.' );\n\n\t\t$wpdb = \\reset_fixture(); $wpdb->otp_row = otp_row( [ 'delivery_mode' => 'sms', 'code_length' => 5, 'code_hash' => hash( 'sha256', '12345' ) ] ); $wpdb->insert_result = 0;\n\t\t\\Nahan\\Core\\Plugin::$test_instance = (object) [ 'otp' => new OtpManager( new SmsService( new Settings() ), local_gate() ), 'jwt' => jwt( local_gate() ) ];\n\t\t$issue_failed = $verify_route['callback']( new \\TestRequest( [ 'tracking_code' => 'trusted', 'code' => '12345', 'device_id' => 'from-body' ] ) );\n\t\tassert_same( 503, $issue_failed->status, 'An issue_pair WP_Error must become a failing REST envelope.' );\n\t\tassert_same( false, $issue_failed->data['success'] ?? null, 'Issue failure must not be encoded as success.' );\n\t\tassert_true( ! isset( $issue_failed->data['data']['tokens'] ), 'Issue failure response must not expose a tokens field.' );\n\t};\n\n\t$failed = 0;\n\tforeach ( $tests as $name => $test ) {\n\t\ttry { $test(); fwrite( STDOUT, \"PASS {$name}\\n\" ); }\n\t\tcatch ( \\Throwable $error ) { $failed++; fwrite( STDERR, \"FAIL {$name}: {$error->getMessage()}\\n\" ); }\n\t}\n\texit( 0 === $failed ? 0 : 1 );\n}\n"
    },
    "/Users/binam/project/پرهیزکاری/karban-uiux/web/tests/wordpress/local-profile-save.test.php": {
      "sha256": "9a5345d51d8f53cdcb35474a717d407fcf55185946e3b223e2efc801cb85de02",
      "text": "<?php\n/** Standalone registered-callback contract test; no WordPress bootstrap or DB. */\ndeclare(strict_types=1);\nnamespace GraphQL\\Error { class UserError extends \\Exception {} }\nnamespace WPGraphQL\\Model { class Post { public function __construct(public $post) {} } }\nnamespace {\ndefine('ABSPATH', __DIR__ . '/');\n$plugin = rtrim($argv[1] ?? '', '/');\nclass WP_Error { public function __construct(private $code, private $message='', private $data=[]) {} public function get_error_code(){return $this->code;} public function get_error_message(){return $this->message;} public function get_error_data(){return $this->data;} }\nclass WP_REST_Response { public function __construct(public $data, public $status=200){} public function get_data(){return $this->data;} public function get_status(){return $this->status;} }\nclass Request { public function __construct(private array $data=[]){} public function get_params(){return $this->data;} public function get_json_params(){return $this->data;} public function get_param($key){return $this->data[$key]??null;} }\nclass WP_Query {public $posts;public $found_posts;public $max_num_pages=1;public function __construct($args){$GLOBALS['list_args']=$args;$this->posts=$GLOBALS['query_posts']??[];$this->found_posts=count($this->posts);}}\nfunction wp_slash($value){return is_string($value)?addslashes($value):(is_array($value)?array_map('wp_slash',$value):$value);}\nfunction __return_true(){return true;}\nfunction is_wp_error($v){return $v instanceof WP_Error;}\nfunction get_page_by_path($slug,$output,$type){return get_post(20);}\nfunction current_time($type,$gmt=false){return '2026-10-21 00:00:00';}\nfunction register_rest_route($ns,$path,$args){$GLOBALS['routes'][$path][$args['methods']]=$args;}\nfunction register_graphql_mutation($name,$args){$GLOBALS['mutations'][$name]=$args;}\nfunction register_graphql_field($type,$name,$args){$GLOBALS['graphql'][$type][$name]=$args;}\nfunction register_graphql_object_type($name,$args){}\nfunction register_graphql_input_type($name,$args){$GLOBALS['inputs'][$name]=$args;}\nfunction register_graphql_enum_type($name,$args){}\nfunction acf_add_local_field_group($args){$GLOBALS['acf'][$args['key']]=$args;}\nfunction register_post_type($name,$args){$GLOBALS['cpt'][$name]=$args;}\nfunction get_posts($args){$GLOBALS['query_args']=$args;return $GLOBALS['query_ids']??[];}\nfunction get_current_user_id(){return $GLOBALS['uid'];}\nfunction is_user_logged_in(){return get_current_user_id()>0;}\nfunction wp_get_current_user(){return get_userdata(get_current_user_id());}\nfunction get_userdata($id){return $GLOBALS['users'][$id]??false;}\nfunction current_user_can($cap){return in_array($cap,$GLOBALS['caps'][get_current_user_id()]??[],true);}\nfunction get_user_meta($id,$key,$single=true){return $GLOBALS['um'][$id][$key]??'';}\nfunction update_user_meta($id,$key,$value){if(($GLOBALS['fail']??'')===$key)return false; if(get_user_meta($id,$key)===$value)return false; $GLOBALS['um'][$id][$key]=is_string($value)?stripslashes($value):$value;return 1;}\nfunction wp_update_user($data){if(($GLOBALS['fail']??'')==='display_name')return new WP_Error('db');$GLOBALS['users'][$data['ID']]->display_name=stripslashes($data['display_name']);return $data['ID'];}\nfunction get_post($id){return $GLOBALS['posts'][$id]??null;}\nfunction get_post_meta($id,$key,$single=true){return $GLOBALS['pm'][$id][$key]??'';}\nfunction update_post_meta($id,$key,$value){if(($GLOBALS['fail']??'')===$key)return false;if(get_post_meta($id,$key)===$value)return false;$GLOBALS['pm'][$id][$key]=is_string($value)?stripslashes($value):$value;return 1;}\nfunction add_filter($tag,$callback,$priority=10,$accepted=1){$GLOBALS['filters'][$tag][$priority][spl_object_id($callback)]=[$callback,$accepted];return true;}\nfunction remove_filter($tag,$callback,$priority=10){unset($GLOBALS['filters'][$tag][$priority][spl_object_id($callback)]);if(empty($GLOBALS['filters'][$tag][$priority]))unset($GLOBALS['filters'][$tag][$priority]);if(empty($GLOBALS['filters'][$tag]))unset($GLOBALS['filters'][$tag]);return true;}\nfunction apply_filters($tag,$value,...$args){$priorities=$GLOBALS['filters'][$tag]??[];ksort($priorities);foreach($priorities as $callbacks)foreach($callbacks as [$callback,$accepted])$value=$callback(...array_slice([$value,...$args],0,$accepted));return $value;}\nfunction wp_update_post($data,$error=false){\n if(($GLOBALS['fail']??'')==='post')return new WP_Error('db');\n if(($GLOBALS['fail']??'')==='post-zero')return 0;\n if(($GLOBALS['fail']??'')==='post-throw')throw new RuntimeException('fixture write exception');\n $id=$data['ID'];$postarr=array_merge(wp_slash((array)get_post($id)),$data);$row=$postarr;unset($row['ID']);\n // Installed wp_insert_post(): pending updates by users without publish_post clear post_name,\n // even when wp_update_post merged an existing slug or the caller explicitly passed it.\n if($row['post_status']==='pending'&&!current_user_can('publish_post',$id))$row['post_name']='';\n if($row['post_name']===''&&!in_array($row['post_status'],['draft','pending','auto-draft'],true))$row['post_name']=trim(preg_replace('/[^a-z0-9]+/','-',strtolower(stripslashes($row['post_title']))),'-');\n if(isset($GLOBALS['during_post_write'])){$during=$GLOBALS['during_post_write'];unset($GLOBALS['during_post_write']);$during();}\n $row=apply_filters('wp_insert_post_data',$row,$postarr,$data,true);\n foreach($row as $k=>$v)$GLOBALS['posts'][$id]->$k=is_string($v)?stripslashes($v):$v;\n return $id;\n}\nfunction get_term($id,$taxonomy){$t=$GLOBALS['terms'][$id]??null;return $t && $t->taxonomy===$taxonomy?$t:null;}\nfunction get_term_meta($id,$key,$single=true){return $GLOBALS['tm'][$id][$key]??'';}\nfunction wp_get_post_terms($id,$tax,$args=[]){return array_map(fn($tid)=>get_term($tid,$tax),$GLOBALS['pt'][$id][$tax]??[]);}\nfunction wp_set_object_terms($id,$terms,$tax){if(($GLOBALS['fail']??'')===$tax)return new WP_Error('db');$GLOBALS['pt'][$id][$tax]=$terms;return $terms;}\nfunction get_post_mime_type($id){return get_post($id)->post_mime_type??'';}\nfunction wp_get_attachment_image_url($id,$size){return 'https://fixture.invalid/image-'.$id.'.jpg';}\nif(!function_exists('mb_strlen')){function mb_strlen($s,$enc=null){return preg_match_all('/./us',$s);}}\nfunction reset_fixture(){\n $GLOBALS['filters']=[];unset($GLOBALS['during_post_write']);\n $GLOBALS['uid']=1;$GLOBALS['fail']='';$GLOBALS['um']=[1=>['nahan_phone'=>'09123456789'],2=>['nahan_specialist_post'=>20]];\n $GLOBALS['users']=[1=>(object)['ID'=>1,'display_name'=>'Client','roles'=>['nahan_client']],2=>(object)['ID'=>2,'display_name'=>'Owner','roles'=>['nahan_specialist']],3=>(object)['ID'=>3,'display_name'=>'Admin','roles'=>['administrator']]];\n $GLOBALS['caps']=[1=>['nahan_client'],2=>['nahan_specialist','nahan_edit_own_profile'],3=>[]];\n $GLOBALS['posts']=[20=>(object)['ID'=>20,'post_type'=>'nahan_specialist','post_author'=>2,'post_status'=>'draft','post_name'=>'stable','post_title'=>'Trade','post_password'=>''],30=>(object)['ID'=>30,'post_type'=>'attachment','post_author'=>1,'post_status'=>'inherit','post_mime_type'=>'image/jpeg']];\n $GLOBALS['pm']=[20=>['user'=>2,'is_verified'=>1],30=>['_nahan_media_owner'=>1,'_nahan_media_purpose'=>'public-avatar']];\n $GLOBALS['terms']=[10=>(object)['term_id'=>10,'taxonomy'=>'city','name'=>'کاشان','slug'=>'kashan'],11=>(object)['term_id'=>11,'taxonomy'=>'city','name'=>'خارج','slug'=>'outside'],12=>(object)['term_id'=>12,'taxonomy'=>'job_category','name'=>'Trade','slug'=>'trade']];$GLOBALS['tm']=[];$GLOBALS['pt']=[];\n}\nfunction check($v,$message){if(!$v)throw new \\RuntimeException($message);$GLOBALS['assertions']=($GLOBALS['assertions']??0)+1;}\nfunction call_route($path,$method,$data=[]){check(isset($GLOBALS['routes'][$path][$method]),\"Registered $method $path\");$r=$GLOBALS['routes'][$path][$method];$req=new Request($data);$p=$r['permission_callback']($req);if(is_wp_error($p))return $p;return $r['callback']($req);}\nfunction status($r){return is_wp_error($r)?($r->get_error_data()['status']??400):$r->status;}\nrequire $plugin.'/includes/class-autoloader.php';define('NAHAN_CORE_DIR',$plugin.'/');\\Nahan\\Core\\Autoloader::register();\nrequire $plugin.'/rest-api/class-rest-helper.php';\nif(is_file($plugin.'/rest-api/account-routes.php'))require $plugin.'/rest-api/account-routes.php';\nrequire $plugin.'/rest-api/profile-routes.php';require $plugin.'/graphql/register-mutations.php';\n\n// Standalone installed request class, never wp-load.php. All persistence above is in memory.\nrequire dirname($plugin, 3).'/wp-includes/rest-api/class-wp-rest-request.php';\nfunction get_option($key){return $key==='permalink_structure' ? $GLOBALS['permalinks'] : false;}\nfunction wp_is_json_media_type($type){return (bool)preg_match('~^application/(?:[a-z0-9.+-]+\\+)?json$~i',$type);}\nfunction add_option($key,$value,...$unused){if(isset($GLOBALS['options'][$key]))return false;$GLOBALS['options'][$key]=$value;return true;}\nfunction delete_option($key){unset($GLOBALS['options'][$key]);return true;}\nfunction wp_parse_str($text,&$result){parse_str($text,$result);}\nfunction request_fixture($path,$method,$body,$query=[],$url=[]){\n $request=new WP_REST_Request($method,'/nahan/v1'.$path);\n $request->set_header('Content-Type','application/json');$request->set_body(json_encode((object)$body));\n if(array_key_exists('rest_route',$query))$query['rest_route']='/nahan/v1'.$path;\n $request->set_query_params($query);$request->set_url_params($url);return $request;\n}\nfunction raw_request_fixture($path,$raw){$request=request_fixture($path,'POST',[]);$request->set_body($raw);return $request;}\nfunction invoke_actual($path,$request){$route=$GLOBALS['routes'][$path][$request->get_method()];$permission=$route['permission_callback']($request);return is_wp_error($permission)?$permission:$route['callback']($request);}\nrequire $plugin.'/rest-api/upload-routes.php';\n$failures=[];$cases=0;\nfunction expect_actual($condition,$message){$GLOBALS['cases']++;if(!$condition)$GLOBALS['failures'][]=$message;}\nforeach([''=>'off','/%postname%/'=>'on'] as $structure=>$label){foreach(['pretty','plain'] as $mode){\n $GLOBALS['permalinks']=$structure;$tag=\"$mode structure=$label\";$query=$mode==='plain'?['rest_route'=>'/nahan/v1/account/me']:[];\n reset_fixture();$request=request_fixture('/account/me','POST',['display_name'=>'Fixture Name','account_city_id'=>10],$query);\n expect_actual(isset($request->get_params()['rest_route'])===($mode==='plain'&&$label==='on'),'characterize installed merge '.$tag);\n $response=invoke_actual('/account/me',$request);\n $reread=invoke_actual('/account/me',request_fixture('/account/me','GET',[],$query));expect_actual(status($reread)===200&&($reread->data['data']['display_name']??null)==='Fixture Name'&&($reread->data['data']['location']['id']??null)===10,'account save then actual callback reread '.$tag);\n echo $tag.' account status='.status($response).' code='.($response->data['error']['code']??'none').\"\\n\";\n expect_actual(status($response)===200&&get_userdata(1)->display_name==='Fixture Name'&&get_user_meta(1,'nahan_account_city')===10,'valid account JSON saves '.$tag);\n reset_fixture();$GLOBALS['um'][1]['nahan_account_city']=10;$GLOBALS['um'][1]['nahan_account_avatar']=30;\n $response=invoke_actual('/account/me',request_fixture('/account/me','POST',['account_city_id'=>null,'avatar_id'=>null],$query));\n expect_actual(status($response)===200&&get_user_meta(1,'nahan_account_city')===0&&get_user_meta(1,'nahan_account_avatar')===0,'explicit account clears '.$tag);\n foreach(['owner_id','id','role','slug','status','rest_route','unrecognized'] as $field){reset_fixture();$response=invoke_actual('/account/me',request_fixture('/account/me','POST',[$field=>99],$query));expect_actual(status($response)===422&&get_userdata(1)->display_name==='Client','unknown JSON rejected '.$field.' '.$tag);}\n foreach([['display_name'=>\"Bad\\nName\"],['account_city_id'=>11],['account_city_id'=>'10']] as $body){reset_fixture();expect_actual(status(invoke_actual('/account/me',request_fixture('/account/me','POST',$body,$query)))===422,'invalid account body '.$tag);}\n foreach(['owner_id','id','role','display_name','account_city_id'] as $key){reset_fixture();$response=invoke_actual('/account/me',request_fixture('/account/me','POST',['display_name'=>'Safe Name'],array_merge($query,[$key=>2])));expect_actual(status($response)===422&&get_userdata(1)->display_name==='Client'&&get_userdata(2)->display_name==='Owner','nonrouting query rejected before writes '.$key.' '.$tag);}\n reset_fixture();$GLOBALS['uid']=2;$response=invoke_actual('/profile/me',request_fixture('/profile/me','POST',['title'=>'Fixture Trade','city_id'=>10],$query));expect_actual(status($response)===200&&get_post(20)->post_title==='Fixture Trade'&&$GLOBALS['pt'][20]['city']===[10],'profile JSON saves '.$tag);\n reset_fixture();$GLOBALS['uid']=2;$GLOBALS['pm'][20]['bio']='Complete biography';$GLOBALS['pt'][20]=['job_category'=>[12],'city'=>[10]];\n $response=invoke_actual('/profile/me/submit',request_fixture('/profile/me/submit','POST',[],$query));expect_actual(status($response)===200&&get_post(20)->post_status==='pending'&&get_post(20)->post_name==='stable','empty JSON submit succeeds '.$tag);\n reset_fixture();$_FILES=[];$upload=new WP_REST_Request('POST','/nahan/v1/uploads');$upload->set_header('Content-Type','multipart/form-data; boundary=fixture');$upload->set_body_params(['purpose'=>'public-avatar']);$upload->set_query_params($query);\n $response=invoke_actual('/uploads',$upload);expect_actual(status($response)===422&&($response->data['error']['code']??null)==='invalid_upload','multipart purpose reaches file validation without routing leak '.$tag);\n foreach(['/profile/me','/profile/me/submit','/profile/me/gallery'] as $path){reset_fixture();$GLOBALS['uid']=2;expect_actual(status(invoke_actual($path,request_fixture($path,'POST',['owner_id'=>99],$query)))===422,'profile unknown JSON rejected '.$path.' '.$tag);}\n reset_fixture();$GLOBALS['uid']=2;$GLOBALS['options']=[];$GLOBALS['posts'][30]->post_author=2;$GLOBALS['pm'][30]=['_nahan_media_owner'=>2,'_nahan_media_purpose'=>'public-portfolio'];\n $response=invoke_actual('/profile/me/gallery',request_fixture('/profile/me/gallery','POST',['media_id'=>30,'expected_revision'=>0],$query));expect_actual(status($response)===200&&count($response->data['data']['gallery']??[])===1,'gallery add JSON saves '.$tag);\n $reread=invoke_actual('/profile/me',request_fixture('/profile/me','GET',[],$query));expect_actual(status($reread)===200&&count($reread->data['data']['gallery']??[])===1,'profile gallery reread '.$tag);\n $delete='/profile/me/gallery/media/(?P<media_id>\\\\d+)';\n foreach([['media_id'=>31],['owner_id'=>3],['rest_route'=>'/bad']] as $bad){expect_actual(status(invoke_actual($delete,request_fixture('/profile/me/gallery/media/30','DELETE',$bad,$query,['media_id'=>'30'])))===422,'delete rejects body overrides '.$tag);}\n $response=invoke_actual($delete,request_fixture('/profile/me/gallery/media/30','DELETE',['expected_revision'=>1],$query,['media_id'=>'30']));expect_actual(status($response)===200&&($response->data['data']['gallery']??null)===[],'gallery path ID separate from JSON '.$tag);\n}}\n// Assoc JSON decoding must not erase the top-level object/list distinction.\n$GLOBALS['permalinks']='/%postname%/';\nforeach(['/account/me','/profile/me','/profile/me/submit','/profile/me/gallery'] as $path){\n foreach(['[]','[1]','null','true','42','\"scalar\"'] as $raw){\n  reset_fixture();$GLOBALS['uid']=2;$GLOBALS['pm'][20]['bio']='Complete biography';$GLOBALS['pt'][20]=['job_category'=>[12],'city'=>[10]];\n  $before=serialize([$GLOBALS['users'],$GLOBALS['posts'],$GLOBALS['um'],$GLOBALS['pm'],$GLOBALS['pt']]);\n  $response=invoke_actual($path,raw_request_fixture($path,$raw));\n  expect_actual(status($response)===422&&($response->data['error']['code']??null)==='unknown_field','non-object raw JSON rejected '.$path.' '.$raw);\n  expect_actual($before===serialize([$GLOBALS['users'],$GLOBALS['posts'],$GLOBALS['um'],$GLOBALS['pm'],$GLOBALS['pt']]),'non-object JSON cannot write '.$path.' '.$raw);\n }\n reset_fixture();$GLOBALS['uid']=2;$GLOBALS['pm'][20]['bio']='Complete biography';$GLOBALS['pt'][20]=['job_category'=>[12],'city'=>[10]];\n $response=invoke_actual($path,raw_request_fixture($path,'{}'));\n expect_actual($path==='/profile/me/gallery' ? status($response)===422&&($response->data['error']['code']??null)==='invalid_gallery' : status($response)===200,'empty object retains business policy '.$path);\n}\nif($failures){fwrite(STDERR,implode(\"\\n\",array_map(fn($m)=>'FAIL '.$m,$failures)).\"\\n\");echo count($failures).\" failed / $cases checks\\n\";exit(1);}\necho \"PASS installed WP_REST_Request + registered owner callbacks $cases checks\\n\";\n}\n"
