      "text": "<?php\n/** Registered source callbacks + real tiny local image bytes. Never bootstraps WP or uploads. */\ndeclare(strict_types=1);\nnamespace GraphQL\\Error { class UserError extends \\Exception {} }\nnamespace WPGraphQL\\Model { class Post { public function __construct(public $post) {} } }\nnamespace Nahan\\Core {\n // PHP upload provenance is the only native-file boundary replaced, in this test process only.\n function is_uploaded_file($path) { return ($GLOBALS['uploaded'] ?? false) && $path === ($GLOBALS['fixture_file'] ?? null); }\n}\nnamespace {\n define('ABSPATH', __DIR__.'/'); define('OBJECT','OBJECT');\n $plugin=rtrim($argv[1]??'','/'); $mode=$argv[2]??'all';\n class WP_Error {public function __construct(private $code,private $message='',private $data=[]){}public function get_error_code(){return $this->code;}public function get_error_message(){return $this->message;}public function get_error_data(){return $this->data;}}\n class WP_REST_Response {public function __construct(public $data,public $status=200){}}\n class Request implements \\ArrayAccess {\n  public function __construct(private array $data=[], private array $url=[]){} public function get_body(){return json_encode((object)$this->data);} public function get_query_params(){return [];} public function get_url_params(){return $this->url;} public function get_body_params(){return $this->data;} public function get_json_params(){return $this->data;} public function get_params(){return $this->data;}public function get_param($key){return $this->data[$key]??null;}\n  public function offsetExists(mixed $o):bool{return isset($this->data[$o]);}public function offsetGet(mixed $o):mixed{return $this->data[$o]??null;}public function offsetSet(mixed $o,mixed $v):void{}public function offsetUnset(mixed $o):void{}\n }\n function is_wp_error($v){return $v instanceof WP_Error;}\n function register_rest_route($ns,$path,$args){$GLOBALS['routes'][$path][$args['methods']]=$args;}\n function register_graphql_field($type,$name,$args){$GLOBALS['graphql'][$type][$name]=$args;}\n function register_graphql_object_type($name,$args){$GLOBALS['objects'][$name]=$args;}\n function register_graphql_input_type($name,$args){$GLOBALS['inputs'][$name]=$args;}\n function register_graphql_enum_type(...$args){}\n function register_graphql_mutation($name,$args){$GLOBALS['mutations'][$name]=$args;}\n function get_current_user_id(){return $GLOBALS['uid'];}function is_user_logged_in(){return get_current_user_id()>0;}\n function wp_get_current_user(){return get_userdata(get_current_user_id());}function get_userdata($id){return $GLOBALS['users'][$id]??(object)['ID'=>0,'roles'=>[]];}\n function current_user_can($cap){return in_array($cap,$GLOBALS['caps'][get_current_user_id()]??[],true);}\n function get_user_meta($id,$key,$single=true){return $GLOBALS['um'][$id][$key]??'';}\n function get_post_meta($id,$key,$single=true){return $GLOBALS['pm'][$id][$key]??'';}\n function wp_slash($v){return is_array($v)?array_map('wp_slash',$v):(is_string($v)?addslashes($v):$v);}\n function unslash($v){return is_array($v)?array_map('unslash',$v):(is_string($v)?stripslashes($v):$v);}\n function update_post_meta($id,$key,$value,$prev=''){\n  $GLOBALS['writes']++;if($GLOBALS['fail']===$key)return false;\n  if($GLOBALS['fail']==='silent-'.$key)return 1;\n  if($prev!==''&&get_post_meta($id,$key)!==$prev)return false;\n  $v=unslash($value);if(get_post_meta($id,$key)===$v)return false;$GLOBALS['pm'][$id][$key]=$v;return 1;\n }\n function update_user_meta($id,$key,$value){$GLOBALS['writes']++;if($GLOBALS['fail']===$key)return false;if($GLOBALS['fail']==='silent-'.$key)return 1;$GLOBALS['um'][$id][$key]=unslash($value);return 1;}\n function add_post_meta($id,$key,$value,$unique=false){if($unique&&isset($GLOBALS['pm'][$id][$key]))return false;return update_post_meta($id,$key,$value);}\n function add_option($key,$value,$deprecated='',$autoload=null){if($GLOBALS['fail']==='lock-throw')throw new \\RuntimeException('PRIVATE /filesystem');if(isset($GLOBALS['options'][$key])||$GLOBALS['fail']==='lock')return false;$GLOBALS['options'][$key]=$value;return true;}\n function delete_option($key){if($GLOBALS['fail']==='unlock-throw')throw new \\RuntimeException('PRIVATE /filesystem');if($GLOBALS['fail']==='unlock')return false;unset($GLOBALS['options'][$key]);return true;}\n function get_post($id){return $GLOBALS['posts'][$id]??null;}\n function get_post_mime_type($id){return get_post($id)->post_mime_type??'';}\n function wp_get_attachment_image_url($id,$size){return $GLOBALS['urls'][$id]??'https://fixture.invalid/media-'.$id.'.png';}\n function wp_get_attachment_metadata($id){return $GLOBALS['fail']==='source-metadata'?false:['width'=>2,'height'=>2,'file'=>'fixture.png'];}\n function wp_get_attachment_url($id){return wp_get_attachment_image_url($id,'full');}\n function add_filter($tag,$callback,$priority=10,$accepted=1){$GLOBALS['filters'][$tag][$priority][spl_object_id($callback)]=[$callback,$accepted];}\n function remove_filter($tag,$callback,$priority=10){unset($GLOBALS['filters'][$tag][$priority][spl_object_id($callback)]);if(empty($GLOBALS['filters'][$tag][$priority]))unset($GLOBALS['filters'][$tag][$priority]);if(empty($GLOBALS['filters'][$tag]))unset($GLOBALS['filters'][$tag]);}\n function wp_update_post($data,$error=false){\n  $GLOBALS['writes']++;if($GLOBALS['fail']==='post')return new WP_Error('db','PRIVATE /filesystem');if($GLOBALS['fail']==='post-zero')return 0;\n  $id=$data['ID'];$row=array_merge(wp_slash((array)get_post($id)),$data);\n  if($row['post_status']==='pending'&&!current_user_can('publish_post'))$row['post_name']='';\n  foreach($GLOBALS['filters']['wp_insert_post_data']??[] as $callbacks)foreach($callbacks as [$fn,$accepted])$row=$fn($row,$data,$data,true);\n  foreach($row as $key=>$value)$GLOBALS['posts'][$id]->$key=unslash($value);return $id;\n }\n function wp_get_post_terms($id,$tax){return [];}\n function wp_delete_attachment(...$args){$GLOBALS['deleted']++;throw new \\RuntimeException('Must never delete a file');}\n function do_action(...$args){$GLOBALS['events'][]=$args;}\n function __return_true(){return true;}\n function get_page_by_path(...$args){return get_post(20);}\n function current_time(...$args){return '2026-10-21 00:00:00';}\n // Core persistence is stubbed, not called. Decode really uses GD, never a permissive fake.\n function wp_get_image_editor($path){\n  $GLOBALS['decodes']++;if($GLOBALS['fail']==='decoder')return new WP_Error('decode','PRIVATE /filesystem');\n  $image=@imagecreatefromstring(file_get_contents($path));if(!$image)return new WP_Error('decode');\n  $size=['width'=>imagesx($image),'height'=>imagesy($image)];imagedestroy($image);\n  return new class($size){public function __construct(private $size){}public function get_size(){return $this->size;}};\n }\n function media_handle_upload($field,$parent,$post_data=[],$overrides=[]){\n  $GLOBALS['persist_calls']++;$GLOBALS['persist_args']=[$field,$parent,$post_data,$overrides];\n  if($GLOBALS['fail']==='storage-throw')throw new \\RuntimeException('PRIVATE /filesystem');\n  if($GLOBALS['fail']==='storage')return new WP_Error('upload','PRIVATE /filesystem');if($GLOBALS['fail']==='storage-zero')return 0;\n  $id=90;$GLOBALS['posts'][$id]=(object)['ID'=>$id,'post_type'=>'attachment','post_author'=>$post_data['post_author']??get_current_user_id(),'post_status'=>'inherit','post_mime_type'=>$GLOBALS['detected_mime']??'image/png'];\n  if($GLOBALS['fail']==='storage-foreign')$GLOBALS['posts'][$id]->post_author=1;\n  return $id;\n }\n function reset_fixture(){\n  $GLOBALS['uid']=2;$GLOBALS['fail']='';$GLOBALS['uploaded']=true;$GLOBALS['writes']=0;$GLOBALS['persist_calls']=0;$GLOBALS['decodes']=0;$GLOBALS['deleted']=0;$GLOBALS['events']=[];$GLOBALS['options']=[];$GLOBALS['filters']=[];$GLOBALS['urls']=[];$GLOBALS['detected_mime']='image/png';\n  $GLOBALS['caps']=[1=>['nahan_client'],2=>['nahan_specialist','nahan_edit_own_profile'],3=>['nahan_specialist','nahan_edit_own_profile']];\n  $GLOBALS['users']=[1=>(object)['ID'=>1,'roles'=>['nahan_client'],'display_name'=>'Client'],2=>(object)['ID'=>2,'roles'=>['nahan_specialist'],'display_name'=>'Owner'],3=>(object)['ID'=>3,'roles'=>['nahan_specialist'],'display_name'=>'Other']];\n  $GLOBALS['um']=[2=>['nahan_specialist_post'=>20],3=>['nahan_specialist_post'=>21]];\n  $GLOBALS['posts']=[20=>(object)['ID'=>20,'post_author'=>2,'post_type'=>'nahan_specialist','post_name'=>'stable','post_title'=>'Trade','post_status'=>'draft','post_password'=>'','post_content'=>''],21=>(object)['ID'=>21,'post_author'=>3,'post_type'=>'nahan_specialist','post_name'=>'other','post_title'=>'Other','post_status'=>'draft','post_password'=>'']];\n  $GLOBALS['pm']=[20=>['user'=>2,'is_verified'=>1],21=>['user'=>3]];\n  for($id=30;$id<=54;$id++){ $GLOBALS['posts'][$id]=(object)['ID'=>$id,'post_type'=>'attachment','post_author'=>2,'post_status'=>'inherit','post_mime_type'=>'image/png'];$GLOBALS['pm'][$id]=['_nahan_media_owner'=>2,'_nahan_media_purpose'=>'public-portfolio']; }\n  $_FILES=[];\n }\n $assertions=0;$failures=[];\n function check($ok,$message){$GLOBALS['assertions']++;if(!$ok)$GLOBALS['failures'][]=$message;}\n function route($path,$method,$data=[]){\n  $r=$GLOBALS['routes'][$path][$method]??null;if(!$r){check(false,'Missing registered '.$method.' '.$path);return new WP_Error('missing',[''],['status'=>599]);}\n  $url=[];if($method==='DELETE'&&str_contains($path,'gallery/media/')){$url=['media_id'=>$data['media_id']??null];unset($data['media_id']);}$req=new Request($data,$url);$permission=$r['permission_callback']($req);if(is_wp_error($permission))return $permission;if($permission!==true)return new WP_Error('forbidden','',['status'=>403]);return $r['callback']($req);\n }\n function status($r){return is_wp_error($r)?($r->get_error_data()['status']??400):$r->status;}\n function code($r){return is_wp_error($r)?$r->get_error_code():($r->data['error']['code']??'');}\n function data($r){return is_wp_error($r)?[]:($r->data['data']??[]);}\n function file_fixture($bytes,$name='tiny.png',$declared='image/png',$size=null){\n  file_put_contents($GLOBALS['fixture_file'],$bytes);clearstatcache(true,$GLOBALS['fixture_file']);\n  $_FILES=['file'=>['name'=>$name,'type'=>$declared,'tmp_name'=>$GLOBALS['fixture_file'],'error'=>UPLOAD_ERR_OK,'size'=>$size??strlen($bytes)]];\n }\n $dir=rtrim(getenv('TMPDIR')?:sys_get_temp_dir(),'/').'/karban-task7c-'.bin2hex(random_bytes(6));mkdir($dir,0700);$GLOBALS['fixture_file']=$dir.'/fixture';\n register_shutdown_function(static function()use($dir){@unlink($dir.'/fixture');@rmdir($dir);});\n $img=imagecreatetruecolor(2,2);ob_start();imagepng($img);$png=ob_get_clean();ob_start();imagejpeg($img);$jpeg=ob_get_clean();ob_start();imagegif($img);$gif=ob_get_clean();$webp=null;if(function_exists('imagewebp')){ob_start();imagewebp($img);$webp=ob_get_clean();}imagedestroy($img);\n require $plugin.'/includes/class-autoloader.php';define('NAHAN_CORE_DIR',$plugin.'/');\\Nahan\\Core\\Autoloader::register();\n require $plugin.'/rest-api/class-rest-helper.php';require $plugin.'/rest-api/account-routes.php';require $plugin.'/rest-api/profile-routes.php';require $plugin.'/rest-api/upload-routes.php';require $plugin.'/graphql/register-types.php';require $plugin.'/graphql/register-mutations.php';require $plugin.'/graphql/register-queries.php';\n if($mode==='upload-valid'){\n  reset_fixture();file_fixture($png,'tiny.png','text/plain',1);$r=route('/uploads','POST',['purpose'=>'public-avatar']);check(status($r)===200,'Actual decoded PNG, not declared MIME/size, determines valid upload');\n }\n if($mode==='upload-purpose'){\n  reset_fixture();file_fixture($png,'tiny.png','text/plain');$r=route('/uploads','POST',['purpose'=>'identity']);check(status($r)===422&&code($r)==='invalid_purpose'&&!$GLOBALS['persist_calls'],'Purpose rejected before file/MIME/persistence');\n }\n if(in_array($mode,['all','upload'],true)){\n  foreach([1,2] as $actor){reset_fixture();$GLOBALS['uid']=$actor;file_fixture($png,'tiny.png','application/pdf',1);$r=route('/uploads','POST',['purpose'=>'public-avatar']);check(status($r)===200,'Own valid avatar uses actual MIME and bytes role '.$actor);check((data($r)['id']??0)===90,'Upload returns persisted ID');check(get_post_meta(90,'_nahan_media_owner')===$actor&&get_post_meta(90,'_nahan_media_purpose')==='public-avatar','Fixed owner/purpose persisted');check($GLOBALS['persist_calls']===1,'Uses core media persistence once');}\n  reset_fixture();file_fixture($png);$r=route('/uploads','POST',['purpose'=>'public-portfolio']);check(status($r)===200,'Own portfolio upload');check(get_post_meta(90,'_nahan_media_purpose')==='public-portfolio','Portfolio purpose recorded');check(!isset($GLOBALS['pm'][20]['_nahan_public_gallery']),'Upload never autoattaches/publishes portfolio');\n  foreach([0,1] as $actor){reset_fixture();$GLOBALS['uid']=$actor;file_fixture($png);$r=route('/uploads','POST',['purpose'=>'public-portfolio']);check(status($r)===($actor===0?401:403)&&!$GLOBALS['persist_calls'],'Anonymous/client portfolio denied');}\n  foreach([[],['purpose'=>'identity'],['purpose'=>'general'],['purpose'=>'project'],['purpose'=>'public-avatar','owner'=>1],['purpose'=>'public-avatar','context'=>'general'],['purpose'=>['public-avatar']]] as $bad){reset_fixture();file_fixture($png);$r=route('/uploads','POST',$bad);check(status($r)>=400&&!$GLOBALS['persist_calls'],'Purpose/authority exact fields rejected '.json_encode($bad));}\n  foreach(['no-file','extra-file','array-file','php-error','not-uploaded','zero','oversize','wrong-extension','text','svg','pdf','truncated','dimensions','pixels','decoder'] as $case){\n   reset_fixture();file_fixture($png);\n   if($case==='no-file')$_FILES=[];if($case==='extra-file')$_FILES['extra']=$_FILES['file'];if($case==='array-file')$_FILES['file']['name']=['tiny.png'];\n   if($case==='php-error')$_FILES['file']['error']=UPLOAD_ERR_PARTIAL;if($case==='not-uploaded')$GLOBALS['uploaded']=false;\n   if($case==